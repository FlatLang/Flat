package flat/eventstream

import flat/future

/**
 * Single-start bounded mapping operation. Input remains caller-owned: cancellation
 * detaches this operation's pending receive, not other consumers or the producer.
 * Mapping futures are owned until their results are sent or discarded. cancel()
 * invokes their cancellation hooks; producers must release their own resources in
 * those hooks (cancelling a Future is not preemption of arbitrary async code).
 * completion settles only after owned tasks and the ordered emitter have drained.
 * Accepted output drains gracefully on cancellation; internal reorder/results are
 * discarded. Ordered indexes are input admission order, never completion order.
 */
class<In, Out> {
    visible var Int inFlightCount
    visible var Int peakInFlightCount
    visible Int reorderCount => reorder.count
    visible Int activeTaskCount => activeTasks.count
    visible var Int peakReorderCount
    visible var Bool cancelled
    visible var Bool finished
    visible var Int blockedOutputSendCount
    visible var Int peakBlockedOutputSendCount
    /** Settles true at first output saturation, otherwise false at terminal cleanup. */
    visible Future<Bool> outputBackpressure = Future.create<Bool>()

    visible BoundedFlow<ConcurrentMapResult<Out>> output
    visible Future<Bool> completion = Future.create<Bool>()
    var Future<Bool> orderedEmitterCompletion = Future.create<Bool>()

    var Future.CompletableFuture<Bool> workerProgress = Future.create<Bool>()
    var BoundedChannel<ConcurrentMapResult<Out>> orderedCompletions
    var Future.CompletableFuture<Bool> orderedProgress = Future.create<Bool>()
    var Bool started
    var ConcurrentMapResult<Out>[] reorder = ConcurrentMapResult<Out>[]
    var ConcurrentMapTask<In, Out>[] activeTasks = ConcurrentMapTask<In, Out>[]
    var Future<ChannelReceiveResult<In>> currentReceive
    var Long nextInputIndex
    var Long nextOutputIndex
    var Exception upstreamFailure

    public construct(
        visible BoundedFlow<In> input,
        visible Array<mapFunc(In) -> Future<Out>> mapFuncs,
        visible Bool ordered,
        visible Int maxParallel,
        visible Int maxReorder,
        visible Int outputCapacity,
        visible Int maxPendingOutputSends
    ) {
        if (maxParallel <= 0) {
            throw Exception("Concurrent map parallelism must be positive")
        }
        if (outputCapacity < 0) {
            throw Exception("Concurrent map output capacity cannot be negative")
        }
        if (maxReorder < 0) {
            throw Exception("Concurrent map reorder capacity cannot be negative")
        }
        if (maxPendingOutputSends < 0) {
            throw Exception("Concurrent map pending output capacity cannot be negative")
        }

        let requiredPending = maxParallel

        if (maxPendingOutputSends < requiredPending) {
            throw Exception("Concurrent map pending output capacity cannot preserve accepted results")
        }

        output = BoundedFlow<ConcurrentMapResult<Out>>(
            outputCapacity,
            maxPendingOutputSends,
            1
        )
        orderedCompletions = BoundedChannel<ConcurrentMapResult<Out>>(
            maxParallel,
            maxParallel,
            1
        )
    }

    /** Single-shot startup; repeated calls never create a second dispatcher. */
    public start() {
        if (started || finished) return
        started = true
        run()$
    }

    public cancel() {
        if (cancelled || finished) return

        cancelled = true
        if (currentReceive) currentReceive.cancel()
        activeTasks.copy().forEach({ _.cancel() })
        reorder.clear()
        output.close()
        // No consumer remains for internal buffered results after cancellation.
        orderedCompletions.fail(CancellationException())
        signalWorkerProgress()
        signalOrderedProgress()
    }

    async run() {
        if (ordered) emitOrdered()$

        try {
            dispatch()
        } catch (Exception error) {
            if (!cancelled) upstreamFailure = error
        }

        drainWorkers()

        if (ordered) {
            if (upstreamFailure) orderedCompletions.fail(upstreamFailure)
            else orderedCompletions.close()

            orderedEmitterCompletion.get()
        }

        finishOutput()
    }

    async dispatch() {
        while (!cancelled) {
            while (!cancelled && inFlightCount >= maxParallel) {
                workerProgress.get()
            }

            while (!cancelled && ordered && nextInputIndex > nextOutputIndex + maxReorder) {
                orderedProgress.get()
            }

            if (cancelled) return

            currentReceive = input.receive()$
            let received = currentReceive.get()
            currentReceive = null

            if (received.received) {
                let task = ConcurrentMapTask<In, Out>(
                    sourceIndex: nextInputIndex++,
                    input: received.value
                )
                task.mapFuncs = mapFuncs

                activeTasks.add(task)
                inFlightCount++
                peakInFlightCount = Math.max(peakInFlightCount, inFlightCount)
                process(task)$
            } else if (received.completed) {
                return
            } else if (received.capacityExceeded) {
                // A shared input may already have its allowed receivers. This
                // operation cannot wait by polling an immediately rejected read.
                upstreamFailure = Exception("Concurrent map input receive capacity exceeded")
                return
            } else if (received.failed) {
                upstreamFailure = received.error
                output.fail(received.error)
                if (ordered) orderedCompletions.fail(received.error)
                return
            }
        }
    }

    async process(ConcurrentMapTask<In, Out> task) {
        let result = task.run()

        if (ordered) {
            orderedCompletions.send(result)
        } else {
            sendOutput(result)
        }

        activeTasks.removeFirstWhere({ Object.referenceEquals(_, task) })
        inFlightCount--
        signalWorkerProgress()
    }

    async sendOutput(ConcurrentMapResult<Out> result) {
        let pendingBefore = output.pendingSendCount
        let send = output.send(result)$
        let blocked = output.pendingSendCount > pendingBefore

        if (blocked) {
            blockedOutputSendCount++
            peakBlockedOutputSendCount = Math.max(
                peakBlockedOutputSendCount,
                blockedOutputSendCount
            )
            signalOutputBackpressure()
        }

        send.get()

        if (blocked) blockedOutputSendCount--
    }

    async drainWorkers() {
        while (inFlightCount > 0) {
            workerProgress.get()
        }
    }

    async emitOrdered() {
        while (!cancelled) {
            let received = orderedCompletions.receive()

            if (received.received) {
                reorder.add(received.value)
                recordReorderPeak()
                flushOrdered()
            } else if (received.failed) {
                upstreamFailure = received.error
                break
            } else if (received.completed) {
                flushOrdered()
                break
            }
        }

        completeOrderedEmitter()
    }

    recordReorderPeak() {
        var Int count = reorder.count

        if (reorder.any({ _.sourceIndex == nextOutputIndex })) {
            count--
        }

        peakReorderCount = Math.max(peakReorderCount, count)
    }

    async flushOrdered() {
        while (!cancelled) {
            let next = reorder.firstWhere({ _.sourceIndex == nextOutputIndex })
            if (!next) return

            reorder.removeFirstWhere({ Object.referenceEquals(_, next) })
            sendOutput(next)
            nextOutputIndex++
            signalOrderedProgress()
        }
    }

    // Progress is a coalesced notification, never queued work. Predicates own
    // the state; replacing before completion lets resumed waiters observe the
    // next generation. No producer can block on a stale progress notification.
    signalWorkerProgress() {
        let previous = workerProgress
        workerProgress = Future.create<Bool>()
        previous.complete(true)
    }

    signalOrderedProgress() {
        let previous = orderedProgress
        orderedProgress = Future.create<Bool>()
        previous.complete(true)
    }

    finishOutput() {
        if (finished) return

        finished = true
        currentReceive = null
        reorder.clear()

        if (cancelled) {
            output.close()
        } else if (upstreamFailure) {
            output.fail(upstreamFailure)
        } else {
            output.close()
        }

        completeOperation()
    }
    completeOrderedEmitter() {
        throw Exception("Not implemented for target language or runtime")
    }

    signalOutputBackpressure() {
        throw Exception("Not implemented for target language or runtime")
    }

    completeOperation() {
        throw Exception("Not implemented for target language or runtime")
    }
}
