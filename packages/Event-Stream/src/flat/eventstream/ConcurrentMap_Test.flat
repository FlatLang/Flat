package flat/eventstream

import flat/future

testable class {
    // Concrete callback results must cross a typed complete(T) boundary before
    // becoming generic payloads. The seed's Future.from invokes callbacks in JS
    // and stores arithmetic/boolean returns unboxed; identity/reference returns
    // happen to work but are not a sound primitive-producer convention.
    // Calls to these factories require `$`: otherwise the seed implicitly adds
    // Future.get() to a non-Future method returning Future<T>, awaiting inside
    // the synchronous mapper instead of transferring its owned future.
    intFuture(async compute() -> Int) -> Future<Int> {
        let future = Future.create<Int>()
        completeIntFuture(future, compute)$
        return future
    }

    async completeIntFuture(Future.CompletableFuture<Int> future, async compute() -> Int) {
        try {
            Int value = compute()
            if (!future.cancelled) future.complete(value)
        } catch (Exception error) {
            if (!future.cancelled) future.error(error)
        }
    }

    boolFuture(async compute() -> Bool) -> Future<Bool> {
        let future = Future.create<Bool>()
        completeBoolFuture(future, compute)$
        return future
    }

    async completeBoolFuture(Future.CompletableFuture<Bool> future, async compute() -> Bool) {
        try {
            Bool value = compute()
            if (!future.cancelled) future.complete(value)
        } catch (Exception error) {
            if (!future.cancelled) future.error(error)
        }
    }

    async test `primitive mapper payloads retain Int and Bool types across generic futures`() {
        let numbers = BoundedFlow<Int>(capacity: 1)
        let mapped = ConcurrentMap.unordered<Int, Int>(numbers,
            (Int value) => intFuture({ value * 10 + 3 })$, maxParallel: 1, outputCapacity: 1)
        numbers.send(7)
        numbers.close()
        ConcurrentMapResult<Int> number = mapped.output.receive().value
        expect(number.succeeded).toBe(true)
        expectIntResult(number, 73)
        // Generic equality and a concrete read must agree: neither side may be
        // a raw JS number masquerading as the generic Int payload.
        Int concreteNumber = number.value
        expect(concreteNumber).toBe(73)
        expect(mapped.output.receive().completed).toBe(true)
        mapped.completion.get()

        let flags = BoundedFlow<Bool>(capacity: 2)
        let inverted = ConcurrentMap.ordered<Bool, Bool>(flags,
            (Bool value) => boolFuture({ !value })$, maxParallel: 2,
            maxReorder: 1, outputCapacity: 2)
        flags.send(true)
        flags.send(false)
        flags.close()
        ConcurrentMapResult<Bool> first = inverted.output.receive().value
        ConcurrentMapResult<Bool> second = inverted.output.receive().value
        expect(first.succeeded).toBe(true)
        expect(second.succeeded).toBe(true)
        expectBoolResult(first, false)
        expectBoolResult(second, true)
        expect(inverted.output.receive().completed).toBe(true)
        inverted.completion.get()
        Bool pressured = inverted.outputBackpressure.get()
        Bool completed = inverted.completion.get()
        expect(pressured).toBe(false)
        expect(completed).toBe(true)
    }

    expectBoolResult(ConcurrentMapResult<Bool> result, Bool expected) {
        expect(result.value).toBe(expected)
        Bool concrete = result.value
        expect(concrete).toBe(expected)
    }

    async test `reference and null mapper payloads preserve identity without primitive normalization`() {
        let source = BoundedFlow<Int>(capacity: 2)
        let reference = ConcurrentMap_TestValue()
        reference.value = 91
        let operation = ConcurrentMap.ordered<Int, ConcurrentMap_TestValue>(source,
            (Int value) => {
                let future = Future.create<ConcurrentMap_TestValue>()
                if (value == 0) future.complete(reference)
                else future.complete(null)
                return future
            }, maxParallel: 2, maxReorder: 1, outputCapacity: 2)
        source.send(0)
        source.send(1)
        source.close()
        ConcurrentMapResult<ConcurrentMap_TestValue> first = operation.output.receive().value
        ConcurrentMapResult<ConcurrentMap_TestValue> second = operation.output.receive().value
        expect(first.succeeded).toBe(true)
        expect(second.succeeded).toBe(true)
        expect(Object.referenceEquals(first.value, reference)).toBe(true)
        expect(second.value).toBe(null)
        expect(operation.output.receive().completed).toBe(true)
        operation.completion.get()
    }

    async test `unordered concurrent map emits completion order with bounded work`() {
        let input = BoundedFlow<Int>(capacity: 2)
        let firstGate = Future.create<Bool>()
        let secondGate = Future.create<Bool>()
        var active = 0
        var peak = 0

        let operation = ConcurrentMap.unordered<Int, Int>(input, (Int value) => intFuture(async {
            active++
            peak = Math.max(peak, active)

            if (value == 1) firstGate.get()
            else secondGate.get()

            active--
            return value * 10
        })$, maxParallel: 2, outputCapacity: 2)

        input.send(1)
        input.send(2)
        input.close()

        secondGate.complete(true)
        let second = operation.output.receive()
        firstGate.complete(true)
        let first = operation.output.receive()
        let end = operation.output.receive()

        expect(second.value.sourceIndex).toBe(1)
        expect(first.value.sourceIndex).toBe(0)
        expect(end.completed).toBe(true)
        expect(peak).toBe(2)
        expect(operation.peakInFlightCount).toBe(2)
        expect(operation.inFlightCount).toBe(0)
    }

    async test `ordered concurrent map emits source order after reversed completion`() {
        let input = BoundedFlow<Int>(capacity: 3)
        let firstGate = Future.create<Bool>()
        let secondGate = Future.create<Bool>()
        let thirdGate = Future.create<Bool>()

        let operation = ConcurrentMap.ordered<Int, Int>(input, (Int value) => intFuture(async {
            if (value == 1) firstGate.get()
            else if (value == 2) secondGate.get()
            else thirdGate.get()

            return value * 10
        })$, maxParallel: 3, maxReorder: 2, outputCapacity: 3)

        input.send(1)
        input.send(2)
        input.send(3)
        input.close()

        thirdGate.complete(true)
        secondGate.complete(true)
        firstGate.complete(true)

        let first = operation.output.receive()
        let second = operation.output.receive()
        let third = operation.output.receive()

        expect(first.value.sourceIndex).toBe(0)
        expect(second.value.sourceIndex).toBe(1)
        expect(third.value.sourceIndex).toBe(2)
        expect(operation.output.receive().completed).toBe(true)
        expect(operation.peakReorderCount > 0).toBe(true)
        expect(operation.peakReorderCount <= 2).toBe(true)
        expect(operation.reorderCount).toBe(0)
    }

    async test `ordered concurrent map limits admission by reorder capacity`() {
        let input = BoundedFlow<Int>(capacity: 3)
        let firstGate = Future.create<Bool>()
        let secondGate = Future.create<Bool>()
        let thirdGate = Future.create<Bool>()
        var thirdStarted = false

        let operation = ConcurrentMap.ordered<Int, Int>(input, (Int value) => intFuture(async {
            if (value == 1) firstGate.get()
            else if (value == 2) secondGate.get()
            else {
                thirdStarted = true
                thirdGate.get()
            }

            return value
        })$, maxParallel: 3, maxReorder: 1, outputCapacity: 3)

        input.send(1)
        input.send(2)
        input.send(3)
        input.close()

        expect(thirdStarted).toBe(false)

        secondGate.complete(true)
        expect(thirdStarted).toBe(false)

        firstGate.complete(true)

        let first = operation.output.receive()
        let second = operation.output.receive()

        expect(first.value.sourceIndex).toBe(0)
        expect(second.value.sourceIndex).toBe(1)
        thirdGate.complete(true)
        expect(operation.output.receive().value.sourceIndex).toBe(2)
        expect(thirdStarted).toBe(true)
        expect(operation.output.receive().completed).toBe(true)
        expect(operation.peakReorderCount <= 1).toBe(true)
    }

    async test `ordered concurrent map preserves order under randomized completion`() {
        let input = BoundedFlow<Int>(capacity: 5)
        let gates = Future<Bool>[]
        gates.add(Future.create<Bool>())
        gates.add(Future.create<Bool>())
        gates.add(Future.create<Bool>())
        gates.add(Future.create<Bool>())
        gates.add(Future.create<Bool>())
        let remaining = gates.copy()
        let operation = ConcurrentMap.ordered<Int, Int>(
            input,
            (Int value) => intFuture(async {
                gates[value].get()
                return value
            })$,
            maxParallel: 5,
            maxReorder: 4,
            outputCapacity: 5
        )

        for (value in 0..5) input.send(value)
        input.close()

        while (remaining.isNotEmpty) {
            let randomIndex = (Int)Math.random(remaining.count)
            let Future.CompletableFuture<Bool> future = (Future.CompletableFuture<Bool>)remaining[randomIndex]
            future.complete(true)
            remaining.remove(randomIndex)
        }

        for (index in 0..5) {
            expect(operation.output.receive().value.sourceIndex).toBe(index)
        }
        expect(operation.output.receive().completed).toBe(true)
        expect(operation.peakInFlightCount).toBe(5)
        expect(operation.peakReorderCount <= 4).toBe(true)
    }

    async test `concurrent map supports zero-capacity rendezvous output`() {
        let input = BoundedFlow<Int>(capacity: 1)
        let gate = Future.create<Bool>()
        let operation = ConcurrentMap.unordered<Int, Int>(
            input,
            { gate },
            maxParallel: 1,
            outputCapacity: 0
        )

        input.send(1)
        input.close()
        gate.complete(true)

        operation.outputBackpressure.get()
        expect(operation.output.bufferedCount).toBe(0)
        expect(operation.output.pendingSendCount).toBe(1)
        expect(operation.output.receive().received).toBe(true)
        expect(operation.output.receive().completed).toBe(true)
        expect(operation.blockedOutputSendCount).toBe(0)
    }

    async test `concurrent map output backpressure bounds completed work`() {
        let input = BoundedFlow<Int>(capacity: 2)
        let firstGate = Future.create<Bool>()
        let secondGate = Future.create<Bool>()

        let operation = ConcurrentMap.unordered<Int, Int>(input, (Int value) => intFuture(async {
            if (value == 1) firstGate.get()
            else secondGate.get()
            return value
        })$, maxParallel: 2, outputCapacity: 1, maxPendingOutputSends: 2)

        input.send(1)
        input.send(2)
        input.close()
        firstGate.complete(true)
        secondGate.complete(true)

        operation.outputBackpressure.get()
        expect(operation.outputBackpressure.completed).toBe(true)
        expect(operation.blockedOutputSendCount).toBe(1)
        expect(operation.output.pendingSendCount).toBe(1)
        expect(operation.inFlightCount).toBe(2)

        let first = operation.output.receive()
        let second = operation.output.receive()

        expect(first.received).toBe(true)
        expect(second.received).toBe(true)
        expect(operation.output.receive().completed).toBe(true)
        expect(operation.inFlightCount).toBe(0)
        expect(operation.blockedOutputSendCount).toBe(0)
        expect(operation.peakBlockedOutputSendCount).toBe(1)
    }

    async test `concurrent map isolates item failure and continues`() {
        let input = BoundedFlow<String>(capacity: 2)
        let operation = ConcurrentMap.unordered<String, String>(input, failFirst, maxParallel: 2, outputCapacity: 2)

        input.send("one")
        input.send("two")
        input.close()

        let first = operation.output.receive().value
        let second = operation.output.receive().value

        expect(first.failed || second.failed).toBe(true)

        if (first.failed) {
            expect(first.error.message).toBe("broken")
            expect(second.succeeded).toBe(true)
        } else if (second.failed) {
            expect(second.error.message).toBe("broken")
            expect(first.succeeded).toBe(true)
        }
        expect(operation.output.receive().completed).toBe(true)
    }

    failFirst(String value) -> Future<String> {
        let future = Future.create<String>()
        if (value == "one") future.error(Exception("broken"))
        else future.complete("#value!")
        return future
    }

    async test `concurrent map propagates upstream failure after active work drains`() {
        let input = BoundedFlow<Int>(capacity: 1)
        let gate = Future.create<Bool>()
        let operation = ConcurrentMap.unordered<Int, Int>(input, (Int value) => intFuture(async {
            gate.get()
            return value
        })$, maxParallel: 1, outputCapacity: 1)

        input.send(1)
        input.fail(Exception("upstream"))
        gate.complete(true)

        let result = operation.output.receive()

        if (result.received) {
            expect(operation.output.receive().failed).toBe(true)
        } else {
            expect(result.failed).toBe(true)
            expect(result.error.message).toBe("upstream")
        }
        expect(operation.inFlightCount).toBe(0)
    }

    async test `cancelling concurrent map releases pending input and closes output`() {
        let input = BoundedFlow<Int>(capacity: 0)
        let operation = ConcurrentMap.unordered<Int, Int>(input, (Int value) => intFuture({ value })$, maxParallel: 1, outputCapacity: 1)

        expect(input.pendingReceiveCount).toBe(1)

        operation.cancel()

        expect(input.pendingReceiveCount).toBe(0)
        expect(operation.cancelled).toBe(true)
        expect(operation.output.receive().completed).toBe(true)
        operation.completion.get()
        expect(operation.completion.completed).toBe(true)
    }

    async test `cancelling concurrent map cancels active mapping and cleans task state`() {
        let input = BoundedFlow<Int>(capacity: 1)
        let gate = Future.create<Int>()
        let operation = ConcurrentMap.unordered<Int, Int>(
            input,
            { gate },
            maxParallel: 1,
            outputCapacity: 1
        )

        input.send(1)
        expect(operation.activeTaskCount).toBe(1)
        expect(operation.inFlightCount).toBe(1)

        operation.cancel()
        operation.completion.get()

        expect(gate.cancelled).toBe(true)
        expect(operation.activeTaskCount).toBe(0)
        expect(operation.inFlightCount).toBe(0)
        expect(operation.reorderCount).toBe(0)
        expect(operation.output.pendingSendCount).toBe(0)
        expect(operation.output.pendingReceiveCount).toBe(0)
        expect(operation.output.receive().completed).toBe(true)
    }

    async test `cancelling ordered map waits for active cleanup`() {
        let input = BoundedFlow<Int>(capacity: 1)
        let gate = Future.create<Int>()
        let operation = ConcurrentMap.ordered<Int, Int>(
            input,
            { gate },
            maxParallel: 1,
            maxReorder: 1,
            outputCapacity: 1
        )

        input.send(1)
        expect(operation.activeTaskCount).toBe(1)

        operation.cancel()
        operation.completion.get()

        expect(gate.cancelled).toBe(true)
        expect(operation.activeTaskCount).toBe(0)
        expect(operation.inFlightCount).toBe(0)
        expect(operation.reorderCount).toBe(0)
        expect(operation.finished).toBe(true)
    }

    async test `concurrent map emits transformed values`() {
        let input = BoundedFlow<Int>(capacity: 1)
        let operation = ConcurrentMap.unordered<Int, ConcurrentMap_TestValue>(
            input,
            (Int value) => {
                let future = Future.create<ConcurrentMap_TestValue>()
                let mapped = ConcurrentMap_TestValue()
                mapped.value = value * 10
                future.complete(mapped)
                return future
            },
            maxParallel: 1,
            outputCapacity: 1
        )

        input.send(2)
        input.close()

        let result = operation.output.receive()
        let mapped = (ConcurrentMap_TestValue)result.value.value

        expect(result.value.succeeded).toBe(true)
        expect(mapped).toNotBe(null)
        expectMappedResult(result.value)
        expect(operation.output.receive().completed).toBe(true)
    }

    expectMappedResult(ConcurrentMapResult<ConcurrentMap_TestValue> result) {
        expect(result.value.value).toBe(20)
    }

    async test `concurrent map with one worker loses or duplicates no accepted item`() {
        let input = BoundedFlow<Int>(capacity: 3)
        let operation = ConcurrentMap.unordered<Int, Int>(
            input,
            (Int value) => intFuture({ value })$,
            maxParallel: 1,
            outputCapacity: 3
        )

        input.send(1)
        input.send(2)
        input.send(3)
        input.close()

        let first = operation.output.receive()
        let second = operation.output.receive()
        let third = operation.output.receive()

        expect(first.value.sourceIndex).toBe(0)
        expect(second.value.sourceIndex).toBe(1)
        expect(third.value.sourceIndex).toBe(2)
        expect(first.value.succeeded).toBe(true)
        expect(second.value.succeeded).toBe(true)
        expect(third.value.succeeded).toBe(true)
        expect(operation.output.receive().completed).toBe(true)
        operation.completion.get()
        expect(operation.peakInFlightCount).toBe(1)
        expect(operation.inFlightCount).toBe(0)
        expect(operation.completion.completed).toBe(true)
    }

    async test `repeated start keeps exactly one input receiver`() {
        let input = BoundedFlow<Int>(capacity: 0)
        let operation = ConcurrentMap.unordered<Int, Int>(
            input, (Int value) => intFuture({ value })$,
            maxParallel: 1, outputCapacity: 1
        )

        operation.start()
        operation.start()
        expect(input.pendingReceiveCount).toBe(1)
        input.send(7)
        input.close()
        expectIntResult(operation.output.receive().value, 7)
        expect(operation.output.receive().completed).toBe(true)
        operation.completion.get()
        expect(operation.activeTaskCount).toBe(0)
        expect(input.pendingReceiveCount).toBe(0)
        expect(operation.outputBackpressure.get()).toBe(false)
    }

    async test `ordered output is identical at serial and forward and reversed parallel schedules`() {
        expectOrderedSchedule(1, false)
        expectOrderedSchedule(1, true)
        expectOrderedSchedule(3, false)
        expectOrderedSchedule(3, true)
    }

    async expectOrderedSchedule(Int parallelism, Bool reverse) {
        let input = BoundedFlow<Int>(capacity: 6)
        // Six immutable identities form a bounded fixture, not a production barrier.
        let gates = Array<Future.CompletableFuture<Bool>>()
        let entered = Array<Future.CompletableFuture<Bool>>()
        let settled = Array<Future.CompletableFuture<Bool>>()
        let settlementOrder = Int[]
        for (index in 0..6) {
            gates.add(Future.create<Bool>())
            entered.add(Future.create<Bool>())
            settled.add(Future.create<Bool>())
        }
        var Int active
        var Int peak
        let operation = ConcurrentMap.ordered<Int, Int>(
            input,
            (Int value) => intFuture(async {
                active++
                peak = Math.max(peak, active)
                entered[value].complete(true)
                try {
                    gates[value].get()
                    return value * 10
                } finally {
                    active--
                    settlementOrder.add(value)
                    settled[value].complete(true)
                }
            })$,
            maxParallel: parallelism, maxReorder: parallelism - 1,
            outputCapacity: 6
        )
        for (value in 0..6) input.send(value)
        input.close()

        var Int base
        while (base < 6) {
            for (index in base..base + parallelism) entered[index].get()
            expect(active).toBe(parallelism)
            if (base + parallelism < 6) expect(entered[base + parallelism].completed).toBe(false)
            for (offset in 0..parallelism) {
                let index = base + (reverse ? parallelism - 1 - offset : offset)
                gates[index].complete(true)
                settled[index].get()
                expect(settlementOrder[base + offset]).toBe(index)
            }
            for (index in base..base + parallelism) {
                let received = operation.output.receive()
                expect(received.value.sourceIndex).toBe(index)
                expectIntResult(received.value, index * 10)
                expect(received.value.succeeded).toBe(true)
            }
            base += parallelism
        }
        expect(operation.output.receive().completed).toBe(true)
        operation.completion.get()
        expect(peak).toBe(parallelism)
        expect(active).toBe(0)
        expect(settlementOrder.count).toBe(6)
        expect(operation.peakInFlightCount).toBe(parallelism)
        expect(operation.peakReorderCount <= parallelism - 1).toBe(true)
        expect(operation.inFlightCount).toBe(0)
        expect(operation.activeTaskCount).toBe(0)
        expect(operation.reorderCount).toBe(0)
        expect(input.pendingReceiveCount).toBe(0)
        expect(operation.output.pendingSendCount).toBe(0)
        expect(operation.output.pendingReceiveCount).toBe(0)
        expect(operation.outputBackpressure.get()).toBe(false)
        let schedule = reverse ? "reverse" : "forward"
        var String order = "["
        for (value in settlementOrder) {
            if (order != "[") order += ","
            order += "#value"
        }
        order += "]"
        Console.log("{\"schema\":\"flat.eventstream.lifecycle.v1\",\"scenario\":\"ordered-#schedule\",\"concurrency\":#parallelism,\"settlementOrder\":#order,\"settledCount\":#{settlementOrder.count},\"peakActive\":#peak,\"activeAfter\":#active,\"peakInFlight\":#{operation.peakInFlightCount},\"peakReorder\":#{operation.peakReorderCount},\"inFlightAfter\":#{operation.inFlightCount},\"activeTasksAfter\":#{operation.activeTaskCount},\"reorderAfter\":#{operation.reorderCount},\"pendingInputReceivesAfter\":#{input.pendingReceiveCount},\"pendingOutputSendsAfter\":#{operation.output.pendingSendCount},\"pendingOutputReceivesAfter\":#{operation.output.pendingReceiveCount},\"unobserved\":[\"allocation_bytes\",\"throughput\"]}")
    }

    async test `cancellation releases ordered output pressure and internal ownership`() {
        let input = BoundedFlow<Int>(capacity: 3)
        let operation = ConcurrentMap.ordered<Int, Int>(
            input, (Int value) => intFuture({ value })$,
            maxParallel: 3, maxReorder: 2, outputCapacity: 0
        )
        input.send(1)
        input.send(2)
        input.send(3)
        input.close()
        expect(operation.outputBackpressure.get()).toBe(true)
        expect(operation.output.pendingSendCount).toBe(1)

        operation.cancel()
        operation.cancel()
        operation.completion.get()

        expect(operation.finished).toBe(true)
        expect(operation.cancelled).toBe(true)
        expect(operation.inFlightCount).toBe(0)
        expect(operation.activeTaskCount).toBe(0)
        expect(operation.reorderCount).toBe(0)
        expect(operation.blockedOutputSendCount).toBe(0)
        expect(operation.output.pendingSendCount).toBe(0)
        expect(operation.output.pendingReceiveCount).toBe(0)
        expect(input.pendingReceiveCount).toBe(0)
        expect(operation.output.receive().completed).toBe(true)
    }

    async test `cancellation without saturation settles backpressure observation`() {
        let input = BoundedFlow<Int>(capacity: 0)
        let operation = ConcurrentMap.unordered<Int, Int>(
            input, (Int value) => intFuture({ value })$,
            maxParallel: 1, outputCapacity: 1
        )
        operation.cancel()
        operation.completion.get()
        expect(operation.outputBackpressure.get()).toBe(false)
        expect(operation.activeTaskCount).toBe(0)
        expect(input.pendingReceiveCount).toBe(0)
    }

    async test `input receiver exhaustion fails instead of polling forever`() {
        let input = BoundedFlow<Int>(capacity: 0)
        let existing = input.receive()$
        let operation = ConcurrentMap.unordered<Int, Int>(
            input, (Int value) => intFuture({ value })$,
            maxParallel: 1, outputCapacity: 1
        )
        operation.completion.get()
        let failure = operation.output.receive()
        expect(failure.failed).toBe(true)
        expect(failure.error.message).toBe("Concurrent map input receive capacity exceeded")
        expect(operation.finished).toBe(true)
        expect(operation.activeTaskCount).toBe(0)
        // This operation does not own the other consumer or close its input.
        expect(input.closed).toBe(false)
        expect(input.pendingReceiveCount).toBe(1)
        existing.cancel()
        expect(input.pendingReceiveCount).toBe(0)
        expect(operation.outputBackpressure.get()).toBe(false)
    }

    async test `serial and parallel cancellation invoke every owned producer cleanup hook`() {
        expectMappingCancellation(1)
        expectMappingCancellation(3)
    }

    async expectMappingCancellation(Int parallelism) {
        let input = BoundedFlow<Int>(capacity: parallelism)
        let gates = Array<Future.CompletableFuture<Int>>()
        var Int cleaned
        for (index in 0..parallelism) {
            let gate = Future.create<Int>()
            gate.onCancel({ cleaned++ })
            gates.add(gate)
        }
        let operation = ConcurrentMap.unordered<Int, Int>(
            input, (Int value) => gates[value],
            maxParallel: parallelism, outputCapacity: 0
        )
        for (value in 0..parallelism) input.send(value)
        expect(operation.inFlightCount).toBe(parallelism)
        expect(operation.activeTaskCount).toBe(parallelism)

        operation.cancel()
        operation.completion.get()
        expect(cleaned).toBe(parallelism)
        expect(gates.all({ _.cancelled })).toBe(true)
        expect(operation.activeTaskCount).toBe(0)
        expect(operation.inFlightCount).toBe(0)
        expect(operation.blockedOutputSendCount).toBe(0)
        expect(input.pendingReceiveCount).toBe(0)
        expect(operation.output.pendingSendCount).toBe(0)
        expect(operation.outputBackpressure.get()).toBe(false)
        // Upstream ownership remains with the caller, including its close.
        expect(input.closed).toBe(false)
        input.close()
    }

    async test `unordered failure and unrelated output progress while first mapper is held`() {
        let input = BoundedFlow<Int>(capacity: 3)
        let gates = Array<Future.CompletableFuture<Bool>>()
        let entered = Array<Future.CompletableFuture<Bool>>()
        let settled = Array<Future.CompletableFuture<Bool>>()
        let settlementOrder = Int[]
        for (index in 0..3) {
            gates.add(Future.create<Bool>())
            entered.add(Future.create<Bool>())
            settled.add(Future.create<Bool>())
        }
        let operation = ConcurrentMap.unordered<Int, Int>(input,
            (Int value) => intFuture(async {
                entered[value].complete(true)
                try {
                    gates[value].get()
                    if (value == 1) throw Exception("controlled failure")
                    return value
                } finally {
                    settlementOrder.add(value)
                    settled[value].complete(true)
                }
            })$, maxParallel: 3, outputCapacity: 0)
        for (index in 0..3) input.send(index)
        input.close()
        for (gate in entered) gate.get()
        gates[1].complete(true)
        settled[1].get()
        ConcurrentMapResult<Int> failed = operation.output.receive().value
        expect(failed.sourceIndex).toBe(1)
        expect(failed.failed).toBe(true)
        expect(failed.error.message).toBe("controlled failure")
        var Int failedResults
        if (failed.failed) failedResults++
        gates[2].complete(true)
        settled[2].get()
        ConcurrentMapResult<Int> unrelated = operation.output.receive().value
        expect(unrelated.sourceIndex).toBe(2)
        expect(unrelated.succeeded).toBe(true)
        expectIntResult(unrelated, 2)
        var Int unrelatedOutputsBeforeFirstSettlement
        if (unrelated.succeeded && !settled[0].completed) unrelatedOutputsBeforeFirstSettlement++
        expect(unrelatedOutputsBeforeFirstSettlement).toBe(1)
        expect(settled[0].completed).toBe(false)
        expect(operation.completion.completed).toBe(false)
        gates[0].complete(true)
        settled[0].get()
        expectIntResult(operation.output.receive().value, 0)
        expect(operation.output.receive().completed).toBe(true)
        operation.completion.get()
        expect(operation.peakInFlightCount).toBe(3)
        expect(operation.inFlightCount).toBe(0)
        expect(operation.activeTaskCount).toBe(0)
        expect(operation.output.pendingSendCount).toBe(0)
        expect(input.pendingReceiveCount).toBe(0)
        expect(settlementOrder).toBe([1, 2, 0])
        var String order = "["
        for (value in settlementOrder) {
            if (order != "[") order += ","
            order += "#value"
        }
        order += "]"
        Console.log("{\"schema\":\"flat.eventstream.lifecycle.v1\",\"scenario\":\"unordered-failure-isolation\",\"concurrency\":3,\"settlementOrder\":#order,\"settledCount\":#{settlementOrder.count},\"unrelatedOutputsBeforeFirstSettlement\":#unrelatedOutputsBeforeFirstSettlement,\"failedResults\":#failedResults,\"peakInFlight\":#{operation.peakInFlightCount},\"inFlightAfter\":#{operation.inFlightCount},\"activeTasksAfter\":#{operation.activeTaskCount},\"pendingOutputSendsAfter\":#{operation.output.pendingSendCount},\"unobserved\":[\"allocation_bytes\",\"throughput\"]}")
    }

    // Resolve the nested channel/map generic at a typed boundary for the Java seed.
    expectIntResult(ConcurrentMapResult<Int> result, Int expected) {
        expect(result.value).toBe(expected)
    }

    async test `upstream failure waits for every mapper finally at one and three`() {
        expectFailureDrain(1)
        expectFailureDrain(3)
    }

    async expectFailureDrain(Int parallelism) {
        let input = BoundedFlow<Int>(capacity: parallelism)
        let entered = Array<Future.CompletableFuture<Bool>>()
        let cleanupEntered = Array<Future.CompletableFuture<Bool>>()
        let cleanupRelease = Array<Future.CompletableFuture<Bool>>()
        let settled = Array<Future.CompletableFuture<Bool>>()
        let release = Future.create<Bool>()
        var Int settledCount
        var Int cleanupWaitSamples
        for (index in 0..parallelism) {
            entered.add(Future.create<Bool>())
            cleanupEntered.add(Future.create<Bool>())
            cleanupRelease.add(Future.create<Bool>())
            settled.add(Future.create<Bool>())
        }
        let operation = ConcurrentMap.unordered<Int, Int>(input,
            (Int value) => intFuture(async {
                entered[value].complete(true)
                try {
                    release.get()
                    return value
                } finally {
                    cleanupEntered[value].complete(true)
                    cleanupRelease[value].get()
                    settledCount++
                    settled[value].complete(true)
                }
            })$, maxParallel: parallelism, outputCapacity: parallelism)
        for (index in 0..parallelism) input.send(index)
        for (gate in entered) gate.get()
        input.fail(Exception("controlled upstream failure"))
        release.complete(true)
        for (gate in cleanupEntered) gate.get()
        expect(operation.activeTaskCount).toBe(parallelism)
        expect(operation.completion.completed).toBe(false)
        var index = parallelism
        while (index > 0) {
            index--
            expect(operation.completion.completed).toBe(false)
            cleanupWaitSamples++
            cleanupRelease[index].complete(true)
            settled[index].get()
        }
        operation.completion.get()
        let terminal = operation.output.receive()
        expect(terminal.failed).toBe(true)
        expect(terminal.error.message).toBe("controlled upstream failure")
        expect(settledCount).toBe(parallelism)
        expect(operation.finished).toBe(true)
        expect(operation.cancelled).toBe(false)
        expect(operation.inFlightCount).toBe(0)
        expect(operation.activeTaskCount).toBe(0)
        expect(input.pendingReceiveCount).toBe(0)
        expect(operation.output.pendingSendCount).toBe(0)
        Console.log("{\"schema\":\"flat.eventstream.lifecycle.v1\",\"scenario\":\"upstream-failure-drain\",\"concurrency\":#parallelism,\"settledCount\":#settledCount,\"cleanupWaitSamples\":#cleanupWaitSamples,\"peakInFlight\":#{operation.peakInFlightCount},\"inFlightAfter\":#{operation.inFlightCount},\"activeTasksAfter\":#{operation.activeTaskCount},\"pendingOutputSendsAfter\":#{operation.output.pendingSendCount},\"pendingInputReceivesAfter\":#{input.pendingReceiveCount},\"unobserved\":[\"allocation_bytes\",\"throughput\"]}")
    }

    async test `output pressure cancellation drains owned futures at one and three`() {
        expectPressureCancellation(1)
        expectPressureCancellation(3)
    }

    async expectPressureCancellation(Int parallelism) {
        let input = BoundedFlow<Int>(capacity: parallelism)
        let gates = Array<Future.CompletableFuture<Int>>()
        for (index in 0..parallelism) gates.add(Future.create<Int>())
        let operation = ConcurrentMap.unordered<Int, Int>(input,
            (Int value) => gates[value], maxParallel: parallelism, outputCapacity: 0)
        for (index in 0..parallelism) input.send(index)
        expect(operation.activeTaskCount).toBe(parallelism)
        gates.last.complete(42)
        expect(operation.outputBackpressure.get()).toBe(true)
        let pendingAtPressure = operation.output.pendingSendCount
        let inFlightAtPressure = operation.inFlightCount
        expect(pendingAtPressure).toBe(1)
        expect(inFlightAtPressure).toBe(parallelism)
        expect(operation.completion.completed).toBe(false)
        operation.cancel()
        operation.cancel()
        operation.completion.get()
        expect(operation.finished).toBe(true)
        expect(operation.cancelled).toBe(true)
        for (index in 0..parallelism - 1) expect(gates[index].cancelled).toBe(true)
        expect(operation.peakInFlightCount).toBe(parallelism)
        expect(operation.inFlightCount).toBe(0)
        expect(operation.activeTaskCount).toBe(0)
        expect(operation.blockedOutputSendCount).toBe(0)
        expect(operation.output.pendingSendCount).toBe(0)
        expect(operation.output.pendingReceiveCount).toBe(0)
        expect(input.pendingReceiveCount).toBe(0)
        expect(operation.output.receive().completed).toBe(true)
        expect(input.closed).toBe(false)
        input.close()
        Console.log("{\"schema\":\"flat.eventstream.lifecycle.v1\",\"scenario\":\"output-pressure-cancellation\",\"concurrency\":#parallelism,\"pendingOutputSendsAtPressure\":#pendingAtPressure,\"inFlightAtPressure\":#inFlightAtPressure,\"peakInFlight\":#{operation.peakInFlightCount},\"inFlightAfter\":#{operation.inFlightCount},\"activeTasksAfter\":#{operation.activeTaskCount},\"pendingOutputSendsAfter\":#{operation.output.pendingSendCount},\"pendingOutputReceivesAfter\":#{operation.output.pendingReceiveCount},\"pendingInputReceivesAfter\":#{input.pendingReceiveCount},\"cancelled\":#{operation.cancelled},\"unobserved\":[\"callback_finally_cleanup\",\"allocation_bytes\",\"throughput\"]}")
    }

    test `concurrent map validates every finite bound`() {
        let input = BoundedFlow<Int>(capacity: 1)

        expect({ ConcurrentMap.unordered<Int, Int>(input, (Int value) => intFuture({ value })$, maxParallel: 0, outputCapacity: 1) })
            .toThrowWithMessage(Exception.class, "Concurrent map parallelism must be positive")
        expect({ ConcurrentMap.unordered<Int, Int>(input, (Int value) => intFuture({ value })$, maxParallel: 1, outputCapacity: -1) })
            .toThrowWithMessage(Exception.class, "Concurrent map output capacity cannot be negative")
        expect({ ConcurrentMap.ordered<Int, Int>(input, (Int value) => intFuture({ value })$, maxParallel: 1, maxReorder: -1, outputCapacity: 1) })
            .toThrowWithMessage(Exception.class, "Concurrent map reorder capacity cannot be negative")
        expect({ ConcurrentMap.unordered<Int, Int>(input, (Int value) => intFuture({ value })$, maxParallel: 1, outputCapacity: 1, maxPendingOutputSends: -1) })
            .toThrowWithMessage(Exception.class, "Concurrent map pending output capacity cannot be negative")
        expect({ ConcurrentMap.unordered<Int, Int>(input, (Int value) => intFuture({ value })$, maxParallel: 2, outputCapacity: 1, maxPendingOutputSends: 1) })
            .toThrowWithMessage(Exception.class, "Concurrent map pending output capacity cannot preserve accepted results")
    }
}
