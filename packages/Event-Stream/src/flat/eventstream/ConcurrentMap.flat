package flat/eventstream

import flat/future

/**
 * Bounded mapping of typed Future payloads. A mapper transfers a Future<Out>
 * whose result obeys Future's generic representation contract (including boxed
 * primitive payloads on ES6). The operation preserves that payload and reference
 * identity; it never guesses Out from JS typeof or normalizes arbitrary values.
 * Native producers must use a typed completion boundary, not raw JS resolution.
 */
class<In, Out> {
    public static unordered<In, Out>(
        BoundedFlow<In> input,
        func(In value) -> Future<Out>,
        Int maxParallel,
        Int outputCapacity,
        Int maxPendingOutputSends = maxParallel
    ) -> ConcurrentMapOperation<In, Out> {
        let funcs = Array<mapFunc(In) -> Future<Out>>()
        funcs.add(func)

        let operation = ConcurrentMapOperation<In, Out>(
            input,
            funcs,
            false,
            maxParallel,
            0,
            outputCapacity,
            maxPendingOutputSends
        )
        operation.start()
        return operation
    }

    public static ordered<In, Out>(
        BoundedFlow<In> input,
        func(In value) -> Future<Out>,
        Int maxParallel,
        Int maxReorder,
        Int outputCapacity,
        Int maxPendingOutputSends = maxParallel
    ) -> ConcurrentMapOperation<In, Out> {
        let funcs = Array<mapFunc(In) -> Future<Out>>()
        funcs.add(func)

        let operation = ConcurrentMapOperation<In, Out>(
            input,
            funcs,
            true,
            maxParallel,
            maxReorder,
            outputCapacity,
            maxPendingOutputSends
        )
        operation.start()
        return operation
    }
}
