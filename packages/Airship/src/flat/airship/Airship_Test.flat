    test `child package arguments retain explicit generated compiler selection`() {
        let script = File("test/stage_subprocess_guard.cjs").normalizedLocation
        let parent = Airship(["--use-links", "--flatc-runtime", "flat", "--flatc-script", script, "-t", "es6"])
        let args = ["-f", parent.packageLocation.normalizedLocation]
        parent.propagateArgs(args)
        let child = Airship(args, parent)
        expect(child.cliArgs.flatcRuntimeValueArg.value).toBe("flat")
        expect(child.cliArgs.flatcScriptValueArg.value).toBe(script)
        expect(child.cliArgs.flatcJarArg.enabled).toBe(false)
