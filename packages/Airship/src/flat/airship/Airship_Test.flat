        expect(args[args.indexOf("-o") + 1]).toBe(source.outFile)
        expect(args[args.indexOf("-main") + 1]).toBe(source.mainClass)
        expect(args.contains("-library")).toBe(false)
        expect(args.contains("-app-props")).toBe(false)
        expect(args.contains("-install-dir")).toBe(false)
        expect(args.contains("-parallel")).toBe(false)
    }

    test async `forwards Flat library package dependencies and exclusions`() {
        let airship = Airship(["--flatc-runtime", "flat", "--use-links", "-t", "es6"])
        let packages = airship.getWorkspacePackagesDirectory()
        let dependency = LocalDependency(packages.normalizedLocation + "/Flat")
        let writer = LocalDependency(packages.normalizedLocation + "/Flat-ES6")
        let source = airship.getSourceForPackage("main").copy(mainClass: null, dependencies: [dependency])
        let args = airship.installService.getFlatcInstallArguments("main", source)
        let response = airship.dependencyService.getCompilationDependencies(source, download: false)

        expect(args.contains("-library")).toBe(true)
        expect(args.contains("-main")).toBe(false)
        expect(args[args.indexOf("-o") + 1]).toBe(source.outFile)
        expect(response.dependencies.any({ _.getLocation() == dependency.getLocation() })).toBe(true)
        // Assert the actual selected production edges, not an assumed target
        // override. Resolution is local-only and does not acquire dependencies.
        for (edge in airship.dependencyService.getCompilationDependencyPackage(dependency).package.mainSource.dependencies) {
            let resolved = airship.dependencyService.resolveDependency(edge)
            expect(response.dependencies.any({ _.getLocation() == resolved.getLocation() })).toBe(true)
        }
        for (resolved in response.dependencies) {
            let selected = airship.dependencyService.getCompilationDependencyPackage(resolved)
            let production = selected.package.mainSource
            if (production) {
                let location = resolved.getLocation() + "/" + production.source
                expect(args.contains(location)).toBe(true)
                expect(args[args.indexOf(location) - 1]).toBe("-l")
                for (exclusion in production.excludedSources) {
                    let excluded = resolved.getLocation() + "/" + exclusion.location
                    expect(args.contains(excluded)).toBe(true)
                    expect(args[args.indexOf(excluded) - 1]).toBe("-x")
                }
                let testSource = selected.package.testSource?.source
                if (testSource?.contains("*")) {
                    let excluded = selected.packageLocation.normalizedLocation + "/" + testSource
                    expect(args.contains(excluded)).toBe(true)
                    expect(args[args.indexOf(excluded) - 1]).toBe("-x")
                }
            } else {
                // Build-only packages such as Flat-ES6 have no Flat source.
                // The legacy location helper synthesizes /src from null;
                // compilation must not forward that nonexistent source root.
                expect(args.contains(resolved.getLocation() + "/src")).toBe(false)
            }
        }
        expect(airship.dependencyService.getCompilationDependencyPackage(writer).package.mainSource).toBe(null)
        expect(response.dependencies.any({ _.getLocation() == writer.getLocation() })).toBe(true)
        expect(args.contains(writer.getLocation() + "/src")).toBe(false)
        let current = LocalDependency(airship.packageLocation.normalizedLocation)
        let excluded = airship.dependencyService.getDependencySourceGlobLocation(current, "test")
        expect(args.contains(excluded)).toBe(true)
        expect(args[args.indexOf(excluded) - 1]).toBe("-x")
    }

    test async `compilation metadata and closure remain isolated across targets`() {
        let root = Airship(["--flatc-runtime", "flat", "--use-links", "-t", "es6"])
        let packages = root.getWorkspacePackagesDirectory()
        let location = packages.normalizedLocation + "/Flat"
        let dependency = LocalDependency(location)
        // Prime the same path through Dependency.airship: Flat defaults to JS.
        let defaults = dependency.airship
        let defaultMain = defaults.package.mainSource
        expect(defaults.target).toBe("js")
        expect(defaultMain.dependencies.any({ _.name == "Flat-JS" })).toBe(true)
        expect(defaultMain.dependencies.any({ _.name == "Flat-ES6" })).toBe(false)

        let es6 = Airship(["-f", location, "--use-links", "-t", "es6"])
        let es6Main = es6.package.mainSource
        expect(es6.target).toBe("es6")
        expect(es6Main.dependencies.any({ _.name == "Flat-ES6" })).toBe(true)
        // ES6 also includes the JS override by Airship's documented selection.
        expect(es6Main.dependencies.any({ _.name == "Flat-JS" })).toBe(true)

        let source = root.getSourceForPackage("main").copy(
            dependencies: [dependency], defaultExports: Array<DefaultExport>()
        )
        let es6Closure = root.dependencyService.getCompilationDependencies(source, download: false)
        expect(es6Closure.dependencies.any({ _.getLocation() == packages.normalizedLocation + "/Flat-ES6" })).toBe(true)
        expect(es6Closure.dependencies.any({ _.getLocation() == packages.normalizedLocation + "/Flat-JS" })).toBe(true)

        let js = Airship(["-f", location, "--use-links", "-t", "js"])
        expect(js.target).toBe("js")
        expect(js.package.mainSource.dependencies.any({ _.name == "Flat-JS" })).toBe(true)
        expect(js.package.mainSource.dependencies.any({ _.name == "Flat-ES6" })).toBe(false)
        let jsClosure = js.dependencyService.getCompilationDependencies(
            js.package.mainSource, download: false
        )
        expect(jsClosure.dependencies.any({ _.getLocation() == packages.normalizedLocation + "/Flat-JS" })).toBe(true)
        expect(jsClosure.dependencies.any({ _.getLocation() == packages.normalizedLocation + "/Flat-ES6" })).toBe(false)
        // A later target request must not mutate already selected metadata.
        expect(defaultMain.dependencies.any({ _.name == "Flat-ES6" })).toBe(false)
        expect(es6Main.dependencies.any({ _.name == "Flat-ES6" })).toBe(true)
        expect(defaults.target).toBe("js")
        expect(es6.target).toBe("es6")
        let browser = Airship(["-f", location, "--use-links", "-t", "es6", "-r", "browser"])
        expect(browser.targetRuntime).toBe("browser")
        expect(browser.dependencyService.getCompilationDependencyPackage(dependency).targetRuntime).toBe("browser")
        expect(root.dependencyService.getCompilationDependencyPackage(dependency).targetRuntime).toBe("node")
        expect(es6.targetRuntime).toBe("node")
        expect(Object.referenceEquals(browser.package, es6.package)).toBe(false)
        // Invalidating one manifest identity clears every selected context.
        Airship.clearCache(es6)
        let reloadedEs6 = Airship(["-f", location, "--use-links", "-t", "es6"])
        let reloadedJs = Airship(["-f", location, "--use-links", "-t", "js"])
        let reloadedBrowser = Airship(["-f", location, "--use-links", "-t", "es6", "-r", "browser"])
        expect(Object.referenceEquals(reloadedEs6.package, es6.package)).toBe(false)
        expect(Object.referenceEquals(reloadedJs.package, js.package)).toBe(false)
        expect(Object.referenceEquals(reloadedBrowser.package, browser.package)).toBe(false)
        expect(reloadedEs6.package.mainSource.dependencies.any({ _.name == "Flat-ES6" })).toBe(true)
        expect(reloadedJs.package.mainSource.dependencies.any({ _.name == "Flat-ES6" })).toBe(false)
    }

    test async `Flat root tests include only dependency production source closure`() {
        let airship = Airship(["--flatc-runtime", "flat", "--use-links", "-t", "es6"])
        let packages = airship.getWorkspacePackagesDirectory()
        let dependency = LocalDependency(packages.normalizedLocation + "/CoLorIzer")
        let testOnly = LocalDependency(packages.normalizedLocation + "/Flat")
        let production = LocalDependency(packages.normalizedLocation + "/Flat-Java-Compiler")
        let child = airship.dependencyService.getCompilationDependencyPackage(dependency)
        let productionPackage = airship.dependencyService.getCompilationDependencyPackage(production)
        let productionMain = productionPackage.package.mainSource
        let testOnlyPackage = airship.dependencyService.getCompilationDependencyPackage(testOnly)
        let testOnlyMain = testOnlyPackage.package.mainSource
        let main = child.package.mainSource
        let tests = child.package.testSource
        testOnlyPackage.package.mainSource = testOnlyMain.copy(dependencies: Array<Dependency>())
        productionPackage.package.mainSource = productionMain.copy(dependencies: [dependency])
        // Reuse installed package metadata as an in-memory fixture. No package
        // files are changed, and cached metadata is restored even on red.
        child.package.mainSource = main.copy(
            dependencies: [production],
            excludedSources: [ExcludedSource("src/production-excluded.flat")]
        )
        child.package.testSource = tests.copy(
            dependencies: [production, testOnly],
            excludedSources: [ExcludedSource("src/test-excluded.flat")]
        )
        try {
            let source = airship.getSourceForPackage("test").copy(
                dependencies: [dependency], defaultExports: Array<DefaultExport>()
            )
            let closure = airship.dependencyService.getCompilationDependencies(source, download: false)
            expect(closure.dependencies.count).toBe(2)
            expect(closure.dependencies.filter({ _.getLocation() == dependency.getLocation() }).count).toBe(1)
            expect(closure.dependencies.filter({ _.getLocation() == production.getLocation() }).count).toBe(1)
            expect(closure.dependencies.any({ _.getLocation() == testOnly.getLocation() })).toBe(false)
            // Installation still follows the requested dependency test source.
            let installation = airship.dependencyService.getDependenciesForSource("test", source, download: false)
            expect(installation.dependencies.any({ _.getLocation() == testOnly.getLocation() })).toBe(true)
            let args = airship.installService.getFlatcInstallArguments("test", source)
            let root = airship.packageLocation.normalizedLocation
            let location = child.packageLocation.normalizedLocation

            expect(args.contains(root + "/src")).toBe(true)
            expect(args.contains(root + "/" + source.source)).toBe(true)
            expect(args[args.indexOf("-main") + 1]).toBe(source.mainClass)
            expect(args.contains(location + "/" + main.source)).toBe(true)
            expect(args[args.indexOf(location + "/" + main.source) - 1]).toBe("-l")
            // A test glob must be excluded, not passed as dependency input.
            expect(args.contains(location + "/" + tests.source)).toBe(true)
            expect(args[args.indexOf(location + "/" + tests.source) - 1]).toBe("-x")
            expect(args.contains(location + "/src/production-excluded.flat")).toBe(true)
            expect(args[args.indexOf(location + "/src/production-excluded.flat") - 1]).toBe("-x")
            expect(args.contains(location + "/src/test-excluded.flat")).toBe(false)
            expect(args.contains(production.getLocation() + "/src")).toBe(true)
            expect(args[args.indexOf(production.getLocation() + "/src") - 1]).toBe("-l")
            expect(args.contains(testOnly.getLocation() + "/src")).toBe(false)
            expect(args[args.indexOf(root + "/" + source.source) - 1] == "-x").toBe(false)
        } finally {
            child.package.mainSource = main
            child.package.testSource = tests
            testOnlyPackage.package.mainSource = testOnlyMain
            productionPackage.package.mainSource = productionMain
        }
    }

    test async `Flat production compilation excludes explicit root and dependency test paths`() {
        let airship = Airship(["--flatc-runtime", "flat", "--use-links", "-t", "es6"])
        let dependency = LocalDependency(airship.getWorkspacePackagesDirectory().normalizedLocation + "/CoLorIzer")
        let child = airship.dependencyService.getCompilationDependencyPackage(dependency)
        let rootTests = airship.package.testSource
        let main = child.package.mainSource
        let tests = child.package.testSource
        let testPaths = ["src/Explicit_Test.flat", "src/tests"]
        child.package.mainSource = main.copy(dependencies: Array<Dependency>(), defaultExports: Array<DefaultExport>())
        try {
            for (testPath in testPaths) {
                airship.package.testSource = rootTests.copy(source: testPath)
                child.package.testSource = tests.copy(source: testPath)
                let source = airship.getSourceForPackage("main").copy(
                    dependencies: [dependency], defaultExports: Array<DefaultExport>()
                )
                let args = airship.installService.getFlatcInstallArguments("main", source)
                let rootExclusion = airship.packageLocation.normalizedLocation + "/" + testPath
                let dependencyExclusion = child.packageLocation.normalizedLocation + "/" + testPath
                expect(args.contains(rootExclusion)).toBe(true)
                expect(args[args.indexOf(rootExclusion) - 1]).toBe("-x")
                expect(args.contains(dependencyExclusion)).toBe(true)
                expect(args[args.indexOf(dependencyExclusion) - 1]).toBe("-x")

                let testSource = airship.getSourceForPackage("test").copy(
                    dependencies: [dependency], defaultExports: Array<DefaultExport>()
                )
                let testArgs = airship.installService.getFlatcInstallArguments("test", testSource)
                // Selected root tests are inputs; dependency tests remain excluded.
                expect(testArgs[testArgs.indexOf(rootExclusion) - 1] == "-x").toBe(false)
                expect(testArgs[testArgs.indexOf(dependencyExclusion) - 1]).toBe("-x")
            }
        } finally {
            airship.package.testSource = rootTests
            child.package.mainSource = main
            child.package.testSource = tests
        }
    }

    test async `Flat dependency default imports are selected from production not tests`() {
        let airship = Airship(["--flatc-runtime", "flat", "--use-links", "-t", "es6"])
        let packages = airship.getWorkspacePackagesDirectory()
        let dependency = LocalDependency(packages.normalizedLocation + "/CoLorIzer")
        let child = airship.dependencyService.getCompilationDependencyPackage(dependency)
        let main = child.package.mainSource
        let tests = child.package.testSource
        child.package.mainSource = main.copy(
            dependencies: Array<Dependency>(), defaultExports: Array<DefaultExport>()
        )
        child.package.testSource = tests.copy(
            dependencies: Array<Dependency>(),
            defaultExports: [DefaultExport("flat/test/Test", true)]
        )
        try {
            let source = airship.getSourceForPackage("test").copy(
                dependencies: [dependency], defaultExports: Array<DefaultExport>()
            )
            // Dependency test exports are irrelevant; only production defaults
            // enter the root compilation's configured import contract.
            let args = airship.installService.getFlatcInstallArguments("test", source)
            expect(args.contains("-default-static-import")).toBe(false)
            child.package.mainSource = child.package.mainSource.copy(
                defaultExports: [DefaultExport("flat/io", false), DefaultExport("flat/test/Test", true)]
            )
            child.package.testSource = child.package.testSource.copy(
                defaultExports: Array<DefaultExport>()
            )
            let productionArgs = airship.installService.getFlatcInstallArguments("test", source)
            expect(productionArgs[productionArgs.indexOf("-default-import") + 1]).toBe("flat/io")
            expect(productionArgs[productionArgs.indexOf("-default-static-import") + 1]).toBe("flat/test/Test")
        } finally {
            child.package.mainSource = main
            child.package.testSource = tests
        }
    }

    test async `Flat root test dependencies forward Test production default imports`() {
        let airship = Airship(["--flatc-runtime", "flat", "--use-links", "-t", "es6"])
        let packages = airship.getWorkspacePackagesDirectory()
        let dependency = LocalDependency(packages.normalizedLocation + "/Test")
        let source = airship.getSourceForPackage("test").copy(
            dependencies: [dependency], defaultExports: Array<DefaultExport>()
        )
        let defaults = airship.dependencyService.getCompilationDependencyPackage(dependency).package.mainSource.defaultExports
        expect(defaults.count > 0).toBe(true)
        let args = airship.installService.getFlatcInstallArguments("test", source)
        for (value in defaults) {
            let flag = value.staticImport ? "-default-static-import" : "-default-import"
            expect(args[args.indexOf(value.location) - 1]).toBe(flag)
        }
    }

    test async `selects the workspace Flat compiler artifact rather than the global bin`() {
        let airship = Airship(["--flatc-runtime", "flat", "--use-links", "-t", "es6"])
        let command = airship.installService.getFlatCompilerCommand()
        let packages = airship.getWorkspacePackagesDirectory()

        expect(command[0]).toBe("node")
        expect(command[1]).toBe(packages.normalizedLocation + "/Flat-Compiler/dist/es6/index.js")
        expect(command.contains(Airship.flatHome + "/bin/flatc")).toBe(false)
    }

    test async `omitted source dependencies remain an empty source-owned list`() {
        let root = File(".airship-optional-dependencies-#{Time.currentTimeMillis}")
        root.mkdirs()
        try {
            FileWriter(File(root, "flat.json")):write(
                "{\"name\":\"Optional dependencies\",\"defaultTarget\":\"es6\",\"sources\":{\"main\":{\"source\":\"src\"},\"test\":{\"source\":\"test\"}}}"):close()
            let airship = Airship(["--use-links", "-f", root.normalizedLocation, "-t", "es6"])
            // Loading adds real implicit Core, not a fabricated empty closure.
            expect(airship.package.mainSource.dependencies.count).toBe(1)
            expect(airship.package.testSource.dependencies.count).toBe(1)
            expect(airship.package.mainSource.dependencies.first.name).toBe("Flat-Core")
        } finally {
            if (File(root, "flat.json").isFile) Airship.clearCache(File(root, "flat.json").normalizedLocation)
            root.delete(recursive: true)
        }
    }

    test `entrypoint accepts generated user argv and legacy script-prefixed argv`() {
        let generated = Airship.getUserArguments(["--use-links", "install"], 2)
        let legacy = Airship.getUserArguments(["airship.js", "--use-links", "install"], 2)
        expect(generated.join("|")).toBe("--use-links|install")
        expect(legacy.join("|")).toBe("--use-links|install")
        expect(Airship.getUserArguments(["install"], 1).first).toBe("install")
        expect({ Airship.getUserArguments(String[], 0) }).toThrow(Exception.class)
        expect({ Airship.getUserArguments(["unexpected", "prefix", "install"], 1) }).toThrow(Exception.class)
    }

    test async `accepts explicit Node runtime without forwarding an unsupported compiler flag`() {
        let airship = Airship(["--flatc-runtime", "flat", "--use-links", "-t", "es6", "-r", "node"])
        let source = airship.getSourceForPackage("main").copy(dependencies: Array<Dependency>())
        let args = airship.installService.getFlatcInstallArguments("main", source)
        expect(airship.targetRuntime).toBe("node")
        expect(args.contains("-target-runtime")).toBe(false)
        expect(args.contains("-r")).toBe(false)
    }

    test async `rejects unsupported Flat targets and runtimes before dependency acquisition`() {
        let browser = Airship(["--flatc-runtime", "flat", "--use-links", "-t", "es6", "-r", "browser"])
        assertAsyncThrows(async { browser.installService.install("main") }, ExecutionFailureException.class,
            "Flat compiler supports only target runtime node")
        let java = Airship(["--flatc-runtime", "flat", "--use-links", "-t", "java"])
        assertAsyncThrows(async { java.installService.install("main") }, ExecutionFailureException.class,
            "Flat compiler supports only target es6")
    }

    test async `run rejects malformed command entries instead of silently succeeding`() {
        let root = File(".airship-invalid-script-#{Time.currentTimeMillis}")
        root.mkdirs()
        try {
            FileWriter(File(root, "flat.json")):write(
                "{\"name\":\"Invalid script fixture\",\"scripts\":{\"unsupported\":[7],\"emptyArgv\":[[]],\"emptyValue\":null,\"scalar\":7},\"sources\":{\"main\":{\"source\":\"src\"}}}"):close()
            let airship = Airship(["--use-links", "-f", root.normalizedLocation, "-t", "es6"])
            assertAsyncThrows(async { airship.runScriptService.runScript("unsupported") }, InvalidScriptException.class,
                "Script command 'unsupported' contains an unsupported command")
            assertAsyncThrows(async { airship.runScriptService.runScript("emptyArgv") }, InvalidScriptException.class,
                "Script command 'emptyArgv' contains an empty argv command")
            assertAsyncThrows(async { airship.runScriptService.runScript("emptyValue") }, InvalidScriptException.class,
                "Script command 'emptyValue' has no command")
            assertAsyncThrows(async { airship.runScriptService.runScript("scalar") }, InvalidScriptException.class,
                "Script command 'scalar' contains an unsupported command")
        } finally {
            if (File(root, "flat.json").isFile) Airship.clearCache(File(root, "flat.json").normalizedLocation)
            root.delete(recursive: true)
        }
    }

    test async `legacy alternate test entry keeps its own declared selector`() {
        let airship = Airship(["--use-links", "-t", "es6"])
        let source = airship.getSourceForPackage("toolchain-test")
        let args = airship.installService.getLegacyInstallArguments("toolchain-test", source)
        let selected = InstallService.sanitizeFileLocation(airship.packageLocation.normalizedLocation + "/" + source.source)
        expect(source.source).toBe(airship.package.testSource.source)
        expect(args.contains(selected)).toBe(true)
        var Int index
        while (index < args.count - 1) {
            if (args[index] == "-x") expect(args[index + 1] == selected).toBe(false)
            index++
        }
        expect(args[args.indexOf("-main") + 1]).toBe(source.mainClass)
    }

    test async `custom test entry sharing the declared test selector does not exclude itself`() {
        let airship = Airship(["--flatc-runtime", "flat", "--use-links", "-t", "es6"])
        let source = airship.getSourceForPackage("owned-process-test").copy(dependencies: Array<Dependency>())
        let args = airship.installService.getFlatcInstallArguments("owned-process-test", source)
        let selected = airship.packageLocation.normalizedLocation + "/" + source.source
        expect(source.source).toBe(airship.package.testSource.source)
        expect(args.contains(selected)).toBe(true)
        expect(args.contains("-x")).toBe(false)
    }

    test async `explicit missing install source fails instead of reporting success`() {
        let airship = Airship(["--flatc-runtime", "flat", "--use-links", "-t", "es6"])
        assertAsyncThrows(async { airship.installService.install("not-a-source") }, InvalidCommandException.class,
            "Package #{airship.package.name} has no source named not-a-source")
    }

    test async `forwards Flat library directory-only output`() {
        let airship = Airship(["--flatc-runtime", "flat", "--use-links", "-t", "es6"])
        let source = airship.getSourceForPackage("main").copy(mainClass: null, outFile: null, dependencies: Array<Dependency>())
        let args = airship.installService.getFlatcInstallArguments("main", source)

        expect(args.contains("-library")).toBe(true)
        expect(args.contains("-d")).toBe(true)
        expect(args.contains("-o")).toBe(false)
    }

    test async `forwards Flat root default import owner paths and staticness`() {
        let airship = Airship(["--flatc-runtime", "flat", "--use-links", "-t", "es6"])
        let source = airship.getSourceForPackage("main").copy(
            defaultExports: [DefaultExport("flat/io", false), DefaultExport("flat/test/Test", true)],
            dependencies: Array<Dependency>()
        )
        let args = airship.installService.getFlatcInstallArguments("main", source)

        expect(args[args.indexOf("-default-import") + 1]).toBe("flat/io")
        expect(args[args.indexOf("-default-static-import") + 1]).toBe("flat/test/Test")
        expect(args.contains(airship.packageLocation.normalizedLocation + "/flat/io")).toBe(false)
    }

    test `preserves declared Git transport`() {
        let ssh = GitDependency("git@github.com:FlatLang/Test.git", "master")
        let https = GitDependency("https://github.com/FlatLang/Test.git", "master")

        expect(ssh.getUrl()).toBe("git@github.com:FlatLang/Test.git")
        expect(https.getUrl()).toBe("https://github.com/FlatLang/Test.git")
        expect(https.getUrl("ssh")).toBe("git@github.com:FlatLang/Test.git")
        expect(ssh.getUrl("https")).toBe("https://github.com/FlatLang/Test.git")
        expect(ssh.packageRootLocation).toBe(https.packageRootLocation)
    }
}
