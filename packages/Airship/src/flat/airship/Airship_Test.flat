    test async `compiler output admission removes stale file but not sibling and accepts deterministic rewrite`() {
        let airship = Airship(["-t", "es6"])
        let directory = File(".airship-output-admission-#{Time.currentTimeMillis}")
        directory.mkdirs()
        let output = File(directory, "selected.js")
        let sibling = File(directory, "sibling.js")
        try {
            FileWriter(output):write("deterministic bytes"):close()
            FileWriter(sibling):write("unrelated artifact"):close()
            let source = airship.getSourceForPackage("main").copy(
                outDirectory: directory.normalizedLocation, outFile: "selected.js")
            let selected = airship.installService.prepareCompilerOutput(source)
            expect(output.exists).toBe(false)
            expect(sibling.isFile).toBe(true)
            expect({ airship.installService.validateCompilerResult(0, selected) })
                .toThrow(FlatInstallationFailureException.class)
            FileWriter(output):write("deterministic bytes"):close()
            expect({ airship.installService.validateCompilerResult(0, selected) })
                .toNotThrow(FlatInstallationFailureException.class)
        } finally {
            directory.delete(recursive: true)
        }
    }

    test async `legacy compiler command rejects zero exit no output and removes nonzero partial output`() {
        let String[] runtimes = ["java"]
        for (runtime in runtimes) {
            let Airship airship = Airship(["-t", "es6", "--flatc-runtime", runtime])
            let directory = File(".airship-compiler-failure-#{Time.currentTimeMillis}")
            directory.mkdirs()
            let output = File(directory, "selected.js")
            let fixture = File(directory, "status-fixture.js")
            try {
                // This subprocess fixture tests installation lifecycle only, not
                // language compilation or production compiler acceptance.
                let PackageSource source = airship.getSourceForPackage("main").copy(
                    outDirectory: directory.normalizedLocation, outFile: "selected.js")
                FileWriter(output):write("stale artifact"):close()
                FileWriter(fixture):write("process.exit(0);"):close()
                assertAsyncThrows(async { airship.installService.executeCompilerCommand(source, ["node", fixture.normalizedLocation]) }, FlatInstallationFailureException.class)
                expect(output.exists).toBe(false)

                FileWriter(fixture):write("require('fs').writeFileSync(process.argv[2], 'partial'); process.exit(7);"):close()
                assertAsyncThrows(async { airship.installService.executeCompilerCommand(source,
                    ["node", fixture.normalizedLocation, output.normalizedLocation]) }, FlatInstallationFailureException.class, "Compilation failed: exit code 7")
                expect(output.exists).toBe(false)

                FileWriter(fixture):write("require('fs').writeFileSync(process.argv[2], 'complete');"):close()
                airship.installService.executeCompilerCommand(source,
                    ["node", fixture.normalizedLocation, output.normalizedLocation])
                expect(output.isFile).toBe(true)
            } finally {
                directory.delete(recursive: true)
            }
        }
    }

