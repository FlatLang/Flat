package flat/airship

import flat/test/TestResult

[TestSuite [AirshipOwnedProcess_Test]]
class {
    public static async main(String[] args) {
        let results = TestResult[]
        AirshipOwnedProcess_TestSuite().runTests({ results.add(_) })
        let failures = results.filter({ !_.success })
        failures.forEach({ Console.log("#_") })
        Console.writeLine("Ordinary process companion: #results.count cases, #failures.count failures")
        if (failures.count > 0) System.exit(1)
    }
}
