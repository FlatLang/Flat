package flat/airship/services

import flat/airship
import flat/log
import flat/io

class {
    static Logger log = Logger(RunScriptService.class)

    public construct(
        private Airship airship,
        private AirshipCli cliArgs
    ) {}

    /** Only the conventional single Node entrypoint is an argv command.
     * This is not shell tokenization: quoting, expansion, flags and operators
     * retain the explicit shell route and remain subject to caller admission.
     */
    public getNodeScriptArguments(String command) -> String[] {
        if (!command.startsWith("node ")) return null
        var String path = command.substring(5)
        if (path.startsWith("./")) path = path.substring(2)
        if (path.isEmpty || !path.endsWith(".js") || path.startsWith("/") || path.startsWith("-") || path.contains("..")) return null
        var Int index
        while (index < path.count) {
            // Explicit integer conversion avoids mixed Char comparison lowering
            // in the reviewed bootstrap compiler; the ASCII allowlist is unchanged.
            let Int code = (Int)path[index]
            if (!((code >= 97 && code <= 122) || (code >= 65 && code <= 90) ||
                (code >= 48 && code <= 57) || code == 47 || code == 46 ||
                code == 95 || code == 45)) return null
            index++
        }
        return ["node", command.substring(5)]
    }

    async executeScriptString(String command, String workingDirectory) -> Int {
        if (let arguments = getNodeScriptArguments(command)) {
            let fullArguments = Array<String>():addAll(arguments):addAll(cliArgs.propagationArgs.values)
            if (airship.debug) {
                Console.writeLine(fullArguments.map({ System.sanitizeCliArgument(_) }).join(" "))
                return 0
            }
            return AirshipProcess.execute(fullArguments, workingDirectory, silent: cliArgs.quietArg.enabled)
        }
        var fullCommand = command
        if (cliArgs.propagationArgs.enabled) {
            fullCommand += cliArgs.propagationArgs.values.map({ System.sanitizeCliArgument(_) }).stitchFront(" ")
        }
        if (airship.debug) {
            Console.writeLine(fullCommand)
            return 0
        }
        return AirshipProcess.executeShell(fullCommand, workingDirectory, silent: cliArgs.quietArg.enabled)
    }

    public async runScripts(String[] scripts) {
        scripts.forEachAsync({ runScript(_) })
    }

    public async runScript(String script) {
        if (!airship.package?.scripts?.containsKey(script)) {
            throw InvalidScriptException("Script command '#script' is not defined")
        }

        let workingDirectory = airship.flatJsonFile.getParent().location
        let cmd = airship.package.scripts[script]

        if (cmd?.class.isOfType(Array.class)) {
            let Object[] array = (Object[])cmd

            if (array.isEmpty) {
                return
            }

            for (obj in array) {
                if (obj.class.isOfType(Array.class)) {
                    let String[] c = (Array)obj
                    let fullCmd = Array<String>():addAll(c):addAll(airship.cliArgs.propagationArgs.values)

                    if (airship.debug) {
                        Console.writeLine(fullCmd.map({ System.sanitizeCliArgument(_) }).join(" "))
                    } else {
                        let status = AirshipProcess.execute(fullCmd, workingDirectory, silent: cliArgs.quietArg.enabled)

                        if (status != 0) {
                            throw ExecutionFailureException("Script exited with exit code #status")
                        }
                    }
                } else if (obj.class.isOfType(String.class)) {
                    let String c = (String)obj
                    let status = executeScriptString(c, workingDirectory)
                    if (status != 0) {
                        throw ExecutionFailureException("Script exited with exit code #status")
                    }
                }
            }

            return
        } else {
            let status = executeScriptString(cmd.toString(), workingDirectory)

            if (status != 0) {
                throw ExecutionFailureException("Script exited with exit code #status")
            }
        }
    }
}