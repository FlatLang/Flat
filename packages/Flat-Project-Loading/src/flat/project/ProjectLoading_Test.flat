package flat/project

import flat/compiler/models
import flat/datastruct/HashMap

testable class {
    test `ES6 source selection rejects foreign and trailing extensions and orders overlays`() {
        expect(Es6SourceSelection.accepts("src/Value.flat")).toBe(true)
        expect(Es6SourceSelection.accepts("src/Value.js.flat")).toBe(true)
        expect(Es6SourceSelection.accepts("src/Value.es6.flat")).toBe(true)
        expect(Es6SourceSelection.accepts("src/Value.java.flat")).toBe(false)
        expect(Es6SourceSelection.accepts("src/Value.flat.bak")).toBe(false)
        expect(Es6SourceSelection.baseLocation("src/Value.es6.flat")).toBe("src/Value.flat")
        let overlayLocations = ["src/Value.es6.flat", "src/Value.js.flat", "src/Value.flat"]
        let ordered = overlayLocations.sort({ Es6SourceSelection.compare(_a, _b) })
        expect(ordered).toBe(["src/Value.flat", "src/Value.js.flat", "src/Value.es6.flat"])
    }

    test `project import configuration rejects empty aliases and preserves separate snapshots`() {
        var Int rejected
        try { ProjectImport("flat/example/Value", alias: "") }
        catch (Exception error) { rejected++ }
        try { ProjectImport("flat/example/Value", alias: "   ") }
        catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
        let roots = [SourceRoot("src")]
        let imports = [ProjectImport("flat/example/Value", alias: "Renamed")]
        let defaults = [DefaultImport("flat/example/Helpers", true)]
        let package = ProjectPackage("snapshots", roots, imports: imports, defaultImports: defaults)
        roots.clear()
        imports.clear()
        defaults.clear()
        expect(package.sourceRoots.count).toBe(1)
        expect(package.imports.count).toBe(1)
        expect(package.imports.first.alias).toBe("Renamed")
        expect(package.imports.first.staticImport).toBe(false)
        expect(package.defaultImports.count).toBe(1)
        expect(package.defaultImports.first.staticImport).toBe(true)
        expect(ProjectImport("flat/example/Value").alias).toBe(null)
    }

    test `project model owns immutable package dependency import and target options`() {
        let properties = HashMap<String, String>():add("name", "Example")
        let options = CompilerOptions(
            "es6",
            runtime: "node",
            mainClass: "flat/example/Main",
            outputFile: "example.js",
            outputDirectory: "dist/es6",
            maxConcurrency: 4,
            applicationProperties: properties
        )
        let package = ProjectPackage(
            "flat/example",
            [SourceRoot("src")],
            dependencies: [ProjectDependency("flat/system", "packages/System", local: true)],
            imports: [ProjectImport("flat/example/Value", alias: "Value")],
            defaultImports: [DefaultImport("flat/core/Object")],
            exclusions: [SourceExclusion("src/generated")]
        )
        let project = ProjectModel("workspace:example", [package], options)
        properties["name"] = "Changed"

        expect(project.packages.first.name).toBe("flat/example")
        expect(project.packages.first.dependencies.first.local).toBe(true)
        expect(project.packages.first.imports.first.alias).toBe("Value")
        expect(project.packages.first.defaultImports.first.location).toBe("flat/core/Object")
        expect(project.packages.first.exclusions.first.location).toBe("src/generated")
        expect(project.options.target).toBe("es6")
        expect(project.options.runtime).toBe("node")
        expect(project.options.maxConcurrency).toBe(4)
        expect(project.options.applicationProperties["name"]).toBe("Example")
    }

    test `project configuration rejects null members before discovery`() {
        var Int rejected
        try { ProjectPackage("invalid", [null]) } catch (Exception error) { rejected++ }
        try { ProjectPackage("invalid", [SourceRoot("src")], dependencies: [null]) }
        catch (Exception error) { rejected++ }
        try { ProjectPackage("invalid", [SourceRoot("src")], exclusions: [null]) }
        catch (Exception error) { rejected++ }
        try { ProjectModel("invalid", [null], CompilerOptions("es6", library: true)) }
        catch (Exception error) { rejected++ }
        expect(rejected).toBe(4)
    }

    test `filesystem provider rejects invalid bounds and accepts an exact source bound`() {
        var Int rejected
        try { FilesystemSourceProvider("res/sources", maxSources: 0) } catch (Exception error) { rejected++ }
        try { FilesystemSourceProvider("res/sources", maxDirectories: 0) } catch (Exception error) { rejected++ }
        try { FilesystemSourceProvider("res/sources", maxDepth: 0) } catch (Exception error) { rejected++ }
        expect(rejected).toBe(3)
        let provider = FilesystemSourceProvider("res/sources", maxSources: 1)
        expect(provider.identities().count).toBe(1)
    }

    test `project model rejects invalid target mode and ownership`() {
        var Int rejected
        try { CompilerOptions("", mainClass: "Main") } catch (Exception error) { rejected++ }
        try { CompilerOptions("es6", library: true, mainClass: "Main") } catch (Exception error) { rejected++ }
        try { CompilerOptions("es6") } catch (Exception error) { rejected++ }
        try { CompilerOptions("es6", mainClass: "Main", maxConcurrency: 0) } catch (Exception error) { rejected++ }
        try { ProjectPackage("flat/example", SourceRoot[]) } catch (Exception error) { rejected++ }
        try { ProjectModel("", [ProjectPackage("flat/example", [SourceRoot("src")])], CompilerOptions("es6", library: true)) } catch (Exception error) { rejected++ }
        expect(rejected).toBe(6)
    }

    test `Airship compiler arguments map every required build option`() {
        let project = AirshipCompilerArguments().fromArguments([
            "src", "-l", "packages/System", "-x", "src/generated",
            "-main", "flat/example/Main", "-o", "example.js", "-d", "dist/es6",
            "-target", "es6", "-target-runtime", "node",
            "-default-import", "flat/core/Object",
            "-default-static-import", "flat/core/Console",
            "-app-props", "name=Example,version=1.0.0",
            "-threads", "4", "-parallel"
        ])
        let package = project.packages.first
        expect(package.sourceRoots.first.location).toBe("src")
        expect(package.dependencies.first.sourceLocation).toBe("packages/System")
        expect(package.exclusions.first.location).toBe("src/generated")
        expect(package.defaultImports.count).toBe(2)
        expect(package.defaultImports.last.staticImport).toBe(true)
        expect(project.options.mainClass).toBe("flat/example/Main")
        expect(project.options.outputFile).toBe("example.js")
        expect(project.options.outputDirectory).toBe("dist/es6")
        expect(project.options.target).toBe("es6")
        expect(project.options.runtime).toBe("node")
        expect(project.options.maxConcurrency).toBe(4)
        expect(project.options.applicationProperties["version"]).toBe("1.0.0")
    }

    test `Airship concurrency rejects partial numbers signs and overflow`() {
        var Int rejected
        let invalid = ["", "0", "1x", "+2", "-2", "1.5", "2147483648", "999999999999"]
        for (value in invalid) {
            try { AirshipCompilerArguments.parsePositiveCapacity(value) }
            catch (Exception error) { rejected++ }
        }
        expect(rejected).toBe(invalid.count)
        expect(AirshipCompilerArguments.parsePositiveCapacity("1")).toBe(1)
        expect(AirshipCompilerArguments.parsePositiveCapacity("2147483647")).toBe(2147483647)
        expect(AirshipCompilerArguments.parsePositiveCapacity("2147483640")).toBe(2147483640)
        expect(AirshipCompilerArguments.parsePositiveCapacity("0002")).toBe(2)
        expect(AirshipCompilerArguments().fromArguments([
            "src", "-library", "-threads", "2"
        ]).options.maxConcurrency).toBe(2)
        var Int rejectedArguments
        let invalidArguments = ["2147483648", "21474836470", "2x", "0"]
        for (value in invalidArguments) {
            try {
                AirshipCompilerArguments().fromArguments(["src", "-library", "-threads", value])
            } catch (Exception error) { rejectedArguments++ }
        }
        expect(rejectedArguments).toBe(4)
    }

    test `Airship library arguments map library mode and reject unsupported options`() {
        let library = AirshipCompilerArguments().fromArguments([
            "src", "-library", "-target", "es6"
        ])
        expect(library.options.library).toBe(true)
        expect(library.options.mainClass).toBe(null)

        var Bool rejected
        try { AirshipCompilerArguments().fromArguments(["src", "-unknown"]) } catch (Exception error) { rejected = true }
        expect(rejected).toBe(true)
    }

    test `in memory provider publishes immutable snapshots`() {
        let provider = InMemorySourceProvider()
        let identity = SourceIdentity("memory:Example.flat")
        provider.add(identity, "sha256:abc", "class Example {}")
        let loaded = provider.load(identity)

        expect(provider.identities()).toBe([identity])
        expect(loaded.snapshot.value).toBe("memory:Example.flat@sha256:abc")
        expect(loaded.contents).toBe("class Example {}")
    }

    test `explicit concurrency wins over parallel hint in either argument order`() {
        let adapter = AirshipCompilerArguments()
        expect(adapter.fromArguments(["src", "-library", "-parallel", "-threads", "1"])
            .options.maxConcurrency).toBe(1)
        expect(adapter.fromArguments(["src", "-library", "-threads", "1", "-parallel"])
            .options.maxConcurrency).toBe(1)
        expect(adapter.fromArguments(["src", "-library", "-parallel"])
            .options.maxConcurrency).toBe(2)
    }

    test `argument contracts reject empty values exclusions defaults and property keys`() {
        let options = ["-x", "-default-import", "-default-static-import", "-target-runtime", "-o", "-d"]
        var Int rejected
        for (option in options) {
            try { AirshipCompilerArguments().fromArguments(["src", "-library", option, " "]) }
            catch (Exception error) { rejected++ }
            try { AirshipCompilerArguments().fromArguments(["src", "-library", option]) }
            catch (Exception error) { rejected++ }
        }
        try { AirshipCompilerArguments().fromArguments(["src", "-library", "-app-props", " =value"]) }
        catch (Exception error) { rejected++ }
        expect(rejected).toBe(options.count * 2 + 1)
    }

    test `source and dependency contracts preserve a closure beyond sixty four entries`() {
        let arguments = ["-library"]
        for (index in 0..96) {
            arguments.add("sources/#index")
            arguments.addAll(["-l", "dependencies/#index", "-x", "excluded/#index"])
            arguments.addAll(["-default-import", "flat/defaults/Value#index"])
        }
        let package = AirshipCompilerArguments().fromArguments(arguments).packages.first
        expect(package.sourceRoots.count).toBe(96)
        expect(package.dependencies.count).toBe(96)
        expect(package.exclusions.count).toBe(96)
        expect(package.defaultImports.count).toBe(96)
        expect(package.sourceRoots.last.location).toBe("sources/95")
        expect(package.dependencies.last.sourceLocation).toBe("dependencies/95")
        expect(package.exclusions.last.location).toBe("excluded/95")
        expect(package.defaultImports.last.location).toBe("flat/defaults/Value95")
    }

    test `overlay acceptance agrees with case sensitive identity and rank`() {
        expect(Es6SourceSelection.accepts("Value.JS.flat")).toBe(false)
        expect(Es6SourceSelection.accepts("Value.ES6.flat")).toBe(false)
        let locations = ["B.es6.flat", "A.es6.flat", "B.flat", "A.js.flat", "A.flat"]
        expect(locations.sort({ Es6SourceSelection.compare(_a, _b) }))
            .toBe(["A.flat", "A.js.flat", "A.es6.flat", "B.flat", "B.es6.flat"])
    }

    test `filesystem byte capacity rejects oversized loads without poisoning the provider`() {
        var Int rejected
        try { FilesystemSourceProvider("res/sources", maxSourceBytes: 0) }
        catch (Exception error) { rejected++ }
        let small = FilesystemSourceProvider("res/sources", maxSourceBytes: 16)
        try { small.load(small.identities().first) }
        catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
        expect(small.identities().count).toBe(1)
        let exact = FilesystemSourceProvider("res/sources", maxSourceBytes: 17)
        expect(exact.load(exact.identities().first).contents.count).toBe(17)
    }

    test `filesystem entry capacity rejects invalid bounds and admits the exact inventory`() {
        var Int rejected
        try { FilesystemSourceProvider("res/sources", maxEntries: 0) }
        catch (Exception error) { rejected++ }
        try { FilesystemSourceProvider("res/sources", maxEntries: -1) }
        catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
        expect(FilesystemSourceProvider("res/sources", maxEntries: 1).identities().count).toBe(1)
    }

    test `bounded filesystem inventory charges hidden non-source and nested entries before filtering`() {
        // Five immediate entries, then one child in nested: the root budget is
        // aggregate, not reset for each directory. No partial inventory escapes.
        var Int rejected
        let capacities = [4, 5]
        for (capacity in capacities) {
            try { FilesystemSourceProvider("res/bounded", maxEntries: capacity) }
            catch (Exception error) { rejected++ }
        }
        expect(rejected).toBe(2)
        let provider = FilesystemSourceProvider("res/bounded", maxEntries: 6)
        let identities = provider.identities()
        expect(identities.count).toBe(3)
        expect(identities[0].value.endsWith("res/bounded/A.flat")).toBe(true)
        expect(identities[1].value.endsWith("res/bounded/Z.flat")).toBe(true)
        expect(identities[2].value.endsWith("res/bounded/nested/Unicode.flat")).toBe(true)
        expect(FilesystemSourceProvider("res/bounded", maxEntries: 6).identities()).toBe(identities)
        expect(provider.load(identities[0]).contents).toBe("class A {}\n")
    }

    test `bounded source reads measure UTF8 bytes and reject overflow without truncation`() {
        let small = FilesystemSourceProvider("res/bounded/nested", maxSourceBytes: 10)
        var Bool rejected
        try { small.load(small.identities().first) }
        catch (Exception error) { rejected = true }
        expect(rejected).toBe(true)
        let exact = FilesystemSourceProvider("res/bounded/nested", maxSourceBytes: 11)
        expect(exact.load(exact.identities().first).contents).toBe("// €😀\n")
        expect(exact.load(exact.identities().first).contents).toBe("// €😀\n")
        expect(small.identities()).toBe(exact.identities())
    }

    test `bounded inventory failure and cancellation leave subsequent requests usable`() {
        var Int rejected
        try { FilesystemSourceProvider("res/bounded", maxSources: 2) }
        catch (Exception error) { rejected++ }
        try { FilesystemSourceProvider("res/bounded", maxDirectories: 1) }
        catch (Exception error) { rejected++ }
        try { FilesystemSourceProvider("res/bounded", maxDepth: 1) }
        catch (Exception error) { rejected++ }
        var Int checks
        try {
            // Stop immediately after the bounded root enumeration.
            FilesystemSourceProvider("res/bounded", "filesystem", 4096, 16384, 128, 65536, 16777216,
                { checks++; return checks == 3 })
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(4)
        expect(FilesystemSourceProvider("res/bounded", maxSources: 3,
            maxDirectories: 2, maxDepth: 2, maxEntries: 6).identities().count).toBe(3)
    }

    test `filesystem cancellation interrupts discovery and isolates later requests`() {
        var Int rejected
        try { FilesystemSourceProvider("res/sources", "filesystem", 4096, 16384, 128, 65536, 16777216, { true }) }
        catch (Exception error) { rejected++ }
        var Int checks
        try {
            FilesystemSourceProvider("res/sources", "filesystem", 4096, 16384, 128, 65536, 16777216,
                { checks++; return checks >= 3 })
        } catch (Exception error) { rejected++ }
        let provider = FilesystemSourceProvider("res/sources")
        let identity = provider.identities().first
        try { provider.loadCancellable(identity, { true }) }
        catch (Exception error) { rejected++ }
        // The final check runs after the reader has been closed; no snapshot escapes.
        var Int loadChecks
        try { provider.loadCancellable(identity, { loadChecks++; return loadChecks == 3 }) }
        catch (Exception error) { rejected++ }
        expect(rejected).toBe(4)
        expect(provider.load(identity).contents).toBe("class Example {}\n")
        expect(provider.load(SourceIdentity("file:not-registered.flat"))).toBe(null)
        expect(provider.load(SourceIdentity("memory:Example.flat"))).toBe(null)
    }

    test `filesystem provider enumerates and loads source snapshots deterministically`() {
        let provider = FilesystemSourceProvider("res/sources")
        let identities = provider.identities()
        expect(identities.count).toBe(1)
        expect(identities.first.value.endsWith("res/sources/Example.flat")).toBe(true)
        let loaded = provider.load(identities.first)
        expect(loaded.contents).toBe("class Example {}\n")
        expect(loaded.snapshot.revision.startsWith("filesystem:17:")).toBe(true)
    }
}
