package flat/project

import flat/compiler/models
import flat/io

/** Bounded, target-neutral filesystem source identities; snapshots are read on demand. */
class extends SourceProvider {
    var File[] sourceFiles = File[]
    var String[] visited = String[]

    public construct(visible String root, visible String revisionPrefix = "filesystem",
        visible Int maxSources = 4096, visible Int maxDirectories = 16384,
        visible Int maxDepth = 128) {
        if (maxSources <= 0 || maxDirectories <= 0 || maxDepth <= 0) {
            throw Exception("Filesystem source capacities must be positive")
        }
        let directory = File(root)
        if (!directory.isDirectory) throw Exception("Filesystem source root must be a directory")
        collect(directory, 0)
        sourceFiles = sourceFiles.sort({ _a.normalizedLocation.compareTo(_b.normalizedLocation) })
        visited.clear()
    }

    collect(File directory, Int depth) {
        let identity = directory.getCanonicalFileSync().normalizedLocation
        if (visited.contains(identity)) return
        if (visited.count >= maxDirectories || depth >= maxDepth) {
            throw Exception("Filesystem source discovery exceeds directory/depth capacity")
        }
        visited.add(identity)
        // IO lists one directory at a time. Never recursively materialize a root.
        let children = directory.getChildFiles(includeDirectories: true)
            .sort({ _a.normalizedLocation.compareTo(_b.normalizedLocation) })
        for (file in children) {
            if (file.isDirectory) collect(file, depth + 1)
            else if (file.isFile && file.extensionName == "flat") {
                let canonical = file.getCanonicalFileSync()
                if (!sourceFiles.any({ _.normalizedLocation == canonical.normalizedLocation })) {
                    if (sourceFiles.count >= maxSources) throw Exception("Filesystem source discovery exceeds source capacity")
                    sourceFiles.add(canonical)
                }
            }
        }
    }

    override public identities() -> SourceIdentity[] {
        return sourceFiles.map({ SourceIdentity("file:#{_.normalizedLocation}") })
    }

    override public load(SourceIdentity identity) -> LoadedSource => null {
        let prefix = "file:"
        if (!identity.value.startsWith(prefix)) return null
        let location = identity.value.substring(prefix.count)
        let file = sourceFiles.firstWhere({ _.normalizedLocation == location })
        if (!file) return null
        let reader = FileReader(file)
        var String contents
        try { contents = reader.readAllContents() } finally { reader.close() }
        // Revision is a change hint, not a cryptographic artifact/tool identity.
        let revision = "#revisionPrefix:#{contents.count}:#{contents.hashCodeLong}"
        return LoadedSource(SourceSnapshotIdentity(identity, revision), contents)
    }
}
