package flat/writer/es6/bound

import flat/semantic/types
import flat/bound

testable class {
    test `emits structured continue`() {
        let fixture = Es6BoundWriter_TestFixture()
        let statement = BoundContinueStatement(fixture.range())

        expect(Es6StatementOrchestrator().emit(statement).code)
            .toBe("continue;\n")
    }

    test `emits expression local assignment and return statements`() {
        let fixture = Es6BoundWriter_TestFixture()
        let emitter = Es6StatementEmitter()
        let stringType = SemanticTypes.stringType()
        let local = fixture.reference("local", "message", 1, stringType)
        let literal = BoundLiteralExpression(
            fixture.range(), stringType, "'Hello, Flat'"
        )
        let literalCode = Es6CodeResult(code: literal.sourceValue)
        let conversion = TypeConversions.classify(stringType, stringType)
        let declaration = BoundLocalDeclarationStatement(
            fixture.range(), local, literal, conversion
        )
        let assignment = BoundAssignmentStatement(
            fixture.range(), local, literal, conversion
        )
        let expression = BoundExpressionStatement(fixture.range(), literal)
        let returned = BoundReturnStatement(
            fixture.range(), stringType, literal, conversion
        )
        let noValue = BoundReturnStatement(
            fixture.range(), SemanticTypes.unitType()
        )
        let name = Es6NameMangler.mangle(local.symbolIdentity.value)

        expect(emitter.emitExpression(expression, literalCode).code)
            .toBe("'Hello, Flat';\n")
        expect(emitter.emitInitializedLocal(declaration, literalCode).code)
            .toBe("let " + name + " = 'Hello, Flat';\n")
        expect(emitter.emitAssignment(assignment, literalCode).code)
            .toBe(name + " = 'Hello, Flat';\n")
        expect(emitter.emitReturn(returned, literalCode).code)
            .toBe("return 'Hello, Flat';\n")
        expect(emitter.emitVoidReturn(noValue).code).toBe("return;\n")

        let nativeParameter = fixture.reference(
            "parameter", "number", 7, SemanticTypes.doubleType()
        )
        let namedExternal = BoundExternalStatement(
            fixture.range(), "es6", [
                BoundExternalCodeSegment(fixture.range(), "return Math.sqrt(number);")
            ], [BoundExternalNameBinding("number", nativeParameter)]
        )
        expect(emitter.emitExternal(namedExternal).code).toBe(
            "let number = " + Es6NameMangler.mangle(nativeParameter.symbolIdentity.value) +
                ";\nreturn Math.sqrt(number);\n"
        )

        let boolType = SemanticTypes.boolType()
        let condition = BoundLiteralExpression(fixture.range(), boolType, "true")
        let branch = BoundExpressionStatement(fixture.range(), literal)
        let ifStatement = BoundIfStatement(
            fixture.range(), condition, [branch], [branch]
        )
        let whileStatement = BoundWhileStatement(
            fixture.range(), condition, [branch]
        )
        expect(emitter.emitIf(
            ifStatement,
            Es6CodeResult(code: "true"),
            Es6CodeResult(code: "then;\n"),
            Es6CodeResult(code: "else;\n")
        ).code).toBe("if (true) {\n    then;\n} else {\n    else;\n}\n")
        expect(emitter.emitWhile(
            whileStatement,
            Es6CodeResult(code: "true"),
            Es6CodeResult(code: "body;\n")
        ).code).toBe("while (true) {\n    body;\n}\n")
    }

    test `emits switch cases with explicit fallthrough and break`() {
        let fixture = Es6BoundWriter_TestFixture()
        let charType = SemanticTypes.charType()
        let value = fixture.reference("parameter", "value", 1, charType)
        let space = BoundLiteralExpression(fixture.range(), charType, "' '")
        let first = BoundSwitchCase(
            fixture.range(), space, BoundStatement[], fallsThrough: true
        )
        let second = BoundSwitchCase(
            fixture.range(), null, BoundStatement[], defaultCase: true
        )
        let statement = BoundSwitchStatement(
            fixture.range(), value, [first, second]
        )
        let emitter = Es6StatementEmitter()
        let firstCode = emitter.emitSwitchCase(
            first, Es6CodeResult(code: "' '"), Es6CodeResult(code: "")
        )
        let secondCode = emitter.emitSwitchCase(
            second, Es6CodeResult(code: ""), Es6CodeResult(code: "return false;\n")
        )

        expect(emitter.emitSwitch(
            statement, Es6CodeResult(code: "value"), [firstCode, secondCode]
        ).code).toBe(
            "switch (value) {\ncase ' ':\ndefault:\nreturn false;\nbreak;\n}\n"
        )
    }

    test `emits an uninitialized local and propagates child diagnostics`() {
        let fixture = Es6BoundWriter_TestFixture()
        let stringType = SemanticTypes.stringType()
        let local = fixture.reference("local", "message", 1, stringType)
        let declaration = BoundLocalDeclarationStatement(fixture.range(), local)
        let diagnostic = Es6BackendDiagnostic("es6.value", "value failed")
        let failure = Es6CodeResult(diagnostic: diagnostic)
        let expression = BoundExpressionStatement(
            fixture.range(),
            BoundLiteralExpression(fixture.range(), stringType, "'unused'")
        )
        let emitter = Es6StatementEmitter()

        expect(emitter.emitUninitializedLocal(declaration).code).toBe(
            "let " + Es6NameMangler.mangle(local.symbolIdentity.value) + ";\n"
        )
        expect(emitter.emitExpression(expression, failure).diagnostic).toBe(diagnostic)
    }
}
