    async test `nested loop continue and advance continue keep distinct owners`() {
        let fixture = Es6BoundWriter_TestFixture()
        let range = fixture.range()
        let condition = BoundLiteralExpression(range, SemanticTypes.boolType(), "outer < 2")
        let inner = BoundWhileStatement(range, BoundLiteralExpression(range, SemanticTypes.boolType(), "inner++ < 1"),
            [BoundTryStatement(range, [BoundContinueStatement(range)], BoundCatchClause[], [host("events.push('inner-finally');")])])
        let loop = BoundLoopLatchStatement(range, condition,
            [host("inner = 0;"), inner,
                BoundSwitchStatement(range, BoundLiteralExpression(range, SemanticTypes.intType(), "0"), [
                    BoundSwitchCase(range, BoundLiteralExpression(range, SemanticTypes.intType(), "0"),
                        [BoundContinueStatement(range)], false, false)
                ])],
            [host("events.push('advance'); outer++;"), BoundContinueStatement(range), host("throw new Error('advance replay');")],
            SyntaxIslandIdentity(range.snapshot, "nested-latch", range.startTokenIndex))
        let emitted = Es6StatementOrchestrator().emit(loop)
        expect(emitted.emitted).toBe(true)
        execute("let events = [], outer = 0, inner = 0;\n" + emitted.code +
            "if (outer !== 2 || events.join(',') !== 'inner-finally,advance,inner-finally,advance') " +
            "throw new Error('continue owner');\nconsole.log('ok');\n")
    }

