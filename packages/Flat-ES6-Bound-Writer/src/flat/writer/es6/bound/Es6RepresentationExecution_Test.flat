    async test `generic lambda results box after concrete conversion with resolved constructors`() {
        let fixture = Es6BoundWriter_TestFixture()
        let range = fixture.range()
        let intType = SemanticTypes.intType()
        let wrapper = UserClassSemanticType(fixture.declaration("class", "CanonicalInteger", 90))
        let constructor = CallableSignature(fixture.symbol("constructor", "box", 91), "box",
            CallableKind("constructor"), [intType], wrapper, wrapper)
        let generic = GenericParameterSemanticType(fixture.declaration("function", "produce", 92), "T", 0)
        let declaration = FunctionSemanticType(SemanticType[], generic)
        let source = BoundLiteralExpression(range, SemanticTypes.doubleType(), "readReal()")
        let conversion = TypeConversions.classify(source.semanticType, intType, explicit: true)
        let body = BoundConversionExpression(range, intType, source, conversion)
        let expressionLambda = BoundLambdaExpression(range, FunctionSemanticType(SemanticType[], intType),
            BoundFunctionParameter[], BoundReferenceExpression[], body, declarationContract: declaration,
            resultBoxingConstructor: constructor)
        let blockLambda = BoundLambdaExpression(range, FunctionSemanticType(SemanticType[], intType),
            BoundFunctionParameter[], BoundReferenceExpression[], BoundLiteralExpression(range, intType, "0"),
            [BoundReturnStatement(range, intType, source, conversion)], declarationContract: declaration,
            resultBoxingConstructor: constructor)
        let writer = Es6ExpressionOrchestrator()
        let expression = writer.emit(expressionLambda)
        let block = writer.emit(blockLambda)
        expect(expression.emitted).toBe(true)
        expect(block.emitted).toBe(true)
        let withoutEvidence = BoundLambdaExpression(range, FunctionSemanticType(SemanticType[], intType),
            BoundFunctionParameter[], BoundReferenceExpression[], body, declarationContract: declaration)
        let missing = Es6ExpressionOrchestrator().emit(withoutEvidence)
        expect(missing.emitted).toBe(false)
        expect(missing.diagnostic.code).toBe("es6.generic-result-boxing-evidence")
        let owner = Es6NameMangler.mangle(wrapper.declarationIdentity.value)
        execute("let reads = 0, boxes = 0; function readReal(){ reads++; return -9.75; }\n" +
            "class " + owner + " { constructor(value){ boxes++; this.value = value; } }\n" +
            "const expression = " + expression.code + "; const block = " + block.code + ";\n" +
            "if (reads !== 0 || boxes !== 0) throw new Error('eager boxing');\n" +
            "for (const callback of [expression, block]) { const result = callback();\n" +
            "if (!(result instanceof " + owner + ") || result.value !== -9) throw new Error('convert before box'); }\n" +
            "if (reads !== 2 || boxes !== 2) throw new Error('boxing evaluation count');\nconsole.log('ok');\n")
    }

    async test `generic lambda boundary preserves null and already boxed identity`() {
        let fixture = Es6BoundWriter_TestFixture()
        let range = fixture.range()
        let wrapper = UserClassSemanticType(fixture.declaration("class", "CanonicalInteger", 90))
        let generic = GenericParameterSemanticType(fixture.declaration("function", "produce", 92), "T", 0)
        let declaration = FunctionSemanticType(SemanticType[], generic)
        let reference = BoundLambdaExpression(range, FunctionSemanticType(SemanticType[], wrapper),
            BoundFunctionParameter[], BoundReferenceExpression[], BoundLiteralExpression(range, wrapper, "boxed"),
            declarationContract: declaration)
        let absent = BoundLambdaExpression(range, FunctionSemanticType(SemanticType[], SemanticTypes.nullType()),
            BoundFunctionParameter[], BoundReferenceExpression[], BoundLiteralExpression(range, SemanticTypes.nullType(), "null"),
            declarationContract: declaration)
        let writer = Es6ExpressionOrchestrator()
        let selected = writer.emit(reference)
        let missing = writer.emit(absent)
        expect(selected.emitted).toBe(true)
        expect(missing.emitted).toBe(true)
        execute("const boxed = {}; const selected = " + selected.code + "; const missing = " + missing.code + ";\n" +
            "if (selected() !== boxed || missing() !== null) throw new Error('generic reference identity');\n" +
            "console.log('ok');\n")
    }

    async test `async generic lambda boxes resolved payload rather than promise container`() {
        let fixture = Es6BoundWriter_TestFixture()
        let range = fixture.range()
        let type = SemanticTypes.intType()
        let wrapper = UserClassSemanticType(fixture.declaration("class", "CanonicalInteger", 90))
        let constructor = CallableSignature(fixture.symbol("constructor", "box", 91), "box",
            CallableKind("constructor"), [type], wrapper, wrapper)
        let generic = GenericParameterSemanticType(fixture.declaration("function", "produce", 92), "T", 0)
        let body = BoundEvaluationExpression(range, type, [host("await globalThis.gate();")],
            BoundLiteralExpression(range, type, "7"))
        let lambda = BoundLambdaExpression(range, FunctionSemanticType(SemanticType[], type, asyncFunction: true),
            BoundFunctionParameter[], BoundReferenceExpression[], body,
            declarationContract: FunctionSemanticType(SemanticType[], generic, asyncFunction: true),
            resultBoxingConstructor: constructor)
        let emitted = Es6ExpressionOrchestrator().emit(lambda)
        expect(emitted.emitted).toBe(true)
        let owner = Es6NameMangler.mangle(wrapper.declarationIdentity.value)
        execute("let boxes = 0, release; class " + owner + " { constructor(value){ boxes++; this.value = value; } }\n" +
            "globalThis.gate = () => new Promise(resolve => { release = resolve; });\n" +
            "const callback = " + emitted.code + "; const pending = callback();\n" +
            "if (!(pending instanceof Promise) || boxes !== 0) throw new Error('promise boxed');\n" +
            "release(); pending.then(result => { if (!(result instanceof " + owner +
            ") || result.value !== 7 || boxes !== 1) throw new Error('payload boxing'); console.log('ok'); })" +
            ".catch(error => { console.error(error); process.exitCode = 1; });\n")
    }

    async test `binder function reference adapter carries per lambda boxing evidence without eager calls`() {
        let fixture = Es6BoundWriter_TestFixture()
        let range = fixture.range()
        let type = SemanticTypes.intType()
        let wrapper = UserClassSemanticType(fixture.declaration("class", "CanonicalInteger", 90))
        let constructor = CallableSignature(fixture.symbol("constructor", "box", 91), "box",
            CallableKind("constructor"), [type], wrapper, wrapper)
        let generic = GenericParameterSemanticType(fixture.declaration("function", "produce", 92), "T", 0)
        let declaration = FunctionSemanticType([type], generic)
        let target = CallableSignature(fixture.symbol("function", "read", 93), "read",
            CallableKind("function"), [type], type)
        let functionType = FunctionSemanticType([type], type)
        let reference = BoundFunctionValue(range, functionType, target)
        // Match the actual binder adapter shape: function invocation inside a
        // lambda, with a concrete result and the original generic declaration.
        let parameter = BoundFunctionParameter("argument0", fixture.symbol("parameter", "argument0", 94), type)
        let invocation = BoundFunctionInvocationExpression(range, reference, functionType,
            [BoundReferenceExpression(range, type, parameter.name, parameter.identity)])
        let adapter = BoundLambdaExpression(range, functionType, [parameter], BoundReferenceExpression[], invocation,
            declarationContract: declaration, resultBoxingConstructor: constructor)
        let emitted = Es6ExpressionOrchestrator().emit(adapter)
        expect(emitted.emitted).toBe(true)
        let owner = Es6NameMangler.mangle(wrapper.declarationIdentity.value)
        let selected = Es6NameMangler.mangle(target.identity.declaration.value)
        execute("let reads = 0, boxes = 0; class " + owner + " { constructor(value){ boxes++; this.value = value; } }\n" +
            "function " + selected + "(value){ reads++; return value + 1; }\n" +
            "const adapter = " + emitted.code + "; if (reads || boxes) throw new Error('eager adapter');\n" +
            "const result = adapter(6); if (!(result instanceof " + owner +
            ") || result.value !== 7 || reads !== 1 || boxes !== 1) throw new Error('reference adapter');\n" +
            "console.log('ok');\n")
    }

    test `per lambda boxing evidence cannot fall back to a different constructor`() {
        let fixture = Es6BoundWriter_TestFixture()
        let wrapper = UserClassSemanticType(fixture.declaration("class", "CanonicalInteger", 90))
        let valid = CallableSignature(fixture.symbol("constructor", "box", 91), "box",
            CallableKind("constructor"), [SemanticTypes.intType()], wrapper, wrapper)
        let incompatible = CallableSignature(fixture.symbol("constructor", "wrong", 95), "wrong",
            CallableKind("constructor"), [SemanticTypes.boolType()], wrapper, wrapper)
        let result = Es6ExpressionEmitter([valid]).emitGenericResult(SemanticTypes.intType(),
            Es6CodeResult(code: "1"), incompatible)
        expect(result.emitted).toBe(false)
        expect(result.diagnostic.code).toBe("es6.generic-result-boxing-evidence")
    }

    test `generic result boxing fails closed for ambiguous or incompatible evidence`() {
        let fixture = Es6BoundWriter_TestFixture()
        let wrapper = UserClassSemanticType(fixture.declaration("class", "CanonicalInteger", 90))
        let constructor = CallableSignature(fixture.symbol("constructor", "box", 91), "box",
            CallableKind("constructor"), [SemanticTypes.intType()], wrapper, wrapper)
        let ambiguous = Es6ExpressionEmitter([constructor, constructor]).emitGenericResult(
            SemanticTypes.intType(), Es6CodeResult(code: "1"))
        expect(ambiguous.emitted).toBe(false)
        expect(ambiguous.diagnostic.code).toBe("es6.generic-result-boxing-evidence")
        let incompatible = Es6ExpressionEmitter([constructor]).emitGenericResult(
            SemanticTypes.boolType(), Es6CodeResult(code: "false"))
        expect(incompatible.emitted).toBe(false)
        let failure = Es6CodeResult(diagnostic: Es6BackendDiagnostic("test.failure", "upstream"))
        expect(Es6ExpressionEmitter([constructor]).emitGenericResult(SemanticTypes.intType(), failure)).toBe(failure)
    }

    host(String code) -> BoundExternalStatement => BoundExternalStatement(
        Es6BoundWriter_TestFixture().range(), "es6", [BoundExternalCodeSegment(Es6BoundWriter_TestFixture().range(), code)])

    async execute(String code) {
        let root = File(".flat-es6-representation-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        try {
            let destination = File(root, "regression.js")
            Es6ArtifactCommitter().commit(destination, code)
            let response = System.execute(["node", destination.normalizedLocation], silent: true, shell: false)
            if (response.exitCode != 0) throw Exception(response.stderr.join(""))
            expect(response.stdout.join("")).toBe("ok\n")
        } finally {
            Es6ArtifactFiles.remove(root)
        }
    }
}
