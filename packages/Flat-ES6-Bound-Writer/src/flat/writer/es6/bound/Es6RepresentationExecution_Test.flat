    async test `evaluation setup awaits in its enclosing async function and rejects without replay`() {
        let fixture = Es6BoundWriter_TestFixture()
        let range = fixture.range()
        let expression = BoundEvaluationExpression(range, SemanticTypes.intType(),
            [host("events.push('before'); await globalThis.gate(); events.push('after');")],
            BoundLiteralExpression(range, SemanticTypes.intType(), "23"))
        let emitted = Es6StatementOrchestrator().emit(BoundReturnStatement(range, SemanticTypes.intType(), expression,
            TypeConversions.classify(SemanticTypes.intType(), SemanticTypes.intType())))
        expect(emitted.emitted).toBe(true)
        execute("let events = [], release, calls = 0; const failure = new Error('cancelled');\n" +
            "globalThis.gate = () => { calls++; return new Promise(resolve => { release = resolve; }); };\n" +
            "async function run() {\n" + emitted.code + "}\n" +
            "(async () => { const pending = run();\n" +
            "if (events.join(',') !== 'before' || calls !== 1) throw new Error('await ownership');\n" +
            "release(); if (await pending !== 23 || events.join(',') !== 'before,after') throw new Error('resume');\n" +
            "events = []; globalThis.gate = () => { calls++; return Promise.reject(failure); };\n" +
            "let caught; try { await run(); } catch (error) { caught = error; }\n" +
            "if (caught !== failure || calls !== 2 || events.join(',') !== 'before') throw new Error('rejection replay');\n" +
            "console.log('ok'); })().catch(error => { console.error(error); process.exitCode = 1; });\n")
    }

    async test `evaluation setup in parameter default and parent arguments stays in constructor owner`() {
        let fixture = Es6BoundWriter_TestFixture()
        let range = fixture.range()
        let intType = SemanticTypes.intType()
        let parameter = BoundFunctionParameter("value", fixture.symbol("parameter", "value", 86), intType,
            BoundEvaluationExpression(range, intType, [host("events.push('default');")],
                BoundLiteralExpression(range, intType, "5")))
        let unit = BoundFunctionUnit(fixture.declaration("function", "defaults", 87), "defaults", intType,
            [BoundReturnStatement(range, intType, BoundReferenceExpression(range, intType, "value", parameter.identity),
                TypeConversions.classify(intType, intType))], range, [parameter])
        let emitted = Es6UnitOrchestrator().emitFunction(unit, 0)
        expect(emitted.emitted).toBe(true)
        let name = Es6NameMangler.mangle(unit.identity.value)
        let arguments = Es6ExpressionOrchestrator().emitArguments([
            BoundLiteralExpression(range, intType, "state"),
            BoundEvaluationExpression(range, intType, [host("state = 20; events.push('parent');")],
                BoundLiteralExpression(range, intType, "7"))
        ])
        expect(arguments.emitted).toBe(true)
        execute("let events = [], state = 3;\n" + emitted.fragment.code +
            "if (" + name + "() !== 5 || " + name + "(9) !== 9 || events.join(',') !== 'default') " +
            "throw new Error('default selection');\n" +
            "class Parent { constructor(a,b) { if (a !== 3 || b !== 7) throw new Error('parent arguments'); } }\n" +
            "class Child extends Parent { constructor() {\n" + arguments.setup + "super(" + arguments.code + "); } }\n" +
            "new Child(); if (events.join(',') !== 'default,parent') throw new Error('parent setup');\n" +
            "console.log('ok');\n")
    }

    test `opaque host interpolation rejects setup without guessing an insertion point`() {
