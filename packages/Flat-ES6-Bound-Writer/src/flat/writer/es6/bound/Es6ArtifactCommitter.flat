package flat/writer/es6/bound

import flat/io

/** Atomic single-artifact commit with same-directory temporary replacement. */
class {
    public commit(File destination, String code) {
        if (!destination || code == null) {
            throw Exception("ES6 artifact commit requires destination and code")
        }
        // Reserve private staging beside the destination: never delete or reuse
        // a predictable path that may belong to another commit or caller.
        let staging = Es6ArtifactFiles.createCommitDirectory(destination)
        let temporary = File(staging, "artifact")
        try {
            Es6ArtifactFiles.write(temporary, code)
            Es6ArtifactFiles.replace(temporary, destination)
        } finally {
            Es6ArtifactFiles.remove(staging)
        }
    }
}
