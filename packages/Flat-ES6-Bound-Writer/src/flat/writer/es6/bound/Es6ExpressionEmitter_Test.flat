package flat/writer/es6/bound

import flat/semantic/types
import flat/bound

testable class {
    test `emits parameter field interpolation`() {
        let fixture = Es6BoundWriter_TestFixture()
        let owner = UserClassSemanticType(fixture.declaration("class", "Owner", 20))
        let parameter = fixture.reference("parameter", "other", 22, owner)
        let fieldIdentity = fixture.symbol("field", "data", 23)
        let selected = BoundMemberAccessExpression(
            fixture.range(), ArraySemanticType(SemanticTypes.charType()),
            parameter, "data", fieldIdentity
        )
        let statement = BoundExternalStatement(
            fixture.range(), "es6", [
                BoundExternalCodeSegment(fixture.range(), "return "),
                BoundExternalCodeSegment(fixture.range(), "", selected, "identity"),
                BoundExternalCodeSegment(fixture.range(), ";")
            ]
        )
        let emitted = Es6StatementOrchestrator().emit(statement).code

        expect(emitted).toBe(
            "return " + Es6NameMangler.mangle(parameter.symbolIdentity.value) + "." +
                Es6NameMangler.mangle(fieldIdentity.value) + ";\n"
        )
    }

    test `emits literals references member access and conversions structurally`() {
        let fixture = Es6BoundWriter_TestFixture()
        let emitter = Es6ExpressionEmitter()
        let stringType = SemanticTypes.stringType()
        let literal = BoundLiteralExpression(
            fixture.range(), stringType, "'Hello, Flat'"
        )
        let receiver = fixture.reference(
            "local", "console", 1, SemanticTypes.objectType()
        )
        let memberIdentity = fixture.symbol("member", "log", 2)
        let member = BoundMemberAccessExpression(
            fixture.range(), stringType, receiver, "log", memberIdentity
        )
        let conversion = BoundConversionExpression(
            fixture.range(), stringType, literal,
            TypeConversions.classify(stringType, stringType)
        )

        expect(emitter.emitLiteral(literal).code).toBe("'Hello, Flat'")
        let receiverResult = emitter.emitReference(receiver)
        expect(receiverResult.code)
            .toBe(Es6NameMangler.mangle(receiver.symbolIdentity.value))
        expect(emitter.emitMemberAccess(member, receiverResult).code).toBe(
            "#{Es6NameMangler.mangle(receiver.symbolIdentity.value)}.#{Es6NameMangler.mangle(memberIdentity.value)}"
        )
        let literalResult = emitter.emitLiteral(literal)
        expect(emitter.emitConversion(conversion, literalResult).code).toBe("'Hello, Flat'")
        let numericUnboxing = BoundConversionExpression(
            fixture.range(), SemanticTypes.byteType(),
            fixture.reference("local", "boxed", 3, SemanticTypes.objectType()),
            TypeConversions.classify(
                SemanticTypes.objectType(), SemanticTypes.byteType(), explicit: true
            )
        )
        expect(emitter.emitConversion(
            numericUnboxing, Es6CodeResult(code: "boxed")
        ).code).toBe("Number(boxed)")
        let one = BoundLiteralExpression(
            fixture.range(), SemanticTypes.intType(), "1"
        )
        let two = BoundLiteralExpression(
            fixture.range(), SemanticTypes.intType(), "2"
        )
        let unary = BoundUnaryExpression(
            fixture.range(), SemanticTypes.intType(), "-", one
        )
        let binary = BoundBinaryExpression(
            fixture.range(), SemanticTypes.intType(), "+", one, two
        )
        let conditional = BoundConditionalExpression(
            fixture.range(), SemanticTypes.intType(),
            BoundLiteralExpression(fixture.range(), SemanticTypes.boolType(), "true"),
            one, two
        )
        let orchestrator = Es6ExpressionOrchestrator()
        expect(orchestrator.emit(unary).code).toBe("-1")
        expect(orchestrator.emit(binary).code).toBe("(1 + 2)")
        let interpolation = BoundInterpolatedStringExpression(fixture.range(), [
            BoundInterpolatedStringSegment(fixture.range(), "\"Hello \"", null),
            BoundInterpolatedStringSegment(fixture.range(), null, receiver)
        ])
        expect(orchestrator.emit(interpolation).code).toBe(
            "(\"Hello \" + #{Es6NameMangler.mangle(receiver.symbolIdentity.value)})"
        )
        let conditionalInterpolation = BoundInterpolatedStringExpression(fixture.range(), [
            BoundInterpolatedStringSegment(fixture.range(), null, conditional)
        ])
        expect(orchestrator.emit(conditionalInterpolation).code).toBe("((true ? 1 : 2))")
        let invocationType = FunctionSemanticType(
            [SemanticTypes.intType()], SemanticTypes.intType()
        )
        let functionValue = fixture.reference(
            "parameter", "transform", 9, invocationType
        )
        let invocation = BoundFunctionInvocationExpression(
            fixture.range(), functionValue, invocationType, [one]
        )
        expect(orchestrator.emit(invocation).code).toBe(
            Es6NameMangler.mangle(functionValue.symbolIdentity.value) + "(1)"
        )
        let className = BoundClassNameExpression(fixture.range(), receiver)
        let referencedType = UserClassSemanticType(
            fixture.declaration("class", "Value", 7)
        )
        let metadata = BoundTypeMetadataExpression(fixture.range(), referencedType)
        let typeTest = BoundTypeTestExpression(fixture.range(), receiver, metadata)
        expect(orchestrator.emit(metadata).code).toBe(
            Es6NameMangler.mangle(referencedType.declarationIdentity.value)
        )
        expect(orchestrator.emit(typeTest).code).toBe(
            "(" + Es6NameMangler.mangle(receiver.symbolIdentity.value) + " instanceof " +
                Es6NameMangler.mangle(referencedType.declarationIdentity.value) + ")"
        )
        expect(orchestrator.emit(className).code).toBe(
            Es6NameMangler.mangle(receiver.symbolIdentity.value) +
            ".constructor.__flatType.name"
        )
        let emptyArray = BoundArrayExpression(
            fixture.range(), ArraySemanticType(SemanticTypes.stringType()),
            BoundExpression[]
        )
        expect(orchestrator.emit(emptyArray).code).toBe("[]")
        let arrayConstruction = BoundArrayExpression(
            fixture.range(), ArraySemanticType(SemanticTypes.charType()),
            fixture.reference("local", "count", 8, SemanticTypes.intType())
        )
        let size = (BoundReferenceExpression)arrayConstruction.allocationSize
        let arrayLength = BoundArrayLengthExpression(fixture.range(), arrayConstruction)
        expect(orchestrator.emit(arrayLength).code).toBe("new Array(" +
            Es6NameMangler.mangle(size.symbolIdentity.value) + ").fill(null).length")
        expect(orchestrator.emit(arrayConstruction).code).toBe(
            "new Array(" + Es6NameMangler.mangle(size.symbolIdentity.value) +
                ").fill(null)"
        )
        let assignment = BoundAssignmentValueExpression(
            fixture.range(), receiver.semanticType, receiver, literal,
            TypeConversions.classify(literal.semanticType, receiver.semanticType)
        )
        expect(orchestrator.emit(assignment).code).toBe(
            "(" + Es6NameMangler.mangle(receiver.symbolIdentity.value) +
                " = 'Hello, Flat')"
        )
        expect(orchestrator.emit(conditional).code).toBe("(true ? 1 : 2)")
    }
}
