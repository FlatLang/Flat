package flat/writer/es6/bound

import flat/io

/** ES6/Node file primitives used by spooling and atomic artifact commit. */
class {
    public static ensureDirectory(File directory) {
        if (!directory) throw Exception("ES6 artifact directory is required")
        native_array native var Char[] errorMessage
        external {
            try {
                #{File.FileGlobal.fs}.mkdirSync(
                    #{directory.location.chars.data},
                    {recursive: true}
                );
            } catch (error) {
                #{errorMessage} = error.message;
            }
        }
        if (errorMessage) throw Exception(String(errorMessage))
    }

    /** Exclusively reserve same-filesystem staging owned by one commit. */
    public static createCommitDirectory(File destination) -> File {
        if (!destination) throw Exception("ES6 artifact commit requires destination")
        let prefix = destination.normalizedLocation + ".flat-tmp-"
        native_array native var Char[] data
        native_array native var Char[] errorMessage
        external {
            try {
                #{data} = #{File.FileGlobal.fs}.mkdtempSync(#{prefix.chars.data});
            } catch (error) {
                #{errorMessage} = error.message;
            }
        }
        if (errorMessage) throw Exception(String(errorMessage))
        return File(String(data))
    }

    public static write(File file, String value) {
        if (!file || value == null) throw Exception("ES6 artifact write requires file and value")
        native_array native var Char[] errorMessage
        external {
            try {
                #{File.FileGlobal.fs}.writeFileSync(
                    #{file.location.chars.data},
                    #{value.chars.data}
                );
            } catch (error) {
                #{errorMessage} = error.message;
            }
        }
        if (errorMessage) throw Exception(String(errorMessage))
    }

    public static read(File file) -> String {
        if (!file || !file.exists || file.isDirectory) {
            throw Exception("ES6 artifact read requires an existing file")
        }
        return FileReader(file).readAllContents()
    }

    public static remove(File file) {
        if (!file) return
        native_array native var Char[] errorMessage
        external {
            try {
                #{File.FileGlobal.fs}.rmSync(
                    #{file.location.chars.data},
                    {recursive: true, force: true}
                );
            } catch (error) {
                #{errorMessage} = error.message;
            }
        }
        if (errorMessage) throw Exception(String(errorMessage))
    }

    public static replace(File temporary, File destination) {
        if (!temporary || !temporary.exists || !destination) {
            throw Exception("ES6 atomic replace requires temporary and destination files")
        }
        let parent = destination.getParent()
        if (!parent || !parent.exists) {
            throw Exception("ES6 atomic replace destination parent must exist")
        }
        native_array native var Char[] errorMessage
        external {
            try {
                #{File.FileGlobal.fs}.renameSync(
                    #{temporary.location.chars.data},
                    #{destination.location.chars.data}
                );
            } catch (error) {
                #{errorMessage} = error.message;
            }
        }
        if (errorMessage) throw Exception(String(errorMessage))
    }
}
