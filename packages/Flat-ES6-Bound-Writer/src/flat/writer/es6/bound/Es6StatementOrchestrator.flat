package flat/writer/es6/bound

import flat/bound

/** Recursive reduced-statement orchestration for one independently emitted function. */
class {
    public construct(
        visible Es6ExpressionOrchestrator expressions = Es6ExpressionOrchestrator(),
        visible Es6StatementEmitter statements = Es6StatementEmitter()
    ) {
        if (!expressions || !statements) throw Exception("ES6 statement orchestration requires emitters")
    }

    public emit(BoundStatement statement) -> Es6CodeResult {
        if (!statement) throw Exception("ES6 statement orchestration requires statement")
        let capability = Es6TargetCapabilities.diagnoseStatement(statement.unitKind())
        if (capability) return Es6CodeResult(diagnostic: capability)
        if (statement.class.isOfType(BoundBreakStatement.class)) return Es6CodeResult(code:
            expressions.breakTarget ? "break " + expressions.breakTarget + ";\n" : "break;\n")
        if (statement.class.isOfType(BoundLoopLatchStatement.class)) {
            let value = (BoundLoopLatchStatement)statement
            let outer = expressions.continueTarget
            let outerBreak = expressions.breakTarget
            expressions.setBreakTarget(null)
            expressions.setContinueTarget(null)
            let condition = expressions.emit(value.condition)
            let advance = emitAll(value.advanceValues())
            let latch = expressions.freshTemporary()
            expressions.setContinueTarget(latch)
            let body = emitAll(value.bodyValues())
            expressions.setContinueTarget(outer)
            expressions.setBreakTarget(outerBreak)
            if (!condition.emitted) return condition
            if (!body.emitted) return body
            if (!advance.emitted) return advance
            return Es6CodeResult(code: "while (true) {\n" + condition.setup +
                "if (!(" + condition.code + ")) break;\n" + latch + ": {\n" + body.code +
                "}\n" + advance.code + "}\n")
        }
        if (statement.class.isOfType(BoundContinueStatement.class)) {
            return Es6CodeResult(code: expressions.continueTarget ?
                "break " + expressions.continueTarget + ";\n" : "continue;\n")
        }
        if (statement.class.isOfType(BoundExternalStatement.class)) {
            let value = (BoundExternalStatement)statement
            return statements.emitExternal(value, expressions)
        }
        if (statement.class.isOfType(BoundIfStatement.class)) {
            let value = (BoundIfStatement)statement
            return statements.emitIf(
                value,
                expressions.emit(value.condition),
                emitAll(value.thenValues()),
                emitAll(value.elseValues())
            )
        }
        if (statement.class.isOfType(BoundSwitchStatement.class)) {
            BoundSwitchStatement value = (BoundSwitchStatement)statement
            return emitSwitch(value)
        }
        if (statement.class.isOfType(BoundForEachStatement.class)) {
            let value = (BoundForEachStatement)statement
            let initialization = emitAll(value.initialization())
            if (!initialization.emitted) return initialization
            let outer = expressions.continueTarget
            let outerBreak = expressions.breakTarget
            expressions.setBreakTarget(null)
            expressions.setContinueTarget(null)
            let condition = expressions.emit(value.condition)
            let advance = emitAll(value.advance())
            let latch = expressions.freshTemporary()
            expressions.setContinueTarget(latch)
            let body = emitAll(value.body())
            expressions.setContinueTarget(outer)
            expressions.setBreakTarget(outerBreak)
            if (!body.emitted) return body
            return statements.emitForEach(value, initialization, condition,
                Es6CodeResult(code: latch + ": {\n" + body.code + "}\n"), advance)
        }
        if (statement.class.isOfType(BoundWhileStatement.class)) {
            let value = (BoundWhileStatement)statement
            let outer = expressions.continueTarget
            let outerBreak = expressions.breakTarget
            expressions.setBreakTarget(null)
            expressions.setContinueTarget(null)
            let body = emitAll(value.bodyValues())
            let condition = expressions.emit(value.condition)
            expressions.setContinueTarget(outer)
            expressions.setBreakTarget(outerBreak)
            return statements.emitWhile(value, condition, body)
        }
        if (statement.class.isOfType(BoundTryStatement.class)) {
            let value = (BoundTryStatement)statement
            let catches = String[]
            for (caught in value.catchValues()) {
                let body = emitAll(caught.statements())
                if (!body.emitted) return body
                catches.add(statements.emitCatch(caught, body).code)
            }
            let tryBody = emitAll(value.tryValues())
            if (!tryBody.emitted) return tryBody
            let finallyBody = emitAll(value.finallyValues())
            if (!finallyBody.emitted) return finallyBody
            return statements.emitTry(value, tryBody, catches, finallyBody)
        }
        if (statement.class.isOfType(BoundThrowStatement.class)) {
            let value = (BoundThrowStatement)statement
            return statements.emitThrow(value, expressions.emit(value.value))
        }
        if (statement.class.isOfType(BoundExpressionStatement.class)) {
            let value = (BoundExpressionStatement)statement
            return statements.emitExpression(value, expressions.emit(value.expression))
        }
        if (statement.class.isOfType(BoundLocalDeclarationStatement.class)) {
            let value = (BoundLocalDeclarationStatement)statement
            if (!value.initializer) return statements.emitUninitializedLocal(value)
            return statements.emitInitializedLocal(value, expressions.emit(BoundConversionExpression(
                value.range, value.local.semanticType, value.initializer, value.conversion)))
        }
        if (statement.class.isOfType(BoundNativeArrayClearStatement.class)) {
            let value = (BoundNativeArrayClearStatement)statement
            return emitStore(value.target, BoundLiteralExpression(value.range, value.target.semanticType, "null"))
        }
        if (statement.class.isOfType(BoundArrayAssignmentStatement.class)) {
            let value = (BoundArrayAssignmentStatement)statement
            return emitStore(value.target, BoundConversionExpression(
                value.range, value.target.semanticType, value.value, value.conversion))
        }
        if (statement.class.isOfType(BoundAssignmentStatement.class)) {
            let value = (BoundAssignmentStatement)statement
            return statements.emitAssignment(value, expressions.emit(BoundConversionExpression(
                value.range, value.target.semanticType, value.value, value.conversion)))
        }
        if (statement.class.isOfType(BoundMemberAssignmentStatement.class)) {
            let value = (BoundMemberAssignmentStatement)statement
            if (value.compoundOperator) return Es6CodeResult(diagnostic: Es6BackendDiagnostic(
                "es6.unlowered-compound-store", "Compound field statement requires target-independent lowering"))
            return emitStore(value.target, BoundConversionExpression(
                value.range, value.target.semanticType, value.value, value.conversion))
        }
        if (statement.class.isOfType(BoundReturnStatement.class)) {
            let value = (BoundReturnStatement)statement
            if (!value.value) return statements.emitVoidReturn(value)
            var Es6CodeResult result = expressions.emit(BoundConversionExpression(
                value.range, value.requiredType, value.value, value.conversion))
            if (expressions.returnDeclaration && expressions.returnDeclaration.kind() == "generic-parameter") {
                result = expressions.expressions.emitGenericResult(value.requiredType, result, expressions.returnBoxingConstructor)
            }
            return statements.emitReturn(value, result)
        }
        return Es6CodeResult(diagnostic: Es6BackendDiagnostic(
            "es6.unsupported-statement",
            "ES6 backend cannot orchestrate reduced statement '#{statement.unitKind()}'",
            statement.range
        ))
    }

    emitSwitch(BoundSwitchStatement value) -> Es6CodeResult {
        let outer = expressions.breakTarget
        let exit = expressions.freshTemporary()
        expressions.setBreakTarget(exit)
        let result = emitSwitchSelection(value, exit)
        expressions.setBreakTarget(outer)
        return result
    }

    emitSwitchSelection(BoundSwitchStatement value, String exit) -> Es6CodeResult {
        let selected = expressions.emit(value.value)
        if (!selected.emitted) return selected
        let input = expressions.freshTemporary()
        let index = expressions.freshTemporary()
        var String code = exit + ": {\n" + selected.setup + "let " + input + " = " + selected.code + ";\n" +
            "let " + index + " = -1;\n"
        var String cases = ""
        var Int ordinal
        var Int defaultIndex = -1
        for (caseValue in value.caseValues()) {
            if (caseValue.defaultCase) defaultIndex = ordinal
            else {
                let label = expressions.emit(caseValue.label)
                if (!label.emitted) return label
                code += "if (" + index + " === -1) {\n" + label.setup + "if (" + input + " === " + label.code +
                    ") " + index + " = " + ordinal + ";\n}\n"
            }
            let body = emitAll(caseValue.statementValues())
            if (!body.emitted) return body
            cases += "case " + ordinal + ":\n" + body.code + (caseValue.fallsThrough ? "" : "break;\n")
            ordinal++
        }
        code += "if (" + index + " === -1) " + index + " = " + defaultIndex + ";\n"
        return Es6CodeResult(code: code + "switch (" + index + ") {\n" + cases + "}\n}\n")
    }

    emitStore(BoundExpression target, BoundExpression value) -> Es6CodeResult {
        let scan = Es6EvaluationScan()
        scan.lowerExpression(target)
        scan.lowerExpression(value)
        if (!scan.found) return statements.emitAssignmentValue(expressions.emit(target), expressions.emit(value))
        let plan = Es6EvaluationPlan(expressions)
        let location = plan.target(target)
        let selected = plan.lowerExpression(value)
        if (plan.diagnostic) return Es6CodeResult(diagnostic: plan.diagnostic)
        let result = statements.emitAssignmentValue(expressions.emit(location), expressions.emit(selected))
        if (!result.emitted) return result
        return Es6CodeResult(code: plan.code + result.code)
    }

    public emitAll(BoundStatement[] values) -> Es6CodeResult {
        if (!values) throw Exception("ES6 statement list is required")
        var String code = ""
        for (value in values) {
            let emitted = emit(value)
            if (!emitted.emitted) return emitted
            code += emitted.code
        }
        return Es6CodeResult(code: code)
    }
}
