package flat/writer/es6/bound

import flat/bound

/** Emits complete first-slice function/type units or one diagnostic without partial fragments. */
class {
    public construct(
        visible Es6StatementOrchestrator statements = Es6StatementOrchestrator(),
        visible Es6UnitEmitter units = Es6UnitEmitter()
    ) {
        if (!statements || !units) throw Exception("ES6 unit orchestration requires emitters")
    }

    parameterNames(BoundFunctionUnit functionUnit) -> String[] {
        return functionUnit.parameterValues().map((parameter) => {
            let name = Es6NameMangler.mangle(parameter.identity.value)
            if (!parameter.defaultValue) return name
            let value = statements.expressions.emit(parameter.defaultValue)
            if (!value.emitted) throw Exception(value.diagnostic.message)
            return name + " = " + value.code
        })
    }

    public emitFunction(BoundFunctionUnit functionUnit, Int ordinal) -> Es6EmissionResult {
        if (!functionUnit) throw Exception("ES6 function unit is required")
        let loweredFunction = CollectionControlLoweringPass().lower(functionUnit)
        let body = statements.emitAll(loweredFunction.statements())
        if (!body.emitted) return Es6EmissionResult(diagnostic: body.diagnostic)
        let parameters = parameterNames(loweredFunction)
        let code = loweredFunction.constructorFunction ?
            units.emitConstructor(parameters, body.code) :
            units.emitFunction(loweredFunction.identity.value, parameters, body.code)
        return Es6EmissionResult(
            fragment: Es6ArtifactFragment(loweredFunction.identity.value, ordinal, code)
        )
    }

    public emitMethod(BoundFunctionUnit functionUnit) -> Es6CodeResult {
        if (!functionUnit) throw Exception("ES6 method unit is required")
        var Es6CodeResult body = statements.emitAll(functionUnit.statements())
        if (!body.emitted) return body
        let parameters = parameterNames(functionUnit)
        if (functionUnit.constructorFunction) {
            return Es6CodeResult(code: units.emitConstructor(parameters, body.code))
        }
        let name = functionUnit.dispatchIdentity ?: functionUnit.identity.value
        return Es6CodeResult(code: units.emitMethod(
            name,
            parameters,
            body.code,
            functionUnit.staticFunction,
            functionUnit.asyncFunction,
            functionUnit.externalName
        ))
    }

    emitTypeMethod(
        BoundFunctionUnit functionUnit,
        BoundTypeUnit typeUnit
    ) -> Es6CodeResult {
        if (!functionUnit.constructorFunction || !typeUnit.parentType) return emitMethod(functionUnit)
        let body = statements.emitAll(functionUnit.statements())
        if (!body.emitted) return body
        let parentCall = functionUnit.parentConstructorCall
        let parentArgumentValues = parentCall.argumentValues()
        let parentArguments = statements.expressions.emitArguments(parentArgumentValues)
        if (!parentArguments.emitted) return parentArguments
        let parameters = parameterNames(functionUnit)
        return Es6CodeResult(code: units.emitConstructor(
            parameters, "super(" + parentArguments.code + ");\n" + body.code
        ))
    }

    emitMetadata(BoundTypeUnit typeUnit) -> String {
        let owner = Es6NameMangler.mangle(typeUnit.identity.value)
        let typeName = typeUnit.identity.name
        var String result = owner + "." + Es6RuntimeAbi().typeMetadataProperty +
            " = { name: '" + typeName + "' };\n"
        let implemented = typeUnit.metadata().filter({ _.metadataKind == "implements" })
        if (implemented.isNotEmpty) {
            let names = implemented.map({ "'" + _.value + "'" })
            result += owner + ".__flatType.interfaces = [" + names.join(", ") + "];\n"
        }
        let reified = typeUnit.metadata().filter({ _.metadataKind == "reified" })
        if (reified.isEmpty) return result
        let values = reified.map({ "'" + _.value + "'" })
        return result + owner + ".__flatReified = [" + values.join(", ") + "];\n"
    }

    public emitType(BoundTypeUnit typeUnit, Int ordinal) -> Es6EmissionResult {
        if (!typeUnit) throw Exception("ES6 type unit is required")
        let loweredFunctions = BoundFunctionUnit[]
        for (functionUnit in typeUnit.functionUnits()) {
            let lowered = CollectionControlLoweringPass().lower(functionUnit)
            loweredFunctions.add(lowered)
        }
        let loweredType = BoundTypeUnit(
            typeUnit.identity, typeUnit.semanticType, loweredFunctions, typeUnit.range,
            typeUnit.metadata(), typeUnit.fieldUnits(), typeUnit.parentType
        )
        let methods = String[]
        for (functionUnit in loweredType.functionUnits()) {
            if (functionUnit.abstractFunction) continue
            let method = emitTypeMethod(functionUnit, typeUnit)
            if (!method.emitted) return Es6EmissionResult(diagnostic: method.diagnostic)
            methods.add(method.code)
        }
        let classCode = units.emitClass(
            loweredType.identity.value,
            loweredType.parentType ? loweredType.parentType.declarationIdentity.value : null,
            String[],
            methods
        )
        let owner = Es6NameMangler.mangle(loweredType.identity.value)
        var String staticFields = ""
        for (field in loweredType.fieldUnits().filter({ _.staticField })) {
            if (!field.initializer) continue
            let initializer = statements.expressions.emit(field.initializer)
            if (!initializer.emitted) {
                return Es6EmissionResult(diagnostic: initializer.diagnostic)
            }
            staticFields += owner + "." + Es6NameMangler.mangle(field.identity.value) +
                " = " + initializer.code + ";\n"
        }
        return Es6EmissionResult(fragment: Es6ArtifactFragment(
            loweredType.identity.value,
            ordinal,
            classCode + staticFields + emitMetadata(loweredType)
        ))
    }
}
