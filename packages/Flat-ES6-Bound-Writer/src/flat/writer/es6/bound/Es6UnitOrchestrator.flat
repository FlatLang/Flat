package flat/writer/es6/bound

import flat/bound

/** Emits complete first-slice function/type units or one diagnostic without partial fragments. */
class {
    public construct(
        visible Es6StatementOrchestrator statements = Es6StatementOrchestrator(),
        visible Es6UnitEmitter units = Es6UnitEmitter()
    ) {
        if (!statements || !units) throw Exception("ES6 unit orchestration requires emitters")
    }

    parameterNames(BoundFunctionUnit functionUnit) -> String[] {
        return functionUnit.parameterValues().map((parameter) => statements.expressions.storageName(parameter.identity.value))
    }

    parameterDefaults(BoundFunctionUnit functionUnit) -> Es6CodeResult {
        var String code = ""
        for (parameter in functionUnit.parameterValues()) {
            if (!parameter.defaultValue) continue
            let value = statements.expressions.emit(parameter.defaultValue)
            if (!value.emitted) return value
            let name = statements.expressions.storageName(parameter.identity.value)
            code += "if (" + name + " === undefined) {\n" + value.setup + name + " = " + value.code + ";\n}\n"
        }
        return Es6CodeResult(code: code)
    }

    emitBody(BoundFunctionUnit functionUnit) -> Es6CodeResult {
        let defaults = parameterDefaults(functionUnit)
        if (!defaults.emitted) return defaults
        let body = statements.emitAll(functionUnit.statements(), includePrelude: false)
        if (!body.emitted) return body
        return Es6CodeResult(code: statements.expressions.scopePrelude(functionUnit.statements()) + defaults.code + body.code)
    }

    public emitFunction(BoundFunctionUnit functionUnit, Int ordinal) -> Es6EmissionResult {
        try { return emitFunctionBody(functionUnit, ordinal) }
        finally { statements.expressions.resetOwner() }
    }

    emitFunctionBody(BoundFunctionUnit functionUnit, Int ordinal) -> Es6EmissionResult {
        if (!functionUnit) throw Exception("ES6 function unit is required")
        if (functionUnit.constructorPlan) return Es6EmissionResult(diagnostic: Es6BackendDiagnostic(
            "es6.constructor-plan-owner-required", "Normalized constructor allocation requires its published type"))
        statements.expressions.resetOwner()
        if (functionUnit.abstractFunction) {
            return Es6EmissionResult(diagnostic: Es6BackendDiagnostic(
                "es6.abstract-function-body", "Abstract declarations have no executable function body"))
        }
        if (functionUnit.lazyProperty) {
            return Es6EmissionResult(diagnostic: Es6BackendDiagnostic(
                "es6.unlowered-lazy-property", "Lazy properties require type lowering before emission"))
        }
        let loweredFunction = CollectionControlLoweringPass().lower(functionUnit)
        let naming = statements.expressions.prepareOwner(loweredFunction)
        if (naming) return Es6EmissionResult(diagnostic: naming)
        let body = emitBody(loweredFunction)
        if (!body.emitted) return Es6EmissionResult(diagnostic: body.diagnostic)
        let parameters = parameterNames(loweredFunction)
        let code = loweredFunction.constructorFunction ?
            units.emitConstructor(parameters, body.code) :
            units.emitFunction(loweredFunction.identity.value, parameters, body.code,
                asyncFunction: loweredFunction.asyncFunction, externalName: loweredFunction.externalName)
        return Es6EmissionResult(
            fragment: Es6ArtifactFragment(loweredFunction.identity.value, ordinal, code)
        )
    }

    emitConstructorDelegation(
        BoundFunctionUnit functionUnit
    ) -> Es6CodeResult {
        if (!functionUnit.constructorDelegation) return Es6CodeResult(code: "")
        let arguments = statements.expressions.emitArguments(
            functionUnit.constructorDelegation.argumentValues()
        )
        if (!arguments.emitted) return arguments
        let target = Es6NameMangler.mangle(
            functionUnit.constructorDelegation.target.identity.declaration.value
        )
        return Es6CodeResult(code: arguments.setup + "this." + target + "(" + arguments.code + ");\n")
    }

    public emitMethod(BoundFunctionUnit functionUnit) -> Es6CodeResult {
        try { return emitMethodBody(functionUnit) }
        finally { statements.expressions.resetOwner() }
    }

    emitMethodBody(BoundFunctionUnit functionUnit) -> Es6CodeResult {
        if (!functionUnit) throw Exception("ES6 method unit is required")
        if (functionUnit.constructorPlan) return Es6CodeResult(diagnostic: Es6BackendDiagnostic(
            "es6.constructor-plan-owner-required", "Normalized constructor allocation requires its published type"))
        statements.expressions.resetOwner()
        let naming = statements.expressions.prepareOwner(functionUnit)
        if (naming) return Es6CodeResult(diagnostic: naming)
        if (functionUnit.abstractFunction) {
            return Es6CodeResult(diagnostic: Es6BackendDiagnostic(
                "es6.abstract-function-body", "Abstract declarations have no executable method body"))
        }
        if (functionUnit.lazyProperty) {
            return Es6CodeResult(diagnostic: Es6BackendDiagnostic(
                "es6.unlowered-lazy-property", "Lazy properties require type lowering before emission"))
        }
        var Es6CodeResult body = statements.emitAll(functionUnit.statements(), includePrelude: false)
        if (!body.emitted) return body
        let defaults = parameterDefaults(functionUnit)
        if (!defaults.emitted) return defaults
        let delegation = emitConstructorDelegation(functionUnit)
        if (!delegation.emitted) return delegation
        let parameters = parameterNames(functionUnit)
        if (functionUnit.constructorFunction) {
            return Es6CodeResult(code: units.emitConstructor(
                parameters, statements.expressions.scopePrelude(functionUnit.statements()) + defaults.code + delegation.code + body.code
            ))
        }
        let name = functionUnit.dispatchIdentity ?: functionUnit.identity.value
        return Es6CodeResult(code: units.emitMethod(
            name,
            parameters,
            statements.expressions.scopePrelude(functionUnit.statements()) + defaults.code + body.code,
            functionUnit.staticFunction,
            functionUnit.asyncFunction,
            functionUnit.externalName
        ))
    }

    emitTypeConstructorOverload(
        BoundFunctionUnit functionUnit,
        BoundTypeUnit typeUnit
    ) -> Es6CodeResult {
        try { return emitTypeConstructorOverloadBody(functionUnit, typeUnit) }
        finally { statements.expressions.resetOwner() }
    }

    emitTypeConstructorOverloadBody(
        BoundFunctionUnit functionUnit,
        BoundTypeUnit typeUnit
    ) -> Es6CodeResult {
        statements.expressions.resetOwner()
        let naming = statements.expressions.prepareOwner(functionUnit)
        if (naming) return Es6CodeResult(diagnostic: naming)
        let body = statements.emitAll(functionUnit.statements(), includePrelude: false)
        if (!body.emitted) return body
        let defaults = parameterDefaults(functionUnit)
        if (!defaults.emitted) return defaults
        let delegation = emitConstructorDelegation(functionUnit)
        if (!delegation.emitted) return delegation
        let parameters = parameterNames(functionUnit)
        let name = functionUnit.identity.value
        let prelude = statements.expressions.scopePrelude(functionUnit.statements())
        let initializer = units.emitConstructorInitializer(
            name, parameters, prelude + defaults.code + delegation.code + body.code
        )
        var String parentArguments = ""
        var String parentSetup = ""
        if (functionUnit.parentConstructorCall) {
            let emitted = statements.expressions.emitArguments(
                functionUnit.parentConstructorCall.argumentValues()
            )
            if (!emitted.emitted) return emitted
            parentArguments = emitted.code
            parentSetup = emitted.setup
        }
        let factory = units.emitConstructorFactory(
            name, typeUnit.identity.value,
            typeUnit.parentType ? typeUnit.parentType.declarationIdentity.value : null,
            parameters, parentArguments, prelude + defaults.code + parentSetup,
            statements.expressions.generatedName("value")
        )
        return Es6CodeResult(code: initializer + factory)
    }

    emitTypeMethod(
        BoundFunctionUnit functionUnit,
        BoundTypeUnit typeUnit
    ) -> Es6CodeResult {
        try { return emitTypeMethodBody(functionUnit, typeUnit) }
        finally { statements.expressions.resetOwner() }
    }

    emitTypeMethodBody(
        BoundFunctionUnit functionUnit,
        BoundTypeUnit typeUnit
    ) -> Es6CodeResult {
        if (!functionUnit.constructorFunction || !typeUnit.parentType) return emitMethod(functionUnit)
        statements.expressions.resetOwner()
        let naming = statements.expressions.prepareOwner(functionUnit)
        if (naming) return Es6CodeResult(diagnostic: naming)
        let defaults = parameterDefaults(functionUnit)
        if (!defaults.emitted) return defaults
        let body = statements.emitAll(functionUnit.statements(), includePrelude: false)
        if (!body.emitted) return body
        let delegation = emitConstructorDelegation(functionUnit)
        if (!delegation.emitted) return delegation
        let parentCall = functionUnit.parentConstructorCall
        let parentArgumentValues = parentCall.argumentValues()
        let parentArguments = statements.expressions.emitArguments(parentArgumentValues)
        if (!parentArguments.emitted) return parentArguments
        let parameters = parameterNames(functionUnit)
        return Es6CodeResult(code: units.emitConstructor(
            parameters, statements.expressions.scopePrelude(functionUnit.statements()) + defaults.code + parentArguments.setup + "super(" + parentArguments.code + ");\n" +
                delegation.code + body.code
        ))
    }

    metadataLiteral(String value) -> String {
        return "'" + value.replace("\\", "\\\\").replace("'", "\\'")
            .replace("\r", "\\r").replace("\n", "\\n")
            .replace("\u2028", "\\u2028").replace("\u2029", "\\u2029") + "'"
    }

    emitMetadata(BoundTypeUnit typeUnit) -> String {
        let owner = Es6NameMangler.mangle(typeUnit.identity.value)
        let typeName = typeUnit.identity.name
        var String result = owner + "." + Es6RuntimeAbi().typeMetadataProperty +
            " = { name: " + metadataLiteral(typeName) + " };\n"
        let implemented = typeUnit.metadata().filter({ _.metadataKind == "implements" })
        let identities = implemented.filter({ _.declarationIdentity != null })
        let identityValues = identities.map({ metadataLiteral(_.declarationIdentity.value) })
        result += owner + ".__flatType.interfaceIdentities = [" + identityValues.join(", ") + "];\n"
        if (implemented.isNotEmpty) {
            let names = implemented.map({ metadataLiteral(_.value) })
            result += owner + ".__flatType.interfaces = [" + names.join(", ") + "];\n"
        }
        let reified = typeUnit.metadata().filter({ _.metadataKind == "reified" })
        if (reified.isEmpty) return result
        let values = reified.map({ metadataLiteral(_.value) })
        return result + owner + ".__flatReified = [" + values.join(", ") + "];\n"
    }

    /** Compatibility adapter: emit once, retain legacy combined output. */
    public emitType(BoundTypeUnit typeUnit, Int ordinal) -> Es6EmissionResult {
        let emitted = emitTypeSections(typeUnit, ordinal)
        if (!emitted.emitted) return Es6EmissionResult(diagnostic: emitted.diagnostic)
        let sections = emitted.sections
        return Es6EmissionResult(fragment: Es6ArtifactFragment(sections.identity, sections.ordinal,
            sections.declarations + sections.metadata + sections.eagerInitializers))
    }

    public emitTypeSections(BoundTypeUnit typeUnit, Int ordinal) -> Es6TypeSectionsResult {
        if (!typeUnit) throw Exception("ES6 type unit is required")
        if (typeUnit.functionUnits().any({ _.lazyProperty })) {
            return Es6TypeSectionsResult(diagnostic: Es6BackendDiagnostic(
                "es6.unlowered-lazy-property", "Lazy properties require type lowering before emission"))
        }
        let loweredFunctions = BoundFunctionUnit[]
        for (functionUnit in typeUnit.functionUnits()) {
            let lowered = CollectionControlLoweringPass().lower(functionUnit)
            loweredFunctions.add(lowered)
        }
        let loweredType = BoundTypeUnit(
            typeUnit.identity, typeUnit.semanticType, loweredFunctions, typeUnit.range,
            typeUnit.metadata(), typeUnit.fieldUnits().map((field) => CollectionControlLoweringPass().lowerField(field)), typeUnit.parentType
        )
        let methods = String[]
        for (functionUnit in loweredType.functionUnits()) {
            if (functionUnit.abstractFunction) continue
            let method = functionUnit.constructorPlan ?
                Es6ConstructorPlanEmitter().emit(functionUnit, loweredType) :
                functionUnit.constructorFunction &&
                functionUnit.identity.syntaxIdentity.kind == "constructor-overload"
                ? emitTypeConstructorOverload(functionUnit, typeUnit)
                : emitTypeMethod(functionUnit, typeUnit)
            if (!method.emitted) return Es6TypeSectionsResult(diagnostic: method.diagnostic)
            methods.add(method.code)
        }
        let classCode = units.emitClass(
            loweredType.identity.value,
            loweredType.parentType ? loweredType.parentType.declarationIdentity.value : null,
            String[],
            methods
        )
        let owner = Es6NameMangler.mangle(loweredType.identity.value)
        var String staticFields = ""
        statements.expressions.setTemporaryPrefix(owner + "_evaluation")
        for (field in loweredType.fieldUnits().filter({ _.staticField })) {
            if (!field.initializer) continue
            let initializer = statements.expressions.emit(field.initializer)
            if (!initializer.emitted) {
                return Es6TypeSectionsResult(diagnostic: initializer.diagnostic)
            }
            let fieldOwner = Es6NameMangler.mangle(field.canonicalOwner().value)
            staticFields += initializer.setup + fieldOwner + "." + Es6NameMangler.mangle(field.identity.value) +
                " = " + initializer.code + ";\n"
        }
        return Es6TypeSectionsResult(sections: Es6TypeSections(
            loweredType.identity.value, ordinal,
            loweredType.parentType ? loweredType.parentType.declarationIdentity : null,
            classCode, emitMetadata(loweredType), staticFields
        ))
    }
}
