package flat/writer/es6/bound

import flat/bound
import flat/semantic/types

/** Emits literal/reference/member/conversion expressions for the first vertical slice. */
class {
    var CallableSignature[] boxingTargets

    /** Targets must be canonical constructors resolved by the semantic owner.
     * The writer never discovers wrappers from primitive names or runtime values.
     */
    public construct(CallableSignature[] boxingConstructors = CallableSignature[]) {
        if (!boxingConstructors || boxingConstructors.any((constructor) => !constructor)) {
            throw Exception("ES6 boxing requires resolved constructor evidence")
        }
        boxingTargets = CallableSignature[]:addAll(boxingConstructors)
    }

    public emitGenericResult(SemanticType concreteType, Es6CodeResult value,
        CallableSignature resultBoxingConstructor = null) -> Es6CodeResult {
        if (!value.emitted || concreteType.kind() != "primitive") return value
        var CallableSignature[] candidates = boxingTargets
        if (resultBoxingConstructor) {
            candidates = CallableSignature[]
            candidates.add(resultBoxingConstructor)
        }
        let selected = candidates.filter((candidate) => candidate.callableKind.value == "constructor" &&
            !candidate.asyncFunction && candidate.optionalParameterCount == 0 && candidate.ownerType != null && candidate.parameterTypes().count == 1 &&
            candidate.parameterTypes().first.value() == concreteType.value() &&
            candidate.returnType.value() == candidate.ownerType.value())
        if (selected.count != 1) return Es6CodeResult(diagnostic: Es6BackendDiagnostic(
            "es6.generic-result-boxing-evidence", "Generic primitive result requires one resolved canonical boxing constructor"))
        let target = selected.first
        let owner = Es6NameMangler.mangle(target.ownerType.declarationIdentity.value)
        let overload = target.identity.declaration.syntaxIdentity.kind == "constructor-overload"
            ? Es6NameMangler.mangle(target.identity.declaration.value) : null
        return Es6CodeResult(code: Es6CallEmitter().emitConstructorCall(owner, value.code, overload), setup: value.setup)
    }
    public emitDeclarationValue(
        Es6CodeResult local,
        Es6CodeResult value
    ) -> Es6CodeResult {
        if (!local || !value) throw Exception("ES6 declaration value requires local and value")
        if (!local.emitted) return local
        if (!value.emitted) return value
        return Es6CodeResult(code: "(" + local.code + " = " + value.code + ")")
    }

    public emitPostfixUpdate(
        BoundPostfixUpdateExpression expression,
        Es6CodeResult target
    ) -> Es6CodeResult {
        if (!expression || !target) {
            throw Exception("ES6 postfix update requires expression and target")
        }
        if (!target.emitted) return target
        return Es6CodeResult(code: "(" + target.code + expression.updateOperator + ")")
    }

    public emitAssignmentValue(
        Es6CodeResult target,
        Es6CodeResult value
    ) -> Es6CodeResult {
        if (!target || !value) throw Exception("ES6 assignment value requires target and value")
        if (!target.emitted) return target
        if (!value.emitted) return value
        return Es6CodeResult(code: "(" + target.code + " = " + value.code + ")")
    }

    public emitLiteral(BoundLiteralExpression expression) -> Es6CodeResult {
        if (!expression) throw Exception("ES6 literal emission requires an expression")
        if (expression.semanticType.kind() == "unit") return Es6CodeResult(code: "void 0")
        return Es6CodeResult(code: expression.sourceValue)
    }

    public emitInterpolatedString(
        BoundInterpolatedStringExpression expression,
        String[] segmentCode
    ) -> Es6CodeResult {
        if (!expression || !segmentCode || segmentCode.count != expression.segmentValues().count) {
            throw Exception("ES6 interpolation emission requires every ordered segment")
        }
        // Interpolation is always a String, even with one expression or leading
        // numeric segments. Seed concatenation before evaluating any segment so
        // adjacent numbers cannot add before the first literal is encountered.
        // The left-associated expression preserves source order and evaluates
        // each segment once without a runtime array or materialization barrier.
        return Es6CodeResult(code: "(\"\" + " + segmentCode.join(" + ") + ")")
    }

    public emitReference(BoundReferenceExpression expression) -> Es6CodeResult {
        if (!expression) throw Exception("ES6 reference emission requires an expression")
        let field = Es6NameMangler.mangle(expression.symbolIdentity.value)
        return Es6CodeResult(code: expression.staticOwner ?
            Es6NameMangler.mangle(expression.staticOwner.value) + "." + field : field)
    }

    public emitUnary(
        BoundUnaryExpression expression,
        Es6CodeResult operand
    ) -> Es6CodeResult {
        if (!expression || !operand) throw Exception("ES6 unary emission requires expression and operand")
        if (!operand.emitted) return operand
        // Parenthesize the operand: -(-x) must not become the update token --x.
        return Es6CodeResult(code: "(" + expression.operator + "(" + operand.code + "))")
    }

    public emitBinary(
        BoundBinaryExpression expression,
        Es6CodeResult left,
        Es6CodeResult right
    ) -> Es6CodeResult {
        if (!expression || !left || !right) {
            throw Exception("ES6 binary emission requires expression and operands")
        }
        if (!left.emitted) return left
        if (!right.emitted) return right
        if (expression.operator == "?:") {
            return Es6CodeResult(diagnostic: Es6BackendDiagnostic(
                "es6.unlowered-fallback", "Null fallback requires target-independent lowering"))
        }
        return Es6CodeResult(code: "(" + left.code + " " + expression.operator + " " + right.code + ")")
    }

    public emitMemberAssignmentValue(
        BoundMemberAssignmentValueExpression expression,
        Es6CodeResult target,
        Es6CodeResult value
    ) -> Es6CodeResult {
        if (!expression || !target || !value) {
            throw Exception("ES6 member assignment value requires expression, target, and value")
        }
        if (!target.emitted) return target
        if (!value.emitted) return value
        return Es6CodeResult(code: "(" + target.code + " " +
            expression.operator + "= " + value.code + ")")
    }

    public emitMemberAccess(
        BoundMemberAccessExpression expression,
        Es6CodeResult receiver
    ) -> Es6CodeResult {
        if (!expression || !receiver) {
            throw Exception("ES6 member emission requires expression and receiver")
        }
        if (!receiver.emitted) return receiver
        let String receiverCode = receiver.code
        let member = Es6NameMangler.mangle(expression.memberIdentity.value)
        if (expression.safeAccess) {
            return Es6CodeResult(diagnostic: Es6BackendDiagnostic(
                "es6.unlowered-safe-field", "Safe field access requires target-independent lowering"))
        }
        return Es6CodeResult(code: receiverCode + "." + member)
    }

    /** Consume resolved numeric-family projection and conversion evidence only.
     * Never coerce the source object. Preserve virtual dispatch and evaluate the
     * source/getter once; apply the same numeric representation as ordinary casts.
     */
    public emitNumericUnbox(BoundNumericUnboxExpression expression, Es6CodeResult value) -> Es6CodeResult {
        if (!expression || !value) throw Exception("ES6 numeric unbox requires expression and value")
        if (!value.emitted) return value
        let conversion = expression.projectionConversion
        let canonical = TypeConversions.classify(conversion.fromType, conversion.toType, explicit: true)
        if (!canonical.applicable || canonical.conversionKind != conversion.conversionKind ||
            (conversion.conversionKind != "identity" &&
             conversion.conversionKind != "numeric-widening" && conversion.conversionKind != "numeric-cast")) {
            return Es6CodeResult(diagnostic: Es6BackendDiagnostic(
                "es6.numeric-unbox-unsupported", "ES6 numeric unbox requires supported numeric projection conversion evidence", expression.range))
        }
        let owner = Es6NameMangler.mangle(expression.numberType.declarationIdentity.value)
        let getter = expression.projection.externalName ?: Es6NameMangler.mangle(
            expression.projection.dispatchIdentity ?: expression.projection.identity.declaration.value)
        return Es6CodeResult(code: "((value) => { if (value === null || !(value instanceof " + owner +
            ")) throw new TypeError('Invalid numeric unboxing cast'); return " +
            numericConversionCode(conversion, "value." + getter + "()") + "; })(" + value.code + ")")
    }

    public emitConversion(
        BoundConversionExpression expression,
        Es6CodeResult value,
        CallableSignature resultBoxingConstructor = null
    ) -> Es6CodeResult {
        if (!expression || !value) {
            throw Exception("ES6 conversion emission requires expression and value")
        }
        if (!value.emitted) return value
        if (expression.semanticType.kind() == "generic-parameter" &&
            expression.value.semanticType.kind() == "primitive") {
            return emitGenericResult(expression.value.semanticType, value, resultBoxingConstructor)
        }
        if (expression.conversion.conversionKind == "checked-reference-cast") {
            if (expression.semanticType.kind() != "user-class") {
                return Es6CodeResult(diagnostic: Es6BackendDiagnostic(
                    "es6.unsupported-checked-cast",
                    "Checked reference casts require declared class runtime evidence",
                    expression.range
                ))
            }
            let target = (UserClassSemanticType)expression.semanticType
            let name = Es6NameMangler.mangle(target.declarationIdentity.value)
            return Es6CodeResult(code: "((value) => { if (value === null || value instanceof " + name +
                ") return value; throw new TypeError('Invalid checked reference cast'); })(" + value.code + ")")
        }
        if (expression.conversion.conversionKind == "numeric-cast") {
            return Es6CodeResult(code: numericConversionCode(expression.conversion, value.code))
        }
        if (expression.conversion.conversionKind == "numeric-unboxing") {
            return Es6CodeResult(diagnostic: Es6BackendDiagnostic(
                "es6.unlowered-numeric-unboxing",
                "Numeric unboxing requires a resolved BoundNumericUnboxExpression projection",
                expression.range
            ))
        }
        return value
    }

    /** ES6 numeric primitives use numbers; integral casts discard the fraction
     * toward zero, not floor (including negative fractions and Long targets).
     * Floating/identity conversions retain IEEE values without object coercion.
     */
    numericConversionCode(TypeConversion conversion, String value) -> String {
        if (conversion.conversionKind == "numeric-cast" && TypeConversions.isIntegral(conversion.toType)) {
            return "Math.trunc(" + value + ")"
        }
        return value
    }
}
