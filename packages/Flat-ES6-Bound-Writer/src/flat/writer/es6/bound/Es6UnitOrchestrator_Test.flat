package flat/writer/es6/bound

import flat/compiler/models
import flat/semantic/types
import flat/bound

testable class {
    test `recursively emits complete slice units`() {
        let fixture = Es6BoundWriter_TestFixture()
        let stringType = SemanticTypes.stringType()
        let unitType = SemanticTypes.unitType()
        let helperIdentity = fixture.declaration("function", "message", 1)
        let helperSymbol = SymbolIdentity(helperIdentity, "function")
        let helperTarget = CallableSignature(
            helperSymbol, "message", CallableKind("function"), SemanticType[], stringType
        )
        let helper = BoundFunctionUnit(
            helperIdentity,
            "message",
            stringType,
            [BoundReturnStatement(
                fixture.range(), stringType,
                BoundLiteralExpression(fixture.range(), stringType, "'Hello, Flat'"),
                TypeConversions.classify(stringType, stringType)
            )],
            fixture.range()
        )
        let local = fixture.reference("local", "message", 2, stringType)
        let call = BoundCallExpression(
            fixture.range(), stringType, helperTarget,
            BoundExpression[], TypeConversion[]
        )
        let declaration = BoundLocalDeclarationStatement(
            fixture.range(), local, call, TypeConversions.classify(stringType, stringType)
        )
        let assignment = BoundAssignmentStatement(
            fixture.range(), local,
            BoundLiteralExpression(fixture.range(), stringType, "'Hello, Flat'"),
            TypeConversions.classify(stringType, stringType)
        )
        let mainIdentity = fixture.declaration("static-method", "main", 3)
        let main = BoundFunctionUnit(
            mainIdentity,
            "main",
            unitType,
            [declaration, assignment, BoundReturnStatement(fixture.range(), unitType)],
            fixture.range(),
            staticFunction: true,
            mainFunction: true
        )
        let typeIdentity = fixture.declaration("class", "Hello", 4)
        let typeUnit = BoundTypeUnit(
            typeIdentity, UserClassSemanticType(typeIdentity), [main], fixture.range()
        )
        let emitter = Es6UnitOrchestrator()
        let helperResult = emitter.emitFunction(helper, 0)
        let typeResult = emitter.emitType(typeUnit, 1)

        expect(helperResult.emitted).toBe(true)
        expect(helperResult.fragment.code.contains("return 'Hello, Flat';")).toBe(true)
        expect(typeResult.emitted).toBe(true)
        expect(typeResult.fragment.code.contains(
            Es6NameMangler.mangle(helperIdentity.value) + "()"
        )).toBe(true)
        expect(typeResult.fragment.code.contains(
            "let " + Es6NameMangler.mangle(local.symbolIdentity.value)
        )).toBe(true)
        expect(typeResult.fragment.code.contains(" = 'Hello, Flat';")).toBe(true)

        let field = BoundFieldUnit(
            "PI", fixture.symbol("field", "PI", 9), SemanticTypes.doubleType(),
            fixture.range(), true,
            BoundLiteralExpression(fixture.range(), SemanticTypes.doubleType(), "3.14"),
            true
        )
        let fieldType = BoundTypeUnit(
            typeIdentity, UserClassSemanticType(typeIdentity), [main], fixture.range(),
            fieldValues: [field]
        )
        let fieldResult = emitter.emitType(fieldType, 2)
        expect(fieldResult.fragment.code.contains(
            Es6NameMangler.mangle(field.identity.value) + " = 3.14;"
        )).toBe(true)
        let abstractFunction = BoundFunctionUnit(
            fixture.declaration("instance-method", "required", 10),
            "required", SemanticTypes.intType(), BoundStatement[], fixture.range(),
            abstractFunction: true
        )
        let abstractIdentity = fixture.declaration("class", "AbstractOwner", 11)
        let abstractType = BoundTypeUnit(
            abstractIdentity,
            UserClassSemanticType(abstractIdentity),
            [abstractFunction], fixture.range()
        )
        let abstractResult = emitter.emitType(abstractType, 3)
        expect(abstractResult.fragment.code.contains("required")).toBe(false)
    }

    test `emits selected static and constructor calls`() {
        let fixture = Es6BoundWriter_TestFixture()
        let ownerIdentity = fixture.declaration("class", "Owner", 1)
        let ownerType = UserClassSemanticType(ownerIdentity)
        let staticIdentity = fixture.symbol("static-method", "create", 2)
        let staticTarget = CallableSignature(
            staticIdentity, "create", CallableKind("static-method"),
            SemanticType[], ownerType, ownerType
        )
        let constructorIdentity = fixture.symbol("constructor", "Owner", 3)
        let constructorTarget = CallableSignature(
            constructorIdentity, "Owner", CallableKind("constructor"),
            SemanticType[], ownerType, ownerType
        )
        let emitter = Es6ExpressionOrchestrator()
        let staticCall = emitter.emit(BoundCallExpression(
            fixture.range(), ownerType, staticTarget,
            BoundExpression[], TypeConversion[]
        ))
        let constructorCall = emitter.emit(BoundCallExpression(
            fixture.range(), ownerType, constructorTarget,
            BoundExpression[], TypeConversion[]
        ))
        let receiver = fixture.reference("local", "owner", 4, ownerType)
        let instanceIdentity = fixture.symbol("instance-method", "read", 5)
        let instanceTarget = CallableSignature(
            instanceIdentity, "read", CallableKind("instance-method"),
            SemanticType[], ownerType, ownerType
        )
        let instanceCall = emitter.emit(BoundCallExpression(
            fixture.range(), ownerType, instanceTarget, receiver,
            BoundExpression[], TypeConversion[]
        ))
        let external = Es6StatementOrchestrator().emit(
            BoundExternalStatement(fixture.range(), "es6", [
                BoundExternalCodeSegment(fixture.range(), "code")
            ])
        )
        let owner = Es6NameMangler.mangle(ownerIdentity.value)

        expect(staticCall.code).toBe(
            owner + "." + Es6NameMangler.mangle(staticIdentity.declaration.value) + "()"
        )
        expect(constructorCall.code).toBe("new " + owner + "()")
        expect(instanceCall.code).toBe(
            Es6NameMangler.mangle(receiver.symbolIdentity.value) + "." +
            Es6NameMangler.mangle(instanceIdentity.declaration.value) + "()"
        )
        expect(external.code).toBe("code\n")

        let stringValue = fixture.reference(
            "parameter", "message", 6, SemanticTypes.stringType()
        )
        let interpolated = Es6StatementOrchestrator().emit(
            BoundExternalStatement(fixture.range(), "es6", [
                BoundExternalCodeSegment(fixture.range(), "Error("),
                BoundExternalCodeSegment(
                    fixture.range(), "", stringValue, "es6-native-string"
                ),
                BoundExternalCodeSegment(fixture.range(), ");")
            ])
        )
        expect(interpolated.code).toBe(
            "Error(" + Es6NameMangler.mangle(stringValue.symbolIdentity.value) + ");\n"
        )

        let arrayValue = fixture.reference(
            "parameter", "data", 7, ArraySemanticType(SemanticTypes.charType())
        )
        let projected = Es6StatementOrchestrator().emit(
            BoundExternalStatement(fixture.range(), "es6", [
                BoundExternalCodeSegment(
                    fixture.range(), "",
                    BoundNativeArrayDataExpression(fixture.range(), arrayValue),
                    "identity"
                )
            ])
        )
        expect(projected.code).toBe(
            Es6NameMangler.mangle(arrayValue.symbolIdentity.value) + "\n"
        )
    }

    test `unsupported reduced input produces a diagnostic and no partial fragment`() {
        let fixture = Es6BoundWriter_TestFixture()
        let functionUnit = BoundFunctionUnit(
            fixture.declaration("function", "branch", 1),
            "branch",
            SemanticTypes.unitType(),
            [BoundBranchStatement(fixture.range(), "target")],
            fixture.range()
        )
        let result = Es6UnitOrchestrator().emitFunction(functionUnit, 0)

        expect(result.emitted).toBe(false)
        expect(result.fragment).toBe(null)
        expect(result.diagnostic.code).toBe("es6.unsupported-statement")
    }
}
