            destination,
            code + "const value = new " + className + "();\n" +
                "console.log(value." + runName + "());\n" +
                "console.log(value." + fallbackName + "());\n" +
                "console.log(value." + validateName + "(0, 1, true));\n" +
                "console.log(value." + validateName + "(0, 1, false));\n"
        )
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("true\nfalse\nfalse\ntrue\n")
        Es6ArtifactFiles.remove(root)
    }

    async test `declared reference null branch executes under Node`() {
        let stream = Lexer().lex(
            "class Value { substring(Bool invalid) -> Value { " +
                "if (invalid) { return null; } return this; } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:nullable-reference-return-execute"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse(
            stream.consumeAll<Token>("data"), snapshot
        )
        let type = PrimitiveClassPartitionBinder().bind([syntax], snapshot).typeUnits().first
        let className = Es6NameMangler.mangle(type.identity.value)
        let substringName = Es6NameMangler.mangle(
            type.functionUnits().firstOrNull({ _.name == "substring" }).identity.value
        )
        let code = Es6UnitOrchestrator().emitType(type, 0).fragment.code
        let root = File(".flat-es6-null-return-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "null-return.js")
        Es6ArtifactCommitter().commit(
            destination,
            code + "const value = new " + className + "();\n" +
                "console.log(value." + substringName + "(true) === null);\n" +
                "console.log(value." + substringName + "(false) === value);\n"
        )
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("true\ntrue\n")
        Es6ArtifactFiles.remove(root)
    }

    async test `cast dispatch executes under Node`() {
        let stream = Lexer().lex(
            "class StringCharArray { equals(Object other) -> Bool { " +
                "return equals((StringCharArray)other); } " +
                "equals(StringCharArray other) -> Bool { return true; } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:receiver-overload-execute"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse(
            stream.consumeAll<Token>("data"), snapshot
        )
        let type = PrimitiveClassPartitionBinder().bind([syntax], snapshot).typeUnits().first
        let overloads = type.functionUnits().filter({ _.name == "equals" })
        let objectOverload = overloads.first
        let className = Es6NameMangler.mangle(type.identity.value)
        let objectMethod = Es6NameMangler.mangle(objectOverload.identity.value)
        let code = Es6UnitOrchestrator().emitType(type, 0).fragment.code
        let root = File(".flat-es6-receiver-overload-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "receiver-overload.js")
        Es6ArtifactCommitter().commit(
            destination,
            code + "const value = new " + className + "();\n" +
                "console.log(value." + objectMethod + "(value));\n"
        )
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("true\n")
        Es6ArtifactFiles.remove(root)
    }

}
