        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("z\n")
        Es6ArtifactFiles.remove(root)
    }

    async test `callable invocation with implicit field executes under Node`() {
        let stream = Lexer().lex(
            "class Value { Char[] chars; construct() { chars = ['a']; } " +
                "transform(map(Char, Int) -> Char) -> Char { return map(chars[0], 0); } " +
                "apply(map(Char, Int) -> Char) -> Char { return transform(map); } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:function-invocation-field-execute"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot
        ).typeUnit
        let code = Es6UnitOrchestrator().emitType(type, 0).fragment.code
        let className = Es6NameMangler.mangle(type.identity.value)
        let applyName = Es6NameMangler.mangle(
            type.functionUnits().firstOrNull({ _.name == "apply" }).identity.value
        )
        let root = File(".flat-es6-function-field-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "function-field.js")
        Es6ArtifactCommitter().commit(destination,
            code + "console.log(new " + className + "()." + applyName +
                "((value, index) => value));\n")
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("a\n")
        Es6ArtifactFiles.remove(root)
    }

    async test `declared String conditional branch reconciliation executes under Node`() {
        let stream = Lexer().lex(
            "class String { Char[] chars; construct() { chars = ['a']; } " +
                "this[Int index] -> Char { get { return chars[index]; } } " +
                "substring(Int start) -> String { return this; } " +
                "capitalize() -> String { return true ? " +
                "this[0].toUpperCase() + substring(1) : this; } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:declared-string-conditional-execute"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot
        ).typeUnit
        let code = Es6UnitOrchestrator().emitType(type, 0).fragment.code
        let className = Es6NameMangler.mangle(type.identity.value)
        let capitalizeName = Es6NameMangler.mangle(
            type.functionUnits().firstOrNull({ _.name == "capitalize" }).identity.value
        )
        let root = File(".flat-es6-declared-string-conditional-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "declared-string-conditional.js")
        Es6ArtifactCommitter().commit(destination,
            code + "console.log(new " + className + "()." + capitalizeName + "());\n")
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("").count > 0).toBe(true)
        Es6ArtifactFiles.remove(root)
    }

