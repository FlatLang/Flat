package flat/writer/es6/bound

import flat/io
import flat/system
import flat/time/Time
import flat/lexer/Lexer
import flat/parser/flat
import flat/semantic/binding/primitive
import flat/compiler/models
import flat/bound
import flat/semantic/types

/** Executes receiver-owned overload selection through generated ES6. */
testable class {
    async test `declared static field named defaults and reference absence execute`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:semantic-contract-execute"), "one")
        let sources = ["class Limit { visible static Int MAX = 42; }",
            "class Value { public choose(Int first = 1, Int: middle = 2, Int: last = 3) -> Int { return first + middle + last; } public run() -> Int { return this.choose(middle: 8) + Limit.MAX; } public absent(Object value) -> Bool { return !value; } }"]
        let syntaxes = PrimitiveClassSyntax[]
        var Int offset
        for (source in sources) {
            let stream = Lexer().lex(source)
            stream.emit("start")
            syntaxes.add(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot, offset))
            offset += 100
        }
        let units = PrimitiveClassPartitionBinder().bindContexts([PrimitiveSourceBindingContext("flat", snapshot, syntaxes)]).typeUnits()
        var String code = ""
        for (unit in units) code += Es6UnitOrchestrator().emitType(unit, 0).fragment.code
        let unit = units.last
        let owner = Es6NameMangler.mangle(unit.identity.value)
        let run = Es6NameMangler.mangle(unit.functionUnits().firstOrNull({ _.name == "run" }).identity.value)
        let absent = Es6NameMangler.mangle(unit.functionUnits().firstOrNull({ _.name == "absent" }).identity.value)
        let root = File(".flat-es6-contracts-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "contracts.js")
        Es6ArtifactCommitter().commit(destination, code + "let v = new " + owner + "(); console.log(v." + run + "(),v." + absent + "(null),v." + absent + "({}));\n")
        let response = System.execute(["node", destination.normalizedLocation], silent: true, shell: false)
        Es6ArtifactFiles.remove(root)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("54 true false\n")
    }

    async test `executes owner scoped nested inference`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:nested-inference-execute"), "one")
        let traitStream = Lexer().lex("trait Items<E> { public relay(Box<Box<E>> value) -> Box<Box<E>> { return value; } public nested(Box<Box<E>> value) => relay(value) }")
        traitStream.emit("start")
        let contract = PrimitiveInterfaceParser().parse(traitStream.consumeAll<Token>("data"), snapshot)
        let sources = ["class Box<E> {}", "class Generic<E> implements Items<E> {}", "class Concrete implements Items<Int> {}"]
        let syntaxes = PrimitiveClassSyntax[]
        var Int offset = 100
        for (source in sources) {
            let stream = Lexer().lex(source)
            stream.emit("start")
            syntaxes.add(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot, offset))
            offset += 100
        }
        let context = PrimitiveSourceBindingContext("flat", snapshot, syntaxes, [contract])
        let units = PrimitiveClassPartitionBinder().bindContexts([context]).typeUnits()
        var String code = ""
        for (unit in units) code += Es6UnitOrchestrator().emitType(unit, 0).fragment.code
        let unit = units.firstOrNull({ _.semanticType.declarationIdentity.name == "Concrete" })
        let owner = Es6NameMangler.mangle(unit.identity.value)
        let method = Es6NameMangler.mangle(unit.functionUnits().firstOrNull({ _.name == "nested" }).identity.value)
        let root = File(".flat-es6-nested-inference-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "nested.js")
        Es6ArtifactCommitter().commit(destination, code + "let value = {nested:{value:0}}; console.log((new " + owner + "())." + method + "(value) === value);\n")
        let response = System.execute(["node", destination.normalizedLocation], silent: true, shell: false)
        Es6ArtifactFiles.remove(root)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("true\n")
    }

