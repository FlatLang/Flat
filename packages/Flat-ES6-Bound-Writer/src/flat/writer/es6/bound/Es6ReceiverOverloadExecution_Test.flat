    async test `colon invocation retains receiver once with dot result distinct`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:colon-execution"), "one")
        let stream = Lexer().lex("class Box<E> { visible var Int count; construct() { count = 0; } public add(Int value) -> Int { count += value; return 99; } public static chained() -> Int { let box = Box<Int>():add(3); return box.count; } public static dotted() -> Int { return Box<Int>().add(3); } }")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let unit = PrimitiveClassPartitionBinder().bind([syntax], snapshot).typeUnits().first
        let code = Es6UnitOrchestrator().emitType(unit, 0).fragment.code
        let owner = Es6NameMangler.mangle(unit.identity.value)
        let chained = Es6NameMangler.mangle(unit.functionUnits().firstOrNull({ _.name == "chained" }).identity.value)
        let dotted = Es6NameMangler.mangle(unit.functionUnits().firstOrNull({ _.name == "dotted" }).identity.value)
        let root = File(".flat-es6-colon-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "colon.js")
        Es6ArtifactFiles.write(destination, code + "console.log(" + owner + "." + chained + "()," + owner + "." + dotted + "());\n")
        let response = System.execute(["node", destination.normalizedLocation], silent: true, shell: false)
        Es6ArtifactFiles.remove(root)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("3 99\n")
    }

