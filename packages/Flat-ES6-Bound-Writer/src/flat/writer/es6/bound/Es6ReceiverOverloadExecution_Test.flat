    async test `nested owner interpolation executes under Node`() {
        var String source = "class Value { Chars chars; " +
            "construct() { chars = Chars(); } " +
            "same(Value other) -> Bool { external { return "
        source += '#'
        source += "{chars.data} === "
        source += '#'
        source += "{other.chars.data}; } } }"
        let charsStream = Lexer().lex(
            "class Chars { Char[] data = ['a']; }"
        )
        charsStream.emit("start")
        let valueStream = Lexer().lex(source)
        valueStream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:nested-owner-field-path-execute"), "revision:one"
        )
        let syntaxes = [
            PrimitiveClassParser().parse(
                charsStream.consumeAll<Token>("data"), snapshot
            ),
            PrimitiveClassParser().parse(
                valueStream.consumeAll<Token>("data"), snapshot, 100, "Value"
            )
        ]
        let types = PrimitiveClassPartitionBinder().bind(syntaxes, snapshot).typeUnits()
        let charsType = types.firstOrNull({ _.identity.name == "Chars" })
        let valueType = types.firstOrNull({ _.identity.name == "Value" })
        let charsCode = Es6UnitOrchestrator().emitType(charsType, 0).fragment.code
        let valueCode = Es6UnitOrchestrator().emitType(valueType, 1).fragment.code
        let valueName = Es6NameMangler.mangle(valueType.identity.value)
        let sameName = Es6NameMangler.mangle(
            valueType.functionUnits().firstOrNull({ _.name == "same" }).identity.value
        )
        let root = File(".flat-es6-nested-owner-field-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "nested-owner-field.js")
        Es6ArtifactCommitter().commit(
            destination,
            charsCode + valueCode + "const value = new " + valueName + "();\n" +
