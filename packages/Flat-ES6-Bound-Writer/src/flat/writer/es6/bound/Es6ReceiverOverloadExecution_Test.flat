    async test `external callback suppression preserves promise identity`() {
        var String source = "class Value { apply(async map(Int) -> Int) -> Int { external { return "
        source += '#'
        source += "{map(41)$}; } } }"
        let stream = Lexer().lexInterpolated(source)
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:unawaited-callback"), "one")
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot), snapshot
        ).typeUnit
        let code = Es6UnitOrchestrator().emitType(type, 0).fragment.code
        let className = Es6NameMangler.mangle(type.identity.value)
        let applyName = Es6NameMangler.mangle(
            type.functionUnits().firstOrNull({ _.name == "apply" }).identity.value
        )
        let root = File(".flat-es6-unawaited-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "callback.js")
        Es6ArtifactCommitter().commit(destination, code +
            "const promise = Promise.resolve(42); let calls = 0; " +
            "const result = new " + className + "()." + applyName +
            "(value => { if(value !== 41) throw Error('argument'); calls++; return promise; }); " +
            "if(result !== promise || calls !== 1) throw Error('promise identity');")
        let response = System.execute(["node", destination.normalizedLocation], silent: true, shell: false)
        Es6ArtifactFiles.remove(root)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
    }

    async test `async callback result is resolved before arithmetic`() {
        let stream = Lexer().lex(
            "class Value { async apply(async map(Int) -> Int) -> Int { return map(41) + 1; } " +
                "async finish(async onAfterChunk(Int count) = {}) -> Int { onAfterChunk(1); return 42; } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:async-callback-execute"), "one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot), snapshot
        ).typeUnit
        let code = Es6UnitOrchestrator().emitType(type, 0).fragment.code
        let className = Es6NameMangler.mangle(type.identity.value)
        let applyName = Es6NameMangler.mangle(
            type.functionUnits().firstOrNull({ _.name == "apply" }).identity.value
        )
        let finishName = Es6NameMangler.mangle(
            type.functionUnits().firstOrNull({ _.name == "finish" }).identity.value
        )
        let root = File(".flat-es6-async-callback-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "callback.js")
        Es6ArtifactCommitter().commit(destination,
            code + "(async () => { const instance = new " + className + "(); " +
                "let release, reject; let completed = false; const seen = []; " +
                "const firstGate = new Promise(resolve => { release = resolve; }); " +
                "const secondGate = new Promise((resolve, fail) => { reject = fail; }); " +
                "const first = instance." + applyName +
                "(value => { seen.push(value); return firstGate; }); " +
                "first.then(() => { completed = true; }); " +
                "const second = instance." + applyName +
                "(value => { seen.push(value); return secondGate; }); " +
                "const failure = new Error('callback failure'); " +
                "const observed = second.then(() => { throw new Error('expected rejection'); }, " +
                "error => { if (error !== failure) throw new Error('lost rejection identity'); }); " +
                "await Promise.resolve(); await Promise.resolve(); " +
                "if (completed || seen.join(',') !== '41,41') throw new Error('gate or overlap violated'); " +
                "reject(failure); await observed; " +
                "if (completed) throw new Error('unrelated call completed before release'); " +
                "release(41); console.log(await first); " +
                "if (await instance." + finishName + "() !== 42) throw new Error('async default failed'); " +
                "let finishRelease; let finished = false; let chunkCount; " +
                "const finishGate = new Promise(resolve => { finishRelease = resolve; }); " +
                "const finishing = instance." + finishName +
                "(count => { chunkCount = count; return finishGate; }); " +
                "finishing.then(() => { finished = true; }); " +
                "await Promise.resolve(); await Promise.resolve(); " +
                "if (finished || chunkCount !== 1) throw new Error('callback statement was not awaited'); " +
                "finishRelease(); if (await finishing !== 42) throw new Error('finish result lost'); " +
                "await instance." + finishName + "(() => Promise.reject(failure)).then(" +
                "() => { throw new Error('statement rejection lost'); }, " +
                "error => { if (error !== failure) throw new Error('statement rejection changed'); }); " +
                "})().catch(error => { console.error(error); process.exitCode = 1; });\n")
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        Es6ArtifactFiles.remove(root)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("42\n")
    }

