        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("true\n")
        Es6ArtifactFiles.remove(root)
    }

    async test `overloaded calls in C style for clauses execute under Node`() {
        let stream = Lexer().lex(
            "class Value { visible Int count = 4; " +
                "indexOf(Char search, Int start = 0) -> Int { return 1; } " +
                "indexOf(Value search, Int start = 0) -> Int { return start + 1; } " +
                "run(Value delimiter) -> Int { var Int lastI = 0; " +
                "for (var Int i = indexOf(delimiter); i < 3; " +
