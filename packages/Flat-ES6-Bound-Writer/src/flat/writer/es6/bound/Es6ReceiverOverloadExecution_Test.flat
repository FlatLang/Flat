    async test `method generic sized array local executes`() {
        let stream = Lexer().lex("class Value { static make<Out>(Int size) -> Out[] { " +
            "let values = Array<Out>(size); return values; } }")
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:generic-array-execute"), "one")
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot), snapshot
        ).typeUnit
        let code = Es6UnitOrchestrator().emitType(type, 0).fragment.code
        let className = Es6NameMangler.mangle(type.identity.value)
        let methodName = Es6NameMangler.mangle(
            type.functionUnits().firstOrNull({ _.name == "make" }).identity.value
        )
