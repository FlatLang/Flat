    async test `executes explicit native array contract`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:native-array-execute"), "one")
        let stream = Lexer().lex("class Factory { public static read() -> Sequence<Int> { return [2, 3]; } }")
        stream.emit("start")
        let factory = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let bufferStream = Lexer().lex("class Buffer<E> implements Sequence<E> {}")
        bufferStream.emit("start")
        let buffer = PrimitiveClassParser().parse(bufferStream.consumeAll<Token>("data"), snapshot, 100)
        let traitStream = Lexer().lex("trait Sequence<E> {}")
        traitStream.emit("start")
        let contract = PrimitiveInterfaceParser().parse(traitStream.consumeAll<Token>("data"), snapshot, 200)
        let result = PrimitiveClassPartitionBinder().bind([factory, buffer], interfaceSyntaxValues: [contract], arrayDeclaration: buffer)
        let unit = result.typeUnits().firstOrNull({ _.identity.name == "Factory" })
        let method = unit.functionUnits().firstOrNull({ _.name == "read" })
        let code = Es6UnitOrchestrator().emitType(unit, 0).fragment.code
        let root = File(".flat-es6-native-array-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "array.js")
        Es6ArtifactCommitter().commit(destination, code + "console.log(" + Es6NameMangler.mangle(unit.identity.value) + "." + Es6NameMangler.mangle(method.identity.value) + "().join(','));\n")
        let response = System.execute(["node", destination.normalizedLocation], silent: true, shell: false)
        Es6ArtifactFiles.remove(root)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("2,3\n")
    }

    async test `executes nested continue and shared match`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:match-execute"), "one")
        let stream = Lexer().lex("class Digits { public static count() -> Int { var Int n = 0; for (i in 0..3) { for (j in 0..3) { if (j == 0) { continue; } if (j == 2) { continue; } n += 10; } match i++ { 0 => 1 => n++; } } return n; } }")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let unit = PrimitiveClassPartitionBinder().bind([syntax]).typeUnits().first
        let method = unit.functionUnits().firstOrNull({ _.name == "count" })
        let code = Es6UnitOrchestrator().emitType(unit, 0).fragment.code
        let root = File(".flat-es6-match-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "match.js")
        Es6ArtifactCommitter().commit(destination, code + "console.log(" + Es6NameMangler.mangle(unit.identity.value) + "." + Es6NameMangler.mangle(method.identity.value) + "());\n")
        let harness = File(root, "bounded.js")
        Es6ArtifactCommitter().commit(harness, "const r = require('child_process').spawnSync(process.execPath, [process.argv[2]], {encoding:'utf8', timeout:5000}); if (r.error) { console.error(r.error.message); process.exit(1); } process.stdout.write(r.stdout); process.stderr.write(r.stderr); process.exit(r.status === null ? 1 : r.status);\n")
        let response = System.execute(["node", harness.normalizedLocation, destination.normalizedLocation], silent: true, shell: false)
        Es6ArtifactFiles.remove(root)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("21\n")
    }

    async test `executes generic null forwarding`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:null-forward-execute"), "one")
        let traitStream = Lexer().lex("trait Items<E> { public or(E fallback, E value, Bool matches) -> E { if (matches) { return value; } return fallback; } public absent(E value, Bool matches) -> E { return or(null, value, matches); } public echo(E value) -> E { return value; } }")
        traitStream.emit("start")
        let contract = PrimitiveInterfaceParser().parse(traitStream.consumeAll<Token>("data"), snapshot)
        let stream = Lexer().lex("class Range implements Items<Int> {}")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot, 100)
        let context = PrimitiveSourceBindingContext("flat", snapshot, [syntax], [contract])
        let unit = PrimitiveClassPartitionBinder().bindContexts([context]).typeUnits().first
        let code = Es6UnitOrchestrator().emitType(unit, 0).fragment.code
        let owner = Es6NameMangler.mangle(unit.identity.value)
        let absent = Es6NameMangler.mangle(unit.functionUnits().firstOrNull({ _.name == "absent" }).identity.value)
        let echo = Es6NameMangler.mangle(unit.functionUnits().firstOrNull({ _.name == "echo" }).identity.value)
        let root = File(".flat-es6-null-forward-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "forward.js")
        Es6ArtifactCommitter().commit(destination, code + "let v = new " + owner + "(); console.log(v." + absent + "(0,false) === null,v." + absent + "(0,true),v." + echo + "(7));\n")
        let response = System.execute(["node", destination.normalizedLocation], silent: true, shell: false)
        Es6ArtifactFiles.remove(root)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("true 0 7\n")
    }

