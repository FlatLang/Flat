    async test `namespace bound declared generic array count executes under Node`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:declared-array-execution"), "compiler-input")
        let source = "class Array<E> { visible Int count; construct(Int count, Int capacity = count) { this.count = count; } } " +
            "class Box { static make<Out>(Int size) -> Out[] { return Array<Out>(size); } " +
            "static run() -> Int { return Box.make<Int>(3).count; } }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let partitions = FlatSourceTypePartitioner().partition(stream.consumeAll<Token>("data"), snapshot)
        let syntaxes = PrimitiveClassSyntax[]
        for (partition in partitions) syntaxes.add(PrimitiveClassParser().parse(
            partition.tokenValues(), snapshot, partition.startTokenIndex))
        let context = PrimitiveSourceBindingContext("", snapshot, syntaxes)
        let units = PrimitiveClassPartitionBinder().bindContexts([context]).typeUnits()
        let box = units.last
        let run = box.functionUnits().firstOrNull({ _.name == "run" })
        var String code = ""
        var Int index
        for (unit in units) {
            let emitted = Es6UnitOrchestrator().emitType(unit, index)
            if (!emitted.emitted) throw Exception(emitted.diagnostic.message)
            code += emitted.fragment.code
            index++
        }
        let root = File(".flat-es6-namespace-array-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(destination, code + "console.log(" +
            Es6NameMangler.mangle(box.identity.value) + "." + Es6NameMangler.mangle(run.identity.value) + "());\n")
        let response = System.execute(["node", destination.normalizedLocation], silent: true, shell: false)
        Es6ArtifactFiles.remove(root)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        if (response.stdout.join("") != "3\n") throw Exception("Declared array execution output: " + response.stdout.join("") + "\n" + code)
        expect(response.stdout.join("")).toBe("3\n")
    }

