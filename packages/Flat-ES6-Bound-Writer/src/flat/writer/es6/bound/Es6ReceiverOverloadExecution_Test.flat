        Es6ArtifactFiles.remove(root)
    }

    async test `receiver return shorthand ignores call result`() {
        let stream = Lexer().lex("class Value { Int count; accept(Int value) -> Int { count = value; return 7; } " +
            "chain(Int value) => this:accept(value)\n read() -> Int { return count; } }")
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:receiver-return"), "one")
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot), snapshot
        ).typeUnit
