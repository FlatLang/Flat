    async test `declared Bool wrapper execution`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:bool-wrapper"), "one")
        let syntaxes = PrimitiveClassSyntax[]
        var Int offset
        let sources = ["class Object { construct() {} }",
            "class Bool extends Object { construct(public Bool value) {} public equals(Object other) -> Bool { return (other || !this) && other.class.isOfType(Bool.class) && value == ((Bool)other); } }"]
        for (source in sources) {
            let stream = Lexer().lex(source)
            stream.emit("start")
            syntaxes.add(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot, offset))
            offset += 100
        }
        let units = PrimitiveClassPartitionBinder().bindContexts([PrimitiveSourceBindingContext("", snapshot, syntaxes)]).typeUnits()
        var String code = ""
        var Int ordinal
        for (unit in units) {
            let emitted = Es6UnitOrchestrator().emitType(unit, ordinal++)
            if (!emitted.emitted) throw Exception("Bool wrapper emission rejected")
            code += emitted.fragment.code
        }
        let wrapper = units.firstOrNull({ _.identity.name == "Bool" })
        let name = Es6NameMangler.mangle(wrapper.identity.value)
        let rootName = Es6NameMangler.mangle(units.firstOrNull({ _.identity.name == "Object" }).identity.value)
        let method = Es6NameMangler.mangle(wrapper.functionUnits().firstOrNull({ _.name == "equals" }).identity.value)
        let root = File(".flat-es6-bool-wrapper-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "bool.js")
        Es6ArtifactCommitter().commit(destination, code + "const yes=new " + name + "(true);const no=new " + name + "(false);\n" +
            "console.log(yes." + method + "(yes),yes." + method + "(no),yes." + method + "(new " + rootName + "()),yes." + method + "(null));\n")
        let response = System.execute(["node", destination.normalizedLocation], silent: true, shell: false)
        Es6ArtifactFiles.remove(root)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("true false false false\n")
    }

    async test `nullable Bool condition execution`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:nullable-bool"), "one")
        let range = SourceRange(snapshot, 0, 1, Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 2))
        let nullable = NullableSemanticType(SemanticTypes.boolType())
        let identity = SymbolIdentity(DeclarationIdentity(SyntaxIslandIdentity(snapshot, "local", 0), "local", "input"), "local")
        let condition = PrimitiveDeclarationValueSyntax(range, "value", PrimitiveReferenceSyntax(range, "input"))
        let result = PrimitiveControlStatementBinder().bind(PrimitiveStatementSyntaxResult([
            PrimitiveIfSyntax(range, condition, PrimitiveStatementSyntax[], PrimitiveStatementSyntax[])
        ]), snapshot, [LocalBinding("input", identity, nullable)])
        let statements = result.statements()
        var BoundIfStatement branch
        branch = (BoundIfStatement)statements.last
        var BoundLocalDeclarationStatement retained
        retained = (BoundLocalDeclarationStatement)statements.first
        let method = Es6NameMangler.mangle(retained.local.symbolIdentity.value)
        let guard = Es6ExpressionOrchestrator().emit(branch.condition).code
        let code = "function test(input){ const " + method + "=input;return " + guard + ";}\n"
        let root = File(".flat-es6-nullable-bool-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "nullable.js")
        Es6ArtifactCommitter().commit(destination, code + "let calls=0;function next(input){calls++;return input;}\n" +
            "for(const input of [false,true,null]) console.log(test(next(input)),calls);\n")
        let response = System.execute(["node", destination.normalizedLocation], silent: true, shell: false)
        Es6ArtifactFiles.remove(root)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("false 1\ntrue 2\nfalse 3\n")
    }

