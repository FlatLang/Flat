package flat/writer/es6/bound

import flat/bound
import flat/semantic/types

/** Node CLI boundary for an already-selected bound declaration; never resolves overloads. */
class {
    /** nativeStringConstructor is selected by semantic/project ownership, never discovered here.
     * It adapts each Node argv native string to the declared entrypoint element type.
     */
    public emit(BoundTypeUnit owner, BoundFunctionUnit selectedMain,
        CallableSignature nativeStringConstructor = null) -> Es6CodeResult {
        if (!owner || !selectedMain) {
            return failure("es6.entrypoint-owner", "Entrypoint requires a selected type and member")
        }
        // Require the published member itself, not a same-named replacement supplied by a caller.
        if (!owner.functionUnits().any({ Object.referenceEquals(_, selectedMain) })) {
            return failure("es6.entrypoint-owner", "Selected entrypoint is not a member of the selected type")
        }
        if (selectedMain.name != "main" || !selectedMain.staticFunction ||
            selectedMain.abstractFunction || selectedMain.constructorFunction || selectedMain.lazyProperty) {
            return failure("es6.entrypoint-kind", "Entrypoint must be a concrete static main method")
        }
        let parameters = selectedMain.parameterValues()
        let returnType = selectedMain.returnType.value()
        if (returnType != "unit" && returnType != "void") {
            return failure("es6.entrypoint-signature", "Entrypoint must return unit or void")
        }
        var String arguments = ""
        if (parameters.count == 1) {
            let type = parameters[0].semanticType
            if (type.kind() != "array") {
                return failure("es6.entrypoint-signature", "Entrypoint arguments require a native String array")
            }
            let arrayType = (ArraySemanticType)type
            if (arrayType.dimensions != 1 || parameters[0].defaultValue) {
                return failure("es6.entrypoint-signature", "Entrypoint arguments require exactly String[]")
            }
            if (arrayType.elementType.value() == SemanticTypes.stringType().value()) {
                if (nativeStringConstructor) return failure("es6.entrypoint-adapter",
                    "Native String[] does not require a wrapper constructor")
                arguments = "process.argv.slice(2)"
            } else {
                if (!nativeStringConstructor || nativeStringConstructor.callableKind.value != "constructor" ||
                    !nativeStringConstructor.ownerType ||
                    nativeStringConstructor.ownerType.value() != arrayType.elementType.value() ||
                    nativeStringConstructor.returnType.value() != arrayType.elementType.value() ||
                    nativeStringConstructor.parameterTypes().count != 1 ||
                    nativeStringConstructor.parameterTypes().first.value() != SemanticTypes.stringType().value()) {
                    return failure("es6.entrypoint-signature",
                        "Wrapper String[] requires the selected native-string constructor for its element type")
                }
                let target = nativeStringConstructor.identity.declaration
                let wrapper = Es6NameMangler.mangle(nativeStringConstructor.ownerType.declarationIdentity.value)
                let factory = target.syntaxIdentity.kind == "constructor-overload" ?
                    Es6NameMangler.mangle(target.value) : null
                let adapted = Es6CallEmitter().emitConstructorCall(wrapper, "__flatArgument", factory)
                arguments = "process.argv.slice(2).map(__flatArgument => " + adapted + ")"
            }
        } else if (parameters.count != 0) {
            return failure("es6.entrypoint-signature", "Entrypoint accepts no parameters or one String[]")
        } else if (nativeStringConstructor) {
            return failure("es6.entrypoint-adapter", "Parameterless main does not require an argument adapter")
        }
        let ownerName = Es6NameMangler.mangle(owner.identity.value)
        let mainName = selectedMain.externalName ?: Es6NameMangler.mangle(
            selectedMain.dispatchIdentity ?: selectedMain.identity.value
        )
        let call = ownerName + "." + mainName + "(" + arguments + ")"
        return Es6CodeResult(code:
            "if (require.main === module) {\n" +
            "  Promise.resolve().then(() => " + call + ").catch(error => {\n" +
            "    console.error(error && error.message ? error.message : String(error));\n" +
            "    process.exitCode = 1;\n" +
            "  });\n" +
            "}\n"
        )
    }

    failure(String code, String message) -> Es6CodeResult =>
        Es6CodeResult(diagnostic: Es6BackendDiagnostic(code, message))
}
