package flat/writer/es6/bound

import flat/io
import flat/time/Time

testable class {
    test `spools reversed fragments assembles canonically and cleans temporary storage`() {
        let root = temporaryRoot("spool")
        let parts = File(root, "parts")
        Es6ArtifactFiles.ensureDirectory(parts)
        let spool = Es6FragmentSpool(parts, 3)
        let first = Es6ArtifactFragment("first", 0, "first\n")
        let second = Es6ArtifactFragment("second", 1, "second\n")
        let third = Es6ArtifactFragment("third", 2, "third\n")

        expect(spool.accept(third)).toBe(null)
        expect(spool.accept(first)).toBe(null)
        expect(spool.accept(second)).toBe(null)
        let result = spool.assembleAndCleanup()

        expect(result.assembled).toBe(true)
        expect(result.code).toBe("first\nsecond\nthird\n")
        expect(File(root, "parts").exists).toBe(false)
        Es6ArtifactFiles.remove(root)
    }

    test `spool rejects bounded capacity and duplicate ordinals and cleanup removes files`() {
        let root = temporaryRoot("limits")
        let parts = File(root, "parts")
        Es6ArtifactFiles.ensureDirectory(parts)
        let spool = Es6FragmentSpool(parts, 1)
        let first = Es6ArtifactFragment("first", 0, "first")
        let duplicate = Es6ArtifactFragment("duplicate", 0, "duplicate")
        let second = Es6ArtifactFragment("second", 1, "second")

        expect(spool.accept(first)).toBe(null)
        expect(spool.accept(duplicate).code).toBe("es6.spool-capacity")
        spool.cleanup()
        let duplicateParts = File(root, "duplicate")
        Es6ArtifactFiles.ensureDirectory(duplicateParts)
        let duplicateSpool = Es6FragmentSpool(duplicateParts, 2)
        expect(duplicateSpool.accept(first)).toBe(null)
        expect(duplicateSpool.accept(duplicate).code).toBe("es6.fragment-order")
        expect(duplicateSpool.accept(second)).toBe(null)
        duplicateSpool.cleanup()
        expect(root.exists).toBe(true)
        Es6ArtifactFiles.remove(root)
        expect(root.exists).toBe(false)
    }

    test `missing spooled fragment preserves read failure and cleans temporary storage`() {
        let root = temporaryRoot("missing-fragment")
        let parts = File(root, "parts")
        Es6ArtifactFiles.ensureDirectory(parts)
        let spool = Es6FragmentSpool(parts, 2)
        try {
            expect(spool.accept(Es6ArtifactFragment("first", 0, "first\n"))).toBe(null)
            expect(spool.accept(Es6ArtifactFragment("second", 1, "second\n"))).toBe(null)
            let missing = File(parts, "fragment-1.es6")
            expect(missing.exists).toBe(true)
            Es6ArtifactFiles.remove(missing)
            expect(missing.exists).toBe(false)

            var String failure = ""
            try {
                spool.assembleAndCleanup()
            } catch (Exception error) {
                failure = error.message
            }

            expect(failure).toBe("ES6 artifact read requires an existing file")
            expect(parts.exists).toBe(false)
        } finally {
            Es6ArtifactFiles.remove(root)
        }
    }

    test `atomic commit replaces destination and leaves no temporary file`() {
        let root = temporaryRoot("commit")
        let output = File(root, "output")
        Es6ArtifactFiles.ensureDirectory(output)
        let destination = File(output, "hello.js")
        Es6ArtifactCommitter().commit(destination, "console.log('Hello, Flat');\n")

        expect(destination.exists).toBe(true)
        expect(Es6ArtifactFiles.read(destination))
            .toBe("console.log('Hello, Flat');\n")
        expect(File(destination.normalizedLocation + ".flat-tmp").exists).toBe(false)
        Es6ArtifactFiles.remove(root)
    }

    test `atomic commit preserves unrelated stale staging paths`() {
        let root = temporaryRoot("stale-commit")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "hello.js")
        let stale = File(destination.normalizedLocation + ".flat-tmp")
        Es6ArtifactFiles.ensureDirectory(stale)
        let sentinel = File(stale, "unrelated.txt")
        try {
            Es6ArtifactFiles.write(destination, "previous\n")
            Es6ArtifactFiles.write(sentinel, "preserve\n")

            Es6ArtifactCommitter().commit(destination, "replacement\n")

            expect(Es6ArtifactFiles.read(destination)).toBe("replacement\n")
            expect(sentinel.exists).toBe(true)
            expect(Es6ArtifactFiles.read(sentinel)).toBe("preserve\n")
            expect(root.getChildFiles(includeDirectories: true).count).toBe(2)
        } finally {
            Es6ArtifactFiles.remove(root)
        }
    }

    test `failed atomic replacement preserves destination and cleans owned staging`() {
        let root = temporaryRoot("failed-commit")
        let destination = File(root, "hello.js")
        Es6ArtifactFiles.ensureDirectory(destination)
        let sentinel = File(destination, "unrelated.txt")
        try {
            Es6ArtifactFiles.write(sentinel, "preserve\n")
            var Bool rejected = false
            try {
                Es6ArtifactCommitter().commit(destination, "replacement\n")
            } catch (Exception error) {
                rejected = true
            }

            expect(rejected).toBe(true)
            expect(Es6ArtifactFiles.read(sentinel)).toBe("preserve\n")
            expect(root.getChildFiles(includeDirectories: true).count).toBe(1)
        } finally {
            Es6ArtifactFiles.remove(root)
        }
    }

    test `overlapping commit staging reservations have independent ownership`() {
        let root = temporaryRoot("overlapping-commit")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "hello.js")
        try {
            let first = Es6ArtifactFiles.createCommitDirectory(destination)
            let second = Es6ArtifactFiles.createCommitDirectory(destination)
            expect(first.normalizedLocation == second.normalizedLocation).toBe(false)
            let firstArtifact = File(first, "artifact")
            let secondArtifact = File(second, "artifact")
            Es6ArtifactFiles.write(firstArtifact, "first\n")
            Es6ArtifactFiles.write(secondArtifact, "second\n")

            Es6ArtifactFiles.replace(secondArtifact, destination)
            Es6ArtifactFiles.remove(second)
            expect(Es6ArtifactFiles.read(firstArtifact)).toBe("first\n")
            expect(Es6ArtifactFiles.read(destination)).toBe("second\n")
            Es6ArtifactFiles.replace(firstArtifact, destination)
            Es6ArtifactFiles.remove(first)
            expect(Es6ArtifactFiles.read(destination)).toBe("first\n")
            expect(root.getChildFiles(includeDirectories: true).count).toBe(1)
        } finally {
            Es6ArtifactFiles.remove(root)
        }
    }

    temporaryRoot(String name) -> File {
        return File(".flat-es6-bound-writer-test-#name-#{Time.currentTimeMillis}")
    }
}
