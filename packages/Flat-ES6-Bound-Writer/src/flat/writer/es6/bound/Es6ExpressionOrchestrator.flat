package flat/writer/es6/bound

import flat/bound
import flat/semantic/types/FunctionSemanticType

/** Recursive reduced-expression orchestration with diagnostic propagation. */
class {
    public construct(
        visible Es6ExpressionEmitter expressions = Es6ExpressionEmitter(),
        visible Es6CallEmitter calls = Es6CallEmitter()
    ) {
        if (!expressions || !calls) throw Exception("ES6 expression orchestration requires emitters")
    }

    public emit(BoundExpression expression) -> Es6CodeResult {
        if (!expression) throw Exception("ES6 expression orchestration requires expression")
        let capability = Es6TargetCapabilities.diagnoseExpression(expression.expressionKind())
        if (capability) return Es6CodeResult(diagnostic: capability)
        if (expression.class.isOfType(BoundLiteralExpression.class)) {
            let value = (BoundLiteralExpression)expression
            return expressions.emitLiteral(value)
        }
        if (expression.class.isOfType(BoundInterpolatedStringExpression.class)) {
            let value = (BoundInterpolatedStringExpression)expression
            let segmentCode = String[]
            for (segment in value.segmentValues()) {
                if (segment.literal()) segmentCode.add(segment.literalSourceValue)
                else {
                    let emitted = emit(segment.expression)
                    if (!emitted.emitted) return emitted
                    segmentCode.add(emitted.code)
                }
            }
            return expressions.emitInterpolatedString(value, segmentCode)
        }
        if (expression.class.isOfType(BoundReferenceExpression.class)) {
            let value = (BoundReferenceExpression)expression
            if (value.symbolIdentity.symbolKind == "receiver") {
                return Es6CodeResult(code: "this")
            }
            return expressions.emitReference(value)
        }
        if (expression.class.isOfType(BoundNativeArrayDataExpression.class)) {
            return emit(((BoundNativeArrayDataExpression)expression).receiver)
        }
        if (expression.class.isOfType(BoundMemberAccessExpression.class)) {
            let value = (BoundMemberAccessExpression)expression
            return expressions.emitMemberAccess(value, emit(value.receiver))
        }
        if (expression.class.isOfType(BoundUnaryExpression.class)) {
            let value = (BoundUnaryExpression)expression
            return expressions.emitUnary(value, emit(value.operand))
        }
        if (expression.class.isOfType(BoundBinaryExpression.class)) {
            let value = (BoundBinaryExpression)expression
            return expressions.emitBinary(value, emit(value.left), emit(value.right))
        }
        if (expression.class.isOfType(BoundDeclarationValueExpression.class)) {
            let value = (BoundDeclarationValueExpression)expression
            return expressions.emitDeclarationValue(
                expressions.emitReference(value.local), emit(BoundConversionExpression(
                    value.range, value.local.semanticType, value.value, value.storageConversion))
            )
        }
        if (expression.class.isOfType(BoundPostfixUpdateExpression.class)) {
            let value = (BoundPostfixUpdateExpression)expression
            return expressions.emitPostfixUpdate(
                value, emit(value.target)
            )
        }
        if (expression.class.isOfType(BoundAssignmentValueExpression.class)) {
            let value = (BoundAssignmentValueExpression)expression
            return expressions.emitAssignmentValue(
                expressions.emitReference(value.target), emit(BoundConversionExpression(
                    value.range, value.target.semanticType, value.value, value.storageConversion))
            )
        }
        if (expression.class.isOfType(BoundMemberAssignmentValueExpression.class)) {
            let value = (BoundMemberAssignmentValueExpression)expression
            return expressions.emitMemberAssignmentValue(
                value, emit(value.target), emit(value.value)
            )
        }
        if (expression.class.isOfType(BoundNumericUnboxExpression.class)) {
            let value = (BoundNumericUnboxExpression)expression
            return expressions.emitNumericUnbox(value, emit(value.value))
        }
        if (expression.class.isOfType(BoundConversionExpression.class)) {
            let value = (BoundConversionExpression)expression
            return expressions.emitConversion(value, emit(value.value))
        }
        if (expression.class.isOfType(BoundLambdaExpression.class)) {
            let value = (BoundLambdaExpression)expression
            let parameters = String[]
            for (parameter in value.parameterValues()) {
                var String name = Es6NameMangler.mangle(parameter.identity.value)
                if (parameter.defaultValue) {
                    let defaultValue = emit(parameter.defaultValue)
                    if (!defaultValue.emitted) return defaultValue
                    name += " = " + defaultValue.code
                }
                parameters.add(name)
            }
            let body = emit(value.body)
            if (!body.emitted) return body
            let functionType = (FunctionSemanticType)value.semanticType
            let prefix = functionType.asyncFunction ? "async " : ""
            if (value.statementValues().isNotEmpty) {
                let statements = Es6StatementOrchestrator(expressions: this).emitAll(value.statementValues())
                if (!statements.emitted) return statements
                return Es6CodeResult(code: prefix + "(" + parameters.join(", ") + ") => {\n" + statements.code + "}")
            }
            return Es6CodeResult(code: prefix + "(" + parameters.join(", ") + ") => " + body.code)
        }
        if (expression.class.isOfType(BoundFunctionValue.class)) {
            let value = (BoundFunctionValue)expression
            let method = value.target.externalName ?: Es6NameMangler.mangle(
                value.target.dispatchIdentity ?: value.target.identity.declaration.value)
            if (value.target.callableKind.value == "static-method") {
                let owner = Es6NameMangler.mangle(
                    value.target.ownerType.declarationIdentity.value
                )
                return Es6CodeResult(code: owner + "." + method)
            }
            return Es6CodeResult(code: method)
        }
        if (expression.class.isOfType(BoundArrayExpression.class)) {
            let value = (BoundArrayExpression)expression
            if (value.allocationSize) {
                let size = emit(value.allocationSize)
                if (!size.emitted) return size
                return Es6CodeResult(code: "new Array(" + size.code + ").fill(null)")
            }
            let elements = emitArguments(value.elementValues())
            if (!elements.emitted) return elements
            return Es6CodeResult(code: "[" + elements.code + "]")
        }
        if (expression.class.isOfType(BoundNativeArrayDataExpression.class)) {
            // ABI flat-es6-abi-1 stores reduced arrays in their native representation already.
            // This is a backing-storage projection, not a copy or wrapper allocation.
            let value = (BoundNativeArrayDataExpression)expression
            return emit(value.receiver)
        }
        if (expression.class.isOfType(BoundArrayLengthExpression.class)) {
            let value = (BoundArrayLengthExpression)expression
            let receiver = emit(value.receiver)
            if (!receiver.emitted) return receiver
            return Es6CodeResult(code: receiver.code + ".length")
        }
        if (expression.class.isOfType(BoundArrayAccessExpression.class)) {
            let value = (BoundArrayAccessExpression)expression
            let receiver = emit(value.receiver)
            if (!receiver.emitted) return receiver
            let index = emit(value.index)
            if (!index.emitted) return index
            return Es6CodeResult(code: receiver.code + "[" + index.code + "]")
        }
        if (expression.class.isOfType(BoundTypeMetadataExpression.class)) {
            let value = (BoundTypeMetadataExpression)expression
            if (value.interfaceType) {
                return Es6CodeResult(code: "({ __flatInterfaceIdentity: " +
                    metadataLiteral(value.referencedType.declarationIdentity.value) + " })")
            }
            return Es6CodeResult(code: Es6NameMangler.mangle(
                value.referencedType.declarationIdentity.value
            ))
        }
        if (expression.class.isOfType(BoundTypeTestExpression.class)) {
            let value = (BoundTypeTestExpression)expression
            let tested = emit(value.value)
            if (!tested.emitted) return tested
            if (value.typeMetadata.interfaceType) {
                let identity = value.typeMetadata.referencedType.declarationIdentity.value
                return Es6CodeResult(code: "((__flatValue) => { if (__flatValue == null) return false; " +
                    "for (let __flatPrototype = Object.getPrototypeOf(__flatValue); __flatPrototype; " +
                    "__flatPrototype = Object.getPrototypeOf(__flatPrototype)) { " +
                    "if (!Object.prototype.hasOwnProperty.call(__flatPrototype, 'constructor')) continue; " +
                    "const __flatOwner = __flatPrototype.constructor; " +
                    "if (!Object.prototype.hasOwnProperty.call(__flatOwner, '__flatType')) continue; " +
                    "const __flatInterfaces = __flatOwner.__flatType.interfaceIdentities; " +
                    "if (__flatInterfaces && __flatInterfaces.includes(" + metadataLiteral(identity) + ")) return true; " +
                    "} return false; })(" + tested.code + ")")
            }
            let metadata = emit(value.typeMetadata)
            if (!metadata.emitted) return metadata
            return Es6CodeResult(code: "(" + tested.code + " instanceof " + metadata.code + ")")
        }
        if (expression.class.isOfType(BoundClassNameExpression.class)) {
            let value = (BoundClassNameExpression)expression
            let receiver = emit(value.receiver)
            if (!receiver.emitted) return receiver
            return Es6CodeResult(code: receiver.code + ".constructor." +
                Es6RuntimeAbi().typeMetadataProperty + ".name")
        }
        if (expression.class.isOfType(BoundConditionalExpression.class)) {
            let value = (BoundConditionalExpression)expression
            let condition = emit(value.condition)
            if (!condition.emitted) return condition
            let whenTrue = emit(value.whenTrue)
            if (!whenTrue.emitted) return whenTrue
            let whenFalse = emit(value.whenFalse)
            if (!whenFalse.emitted) return whenFalse
            return Es6CodeResult(code: "(" + condition.code + " ? " +
                whenTrue.code + " : " + whenFalse.code + ")")
        }
        if (expression.class.isOfType(BoundIntrinsicMemberCallExpression.class)) {
            let value = (BoundIntrinsicMemberCallExpression)expression
            let diagnostic = calls.diagnoseIntrinsicMember(value.memberName, value.argumentValues().count)
            if (diagnostic) return Es6CodeResult(diagnostic: diagnostic)
            let receiver = emit(value.receiver)
            if (!receiver.emitted) return receiver
            let arguments = emitArguments(value.argumentValues())
            if (!arguments.emitted) return arguments
            return Es6CodeResult(code: calls.emitIntrinsicMemberCall(
                receiver.code, value.memberName, arguments.code
            ))
        }
        if (expression.class.isOfType(BoundFunctionInvocationExpression.class)) {
            let value = (BoundFunctionInvocationExpression)expression
            let functionValue = emit(value.functionValue)
            if (!functionValue.emitted) return functionValue
            let arguments = emitArguments(value.argumentValues())
            if (!arguments.emitted) return arguments
            let calleeType = value.functionValue.semanticType
            let functionType = (FunctionSemanticType)calleeType
            let callee = value.functionValue.class.isOfType(BoundLambdaExpression.class) ?
                "(" + functionValue.code + ")" : functionValue.code
            let invocation = callee + "(" + arguments.code + ")"
            return Es6CodeResult(code: functionType.asyncFunction && !value.suppressAwait ? "(await " + invocation + ")" : invocation)
        }
        if (expression.class.isOfType(BoundCallExpression.class)) {
            let value = (BoundCallExpression)expression
            return emitCall(value)
        }
        if (expression.class.isOfType(BoundNativeCallExpression.class)) {
            let value = (BoundNativeCallExpression)expression
            return emitNativeCall(value)
        }
        return Es6CodeResult(diagnostic: Es6BackendDiagnostic(
            "es6.unsupported-expression",
            "ES6 backend cannot orchestrate reduced expression '#{expression.expressionKind()}'",
            expression.range
        ))
    }

    emitCall(BoundCallExpression expression) -> Es6CodeResult {
        if (expression.safeAccess) return Es6CodeResult(diagnostic: Es6BackendDiagnostic(
            "es6.unlowered-safe-call", "Safe call requires target-independent lowering"))
        let values = expression.argumentValues()
        let conversions = expression.argumentConversions()
        let converted = BoundExpression[]
        var Int index
        while (index < values.count) {
            let conversion = conversions[index]
            converted.add(BoundConversionExpression(values[index].range,
                conversion.toType, values[index], conversion))
            index++
        }
        let arguments = emitArguments(converted)
        if (!arguments.emitted) return arguments
        let kind = expression.target.callableKind.value
        let identity = expression.target.identity.declaration.value
        let name = expression.target.externalName ?: Es6NameMangler.mangle(
            expression.target.dispatchIdentity ?: identity)
        let String argumentText = arguments.code
        if (kind == "function") {
            return selectedCall(expression, calls.emitFunctionCall(name, argumentText))
        }
        if (kind == "static-method") {
            let owner = Es6NameMangler.mangle(expression.target.ownerType.declarationIdentity.value)
            return selectedCall(expression, calls.emitStaticCall(owner, name, argumentText))
        }
        if (kind == "constructor") {
            let owner = Es6NameMangler.mangle(expression.target.ownerType.declarationIdentity.value)
            let constructorName = expression.target.identity.declaration.syntaxIdentity.kind ==
                "constructor-overload"
                ? Es6NameMangler.mangle(identity)
                : null
            return Es6CodeResult(code: calls.emitConstructorCall(
                owner, argumentText, constructorName
            ))
        }
        if (kind == "instance-method") {
            if (!expression.receiver) {
                return Es6CodeResult(diagnostic: Es6BackendDiagnostic(
                    "es6.call-receiver-missing",
                    "ES6 instance call requires a bound receiver",
                    expression.range
                ))
            }
            let receiver = emit(expression.receiver)
            if (!receiver.emitted) return receiver
            return selectedCall(expression, calls.emitInstanceCall(receiver.code, name, argumentText))
        }
        return Es6CodeResult(diagnostic: Es6BackendDiagnostic(
            "es6.unsupported-call-kind",
            "ES6 backend does not yet support call kind '#kind'",
            expression.range
        ))
    }

    metadataLiteral(String value) -> String {
        return "'" + value.replace("\\", "\\\\").replace("'", "\\'")
            .replace("\r", "\\r").replace("\n", "\\n")
            .replace("\u2028", "\\u2028").replace("\u2029", "\\u2029") + "'"
    }

    selectedCall(BoundCallExpression expression, String code) -> Es6CodeResult {
        return Es6CodeResult(code: expression.target.asyncFunction && !expression.suppressAwait ?
            "(await " + code + ")" : code)
    }

    emitNativeCall(BoundNativeCallExpression expression) -> Es6CodeResult {
        let arguments = emitArguments(expression.argumentValues())
        if (!arguments.emitted) return arguments
        return Es6CodeResult(code: calls.emitNativeCall(expression.nativeName, arguments.code))
    }

    public emitArguments(BoundExpression[] values) -> Es6CodeResult {
        let arguments = String[]
        for (value in values) {
            let emitted = emit(value)
            if (!emitted.emitted) return emitted
            arguments.add(emitted.code)
        }
        return Es6CodeResult(code: calls.joinArguments(arguments))
    }
}
