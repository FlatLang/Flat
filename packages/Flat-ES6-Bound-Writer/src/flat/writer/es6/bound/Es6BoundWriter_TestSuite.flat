package flat/writer/es6/bound

import flat/test/TestResult
import flat/time/Timer
import flat/io/FancyOutputStream

[TestSuite [
    Es6BoundAbi_Test,
    Es6ExpressionEmitter_Test,
    Es6CallEmitter_Test,
    Es6StatementEmitter_Test,
    Es6UnitEmitter_Test,
    Es6FragmentEmitter_Test,
    Es6FragmentAssembler_Test,
    Es6ArtifactPersistence_Test,
    Es6ArtifactOutput_Test,
    Es6HelloExecution_Test,
    Es6UnitOrchestrator_Test,
    Es6EmissionCoordinator_Test
]]
class {
    public static async main(String[] args) {
        let test = Es6BoundWriter_TestSuite()
        let results = TestResult[]
        let timer = Timer().start()
        test.runTests({ results.add(_) })
        timer.stop()
        let unsuccessful = results.filter({ !_.success })
        let fancy = FancyOutputStream(headerPattern: "/\\")
        if (unsuccessful.isNotEmpty) {
            fancy.writeHeader("#unsuccessful.count Failure#{unsuccessful.count == 1 ? "" : "s"} out of #results.count tests", pattern: ":'( ", symmetrical: true)
            unsuccessful.forEach({ Console.log("#_") })
        } else {
            fancy.writeHeader("All #results.count Successful", pattern: ":) ", symmetrical: true)
        }
        Console.writeLine("Took #{timer.duration}ms")
        if (unsuccessful.isNotEmpty) System.exit(1)
    }
}
