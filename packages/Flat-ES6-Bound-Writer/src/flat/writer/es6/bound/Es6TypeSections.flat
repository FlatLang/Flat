package flat/writer/es6/bound

import flat/compiler/models

/** Immutable target sections for one type in a finite artifact partition. */
data class {
    public construct(
        visible String identity,
        visible Int ordinal,
        visible DeclarationIdentity parentIdentity = null,
        visible String declarations = "",
        visible String metadata = "",
        visible String eagerInitializers = ""
    ) {
        if (!identity || identity.trim().count == 0 || ordinal < 0 ||
            declarations == null || metadata == null || eagerInitializers == null) {
            throw Exception("ES6 type sections require identity ordinal and non-null code sections")
        }
    }
}
