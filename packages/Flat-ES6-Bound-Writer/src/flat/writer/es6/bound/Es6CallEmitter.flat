package flat/writer/es6/bound

/** Pure ES6 call syntax rendering from validated names and argument text. */
class {
    /** Validate reduced intrinsic input before syntax emission, without resolving methods. */
    public diagnoseIntrinsicMember(String memberName, Int argumentCount) -> Es6BackendDiagnostic {
        let oneArgument = memberName == "repeat" || memberName == "add" ||
            memberName == "map" || memberName == "contains"
        let noArguments = memberName == "toLowerCase" || memberName == "toUpperCase"
        let supported = oneArgument || noArguments || memberName == "set" || memberName == "join"
        if (!supported) return Es6BackendDiagnostic(
            "es6.unsupported-intrinsic-member", "ES6 backend does not support reduced intrinsic '#memberName'")
        if ((oneArgument && argumentCount != 1) || (noArguments && argumentCount != 0) ||
            (memberName == "set" && argumentCount != 2) ||
            (memberName == "join" && argumentCount != 0 && argumentCount != 1)) {
            return Es6BackendDiagnostic("es6.intrinsic-arity", "Invalid reduced intrinsic argument count for '#memberName'")
        }
        return null
    }

    public emitFunctionCall(String mangledName, String argumentText) -> String {
        return mangledName + "(" + argumentText + ")"
    }

    public emitIntrinsicMemberCall(
        String receiver,
        String memberName,
        String argumentText
    ) -> String {
        if (memberName == "repeat") {
            return receiver + ".repeat(" + argumentText + ")"
        }
        if (memberName == "set") {
            // Evaluate receiver, index, then value exactly once, as for an ordinary member call.
            return "((__flatReceiver, __flatIndex, __flatValue) => " +
                "__flatReceiver[__flatIndex] = __flatValue)(" + receiver + ", " + argumentText + ")"
        }
        if (memberName == "add") {
            return receiver + ".push(" + argumentText + ")"
        }
        if (memberName == "map") {
            return receiver + ".map(" + argumentText + ")"
        }
        if (memberName == "contains") {
            return receiver + ".includes(" + argumentText + ")"
        }
        if (memberName == "join") {
            return receiver + ".join(" + argumentText + ")"
        }
        if ((memberName == "toLowerCase" || memberName == "toUpperCase") &&
            argumentText.count == 0) {
            return "String.fromCharCode(" + receiver + ")." + memberName +
                "().charCodeAt(0)"
        }
        throw Exception("Unsupported ES6 intrinsic member call '#memberName'")
    }

    public emitInstanceCall(String receiver, String methodName, String argumentText) -> String {
        return receiver + "." + methodName + "(" + argumentText + ")"
    }

    public emitStaticCall(String ownerName, String methodName, String argumentText) -> String {
        return ownerName + "." + methodName + "(" + argumentText + ")"
    }

    public emitConstructorCall(
        String ownerName,
        String argumentText,
        String constructorName = null
    ) -> String {
        if (constructorName) {
            return ownerName + "." + constructorName + "(" + argumentText + ")"
        }
        return "new " + ownerName + "(" + argumentText + ")"
    }

    public emitNativeCall(String nativeName, String argumentText) -> String {
        let components = nativeName.split(".")
        if (components.any({ !_.trim() })) {
            throw Exception("ES6 native call path cannot contain empty components")
        }
        var String target = "globalThis"
        for (component in components) target += "['" + component + "']"
        return target + "(" + argumentText + ")"
    }

    public joinArguments(String[] values) -> String {
        return values.join(", ")
    }
}
