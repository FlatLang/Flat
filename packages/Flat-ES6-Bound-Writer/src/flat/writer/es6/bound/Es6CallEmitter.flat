package flat/writer/es6/bound

/** Pure ES6 call syntax rendering from validated names and argument text. */
class {
    public emitFunctionCall(String mangledName, String argumentText) -> String {
        return mangledName + "(" + argumentText + ")"
    }

    public emitInstanceCall(String receiver, String methodName, String argumentText) -> String {
        return receiver + "." + methodName + "(" + argumentText + ")"
    }

    public emitStaticCall(String ownerName, String methodName, String argumentText) -> String {
        return ownerName + "." + methodName + "(" + argumentText + ")"
    }

    public emitConstructorCall(String ownerName, String argumentText) -> String {
        return "new " + ownerName + "(" + argumentText + ")"
    }

    public emitNativeCall(String nativeName, String argumentText) -> String {
        return "globalThis['" + nativeName + "'](" + argumentText + ")"
    }

    public joinArguments(String[] values) -> String {
        return values.join(", ")
    }
}
