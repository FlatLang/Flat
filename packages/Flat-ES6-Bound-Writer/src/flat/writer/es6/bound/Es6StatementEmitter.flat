package flat/writer/es6/bound

import flat/bound

/** Emits reduced statements from already-emitted child expressions. */
class {
    public emitThrow(
        BoundThrowStatement statement,
        Es6CodeResult value
    ) -> Es6CodeResult {
        if (!statement || !value) throw Exception("ES6 throw requires statement and value")
        if (!value.emitted) return value
        return Es6CodeResult(code: "throw " + value.code + ";\n")
    }

    public emitCatch(
        BoundCatchClause clause,
        Es6CodeResult body
    ) -> Es6CodeResult {
        if (!clause || !body) throw Exception("ES6 catch requires clause and body")
        if (!body.emitted) return body
        let name = Es6NameMangler.mangle(clause.local.symbolIdentity.value)
        return Es6CodeResult(code: "catch (" + name + ") {\n" + indent(body.code) + "}")
    }

    public emitTry(
        BoundTryStatement statement,
        Es6CodeResult tryBody,
        String[] catches,
        Es6CodeResult finallyBody
    ) -> Es6CodeResult {
        if (!statement || !tryBody || !catches || !finallyBody) {
            throw Exception("ES6 try requires bodies and catches")
        }
        if (!tryBody.emitted) return tryBody
        if (!finallyBody.emitted) return finallyBody
        var String code = "try {\n" + indent(tryBody.code) + "}"
        if (catches.isNotEmpty) code += " " + catches.first
        if (statement.finallyValues().isNotEmpty) {
            code += " finally {\n" + indent(finallyBody.code) + "}"
        }
        return Es6CodeResult(code: code + "\n")
    }

    public emitIf(
        BoundIfStatement statement,
        Es6CodeResult condition,
        Es6CodeResult thenBody,
        Es6CodeResult elseBody
    ) -> Es6CodeResult {
        if (!statement || !condition || !thenBody || !elseBody) {
            throw Exception("ES6 if emission requires statement condition and branches")
        }
        if (!condition.emitted) return condition
        if (!thenBody.emitted) return thenBody
        if (!elseBody.emitted) return elseBody
        var String code = "if (" + condition.code + ") {\n" + indent(thenBody.code) + "}"
        if (statement.elseValues().isNotEmpty) {
            code += " else {\n" + indent(elseBody.code) + "}"
        }
        return Es6CodeResult(code: code + "\n")
    }

    public emitWhile(
        BoundWhileStatement statement,
        Es6CodeResult condition,
        Es6CodeResult body
    ) -> Es6CodeResult {
        if (!statement || !condition || !body) {
            throw Exception("ES6 while emission requires statement condition and body")
        }
        if (!condition.emitted) return condition
        if (!body.emitted) return body
        return Es6CodeResult(code:
            "while (" + condition.code + ") {\n" + indent(body.code) + "}\n"
        )
    }

    indent(String code) -> String {
        if (!code) return ""
        return code.split("\n").filter({ _.count > 0 })
            .map({ "    " + _ + "\n" }).join("")
    }

    public emitExpression(
        BoundExpressionStatement statement,
        Es6CodeResult expression
    ) -> Es6CodeResult {
        if (!statement || !expression) {
            throw Exception("ES6 expression statement requires statement and expression")
        }
        if (!expression.emitted) return expression
        return Es6CodeResult(code: expression.code + ";\n")
    }

    public emitInitializedLocal(
        BoundLocalDeclarationStatement statement,
        Es6CodeResult initializer
    ) -> Es6CodeResult {
        if (!statement || !statement.initializer || !initializer) {
            throw Exception("ES6 initialized local requires statement and initializer")
        }
        if (!initializer.emitted) return initializer
        let name = Es6NameMangler.mangle(statement.local.symbolIdentity.value)
        return Es6CodeResult(code: "let " + name + " = " + initializer.code + ";\n")
    }

    public emitUninitializedLocal(
        BoundLocalDeclarationStatement statement
    ) -> Es6CodeResult {
        if (!statement || statement.initializer) {
            throw Exception("ES6 uninitialized local requires a local without initializer")
        }
        let name = Es6NameMangler.mangle(statement.local.symbolIdentity.value)
        return Es6CodeResult(code: "let " + name + ";\n")
    }

    public emitAssignment(
        BoundAssignmentStatement statement,
        Es6CodeResult value
    ) -> Es6CodeResult {
        if (!statement || !value) {
            throw Exception("ES6 assignment requires statement and value")
        }
        if (!value.emitted) return value
        let name = Es6NameMangler.mangle(statement.target.symbolIdentity.value)
        return Es6CodeResult(code: name + " = " + value.code + ";\n")
    }

    public emitMemberAssignment(
        BoundMemberAssignmentStatement statement,
        Es6CodeResult target,
        Es6CodeResult value
    ) -> Es6CodeResult {
        if (!statement || !target || !value) {
            throw Exception("ES6 member assignment requires statement target and value")
        }
        if (!target.emitted) return target
        if (!value.emitted) return value
        return Es6CodeResult(code: target.code + " = " + value.code + ";\n")
    }

    public emitReturn(
        BoundReturnStatement statement,
        Es6CodeResult value
    ) -> Es6CodeResult {
        if (!statement || !statement.value || !value) {
            throw Exception("ES6 value return requires statement and value")
        }
        if (!value.emitted) return value
        return Es6CodeResult(code: "return " + value.code + ";\n")
    }

    public emitVoidReturn(BoundReturnStatement statement) -> Es6CodeResult {
        if (!statement || statement.value) {
            throw Exception("ES6 void return requires a value-less return")
        }
        return Es6CodeResult(code: "return;\n")
    }
}
