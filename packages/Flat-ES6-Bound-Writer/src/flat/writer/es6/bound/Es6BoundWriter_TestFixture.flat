package flat/writer/es6/bound

import flat/compiler/models
import flat/semantic/types
import flat/bound

class Es6BoundWriter_TestFixture {
    visible SourceSnapshotIdentity snapshot = SourceSnapshotIdentity(
        SourceIdentity("memory:Es6Bound.flat"), "revision:es6-bound"
    )

    public range(Int start = 0, Int end = 1) => SourceRange(
        snapshot,
        start,
        end,
        Location(lineNumber: 1, column: start + 1),
        Location(lineNumber: 1, column: end + 1)
    )

    public declaration(String kind, String name, Int ordinal) => DeclarationIdentity(
        SyntaxIslandIdentity(snapshot, "#kind-header", ordinal), kind, name
    )

    public symbol(String kind, String name, Int ordinal) =>
        SymbolIdentity(declaration(kind, name, ordinal), kind)

    public reference(String kind, String name, Int ordinal, SemanticType semanticType) =>
        BoundReferenceExpression(
            range(), semanticType, name, symbol(kind, name, ordinal)
        )
}
