package flat/writer/es6/bound

import flat/io
import flat/system
import flat/time/Time
import flat/parser/flat
import flat/semantic/binding/primitive
import flat/compiler/models

testable class {
    async test `executes reduced type slice under Node`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:class-execute"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse(tokens(), snapshot)
        let binding = PrimitiveClassBinder().bind(syntax, snapshot)
        let typeUnit = binding.typeUnit
        let emitted = Es6UnitOrchestrator().emitType(typeUnit, 0)
        let className = Es6NameMangler.mangle(typeUnit.identity.value)
        let functions = typeUnit.functionUnits()
        let method = functions.last
        let methodName = Es6NameMangler.mangle(method.identity.value)
        let root = File(
            ".flat-es6-class-test-#{Time.currentTimeMillis}"
        )
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "class.js")
        Es6ArtifactCommitter().commit(destination, emitted.fragment.code +
            "console.log(new " + className + "(7)." + methodName + "());\n")
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))

        expect(emitted.emitted).toBe(true)
        expect(response.stdout.join("")).toBe("7\n")
        Es6ArtifactFiles.remove(root)
    }

    async test `executes initialized field default parameter and target native constructor`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:exception-execute"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse(exceptionTokens(), snapshot)
        let typeUnit = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let emitted = Es6UnitOrchestrator().emitType(typeUnit, 0)
        let className = Es6NameMangler.mangle(typeUnit.identity.value)
        let fieldName = Es6NameMangler.mangle(typeUnit.fieldUnits().first.identity.value)
        let root = File(".flat-es6-exception-constructor-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "exception.js")
        Es6ArtifactCommitter().commit(destination, emitted.fragment.code +
            "console.log(new " + className + "()." + fieldName + ");\n")
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))

        expect(response.stdout.join("")).toBe("\n")
        expect(emitted.fragment.code.indexOf("globalThis['Math']['max'](1, 2)") >= 0)
            .toBe(true)
        Es6ArtifactFiles.remove(root)
    }

    exceptionTokens() -> Token[] {
        return [
            token("class", false, 1), token("Exception", false, 7), token("{", true, 17),
            token("visible", false, 19), token("String", false, 27), token("message", false, 34),
            token("=", true, 42), stringToken("''", 44), token(";", true, 46),
            token("construct", false, 48), token("(", true, 57), token("String", false, 58),
            token("message", false, 65), token("=", true, 73), stringToken("''", 75),
            token(")", true, 77), token("{", true, 79), token("native", false, 81),
            token("[", true, 87), token("es6", false, 88), token("]", true, 91),
            token("Math", false, 93), token(".", true, 97), token("max", false, 98),
            token("(", true, 101), token("1", false, 102, Token.Type.INTEGER),
            token(",", true, 103), token("2", false, 105, Token.Type.INTEGER),
            token(")", true, 106), token(";", true, 107), token("}", true, 109),
            token("}", true, 111)
        ]
    }

    tokens() -> Token[] {
        return [
            token("class", false, 1), token("Box", false, 7), token("{", true, 11),
            token("Int", false, 13), token("value", false, 17), token(";", true, 22),
            token("constructor", false, 24), token("(", true, 35), token("Int", false, 36), token("value", false, 40),
            token(")", true, 45), token("{", true, 47), token("this", false, 49), token(".", true, 53),
            token("value", false, 54), token("=", true, 60), token("value", false, 62), token(";", true, 67),
            token("}", true, 69), token("get", false, 71), token("(", true, 74), token(")", true, 75),
            token("->", true, 77), token("Int", false, 80), token("{", true, 84), token("return", false, 86),
            token("this", false, 93), token(".", true, 97), token("value", false, 98), token(";", true, 103),
            token("}", true, 105), token("}", true, 107)
        ]
    }

    stringToken(String value, Int column) -> Token => Token(
        value: value, type: Token.Type.STRING,
        location: Location(lineNumber: 1, column: column)
    )

    token(
        String value,
        Bool symbol,
        Int column,
        Int explicitType = Token.Type.IDENTIFIER
    ) -> Token {
        let type = symbol ? Token.Type.SYMBOL : explicitType
        return Token(value: value, type: type,
            location: Location(lineNumber: 1, column: column))
    }
}
