package flat/writer/es6/bound

import flat/io
import flat/system
import flat/time/Time
import flat/parser/flat
import flat/semantic/binding/primitive
import flat/compiler/models
import flat/semantic/types
import flat/bound

testable class {
    async test `parsed throw catch finally executes under Node`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:exception-execute"), "revision:one"
        )
        let syntax = PrimitiveControlStatementParser().parse([
            token("try", Token.Type.IDENTIFIER, 1), token("{", Token.Type.SYMBOL, 5),
            token("throw", Token.Type.IDENTIFIER, 7), token("'failure'", Token.Type.STRING, 13),
            token(";", Token.Type.SYMBOL, 22), token("}", Token.Type.SYMBOL, 24),
            token("catch", Token.Type.IDENTIFIER, 26), token("(", Token.Type.SYMBOL, 32),
            token("String", Token.Type.IDENTIFIER, 33), token("error", Token.Type.IDENTIFIER, 40),
            token(")", Token.Type.SYMBOL, 45), token("{", Token.Type.SYMBOL, 47),
            token("return", Token.Type.IDENTIFIER, 49), token("error", Token.Type.IDENTIFIER, 56),
            token(";", Token.Type.SYMBOL, 61), token("}", Token.Type.SYMBOL, 63),
            token("finally", Token.Type.IDENTIFIER, 65), token("{", Token.Type.SYMBOL, 73),
            token("let", Token.Type.IDENTIFIER, 75), token("done", Token.Type.IDENTIFIER, 79),
            token("=", Token.Type.SYMBOL, 84), token("true", Token.Type.BOOL, 86),
            token(";", Token.Type.SYMBOL, 90), token("}", Token.Type.SYMBOL, 92)
        ], snapshot)
        let statements = PrimitiveControlStatementBinder().bind(syntax, snapshot).statements()
        let range = syntax.statements().first.range
        let identity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "function", 1), "function", "run"
        )
        let unit = BoundFunctionUnit(identity, "run", SemanticTypes.stringType(), statements, range)
        let emitted = Es6UnitOrchestrator().emitFunction(unit, 0)
        let root = File(".flat-es6-exception-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "exception.js")
        Es6ArtifactCommitter().commit(destination, emitted.fragment.code +
            "console.log(" + Es6NameMangler.mangle(identity.value) + "());\n")
        let response = System.execute(["node", destination.normalizedLocation], silent: true, shell: false)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("failure\n")
        Es6ArtifactFiles.remove(root)
    }

    token(String value, Int type, Int column) -> Token => Token(
        value: value, type: type, location: Location(lineNumber: 1, column: column)
    )
}
