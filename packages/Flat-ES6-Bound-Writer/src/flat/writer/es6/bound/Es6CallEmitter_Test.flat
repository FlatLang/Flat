package flat/writer/es6/bound

testable class {
    test `emits function and native calls in supplied argument order`() {
        let emitter = Es6CallEmitter()
        let identity = "stable:function:join"
        let name = Es6NameMangler.mangle(identity)
        let arguments = emitter.joinArguments(["'first'", "'second'"])

        expect(emitter.emitFunctionCall(name, arguments))
            .toBe(name + "('first', 'second')")
        expect(emitter.emitNativeCall("flatPrint", arguments))
            .toBe("globalThis['flatPrint']('first', 'second')")
        expect(emitter.emitNativeCall("console.log", "'Hello, Flat'"))
            .toBe("globalThis['console']['log']('Hello, Flat')")
        expect(emitter.emitIntrinsicMemberCall("'x'", "repeat", "3"))
            .toBe("'x'.repeat(3)")
        expect(emitter.emitIntrinsicMemberCall("values", "add", "item"))
            .toBe("values.push(item)")
        expect(emitter.emitIntrinsicMemberCall("values", "map", "mapper"))
            .toBe("values.map(mapper)")
        expect(emitter.emitIntrinsicMemberCall("values", "contains", "item"))
            .toBe("values.includes(item)")
        expect(emitter.emitIntrinsicMemberCall("values", "join", ""))
            .toBe("values.join()")
        expect(emitter.emitIntrinsicMemberCall("value", "toUpperCase", ""))
            .toBe("String.fromCharCode(value).toUpperCase().charCodeAt(0)")
        expect(emitter.emitIntrinsicMemberCall("value", "toLowerCase", ""))
            .toBe("String.fromCharCode(value).toLowerCase().charCodeAt(0)")
    }
}
