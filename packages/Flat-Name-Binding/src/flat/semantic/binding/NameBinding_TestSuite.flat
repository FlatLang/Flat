package flat/semantic/binding

import flat/test/TestResult
import flat/time/Timer
import flat/io/FancyOutputStream
import flat/semantic/binding/primitive/PrimitiveExpressionBinder_Test
import flat/semantic/binding/primitive/PrimitiveStatementBinder_Test
import flat/semantic/binding/primitive/PrimitiveControlStatementBinder_Test
import flat/semantic/binding/primitive/PrimitiveExternalStatementBinder_Test
import flat/semantic/binding/primitive/PrimitiveFunctionBinder_Test
import flat/semantic/binding/primitive/PrimitiveClassBinder_Test
import flat/semantic/binding/primitive/PrimitiveClassPartitionBinder_Test
import flat/semantic/binding/primitive/PrimitiveInheritanceBinder_Test

[TestSuite [
    BinderWorkItem_Test,
    LayeredBindingLookup_Test,
    BindingDiagnostics_Test,
    PrimitiveExpressionBinder_Test,
    PrimitiveStatementBinder_Test,
    PrimitiveControlStatementBinder_Test,
    PrimitiveExternalStatementBinder_Test,
    PrimitiveFunctionBinder_Test,
    PrimitiveClassBinder_Test,
    PrimitiveClassPartitionBinder_Test,
    PrimitiveInheritanceBinder_Test
]]
class {
    public static async main(String[] args) {
        let test = NameBinding_TestSuite()
        let results = TestResult[]
        let timer = Timer().start()
        test.runTests({ results.add(_) })
        timer.stop()

        let unsuccessful = results.filter({ !_.success })
        let fancy = FancyOutputStream(headerPattern: "/\\")
        if (unsuccessful.isNotEmpty) {
            fancy.writeHeader(
                "#unsuccessful.count Failure#{unsuccessful.count == 1 ? "" : "s"} out of #results.count tests",
                pattern: ":'( ",
                symmetrical: true
            )
            unsuccessful.forEach({ Console.log("#_") })
        } else {
            fancy.writeHeader("All #results.count Successful", pattern: ":) ", symmetrical: true)
        }
        Console.writeLine("Took #{timer.duration}ms")
        if (unsuccessful.isNotEmpty) System.exit(1)
    }
}
