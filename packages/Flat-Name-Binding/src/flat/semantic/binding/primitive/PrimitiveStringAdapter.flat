package flat/semantic/binding/primitive

import flat/bound
import flat/compiler/models
import flat/semantic/types

/** Resolves scalar text representation changes before publishing bound calls. */
class {
    public static wrap(BoundExpression value, SemanticType required,
        PrimitiveResolvedDeclarationContext context, CallableSignature[] callables) -> BoundExpression {
        if (value.semanticType.value() == required.value()) return value
        if (value.semanticType.kind() == "nullable" || required.kind() == "nullable")
            throw Exception("Nullable text adaptation requires single-evaluation null-preserving lowering")
        if (value.semanticType.value() != SemanticTypes.stringType().value())
            throw Exception("Text unwrapping requires a truthful native storage bridge")
        let canonical = context ? context.candidates("flat/String") : null
        if (!canonical || canonical.count != 1)
            throw Exception("Text adaptation requires one canonical flat/String declaration")
        let owner = UserClassSemanticType(canonical.first)
        if (required.value() != owner.value())
            throw Exception("Text adaptation cannot target a noncanonical String declaration")
        let targets = callables.filter((candidate) => candidate.callableKind.value == "constructor" &&
            candidate.ownerType.value() == owner.value() && candidate.returnType.value() == owner.value() &&
            candidate.parameterTypes().count == 1 && candidate.optionalParameterCount == 0 &&
            candidate.parameterTypes().first.value() == SemanticTypes.stringType().value())
        if (targets.count != 1)
            throw Exception("Text adaptation requires one canonical native text constructor")
        let checked = CallTypeChecker.check(targets.first, null, [value.semanticType], value.range)
        if (!checked.valid) throw Exception(checked.diagnostic.message)
        return BoundCallExpression(value.range, checked.semanticType, targets.first, null,
            [value], checked.argumentConversions())
    }

    /** Ordinary overloads win before any representation-changing candidate. */
    public static call(String name, CallableSignature[] candidates, BoundExpression receiver,
        BoundExpression[] arguments, PrimitiveResolvedDeclarationContext context,
        CallableSignature[] callables, TypeHierarchyComponent hierarchy,
        Bool safeAccess = false, SourceRange callRange = null) -> BoundCallExpression {
        let range = callRange ?: receiver.range
        let receiverType = safeAccess && receiver && receiver.semanticType.kind() == "nullable" ?
            ((NullableSemanticType)receiver.semanticType).underlyingType : receiver ? receiver.semanticType : null
        let exact = OverloadResolver.resolve(name, candidates, receiverType,
            arguments.map({ _.semanticType }), range, hierarchy)
        if (exact.resolved) {
            let checked = CallTypeChecker.check(exact.selected, receiverType,
                arguments.map({ _.semanticType }), range, hierarchy)
            return resolvedCall(checked, receiver, arguments, safeAccess, range, hierarchy)
        }
        // An existing ambiguity must not be replaced by an adapter-selected call.
        if (exact.applicableCandidates().isNotEmpty) throw Exception(exact.diagnostic.message)
        let checks = CallCheckResult[]
        let calls = BoundCallExpression[]
        for (candidate in candidates) {
            if (arguments.count > candidate.parameterTypes().count ||
                arguments.count < candidate.parameterTypes().count - candidate.optionalParameterCount) continue
            let adapted = BoundExpression[]
            var Int index
            var Bool rejected
            for (argument in arguments) {
                let required = candidate.parameterTypes()[index]
                if (TypeConversions.classify(argument.semanticType, required, hierarchy: hierarchy).applicable) {
                    adapted.add(argument)
                } else {
                    try {
                        adapted.add(wrap(argument, required, context, callables))
                    } catch (Exception error) {
                        rejected = true
                    }
                }
                index++
            }
            if (rejected) continue
            let checked = CallTypeChecker.check(candidate, receiverType,
                adapted.map({ _.semanticType }), range, hierarchy)
            if (checked.valid) {
                checks.add(checked)
                calls.add(resolvedCall(checked, receiver, adapted, safeAccess, range, hierarchy))
            }
        }
        let selected = OverloadResolver.resolveChecked(name, candidates, checks, range)
        if (!selected.resolved) throw Exception(selected.diagnostic.message)
        return calls.firstOrNull({ _.target.identity.value == selected.selected.identity.value })
    }

    static resolvedCall(CallCheckResult checked, BoundExpression receiver,
        BoundExpression[] arguments, Bool safeAccess, SourceRange range, TypeHierarchyComponent hierarchy) -> BoundCallExpression {
        let resultType = safeAccess && checked.semanticType.kind() != "nullable" ?
            NullableSemanticType(checked.semanticType) : checked.semanticType
        let receiverType = receiver && safeAccess && receiver.semanticType.kind() == "nullable" ?
            ((NullableSemanticType)receiver.semanticType).underlyingType : receiver ? receiver.semanticType : null
        let receiverConversion = receiver ? TypeConversions.classify(receiverType, checked.target.receiverType(), hierarchy: hierarchy) : null
        return BoundCallExpression(range, resultType, checked.target, receiver,
            arguments, checked.argumentConversions(), safeAccess: safeAccess, receiverConversion: receiverConversion)
    }

    /** Resolve the source-declared canonical String addition contract, never a native coercion. */
    public static plus(BoundExpression left, BoundExpression right,
        PrimitiveResolvedDeclarationContext context, CallableSignature[] callables,
        TypeHierarchyComponent hierarchy) -> BoundCallExpression {
        if (!context) return null
        let strings = context.candidates("flat/String")
        let operators = context.candidates("flat/operators/PlusOperator")
        if (strings.count != 1 || operators.count != 1) return null
        let ownerType = UserClassSemanticType(strings.first)
        if (left.semanticType.value() != ownerType.value() && right.semanticType.value() != ownerType.value()) return null
        let syntax = context.classFor(strings.first)
        if (!syntax) return null
        let scope = context.scopeFor(strings.first)
        let resolver = PrimitiveStructuralTypeResolver(declarationContext: scope, lookupRange: syntax.range)
        var Bool implemented
        for (name in syntax.implementedTypeNames()) {
            let type = resolver.resolve(name)
            if (type.kind() != "generic-instance") continue
            let contract = (GenericInstanceSemanticType)type
            let arguments = contract.typeArguments()
            if (contract.declarationType.declarationIdentity.value == operators.first.value &&
                arguments.count == 2 && arguments.all({ _.value() == ownerType.value() })) {
                implemented = true
            }
        }
        if (!implemented) return null
        let receiver = textOperand(left, ownerType, context, callables, hierarchy)
        let argument = textOperand(right, ownerType, context, callables, hierarchy)
        let candidates = callables.filter((candidate) => candidate.callableKind.value == "instance-method" &&
            candidate.ownerType.value() == ownerType.value() && candidate.name == "plus" &&
            candidate.returnType.value() == ownerType.value())
        return call("plus", candidates, receiver, [argument], context, callables, hierarchy)
    }

    /** Primitive concatenation follows canonical source-declared scalar toString contracts. */
    static textOperand(BoundExpression value, SemanticType required,
        PrimitiveResolvedDeclarationContext context, CallableSignature[] callables,
        TypeHierarchyComponent hierarchy) -> BoundExpression {
        if (value.semanticType.value() == required.value()) return value
        if (value.semanticType.kind() == "string") return wrap(value, required, context, callables)
        if (value.semanticType.kind() == "generic-parameter") {
            let roots = context.candidates("flat/Object")
            if (roots.count != 1 || !hierarchy || !hierarchy.isRootClass(UserClassSemanticType(roots.first)))
                throw Exception("Generic text conversion requires a registered canonical Object root")
            let targets = callables.filter((candidate) => candidate.callableKind.value == "instance-method" &&
                candidate.ownerType.declarationIdentity.value == roots.first.value &&
                candidate.name == "toString" && candidate.returnType.value() == required.value() &&
                candidate.parameterTypes().isEmpty)
            return call("toString", targets, value, BoundExpression[], context, callables, hierarchy)
        }
        if (value.semanticType.value() == SemanticTypes.intType().value()) {
            let declarations = context ? context.candidates("flat/primitive/number/Int") : null
            if (!declarations || declarations.count != 1)
                throw Exception("String addition requires one canonical Int declaration")
            let candidates = callables.filter((candidate) => candidate.callableKind.value == "static-method" &&
                candidate.ownerType && candidate.ownerType.declarationIdentity.value == declarations.first.value &&
                candidate.name == "toString" && candidate.returnType.value() == required.value() &&
                candidate.parameterTypes().count == 1 && candidate.optionalParameterCount == 0 &&
                candidate.parameterTypes().first.value() == SemanticTypes.intType().value())
            if (candidates.count != 1)
                throw Exception("String addition requires one canonical Int.toString(Int) contract")
            return call("toString", candidates, null, [value], context, callables, hierarchy, callRange: value.range)
        }
        if (value.semanticType.value() != SemanticTypes.charType().value())
            throw Exception("String addition requires a declared text conversion contract")
        let declarations = context.candidates("flat/primitive/number/Char")
        if (declarations.count != 1)
            throw Exception("String addition requires one canonical Char declaration")
        let candidates = callables.filter((candidate) => candidate.callableKind.value == "static-method" &&
            candidate.ownerType.declarationIdentity.value == declarations.first.value &&
            candidate.name == "toString" && candidate.returnType.value() == required.value() &&
            candidate.parameterTypes().count == 1 && candidate.optionalParameterCount == 0 &&
            candidate.parameterTypes().first.value() == SemanticTypes.charType().value())
        return call("toString", candidates, null, [value], context, callables, hierarchy, callRange: value.range)
    }

    /** Never publish the old representation-changing no-op conversion markers. */
    public static unsupported(SemanticType source, SemanticType target, String operation,
        Bool applicable, Bool explicitConversion, Bool implicitConversion, Int rank) -> TypeConversion {
        throw Exception("Text representation adapter unavailable for #operation: #{source.value()} to #{target.value()}")
    }
}
