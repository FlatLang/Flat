    async test `class override suppresses generic trait default with specialized callback receiver`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:specialized-override"), "one")
        let traitStream = Lexer().lex("trait List<T> { map<Out>(f(T x, Int i, List<T> list) -> Out) -> Int { return 1; } }")
        traitStream.emit("start")
        let contract = PrimitiveInterfaceParser().parse(traitStream.consumeAll<Token>("data"), snapshot)
        let classStream = Lexer().lex("class Array<E> implements List<E> { override map<Out>(f(E x, Int i, Array<E> array) -> Out) -> Int { return 2; } }")
        classStream.emit("start")
        let syntax = PrimitiveClassParser().parse(classStream.consumeAll<Token>("data"), snapshot)
        expect(contract.methodValues().first.parameterTypeNames().first).toBe("f(T,Int,List<T>)->Out")
        expect(syntax.methodValues().first.parameterValues().first.typeName).toBe("func(E,Int,Array<E>)->Out")
        let types = PrimitiveClassPartitionBinder().bind([syntax], interfaceSyntaxValues: [contract]).typeUnits()
        expect(types.first.functionUnits().filter({ _.name == "map" }).count).toBe(1)
        let differentStream = Lexer().lex("class Different<E> implements List<E> { map<Out>(f(E x, Bool i, Different<E> array) -> Out) -> Int { return 2; } }")
        differentStream.emit("start")
        let different = PrimitiveClassParser().parse(differentStream.consumeAll<Token>("data"), snapshot)
        expect(PrimitiveClassPartitionBinder().bind([different], interfaceSyntaxValues: [contract])
            .typeUnits().first.functionUnits().filter({ _.name == "map" }).count).toBe(2)
    }

