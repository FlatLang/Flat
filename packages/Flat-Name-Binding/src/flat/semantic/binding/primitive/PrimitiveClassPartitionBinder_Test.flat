    async test `configured static overload failures preserve typed consumer diagnostics and candidate order`() {
        String[] arguments = ["true", "1"]
        var Int caseIndex
        for (argument in arguments) {
            let contexts = PrimitiveSourceBindingContext[]
            String[] sources = [
                "class First { public static choose(Int value) -> Int { return value; } }",
                "class Second { public static choose(Int value) -> Int { return value; } }",
                "class Consumer { static run() -> Int { return choose(" + argument + "); } }"
            ]
            var Int index
            for (source in sources) {
                let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:static-diagnostic:#{index}"), "one")
                let stream = Lexer().lex(source)
                stream.emit("start")
                let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
                let defaults = PrimitiveDefaultImport[]
                if (index == 2) {
                    defaults.add(PrimitiveDefaultImport("library/First", true))
                    defaults.add(PrimitiveDefaultImport("library/Second", true))
                }
                contexts.add(PrimitiveSourceBindingContext(index == 2 ? "app" : "library", snapshot, [syntax],
                    defaultImports: defaults))
                index++
            }
            let consumer = contexts.last.classValues().first
            let statement = consumer.methodValues().first.statements().first
            let returned = (PrimitiveReturnSyntax)statement
            let expectedRange = returned.value.range
            var BindingDiagnostic firstDiagnostic
            var BindingDiagnostic secondDiagnostic
            try { PrimitiveClassPartitionBinder().bindContexts(contexts) }
            catch (PrimitiveContextBindingException error) { firstDiagnostic = error.diagnostic }
            try { PrimitiveClassPartitionBinder().bindContexts(contexts.reverse()) }
            catch (PrimitiveContextBindingException error) { secondDiagnostic = error.diagnostic }
            expect(firstDiagnostic != null).toBe(true)
            expect(secondDiagnostic != null).toBe(true)
            if (!firstDiagnostic || !secondDiagnostic) throw Exception("Static overload failure lost typed consumer diagnostic")
            expect(firstDiagnostic.code).toBe(caseIndex == 0 ? "type.call-no-match" : "type.call-ambiguous")
            expect(firstDiagnostic.range).toBe(expectedRange)
            expect(firstDiagnostic.candidateValues.count).toBe(2)
            expect(firstDiagnostic.candidateValues).toBe(secondDiagnostic.candidateValues)
            expect(firstDiagnostic.candidateValues[0].compareTo(firstDiagnostic.candidateValues[1]) < 0).toBe(true)
            expect(secondDiagnostic.code).toBe(firstDiagnostic.code)
            expect(secondDiagnostic.range).toBe(expectedRange)
            caseIndex++
        }
    }

    async test `configured type precedence and ambiguity retain canonical consumer diagnostics`() {
        let contexts = PrimitiveSourceBindingContext[]
        let namespaces = ["local", "explicit", "configured", "flat"]
        var Int index
        for (namespaceName in namespaces) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:configured-precedence:#{index}"), "one")
            let stream = Lexer().lex("class String { construct() {} }")
            stream.emit("start")
            let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
            contexts.add(PrimitiveSourceBindingContext(namespaceName, snapshot, [syntax]))
            index++
        }
        let consumer = contexts.first
        let range = consumer.classValues().first.range
        let configured = [PrimitiveDefaultImport("configured/String")]
        let scopeOwner = PrimitiveSourceBindingContext("app", consumer.snapshot, PrimitiveClassSyntax[],
            defaultImports: configured)
        let scope = PrimitiveResolvedDeclarationContext(scopeOwner, contexts)
        expect(scope.resolve("String", range).value).toBe(scope.classIdentity(contexts[2].classValues().first).value)
        let explicitOwner = PrimitiveSourceBindingContext("app", consumer.snapshot, PrimitiveClassSyntax[],
            importValues: [PrimitiveBindingImport("explicit/String", range)], defaultImports: configured)
        expect(PrimitiveResolvedDeclarationContext(explicitOwner, contexts).resolve("String", range).value)
            .toBe(scope.classIdentity(contexts[1].classValues().first).value)
        let localOwner = PrimitiveSourceBindingContext("local", consumer.snapshot, consumer.classValues(),
            importValues: explicitOwner.importValues(), defaultImports: configured)
        expect(PrimitiveResolvedDeclarationContext(localOwner, contexts).resolve("String", range).value)
            .toBe(scope.classIdentity(consumer.classValues().first).value)
        let ambiguousOwner = PrimitiveSourceBindingContext("app", consumer.snapshot, PrimitiveClassSyntax[],
            defaultImports: [PrimitiveDefaultImport("configured/String"), PrimitiveDefaultImport("explicit/String")])
        var Bool rejected
        try { PrimitiveResolvedDeclarationContext(ambiguousOwner, contexts).resolve("String", range) }
        catch (PrimitiveContextBindingException error) {
            rejected = error.diagnostic.code == "binding.import-ambiguous" && error.diagnostic.range == range
        }
        expect(rejected).toBe(true)
    }

    async test `configured import diagnostics use consumer and share explicit import capacity`() {
