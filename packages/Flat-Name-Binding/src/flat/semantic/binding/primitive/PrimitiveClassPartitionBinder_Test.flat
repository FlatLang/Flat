    async test `infers owner generic constructor through a source-owned array receiver`() {
        let sources = [
            "class Array<E> { next() -> ArrayIterator<E> { return ArrayIterator(this); } }",
            "class ArrayIterator<E> { construct(E[] values) {} }"
        ]
        let syntaxes = PrimitiveClassSyntax[]
        var Int sourceIndex
        for (source in sources) {
            let snapshot = SourceSnapshotIdentity(
                SourceIdentity("memory:iterator-constructor:#{sourceIndex}"), "one")
            let stream = Lexer().lex(source)
            stream.emit("start")
            syntaxes.add(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot))
            sourceIndex++
        }
        let units = PrimitiveClassPartitionBinder().bind(syntaxes).typeUnits()
        let function = units.firstOrNull({ _.identity.name == "Array" }).functionUnits()
            .firstOrNull({ _.name == "next" })
        expect(function.returnType.kind()).toBe("generic-instance")
        let reversed = PrimitiveClassPartitionBinder().bind([syntaxes.last, syntaxes.first])
            .typeUnits()
        expect(reversed.firstOrNull({ _.identity.name == "Array" }).functionUnits()
            .firstOrNull({ _.name == "next" }).returnType.value()).toBe(function.returnType.value())
    }

