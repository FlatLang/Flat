    async test `keeps inferred result owner scope`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:inferred-owner"), "one")
        let traitStream = Lexer().lex("trait Items<E> { public relay(Box<Box<E>> value) -> Box<Box<E>> { return value; } public nested(Box<Box<E>> value) => relay(value) }")
        traitStream.emit("start")
        let contract = PrimitiveInterfaceParser().parse(traitStream.consumeAll<Token>("data"), snapshot)
        let sources = ["class Box<E> {}", "class Generic<E> implements Items<E> {}", "class Concrete implements Items<Int> {}"]
        let syntaxes = PrimitiveClassSyntax[]
        var Int offset = 100
        for (source in sources) {
            let stream = Lexer().lex(source)
            stream.emit("start")
            syntaxes.add(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot, offset))
            offset += 100
        }
        let context = PrimitiveSourceBindingContext("flat", snapshot, syntaxes, [contract])
        let units = PrimitiveClassPartitionBinder().bindContexts([context]).typeUnits()
        let concrete = units.firstOrNull({ _.semanticType.declarationIdentity.name == "Concrete" })
        let nested = concrete.functionUnits().firstOrNull({ _.name == "nested" })
        expect(nested.returnType.value()).toBe(nested.parameterValues().first.semanticType.value())
        expect(nested.returnType.value().contains("primitive:Int")).toBe(true)
        expect(nested.returnType.value().contains("generic-parameter")).toBe(false)
    }

