    async test `reuses first contextual callback parameter by indexed name`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:implicit-callback-name"), "one")
        let stream = Lexer().lex("{ _x == _x }")
        stream.emit("start")
        let syntax = PrimitiveExpressionParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let context = FunctionSemanticType([SemanticTypes.intType(), SemanticTypes.intType()], SemanticTypes.boolType())
        let bound = PrimitiveExpressionBinder().bindCallback((PrimitiveLambdaSyntax)syntax,
            context, LocalBinding[], CallableSignature[])
        expect(bound.succeeded).toBe(true)
        let lambda = (BoundLambdaExpression)bound.expression
        expect(lambda.parameterValues().count).toBe(2)
        let body = (BoundBinaryExpression)lambda.body
        expect(((BoundReferenceExpression)body.left).symbolIdentity.value)
            .toBe(lambda.parameterValues().first.identity.value)
        expect(((BoundReferenceExpression)body.right).symbolIdentity.value)
            .toBe(lambda.parameterValues().first.identity.value)
        let outside = Lexer().lex("_x")
        outside.emit("start")
        expect(PrimitiveExpressionBinder().bind(
            PrimitiveExpressionParser().parse(outside.consumeAll<Token>("data"), snapshot)
        ).succeeded).toBe(false)
        let indexed = Lexer().lex("{ _i == _i }")
        indexed.emit("start")
        let indexedSyntax = PrimitiveExpressionParser().parse(indexed.consumeAll<Token>("data"), snapshot)
        let indexedBound = PrimitiveExpressionBinder().bindCallback(
            (PrimitiveLambdaSyntax)indexedSyntax, context, LocalBinding[], CallableSignature[])
        expect(indexedBound.succeeded).toBe(true)
        let indexedLambda = (BoundLambdaExpression)indexedBound.expression
        let indexedBody = (BoundBinaryExpression)indexedLambda.body
        expect(((BoundReferenceExpression)indexedBody.left).symbolIdentity.value)
            .toBe(indexedLambda.parameterValues()[1].identity.value)
        let shadow = Lexer().lex("{ _x }")
        shadow.emit("start")
        let lexical = LocalBinding("_x", SymbolIdentity(DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "local", 20), "local", "_x"
        ), "local"), SemanticTypes.intType())
        let shadowSyntax = PrimitiveExpressionParser().parse(shadow.consumeAll<Token>("data"), snapshot)
        let shadowBound = PrimitiveExpressionBinder().bindCallback(
            (PrimitiveLambdaSyntax)shadowSyntax, context, [lexical], CallableSignature[])
        expect(shadowBound.succeeded).toBe(true)
        let shadowLambda = (BoundLambdaExpression)shadowBound.expression
        let shadowReference = (BoundReferenceExpression)shadowLambda.body
        expect(shadowReference.symbolIdentity.value).toBe(lexical.identity.value)
    }
    async test `binds generic List default using published root method only`() {
        let rootSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:root-contract"), "one")
        let listSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:list-contract-real"), "one")
        let arraySnapshot = SourceSnapshotIdentity(SourceIdentity("memory:array-contract-real"), "one")
        let rootStream = Lexer().lex("class Object { public equals(Object another) -> Bool { return true; } }")
        rootStream.emit("start")
        let root = PrimitiveClassParser().parse(rootStream.consumeAll<Token>("data"), rootSnapshot)
        let listStream = Lexer().lex("trait List<Type> { public any(anyFunc(Type x, Int i, List<Type> list) -> Bool) => false { return false; } public contains(Type value) => any({ _x == null && value == null || _x != null && _x.equals(value) }) }")
        listStream.emit("start")
        let list = PrimitiveInterfaceParser().parse(listStream.consumeAll<Token>("data"), listSnapshot)
        let arrayStream = Lexer().lex("class Array<E> implements List<E> { visible native_array var E[] data; this[Int index] <=> data[index] }")
        arrayStream.emit("start")
        let array = PrimitiveClassParser().parse(arrayStream.consumeAll<Token>("data"), arraySnapshot)
        let stringStream = Lexer().lex("class String { visible Char[] charsToTrim; check(Char value) -> Bool { return charsToTrim.contains(value); } trim(Char[] charsToTrim, Int start) -> Bool { while (start < 1 && charsToTrim.contains(charsToTrim[start])) { start++; } return true; } inferred(Char value) => charsToTrim.contains(value) }")
        stringStream.emit("start")
        let string = PrimitiveClassParser().parse(stringStream.consumeAll<Token>("data"),
            SourceSnapshotIdentity(SourceIdentity("memory:string-contract-real"), "one"))
        let arrayOverlayStream = Lexer().lex("class Array<E> { equals(E value) -> Bool { return true; } }")
        arrayOverlayStream.emit("start")
        let arrayOverlay = PrimitiveClassParser().parse(arrayOverlayStream.consumeAll<Token>("data"),
            SourceSnapshotIdentity(SourceIdentity("memory:array-overlay-contract-real"), "one"))
        let mergedArray = array.mergedWith(arrayOverlay)
        let units = PrimitiveClassPartitionBinder().bind([root, mergedArray, string], interfaceSyntaxValues: [list]).typeUnits()
        expect(units.last.functionUnits().firstOrNull({ _.name == "check" }).returnType.value())
            .toBe(SemanticTypes.boolType().value())
        expect(units.firstOrNull({ _.identity.name == "Array" }).functionUnits().firstOrNull({ _.name == "contains" }).returnType.value())
            .toBe(SemanticTypes.boolType().value())
        let reversed = PrimitiveClassPartitionBinder().bind([string, root, mergedArray],
            interfaceSyntaxValues: [list]).typeUnits()
        expect(reversed.firstOrNull({ _.identity.name == "String" }).functionUnits()
            .firstOrNull({ _.name == "trim" }).returnType.value())
            .toBe(SemanticTypes.boolType().value())
        expect(reversed.firstOrNull({ _.identity.name == "String" }).functionUnits()
            .firstOrNull({ _.name == "inferred" }).returnType.value())
            .toBe(SemanticTypes.boolType().value())
        let orderedStream = Lexer().lex("trait Ordered<T> implements List<T> { indexOf(T value) => 0 }")
        orderedStream.emit("start")
        let ordered = PrimitiveInterfaceParser().parse(orderedStream.consumeAll<Token>("data"),
            SourceSnapshotIdentity(SourceIdentity("memory:ordered-contract-real"), "one"))
        let inheritedArrayStream = Lexer().lex("class Array<E> implements Ordered<E> { visible native_array var E[] data; this[Int index] <=> data[index] }")
        inheritedArrayStream.emit("start")
        let inheritedArray = PrimitiveClassParser().parse(inheritedArrayStream.consumeAll<Token>("data"), arraySnapshot)
        let inheritedUnits = PrimitiveClassPartitionBinder().bind([root, inheritedArray.mergedWith(arrayOverlay)], interfaceSyntaxValues: [list, ordered]).typeUnits()
        expect(inheritedUnits.last.functionUnits().filter({ _.name == "contains" }).count).toBe(1)
        expect(inheritedUnits.last.functionUnits().firstOrNull({ _.name == "contains" }).returnType.value())
            .toBe(SemanticTypes.boolType().value())
        let orderedUnits = PrimitiveClassPartitionBinder().bind([root, mergedArray, string],
            interfaceSyntaxValues: [list, ordered]).typeUnits()
        expect(orderedUnits.firstOrNull({ _.identity.name == "Array" }).functionUnits()
            .filter({ _.name == "contains" }).count).toBe(1)
        expect(orderedUnits.firstOrNull({ _.identity.name == "String" }).functionUnits()
            .firstOrNull({ _.name == "trim" }).returnType.value()).toBe(SemanticTypes.boolType().value())
        let overloadStream = Lexer().lex("class Array<E> implements Ordered<E> { contains(Bool value) -> Bool { return false; } }")
        overloadStream.emit("start")
        let overload = PrimitiveClassParser().parse(overloadStream.consumeAll<Token>("data"), arraySnapshot)
        let overloadUnits = PrimitiveClassPartitionBinder().bind([root, overload],
            interfaceSyntaxValues: [list, ordered]).typeUnits()
        expect(overloadUnits.last.functionUnits().filter({ _.name == "contains" }).count).toBe(2)
        let deepStream = Lexer().lex("trait Deep<V> implements Ordered<V> { read() -> Int { return 1; } }")
        deepStream.emit("start")
        let deep = PrimitiveInterfaceParser().parse(deepStream.consumeAll<Token>("data"),
            SourceSnapshotIdentity(SourceIdentity("memory:deep-contract-real"), "one"))
        let deepArrayStream = Lexer().lex("class Array<E> implements Deep<E> { }")
        deepArrayStream.emit("start")
        let deepArray = PrimitiveClassParser().parse(deepArrayStream.consumeAll<Token>("data"), arraySnapshot)
        let deepUnits = PrimitiveClassPartitionBinder().bind([root, deepArray.mergedWith(arrayOverlay)],
            interfaceSyntaxValues: [list, ordered, deep]).typeUnits()
        expect(deepUnits.last.functionUnits().filter({ _.name == "contains" }).count).toBe(1)
        expect(deepUnits.last.functionUnits().firstOrNull({ _.name == "contains" }).returnType.value())
            .toBe(SemanticTypes.boolType().value())
        let cycleStream = Lexer().lex("trait Loop<X> implements Loop<X> { }")
        cycleStream.emit("start")
        let cycle = PrimitiveInterfaceParser().parse(cycleStream.consumeAll<Token>("data"),
            SourceSnapshotIdentity(SourceIdentity("memory:cycle-contract-real"), "one"))
        let cycleClassStream = Lexer().lex("class Value<E> implements Loop<E> { }")
        cycleClassStream.emit("start")
        let cycleClass = PrimitiveClassParser().parse(cycleClassStream.consumeAll<Token>("data"), arraySnapshot)
        var String cycleError
        try {
            PrimitiveClassPartitionBinder().bind([cycleClass], interfaceSyntaxValues: [cycle])
        } catch (Exception error) { cycleError = error.message }
        expect(cycleError).toBe("Cyclic trait inheritance 'Loop'")
    }
    async test `publishes instantiated List contains default for Array across sources`() {
        let listSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:list-contract"), "one")
        let arraySnapshot = SourceSnapshotIdentity(SourceIdentity("memory:array-implementation"), "one")
        let stringSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:string-client"), "one")
        let listStream = Lexer().lex("trait List<Type> { public contains(Type value) => true }")
        listStream.emit("start")
        let contract = PrimitiveInterfaceParser().parse(listStream.consumeAll<Token>("data"), listSnapshot)
        expect(contract.methodValues().any({ _.name == "contains" })).toBe(true)
        let arrayStream = Lexer().lex("class Array<E> implements List<E> { visible native_array var E[] data; this[Int index] <=> data[index] }")
        arrayStream.emit("start")
        let array = PrimitiveClassParser().parse(arrayStream.consumeAll<Token>("data"), arraySnapshot)
        let stringStream = Lexer().lex("class String { visible Char[] charsToTrim; check(Char value) -> Bool { return charsToTrim.contains(value); } }")
        stringStream.emit("start")
        let string = PrimitiveClassParser().parse(stringStream.consumeAll<Token>("data"), stringSnapshot)
        let units = PrimitiveClassPartitionBinder().bind([array, string], interfaceSyntaxValues: [contract]).typeUnits()
        expect(units.first.functionUnits().any({ _.name == "contains" })).toBe(true)
        expect(units.last.functionUnits().firstOrNull({ _.name == "check" }).returnType.value())
            .toBe(SemanticTypes.boolType().value())
    }
    async test `binds generic indexed parameter inside structured member call`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:indexed-member-argument"), "one")
        let sources = [
            "class Array<E> { visible native_array var E[] data; this[Int index] <=> data[index] public contains(E value) -> Bool { return true; } }",
            "class StringCharArray { visible native_array Char[] data; this[Int index] -> Char { get { return data[index]; } } }",
            "class String { visible StringCharArray chars; trim(Char[] charsToTrim, Int start) -> Bool { while (start < 1 && charsToTrim.contains(chars[start])) { start++; } return true; } }"
        ]
        let syntaxes = PrimitiveClassSyntax[]
        for (source in sources) {
            let stream = Lexer().lex(source)
            stream.emit("start")
            syntaxes.add(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot))
        }
        let units = PrimitiveClassPartitionBinder().bind(syntaxes, snapshot).typeUnits()
        let string = units.firstOrNull({ _.identity.name == "String" })
        let trim = string.functionUnits().firstOrNull({ _.name == "trim" })
        expect(string.fieldUnits().first.semanticType.kind()).toBe("user-class")
        let statements = trim.statements()
        let conditionObject = (Object)statements.first
        let condition = (BoundWhileStatement)conditionObject
        expect(condition.condition.expressionKind()).toBe("binary")
        expect(trim.returnType.value()).toBe(SemanticTypes.boolType().value())
    }

    async test `binds nested indexed field before published generic contains call`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:indexed-field-call"), "one")
        let sources = [
            "class Array<E> implements List<E> { visible native_array var E[] data; this[Int index] <=> data[index] }",
            "class StringCharArray { visible native_array Char[] data; this[Int index] -> Char { get { return data[index]; } } }",
            "class String { visible StringCharArray chars; trim(Char[] charsToTrim, Int start) -> Bool { while (start < 1 && charsToTrim.contains(chars[start])) { start++; } return true; } localPrecedence(StringCharArray chars, Int start) -> Char { return chars[start]; } }"
        ]
        let traitStream = Lexer().lex("trait List<T> { public contains(T value) => true }")
        traitStream.emit("start")
        let contract = PrimitiveInterfaceParser().parse(traitStream.consumeAll<Token>("data"), snapshot)
        let syntaxes = PrimitiveClassSyntax[]
        var Int sourceIndex
        for (source in sources) {
            let sourceSnapshot = SourceSnapshotIdentity(
                SourceIdentity("memory:indexed-field-call:#{sourceIndex}"), "one")
            let stream = Lexer().lex(source)
            stream.emit("start")
            syntaxes.add(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), sourceSnapshot))
            sourceIndex++
        }
        let units = PrimitiveClassPartitionBinder().bind(syntaxes,
            interfaceSyntaxValues: [contract]).typeUnits()
        let string = units.firstOrNull({ _.identity.name == "String" })
        let trim = string.functionUnits().firstOrNull({ _.name == "trim" })
        let precedence = string.functionUnits().firstOrNull({ _.name == "localPrecedence" })
        expect(precedence.returnType.value()).toBe(SemanticTypes.charType().value())
        expect(trim.returnType.value()).toBe(SemanticTypes.boolType().value())
        let missingStream = Lexer().lex("class Missing { check(Int index) -> Char { return chars[index]; } }")
        missingStream.emit("start")
        let missing = PrimitiveClassParser().parse(missingStream.consumeAll<Token>("data"), snapshot)
        var String diagnostic
        try { PrimitiveClassPartitionBinder().bind([missing], snapshot) }
        catch (Exception error) { diagnostic = error.message }
        expect(diagnostic != null).toBe(true)
    }

    async test `binds indexed field through merged overlay and distinct source identities`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:canonical-string"), "one")
        let overlaySnapshot = SourceSnapshotIdentity(SourceIdentity("memory:overlay-string"), "one")
        let arraySnapshot = SourceSnapshotIdentity(SourceIdentity("memory:array"), "one")
        let charsSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:string-char-array"), "one")
        let arrayStream = Lexer().lex("class Array<E> { visible native_array var E[] data; this[Int index] <=> data[index] public contains(E value) -> Bool { return true; } }")
        arrayStream.emit("start")
        let charsStream = Lexer().lex("class StringCharArray { visible native_array Char[] data; this[Int index] -> Char { get { return data[index]; } } }")
        charsStream.emit("start")
        let canonicalStream = Lexer().lex("class String { visible Int count; visible StringCharArray chars; trimStart(var Int: start, Char[] charsToTrim) -> String { while (start <= count - 1 && charsToTrim.contains(chars[start])) { start++; } return start > count - 1 ? \"\" : substring(start, count); } substring(Int start, Int end) -> String { return this; } }")
        canonicalStream.emit("start")
        let overlayStream = Lexer().lex("class String { extension() -> Int { return 1; } }")
        overlayStream.emit("start")
        let canonical = PrimitiveClassParser().parse(canonicalStream.consumeAll<Token>("data"), snapshot)
        let overlay = PrimitiveClassParser().parse(overlayStream.consumeAll<Token>("data"), overlaySnapshot)
        let syntaxes = [
            PrimitiveClassParser().parse(arrayStream.consumeAll<Token>("data"), arraySnapshot),
            PrimitiveClassParser().parse(charsStream.consumeAll<Token>("data"), charsSnapshot),
            canonical.mergedWith(overlay)
        ]
        let units = PrimitiveClassPartitionBinder().bind(syntaxes).typeUnits()
        let string = units.firstOrNull({ _.identity.name == "String" })
        expect(string.functionUnits().firstOrNull({ _.name == "trimStart" }).returnType.value())
            .toBe(string.semanticType.value())
    }

