package flat/semantic/binding/primitive

import flat/compiler/models
import flat/parser/flat
import flat/bound
import flat/lexer/Lexer
import flat/semantic/types
import flat/io/File
import flat/io/FileReader

testable class {
    async test `publishes inferred member result before reverse-ordered consumer`() {
        let consumerSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:inferred-consumer"), "one")
        let ownerSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:inferred-owner"), "one")
        let consumerStream = Lexer().lex(
            "class Reader { visible Int current; check(Array<Int> values, Int value) -> Bool { " +
            "while (value > 0 && values.contains(value)) { value--; } return true; } }"
        )
        consumerStream.emit("start")
        let consumer = PrimitiveClassParser().parse(
            consumerStream.consumeAll<Token>("data"), consumerSnapshot
        )
        let ownerStream = Lexer().lex(
            "class Array<E> { public contains(E value) => value != null }"
        )
        ownerStream.emit("start")
        let owner = PrimitiveClassParser().parse(ownerStream.consumeAll<Token>("data"), ownerSnapshot)
        let check = consumer.methodValues().firstOrNull({ _.name == "check" })
        expect(check.statements().first.statementKind()).toBe("while")
        let statement = check.statements().first
        let whileValue = (PrimitiveWhileSyntax)statement
        let condition = whileValue.condition
        expect(condition.expressionKind()).toBe("binary")
        let binary = (PrimitiveBinarySyntax)condition
        let right = binary.right
        expect(right.expressionKind()).toBe("member-call")
        let call = (PrimitiveMemberCallSyntax)right
        expect(call.memberName).toBe("contains")
        expect(call.receiver.expressionKind()).toBe("reference")
        let forward = PrimitiveClassPartitionBinder().bind([owner, consumer]).typeUnits()
        expect(forward.firstOrNull({ _.identity.name == "Reader" }).functionUnits()
            .firstOrNull({ _.name == "check" }).returnType.value())
            .toBe(SemanticTypes.boolType().value())
        let bound = PrimitiveClassPartitionBinder().bind([consumer, owner]).typeUnits()
        expect(bound.firstOrNull({ _.identity.name == "Reader" }).functionUnits()
            .firstOrNull({ _.name == "check" }).returnType.value())
            .toBe(SemanticTypes.boolType().value())
    }

    async test `published inferred result of another source feeds typed array`() {
        let ownerSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:published-result-owner"), "one")
        let readerSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:published-result-reader"), "one")
        let ownerStream = Lexer().lex("class Owner { public Int value => 1 public read() => value }")
        ownerStream.emit("start")
        let readerStream = Lexer().lex("class Reader { public collect(Owner owner) -> Int[] { let values = Int[]; values.add(owner.read()); return values; } }")
        readerStream.emit("start")
        let owner = PrimitiveClassParser().parse(ownerStream.consumeAll<Token>("data"), ownerSnapshot)
        let reader = PrimitiveClassParser().parse(readerStream.consumeAll<Token>("data"), readerSnapshot)
        let bound = PrimitiveClassPartitionBinder().bind([reader, owner]).typeUnits()
        expect(bound.firstOrNull({ _.identity.name == "Reader" }).functionUnits()
            .firstOrNull({ _.name == "collect" }).name).toBe("collect")
    }

    async test `nested published metadata resolves its declared location`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:metadata-location"), "one")
        let classStream = Lexer().lex("class Metadata { visible String location; }")
        classStream.emit("start")
        let errorStream = Lexer().lex("class Problem { visible Metadata class; public matches(Problem e, Metadata expected) -> Bool { return e.class.location == expected.location; } }")
        errorStream.emit("start")
        let ownerSyntax = PrimitiveClassParser().parse(classStream.consumeAll<Token>("data"), snapshot)
        let consumerSyntax = PrimitiveClassParser().parse(errorStream.consumeAll<Token>("data"), snapshot)
        let bound = PrimitiveClassPartitionBinder().bind([consumerSyntax, ownerSyntax], snapshot).typeUnits()
        expect(bound.firstOrNull({ _.identity.name == "Problem" }).functionUnits()
            .firstOrNull({ _.name == "matches" }).returnType.value())
            .toBe(SemanticTypes.boolType().value())
    }

    async test `parses nested catch metadata access`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:catch-access-shape"), "one")
        let stream = Lexer().lex("class Exception { construct() {} public matches(Class expected) -> Bool { try { throw this; } catch (Exception e) { if (e.class.location == expected.location) { return true; } } return false; } }")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let selected = syntax.methodValues().firstOrNull({ _.name == "matches" })
        let statements = selected.statements()
        let attemptObject = (Object)statements.first
        let attempt = (PrimitiveTrySyntax)attemptObject
        let catchStatements = attempt.catchValues().first.statements()
        let conditionObject = (Object)catchStatements.first
        let condition = (PrimitiveIfSyntax)conditionObject
        let comparison = (PrimitiveBinarySyntax)condition.condition
        expect(comparison.left.expressionKind()).toBe("member-access")
        let access = (PrimitiveMemberAccessSyntax)comparison.left
        expect(access.memberName).toBe("location")
        expect(access.receiver.expressionKind()).toBe("member-access")
        let inner = (PrimitiveMemberAccessSyntax)access.receiver
        expect(inner.memberName).toBe("class")
        expect(inner.receiver.expressionKind()).toBe("reference")
        let reference = (PrimitiveReferenceSyntax)inner.receiver
        expect(reference.name).toBe("e")
        expect(inner.range.startTokenIndex < access.range.startTokenIndex).toBe(false)
        expect(inner.range.endTokenIndex < access.range.endTokenIndex).toBe(true)
        expect(inner.range.startTokenIndex).toBe(31)
        expect(access.range.startTokenIndex).toBe(31)
    }

    async test `parsed static catch uses source owned metadata location`() {
        let classSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:catch-metadata-class"), "one")
        let exceptionSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:catch-metadata-binding"), "one")
        let classStream = Lexer().lex("class Class { construct(visible String location) {} }")
        classStream.emit("start")
        let exceptionStream = Lexer().lex("class Exception { construct() {} public static matches(Class expected) -> Bool { try { throw Exception(); } catch (Exception e) { if (e.class.location == expected.location) { return true; } } return false; } }")
        exceptionStream.emit("start")
        let classSyntax = PrimitiveClassParser().parse(classStream.consumeAll<Token>("data"), classSnapshot)
        let exceptionSyntax = PrimitiveClassParser().parse(exceptionStream.consumeAll<Token>("data"), exceptionSnapshot)
        let units = PrimitiveClassPartitionBinder().bind([exceptionSyntax, classSyntax]).typeUnits()
        let boundException = units.firstOrNull({ _.identity.name == "Exception" })
        let boundMatch = boundException.functionUnits().firstOrNull({ _.name == "matches" })
        expect(boundMatch.returnType.value()).toBe(SemanticTypes.boolType().value())
        expect(boundMatch.statements().count > 0).toBe(true)
    }

