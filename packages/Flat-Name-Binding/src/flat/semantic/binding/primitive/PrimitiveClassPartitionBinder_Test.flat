    async test `publishes inferred indexed storage accessors to consumers`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:inferred-accessor-consumer"), "one")
        let first = Lexer().lex("class Items { Int[] data; this[Int index] <=> data[index]\n}")
        first.emit("start")
