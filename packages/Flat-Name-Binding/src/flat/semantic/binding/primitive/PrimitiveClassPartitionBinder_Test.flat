        let firstStatements = first.statements()
        var BoundReturnStatement returned
        returned = (BoundReturnStatement)firstStatements.first
        var BoundConditionalExpression conditional
        conditional = (BoundConditionalExpression)returned.value
        var BoundCallExpression getter
        getter = (BoundCallExpression)conditional.whenTrue
        expect(getter.receiver.semanticType.kind()).toBe("generic-instance")
        expect(getter.target.receiverType().value()).toBe(getter.receiver.semanticType.value())
        expect(getter.semanticType.kind()).toBe("generic-parameter")
    }

    async test `namespace imports select distinct Widget identities without renaming syntax`() {
        let leftSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:alpha/Widget"), "one")
        let rightSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:beta/Widget"), "one")
        let useSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:consumer/Use"), "one")
        let snapshots = [leftSnapshot, rightSnapshot, useSnapshot]
        let sources = ["class Widget { construct() {} }", "class Widget { construct() {} }",
            "class Use { run() -> Widget { return Widget(); } }"]
        let syntaxes = PrimitiveClassSyntax[]
        var Int index
        for (source in sources) {
            let stream = Lexer().lex(source)
            stream.emit("start")
            syntaxes.add(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshots[index]))
            index++
        }
        let imports = [PrimitiveBindingImport("beta/Widget", syntaxes.last.range)]
        let contexts = [PrimitiveSourceBindingContext("alpha", leftSnapshot, [syntaxes[0]]),
            PrimitiveSourceBindingContext("beta", rightSnapshot, [syntaxes[1]]),
            PrimitiveSourceBindingContext("consumer", useSnapshot, [syntaxes[2]], importValues: imports)]
        let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
        let used = units.firstOrNull({ _.identity.name == "Use" })
        let target = units.firstOrNull({ _.identity.syntaxIdentity.snapshot == rightSnapshot })
        let method = used.functionUnits().firstOrNull({ _.name == "run" })
        expect(method.returnType.value()).toBe(target.semanticType.value())
        let body = method.statements()
        var BoundReturnStatement returned
        returned = (BoundReturnStatement)body.first
        var BoundCallExpression call
        call = (BoundCallExpression)returned.value
        expect(call.target.ownerType.value()).toBe(target.semanticType.value())
        let reversed = PrimitiveClassPartitionBinder().bindContexts(contexts.reverse()).typeUnits()
        expect(reversed.map({ _.identity.value })).toBe(units.map({ _.identity.value }))
        expect(syntaxes[0].name).toBe("Widget")
        expect(syntaxes[1].name).toBe("Widget")
        let conflictImports = [PrimitiveBindingImport("beta/Widget", syntaxes.last.range),
            PrimitiveBindingImport("alpha/Widget", syntaxes.last.range)]
        let conflicting = PrimitiveSourceBindingContext("consumer", useSnapshot, [syntaxes[2]],
            importValues: conflictImports)
        let conflictContexts = PrimitiveSourceBindingContext[]
        conflictContexts.add(contexts[0])
        conflictContexts.add(contexts[1])
        conflictContexts.add(conflicting)
        var PrimitiveContextBindingException failure
        try { PrimitiveClassPartitionBinder().bindContexts(conflictContexts) }
        catch (PrimitiveContextBindingException error) { failure = error }
        if (!failure) throw Exception("Conflicting imports accepted")
        expect(failure.diagnostic.code).toBe("binding.import-ambiguous")
        expect(failure.diagnostic.range).toBe(syntaxes.last.range)
        let candidates = failure.diagnostic.candidateValues
        failure = null
        try { PrimitiveClassPartitionBinder().bindContexts(conflictContexts.reverse()) }
        catch (PrimitiveContextBindingException error) { failure = error }
        expect(failure.diagnostic.candidateValues).toBe(candidates)
        expect(candidates.count).toBe(2)
        expect(syntaxes[1].range.snapshot).toBe(rightSnapshot)
    }

