    async test `declared field access retains explicit receiver and owner visibility`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:explicit-field-owner"), "one")
        let ownerStream = Lexer().lex("class Storage { visible Int value; Int secret; construct() { value = 7; secret = 9; } }")
        ownerStream.emit("start")
        let owner = PrimitiveClassParser().parse(ownerStream.consumeAll<Token>("data"), snapshot)
        let readerStream = Lexer().lex("class Reader { visible Int value; read(Storage other) -> Int { return other.value; } }")
        readerStream.emit("start")
        let reader = PrimitiveClassParser().parse(readerStream.consumeAll<Token>("data"), snapshot)
        let units = PrimitiveClassPartitionBinder().bind([reader, owner], snapshot).typeUnits()
        let read = units.firstOrNull({ _.identity.name == "Reader" }).functionUnits().firstOrNull({ _.name == "read" })
        let body = read.statements()
        let returnedObject = (Object)body.first
        let returned = (BoundReturnStatement)returnedObject
        let accessObject = (Object)returned.value
        let access = (BoundMemberAccessExpression)accessObject
        expect(access.receiver.semanticType.value()).toBe(units.firstOrNull({ _.identity.name == "Storage" }).semanticType.value())
        expect(access.semanticType.value()).toBe(SemanticTypes.intType().value())
        let invalidStream = Lexer().lex("class Reader { read(Storage other) -> Int { return other.secret; } }")
        invalidStream.emit("start")
        let invalid = PrimitiveClassParser().parse(invalidStream.consumeAll<Token>("data"), snapshot)
        var String failure
        try { PrimitiveClassPartitionBinder().bind([invalid, owner], snapshot) }
        catch (Exception error) { failure = error.message }
        expect(failure.contains("not visible")).toBe(true)
    }

