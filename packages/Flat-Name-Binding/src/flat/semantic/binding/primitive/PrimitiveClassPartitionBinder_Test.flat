    async test `generic fluent call uses inferred same-owner receiver`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:generic-fluent"), "one")
        let stream = Lexer().lex("class Bag<E> { construct() {} public clone() => Bag<E>() public plusEquals(E[] values) -> Bag<E> { return Bag<E>(); } public plus(E[] other) => clone().plusEquals(other) }")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let clone = syntax.methodValues().firstOrNull({ _.name == "clone" })
        expect(clone.statements().first.statementKind()).toBe("return")
        expect(clone.inferredReturnType).toBe(true)
        let isolatedStream = Lexer().lex("class Bag<E> { construct() {} public clone() => Bag<E>() }")
        isolatedStream.emit("start")
        let isolatedSyntax = PrimitiveClassParser().parse(isolatedStream.consumeAll<Token>("data"), snapshot)
        let isolated = PrimitiveClassPartitionBinder().bind([isolatedSyntax], snapshot).typeUnits().first
        expect(isolated.functionUnits().firstOrNull({ _.name == "clone" }).returnType.kind())
            .toBe("generic-instance")
        let bound = PrimitiveClassPartitionBinder().bind([syntax], snapshot).typeUnits().first
        expect(bound.functionUnits().firstOrNull({ _.name == "plus" }).returnType.kind())
            .toBe("generic-instance")
    }

