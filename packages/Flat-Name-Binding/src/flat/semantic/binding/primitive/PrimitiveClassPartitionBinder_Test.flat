    async test `concrete Int join operands use canonical static text conversion once`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:int-range-text"), "one")
        let stream = Lexer().lex("trait PlusOperator<In, Out> { public plus(In another) -> Out }")
        stream.emit("start")
        let contract = PrimitiveInterfaceParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let contexts = [PrimitiveSourceBindingContext("flat/operators", snapshot, PrimitiveClassSyntax[], [contract])]
        let sources = [
            "class String implements PlusOperator<String, String> { public construct(native String text) {} public plus(String another) -> String { return this; } }",
            "class Int { public static toString(Int value) -> String { return \"number\"; } }",
            "class IntRange { public join(Int value, String delimiter) -> String { var str = \"\"; str += value + delimiter; str += delimiter + value; return str; } }"
        ]
        let namespaces = ["flat", "flat/primitive/number", "flat/datastruct/list"]
        var Int index
        for (source in sources) {
            let tokens = Lexer().lex(source)
            tokens.emit("start")
            let syntax = PrimitiveClassParser().parse(tokens.consumeAll<Token>("data"), snapshot)
            contexts.add(PrimitiveSourceBindingContext(namespaces[index++], snapshot, [syntax],
                importValues: [PrimitiveBindingImport("flat/operators/PlusOperator", syntax.range)]))
        }
        let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
        let intType = units.firstOrNull({ _.identity.name == "Int" }).semanticType
        let stringType = units.firstOrNull({ _.identity.name == "String" }).semanticType
        let method = units.firstOrNull({ _.identity.name == "IntRange" }).functionUnits().firstOrNull({ _.name == "join" })
        let statements = method.statements()
        let syntaxStatements = contexts.last.classValues().first.methodValues().first.statements()
        for (position in 1..3) {
            Object assignmentSource = statements[position]
            BoundAssignmentStatement assignment = (BoundAssignmentStatement)assignmentSource
            Object outerSource = assignment.value
            BoundCallExpression outer = (BoundCallExpression)outerSource
            Object innerSource = outer.argumentValues().first
            BoundCallExpression inner = (BoundCallExpression)innerSource
            expect(outer.target.name).toBe("plus")
            expect(inner.target.name).toBe("plus")
            expect(inner.target.ownerType.value()).toBe(stringType.value())
            Object convertedSource = position == 1 ? inner.receiver : inner.argumentValues().first
            BoundCallExpression converted = (BoundCallExpression)convertedSource
            expect(converted.target.name).toBe("toString")
            expect(converted.target.callableKind.value).toBe("static-method")
            expect(converted.target.ownerType.value()).toBe(intType.value())
            expect(converted.semanticType.value()).toBe(stringType.value())
            expect(converted.receiver == null).toBe(true)
            let arguments = converted.argumentValues()
            expect(arguments.count).toBe(1)
            expect(arguments.first.semanticType.value()).toBe(SemanticTypes.intType().value())
            expect(arguments.first.expressionKind()).toBe("reference")
            expect(converted.range.startTokenIndex).toBe(arguments.first.range.startTokenIndex)
            expect(converted.range.endTokenIndex).toBe(arguments.first.range.endTokenIndex)
            expect(assignment.range.startTokenIndex).toBe(syntaxStatements[position].range.startTokenIndex)
            expect(assignment.range.endTokenIndex).toBe(syntaxStatements[position].range.endTokenIndex)
        }
    }

    async test `Int text conversion requires unique canonical declaration and exact signature`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:int-text-evidence"), "one")
        let operatorStream = Lexer().lex("trait PlusOperator<In, Out> { public plus(In another) -> Out }")
        operatorStream.emit("start")
        let contract = PrimitiveInterfaceParser().parse(operatorStream.consumeAll<Token>("data"), snapshot)
        let stringStream = Lexer().lex("class String implements PlusOperator<String, String> {}")
        stringStream.emit("start")
        let stringSyntax = PrimitiveClassParser().parse(stringStream.consumeAll<Token>("data"), snapshot)
        let intStream = Lexer().lex("class Int {}")
        intStream.emit("start")
        let intSyntax = PrimitiveClassParser().parse(intStream.consumeAll<Token>("data"), snapshot)
        let operatorSource = PrimitiveSourceBindingContext("flat/operators", snapshot, PrimitiveClassSyntax[], [contract])
        let stringSource = PrimitiveSourceBindingContext("flat", snapshot, [stringSyntax],
            importValues: [PrimitiveBindingImport("flat/operators/PlusOperator", stringSyntax.range)])
        let intSource = PrimitiveSourceBindingContext("flat/primitive/number", snapshot, [intSyntax])
        let duplicateSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:int-text-competing-owner"), "one")
        let duplicateStream = Lexer().lex("class Int {}")
        duplicateStream.emit("start")
        let duplicateSyntax = PrimitiveClassParser().parse(duplicateStream.consumeAll<Token>("data"), duplicateSnapshot)
        let duplicateIntSource = PrimitiveSourceBindingContext("flat/primitive/number", duplicateSnapshot, [duplicateSyntax])
        let base = [operatorSource, stringSource]
        let complete = [operatorSource, stringSource, intSource]
        let scope = PrimitiveResolvedDeclarationContext(stringSource, complete)
        let stringType = UserClassSemanticType(scope.classIdentity(stringSyntax))
        let intType = UserClassSemanticType(scope.classIdentity(intSyntax))
        let plus = CallableSignature(SymbolIdentity(stringType.declarationIdentity, "plus"), "plus",
            CallableKind("instance-method"), [stringType], stringType, stringType)
        let scalar = BoundLiteralExpression(intSyntax.range, SemanticTypes.intType(), "7")
        let text = BoundLiteralExpression(stringSyntax.range, stringType, "text")
        for (mode in 0..9) {
            let inputs = PrimitiveSourceBindingContext[]
            if (mode == 0) inputs.addAll(base)
            else if (mode == 1) {
                inputs.add(operatorSource)
                inputs.add(stringSource)
                inputs.add(intSource)
                inputs.add(duplicateIntSource)
            } else inputs.addAll(complete)
            let context = PrimitiveResolvedDeclarationContext(stringSource, inputs)
            let owner = mode == 2 ? stringType : intType
            let parameter = mode == 3 ? SemanticTypes.longType() : SemanticTypes.intType()
            let result = mode == 4 ? SemanticTypes.stringType() : stringType
            let kind = mode == 5 ? "instance-method" : "static-method"
            let target = CallableSignature(SymbolIdentity(owner.declarationIdentity, "toString"), "toString",
                CallableKind(kind), [parameter], result, owner, optionalParameterCount: mode == 6 ? 1 : 0)
            let callables = CallableSignature[]
            callables.add(plus)
            if (mode != 8) callables.add(target)
            if (mode == 7) callables.add(target)
            var Bool rejected
            try { PrimitiveStringAdapter.plus(scalar, text, context, callables, null) }
            catch (Exception error) { rejected = true }
            if (!rejected) throw Exception("Int text conversion accepted invalid canonical evidence mode #mode")
        }
        var Bool nullableRejected
        let nullable = BoundLiteralExpression(intSyntax.range, NullableSemanticType(SemanticTypes.intType()), "null")
        let target = CallableSignature(SymbolIdentity(intType.declarationIdentity, "toString"), "toString",
            CallableKind("static-method"), [SemanticTypes.intType()], stringType, intType)
        try { PrimitiveStringAdapter.plus(nullable, text, scope, [plus, target], null) }
        catch (Exception error) { nullableRejected = true }
        expect(nullableRejected).toBe(true)
    }

