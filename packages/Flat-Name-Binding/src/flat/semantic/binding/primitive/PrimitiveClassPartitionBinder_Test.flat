        catch (Exception error) { failure = error.message }
        if (!failure) throw Exception("Shadow scalar declaration acquired native receiver authority")
        expect(failure.contains("toFixed")).toBe(true)
    }

    async test `same name casts in canonical numeric classes select primitive projection`() {
        let targets = ["Double", "Float", "Long", "Int", "Short", "Byte", "Char"]
        for (target in targets) {
            let scalarSource = "class #{target} { public construct(public #{target} value) {} public convert(Object other) -> #{target} { return (#{target})other; } }"
            let sources = ["class Object { construct() {} }",
                "class Number { construct() {} visible Double realValue => 0.0\n }",
                scalarSource]
            let contexts = PrimitiveSourceBindingContext[]
            for (index in 0..sources.count) {
                let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:self-numeric-cast:#{target}:#{index}"), "one")
                let stream = Lexer().lex(sources[index])
                stream.emit("start")
                let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
                contexts.add(PrimitiveSourceBindingContext(index == 0 ? "flat" : "flat/primitive/number", snapshot, [syntax]))
            }
            let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
            let owner = units.firstOrNull({ _.identity.name == target })
            let method = owner.functionUnits().firstOrNull({ _.name == "convert" })
            let methodStatements = method.statements()
            Object returnedSource = methodStatements.first
            BoundReturnStatement returned = (BoundReturnStatement)returnedSource
            Object valueObject = returned.value
            BoundNumericUnboxExpression unbox = (BoundNumericUnboxExpression)valueObject
            expect(unbox.semanticType.value()).toBe("primitive:#target")
            expect(unbox.projection.name).toBe("realValue")
            expect(unbox.projectionConversion.toType.value()).toBe("primitive:#target")
        }
    }

    async test `mixed canonical text equality selects declared equals in both orders`() {
        let expressions = ["value == \"true\"", "\"true\" == value", "value != \"true\"", "\"true\" != value"]
        for (index in 0..expressions.count) {
            let sources = ["class String { public construct(native String text) {} public equals(String other) -> Bool { return true; } }",
                "class Caller { public static read(String value) -> Bool { return " + expressions[index] + "; } }"]
            let contexts = PrimitiveSourceBindingContext[]
            for (sourceIndex in 0..sources.count) {
                let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:mixed-equality:#{index}:#{sourceIndex}"), "one")
                let stream = Lexer().lex(sources[sourceIndex])
                stream.emit("start")
                let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
                contexts.add(PrimitiveSourceBindingContext("flat", snapshot, [syntax]))
            }
            let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
            let owner = units.firstOrNull({ _.identity.name == "String" })
            let method = units.firstOrNull({ _.identity.name == "Caller" }).functionUnits().firstOrNull({ _.name == "read" })
            let statement = method.statements().first
            let returned = (BoundReturnStatement)statement
            var BoundExpression result = returned.value
            var BoundCallExpression retainedAdaptation
            var BoundReferenceExpression retainedParameter
            if (index == 1 || index == 3) {
                Object evaluationSource = result
                BoundEvaluationExpression evaluation = (BoundEvaluationExpression)evaluationSource
                let setup = evaluation.setup()
                expect(setup.count).toBe(2)
                Object leftSource = setup.first
                BoundLocalDeclarationStatement left = (BoundLocalDeclarationStatement)leftSource
                Object adaptedSource = left.initializer
                retainedAdaptation = (BoundCallExpression)adaptedSource
                Object rightSource = setup.last
                BoundLocalDeclarationStatement right = (BoundLocalDeclarationStatement)rightSource
                Object parameterSource = right.initializer
                retainedParameter = (BoundReferenceExpression)parameterSource
                result = evaluation.value
            }
            if (index >= 2) {
                let negation = (BoundUnaryExpression)result
                expect(negation.operator).toBe("!")
                result = negation.operand
            }
            let call = (BoundCallExpression)result
            expect(call.target.name).toBe("equals")
            expect(call.target.ownerType.declarationIdentity.value).toBe(owner.identity.value)
            expect(call.target.parameterTypes().first.value()).toBe(owner.semanticType.value())
            let parameter = retainedParameter ?: (BoundReferenceExpression)call.receiver
            expect(parameter.symbolIdentity.value).toBe(method.parameterValues().first.identity.value)
            let argument = call.argumentValues().first
            let adapted = retainedAdaptation ?: (BoundCallExpression)argument
            expect(adapted.target.callableKind.value).toBe("constructor")
            expect(adapted.target.parameterTypes().first.value()).toBe(SemanticTypes.stringType().value())
            expect(adapted.argumentValues().count).toBe(1)
        }
    }

    async test `mixed text equality rejects missing canonical evidence and unsafe operands`() {
        let declarations = [
            "class String { public construct(native String text) {} public equals(String other) -> Bool { return true; } }",
            "class String { public equals(String other) -> Bool { return true; } }",
            "class String { public construct(native String text) {} }"
        ]
        for (index in 0..5) {
            let expression = index == 3 ? "value == 1" : "value == \"true\""
            let parameterType = index == 4 ? "String value = null" : "String value"
            let sources = [declarations[index == 1 ? 1 : index == 2 ? 2 : 0],
                "class Caller { read(" + parameterType + ") -> Bool { return " + expression + "; } }"]
            let contexts = PrimitiveSourceBindingContext[]
            for (sourceIndex in 0..sources.count) {
                let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:mixed-equality-negative:#{index}:#{sourceIndex}"), "one")
                let stream = Lexer().lex(sources[sourceIndex])
                stream.emit("start")
                let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
                contexts.add(PrimitiveSourceBindingContext(index == 0 ? "app" : "flat", snapshot, [syntax]))
            }
            var Bool rejected = false
            try { PrimitiveClassPartitionBinder().bindContexts(contexts) }
            catch (Exception error) { rejected = true }
            expect(rejected).toBe(true)
        }
    }
    async test `generic owner lexical static lazy getter is a collection receiver before type lookup`() {
        let sources = [
            "class Entry { construct(visible Int code) {} } class Array<E> { filter(func(E)->Bool predicate) -> E { return null; } } class Owner<T> { visible static lazy Entry[] VALUES => null\n read(Int wanted) -> Entry { return VALUES.filter({ _.code == wanted }); } shadow(Entry[] VALUES) -> Entry[] { return VALUES; } }",
            "class Entry { construct(visible Int code) {} } class Array<E> { filter(func(E)->Bool predicate) -> E { return null; } } class Owner<T> { visible static lazy Entry[] VALUES => null\n read(Int wanted) -> Entry { return MISSING.filter({ _.code == wanted }); } }"
        ]
        for (index in 0..sources.count) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:lexical-static:#{index}"), "one")
            let stream = Lexer().lex(sources[index])
            stream.emit("start")
            let partitions = FlatSourceTypePartitioner().partition(stream.consumeAll<Token>("data"), snapshot)
            let classes = PrimitiveClassSyntax[]
            for (partition in partitions) classes.add(PrimitiveClassParser().parse(
                partition.tokenValues(), snapshot, partition.startTokenIndex))
            let context = PrimitiveSourceBindingContext("app", snapshot, classes)
            if (index == 0) {
                let owner = PrimitiveClassPartitionBinder().bindContexts([context]).typeUnits().firstOrNull({ _.identity.name == "Owner" })
                let read = owner.functionUnits().firstOrNull({ _.name == "read" })
                let readStatement = read.statements().first
                let statement = (BoundReturnStatement)readStatement
                let filterValue = statement.value
                let filter = (BoundCallExpression)filterValue
                let getterValue = filter.receiver
                let getter = (BoundCallExpression)getterValue
                let callbackValue = filter.argumentValues().first
                let callback = (BoundLambdaExpression)callbackValue
                expect(callback.captureValues().first.name).toBe("wanted")
                expect(getter.target.identity.declaration.name).toBe("VALUES")
                expect(getter.target.ownerType.declarationIdentity.value).toBe(owner.identity.value)
                expect(getter.target.callableKind.value).toBe("static-method")
                let shadow = owner.functionUnits().firstOrNull({ _.name == "shadow" })
                let shadowStatement = shadow.statements().first
                let returned = (BoundReturnStatement)shadowStatement
                expect(returned.value.expressionKind()).toBe("reference")
            } else {
                var Bool rejected = false
                try { PrimitiveClassPartitionBinder().bindContexts([context]) }
                catch (Exception error) { rejected = error.message.contains("MISSING") }
                expect(rejected).toBe(true)
            }
        }
    }
    async test `source scoped implicit root metadata call retains hierarchy conversions`() {
        let sources = [
            "class Object { public static referenceEquals(Object one, Object two) -> Bool { return true; } }",
            "class Class<Type> { read(Class other) -> Bool { var current = this; while (current) { if (Object.referenceEquals(current, other)) { return true; } return false; } return false; } }",
            "class Owner { read() -> Bool { return Object.referenceEquals(Class.class, Class<Int>()); } }"
        ]
        for (order in 0..2) {
            let contexts = PrimitiveSourceBindingContext[]
            for (index in 0..sources.count) {
                let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:implicit-root:#{index}"), "one")
                let stream = Lexer().lex(sources[index])
                stream.emit("start")
                let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
                contexts.add(PrimitiveSourceBindingContext("app", snapshot, [syntax]))
            }
            let units = PrimitiveClassPartitionBinder().bindContexts(order == 0 ? contexts : contexts.reverse()).typeUnits()
            let root = units.firstOrNull({ _.identity.name == "Object" })
            let metadata = units.firstOrNull({ _.identity.name == "Class" })
            expect(metadata.parentType.value()).toBe(root.semanticType.value())
            expect(units.count).toBe(3)
        }
    }

