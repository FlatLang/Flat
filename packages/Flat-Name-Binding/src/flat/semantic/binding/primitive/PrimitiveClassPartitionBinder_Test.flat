    async test `nested collection add awaits inferred same-owner removal overload`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:nested-removal-overload"), "one")
        let stream = Lexer().lex(
            "class Bag<E> { visible native_array var E[] data; this[Int index] <=> data[index] " +
            "public E first => data[0] " +
            "public collect() -> E[] { let removed = E[]; " +
            "for (var Int i = 2; i >= 0; i--) { removed.add(take(i)); } return removed; } " +
            "public take(Int index) => take(index, 1).first " +
            "public take(Int index, Int count) -> Bag<E> { return Bag<E>(); } construct() {} }"
