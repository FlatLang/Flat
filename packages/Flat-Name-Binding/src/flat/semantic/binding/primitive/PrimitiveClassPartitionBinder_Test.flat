    async test `explicit storage and visible constructor parameter share field identity`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:matching-explicit-storage"), "one")
        let stream = Lexer().lex("class Meta { visible String location; construct(visible String location) {} }")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let bound = PrimitiveClassPartitionBinder().bind([syntax]).typeUnits().first
        expect(bound.fieldUnits().filter({ _.name == "location" }).count).toBe(1)
        expect(bound.fieldUnits().first.name).toBe("location")
    }

    async test `mismatched explicit storage and constructor parameter is rejected`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:mismatched-explicit-storage"), "one")
        let stream = Lexer().lex("class Meta { visible Int location; construct(visible String location) {} }")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        var String message
        try { PrimitiveClassPartitionBinder().bind([syntax]) }
        catch (Exception error) { message = error.message }
        expect(message).toBe("Constructor parameter conflicts with field 'location'")
    }

    async test `native array null constructor default has nullable parameter type`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:nullable-native-default"), "one")
        let stream = Lexer().lex("class Meta { construct(visible Int[] values = null) {} }")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let bound = PrimitiveClassPartitionBinder().bind([syntax]).typeUnits().first
        let parameter = bound.functionUnits().first.parameterValues().first
        expect(parameter.semanticType.kind()).toBe("nullable")
        expect(bound.fieldUnits().first.semanticType.value()).toBe(parameter.semanticType.value())
    }

