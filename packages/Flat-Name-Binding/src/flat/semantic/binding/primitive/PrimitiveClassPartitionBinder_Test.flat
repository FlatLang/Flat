    async test `namespace import admits two types and diagnoses colliding explicit type`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:namespace-import"), "one")
        let sources = ["class First { construct() {} }", "class Second { construct() {} }",
            "class First { construct() {} }", "class Use { run(First a, Second b) -> First { return a; } }"]
        let syntaxes = PrimitiveClassSyntax[]
        var Int offset
        for (source in sources) {
            let stream = Lexer().lex(source)
            stream.emit("start")
            syntaxes.add(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot, offset))
            offset += 100
        }
        let contexts = [PrimitiveSourceBindingContext("library", snapshot, [syntaxes[0], syntaxes[1]]),
            PrimitiveSourceBindingContext("other", snapshot, [syntaxes[2]]),
            PrimitiveSourceBindingContext("consumer", snapshot, [syntaxes[3]],
                importValues: [PrimitiveBindingImport("library", syntaxes[3].range)])]
        let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
        let method = units.firstOrNull({ _.identity.name == "Use" }).functionUnits().firstOrNull({ _.name == "run" })
        expect(method.returnType.value()).toBe(units.first.semanticType.value())
        let conflicting = PrimitiveSourceBindingContext("consumer", snapshot, [syntaxes[3]],
            importValues: [PrimitiveBindingImport("library", syntaxes[3].range),
                PrimitiveBindingImport("other/First", syntaxes[3].range)])
        let conflicts = PrimitiveSourceBindingContext[]
        conflicts.add(contexts[0])
        conflicts.add(contexts[1])
        conflicts.add(conflicting)
        var PrimitiveContextBindingException failure
        try { PrimitiveClassPartitionBinder().bindContexts(conflicts) }
        catch (PrimitiveContextBindingException error) { failure = error }
        if (!failure) throw Exception("Namespace collision accepted")
        expect(failure.diagnostic.code).toBe("binding.import-ambiguous")
        expect(failure.diagnostic.range).toBe(syntaxes[3].range)
        expect(failure.diagnostic.candidateValues.count).toBe(2)
    }

    async test `retains declared collection result through namespace binding`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:declared-array-execution"), "compiler-input")
        let source = "class Array<E> { visible Int count; construct(Int count, Int capacity = count) { this.count = count; } } " +
            "class Box { static make<Out>(Int size) -> Out[] { return Array<Out>(size); } " +
            "static run() -> Int { return Box.make<Int>(3).count; } }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let partitions = FlatSourceTypePartitioner().partition(stream.consumeAll<Token>("data"), snapshot)
        let syntaxes = PrimitiveClassSyntax[]
        for (partition in partitions) syntaxes.add(PrimitiveClassParser().parse(
            partition.tokenValues(), snapshot, partition.startTokenIndex))
        let context = PrimitiveSourceBindingContext("", snapshot, syntaxes)
        let units = PrimitiveClassPartitionBinder().bindContexts([context]).typeUnits()
        let legacy = PrimitiveClassPartitionBinder().bind(syntaxes).typeUnits()
        let results = [units, legacy]
        for (bound in results) {
            let array = bound.first
            let box = bound.last
            let method = box.functionUnits().firstOrNull({ _.name == "make" })
            expect(method.returnType.kind()).toBe("generic-instance")
            let body = method.statements()
            var BoundReturnStatement returned
            returned = (BoundReturnStatement)body.first
            var BoundCallExpression construction
            construction = (BoundCallExpression)returned.value
            expect(construction.expressionKind()).toBe("call")
            expect(construction.target.callableKind.value).toBe("constructor")
            expect(construction.target.ownerType.value()).toBe(array.semanticType.value())
            expect(construction.target.returnType.value()).toBe(method.returnType.value())
            expect(construction.target.optionalParameterCount).toBe(1)
            expect(construction.argumentValues().count).toBe(1)
            let run = box.functionUnits().firstOrNull({ _.name == "run" })
            let runBody = run.statements()
            var BoundReturnStatement runReturn
            runReturn = (BoundReturnStatement)runBody.first
            var BoundMemberAccessExpression field
            field = (BoundMemberAccessExpression)runReturn.value
            expect(field.expressionKind()).toBe("member-access")
            expect(field.memberIdentity.value).toBe(array.fieldUnits().first.identity.value)
            expect(field.receiver.semanticType.kind()).toBe("generic-instance")
        }
    }

