        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:partition-invalid"), "one")
        var Int rejected
        try {
            PrimitiveClassPartitionBinder().bind([
                PrimitiveClassParser().parse(typeTokens("Child", "Missing", "2"), snapshot)
            ], snapshot)
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(1)
    }

    test `missing parent diagnostic identifies dependency edge`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:partition-missing-edge"), "one"
        )
        var String message
        try {
            PrimitiveClassPartitionBinder().bind([
                PrimitiveClassParser().parse(
                    typeTokens("Child", "Missing", "2"), snapshot
                )
            ], snapshot)
        } catch (Exception error) { message = error.message }
        expect(message).toBe("Missing or cyclic reduced parent for Child->Missing")
    }

    test `duplicate type fails`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:partition-duplicate"), "one")
        var Int rejected
        try {
            PrimitiveClassPartitionBinder().bind([
                PrimitiveClassParser().parse(typeTokens("Same", null, "1"), snapshot),
                PrimitiveClassParser().parse(typeTokens("Same", null, "2"), snapshot)
            ], snapshot)
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(1)
    }

    test `binds deterministic three level ancestry`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:partition-ancestry"), "one")
        let leaf = PrimitiveClassParser().parse(typeTokens("Leaf", "Middle", "3"), snapshot)
        let middle = PrimitiveClassParser().parse(typeTokens("Middle", "Root", "2"), snapshot)
        let root = PrimitiveClassParser().parse(typeTokens("Root", null, "1"), snapshot)
        let types = PrimitiveClassPartitionBinder().bind([leaf, root, middle], snapshot).typeUnits()

        expect(types.map({ _.identity.name })).toBe(["Root", "Middle", "Leaf"])
        expect(types.last.parentType.value()).toBe(types[1].semanticType.value())
        expect(types[1].parentType.value()).toBe(types.first.semanticType.value())
    }

    test `cycle fails`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:partition-cycle"), "one")
        var Int rejected
        try {
            PrimitiveClassPartitionBinder().bind([
                PrimitiveClassParser().parse(typeTokens("One", "Two", "1"), snapshot),
                PrimitiveClassParser().parse(typeTokens("Two", "One", "2"), snapshot)
            ], snapshot)
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(1)
    }

    emptyTypeTokens(String name) -> Token[] {
        return [
            token("class", false), token(name, false), token("{", true),
            token("}", true)
        ]
    }

    typeWithParameter(String name) -> Token[] {
        return [
            token("class", false), token(name, false), token("{", true),
            token("construct", false), token("(", true), token("Int", false),
            token("value", false), token(")", true), token("{", true),
            token("}", true), token("}", true)
        ]
    }

    typeTokens(String name, String parent, String returned) -> Token[] {
        let values = [token("class", false), token(name, false)]
        if (parent) values.addAll([token("extends", false), token(parent, false)])
        values.addAll([
            token("{", true), token("constructor", false), token("(", true), token(")", true),
            token("{", true), token("}", true), token("value", false), token("(", true),
            token(")", true), token("->", true), token("Int", false), token("{", true),
            token("return", false), token(returned, false, Token.Type.INTEGER),
            token(";", true), token("}", true), token("}", true)
        ])
        return values
    }

    token(String value, Bool symbol, Int type = Token.Type.IDENTIFIER) -> Token => Token(
        value: value, type: symbol ? Token.Type.SYMBOL : type,
        location: Location(lineNumber: 1, column: 1)
    )
}
