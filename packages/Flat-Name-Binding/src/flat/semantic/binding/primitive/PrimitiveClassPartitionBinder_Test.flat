    async test `preserves method generic scope in sized array initializer`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:generic-array-local"), "one")
        let stream = Lexer().lex("class Box { static make<Out>(Int size) -> Out[] { " +
            "let values = Array<Out>(size); return values; } }")
