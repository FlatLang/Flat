    async test `readiness preserves inherited generic parameter and callback scope`() {
        let sources = [
            "class Holder<E> { public read() -> Int => 1 }",
            "trait Items<Type> { public inspect(Holder<Type> value) -> Int => value.read() public apply<Out>(Holder<Type> value, f(Holder<Type> x) -> Out) -> Out => f(value) public callback(Holder<Type> value) -> Int { return apply(value, { _.read() }); } }",
            "class Range implements Items<Int> {}"]
        let paths = ["memory:a/Holder", "memory:b/Items", "memory:c/Range"]
        let contexts = PrimitiveSourceBindingContext[]
        var Int index
        for (source in sources) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity(paths[index]), "one")
            let stream = Lexer().lex(source)
            stream.emit("start")
            let tokens = stream.consumeAll<Token>("data")
            if (index == 1) {
                let contract = PrimitiveInterfaceParser().parse(tokens, snapshot)
                contexts.add(PrimitiveSourceBindingContext("flat", snapshot, PrimitiveClassSyntax[], [contract]))
            } else {
                let syntax = PrimitiveClassParser().parse(tokens, snapshot)
                contexts.add(PrimitiveSourceBindingContext("flat", snapshot, [syntax]))
            }
            index++
        }
        admitCallbackScalar(contexts, "Int")
        let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
        let range = units.firstOrNull({ _.identity.name == "Range" })
        expect(range.functionUnits().firstOrNull({ _.name == "inspect" }).returnType.value())
            .toBe(SemanticTypes.intType().value())
        expect(range.functionUnits().firstOrNull({ _.name == "callback" }).returnType.value())
            .toBe(SemanticTypes.intType().value())
        let reversed = PrimitiveClassPartitionBinder().bindContexts(contexts.reverse()).typeUnits()
        expect(reversed.firstOrNull({ _.identity.name == "Range" }).functionUnits()
            .firstOrNull({ _.name == "callback" }).returnType.value()).toBe(SemanticTypes.intType().value())
    }

    async test `callback inference waits for reverse ordered primitive static result`() {
        let sources = [
            "class Range { public map<Out>(callback(Int value) -> Out) -> Out => callback(1) public render(Bool format, String tab) => map({ _.encode(format, tab) }) public shadow(String _) => map({ _.encode(false, \"x\") }) }",
            "class Int { public static encode(Int value, Bool format = false, String tab = \"x\") => toString(value) public static toString(Int value) => Long.toString(value) }",
            "class Long { public static toString(Long value) -> String => \"ok\" }"]
        let paths = ["memory:a/Range", "memory:z/Int", "memory:zz/Long"]
        let contexts = PrimitiveSourceBindingContext[]
        var Int index
        for (source in sources) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity(paths[index++]), "one")
            let stream = Lexer().lex(source)
            stream.emit("start")
            let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
            contexts.add(PrimitiveSourceBindingContext("flat", snapshot, [syntax]))
        }
        let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
        let range = units.firstOrNull({ _.identity.name == "Range" })
        expect(range.functionUnits().firstOrNull({ _.name == "render" }).returnType.value())
            .toBe(SemanticTypes.stringType().value())
        expect(range.functionUnits().firstOrNull({ _.name == "shadow" }).returnType.value())
            .toBe(SemanticTypes.stringType().value())
        let reversed = PrimitiveClassPartitionBinder().bindContexts(contexts.reverse()).typeUnits()
        expect(reversed.firstOrNull({ _.identity.name == "Range" }).functionUnits()
            .firstOrNull({ _.name == "shadow" }).returnType.value()).toBe(SemanticTypes.stringType().value())
        expect(reversed.firstOrNull({ _.identity.name == "Range" }).functionUnits()
            .firstOrNull({ _.name == "render" }).returnType.value()).toBe(SemanticTypes.stringType().value())
    }

