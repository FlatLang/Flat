    async test `named String overload selects source owned method across snapshots`() {
        let ownerSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:named-string-owner"), "one")
        let readerSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:named-string-reader"), "one")
        let ownerStream = Lexer().lex("class String { visible native String data; public construct(native String nativeText) { data = nativeText; } public lastIndexOf(Char search, Int defaultReturnValue = -1) -> Int { return 1; } public lastIndexOf(String search, Int defaultReturnValue = -1) -> Int { return 2; } }")
        ownerStream.emit("start")
        let readerStream = Lexer().lex("class Reader { construct(visible String location) {} read() -> Int { return location.lastIndexOf(\"/\", defaultReturnValue: 0); } }")
        readerStream.emit("start")
        let owner = PrimitiveClassParser().parse(ownerStream.consumeAll<Token>("data"), ownerSnapshot)
        let reader = PrimitiveClassParser().parse(readerStream.consumeAll<Token>("data"), readerSnapshot)
        let types = PrimitiveClassPartitionBinder().bindContexts([
            PrimitiveSourceBindingContext("flat", readerSnapshot, [reader]),
            PrimitiveSourceBindingContext("flat", ownerSnapshot, [owner])
        ]).typeUnits()
        let read = types.firstOrNull({ _.identity.name == "Reader" }).functionUnits()
            .firstOrNull({ _.name == "read" })
        expect(read.returnType.value()).toBe(SemanticTypes.intType().value())
        let readStatements = read.statements()
        let returnedObject = (Object)readStatements.first
        let returned = (BoundReturnStatement)returnedObject
        let callObject = (Object)returned.value
        let call = (BoundCallExpression)callObject
        let arguments = call.argumentValues()
        let wrappedObject = (Object)arguments.first
        let wrapped = (BoundCallExpression)wrappedObject
        expect(wrapped.target.callableKind.value).toBe("constructor")
        expect(wrapped.target.ownerType.declarationIdentity.syntaxIdentity.snapshot).toBe(ownerSnapshot)
    }

