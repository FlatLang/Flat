    async test `inferred text contracts are contextual across arbitrary overrides and forward calls`() {
        let parentSource = "class Object { public toJson() => \"base\" public label() => \"base\" public forward() => label() }"
        var String childSource = "class String extends Object { visible Int code = 1; public construct(native String text) {} "
        childSource += "override public toJson() -> String { return \"child\"; } override public label() => \"code: "
        childSource += '#'
        childSource += "code\" public forwarded() => label() }"
        let parentSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:inferred-parent"), "one")
        let childSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:inferred-child"), "one")
        let parentStream = Lexer().lex(parentSource)
        parentStream.emit("start")
        let parent = PrimitiveClassParser().parse(parentStream.consumeAll<Token>("data"), parentSnapshot)
        let childStream = Lexer().lex(childSource)
        childStream.emit("start")
        let child = PrimitiveClassParser().parse(childStream.consumeAll<Token>("data"), childSnapshot)
        let units = PrimitiveClassPartitionBinder().bindContexts([
            PrimitiveSourceBindingContext("flat", parentSnapshot, [parent]),
            PrimitiveSourceBindingContext("flat", childSnapshot, [child])
        ]).typeUnits()
        let owner = units.firstOrNull({ _.identity.name == "Object" })
        let string = units.firstOrNull({ _.identity.name == "String" })
        let names = ["toJson", "label", "forward"]
        for (name in names) {
            let method = owner.functionUnits().firstOrNull({ _.name == name })
            expect(method.returnType.value()).toBe(string.semanticType.value())
        }
        let methods = owner.functionUnits()
        let statements = methods.firstOrNull({ _.name == "label" }).statements()
        let returnedObject = (Object)statements.first
        let returned = (BoundReturnStatement)returnedObject
        expect(returned.value.expressionKind()).toBe("call")
        let wrapObject = (Object)returned.value
        let wrap = (BoundCallExpression)wrapObject
        expect(wrap.target.callableKind.value).toBe("constructor")
        let arguments = wrap.argumentValues()
        expect(arguments.count).toBe(1)
        expect(arguments.first.semanticType.value()).toBe(SemanticTypes.stringType().value())
    }

    async test `arbitrary signatures distinguish declared String from native parameters`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:declared-native-signatures"), "one")
        let sources = ["class String { public construct(native String text) {} }",
            "class Holder { public construct(visible native String raw, visible String text) {} " +
            "public echo(String value) -> String { return value; } public nativeInput(native String value) -> Int { " +
            "native var String raw = value; var String declared = value; return 1; } }"]
        let syntaxes = PrimitiveClassSyntax[]
        var Int offset
        for (source in sources) {
            let stream = Lexer().lex(source)
            stream.emit("start")
            syntaxes.add(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot, offset))
            offset += 100
        }
        let units = PrimitiveClassPartitionBinder().bindContexts([
            PrimitiveSourceBindingContext("flat", snapshot, syntaxes)
        ]).typeUnits()
        let string = units.firstOrNull({ _.identity.name == "String" })
        let holder = units.firstOrNull({ _.identity.name == "Holder" })
        let echo = holder.functionUnits().firstOrNull({ _.name == "echo" })
        expect(echo.returnType.value()).toBe(string.semanticType.value())
        expect(echo.parameterValues().first.semanticType.value()).toBe(string.semanticType.value())
        let nativeMethod = holder.functionUnits().firstOrNull({ _.name == "nativeInput" })
        expect(nativeMethod.parameterValues().first.semanticType.value()).toBe(SemanticTypes.stringType().value())
        let nativeStatements = nativeMethod.statements()
        let rawObject = (Object)nativeStatements.first
        let declaredObject = (Object)nativeStatements[1]
        let rawLocal = (BoundLocalDeclarationStatement)rawObject
        let declaredLocal = (BoundLocalDeclarationStatement)declaredObject
        expect(rawLocal.initializer.semanticType.value()).toBe(SemanticTypes.stringType().value())
        expect(declaredLocal.initializer.semanticType.value()).toBe(string.semanticType.value())
        expect(declaredLocal.initializer.expressionKind()).toBe("call")
        let constructor = string.functionUnits().firstOrNull({ _.constructorFunction })
        expect(constructor.parameterValues().first.semanticType.value()).toBe(SemanticTypes.stringType().value())
        let rawField = holder.fieldUnits().firstOrNull({ _.name == "raw" })
        let textField = holder.fieldUnits().firstOrNull({ _.name == "text" })
        expect(rawField.semanticType.value()).toBe(SemanticTypes.stringType().value())
        expect(textField.semanticType.value()).toBe(string.semanticType.value())
    }

    async test `canonical String toString preserves Object declared text contract`() {
        let parentSnapshot = SourceSnapshotIdentity(SourceIdentity("flat/Object.flat"), "compiler-input")
        let snapshot = SourceSnapshotIdentity(SourceIdentity("flat/String.flat"), "compiler-input")
        let parentStream = Lexer().lex("class Object { public construct() {} public toString() -> String => \"Object\" }")
        parentStream.emit("start")
