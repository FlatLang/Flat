    }

    async test `explicit null fallback does not make primitive or unit contracts nullable`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:value-null-fallback"), "one")
        let stream = Lexer().lex("read() -> Int => null { return 1; }")
        stream.emit("start")
        let parsed = PrimitiveFunctionParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let method = parsed.functionValues().first
        let resolver = PrimitiveStructuralTypeResolver()
        let integerResult = resolver.fallbackResultType(method, SemanticTypes.intType())
        let booleanResult = resolver.fallbackResultType(method, SemanticTypes.boolType())
        let unitResult = resolver.fallbackResultType(method, SemanticTypes.unitType())
        expect(integerResult.kind()).toBe("primitive")
        expect(booleanResult.kind()).toBe("primitive")
        expect(unitResult.kind()).toBe("unit")
    }
