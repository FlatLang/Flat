    async test `native returns preserve published body and parameter representations and canonical String construction`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:native-return-binding"), "one")
        let sources = [
            "class Array<T> { construct() {} }",
            "class String { visible native String data; construct(native String text) { data = text; } construct(native_array Char[] chars) {} public native text() -> String { return data; } }",
            "class Bridge { visible native_array Char[] data; native_array read(Char[] ordinary) -> Char[] { return data; } native_array forward(Char[] ordinary) -> Char[] { return read(ordinary); } inferred(Char[] ordinary) => read(ordinary)\n wrapArray(Char[] ordinary) -> String { return String(read(ordinary)); } ordinary(native_array Char[] nativeInput, Char[] ordinaryInput) -> Char[] { return ordinaryInput; } wrap(native String text) -> String { return String(text); } }"
        ]
        let syntaxes = PrimitiveClassSyntax[]
        for (source in sources) {
            let stream = Lexer().lex(source)
            stream.emit("start")
            syntaxes.add(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot))
        }
        let program = PrimitiveClassPartitionBinder().bindContexts([PrimitiveSourceBindingContext("flat", snapshot, syntaxes)])
        let bridge = program.typeUnits().firstOrNull({ _.identity.name == "Bridge" })
        let nativeRead = bridge.functionUnits().firstOrNull({ _.name == "read" })
        let forward = bridge.functionUnits().firstOrNull({ _.name == "forward" })
        if (forward.returnType.kind() != "array") throw Exception("Published native return representation was lost")
        let inferred = bridge.functionUnits().firstOrNull({ _.name == "inferred" })
        if (inferred.returnType.kind() != "array") throw Exception("Inferred call erased native return representation")
        let arrayWrapper = bridge.functionUnits().firstOrNull({ _.name == "wrapArray" })
        let arrayWrapperStatements = arrayWrapper.statements()
        let arrayReturnObject = (Object)arrayWrapperStatements.first
        let arrayReturn = (BoundReturnStatement)arrayReturnObject
        let arrayCallObject = (Object)arrayReturn.value
        let arrayCall = (BoundCallExpression)arrayCallObject
        if (arrayCall.target.parameterTypes().first.kind() != "array") throw Exception("Native array String constructor not selected")
        let ordinary = bridge.functionUnits().firstOrNull({ _.name == "ordinary" })
        if (nativeRead.returnType.kind() != "array") throw Exception("Native return was not a host array")
        if (nativeRead.parameterValues().first.semanticType.kind() != "generic-instance") throw Exception("Return modifier leaked to parameter")
        if (ordinary.returnType.kind() != "generic-instance") throw Exception("Ordinary array return lost canonical representation")
        if (ordinary.parameterValues().first.semanticType.kind() != "array") throw Exception("Native parameter lost representation")
        let text = program.typeUnits().firstOrNull({ _.identity.name == "String" }).functionUnits().firstOrNull({ _.name == "text" })
        if (text.returnType.kind() != "string") throw Exception("Native scalar String return lost representation")
        let wrappedTextMethod = bridge.functionUnits().firstOrNull({ _.name == "wrap" })
        let wrappedTextStatements = wrappedTextMethod.statements()
        let statementObject = (Object)wrappedTextStatements.first
        let returned = (BoundReturnStatement)statementObject
        let callObject = (Object)returned.value
        let call = (BoundCallExpression)callObject
        if (call.target.callableKind.value != "constructor" || call.target.parameterTypes().first.kind() != "string") throw Exception("Canonical String native constructor not selected")
    }

    async test `partition numeric unboxing root authority does not follow Object basename`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:partition-impostor"), "one")
        let stream = Lexer().lex("class Object { construct() {} public convert(Object other) -> Double { return (Double)other; } }")
        stream.emit("start")
        let impostor = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let otherSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:partition-canonical"), "one")
        let rootStream = Lexer().lex("class Object { construct() {} }")
        rootStream.emit("start")
        let canonical = PrimitiveClassParser().parse(rootStream.consumeAll<Token>("data"), otherSnapshot)
        let contexts = [PrimitiveSourceBindingContext("impostor", snapshot, [impostor]),
            PrimitiveSourceBindingContext("flat", otherSnapshot, [canonical])]
        for (mode in 0..3) {
            let inputs = PrimitiveSourceBindingContext[]
            if (mode == 0) inputs.add(contexts.first)
            else inputs.addAll(mode == 1 ? contexts : contexts.reverse())
            var String failure
            try { PrimitiveClassPartitionBinder().bindContexts(inputs) }
            catch (Exception error) { failure = error.message }
            if (!failure) throw Exception("Impostor Object acquired numeric unboxing authority")
            expect(failure.contains("Invalid reduced cast")).toBe(true)
        }
    }
    async test `numeric family casts retain resolved projection and explicit target conversion`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:numeric-family"), "compiler-input")
        let numberStream = Lexer().lex("class Number { construct() {} visible Double realValue => 0.0\n } ")
        numberStream.emit("start")
        let number = PrimitiveClassParser().parse(numberStream.consumeAll<Token>("data"), snapshot)
        let numberContext = PrimitiveSourceBindingContext("flat/primitive/number", snapshot, [number])
        let targets = ["Double", "Float", "Long", "Int", "Short", "Byte", "Char"]
        for (target in targets) {
            let sourceSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:numeric-cast:#{target}"), "compiler-input")
            let sourceText = "class Object { construct() {} public convert(Object other) -> #{target} { return (#{target})other; } }"
            let stream = Lexer().lex(sourceText)
            stream.emit("start")
            let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), sourceSnapshot)
            let context = PrimitiveSourceBindingContext("flat", sourceSnapshot, [syntax])
            let completionOrders = [false, true]
            for (reversed in completionOrders) {
                let inputs = PrimitiveSourceBindingContext[]
                if (reversed) {
                    inputs.add(numberContext)
                    inputs.add(context)
                } else {
                    inputs.add(context)
                    inputs.add(numberContext)
                }
                let program = PrimitiveClassPartitionBinder().bindContexts(inputs)
                let unit = program.typeUnits().firstOrNull({ _.identity.name == "Object" })
                let method = unit.functionUnits().firstOrNull({ _.name == "convert" })
                let statement = method.statements().first
                Object returnedSource = statement
                BoundReturnStatement returned = (BoundReturnStatement)returnedSource
                let valueObject = (Object)returned.value
                BoundNumericUnboxExpression unbox = (BoundNumericUnboxExpression)valueObject
                expect(unbox.expressionKind()).toBe("numeric-unbox")
                expect(unbox.projection.name).toBe("realValue")
                expect(unbox.numberType.declarationIdentity.value).toBe(unbox.projection.ownerType.declarationIdentity.value)
                expect(unbox.projectionConversion.conversionKind).toBe(target == "Double" ? "identity" : "numeric-cast")
                expect(unbox.projectionConversion.fromType.value()).toBe("primitive:Double")
                expect(unbox.projectionConversion.toType.value()).toBe("primitive:#target")
                expect(unbox.conversion.fromType.value()).toBe(unbox.value.semanticType.value())
                expect(unbox.range.snapshot).toBe(sourceSnapshot)
            }
        }
    }
    async test `native numeric receiver boxes once through canonical storage constructor`() {
        let sources = [
            "class Double { public construct(public Double value) {} public toFixed(Int precision = 1) -> Int { return precision; } }",
            "class Double { public construct(public Double value) {} public toFixed(Int precision) -> Int { return 99; } }",
            "class Caller { public read(Double current) -> Int { return current.toFixed(1); } public omitted(Double current) -> Int { return current.toFixed(); } public named(Double current) -> Int { return current.toFixed(precision: 1); } }"
        ]
        let namespaces = ["flat/primitive/number", "shadow", "app"]
        let contexts = PrimitiveSourceBindingContext[]
        for (index in 0..sources.count) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:native-toFixed:#index"), "one")
            let stream = Lexer().lex(sources[index])
            stream.emit("start")
            let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
            contexts.add(PrimitiveSourceBindingContext(namespaces[index], snapshot, [syntax]))
        }
        let completionOrders = [false, true]
        for (reversed in completionOrders) {
            let inputs = reversed ? contexts.reverse() : contexts
            let program = PrimitiveClassPartitionBinder().bindContexts(inputs)
            let units = program.typeUnits()
            let caller = units.firstOrNull({ _.identity.name == "Caller" })
            let canonical = units.firstOrNull({ _.range.snapshot == contexts.first.snapshot })
            let callNames = ["read", "omitted", "named"]
            for (name in callNames) {
                let method = caller.functionUnits().firstOrNull({ _.name == name })
                let methodStatements = method.statements()
                Object returnedSource = methodStatements.first
                BoundReturnStatement returned = (BoundReturnStatement)returnedSource
                Object callObject = returned.value
                BoundCallExpression call = (BoundCallExpression)callObject
                expect(call.target.ownerType.value()).toBe(canonical.semanticType.value())
                expect(call.target.name).toBe("toFixed")
                let boxedObject = (Object)call.receiver
                BoundCallExpression boxed = (BoundCallExpression)boxedObject
                expect(boxed.target.callableKind.value).toBe("constructor")
                expect(boxed.target.ownerType.value()).toBe(canonical.semanticType.value())
                expect(boxed.argumentValues().count).toBe(1)
                expect(boxed.argumentValues().first.expressionKind()).toBe("reference")
                expect(boxed.argumentConversions().first.conversionKind).toBe("identity")
                if (name != "named") expect(call.receiverConversion.conversionKind).toBe("identity")
                expect(call.target.optionalParameterCount).toBe(1)
            }
        }
    }

    async test `numeric unboxing rejects missing and impostor projection evidence`() {
        let sources = ["class Object { construct() {} public read(Object value) -> Int { return (Int)value; } }",
            "class Number { construct() {} visible Double realValue => 0.0\n }",
            "class Number { construct() {} visible Int realValue => 0\n }"]
        for (mode in 0..3) {
            let contexts = PrimitiveSourceBindingContext[]
            for (index in 0..2) {
                let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:invalid-numeric-projection:#{mode}:#{index}"), "one")
                let sourceIndex = index == 0 ? 0 : (mode == 2 ? 2 : 1)
                let stream = Lexer().lex(sources[sourceIndex])
                stream.emit("start")
                let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
                if (index == 0 || mode != 0) {
                    let namespaceName = index == 0 ? "flat" : (mode == 1 ? "impostor" : "flat/primitive/number")
                    contexts.add(PrimitiveSourceBindingContext(namespaceName, snapshot, [syntax]))
                }
            }
            var String failure
            try { PrimitiveClassPartitionBinder().bindContexts(contexts) }
            catch (Exception error) { failure = error.message }
            if (!failure) throw Exception("Unproven numeric projection was accepted")
            expect(failure.contains(mode == 2 ? "Number.realValue" : "canonical Number")).toBe(true)
        }
    }

    async test `native receiver rejects shadow only scalar declaration`() {
        let sources = ["class Double { public construct(public Double value) {} public toFixed(Int precision) -> Int { return precision; } }",
            "class Caller { public read(Double current) -> Int { return current.toFixed(1); } }"]
