        expect(childUnit.parentType.value()).toBe(parentUnit.semanticType.value())
    }

    async test `namespace context retains copied ownership and overlay member provenance`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:context-owner"), "one")
        let overlaySnapshot = SourceSnapshotIdentity(SourceIdentity("memory:context-overlay"), "one")
        let stream = Lexer().lex("class Widget { construct() {} }")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let overlayStream = Lexer().lex("class Widget { public value() -> Int { return 1; } }")
        overlayStream.emit("start")
        let overlay = PrimitiveClassParser().parse(overlayStream.consumeAll<Token>("data"), overlaySnapshot)
        let merged = syntax.mergedWith(overlay)
        let classes = [merged]
        let context = PrimitiveSourceBindingContext("alpha", snapshot, classes)
        classes.clear()
        let copied = context.classValues()
        copied.clear()
        expect(context.classValues().count).toBe(1)
        expect(merged.range.snapshot).toBe(snapshot)
        expect(merged.methodValues().first.range.snapshot).toBe(overlaySnapshot)
        let units = PrimitiveClassPartitionBinder().bindContexts([context]).typeUnits()
        let method = units.first.functionUnits().firstOrNull({ _.name == "value" })
        expect(method.range.snapshot).toBe(overlaySnapshot)
        var String capacityFailure
        try { PrimitiveClassPartitionBinder().bindContexts([context], maxContexts: 0) }
        catch (Exception error) { capacityFailure = error.message }
        if (!capacityFailure) throw Exception("Invalid context capacity accepted")
    }

    async test `namespace static and alias imports reject actual metadata ranges`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:unsupported-import"), "one")
        let stream = Lexer().lex("class Use { construct() {} }")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let imports = [PrimitiveBindingImport("other/Widget", syntax.range, staticImport: true),
            PrimitiveBindingImport("other/Widget", syntax.range, alias: "Renamed")]
        let expected = ["binding.import-static-unsupported", "binding.import-alias-unsupported"]
        var Int index
        for (value in imports) {
            let context = PrimitiveSourceBindingContext("consumer", snapshot, [syntax], importValues: [value])
            var PrimitiveContextBindingException failure
            try { PrimitiveClassPartitionBinder().bindContexts([context]) }
            catch (PrimitiveContextBindingException error) { failure = error }
            if (!failure) throw Exception("Unsupported import accepted")
            expect(failure.diagnostic.code).toBe(expected[index])
            expect(failure.diagnostic.range).toBe(value.range)
            index++
        }
    }

    async test `generic mapNotNull body binds callback arguments and owner this`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:generic-map-not-null"), "one")
        let source = "class Array<E> { visible Int count; visible native_array var E[] data; " +
            "construct() {} this[Int index] <=> data[index] " +
            "public iterator() -> Cursor<E> { return Cursor<E>(); } " +
            "public add(E value) -> Bool { return true; } " +
            "public mapNotNull<Out>(mapFunc(E x, Int i, Array<E> array) -> Out) -> Array<Out> { " +
            "let array = Array<Out>(); var Int i = 0; for (element in this) { " +
            "let value = mapFunc(element, i++, this); if (value != null) { array.add(value); } } return array; } }"
        let syntaxes = PrimitiveClassSyntax[]
        let sources = [source, "class Cursor<E> { construct() {} public hasNext() => false public stepNext() -> E { return value; } visible E value }"]
        for (text in sources) {
            let stream = Lexer().lex(text)
            stream.emit("start")
            syntaxes.add(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot))
        }
        let types = PrimitiveClassPartitionBinder().bind(syntaxes, snapshot).typeUnits()
        let method = types.first.functionUnits().firstOrNull({ _.name == "mapNotNull" })
        expect(method.returnType.kind()).toBe("generic-instance")
    }

