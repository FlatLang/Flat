    async test `text adapters preserve ordinary overloads optional arity and one argument evaluation`() {
        let calls = ["this.pick(\"x\")", "this.pick(\"x\", marker: 0)",
            "this.consume(this.make())", "this?.consume(this.make())"]
        var Int index
        for (invocation in calls) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:scalar-adapter-#index"), "one")
            let stream = Lexer().lex("class String { visible native String data; " +
                "public construct(native String text) { data = text; } " +
                "pick(String text, Int marker = 0) -> Int { return 1; } " +
                "pick(Object text, Int marker = 0) -> Int { return 2; } " +
                "make() => \"value\"\n" +
                "consume(String text, Int marker = 0) -> Int { return 3; } " +
                "read() => " + invocation + " }")
            stream.emit("start")
            let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
            let unit = PrimitiveClassPartitionBinder().bindContexts([
                PrimitiveSourceBindingContext("flat", snapshot, [syntax])
            ]).typeUnits().first
            let read = unit.functionUnits().firstOrNull({ _.name == "read" })
            let readStatements = read.statements()
            let returnedObject = (Object)readStatements.first
            let returned = (BoundReturnStatement)returnedObject
            let callObject = (Object)returned.value
            let call = (BoundCallExpression)callObject
            if (index < 2) {
                expect(call.target.parameterTypes().first.value()).toBe(SemanticTypes.objectType().value())
                expect(call.argumentValues().first.expressionKind()).toBe("literal")
            } else {
                let arguments = call.argumentValues()
                let originalObject = (Object)arguments.first
                let original = (BoundCallExpression)originalObject
                expect(original.target.callableKind.value).toBe("instance-method")
                expect(original.target.name).toBe("make")
                expect(original.semanticType.value()).toBe(unit.semanticType.value())
                expect(original.argumentValues().count).toBe(0)
                expect(call.safeAccess).toBe(index == 3)
                if (index == 3) expect(call.semanticType.kind()).toBe("nullable")
            }
            index++
        }
    }

    async test `scalar text adaptation rejects absent and noncanonical constructors`() {
        let spaces = ["flat", "other"]
        for (space in spaces) {
            let constructors = ["", "public construct(native String text) {}"]
            for (constructor in constructors) {
                if (space == "flat" && constructor.isNotEmpty) continue
                let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:scalar-adapter-rejected-#space"), "one")
                let stream = Lexer().lex("class String { " + constructor +
                    " consume(String text) -> Int { return 1; } read() -> Int { return this.consume(\"x\"); } }")
                stream.emit("start")
                let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
                var Bool rejected
                try {
                    PrimitiveClassPartitionBinder().bindContexts([
                        PrimitiveSourceBindingContext(space, snapshot, [syntax])
                    ])
                } catch (Exception error) { rejected = error.message.contains("No overload") }
                expect(rejected).toBe(true)
            }
        }
    }

    async test `constructor arguments adapt canonical native text per candidate`() {
        let sources = ["class String { public construct(native String text) {} }",
            "class Failure { public construct(visible String message, visible Int code = 0) {} }",
            "class Caller { public make(native String text) -> Failure { return Failure(text); } }"]
        let contexts = PrimitiveSourceBindingContext[]
        var Int index
        for (source in sources) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:constructor-adapter-#index"), "one")
            let stream = Lexer().lex(source)
            stream.emit("start")
            let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
            contexts.add(PrimitiveSourceBindingContext("flat", snapshot, [syntax]))
            index++
        }
        let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
        let method = units.firstOrNull({ _.identity.name == "Caller" }).functionUnits().firstOrNull({ _.name == "make" })
        let statements = method.statements()
        let returnedObject = (Object)statements.first
        let returned = (BoundReturnStatement)returnedObject
        let callObject = (Object)returned.value
        let call = (BoundCallExpression)callObject
        expect(call.target.ownerType.declarationIdentity.name).toBe("Failure")
        expect(call.argumentValues().count).toBe(1)
        let suppliedArguments = call.argumentValues()
        let wrappedObject = (Object)suppliedArguments.first
        let wrapped = (BoundCallExpression)wrappedObject
        expect(wrapped.target.ownerType.declarationIdentity.name).toBe("String")
        expect(wrapped.target.callableKind.value).toBe("constructor")
        expect(wrapped.argumentValues().first.expressionKind()).toBe("reference")
    }

    async test `constructor text adaptation rejects wrong types and noncanonical declarations`() {
        let spaces = ["flat", "other", "flat"]
        var Int caseIndex
        for (space in spaces) {
            let argumentType = caseIndex == 2 ? "Int" : "native String"
            let sources = ["class String { public construct(native String text) {} }",
                "class Failure { public construct(visible String message) {} }",
                "class Caller { public make(#argumentType text) -> Failure { return Failure(text); } }"]
            let contexts = PrimitiveSourceBindingContext[]
            var Int index
            for (source in sources) {
                let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:constructor-reject-#caseIndex-#index"), "one")
                let stream = Lexer().lex(source)
                stream.emit("start")
                let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
                contexts.add(PrimitiveSourceBindingContext(space, snapshot, [syntax]))
                index++
            }
            var Bool rejected
            try {
                if (caseIndex == 0) {
                    let missing = contexts.first
                    let stream = Lexer().lex("class String {}")
                    stream.emit("start")
                    let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), missing.snapshot)
                    contexts[0] = PrimitiveSourceBindingContext(space, missing.snapshot, [syntax])
                }
                PrimitiveClassPartitionBinder().bindContexts(contexts)
            } catch (Exception error) {
                rejected = error.message.contains("No overload")
            }
            expect(rejected).toBe(true)
            caseIndex++
        }
    }

    async test `inferred declared conditional joins null without unwrapping`() {
        let bodies = ["(let s = indexOf(before, start)) >= 0 && (let e = indexOf(after, s + 1)) > 0 ? substring(s, e) : null",
            "start > 0 ? null : substring(start, start)", "start > 0 ? substring(start, start) : this"]
        for (body in bodies) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:nullable-text-conditional"), "one")
            let stream = Lexer().lex("class String { indexOf(String text, Int start) -> Int { return 1; } " +
                "substring(Int start, Int end) -> this { return this; } " +
                "public forward(String before, String after) => getStringBetween(before, after) " +
                "public getStringBetween(String before, String after, Int start = 0) => " + body + " }")
            stream.emit("start")
            let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
            let units = PrimitiveClassPartitionBinder().bindContexts([
                PrimitiveSourceBindingContext("flat", snapshot, [syntax])
            ]).typeUnits()
            let unit = units.first
            let method = unit.functionUnits().firstOrNull({ _.name == "getStringBetween" })
            let expected = body.contains("null") ? NullableSemanticType(unit.semanticType) : unit.semanticType
            expect(method.returnType.value()).toBe(expected.value())
            let forward = unit.functionUnits().firstOrNull({ _.name == "forward" })
            expect(forward.returnType.value()).toBe(expected.value())
            let statements = method.statements()
            let returnedObject = (Object)statements.last
            let returned = (BoundReturnStatement)returnedObject
            expect(returned.value.semanticType.value()).toBe(expected.value())
        }
    }

