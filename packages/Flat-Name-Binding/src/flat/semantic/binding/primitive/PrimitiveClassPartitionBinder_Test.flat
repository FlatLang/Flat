    async test `unresolved member on call result fails instead of using owner field`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:unresolved-call-member"), "one")
        let stream = Lexer().lex("class Bag { visible Int first; public other() -> Int { return 1; } public read() => other().first }")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        var String failure
        try { PrimitiveClassPartitionBinder().bind([syntax], snapshot) }
        catch (Exception error) { failure = error.message }
        if (!failure) throw Exception("Unresolved call-result member accepted as owner field")
        let readSyntax = syntax.methodValues().firstOrNull({ _.name == "read" })
        Object syntaxReturnSource = readSyntax.statements().first
        PrimitiveReturnSyntax syntaxReturn = (PrimitiveReturnSyntax)syntaxReturnSource
        let accessToken = syntaxReturn.value.range.startTokenIndex
        expect(failure.contains("Unknown member 'first' on '#{SemanticTypes.intType().value()}' at #accessToken")).toBe(true)
    }

