            SourceIdentity("memory:map-parallel-signature-bind"), "one"
        )
        let identity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", 0), "class", "List"
        )
        let listType = UserClassSemanticType(identity)
        let resolved = PrimitiveStructuralTypeResolver(
            callables: [CallableSignature(
                SymbolIdentity(identity, "constructor"), "List",
                CallableKind("constructor"), SemanticType[], listType, listType
            )],
            genericParameter: GenericParameterSemanticType(identity, "Type", 0)
        ).resolve("async func(Type,Int,List<Type>)->Type")

        expect(resolved.kind()).toBe("function")
        let callback = (FunctionSemanticType)resolved
        expect(callback.asyncFunction).toBe(true)
        expect(callback.parameterTypes().count).toBe(3)
        expect(callback.parameterTypes()[0].kind()).toBe("generic-parameter")
        expect(callback.parameterTypes()[1].value()).toBe(SemanticTypes.intType().value())
        let parameterTypes = callback.parameterTypes()
        let listParameter = parameterTypes[2]
        let listTypeArgument = ((GenericInstanceSemanticType)listParameter).typeArguments().first
        expect(listTypeArgument.value()).toBe(parameterTypes[0].value())
        expect(callback.returnType.value()).toBe(callback.parameterTypes()[0].value())
    }

    test `resolves nested callback before following parameter`() {
