    async test `real Core Array receiver return keeps declaration generic argument`() {
        let reader = FileReader(File("../Flat-Core/src/flat/datastruct/list/Array.flat"))
        let source = reader.readString()
        reader.close()
        let snapshot = SourceSnapshotIdentity(SourceIdentity("flat/datastruct/list/Array.flat"), "self-return-regression")
        let stream = Lexer().lexInterpolated(source)
        stream.emit("start")
        let partition = FlatSourceTypePartitioner().partition(stream.consumeAll<Token>("data"), snapshot, "js").first
        let original = PrimitiveClassParser().parse(partition.tokenValues(), snapshot, partition.startTokenIndex, "Array")
        let actual = original.methodValues().firstOrNull((method) => method.name == "plusEquals")
        expect(actual != null).toBe(true)
        expect(actual.returnTypeName).toBe("this")
        expect(actual.inferredReturnType).toBe(false)
        let actualStatements = actual.statements()
        expect(actualStatements.count).toBe(2)
        Object actualReturnSource = actualStatements.last
        PrimitiveReturnSyntax actualReturn = (PrimitiveReturnSyntax)actualReturnSource
        expect(actualReturn.value.expressionKind()).toBe("reference")
        // Retain the actual Core method and range; only its dependency is a minimal declaration scaffold.
        let ownerStream = Lexer().lex("class Array<E> { construct() {} public addAll(E[] other) -> E[] { return other; } public self() => this\npublic explicitSelf() -> this { return this; } }")
        ownerStream.emit("start")
        let ownerSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:array-self-owner"), "one")
        let owner = PrimitiveClassParser().parse(ownerStream.consumeAll<Token>("data"), ownerSnapshot)
        let methods = owner.methodValues()
        methods.add(actual)
        let array = PrimitiveClassSyntax(owner.range, owner.name, owner.genericParameterName, owner.parentName,
            owner.fieldValues(), owner.constructorValue, methods, constructorValues: owner.constructorValues())
        for (mode in 0..2) {
            let unit = mode == 0 ? PrimitiveClassBinder().bind(array, ownerSnapshot).typeUnit :
                PrimitiveClassPartitionBinder().bind([array], arrayDeclaration: array).typeUnits().first
            let names = ["plusEquals", "self", "explicitSelf"]
            for (name in names) {
                let method = unit.functionUnits().firstOrNull((function) => function.name == name)
                expect(method.returnType.kind()).toBe("generic-instance")
                let instance = (GenericInstanceSemanticType)method.returnType
                expect(instance.declarationType.value()).toBe(unit.semanticType.value())
                let typeArguments = instance.typeArguments()
                Object parameterSource = typeArguments.first
                GenericParameterSemanticType parameter = (GenericParameterSemanticType)parameterSource
                expect(parameter.ownerIdentity.value).toBe(unit.identity.value)
                expect(parameter.name).toBe("E")
                let statements = method.statements()
                Object returnSource = statements.last
                BoundReturnStatement returned = (BoundReturnStatement)returnSource
                expect(returned.value.semanticType.value()).toBe(method.returnType.value())
                expect(returned.conversion.conversionKind).toBe("identity")
                if (name == "plusEquals") {
                    expect(method.range.snapshot).toBe(actual.range.snapshot)
                    expect(method.range.startTokenIndex).toBe(actual.range.startTokenIndex)
                }
            }
            let generic = unit.functionUnits().firstOrNull((method) => method.name == "plusEquals").returnType
            expect(TypeConversions.classify(generic, unit.semanticType).applicable).toBe(false)
        }
    }

    async test `source Array removal calls await inferred overload beside declared contract`() {
        let reader = FileReader(File("../Flat-Core/src/flat/datastruct/list/Array.flat"))
        let source = reader.readString()
        reader.close()
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("flat/datastruct/list/Array.flat"), "collection-binding-regression"
        )
        let stream = Lexer().lexInterpolated(source)
        stream.emit("start")
        let partition = FlatSourceTypePartitioner().partition(
            stream.consumeAll<Token>("data"), snapshot, "js"
        ).first
        let original = PrimitiveClassParser().parse(
            partition.tokenValues(), snapshot, partition.startTokenIndex, "Array"
        )
        let removeWhere = original.methodValues().firstOrNull({ _.name == "removeWhere" })
        expect(removeWhere != null).toBe(true)
        expect(removeWhere.parameterValues().first.name).toBe("func")
        expect(removeWhere.parameterValues().first.typeName).toBe("func(E,Int,Array<E>)->Bool")
        expect(removeWhere.returnTypeName).toBe("E[]")

        // Preserve the tested bodies and ranges. The two-argument dependency is
        // declaration scaffolding: full unchanged collection execution belongs
        // to Compiler integration, not this method-readiness regression.
        let ownerStream = Lexer().lex(
            "class Array<E> { visible var Int count; visible native_array var E[] data; " +
            "this[Int index] <=> data[index] construct() {} public E first => data[0] }"
        )
        ownerStream.emit("start")
        let ownerSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:array-removal-owner"), "one")
        let owner = PrimitiveClassParser().parse(ownerStream.consumeAll<Token>("data"), ownerSnapshot)
        let methods = owner.methodValues()
        methods.add(removeWhere)
        let removalOverloads = original.methodValues().filter({ _.name == "removeAtIndex" })
        let inferredRemoval = removalOverloads.firstOrNull({ _.parameterValues().count == 1 })
        let declaredRemoval = removalOverloads.firstOrNull({ _.parameterValues().count == 2 })
        methods.add(inferredRemoval)
        methods.add(PrimitiveFunctionSyntax(
            declaredRemoval.range, declaredRemoval.name, declaredRemoval.parameterValues(),
            declaredRemoval.returnTypeName, PrimitiveStatementSyntax[]
        ))
        let array = PrimitiveClassSyntax(
            owner.range, owner.name, owner.genericParameterName, owner.parentName,
            owner.fieldValues(), owner.constructorValue, methods,
            arrayOverrideValues: owner.arrayOverrideValues(),
            constructorValues: owner.constructorValues()
        )
        let rootSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:collection-root"), "one")
        let rootStream = Lexer().lex("class Object {}")
        rootStream.emit("start")
        let root = PrimitiveClassParser().parse(rootStream.consumeAll<Token>("data"), rootSnapshot)
        for (order in 0..3) {
            let syntaxes = PrimitiveClassSyntax[]
            if (order == 1) syntaxes.add(root)
            syntaxes.add(array)
            if (order == 2) syntaxes.add(root)
            let bound = PrimitiveClassPartitionBinder().bind(syntaxes, arrayDeclaration: array)
                .typeUnits().firstOrNull({ _.identity.name == "Array" })
            let method = bound.functionUnits().firstOrNull({ _.name == "removeWhere" })
            expect(method.returnType.kind()).toBe("generic-instance")
            expect(method.range.startTokenIndex).toBe(removeWhere.range.startTokenIndex)
            let statements = method.statements()
            let returnedObject = (Object)statements[statements.count - 1]
            let returned = (BoundReturnStatement)returnedObject
            expect(returned.requiredType.value()).toBe(method.returnType.value())
            expect(returned.conversion.applicable).toBe(true)
            expect(returned.conversion.fromType.value()).toBe(returned.value.semanticType.value())
            expect(returned.conversion.toType.value()).toBe(method.returnType.value())
        }
    }

    async test `generic owner collected removed values preserve element type`() {
