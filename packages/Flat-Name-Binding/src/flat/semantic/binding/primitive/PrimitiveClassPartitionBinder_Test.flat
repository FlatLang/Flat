        let type = PrimitiveClassPartitionBinder().bind([syntax], snapshot).typeUnits().first
        expect(type.fieldUnits().first.semanticType.kind()).toBe("generic-parameter")
        expect(type.fieldUnits().last.semanticType.kind()).toBe("array")
