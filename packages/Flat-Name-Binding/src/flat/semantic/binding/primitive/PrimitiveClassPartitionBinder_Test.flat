package flat/semantic/binding/primitive

import flat/compiler/models
import flat/parser/flat
import flat/bound
import flat/lexer/Lexer
import flat/semantic/types
import flat/semantic/binding/BindingDiagnostic
import flat/io/File
import flat/io/FileReader

testable class {
    async test `map quoted generic branch infers canonical reference result`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:map-reference-join"), "one")
        let operatorStream = Lexer().lex("trait PlusOperator<In, Out> { public plus(In another) -> Out }")
        operatorStream.emit("start")
        let operator = PrimitiveInterfaceParser().parse(operatorStream.consumeAll<Token>("data"), snapshot, 100)
        let contexts = [PrimitiveSourceBindingContext("flat/operators", snapshot, PrimitiveClassSyntax[], [operator])]
        // Keep the production Array.toString callback verbatim, including metadata,
        // interpolation, named implicit parameter, null check and original E branch.
        var String quotedMapperSource = "{ _x != null && _x.class.isOfType(String.class) ? \"\\\""
        quotedMapperSource += '#'
        quotedMapperSource += "{_x}\\\"\" : _x }"
        // Keep concatenation outside the array literal for the bootstrap parser.
        let arraySource = "class Array<E> { public map<Out>(func(E x, Int i, Array<E> array) -> Out) -> Array<Out> { return new Array<Out>(); } public join(String delimiter) -> String { return \"x\"; } public mapped() -> Array<Object> { return map(" + quotedMapperSource + "); } override public toString() => \"[\" + map(" + quotedMapperSource + ").join(\", \") + \"]\" }"
        let sources = [
            "class Object { public toString() -> String { return \"x\"; } }",
            "class String implements PlusOperator<String, String> { public construct(native String text) {} public plus(String another) -> String { return this; } }",
            arraySource
        ]
        var Int index
        var PrimitiveClassSyntax arraySyntax
        for (source in sources) {
            let sourceSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:map-owner:#{index}"), "one")
            let stream = Lexer().lex(source)
            stream.emit("start")
            let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), sourceSnapshot)
            if (syntax.name == "Array") arraySyntax = syntax
            var String namespaceName = "flat"
            if (index == 2) namespaceName = "flat/datastruct/list"
            let imports = [PrimitiveBindingImport("flat/operators/PlusOperator", syntax.range),
                PrimitiveBindingImport("flat/String", syntax.range),
                PrimitiveBindingImport("flat/Object", syntax.range)]
            contexts.add(PrimitiveSourceBindingContext(namespaceName, sourceSnapshot, [syntax],
                importValues: imports))
            index++
        }
        let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
        let array = units.firstOrNull((unit) => unit.identity.name == "Array")
        let root = units.firstOrNull((unit) => unit.identity.name == "Object").semanticType
        let text = units.firstOrNull((unit) => unit.identity.name == "String").semanticType
        let method = array.functionUnits().firstOrNull((function) => function.name == "mapped")
        let statements = method.statements()
        Object returnSource = statements.first
        BoundReturnStatement returned = (BoundReturnStatement)returnSource
        Object callSource = returned.value
        BoundCallExpression call = (BoundCallExpression)callSource
        expect(call.target.name).toBe("map")
        expect(call.semanticType.kind()).toBe("generic-instance")
        let mappedType = (GenericInstanceSemanticType)call.semanticType
        expect(mappedType.declarationType.value()).toBe(array.semanticType.value())
        expect(mappedType.typeArguments().first.value()).toBe(root.value())
        expect(call.target.returnType.value()).toBe(call.semanticType.value())
        let arguments = call.argumentValues()
        Object lambdaSource = arguments.first
        BoundLambdaExpression lambda = (BoundLambdaExpression)lambdaSource
        let functionType = (FunctionSemanticType)lambda.semanticType
        expect(functionType.returnType.value()).toBe(root.value())
        expect(functionType.parameterTypes().first.kind()).toBe("generic-parameter")
        expect(functionType.parameterTypes()[2].kind()).toBe("generic-instance")
        Object conditionalSource = lambda.body
        BoundConditionalExpression conditional = (BoundConditionalExpression)conditionalSource
        Object trueSource = conditional.whenTrue
        Object falseSource = conditional.whenFalse
        BoundConversionExpression trueJoin = (BoundConversionExpression)trueSource
        BoundConversionExpression falseJoin = (BoundConversionExpression)falseSource
        expect(trueJoin.conversion.conversionKind).toBe("reference-upcast")
        expect(falseJoin.conversion.conversionKind).toBe("reference-upcast")
        expect(trueJoin.conversion.applicable && trueJoin.conversion.implicit).toBe(true)
        expect(falseJoin.conversion.applicable && falseJoin.conversion.implicit).toBe(true)
        expect(falseJoin.value.expressionKind()).toBe("reference")
        expect(falseJoin.value.semanticType.value()).toBe(functionType.parameterTypes().first.value())
        Object storageSource = trueJoin.value
        BoundCallExpression storage = (BoundCallExpression)storageSource
        expect(storage.target.callableKind.value).toBe("constructor")
        expect(storage.semanticType.value()).toBe(text.value())
        expect(storage.argumentValues().first.expressionKind()).toBe("interpolated-string")
        for (conversion in call.argumentConversions()) expect(conversion.applicable).toBe(true)
        let sourceMethod = arraySyntax.methodValues().firstOrNull((function) => function.name == "mapped")
        let sourceStatements = sourceMethod.statements()
        Object sourceReturnValue = sourceStatements.first
        PrimitiveReturnSyntax sourceReturn = (PrimitiveReturnSyntax)sourceReturnValue
        Object sourceCallValue = sourceReturn.value
        PrimitiveCallSyntax sourceCall = (PrimitiveCallSyntax)sourceCallValue
        let sourceArguments = sourceCall.argumentValues()
        Object sourceLambdaValue = sourceArguments.first
        PrimitiveLambdaSyntax sourceLambda = (PrimitiveLambdaSyntax)sourceLambdaValue
        Object sourceConditionalValue = sourceLambda.body
        PrimitiveConditionalSyntax sourceConditional = (PrimitiveConditionalSyntax)sourceConditionalValue
        expect(conditional.range).toBe(sourceConditional.range)
        expect(trueJoin.range).toBe(sourceConditional.whenTrue.range)
        expect(storage.range).toBe(sourceConditional.whenTrue.range)
        expect(falseJoin.range).toBe(sourceConditional.whenFalse.range)
    }

    async test `field conditional retains generic value through reference join`() {
        let sources = ["class Object {}", "class String { public construct(native String text) {} }",
            "class Choice<E> { visible E stored; public choose(Bool quote) => quote ? \"quoted\" : this.stored }"]
        let contexts = PrimitiveSourceBindingContext[]
        var Int index
        for (source in sources) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:field-reference-join:#{index}"), "one")
            let stream = Lexer().lex(source)
            stream.emit("start")
            let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
            contexts.add(PrimitiveSourceBindingContext("flat", snapshot, [syntax]))
            index++
        }
        let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
        let root = units.firstOrNull((unit) => unit.identity.name == "Object").semanticType
        let choice = units.firstOrNull((unit) => unit.identity.name == "Choice")
        let method = choice.functionUnits().firstOrNull((function) => function.name == "choose")
        expect(method.returnType.value()).toBe(root.value())
        let statements = method.statements()
        Object returnedSource = statements.first
        BoundReturnStatement returned = (BoundReturnStatement)returnedSource
        Object conditionalSource = returned.value
        BoundConditionalExpression conditional = (BoundConditionalExpression)conditionalSource
        Object branchSource = conditional.whenFalse
        BoundConversionExpression branch = (BoundConversionExpression)branchSource
        expect(branch.conversion.conversionKind).toBe("reference-upcast")
        expect(branch.conversion.applicable && branch.conversion.implicit).toBe(true)
        expect(branch.value.semanticType.kind()).toBe("generic-parameter")
        expect(branch.value.expressionKind()).toBe("member-access")
    }

    async test `reducer text accumulator infers declared storage before contextual callback`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:reducer-text-contract"), "one")
        let traitStream = Lexer().lex("trait List<Type> { public reduce<Out>(func(Out acc, Type x, Int i, List<Type> list) -> Out, Out initialValue) -> Out { return initialValue; } }")
        traitStream.emit("start")
        let contract = PrimitiveInterfaceParser().parse(traitStream.consumeAll<Token>("data"), snapshot)
        let operatorStream = Lexer().lex("trait PlusOperator<In, Out> { public plus(In another) -> Out }")
        operatorStream.emit("start")
        let operator = PrimitiveInterfaceParser().parse(operatorStream.consumeAll<Token>("data"), snapshot, 100)
        let contexts = [PrimitiveSourceBindingContext("flat/datastruct/list", snapshot, PrimitiveClassSyntax[], [contract]),
            PrimitiveSourceBindingContext("flat/operators", snapshot, PrimitiveClassSyntax[], [operator])]
        let sources = [
            "class Object { public toString() -> String { return \"x\"; } }",
            "class String implements PlusOperator<String, String> { public construct(native String text) {} public plus(String another) -> String { return this; } }",
            "class Array<E> implements List<E> { public join(String delimiter) -> String { return reduce({ _acc + (_i > 0 ? delimiter : \"\") + _x }, \"\"); } }"
        ]
        var Int index
        for (source in sources) {
            let sourceSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:reducer-owner:#{index}"), "one")
            let stream = Lexer().lex(source)
            stream.emit("start")
            let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), sourceSnapshot)
            let namespaceName = index < 2 ? "flat" : "flat/datastruct/list"
            index++
            contexts.add(PrimitiveSourceBindingContext(namespaceName, sourceSnapshot, [syntax],
                importValues: [PrimitiveBindingImport("flat/operators/PlusOperator", syntax.range)]))
        }
        let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
        let array = units.firstOrNull((unit) => unit.identity.name == "Array")
        let text = units.firstOrNull((unit) => unit.identity.name == "String").semanticType
        let method = array.functionUnits().firstOrNull((function) => function.name == "join")
        let statements = method.statements()
        Object returnedSource = statements.first
        BoundReturnStatement returned = (BoundReturnStatement)returnedSource
        Object callSource = returned.value
        BoundCallExpression call = (BoundCallExpression)callSource
        expect(call.target.name).toBe("reduce")
        expect(call.semanticType.value()).toBe(text.value())
        let arguments = call.argumentValues()
        Object callbackSource = arguments.first
        BoundLambdaExpression callback = (BoundLambdaExpression)callbackSource
        expect(callback.semanticType.kind()).toBe("function")
        let type = (FunctionSemanticType)callback.semanticType
        expect(type.parameterTypes().first.value()).toBe(text.value())
        expect(type.returnType.value()).toBe(text.value())
        expect(type.parameterTypes()[1].kind()).toBe("generic-parameter")
        Object initializerSource = arguments.last
        BoundCallExpression initializer = (BoundCallExpression)initializerSource
        expect(initializer.target.callableKind.value).toBe("constructor")
        expect(initializer.semanticType.value()).toBe(text.value())
        expect(initializer.argumentValues().first.semanticType.value()).toBe(SemanticTypes.stringType().value())
        for (conversion in call.argumentConversions()) {
            expect(conversion.applicable).toBe(true)
        }
    }

    async test `missing reference keeps typed range through cleanup`() {
        let source = "class Main { public invalid() -> Int => dogfoodMissingSymbol }"
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:admission-unknown-reference"), "one")
        let stream = Lexer().lex(source)
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let method = syntax.methodValues().first
        let statements = method.statements()
        Object returnedSource = statements.first
        PrimitiveReturnSyntax returned = (PrimitiveReturnSyntax)returnedSource
        let expected = returned.value.range
        var PrimitiveContextBindingException failure
        let binder = PrimitiveClassBinder()
        try { binder.bind(syntax, snapshot) }
        catch (PrimitiveContextBindingException error) { failure = error }
        if (!failure) throw Exception("Unknown reference did not publish typed binding failure")
        let diagnostic = failure.diagnostic
        expect(diagnostic.code).toBe("binding.unresolved-reference")
        expect(diagnostic.range.snapshot).toBe(snapshot)
        expect(diagnostic.range.startTokenIndex).toBe(expected.startTokenIndex)
        expect(diagnostic.range.endTokenIndex).toBe(expected.endTokenIndex)
        expect(diagnostic.range.start.column).toBe(expected.start.column)
        expect(diagnostic.range.end.column).toBe(expected.end.column)
        expect(diagnostic.workIdentity.snapshot).toBe(snapshot)
        expect(diagnostic.range.startTokenIndex > method.range.startTokenIndex).toBe(true)
        // A subsequent successful bind must not overwrite the captured failure range.
        let validStream = Lexer().lex("class Neighbor { read() -> Int { return 1; } }")
        validStream.emit("start")
        let validSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:diagnostic-neighbor"), "one")
        binder.bind(PrimitiveClassParser().parse(validStream.consumeAll<Token>("data"), validSnapshot), validSnapshot)
        expect(diagnostic.range.snapshot).toBe(snapshot)
        expect(diagnostic.range.startTokenIndex).toBe(expected.startTokenIndex)
        expect(diagnostic.range.endTokenIndex).toBe(expected.endTokenIndex)
    }

    /** Generic callback fixtures admit the same canonical storage contract as production. */
    async admitCallbackScalar(PrimitiveSourceBindingContext[] contexts, String name) {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:callback-scalar:#{name}"), "one")
        let stream = Lexer().lex("class #{name} { public construct(public #{name} value) {} }")
        stream.emit("start")
        let tokens = stream.consumeAll<Token>("data")
        let syntax = PrimitiveClassParser().parse(tokens, snapshot)
        let namespaceName = name == "Bool" ? "flat/primitive" : "flat/primitive/number"
        contexts.add(PrimitiveSourceBindingContext(namespaceName, snapshot, [syntax]))
    }
    async test `compound field value retains target once and stores checked result`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:integrated-member-compound"), "one")
        let stream = Lexer().lex("class Counter { visible Int value; public construct() {} static get() -> Counter { return Counter(); } static rhs() -> Int { return 2; } static run() -> Int { return (get().value += rhs()); } }")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let units = PrimitiveClassPartitionBinder().bind([syntax]).typeUnits()
        let method = units.first.functionUnits().firstOrNull((value) => value.name == "run")
        let statements = method.statements()
        Object returnedSource = statements.last
        BoundReturnStatement returned = (BoundReturnStatement)returnedSource
        Object evaluationSource = returned.value
        BoundEvaluationExpression evaluation = (BoundEvaluationExpression)evaluationSource
        let setup = evaluation.setup()
        expect(setup.count).toBe(3)
        Object receiverSource = setup.first
        BoundLocalDeclarationStatement receiver = (BoundLocalDeclarationStatement)receiverSource
        Object getSource = receiver.initializer
        BoundCallExpression get = (BoundCallExpression)getSource
        expect(get.target.name).toBe("get")
        expect(receiver.local.symbolIdentity.symbolKind).toBe("local")
        expect(receiver.local.name).toBe("compoundReceiver")
        Object valueSource = setup[1]
        BoundLocalDeclarationStatement value = (BoundLocalDeclarationStatement)valueSource
        Object additionSource = value.initializer
        BoundBinaryExpression addition = (BoundBinaryExpression)additionSource
        Object fieldSource = addition.left
        BoundMemberAccessExpression field = (BoundMemberAccessExpression)fieldSource
        Object retainedSource = field.receiver
        BoundReferenceExpression retained = (BoundReferenceExpression)retainedSource
        expect(retained.symbolIdentity.value).toBe(receiver.local.symbolIdentity.value)
        Object rhsSource = addition.right
        BoundCallExpression rhs = (BoundCallExpression)rhsSource
        expect(rhs.target.name).toBe("rhs")
        Object writeSource = setup.last
        BoundMemberAssignmentStatement write = (BoundMemberAssignmentStatement)writeSource
        Object writeReceiverSource = write.target.receiver
        BoundReferenceExpression writeReceiver = (BoundReferenceExpression)writeReceiverSource
        expect(writeReceiver.symbolIdentity.value).toBe(receiver.local.symbolIdentity.value)
        expect(writeReceiver.symbolIdentity.symbolKind).toBe("local")
        expect(write.target.memberIdentity.value).toBe(field.memberIdentity.value)
        Object writtenValueSource = write.value
        BoundReferenceExpression writtenValue = (BoundReferenceExpression)writtenValueSource
        expect(writtenValue.symbolIdentity.value).toBe(value.local.symbolIdentity.value)
        expect(writtenValue.symbolIdentity.value == receiver.local.symbolIdentity.value).toBe(false)
        Object resultSource = evaluation.value
        BoundReferenceExpression result = (BoundReferenceExpression)resultSource
        expect(result.symbolIdentity.value).toBe(value.local.symbolIdentity.value)
    }

    async test `canonical ordinary operators publish checked calls with ordered single operands`() {
        let contexts = PrimitiveSourceBindingContext[]
        let traitSources = [
            "trait PlusOperator<In, Out> { public plus(In another) -> Out }",
            "trait MinusOperator<In, Out> { public minus(In another) -> Out }",
            "trait MultiplyOperator<In, Out> { public multiply(In another) -> Out }",
            "trait LessThanOperator<In> { public lessThan(In another) -> Bool }"
        ]
        var Int index
        for (source in traitSources) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:l02:contract:#{index++}"), "one")
            let stream = Lexer().lex(source)
            stream.emit("start")
            let contract = PrimitiveInterfaceParser().parse(stream.consumeAll<Token>("data"), snapshot)
            contexts.add(PrimitiveSourceBindingContext("flat/operators", snapshot, PrimitiveClassSyntax[], [contract]))
        }
        let sources = [
            "class Amount implements PlusOperator<Amount, Amount>, MinusOperator<Amount, Amount>, MultiplyOperator<Amount, Amount>, LessThanOperator<Amount> { public construct() {} public plus(Amount another) -> Amount { return this; } public plus(Int another) -> Amount { return this; } public minus(Amount another) -> Amount { return this; } public multiply(Amount another) -> Amount { return this; } public lessThan(Amount another) -> Bool { return true; } }",
            "class OperatorUse { static left() -> Amount { return Amount(); } static right() -> Amount { return Amount(); } static add() -> Amount { return left() + right(); } static subtract() -> Amount { return left() - right(); } static product() -> Amount { return left() * right(); } static compare() -> Bool { return left() < right(); } }"
        ]
        for (source in sources) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:l02:owner:#{index++}"), "one")
            let stream = Lexer().lex(source)
            stream.emit("start")
            let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
            contexts.add(PrimitiveSourceBindingContext("app", snapshot, [syntax],
                importValues: [PrimitiveBindingImport("flat/operators", syntax.range)]))
        }
        var String[] identities
        for (mode in 0..2) {
            let units = PrimitiveClassPartitionBinder().bindContexts(mode == 0 ? contexts : contexts.reverse()).typeUnits()
            let owner = units.firstOrNull((unit) => unit.identity.name == "Amount")
            let use = units.firstOrNull((unit) => unit.identity.name == "OperatorUse")
            let names = ["add", "subtract", "product", "compare"]
            let targets = ["plus", "minus", "multiply", "lessThan"]
            let selected = String[]
            var Int position
            for (name in names) {
                let method = use.functionUnits().firstOrNull((unit) => unit.name == name)
                let statements = method.statements()
                Object returnedSource = statements.first
                BoundReturnStatement returned = (BoundReturnStatement)returnedSource
                Object callSource = returned.value
                BoundCallExpression call = (BoundCallExpression)callSource
                expect(call.target.name).toBe(targets[position])
                expect(call.target.ownerType.value()).toBe(owner.semanticType.value())
                expect(call.target.parameterTypes().first.value()).toBe(owner.semanticType.value())
                expect(call.argumentConversions().first.applicable).toBe(true)
                Object leftSource = call.receiver
                BoundCallExpression left = (BoundCallExpression)leftSource
                let arguments = call.argumentValues()
                expect(arguments.count).toBe(1)
                Object rightSource = arguments.first
                BoundCallExpression right = (BoundCallExpression)rightSource
                expect(left.target.name).toBe("left")
                expect(right.target.name).toBe("right")
                expect(left.range.startTokenIndex < right.range.startTokenIndex).toBe(true)
                expect(call.semanticType.value()).toBe(position == 3 ? SemanticTypes.boolType().value() : owner.semanticType.value())
                selected.add(call.target.identity.value)
                position++
            }
            if (mode == 0) identities = selected
            else {
                var Int selectedIndex
                for (identity in selected) {
                    expect(identity).toBe(identities[selectedIndex++])
                }
            }
        }
    }

    async test `operator shaped methods do not authorize undeclared or nullable arithmetic`() {
        let cases = [
            "class Amount { public construct() {} public minus(Amount another) -> Amount { return this; } run(Amount another) -> Amount { return this - another; } }",
            "class Amount implements MinusOperator<Amount, Amount> { public construct() {} public minus(Amount another) -> Amount { return this; } run(Amount? another) -> Amount { return this - another; } }"
        ]
        var Int index
        for (source in cases) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:l02:reject:#{index++}"), "one")
            let traitStream = Lexer().lex("trait MinusOperator<In, Out> { public minus(In another) -> Out }")
            traitStream.emit("start")
            let contract = PrimitiveInterfaceParser().parse(traitStream.consumeAll<Token>("data"), snapshot)
            let stream = Lexer().lex(source)
            stream.emit("start")
            let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot, 100)
            let contexts = [PrimitiveSourceBindingContext("flat/operators", snapshot, PrimitiveClassSyntax[], [contract]),
                PrimitiveSourceBindingContext("app", snapshot, [syntax],
                    importValues: [PrimitiveBindingImport("flat/operators/MinusOperator", syntax.range)])]
            var Exception failure
            try { PrimitiveClassPartitionBinder().bindContexts(contexts) }
            catch (Exception error) { failure = error }
            expect(failure != null).toBe(true)
        }
    }

    async test `declared left text compares nonliteral native neighbor without operand reversal`() {
        let contexts = PrimitiveSourceBindingContext[]
        let sources = [
            "class String { public construct(native String text) {} public equals(String another) -> Bool { return true; } }",
            "class TextUse { static left() -> String { return \"left\"; } static native right() -> String { return \"right\"; } static same() -> Bool { return left() == right(); } static different() -> Bool { return left() != right(); } }"
        ]
        var Int index
        for (source in sources) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:l02:text-neighbor:#{index}"), "one")
            let stream = Lexer().lex(source)
            stream.emit("start")
            let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
            contexts.add(PrimitiveSourceBindingContext(index++ == 0 ? "flat" : "app", snapshot, [syntax]))
        }
        let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
        let use = units.firstOrNull((unit) => unit.identity.name == "TextUse")
        let equalityNames = ["same", "different"]
        for (name in equalityNames) {
            let method = use.functionUnits().firstOrNull((unit) => unit.name == name)
            let statements = method.statements()
            Object returnedSource = statements.first
            BoundReturnStatement returned = (BoundReturnStatement)returnedSource
            var BoundExpression operation = returned.value
            if (name == "different") {
                Object negationSource = operation
                BoundUnaryExpression negation = (BoundUnaryExpression)negationSource
                expect(negation.operator).toBe("!")
                operation = negation.operand
            }
            Object callSource = operation
            BoundCallExpression call = (BoundCallExpression)callSource
            expect(call.target.name).toBe("equals")
            Object leftSource = call.receiver
            BoundCallExpression left = (BoundCallExpression)leftSource
            expect(left.target.name).toBe("left")
            let arguments = call.argumentValues()
            expect(arguments.count).toBe(1)
            Object wrappedSource = arguments.first
            BoundCallExpression wrapped = (BoundCallExpression)wrappedSource
            expect(wrapped.target.callableKind.value).toBe("constructor")
            let nativeArguments = wrapped.argumentValues()
            expect(nativeArguments.count).toBe(1)
            Object rightSource = nativeArguments.first
            BoundCallExpression right = (BoundCallExpression)rightSource
            expect(right.target.name).toBe("right")
            expect(right.semanticType.value()).toBe(SemanticTypes.stringType().value())
        }
    }

    async test `assignment expression stores canonical text and yields the stored representation`() {
        let contexts = PrimitiveSourceBindingContext[]
        let sources = [
            "class String { public construct(native String text) {} }",
            "class AssignmentUse { static run(String initial) -> String { var stored = initial; return (stored = \"next\"); } }"
        ]
        var Int index
        for (source in sources) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:l02:assignment:#{index}"), "one")
            let stream = Lexer().lex(source)
            stream.emit("start")
            let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
            contexts.add(PrimitiveSourceBindingContext(index++ == 0 ? "flat" : "app", snapshot, [syntax]))
        }
        let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
        let stringType = units.firstOrNull((unit) => unit.identity.name == "String").semanticType
        let method = units.firstOrNull((unit) => unit.identity.name == "AssignmentUse").functionUnits()
            .firstOrNull((unit) => unit.name == "run")
        let statements = method.statements()
        Object returnedSource = statements.last
        BoundReturnStatement returned = (BoundReturnStatement)returnedSource
        Object assignedSource = returned.value
        BoundAssignmentValueExpression assigned = (BoundAssignmentValueExpression)assignedSource
        expect(assigned.semanticType.value()).toBe(stringType.value())
        expect(assigned.target.semanticType.value()).toBe(stringType.value())
        expect(assigned.storageConversion.conversionKind).toBe("identity")
        Object wrappedSource = assigned.value
        BoundCallExpression wrapped = (BoundCallExpression)wrappedSource
        expect(wrapped.target.callableKind.value).toBe("constructor")
        expect(wrapped.semanticType.value()).toBe(stringType.value())
        let arguments = wrapped.argumentValues()
        expect(arguments.count).toBe(1)
        expect(arguments.first.semanticType.value()).toBe(SemanticTypes.stringType().value())
    }

    async test `primitive compound and nullable assignment rejection remain strict`() {
        let sources = [
            "class Reject { run(Int value) -> Int { return (value = null); } }",
            "class Reject { run(Int value) -> Int { return (value = 1.5); } }",
            "class Reject { run(Int value) -> Int { value += null; return value; } }",
            "class Reject { run(Int value) -> Int { value %= 1.5; return value; } }"
        ]
        var Int index
        for (source in sources) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:l02:numeric-reject:#{index++}"), "one")
            let stream = Lexer().lex(source)
            stream.emit("start")
            let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
            var Exception failure
            try { PrimitiveClassPartitionBinder().bind([syntax]) }
            catch (Exception error) { failure = error }
            expect(failure != null).toBe(true)
        }
    }

    async test `native text properties use canonical receiver contracts`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:native-text-property"), "one")
        let sources = [
            "class String { visible native String data; public construct(native String text) { data = text; } public Bool isNotEmpty => true }",
            "class Use { run(native String text) -> Bool { return text.isNotEmpty; } static native source() -> String { return \"x\"; } factory() -> Bool { return source().isNotEmpty; } }"
        ]
        let contexts = PrimitiveSourceBindingContext[]
        var Int index
        for (source in sources) {
            let stream = Lexer().lex(source)
            stream.emit("start")
            let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
            contexts.add(PrimitiveSourceBindingContext(index++ == 0 ? "flat" : "app", snapshot, [syntax]))
        }
        let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
        let method = units.firstOrNull({ _.identity.name == "Use" }).functionUnits().firstOrNull({ _.name == "run" })
        let statements = method.statements()
        Object returnedSource = statements.first
        BoundReturnStatement returned = (BoundReturnStatement)returnedSource
        Object callSource = returned.value
        BoundCallExpression call = (BoundCallExpression)callSource
        expect(call.target.name).toBe("isNotEmpty")
        expect(call.target.ownerType.declarationIdentity.name).toBe("String")
        expect(call.receiver.semanticType.value()).toBe(call.target.ownerType.value())
        Object storageSource = call.receiver
        BoundCallExpression storage = (BoundCallExpression)storageSource
        expect(storage.target.callableKind.value).toBe("constructor")
        let storageArguments = storage.argumentValues()
        expect(storageArguments.count).toBe(1)
        expect(storageArguments.first.semanticType.value()).toBe(SemanticTypes.stringType().value())
        expect(storageArguments.first.expressionKind()).toBe("reference")
        expect(call.semanticType.value()).toBe(SemanticTypes.boolType().value())
        expect(call.range.startTokenIndex > 0).toBe(true)
        let factory = units.firstOrNull({ _.identity.name == "Use" }).functionUnits().firstOrNull({ _.name == "factory" })
        let factoryStatements = factory.statements()
        Object factoryReturnSource = factoryStatements.first
        BoundReturnStatement factoryReturn = (BoundReturnStatement)factoryReturnSource
        Object factoryCallSource = factoryReturn.value
        BoundCallExpression factoryCall = (BoundCallExpression)factoryCallSource
        Object factoryStorageSource = factoryCall.receiver
        BoundCallExpression factoryStorage = (BoundCallExpression)factoryStorageSource
        let factoryArguments = factoryStorage.argumentValues()
        expect(factoryArguments.count).toBe(1)
        Object producerSource = factoryArguments.first
        BoundCallExpression producer = (BoundCallExpression)producerSource
        expect(producer.target.name).toBe("source")
        expect(producer.argumentValues().count).toBe(0)
        expect(factoryCall.argumentValues().count).toBe(0)
    }

    async test `structured native text property retains nested ranges and canonical receiver`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:nested-text-property"), "one")
        let sources = [
            "class String { visible native String data; public construct(native String text) { data = text; } public Bool isNotEmpty => true }",
            "class Long { static native time(native String str, native String delimiter) -> String { if (str.isNotEmpty) { return " + '"' + "s" + '#' + "{str.isNotEmpty ? delimiter + str : " + '"' + '"' + "}" + '"' + "; } return " + '"' + '"' + "; } }"
        ]
        let contexts = PrimitiveSourceBindingContext[]
        var Int index
        for (source in sources) {
            let stream = Lexer().lex(source)
            stream.emit("start")
            let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
            contexts.add(PrimitiveSourceBindingContext(index++ == 0 ? "flat" : "app", snapshot, [syntax]))
        }
        let syntaxes = contexts.last.classValues()
        let syntaxStatements = syntaxes.first.methodValues().first.statements()
        Object syntaxIfSource = syntaxStatements.first
        PrimitiveIfSyntax syntaxIf = (PrimitiveIfSyntax)syntaxIfSource
        let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
        let method = units.firstOrNull({ _.identity.name == "Long" }).functionUnits().firstOrNull({ _.name == "time" })
        let statements = method.statements()
        Object ifSource = statements.first
        BoundIfStatement conditional = (BoundIfStatement)ifSource
        Object conditionSource = conditional.condition
        BoundCallExpression condition = (BoundCallExpression)conditionSource
        expect(condition.target.name).toBe("isNotEmpty")
        expect(condition.range.startTokenIndex).toBe(syntaxIf.condition.range.startTokenIndex)
        expect(condition.range.endTokenIndex).toBe(syntaxIf.condition.range.endTokenIndex)
        Object receiverSource = condition.receiver
        BoundCallExpression storage = (BoundCallExpression)receiverSource
        expect(storage.target.callableKind.value).toBe("constructor")
        expect(storage.argumentValues().count).toBe(1)
        expect(method.returnType.value()).toBe(SemanticTypes.stringType().value())
    }

    async test `structured inferred text local keeps canonical assignment representation`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:time-text-assignment"), "one")
        let traitStream = Lexer().lex("trait PlusOperator<In, Out> { public plus(In another) -> Out }")
        traitStream.emit("start")
        let contract = PrimitiveInterfaceParser().parse(traitStream.consumeAll<Token>("data"), snapshot)
        let contexts = [PrimitiveSourceBindingContext("flat/operators", snapshot, PrimitiveClassSyntax[], [contract])]
        let sources = ["class String implements PlusOperator<String, String> { public construct(native String text) {} public plus(String other) -> String { return this; } }",
            "class Long { static run(String delimiter, Bool abbreviate) -> String { var str = \"\"; if (abbreviate) { str = \"s\"; } else { str = \" seconds\" + (true ? delimiter + str : \"\"); } return str; } }"]
        var Int index
        for (source in sources) {
            let stream = Lexer().lex(source)
            stream.emit("start")
            let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
            contexts.add(PrimitiveSourceBindingContext(index++ == 0 ? "flat" : "app", snapshot, [syntax],
                importValues: [PrimitiveBindingImport("flat/operators/PlusOperator", syntax.range)]))
        }
        let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
        let stringType = units.firstOrNull({ _.identity.name == "String" }).semanticType
        let method = units.firstOrNull({ _.identity.name == "Long" }).functionUnits().firstOrNull({ _.name == "run" })
        let statements = method.statements()
        Object localSource = statements.first
        BoundLocalDeclarationStatement local = (BoundLocalDeclarationStatement)localSource
        expect(local.local.semanticType.value()).toBe(stringType.value())
        expect(local.initializer.semanticType.value()).toBe(stringType.value())
        Object ifSource = statements[1]
        BoundIfStatement conditional = (BoundIfStatement)ifSource
        let thenValues = conditional.thenValues()
        let elseValues = conditional.elseValues()
        Object nativeAssignmentSource = thenValues.first
        BoundAssignmentStatement nativeAssignment = (BoundAssignmentStatement)nativeAssignmentSource
        Object plusAssignmentSource = elseValues.first
        BoundAssignmentStatement plusAssignment = (BoundAssignmentStatement)plusAssignmentSource
        expect(nativeAssignment.value.semanticType.value()).toBe(stringType.value())
        expect(plusAssignment.value.semanticType.value()).toBe(stringType.value())
        expect(plusAssignment.target.semanticType.value()).toBe(stringType.value())
        let syntaxStatements = contexts.last.classValues().first.methodValues().first.statements()
        Object syntaxIfSource = syntaxStatements[1]
        PrimitiveIfSyntax syntaxIf = (PrimitiveIfSyntax)syntaxIfSource
        let expectedAssignments = syntaxIf.elseValues()
        expect(plusAssignment.range.startTokenIndex).toBe(expectedAssignments.first.range.startTokenIndex)
        expect(plusAssignment.range.endTokenIndex).toBe(expectedAssignments.first.range.endTokenIndex)
    }

