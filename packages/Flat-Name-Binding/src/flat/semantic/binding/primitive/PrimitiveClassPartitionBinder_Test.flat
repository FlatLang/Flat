    async test `generic factory callback preserves pre substitution return contract`() {
        let typeArgumentModes = [false, true]
        for (explicitTypeArgument in typeArgumentModes) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:generic-factory:#explicitTypeArgument"), "one")
            let typeArguments = explicitTypeArgument ? "<Int>" : ""
            let sources = [
                "class Future { public static from<T>(async func() -> T) -> Int { return 1; } }",
                "class Caller { public run() -> Int { return Future.from#{typeArguments}({ return 0; }); } }"
            ]
            let syntaxes = PrimitiveClassSyntax[]
            for (source in sources) {
                let stream = Lexer().lex(source)
                stream.emit("start")
                syntaxes.add(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot))
            }
            let contexts = PrimitiveSourceBindingContext[]
            for (index in 0..syntaxes.count) contexts.add(PrimitiveSourceBindingContext("app", snapshot, [syntaxes[index]]))
            let scalarSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:generic-factory:Int"), "one")
            let scalarStream = Lexer().lex("class Int { public construct(public Int value) {} }")
            scalarStream.emit("start")
            let scalar = PrimitiveClassParser().parse(scalarStream.consumeAll<Token>("data"), scalarSnapshot)
            contexts.add(PrimitiveSourceBindingContext("flat/primitive/number", scalarSnapshot, [scalar]))
            let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
            let caller = units.firstOrNull({ _.identity.name == "Caller" })
            let method = caller.functionUnits().firstOrNull({ _.name == "run" })
            let methodStatements = method.statements()
            Object returnedSource = methodStatements.first
            BoundReturnStatement returned = (BoundReturnStatement)returnedSource
            Object callObject = returned.value
            BoundCallExpression call = (BoundCallExpression)callObject
            let callArguments = call.argumentValues()
            Object callbackObject = callArguments.first
            BoundLambdaExpression callback = (BoundLambdaExpression)callbackObject
            expect(callback.resultBoxingConstructor.ownerType.declarationIdentity.name).toBe("Int")
            expect(callback.resultBoxingConstructor.parameterTypes().first.value()).toBe("primitive:Int")
            expect(callback.declarationContract.returnType.kind()).toBe("generic-parameter")
            expect(callback.declarationContract.asyncFunction).toBe(true)
            Object callbackTypeSource = callback.semanticType
            FunctionSemanticType callbackType = (FunctionSemanticType)callbackTypeSource
            expect(callbackType.returnType.value()).toBe("primitive:Int")
            let callbackStatements = callback.statementValues()
            Object callbackReturnSource = callbackStatements.first
            BoundReturnStatement callbackReturn = (BoundReturnStatement)callbackReturnSource
            expect(callbackReturn.requiredType.value()).toBe("primitive:Int")
            expect(callbackReturn.value.semanticType.value()).toBe("primitive:Int")
            expect(callbackReturn.conversion.conversionKind).toBe("identity")
        }
    }

    async test `static generic callback infers output and retains async function context`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:static-generic-callback"), "one")
        let sources = [
            "class Async { public static async all<Out, In>(In[] values, async toPromise(In, Int) -> Out) -> Out[] { return Out[]; } }",
            "class Use { run(Int[] values, async map(Int, Int) -> Long) -> Long[] { return Async.all(values, { map(_, _) }); } }"
        ]
        let syntaxes = PrimitiveClassSyntax[]
        for (source in sources) {
            let stream = Lexer().lex(source)
            stream.emit("start")
            syntaxes.add(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot))
        }
        let contexts = PrimitiveSourceBindingContext[]
        for (syntax in syntaxes) contexts.add(PrimitiveSourceBindingContext("app", snapshot, [syntax]))
        let boxingSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:static-callback:Long"), "one")
        let boxingStream = Lexer().lex("class Long { public construct(public Long value) {} }")
        boxingStream.emit("start")
        let boxingSyntax = PrimitiveClassParser().parse(boxingStream.consumeAll<Token>("data"), boxingSnapshot)
        contexts.add(PrimitiveSourceBindingContext("flat/primitive/number", boxingSnapshot, [boxingSyntax]))
        let types = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
        let method = types.firstOrNull({ _.identity.name == "Use" }).functionUnits().firstOrNull({ _.name == "run" })
        let statements = method.statements()
        var BoundReturnStatement returned
        returned = (BoundReturnStatement)statements.first
        var BoundCallExpression call
        call = (BoundCallExpression)returned.value
        expect(call.target.returnType.value()).toBe(ArraySemanticType(SemanticTypes.longType()).value())
        let arguments = call.argumentValues()
        Object evidenceSource1 = arguments.last.semanticType
        FunctionSemanticType callbackType = (FunctionSemanticType)evidenceSource1
        expect(callbackType.asyncFunction).toBe(true)
        expect(callbackType.returnType.value()).toBe(SemanticTypes.longType().value())
    }

    async test `static generic async overload accepts generic owner receiver and chunk callback`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:async-generic-owner"), "one")
        let sources = [
            "class Async { public static async all<Out, In>(In[] values, async toPromise(In, Int) -> Out, Int maxParallel = -1, async onAfterChunk(Int count) = {}) -> Out[] { return new Array<Out>(); } }",
            "class Array<E> { construct() {} public async mapParallel<Out>(async mapFunc(E x, Int i, Array<E> array) -> Out, Int maxParallel = -1, async onAfterChunk(Int count) = {}) -> Out[] { return Async.all(this, { mapFunc(_, _, this) }, maxParallel, onAfterChunk); } }"
        ]
        let syntaxes = PrimitiveClassSyntax[]
        for (source in sources) {
            let stream = Lexer().lex(source)
            stream.emit("start")
            syntaxes.add(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot))
        }
        let types = PrimitiveClassPartitionBinder().bind(syntaxes, snapshot).typeUnits()
        let method = types.last.functionUnits().firstOrNull({ _.name == "mapParallel" })
        expect(method.returnType.kind()).toBe("generic-instance")
    }

    async test `static generic callback rejects incompatible input mapping`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:static-generic-callback-invalid"), "one")
        let sources = [
            "class Async { public static async all<Out, In>(In[] values, async toPromise(In, Int) -> Out) -> Out[] { return Out[]; } }",
            "class Use { run(Int[] values, async map(Bool, Int) -> Long) -> Long[] { return Async.all(values, { map(_, _) }); } }"
        ]
        let syntaxes = PrimitiveClassSyntax[]
        for (source in sources) {
            let stream = Lexer().lex(source)
            stream.emit("start")
            syntaxes.add(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot))
        }
        var String failure
        try { PrimitiveClassPartitionBinder().bind(syntaxes, snapshot) }
        catch (Exception error) { failure = error.message }
        if (!failure) throw Exception("Incompatible static generic callback accepted")
    }

    async test `generic declaration condition preserves type and initializes once`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:generic-condition"), "one")
        let stream = Lexer().lex("class Buffer<E> { run(func() -> E map) -> E => null { " +
            "if (let value = map()) { return value; } } }")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let type = PrimitiveClassPartitionBinder().bind([syntax], snapshot).typeUnits().first
        let method = type.functionUnits().firstOrNull({ _.name == "run" })
        let body = method.statements()
        var BoundLocalDeclarationStatement local
        local = (BoundLocalDeclarationStatement)body.first
        expect(local.local.semanticType.kind()).toBe("generic-parameter")
        expect(local.initializer.expressionKind()).toBe("function-invocation")
        var BoundIfStatement branch
        branch = (BoundIfStatement)body[1]
        expect(branch.condition.semanticType.value()).toBe(SemanticTypes.boolType().value())
        expect(branch.condition.expressionKind()).toBe("binary")
    }

    async test `nullable Bool declaration guard requires presence and true value`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:nullable-bool-condition"), "one")
        let range = SourceRange(snapshot, 0, 1, Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 2))
        let nullable = NullableSemanticType(SemanticTypes.boolType())
        let identity = SymbolIdentity(DeclarationIdentity(SyntaxIslandIdentity(snapshot, "local", 0), "local", "input"), "local")
        let condition = PrimitiveDeclarationValueSyntax(range, "value", PrimitiveReferenceSyntax(range, "input"))
        let result = PrimitiveControlStatementBinder().bind(PrimitiveStatementSyntaxResult([
            PrimitiveIfSyntax(range, condition, PrimitiveStatementSyntax[], PrimitiveStatementSyntax[])
        ]), snapshot, [LocalBinding("input", identity, nullable)])
        let statements = result.statements()
        var BoundLocalDeclarationStatement local
        local = (BoundLocalDeclarationStatement)statements.first
        expect(local.local.semanticType.value()).toBe(nullable.value())
        var BoundIfStatement branch
        branch = (BoundIfStatement)statements.last
        var BoundBinaryExpression guard
        guard = (BoundBinaryExpression)branch.condition
        expect(guard.operator).toBe("&&")
        expect(guard.semanticType.value()).toBe(SemanticTypes.boolType().value())
    }

    async test `condition declaration does not escape into following statement`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:condition-scope"), "one")
        let stream = Lexer().lex("class Buffer<E> { run(func() -> E map) -> E => null { " +
            "if (let value = map()) { return value; } return value; } }")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        var String failure
        try { PrimitiveClassPartitionBinder().bind([syntax], snapshot) }
        catch (Exception error) { failure = error.message }
        if (!failure) throw Exception("Condition local leaked outside its branch")
    }

    async test `native generic storage clear is not an element conversion`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:native-storage-clear"), "one")
        let stream = Lexer().lex("class Buffer<E> { visible native_array E[] data; " +
            "clear(Int index) -> Void { data[index] = null; } " +
            "read(Int index) -> E { return data[index]; } }")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        expect(syntax.fieldValues().first.nativeArrayStorage).toBe(true)
        let type = PrimitiveClassPartitionBinder().bind([syntax], snapshot).typeUnits().first
        let clear = type.functionUnits().firstOrNull({ _.name == "clear" })
        expect(clear.statements().first.unitKind()).toBe("native-array-clear")
        let read = type.functionUnits().firstOrNull({ _.name == "read" })
        expect(read.returnType.kind()).toBe("generic-parameter")
    }

    async test `ordinary primitive array rejects null element assignment`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:ordinary-array-null"), "one")
        let stream = Lexer().lex("class Buffer { Int[] data; " +
            "clear(Int index) -> Void { data[index] = null; } }")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        var String failure
        try { PrimitiveClassPartitionBinder().bind([syntax], snapshot) }
        catch (Exception error) { failure = error.message }
        if (!failure) throw Exception("Ordinary generic array accepted null element assignment")
        expect(failure.endsWith(": Array assignment type mismatch")).toBe(true)
    }

    async test `native storage shadowing and inferred aliases do not grant clear authority`() {
        let sources = [
            "class Buffer { visible native_array Int[] data; clear(Int[] data) -> Void { data[0] = null; } }",
            "class Buffer { visible native_array Int[] data; clear() -> Void { let alias = data; alias[0] = null; } }"
        ]
        for (source in sources) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:storage-authority"), "one")
            let stream = Lexer().lex(source)
            stream.emit("start")
            let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
            var String failure
            try { PrimitiveClassPartitionBinder().bind([syntax], snapshot) }
            catch (Exception error) { failure = error.message }
            if (!failure) throw Exception("Unannotated storage alias accepted clear: #source")
            expect(failure.endsWith(": Array assignment type mismatch")).toBe(true)
        }
    }

    async test `explicit native local permits clear without nullable elements`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:native-local-clear"), "one")
        let stream = Lexer().lex("class Buffer { clear() -> Void { native_array Int[] data; data[0] = null; } }")
