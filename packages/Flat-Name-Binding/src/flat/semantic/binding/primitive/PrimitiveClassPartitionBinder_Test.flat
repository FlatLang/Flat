    async test `publishes generic owner constructor parameter scope`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:generic-constructor-scope"), "one")
        let stream = Lexer().lex("class Buffer<E> { construct(E[] data, Int count) { } }")
