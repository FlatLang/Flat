        for (source in sources) {
            let stream = Lexer().lex(source)
            stream.emit("start")
            syntaxes.add(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot, offset))
            offset += 100
        }
        let result = PrimitiveClassPartitionBinder().bindContexts([
            PrimitiveSourceBindingContext("flat", snapshot, syntaxes, [contract])]).typeUnits().last
        let entry = result.fieldUnits().firstOrNull({ _.name == "entry" })
        expect(entry.semanticType.kind()).toBe("user-class")
