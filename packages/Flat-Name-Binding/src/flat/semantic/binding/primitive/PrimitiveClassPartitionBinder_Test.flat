    async test `namespace overlay method uses only its source local imports`() {
        let baseSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:overlay-base"), "one")
        let overlaySnapshot = SourceSnapshotIdentity(SourceIdentity("memory:overlay-member"), "one")
