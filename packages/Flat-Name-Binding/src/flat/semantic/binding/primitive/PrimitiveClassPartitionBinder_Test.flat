        let stream = Lexer().lex("class String extends Object { visible native String data; " +
            "public construct(native String text) { data = text; } override public toString() => this }")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let units = PrimitiveClassPartitionBinder().bindContexts([
            PrimitiveSourceBindingContext("flat", parentSnapshot, [parent]),
            PrimitiveSourceBindingContext("flat", snapshot, [syntax])
        ]).typeUnits()
        let owner = units.firstOrNull({ _.identity.name == "Object" })
        let child = units.firstOrNull({ _.identity.name == "String" })
        let parentMethod = owner.functionUnits().firstOrNull({ _.name == "toString" })
        let childMethod = child.functionUnits().firstOrNull({ _.name == "toString" })
        expect(parentMethod.returnType.value()).toBe(child.semanticType.value())
