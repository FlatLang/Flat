    async test `publishes inferred indexed storage accessors to consumers`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:inferred-accessor-consumer"), "one")
        let first = Lexer().lex("class Items { Int[] data; this[Int index] <=> data[index]\n}")
        first.emit("start")
        let second = Lexer().lex("class Reader { read(Items items) -> Int { items[0] = 42; return items[0]; } }")
        second.emit("start")
        let types = PrimitiveClassPartitionBinder().bind([
            PrimitiveClassParser().parse(first.consumeAll<Token>("data"), snapshot),
            PrimitiveClassParser().parse(second.consumeAll<Token>("data"), snapshot)
        ], snapshot).typeUnits()
        expect(types.count).toBe(2)
    }

    async test `selects projected receiver array accessor by owner`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:projected-array-owner-bind"), "one"
        )
        let itemsStream = Lexer().lex(
            "class Items { Char[] data; this[Int index] -> Char { " +
                "get { return data[index] } } }"
        )
        itemsStream.emit("start")
        let readerStream = Lexer().lex(
            "class Reader { Char[] data; this[Int index] -> Char { " +
                "get { return data[index] } } " +
                "read(Items items, Int index) -> Char { return items[index]; } }"
        )
        readerStream.emit("start")
        let types = PrimitiveClassPartitionBinder().bind([
            PrimitiveClassParser().parse(
                itemsStream.consumeAll<Token>("data"), snapshot
            ),
            PrimitiveClassParser().parse(
                readerStream.consumeAll<Token>("data"), snapshot
            )
        ], snapshot).typeUnits()
        let items = types.firstOrNull({ _.identity.name == "Items" })
        let reader = types.firstOrNull({ _.identity.name == "Reader" })
        let method = reader.functionUnits().firstOrNull({ _.name == "read" })
        let statements = method.statements()
        let returnedObject = (Object)statements.first
        let returned = (BoundReturnStatement)returnedObject
        let callObject = (Object)returned.value
        let call = (BoundCallExpression)callObject

        expect(call.target.ownerType.value()).toBe(items.semanticType.value())
        expect(call.receiver.semanticType.value()).toBe(items.semanticType.value())
    }

    async test `selects receiver owned overload using explicit cast type evidence`() {
        let stream = Lexer().lex(
            "class StringCharArray { equals(Object other) -> Bool { return equals((StringCharArray)other); } " +
                "equals(StringCharArray other) -> Bool { return true; } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:receiver-overload-bind"), "one"
        )
        let syntax = PrimitiveClassParser().parse(
            stream.consumeAll<Token>("data"), snapshot
        )
        let type = PrimitiveClassPartitionBinder().bind([syntax], snapshot).typeUnits().first
        let functions = type.functionUnits()
        let overloads = functions.filter({ _.name == "equals" })
        let objectOverload = overloads.first
        let statements = objectOverload.statements()
        let returnedObject = (Object)statements.first
        let returned = (BoundReturnStatement)returnedObject
        let callObject = (Object)returned.value
        let call = (BoundCallExpression)callObject
        let arguments = call.argumentValues()
        let argumentObject = (Object)arguments.first
        let argument = (BoundConversionExpression)argumentObject

        expect(objectOverload.parameterValues().first.semanticType.value()).toBe("builtin:Object")
        expect(call.target.ownerType.value()).toBe(type.semanticType.value())
        expect(call.target.parameterTypes().first.value()).toBe(type.semanticType.value())
        expect(argument.semanticType.value()).toBe(type.semanticType.value())
        expect(argument.conversion.conversionKind).toBe("reference-cast")
        expect(call.argumentConversions().first.conversionKind).toBe("identity")
    }

    test `binds child before parent input`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:partition-bind"), "one")
        let child = PrimitiveClassParser().parse(typeTokens("Child", "Parent", "2"), snapshot)
        let parent = PrimitiveClassParser().parse(typeTokens("Parent", null, "1"), snapshot)
        let types = PrimitiveClassPartitionBinder().bind([child, parent], snapshot).typeUnits()

        expect(types.count).toBe(2)
        expect(types.first.identity.name).toBe("Parent")
        expect(types.last.identity.name).toBe("Child")
        expect(types.last.parentType.value()).toBe(types.first.semanticType.value())
        expect(types.last.functionUnits().last.dispatchIdentity)
            .toBe(types.first.functionUnits().last.dispatchIdentity)
    }

    test `binds child and parent from distinct source snapshots`() {
        let parentSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:parent"), "one")
        let childSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:child"), "one")
        let child = PrimitiveClassParser().parse(typeTokens("Child", "Parent", "2"), childSnapshot)
        let parent = PrimitiveClassParser().parse(typeTokens("Parent", null, "1"), parentSnapshot)
        let types = PrimitiveClassPartitionBinder().bind([child, parent]).typeUnits()

        expect(types.first.range.snapshot).toBe(parentSnapshot)
        expect(types.last.range.snapshot).toBe(childSnapshot)
        expect(types.last.parentType.value()).toBe(types.first.semanticType.value())
    }

    test `binds package local construction in ordinary field initializer`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:partition-construction"), "one"
        )
        let stack = PrimitiveClassParser().parse(emptyTypeTokens("StackTrace"), snapshot)
        let exception = PrimitiveClassParser().parse([
            token("class", false), token("Exception", false), token("{", true),
            token("StackTrace", false), token("stackTrace", false), token("=", true),
            token("StackTrace", false), token("(", true), token(")", true), token(";", true),
            token("construct", false), token("(", true), token(")", true),
            token("{", true), token("}", true), token("}", true)
        ], snapshot)
        let types = PrimitiveClassPartitionBinder().bind([exception, stack], snapshot).typeUnits()
        let exceptionType = types.firstOrNull({ _.identity.name == "Exception" })
        let initializer = exceptionType.fieldUnits().first.initializer
        let object = (Object)initializer
        let construction = (BoundCallExpression)object

        let stackType = types.firstOrNull({ _.identity.name == "StackTrace" })
        expect(stackType).toNotBe(null)
    }

    test `rejects unknown construction and constructor arity mismatch`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:partition-construction-invalid"), "one"
        )
        var Int rejected
        try {
            let unknown = PrimitiveClassParser().parse([
                token("class", false), token("Owner", false), token("{", true),
                token("Missing", false), token("value", false), token("=", true),
                token("Missing", false), token("(", true), token(")", true), token(";", true),
                token("}", true)
            ], snapshot)
            PrimitiveClassPartitionBinder().bind([unknown], snapshot)
        } catch (Exception error) { rejected++ }
        try {
            let target = PrimitiveClassParser().parse(typeWithParameter("Target"), snapshot)
            let owner = PrimitiveClassParser().parse([
                token("class", false), token("Owner", false), token("{", true),
                token("Target", false), token("value", false), token("=", true),
                token("Target", false), token("(", true), token(")", true), token(";", true),
                token("}", true)
            ], snapshot)
            PrimitiveClassPartitionBinder().bind([owner, target], snapshot)
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
    }

    test `resolves structural arrays and functions without erasing element types`() {
        let resolver = PrimitiveStructuralTypeResolver()
        let arrayType = resolver.resolve("Object[]")
        let functionType = resolver.resolve("func(Object[],String)->Bool")

        expect(arrayType.value()).toBe("array:1:builtin:Object")
        expect(functionType.value())
            .toBe("function:(array:1:builtin:Object,builtin:String)->primitive:Bool")
    }

    test `rejects unknown structural types`() {
        var Int rejected
        try { PrimitiveStructuralTypeResolver().resolve("func()->Missing") }
        catch (Exception error) { rejected++ }
        expect(rejected).toBe(1)
    }

