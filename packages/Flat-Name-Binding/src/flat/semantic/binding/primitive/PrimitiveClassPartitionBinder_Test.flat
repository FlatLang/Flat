    async test `static Object metadata references declared owner identity without scalar aliasing`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:object-metadata"), "one")
        let stream = Lexer().lex("class Object {} class Class {} class Owner { read() { let metadata = Object.class; } }")
        stream.emit("start")
