    async test `binds nested indexed field before published generic contains call`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:indexed-field-call"), "one")
        let sources = [
            "class Array<E> implements List<E> { visible native_array var E[] data; this[Int index] <=> data[index] }",
            "class StringCharArray { visible native_array Char[] data; this[Int index] -> Char { get { return data[index]; } } }",
            "class String { visible StringCharArray chars; trim(Char[] charsToTrim, Int start) -> Bool { while (start < 1 && charsToTrim.contains(chars[start])) { start++; } return true; } localPrecedence(StringCharArray chars, Int start) -> Char { return chars[start]; } }"
        ]
        let traitStream = Lexer().lex("trait List<T> { public contains(T value) => true }")
        traitStream.emit("start")
        let contract = PrimitiveInterfaceParser().parse(traitStream.consumeAll<Token>("data"), snapshot)
        let syntaxes = PrimitiveClassSyntax[]
        var Int sourceIndex
        for (source in sources) {
            let sourceSnapshot = SourceSnapshotIdentity(
                SourceIdentity("memory:indexed-field-call:#{sourceIndex}"), "one")
            let stream = Lexer().lex(source)
            stream.emit("start")
            syntaxes.add(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), sourceSnapshot))
            sourceIndex++
        }
        let units = PrimitiveClassPartitionBinder().bind(syntaxes,
            interfaceSyntaxValues: [contract]).typeUnits()
        let string = units.firstOrNull({ _.identity.name == "String" })
        let trim = string.functionUnits().firstOrNull({ _.name == "trim" })
        let precedence = string.functionUnits().firstOrNull({ _.name == "localPrecedence" })
        expect(precedence.returnType.value()).toBe(SemanticTypes.charType().value())
        expect(trim.returnType.value()).toBe(SemanticTypes.boolType().value())
        let missingStream = Lexer().lex("class Missing { check(Int index) -> Char { return chars[index]; } }")
        missingStream.emit("start")
        let missing = PrimitiveClassParser().parse(missingStream.consumeAll<Token>("data"), snapshot)
        var String diagnostic
        try { PrimitiveClassPartitionBinder().bind([missing], snapshot) }
        catch (Exception error) { diagnostic = error.message }
        expect(diagnostic != null).toBe(true)
    }

    async test `binds indexed field through merged overlay and distinct source identities`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:canonical-string"), "one")
        let overlaySnapshot = SourceSnapshotIdentity(SourceIdentity("memory:overlay-string"), "one")
        let arraySnapshot = SourceSnapshotIdentity(SourceIdentity("memory:array"), "one")
        let charsSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:string-char-array"), "one")
        let arrayStream = Lexer().lex("class Array<E> { visible native_array var E[] data; this[Int index] <=> data[index] public contains(E value) -> Bool { return true; } }")
        arrayStream.emit("start")
        let charsStream = Lexer().lex("class StringCharArray { visible native_array Char[] data; this[Int index] -> Char { get { return data[index]; } } }")
        charsStream.emit("start")
        let canonicalStream = Lexer().lex("class String { visible native String data; public construct(native String nativeText) { data = nativeText; } visible Int count; visible StringCharArray chars; trimStart(var Int: start, Char[] charsToTrim) -> String { while (start <= count - 1 && charsToTrim.contains(chars[start])) { start++; } return start > count - 1 ? \"\" : substring(start, count); } substring(Int start, Int end) -> String { return this; } }")
        canonicalStream.emit("start")
        let overlayStream = Lexer().lex("class String { extension() -> Int { return 1; } }")
        overlayStream.emit("start")
        let canonical = PrimitiveClassParser().parse(canonicalStream.consumeAll<Token>("data"), snapshot)
        let overlay = PrimitiveClassParser().parse(overlayStream.consumeAll<Token>("data"), overlaySnapshot)
        let syntaxes = [
            PrimitiveClassParser().parse(arrayStream.consumeAll<Token>("data"), arraySnapshot),
            PrimitiveClassParser().parse(charsStream.consumeAll<Token>("data"), charsSnapshot),
            canonical.mergedWith(overlay)
        ]
        let contexts = syntaxes.map((syntax) => PrimitiveSourceBindingContext("flat", syntax.range.snapshot, [syntax]))
        let arrayIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(arraySnapshot, "class", syntaxes.first.range.startTokenIndex), "class", "Array")
        let units = PrimitiveClassPartitionBinder().bindContexts(contexts, arrayDeclaration: arrayIdentity).typeUnits()
        let string = units.firstOrNull({ _.identity.name == "String" })
        let trimStart = string.functionUnits().firstOrNull({ _.name == "trimStart" })
        expect(trimStart.returnType.value()).toBe(string.semanticType.value())
        let trimStatements = trimStart.statements()
        let returnedObject = (Object)trimStatements.last
        let returned = (BoundReturnStatement)returnedObject
        let conditionalObject = (Object)returned.value
        let conditional = (BoundConditionalExpression)conditionalObject
        let wrappedObject = (Object)conditional.whenTrue
        let wrapped = (BoundCallExpression)wrappedObject
        expect(wrapped.expressionKind()).toBe("call")
        expect(wrapped.target.callableKind.value).toBe("constructor")
        expect(wrapped.argumentValues().count).toBe(1)
        expect(wrapped.argumentValues().first.semanticType.value()).toBe(SemanticTypes.stringType().value())
        expect(conditional.whenFalse.semanticType.value()).toBe(string.semanticType.value())
    }

