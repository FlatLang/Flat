    }

    async test `namespace import admits two types and diagnoses colliding explicit type`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:namespace-import"), "one")
        let sources = ["class First { construct() {} }", "class Second { construct() {} }",
            "class First { construct() {} }", "class Use { run(First a, Second b) -> First { return a; } }"]
        let syntaxes = PrimitiveClassSyntax[]
        var Int offset
        for (source in sources) {
            let stream = Lexer().lex(source)
            stream.emit("start")
            syntaxes.add(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot, offset))
            offset += 100
        }
        let contexts = [PrimitiveSourceBindingContext("library", snapshot, [syntaxes[0], syntaxes[1]]),
            PrimitiveSourceBindingContext("other", snapshot, [syntaxes[2]]),
            PrimitiveSourceBindingContext("consumer", snapshot, [syntaxes[3]],
                importValues: [PrimitiveBindingImport("library", syntaxes[3].range)])]
        let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
        let method = units.firstOrNull({ _.identity.name == "Use" }).functionUnits().firstOrNull({ _.name == "run" })
        expect(method.returnType.value()).toBe(units.first.semanticType.value())
        let conflicting = PrimitiveSourceBindingContext("consumer", snapshot, [syntaxes[3]],
            importValues: [PrimitiveBindingImport("library", syntaxes[3].range),
                PrimitiveBindingImport("other/First", syntaxes[3].range)])
        let conflicts = PrimitiveSourceBindingContext[]
        conflicts.add(contexts[0])
        conflicts.add(contexts[1])
        conflicts.add(conflicting)
        var PrimitiveContextBindingException failure
        try { PrimitiveClassPartitionBinder().bindContexts(conflicts) }
        catch (PrimitiveContextBindingException error) { failure = error }
        if (!failure) throw Exception("Namespace collision accepted")
        expect(failure.diagnostic.code).toBe("binding.import-ambiguous")
        expect(failure.diagnostic.range).toBe(syntaxes[3].range)
        expect(failure.diagnostic.candidateValues.count).toBe(2)
    }

