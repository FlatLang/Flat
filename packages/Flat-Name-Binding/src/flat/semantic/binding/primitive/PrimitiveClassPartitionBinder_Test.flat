    async test `publishes inferred member result before reverse-ordered consumer`() {
        let consumerSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:inferred-consumer"), "one")
        let ownerSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:inferred-owner"), "one")
        let consumerStream = Lexer().lex(
            "class Reader { visible Int current; check(Array<Int> values, Int value) -> Bool { " +
            "while (value > 0 && values.contains(value)) { value--; } return true; } }"
        )
        consumerStream.emit("start")
        let consumer = PrimitiveClassParser().parse(
            consumerStream.consumeAll<Token>("data"), consumerSnapshot
        )
        let ownerStream = Lexer().lex(
            "class Array<E> { public contains(E value) => value != null }"
        )
        ownerStream.emit("start")
        let owner = PrimitiveClassParser().parse(ownerStream.consumeAll<Token>("data"), ownerSnapshot)
        let check = consumer.methodValues().firstOrNull({ _.name == "check" })
        expect(check.statements().first.statementKind()).toBe("while")
        let statement = check.statements().first
        let whileValue = (PrimitiveWhileSyntax)statement
        let condition = whileValue.condition
        expect(condition.expressionKind()).toBe("binary")
        let binary = (PrimitiveBinarySyntax)condition
        let right = binary.right
        expect(right.expressionKind()).toBe("member-call")
        let call = (PrimitiveMemberCallSyntax)right
        expect(call.memberName).toBe("contains")
        expect(call.receiver.expressionKind()).toBe("reference")
        let forward = PrimitiveClassPartitionBinder().bind([owner, consumer]).typeUnits()
        expect(forward.firstOrNull({ _.identity.name == "Reader" }).functionUnits()
            .firstOrNull({ _.name == "check" }).returnType.value())
            .toBe(SemanticTypes.boolType().value())
        let bound = PrimitiveClassPartitionBinder().bind([consumer, owner]).typeUnits()
        expect(bound.firstOrNull({ _.identity.name == "Reader" }).functionUnits()
            .firstOrNull({ _.name == "check" }).returnType.value())
            .toBe(SemanticTypes.boolType().value())
    }

