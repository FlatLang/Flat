    async test `published generic array callbacks retain element members captures and overload checks`() {
        for (index in 0..4) {
            let contexts = PrimitiveSourceBindingContext[]
            let bodies = ["_.code == requested", "_.missing == requested", "_.code + requested", "_.code == requested"]
            let sources = [
                "class Entry { construct(visible Int code) {} }",
                "class Array<E> { public select(func(E)->Bool predicate) -> E { return null; } " +
                    (index == 3 ? "public select(func(E)->Int predicate) -> E { return null; } " : "") + "}",
                "class Catalog { find(Entry[] entries, Int requested) -> Entry { return entries.select({ " + bodies[index] + " }); } }"
            ]
            for (sourceIndex in 0..sources.count) {
                let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:structural-callback:#{index}:#{sourceIndex}"), "one")
                let stream = Lexer().lex(sources[sourceIndex])
                stream.emit("start")
                let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
                contexts.add(PrimitiveSourceBindingContext(sourceIndex == 1 ? "flat/datastruct/list" : "app",
                    snapshot, [syntax]))
            }
            if (index == 1 || index == 2) {
                var Bool rejected = false
                try { PrimitiveClassPartitionBinder().bindContexts(contexts) }
                catch (Exception error) { rejected = true }
                expect(rejected).toBe(true)
            } else {
                let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
                let find = units.firstOrNull({ _.identity.name == "Catalog" }).functionUnits().firstOrNull({ _.name == "find" })
                let statement = find.statements().first
                let returned = (BoundReturnStatement)statement
                let call = (BoundCallExpression)returned.value
                expect(call.target.name).toBe("select")
                expect(call.receiver.semanticType.value()).toBe(find.parameterValues().first.semanticType.value())
                expect(call.target.returnType.value()).toBe(find.returnType.value())
                let argument = call.argumentValues().first
                let callback = (BoundLambdaExpression)argument
                expect(callback.parameterValues().first.semanticType.value()).toBe(find.returnType.value())
                expect(callback.captureValues().count).toBe(1)
                expect(callback.captureValues().first.name).toBe("requested")
                expect(callback.body.semanticType.value()).toBe(SemanticTypes.boolType().value())
            }
        }
    }

