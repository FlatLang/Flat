    async test `target member imports remain source local after canonical merge`() {
        let baseSnapshot = SourceSnapshotIdentity(SourceIdentity("flat/datastruct/list/Array.flat"), "compiler-input")
        let overlaySnapshot = SourceSnapshotIdentity(SourceIdentity("flat/datastruct/list/Array.js.flat"), "compiler-input")
        let traitSnapshot = SourceSnapshotIdentity(SourceIdentity("flat/operators/PlusOperator.flat"), "compiler-input")
        let baseStream = Lexer().lex("class Array<E> { construct() {} }")
        baseStream.emit("start")
        let base = PrimitiveClassParser().parse(baseStream.consumeAll<Token>("data"), baseSnapshot)
        let overlayStream = Lexer().lex("class Array<E> { public identity(PlusOperator<Array<E>, Array<E>> value) -> Array<E> { return this; } }")
        overlayStream.emit("start")
        let overlay = PrimitiveClassParser().parse(overlayStream.consumeAll<Token>("data"), overlaySnapshot)
        let traitStream = Lexer().lex("trait PlusOperator<In, Out> { public plus(In another) -> Out }")
        traitStream.emit("start")
        let contract = PrimitiveInterfaceParser().parse(traitStream.consumeAll<Token>("data"), traitSnapshot)
        let empty = PrimitiveClassSyntax[]
        let contexts = [PrimitiveSourceBindingContext("flat/datastruct/list", baseSnapshot, [base.mergedWith(overlay)],
                importValues: [PrimitiveBindingImport("flat/operators", base.range)]),
            PrimitiveSourceBindingContext("flat/datastruct/list", overlaySnapshot, empty),
            PrimitiveSourceBindingContext("flat/operators", traitSnapshot, empty, [contract])]
        // A canonical merge shares members, not the base source's lexical imports.
        for (mode in 0..2) {
            let PrimitiveSourceBindingContext[] inputs = mode == 0 ? contexts : contexts.reverse()
            var PrimitiveContextBindingException missing
            try { PrimitiveClassPartitionBinder().bindContexts(inputs) }
            catch (PrimitiveContextBindingException error) { missing = error }
            if (!missing) throw Exception("Importless overlay borrowed canonical imports")
            expect(missing.diagnostic.code).toBe("binding.type-unresolved")
            expect(missing.diagnostic.range.snapshot).toBe(overlaySnapshot)
        }
        contexts[1] = PrimitiveSourceBindingContext("flat/datastruct/list", overlaySnapshot, empty,
            importValues: [PrimitiveBindingImport("flat/operators/PlusOperator", overlay.range)])
        let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
        expect(units.first.functionUnits().firstOrNull({ _.name == "identity" }).returnType.kind()).toBe("generic-instance")
        expect(units.first.functionUnits().firstOrNull({ _.name == "identity" }).range.snapshot).toBe(overlaySnapshot)
        let reversed = PrimitiveClassPartitionBinder().bindContexts(contexts.reverse()).typeUnits()
        expect(reversed.map({ _.identity.value })).toBe(units.map({ _.identity.value }))
        let conflictingSnapshot = SourceSnapshotIdentity(SourceIdentity("other/PlusOperator.flat"), "compiler-input")
        let conflictingStream = Lexer().lex("trait PlusOperator<In, Out> { public plus(In another) -> Out }")
        conflictingStream.emit("start")
        let conflicting = PrimitiveInterfaceParser().parse(conflictingStream.consumeAll<Token>("data"), conflictingSnapshot)
        let collisions = PrimitiveSourceBindingContext[]
        collisions.add(contexts.first)
        collisions.add(PrimitiveSourceBindingContext("flat/datastruct/list", overlaySnapshot, empty,
            importValues: [PrimitiveBindingImport("other", overlay.range)]))
        collisions.add(contexts.last)
        collisions.add(PrimitiveSourceBindingContext("other", conflictingSnapshot, empty, [conflicting]))
        // A different qualified import in the overlay is valid despite the base's
        // identically named import. Ambiguity exists only within one lexical source.
        for (mode in 0..2) {
            let PrimitiveSourceBindingContext[] inputs = mode == 0 ? collisions : collisions.reverse()
            let bound = PrimitiveClassPartitionBinder().bindContexts(inputs).typeUnits().first
            let parameter = bound.functionUnits().firstOrNull({ _.name == "identity" }).parameterValues().first
            let parameterObject = (Object)parameter.semanticType
            let instance = (GenericInstanceSemanticType)parameterObject
            expect(instance.declarationType.declarationIdentity.syntaxIdentity.snapshot).toBe(conflictingSnapshot)
        }
        collisions[1] = PrimitiveSourceBindingContext("flat/datastruct/list", overlaySnapshot, empty,
            importValues: [PrimitiveBindingImport("other/PlusOperator", overlay.range),
                PrimitiveBindingImport("flat/operators/PlusOperator", overlay.range)])
        var PrimitiveContextBindingException failure
        try { PrimitiveClassPartitionBinder().bindContexts(collisions) }
        catch (PrimitiveContextBindingException error) { failure = error }
        if (!failure) throw Exception("Overlay import collision accepted")
        expect(failure.diagnostic.code).toBe("binding.import-ambiguous")
        expect(failure.diagnostic.range.snapshot).toBe(overlaySnapshot)
        let candidates = failure.diagnostic.candidateValues
        failure = null
        try { PrimitiveClassPartitionBinder().bindContexts(collisions.reverse()) }
        catch (PrimitiveContextBindingException error) { failure = error }
        if (!failure) throw Exception("Reverse overlay collision accepted")
        expect(failure.diagnostic.candidateValues).toBe(candidates)
    }

    async test `resolves imported operator contract for generic owner`() {
        let traitSnapshot = SourceSnapshotIdentity(SourceIdentity("flat/operators/PlusOperator.flat"), "compiler-input")
        let ownerSnapshot = SourceSnapshotIdentity(SourceIdentity("flat/primitive/Number.flat"), "compiler-input")
        let traitStream = Lexer().lex("trait PlusOperator<In, Out> { public plus(In another) -> Out }")
        traitStream.emit("start")
        let contract = PrimitiveInterfaceParser().parse(traitStream.consumeAll<Token>("data"), traitSnapshot)
        let ownerStream = Lexer().lex("class Number<E> implements PlusOperator<Number<E>, Number<E>> { construct() {} public plus(Number<E> another) -> Number<E> { return this; } }")
        ownerStream.emit("start")
        let owner = PrimitiveClassParser().parse(ownerStream.consumeAll<Token>("data"), ownerSnapshot)
        let empty = PrimitiveClassSyntax[]
        let contexts = [PrimitiveSourceBindingContext("flat/operators", traitSnapshot, empty, [contract]),
            PrimitiveSourceBindingContext("flat/primitive", ownerSnapshot, [owner],
                importValues: [PrimitiveBindingImport("flat/operators", owner.range)])]
        let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
        expect(units.first.functionUnits().firstOrNull({ _.name == "plus" }).returnType.kind()).toBe("generic-instance")
    }

    async test `logical reference operands bind Bool guards and reject numeric operands`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:logical-reference"), "one")
        let sources = ["class Object { construct() {} }",
            "class Use { run(Object other, Bool enabled) -> Bool { return (other || enabled) && other; } }"]
        let syntaxes = PrimitiveClassSyntax[]
        var Int offset
        for (source in sources) {
            let stream = Lexer().lex(source)
            stream.emit("start")
            syntaxes.add(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot, offset))
            offset += 100
        }
        let context = PrimitiveSourceBindingContext("", snapshot, syntaxes)
        let units = PrimitiveClassPartitionBinder().bindContexts([context]).typeUnits()
        let method = units.last.functionUnits().firstOrNull({ _.name == "run" })
        let body = method.statements()
        var BoundReturnStatement returned
        returned = (BoundReturnStatement)body.first
        var BoundBinaryExpression logical
        logical = (BoundBinaryExpression)returned.value
        expect(logical.left.semanticType.value()).toBe(SemanticTypes.boolType().value())
        expect(logical.right.expressionKind()).toBe("binary")
        let invalidStream = Lexer().lex("class Invalid { run(Int value) -> Bool { return value || true; } }")
        invalidStream.emit("start")
        let invalid = PrimitiveClassParser().parse(invalidStream.consumeAll<Token>("data"), snapshot)
        var String failure
        try { PrimitiveClassPartitionBinder().bind([invalid]) }
        catch (Exception error) { failure = error.message }
        if (!failure) throw Exception("Numeric logical operand accepted")
    }

