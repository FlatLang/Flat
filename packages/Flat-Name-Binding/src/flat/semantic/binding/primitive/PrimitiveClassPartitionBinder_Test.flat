    async test `declared String collection arguments preserve lexical identity`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:string-type-argument"), "one")
        let stream = Lexer().lex("class String { construct() {} }")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let arrayStream = Lexer().lex("class Array<E> { construct() {} }")
        arrayStream.emit("start")
        let array = PrimitiveClassParser().parse(arrayStream.consumeAll<Token>("data"), snapshot, 100)
        let scope = PrimitiveResolvedDeclarationContext(PrimitiveSourceBindingContext("flat", snapshot, [syntax, array]),
            [PrimitiveSourceBindingContext("flat", snapshot, [syntax, array])])
        let resolver = PrimitiveStructuralTypeResolver(declarationContext: scope, lookupRange: syntax.range)
        let bracketObject = (Object)resolver.resolve("String[]")
        let bracket = (GenericInstanceSemanticType)bracketObject
        expect(bracket.typeArguments().first.value()).toBe(UserClassSemanticType(scope.classIdentity(syntax)).value())
        expect(resolver.resolve("Array<String>").value()).toBe(bracket.value())
        expect(resolver.resolve("String").value()).toBe(UserClassSemanticType(scope.classIdentity(syntax)).value())
    }

