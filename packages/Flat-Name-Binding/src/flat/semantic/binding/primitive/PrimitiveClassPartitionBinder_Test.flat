    }

    async test `same named contracts retain selected source declaration identities`() {
        let contexts = PrimitiveSourceBindingContext[]
        let expected = DeclarationIdentity[]
        let namespaces = ["left", "right"]
        for (namespace in namespaces) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:#namespace-interface-identity"), "one")
            let traitStream = Lexer().lex("trait Contract { read(Int value) -> Int }")
            traitStream.emit("start")
            let contract = PrimitiveInterfaceParser().parse(traitStream.consumeAll<Token>("data"), snapshot)
            let classStream = Lexer().lex("class Reader { read(Contract value) -> Int { return value.read(42); } }")
            classStream.emit("start")
            let syntax = PrimitiveClassParser().parse(classStream.consumeAll<Token>("data"), snapshot, 100)
            contexts.add(PrimitiveSourceBindingContext(namespace, snapshot, [syntax], [contract]))
            let member = contract.methodValues().first
            expected.add(DeclarationIdentity(SyntaxIslandIdentity(snapshot, "instance-method", member.range.startTokenIndex),
                "instance-method", "read"))
        }
        for (mode in 0..2) {
            let PrimitiveSourceBindingContext[] inputs = mode == 0 ? contexts : contexts.reverse()
            let units = PrimitiveClassPartitionBinder().bindContexts(inputs).typeUnits()
            for (unit in units) {
                let function = unit.functionUnits().firstOrNull({ _.name == "read" })
                let functionStatements = function.statements()
                let statementObject = (Object)functionStatements.first
                let returned = (BoundReturnStatement)statementObject
                let expressionObject = (Object)returned.value
                let call = (BoundCallExpression)expressionObject
                let selected = expected.firstOrNull({ _.syntaxIdentity.snapshot == function.range.snapshot })
                expect(call.target.identity.declaration.value).toBe(selected.value)
                expect(call.target.ownerType.declarationIdentity.syntaxIdentity.snapshot).toBe(function.range.snapshot)
            }
        }
        expect(expected.first.value != expected.last.value).toBe(true)
    }

    async test `asynchronous named method evidence survives binding and default copying`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:async-external-bound-publication"), "one")
        let traitStream = Lexer().lex("trait Runtime { async external_name native text() -> String { return \"ok\"; } }")
        traitStream.emit("start")
        let contract = PrimitiveInterfaceParser().parse(traitStream.consumeAll<Token>("data"), snapshot)
        let classStream = Lexer().lex("class Reader implements Runtime { async native forward() -> String { return text(); } }")
        classStream.emit("start")
        let syntax = PrimitiveClassParser().parse(classStream.consumeAll<Token>("data"), snapshot, 100)
        let result = PrimitiveClassPartitionBinder().bindContexts([
            PrimitiveSourceBindingContext("flat", snapshot, [syntax], [contract])]).typeUnits().first
        let method = result.functionUnits().firstOrNull({ _.name == "text" })
        expect(method.asyncFunction).toBe(true)
        expect(method.externalName).toBe("text")
        expect(method.returnType.kind()).toBe("string")
        expect(method.range).toBe(contract.methodValues().first.range)
        expect(method.identity.syntaxIdentity.snapshot).toBe(snapshot)
        let forward = result.functionUnits().firstOrNull({ _.name == "forward" })
        let forwardStatements = forward.statements()
        let statementObject = (Object)forwardStatements.first
        let returned = (BoundReturnStatement)statementObject
        let callObject = (Object)returned.value
        let call = (BoundCallExpression)callObject
        expect(call.target.asyncFunction).toBe(true)
        expect(call.target.externalName).toBe("text")
    }

