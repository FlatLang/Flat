    async test `explicit generic prefix local input requires canonical callback boxing`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:partial-explicit-local"), "one")
        let stream = Lexer().lex("class Value { static async all<Out, In>(In value, async callback(In value) -> Out, Int limit, async after(Int count)) -> Out { return callback(value); } static async run(Int input) -> Bool { return Value.all<Bool>(input, { _ == 1 }, 2, {}); } }")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        var String failure
        try { PrimitiveClassPartitionBinder().bind([syntax], snapshot) }
        catch (Exception error) { failure = error.message }
        if (!failure) throw Exception("Generic callback accepted without canonical Bool boxing evidence")
        expect(failure.contains("canonical boxing declaration")).toBe(true)
        let contexts = [PrimitiveSourceBindingContext("app", snapshot, [syntax])]
        admitCallbackScalar(contexts, "Bool")
        let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
        let method = units.firstOrNull({ _.identity.name == "Value" }).functionUnits().firstOrNull({ _.name == "run" })
        let statements = method.statements()
        Object returnSource = statements.first
        BoundReturnStatement returned = (BoundReturnStatement)returnSource
        Object callSource = returned.value
        BoundCallExpression call = (BoundCallExpression)callSource
        expect(call.target.returnType.value()).toBe(SemanticTypes.boolType().value())
        expect(call.target.parameterTypes().first.value()).toBe(SemanticTypes.intType().value())
        let arguments = call.argumentValues()
        Object callbackSource = arguments[1]
        BoundLambdaExpression callback = (BoundLambdaExpression)callbackSource
        Object callbackTypeSource = callback.semanticType
        FunctionSemanticType callbackType = (FunctionSemanticType)callbackTypeSource
        expect(callbackType.parameterTypes().first.value()).toBe(SemanticTypes.intType().value())
        expect(callbackType.returnType.value()).toBe(SemanticTypes.boolType().value())
        expect(callbackType.asyncFunction).toBe(true)
        expect(callback.declarationContract.returnType.kind()).toBe("generic-parameter")
        expect(callback.resultBoxingConstructor.ownerType.declarationIdentity.name).toBe("Bool")
    }

