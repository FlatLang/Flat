    async test `native text adapter rejects absent ambiguous and missing constructor evidence`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:text-adapter-evidence"), "one")
        let stream = Lexer().lex("class String {}")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let source = PrimitiveSourceBindingContext("flat", snapshot, [syntax])
        let competingSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:text-adapter-competing"), "one")
        let competingStream = Lexer().lex("class String {}")
        competingStream.emit("start")
        let competingSyntax = PrimitiveClassParser().parse(competingStream.consumeAll<Token>("data"), competingSnapshot)
        let competing = PrimitiveSourceBindingContext("flat", competingSnapshot, [competingSyntax])
        let scopes = [PrimitiveResolvedDeclarationContext(source, PrimitiveSourceBindingContext[]),
            PrimitiveResolvedDeclarationContext(source, [source, competing]),
            PrimitiveResolvedDeclarationContext(source, [source])]
        let owner = UserClassSemanticType(PrimitiveResolvedDeclarationContext(source, [source]).classIdentity(syntax))
        let value = BoundLiteralExpression(syntax.range, SemanticTypes.stringType(), "\"x\"")
        var Int index
        for (scope in scopes) {
            var String failure
            try { PrimitiveStringAdapter.wrap(value, owner, scope, CallableSignature[]) }
            catch (Exception error) { failure = error.message }
            if (!failure) throw Exception("Native text receiver accepted without unique canonical evidence")
            let expected = index++ < 2 ? "one canonical flat/String declaration" : "one canonical native text constructor"
            expect(failure.contains(expected)).toBe(true)
        }
    }

