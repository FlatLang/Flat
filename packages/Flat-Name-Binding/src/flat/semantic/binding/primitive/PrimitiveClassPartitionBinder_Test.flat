        let empty = PrimitiveClassSyntax[]
        let contexts = [PrimitiveSourceBindingContext("consumer", baseSnapshot, [merged]),
            PrimitiveSourceBindingContext("consumer", overlaySnapshot, empty,
                importValues: [PrimitiveBindingImport("widgets/Widget", syntaxes[1].range)]),
