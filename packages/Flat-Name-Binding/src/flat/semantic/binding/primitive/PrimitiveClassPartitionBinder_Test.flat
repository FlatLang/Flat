        let stream = Lexer().lex("class Bag<E> { visible native_array var E[] data; this[Int index] <=> data[index] public remove(Int index) -> E { return data[index]; } public removeWhere(func(E value, Int index, Bag<E> owner) -> Bool callback) -> E[] { let removed = E[]; for (var Int i = 2; i >= 0; i--) { if (callback(this[i], i, this)) { removed.add(remove(i)); } } return removed; } }")
