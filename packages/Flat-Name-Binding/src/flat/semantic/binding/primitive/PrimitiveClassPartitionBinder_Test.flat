package flat/semantic/binding/primitive

import flat/compiler/models
import flat/parser/flat
import flat/bound
import flat/lexer/Lexer
import flat/semantic/types

testable class {
    async test `resolves published static call from instance method and respects local shadowing`() {
        let dependency = Lexer().lex("class Helpers { static read(Int value) -> Int { return value; } }")
        dependency.emit("start")
        let helper = PrimitiveClassParser().parse(dependency.consumeAll<Token>("data"),
            SourceSnapshotIdentity(SourceIdentity("memory:helper"), "one"))
        let stream = Lexer().lex("class Caller { run() -> Int { return Helpers.read(42); } }")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"),
            SourceSnapshotIdentity(SourceIdentity("memory:caller"), "one"))
        let bound = PrimitiveClassPartitionBinder().bind([syntax, helper]).typeUnits()
        expect(bound.count).toBe(2)
        let shadowed = Lexer().lex("class Caller { run(Int Helpers) -> Int { return Helpers.read(42); } }")
        shadowed.emit("start")
        let shadowSyntax = PrimitiveClassParser().parse(shadowed.consumeAll<Token>("data"),
            SourceSnapshotIdentity(SourceIdentity("memory:shadow"), "one"))
        var String failure
        try { PrimitiveClassPartitionBinder().bind([shadowSyntax, helper]) }
        catch (Exception error) { failure = error.message }
        expect(failure != null).toBe(true)
    }

    async test `isolates generic async mapping implicit callback frontier`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:map-parallel-body"), "one")
        let stream = Lexer().lex(
            "class List<Type> { toArray() -> Type[] { return null; } " +
            "public async mapParallel<Out>(async mapFunc(Type x, Int i, List<Type> list) -> Out, Int maxParallel = -1, async onAfterChunk(Int count) = {}) -> Out[] { " +
            "return Async.all(toArray(), { mapFunc(_, _, this) }, maxParallel, onAfterChunk); } }"
        )
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let dependency = Lexer().lex(
            "class Async { public static async all<Out, In>(In[] values, async toPromise(In value, Int index) -> Out, Int maxParallel = -1, async onAfterChunk(Int count) = {}) -> Out[] { return null; } }"
        )
        dependency.emit("start")
        let asyncSyntax = PrimitiveClassParser().parse(dependency.consumeAll<Token>("data"),
            SourceSnapshotIdentity(SourceIdentity("memory:async-signature"), "one"))
        var String failure
        try { PrimitiveClassPartitionBinder().bind([syntax, asyncSyntax]) }
        catch (Exception error) { failure = error.message }
        expect(failure.contains("Unknown local '_'")).toBe(true)
    }

    async test `binds canonical mapParallel signature and defaults`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:map-parallel-signature"), "one")
        let stream = Lexer().lex(
            "class List<Type> { public async mapParallel<Out>(async mapFunc(Type x, Int i, List<Type> list) -> Out, Int maxParallel = -1, async onAfterChunk(Int count) = {}) -> List<Out> { return null; } }"
        )
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let type = PrimitiveClassPartitionBinder().bind([syntax], snapshot).typeUnits().first
        let method = type.functionUnits().firstOrNull({ _.name == "mapParallel" })
        let parameters = method.parameterValues()
        let callback = (FunctionSemanticType)parameters[0].semanticType
        expect(callback.asyncFunction).toBe(true)
        let afterChunk = (FunctionSemanticType)parameters[2].semanticType
        expect(afterChunk.asyncFunction).toBe(true)
        let defaultType = parameters[2].defaultValue.semanticType
        let defaultCallback = (FunctionSemanticType)defaultType
        expect(defaultCallback.asyncFunction).toBe(true)
        expect(callback.parameterTypes().count).toBe(3)
        expect(callback.parameterTypes()[0].kind()).toBe("generic-parameter")
        expect(callback.parameterTypes()[2].kind()).toBe("generic-instance")
        expect(callback.returnType.kind()).toBe("generic-parameter")
        expect(method.returnType.kind()).toBe("generic-instance")
        let resultType = (GenericInstanceSemanticType)method.returnType
        expect(resultType.typeArguments().first.value()).toBe(callback.returnType.value())
        let callbackParameters = callback.parameterTypes()
        let listParameterObject = (Object)callbackParameters[2]
        let listParameter = (GenericInstanceSemanticType)listParameterObject
        expect(listParameter.typeArguments().first.value()).toBe(callbackParameters.first.value())
        let statements = method.statements()
        let statementObject = (Object)statements.first
        let statement = (BoundReturnStatement)statementObject
        expect(statement.conversion.conversionKind).toBe("null-reference-return")
        expect(statement.requiredType.value()).toBe(method.returnType.value())
        expect(statement.value.semanticType.kind()).toBe("null")
        expect(parameters[1].defaultValue.semanticType.value()).toBe("primitive:Int")
        expect(parameters[2].defaultValue.semanticType.value()).toBe(parameters[2].semanticType.value())
    }

    async test `rejects null return for unconstrained generic parameter`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:generic-null-invalid"), "one")
        let stream = Lexer().lex("class Box { empty<Out>() -> Out { return null; } }")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        var String failure
        try { PrimitiveClassPartitionBinder().bind([syntax], snapshot) }
        catch (Exception error) { failure = error.message }
        expect(failure.contains("cannot return 'null'")).toBe(true)
    }

    async test `binds generic method parameter and return identity`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:generic-method-binding"), "one"
        )
        let stream = Lexer().lex("class Box { identity<Out>(Out value) -> Out { return value; } " +
            "run() -> Int { return identity(42); } }")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let bound = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let method = bound.functionUnits().firstOrNull({ _.name == "identity" })
        expect(method.returnType.kind()).toBe("generic-parameter")
        let partition = PrimitiveClassPartitionBinder().bind([syntax], snapshot).typeUnits().first
        let partitionMethod = partition.functionUnits().firstOrNull({ _.name == "identity" })
        expect(partitionMethod.returnType.value()).toBe(method.returnType.value())
    }

    test `resolves generic collection of callbacks`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:callback-collection"), "one"
        )
        let identity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", 0), "class", "List"
        )
        let listType = UserClassSemanticType(identity)
        let resolver = PrimitiveStructuralTypeResolver(callables: [CallableSignature(
            SymbolIdentity(identity, "constructor"), "List", CallableKind("constructor"),
            SemanticType[], listType, listType
        )])
        let resolved = resolver.resolve("List<func(Int)->Bool[]>")
        expect(resolved.kind()).toBe("generic-instance")
        let list = (GenericInstanceSemanticType)resolved
        let argument = list.typeArguments().first
        expect(argument.kind()).toBe("function")
        let callback = (FunctionSemanticType)argument
        expect(callback.parameterTypes().first.value()).toBe(SemanticTypes.intType().value())
        expect(callback.returnType.kind()).toBe("array")
        let array = (ArraySemanticType)callback.returnType
        expect(array.elementType.value()).toBe(SemanticTypes.boolType().value())
    }

    test `resolves callback returning generic array`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:callback-array-return"), "one"
        )
        let identity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "instance-method", 0), "instance-method", "map"
        )
        let parameter = GenericParameterSemanticType(identity, "Out", 0)
        let resolved = PrimitiveStructuralTypeResolver(
            methodGenericParameters: [parameter]
        ).resolve("async func(Int)->Out[]")
        expect(resolved.kind()).toBe("function")
        let callback = (FunctionSemanticType)resolved
        expect(callback.returnType.kind()).toBe("array")
        let array = (ArraySemanticType)callback.returnType
        expect(array.elementType.value()).toBe(parameter.value())
        expect(callback.parameterTypes().first.value()).toBe(SemanticTypes.intType().value())
    }

    test `resolves method generic scope`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:generic-scope"), "one"
        )
        let identity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", 0), "class", "List"
        )
        let parameter = GenericParameterSemanticType(identity, "Out", 0)
        let methodIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "instance-method", 10), "instance-method", "map"
        )
        let methodParameter = GenericParameterSemanticType(methodIdentity, "Out", 0)
        let parameters = [methodParameter]
        let resolver = PrimitiveStructuralTypeResolver(
            genericParameter: parameter, methodGenericParameters: parameters
        )
        parameters.clear()
        expect(resolver.resolve("Out").value()).toBe(methodParameter.value())
        let resolved = resolver.resolve("async func(Out,Int)->Out")
        let callback = (FunctionSemanticType)resolved
        expect(callback.returnType.value()).toBe(methodParameter.value())
        expect(callback.parameterTypes().first.value()).toBe(methodParameter.value())
        var Bool rejected
        try {
            PrimitiveStructuralTypeResolver(methodGenericParameters: [parameter, parameter])
        } catch (Exception error) {
            rejected = true
        }
        expect(rejected).toBe(true)
    }

    test `resolves nested generic async callback signature`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:map-parallel-signature-bind"), "one"
        )
        let identity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", 0), "class", "List"
        )
        let listType = UserClassSemanticType(identity)
        let resolved = PrimitiveStructuralTypeResolver(
            callables: [CallableSignature(
                SymbolIdentity(identity, "constructor"), "List",
                CallableKind("constructor"), SemanticType[], listType, listType
            )],
            genericParameter: GenericParameterSemanticType(identity, "Type", 0)
        ).resolve("async func(Type,Int,List<Type>)->Type")

        expect(resolved.kind()).toBe("function")
        let callback = (FunctionSemanticType)resolved
        expect(callback.asyncFunction).toBe(true)
        expect(callback.parameterTypes().count).toBe(3)
        expect(callback.parameterTypes()[0].kind()).toBe("generic-parameter")
        expect(callback.parameterTypes()[1].value()).toBe(SemanticTypes.intType().value())
        let parameterTypes = callback.parameterTypes()
        let listParameter = parameterTypes[2]
        let listTypeArgument = ((GenericInstanceSemanticType)listParameter).typeArguments().first
        expect(listTypeArgument.value()).toBe(parameterTypes[0].value())
        expect(callback.returnType.value()).toBe(callback.parameterTypes()[0].value())
    }

    test `resolves nested callback before following parameter`() {
        let type = PrimitiveStructuralTypeResolver().resolve(
            "func(func(Int)->Bool,Int)->Bool"
        )
        let resolved = (FunctionSemanticType)type
        expect(resolved.parameterTypes().count).toBe(2)
        let firstParameter = resolved.parameterTypes().first
        let callback = (FunctionSemanticType)firstParameter
        expect(callback.parameterTypes().first.value()).toBe(SemanticTypes.intType().value())
        expect(callback.returnType.value()).toBe(SemanticTypes.boolType().value())
        expect(resolved.parameterTypes()[1].value()).toBe(SemanticTypes.intType().value())
        expect(resolved.returnType.value()).toBe(SemanticTypes.boolType().value())
    }

    async test `selects projected constructor field by owner`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:projected-constructor-field-bind"), "one"
        )
        let rangeStream = Lexer().lex(
            "class Range { construct() {} construct(public Int start, public Int end) {} }"
        )
        rangeStream.emit("start")
        let iteratorStream = Lexer().lex(
            "class RangeIterator { construct(private Range range) {} " +
                "Bool hasNext => range.end > 0 }"
        )
        iteratorStream.emit("start")
        let types = PrimitiveClassPartitionBinder().bind([
            PrimitiveClassParser().parse(
                rangeStream.consumeAll<Token>("data"), snapshot
            ),
            PrimitiveClassParser().parse(
                iteratorStream.consumeAll<Token>("data"), snapshot
            )
        ], snapshot).typeUnits()
        let rangeType = types.firstOrNull({ _.identity.name == "Range" })
        let iterator = types.firstOrNull({ _.identity.name == "RangeIterator" })
        expect(iterator.functionUnits().firstOrNull({ _.name == "hasNext" })
            .statements().first.unitKind()).toBe("return")
        expect(rangeType.fieldUnits().firstOrNull({ _.name == "end" }).name).toBe("end")
    }

    async test `selects projected receiver property by owner`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:projected-property-owner-bind"), "one"
        )
        let objectStream = Lexer().lex(
            "class Object { hashCodeLong() -> Long { return 0; } }"
        )
        objectStream.emit("start")
        let itemsStream = Lexer().lex("class Items {}")
        itemsStream.emit("start")
        let readerStream = Lexer().lex(
            "class Reader { read(Items items) -> Long { return items.hashCodeLong; } }"
        )
        readerStream.emit("start")
        let types = PrimitiveClassPartitionBinder().bind([
            PrimitiveClassParser().parse(
                objectStream.consumeAll<Token>("data"), snapshot
            ),
            PrimitiveClassParser().parse(
                itemsStream.consumeAll<Token>("data"), snapshot
            ),
            PrimitiveClassParser().parse(
                readerStream.consumeAll<Token>("data"), snapshot
            )
        ], snapshot).typeUnits()
        let items = types.firstOrNull({ _.identity.name == "Items" })
        let reader = types.firstOrNull({ _.identity.name == "Reader" })
        let method = reader.functionUnits().firstOrNull({ _.name == "read" })
        let statements = method.statements()
        let returnedObject = (Object)statements.first
        let returned = (BoundReturnStatement)returnedObject
        let callObject = (Object)returned.value
        let call = (BoundCallExpression)callObject

        expect(call.target.ownerType.value()).toBe(items.semanticType.value())
        expect(call.receiver.semanticType.value()).toBe(items.semanticType.value())
    }

    async test `selects projected receiver array accessor by owner`() {
        let snapshot = SourceSnapshotIdentity(
