    async test `member lexical scopes keep configured defaults separate while canonical members remain shared`() {
        let baseSnapshot = SourceSnapshotIdentity(SourceIdentity("app/Owner.flat"), "one")
        let overlaySnapshot = SourceSnapshotIdentity(SourceIdentity("app/Owner.js.flat"), "one")
        let leftSnapshot = SourceSnapshotIdentity(SourceIdentity("left/Choice.flat"), "one")
        let rightSnapshot = SourceSnapshotIdentity(SourceIdentity("right/Choice.flat"), "one")
        let snapshots = [baseSnapshot, overlaySnapshot, leftSnapshot, rightSnapshot]
        let sources = ["class Owner { base() -> Int { return 1; } }",
            "class Owner { overlay() -> Int { return base(); } }",
            "class Choice {}", "class Choice {}"]
        let syntaxes = PrimitiveClassSyntax[]
        var Int index
        for (source in sources) {
            let stream = Lexer().lex(source)
            stream.emit("start")
            syntaxes.add(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshots[index++]))
        }
        let merged = syntaxes.first.mergedWith(syntaxes[1])
        let contexts = [PrimitiveSourceBindingContext("app", baseSnapshot, [merged],
                defaultImports: [PrimitiveDefaultImport("left/Choice")]),
            PrimitiveSourceBindingContext("app", overlaySnapshot, PrimitiveClassSyntax[],
                defaultImports: [PrimitiveDefaultImport("right/Choice")]),
            PrimitiveSourceBindingContext("left", leftSnapshot, [syntaxes[2]]),
            PrimitiveSourceBindingContext("right", rightSnapshot, [syntaxes[3]])]
        for (mode in 0..2) {
            let PrimitiveSourceBindingContext[] inputs = mode == 0 ? contexts : contexts.reverse()
            let scope = PrimitiveResolvedDeclarationContext(contexts.first, inputs)
            let overlayScope = scope.scopeForSnapshot(overlaySnapshot)
            expect(overlayScope.resolve("Choice", syntaxes[1].range).syntaxIdentity.snapshot).toBe(rightSnapshot)
            expect(overlayScope.scopeForSnapshot(baseSnapshot).resolve("Choice", syntaxes.first.range).syntaxIdentity.snapshot).toBe(leftSnapshot)
            // Type membership stays canonical despite lexical scope replacement.
            let owner = overlayScope.classFor(scope.classIdentity(merged))
            expect(owner.methodValues().map({ _.name })).toBe(["base", "overlay"])
            let bound = PrimitiveClassPartitionBinder().bindContexts(inputs).typeUnits().firstOrNull({ _.identity.name == "Owner" })
            expect(bound.functionUnits().any({ _.name == "overlay" })).toBe(true)
        }
    }

    async test `overlay member signatures fields and bodies use only originating source imports`() {
        let baseSnapshot = SourceSnapshotIdentity(SourceIdentity("app/Reader.flat"), "one")
        let overlaySnapshot = SourceSnapshotIdentity(SourceIdentity("app/Reader.js.flat"), "one")
        let leftSnapshot = SourceSnapshotIdentity(SourceIdentity("left/Item.flat"), "one")
        let rightSnapshot = SourceSnapshotIdentity(SourceIdentity("right/Item.flat"), "one")
        let snapshots = [baseSnapshot, overlaySnapshot, leftSnapshot, rightSnapshot]
        let sources = ["class Reader { base(Item value) -> Item { return value; } }",
            "class Reader { visible Item selected; construct(Item value) { selected = value; } " +
                "overlay(Item value) -> Item { return value; } }",
            "class Item { construct() {} }", "class Item { construct() {} }"]
        let syntaxes = PrimitiveClassSyntax[]
        var Int index
        for (source in sources) {
            let stream = Lexer().lex(source)
            stream.emit("start")
            syntaxes.add(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshots[index++]))
        }
        let contexts = [PrimitiveSourceBindingContext("app", baseSnapshot, [syntaxes[0].mergedWith(syntaxes[1])],
                importValues: [PrimitiveBindingImport("left/Item", syntaxes[0].range)]),
            PrimitiveSourceBindingContext("app", overlaySnapshot, PrimitiveClassSyntax[],
                importValues: [PrimitiveBindingImport("right/Item", syntaxes[1].range)]),
            PrimitiveSourceBindingContext("left", leftSnapshot, [syntaxes[2]]),
            PrimitiveSourceBindingContext("right", rightSnapshot, [syntaxes[3]])]
        for (mode in 0..2) {
            let PrimitiveSourceBindingContext[] inputs = mode == 0 ? contexts : contexts.reverse()
            let result = PrimitiveClassPartitionBinder().bindContexts(inputs).typeUnits().firstOrNull({ _.identity.name == "Reader" })
            let left = UserClassSemanticType(DeclarationIdentity(SyntaxIslandIdentity(leftSnapshot, "class", 0), "class", "Item"))
            let right = UserClassSemanticType(DeclarationIdentity(SyntaxIslandIdentity(rightSnapshot, "class", 0), "class", "Item"))
            let base = result.functionUnits().firstOrNull({ _.name == "base" })
            let overlay = result.functionUnits().firstOrNull({ _.name == "overlay" })
            expect(base.returnType.value()).toBe(left.value())
            expect(base.parameterValues().first.semanticType.value()).toBe(left.value())
            expect(overlay.returnType.value()).toBe(right.value())
            expect(overlay.parameterValues().first.semanticType.value()).toBe(right.value())
            expect(result.fieldUnits().firstOrNull({ _.name == "selected" }).semanticType.value()).toBe(right.value())
            let constructor = result.functionUnits().firstOrNull((candidate) =>
                candidate.constructorFunction && candidate.range.snapshot == overlaySnapshot &&
                candidate.parameterValues().count == 1 && candidate.parameterValues().first.name == "value")
            expect(constructor != null).toBe(true)
            expect(constructor.parameterValues().first.semanticType.value()).toBe(right.value())
        }
    }

    async test `bodyless generic callable methods publish native storage defaults and parameter identities`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:bodyless-interface-publication"), "one")
        let traitStream = Lexer().lex("trait Bridge<E> { native_array read(native_array E[] input, Int count = 1) -> E[] " +
            "identity<T>(T value) -> T native text() -> String }")
        traitStream.emit("start")
        let contract = PrimitiveInterfaceParser().parse(traitStream.consumeAll<Token>("data"), snapshot)
        let classStream = Lexer().lex("class Reader { native_array read(Bridge<Int> bridge, native_array Int[] input) -> Int[] { " +
            "return bridge.read(input, 1); } omitted(Bridge<Int> bridge, native_array Int[] input) -> Void { bridge.read(input); } identity(Bridge<Int> bridge) -> Int { return bridge.identity(42); } " +
            "native text(Bridge<Int> bridge) -> String { return bridge.text(); } }")
        classStream.emit("start")
        let syntax = PrimitiveClassParser().parse(classStream.consumeAll<Token>("data"), snapshot, 100)
        let context = PrimitiveSourceBindingContext("flat", snapshot, [syntax], [contract])
        let unit = PrimitiveClassPartitionBinder().bindContexts([context]).typeUnits().first
        let read = unit.functionUnits().firstOrNull({ _.name == "read" })
        expect(read.returnType.kind()).toBe("array")
        let readStatements = read.statements()
        let readStatementObject = (Object)readStatements.first
        let readStatement = (BoundReturnStatement)readStatementObject
        let readCallObject = (Object)readStatement.value
        let readCall = (BoundCallExpression)readCallObject
        expect(readCall.target.optionalParameterCount).toBe(1)
        expect(readCall.target.parameterNames()).toBe(["input", "count"])
        expect(readCall.target.parameterTypes().first.kind()).toBe("array")
        expect(readCall.target.returnType.kind()).toBe("array")
        expect(unit.functionUnits().firstOrNull({ _.name == "identity" }).returnType.value()).toBe(SemanticTypes.intType().value())
        expect(unit.functionUnits().firstOrNull({ _.name == "text" }).returnType.kind()).toBe("string")
        expect(contract.methodValues().first.implementation()).toBe(null)
    }

