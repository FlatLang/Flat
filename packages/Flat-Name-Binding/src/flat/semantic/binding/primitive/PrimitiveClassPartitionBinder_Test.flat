    }

    async test `catch metadata retains canonical owner across constructor overlay overloads`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:catch-metadata-overlay"), "one")
        let baseStream = Lexer().lex("class Class<Type> { visible String location; construct(visible String location) {} }")
        baseStream.emit("start")
        let overlayStream = Lexer().lex("class Class<Type> { construct(visible String location, visible native Object jsClass = null) {} }")
        overlayStream.emit("start")
        let base = PrimitiveClassParser().parse(baseStream.consumeAll<Token>("data"), snapshot)
        let overlay = PrimitiveClassParser().parse(overlayStream.consumeAll<Token>("data"), snapshot)
        let metadata = base.mergedWith(overlay)
        expect(metadata.constructorValues().count).toBe(2)
        let stream = Lexer().lex("class Exception { construct() {} static matches(Class expected) -> Bool { try { throw Exception(); } catch (Exception e) { if (e.class.location == expected.location) { return true; } } return false; } }")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"),
            SourceSnapshotIdentity(SourceIdentity("memory:catch-metadata-consumer"), "one"))
        for (order in 0..2) {
            let inputs = PrimitiveClassSyntax[]
            if (order == 0) { inputs.add(syntax); inputs.add(metadata) }
            else { inputs.add(metadata); inputs.add(syntax) }
            let units = PrimitiveClassPartitionBinder().bind(inputs).typeUnits()
            let bound = units.firstOrNull({ _.identity.name == "Exception" })
            expect(bound.functionUnits().firstOrNull({ _.name == "matches" }).returnType.value())
                .toBe(SemanticTypes.boolType().value())
        }
    }

