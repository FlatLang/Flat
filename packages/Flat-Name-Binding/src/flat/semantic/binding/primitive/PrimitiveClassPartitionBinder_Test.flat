    test `resolves method generic scope`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:generic-scope"), "one"
        )
        let identity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", 0), "class", "List"
        )
        let parameter = GenericParameterSemanticType(identity, "Out", 0)
        let methodIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "instance-method", 10), "instance-method", "map"
        )
        let methodParameter = GenericParameterSemanticType(methodIdentity, "Out", 0)
        let parameters = [methodParameter]
        let resolver = PrimitiveStructuralTypeResolver(
            genericParameter: parameter, methodGenericParameters: parameters
        )
        parameters.clear()
        expect(resolver.resolve("Out").value()).toBe(methodParameter.value())
        let resolved = resolver.resolve("async func(Out,Int)->Out")
        let callback = (FunctionSemanticType)resolved
        expect(callback.returnType.value()).toBe(methodParameter.value())
        expect(callback.parameterTypes().first.value()).toBe(methodParameter.value())
        var Bool rejected
        try {
            PrimitiveStructuralTypeResolver(methodGenericParameters: [parameter, parameter])
        } catch (Exception error) {
            rejected = true
        }
        expect(rejected).toBe(true)
    }

    test `resolves nested generic async callback signature`() {
