        let classes = PrimitiveClassSyntax[]
        for (partition in partitions) classes.add(PrimitiveClassParser().parse(
            partition.tokenValues(), snapshot, partition.startTokenIndex))
        let units = PrimitiveClassPartitionBinder().bind(classes, snapshot).typeUnits()
        let method = units.last.functionUnits().firstOrNull({ _.name == "read" })
        let statement = method.statements().first
        let local = (BoundLocalDeclarationStatement)statement
        let metadata = (BoundTypeMetadataExpression)local.initializer
        expect(metadata.expressionKind()).toBe("type-metadata")
        let objectUnit = units.firstOrNull({ _.identity.name == "Object" })
        let classUnit = units.firstOrNull({ _.identity.name == "Class" })
        expect(metadata.referencedType.declarationIdentity.value).toBe(objectUnit.identity.value)
        expect(metadata.referencedType.value()).toBe(objectUnit.semanticType.value())
        expect(metadata.semanticType.value()).toBe(classUnit.semanticType.value())
    }
