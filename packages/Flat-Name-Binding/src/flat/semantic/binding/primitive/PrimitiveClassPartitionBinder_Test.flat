        expect(childMethod.dispatchIdentity).toBe(parentMethod.dispatchIdentity ?: parentMethod.identity.value)
    }

    async test `production inferred String plus conforms to canonical generic contract`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("flat/String.flat"), "compiler-input")
        let contractSnapshot = SourceSnapshotIdentity(SourceIdentity("flat/operators/PlusOperator.flat"), "compiler-input")
        let stream = Lexer().lex("class String extends Object implements PlusOperator<String, String> { " +
            "visible native String data; public construct(native String text) { data = text; } " +
            "override public plus(String another) => concat(another)\n" +
            "public concat(String other) -> String { return this; } }")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let tokens = Lexer().lex("trait PlusOperator<In, Out> { public plus(In another) -> Out }")
        tokens.emit("start")
        let contract = PrimitiveInterfaceParser().parse(tokens.consumeAll<Token>("data"), contractSnapshot)
        let parentSnapshot = SourceSnapshotIdentity(SourceIdentity("flat/Object.flat"), "compiler-input")
        let parentStream = Lexer().lex("class Object { public construct() {} }")
        parentStream.emit("start")
        let parent = PrimitiveClassParser().parse(parentStream.consumeAll<Token>("data"), parentSnapshot)
        let contexts = [PrimitiveSourceBindingContext("flat", parentSnapshot, [parent]),
            PrimitiveSourceBindingContext("flat", snapshot, [syntax],
                importValues: [PrimitiveBindingImport("flat/operators", syntax.range)]),
            PrimitiveSourceBindingContext("flat/operators", contractSnapshot, PrimitiveClassSyntax[], [contract])]
        let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
        let unit = units.firstOrNull({ _.identity.name == "String" })
        let plus = unit.functionUnits().firstOrNull({ _.name == "plus" })
        expect(plus.returnType.value()).toBe(unit.semanticType.value())
        expect(plus.parameterValues().first.semanticType.value()).toBe(unit.semanticType.value())
    }

    async test `ternary reference conditions reuse typed presence checks`() {
        let sources = ["class String { public construct(native String text) {} }",
            "class Item {}",
            "class Example { public construct() {} " +
            "public render(String message) => message ? \"present\" : \"absent\" " +
            "public nullable(String message = null) => message ? 1 : 2 " +
            "public raw(native String message) => message ? 1 : 2 " +
            "public object(Item message) => message ? 1 : 2 " +
            "public maybe(Item message = null) => message ? 1 : 2 }"]
        let contexts = PrimitiveSourceBindingContext[]
        var Int index
        for (source in sources) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:reference-condition-#index"), "one")
            let stream = Lexer().lex(source)
            stream.emit("start")
            let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
            contexts.add(PrimitiveSourceBindingContext("flat", snapshot, [syntax]))
            index++
        }
        let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
        for (method in units.last.functionUnits()) {
            let statements = method.statements()
            if (statements.isEmpty) continue
            if (!statements.last.class.isOfType(BoundReturnStatement.class)) continue
            let returnedObject = (Object)statements.last
            let returned = (BoundReturnStatement)returnedObject
            var BoundExpression conditionalValue = returned.value
            if (conditionalValue.class.isOfType(BoundCallExpression.class)) {
                let wrap = (BoundCallExpression)conditionalValue
                conditionalValue = wrap.argumentValues().first
            }
            let conditionalObject = (Object)conditionalValue
            let conditional = (BoundConditionalExpression)conditionalObject
            expect(conditional.condition.semanticType.value()).toBe(SemanticTypes.boolType().value())
            let checkObject = (Object)conditional.condition
            let check = (BoundBinaryExpression)checkObject
            expect(check.operator).toBe("!=")
            let literalObject = (Object)check.right
            let literal = (BoundLiteralExpression)literalObject
            expect(literal.semanticType.value()).toBe(SemanticTypes.nullType().value())
        }
    }

    async test `nested declared text conditional normalizes outside String receiver`() {
        let sources = ["class String { public construct(native String text) {} }",
            "class Array<E> { public construct() {} join() -> String { return \"many\"; } " +
            "public forward(Bool multiple, Bool oxford) => toEnglish(multiple, oxford) " +
            "public toEnglish(Bool multiple, Bool oxford) => multiple ? (oxford ? join() : \"one\") : \"none\" }"]
        let contexts = PrimitiveSourceBindingContext[]
        var Int index
        for (source in sources) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:nested-text-#index"), "one")
            let stream = Lexer().lex(source)
            stream.emit("start")
            let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
            contexts.add(PrimitiveSourceBindingContext("flat", snapshot, [syntax]))
            index++
        }
        let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
        let string = units.first
        let methods = units.last.functionUnits()
        let method = methods.firstOrNull({ _.name == "toEnglish" })
        expect(method.returnType.value()).toBe(string.semanticType.value())
        let forward = methods.firstOrNull({ _.name == "forward" })
        expect(forward.returnType.value()).toBe(string.semanticType.value())
        let statements = method.statements()
        let returnedObject = (Object)statements.last
        let returned = (BoundReturnStatement)returnedObject
        let outerObject = (Object)returned.value
        let outer = (BoundConditionalExpression)outerObject
        expect(outer.whenFalse.expressionKind()).toBe("call")
        let innerObject = (Object)outer.whenTrue
        let inner = (BoundConditionalExpression)innerObject
        expect(inner.whenTrue.expressionKind()).toBe("call")
        expect(inner.whenFalse.expressionKind()).toBe("call")
    }

    async test `generic join uses checked canonical Object text dispatch once`() {
        let results = ["String", "Int"]
        for (result in results) {
            let sources = ["class Object { public toString() -> #result { return " + (result == "String" ? "\"object\"" : "1") + "; } }",
                "class String implements PlusOperator<String, String> { public construct(native String text) {} " +
                "override plus(String other) -> this { return this; } }",
                "class Array<E> { public construct() {} next(E value) -> E { return value; } " +
                "join(E value, String delimiter) -> String { return this.next(value) + delimiter; } }"]
            let contexts = PrimitiveSourceBindingContext[]
            var Int index
            for (source in sources) {
                let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:generic-text-#result-#index"), "one")
                let stream = Lexer().lex(source)
                stream.emit("start")
                let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
                let space = syntax.name == "Array" ? "flat/datastruct/list" : "flat"
                contexts.add(PrimitiveSourceBindingContext(space, snapshot, [syntax],
                    importValues: [PrimitiveBindingImport("flat/operators", syntax.range),
                        PrimitiveBindingImport("flat", syntax.range)]))
                index++
            }
            let operatorSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:generic-text-operator"), "one")
            let tokens = Lexer().lex("trait PlusOperator<In, Out> { public plus(In another) -> Out }")
            tokens.emit("start")
            let contract = PrimitiveInterfaceParser().parse(tokens.consumeAll<Token>("data"), operatorSnapshot)
            contexts.add(PrimitiveSourceBindingContext("flat/operators", operatorSnapshot, PrimitiveClassSyntax[], [contract]))
            var Bool rejected
            try {
                let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
                let array = units.firstOrNull({ _.identity.name == "Array" })
                let method = array.functionUnits().firstOrNull({ _.name == "join" })
                let statements = method.statements()
                let returnedObject = (Object)statements.first
                let returned = (BoundReturnStatement)returnedObject
                let plusObject = (Object)returned.value
                let plus = (BoundCallExpression)plusObject
                let textObject = (Object)plus.receiver
                let text = (BoundCallExpression)textObject
                expect(text.target.name).toBe("toString")
                expect(text.target.ownerType.declarationIdentity.name).toBe("Object")
                expect(text.receiver.semanticType.kind()).toBe("generic-parameter")
                expect(text.receiver.expressionKind()).toBe("call")
                expect(text.argumentValues().count).toBe(0)
            } catch (Exception error) {
                if (result == "String") throw error
                rejected = true
            }
            expect(rejected).toBe(result == "Int")
        }
    }

    async test `Char plus declared String calls source Char text contract once`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:char-plus-string"), "one")
        let charSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:char-text-contract"), "one")
        let operatorSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:char-plus-operator"), "one")
        let stream = Lexer().lex("class String implements PlusOperator<String, String> { " +
            "public construct(Char value) {} override plus(String other) -> this { return this; } " +
            "next() -> Char { return 'a'; } rest() -> this { return this; } " +
            "run() -> String { return this.next() + this.rest(); } }")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let charStream = Lexer().lex("class Char implements Integer { public static toString(Char value) => String(value) }")
        charStream.emit("start")
        let charSyntax = PrimitiveClassParser().parse(charStream.consumeAll<Token>("data"), charSnapshot)
        let integerTokens = Lexer().lex("trait Integer {}")
        integerTokens.emit("start")
        let integer = PrimitiveInterfaceParser().parse(integerTokens.consumeAll<Token>("data"), charSnapshot, 100)
        let tokens = Lexer().lex("trait PlusOperator<In, Out> { public plus(In another) -> Out }")
        tokens.emit("start")
        let contract = PrimitiveInterfaceParser().parse(tokens.consumeAll<Token>("data"), operatorSnapshot)
        let units = PrimitiveClassPartitionBinder().bindContexts([
            PrimitiveSourceBindingContext("flat", snapshot, [syntax],
                importValues: [PrimitiveBindingImport("flat/operators", syntax.range)]),
            PrimitiveSourceBindingContext("flat/primitive/number", charSnapshot, [charSyntax], [integer],
                importValues: [PrimitiveBindingImport("flat", charSyntax.range)]),
            PrimitiveSourceBindingContext("flat/operators", operatorSnapshot, PrimitiveClassSyntax[], [contract])
        ]).typeUnits()
        let unit = units.firstOrNull({ _.identity.name == "String" })
        let statements = unit.functionUnits().firstOrNull({ _.name == "run" }).statements()
        let returnedObject = (Object)statements.first
        let returned = (BoundReturnStatement)returnedObject
        let plusObject = (Object)returned.value
        let plus = (BoundCallExpression)plusObject
        expect(plus.target.name).toBe("plus")
        expect(plus.semanticType.value()).toBe(unit.semanticType.value())
        let conversionObject = (Object)plus.receiver
        let conversion = (BoundCallExpression)conversionObject
        expect(conversion.target.name).toBe("toString")
        expect(conversion.target.callableKind.value).toBe("static-method")
        expect(conversion.target.ownerType.declarationIdentity.name).toBe("Char")
        let convertedArguments = conversion.argumentValues()
        expect(convertedArguments.count).toBe(1)
        let sourceObject = (Object)convertedArguments.first
        let source = (BoundCallExpression)sourceObject
        expect(source.target.name).toBe("next")
        let plusArguments = plus.argumentValues()
        expect(plusArguments.count).toBe(1)
        let rightObject = (Object)plusArguments.first
        let right = (BoundCallExpression)rightObject
        expect(right.target.name).toBe("rest")
    }

    async test `canonical String plus resolves declared operator with one operand occurrence`() {
        let bodies = ["return this.left() + this.right();",
            "var output = this; while (false) { output = this.left() + this.right(); } return output;",
            "return this.left() + \"right\";", "return \"left\" + this.right();"]
        for (body in bodies) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:string-plus"), "one")
            let operatorSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:plus-contract"), "one")
            let stream = Lexer().lex("class String implements PlusOperator<String, String> { " +
                "visible native String data; public construct(native String text) { data = text; } " +
                "left() -> this { return this; } right() -> this { return this; } " +
                "override plus(String other) -> this { return this; } " +
                "plus(Int other) -> Int { return other; } run() -> String { " + body + " } }")
            stream.emit("start")
            let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
            let tokens = Lexer().lex("trait PlusOperator<In, Out> { public plus(In another) -> Out }")
            tokens.emit("start")
            let contract = PrimitiveInterfaceParser().parse(tokens.consumeAll<Token>("data"), operatorSnapshot)
            let unit = PrimitiveClassPartitionBinder().bindContexts([
                PrimitiveSourceBindingContext("flat", snapshot, [syntax],
                    importValues: [PrimitiveBindingImport("flat/operators", syntax.range)]),
                PrimitiveSourceBindingContext("flat/operators", operatorSnapshot, PrimitiveClassSyntax[], [contract])
            ]).typeUnits().first
            let statements = unit.functionUnits().firstOrNull({ _.name == "run" }).statements()
            var BoundExpression operation
            if (body.startsWith("return")) {
                let returnedObject = (Object)statements.first
                let returned = (BoundReturnStatement)returnedObject
                operation = returned.value
            } else {
                let loopObject = (Object)statements[1]
                let loop = (BoundWhileStatement)loopObject
                let loopBody = loop.bodyValues()
                let assignedObject = (Object)loopBody.first
                let assigned = (BoundAssignmentStatement)assignedObject
                expect(assigned.conversion.conversionKind).toBe("identity")
                operation = assigned.value
            }
            expect(operation.expressionKind()).toBe("call")
            let operationObject = (Object)operation
            let call = (BoundCallExpression)operationObject
            expect(call.target.name).toBe("plus")
            expect(call.target.ownerType.value()).toBe(unit.semanticType.value())
            expect(call.target.parameterTypes().first.value()).toBe(unit.semanticType.value())
            expect(call.semanticType.value()).toBe(unit.semanticType.value())
            let leftObject = (Object)call.receiver
            let left = (BoundCallExpression)leftObject
            expect(left.target.name).toBe(body.contains("\"left\"") ? "String" : "left")
            expect(left.argumentValues().count).toBe(body.contains("\"left\"") ? 1 : 0)
            let arguments = call.argumentValues()
            expect(arguments.count).toBe(1)
            let rightObject = (Object)arguments.first
            let right = (BoundCallExpression)rightObject
            expect(right.target.name).toBe(body.contains("\"right\"") ? "String" : "right")
            expect(right.argumentValues().count).toBe(body.contains("\"right\"") ? 1 : 0)
        }
    }

