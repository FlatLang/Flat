    async test `structured String assignment constructs canonical text once`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:string-assignment-adapter"), "one")
        let stream = Lexer().lex("class String { visible native String data; " +
            "public construct(native String text) { data = text; } " +
            "make() => \"value\"\n" +
            "replace() -> String { var output = this; while (false) { output = this.make(); } return output; } }")
