    async test `trait substitution resolves imported concrete type in implementation source scope`() {
        let ownerSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:consumer/Box.flat"), "one")
        let traitSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:contracts/Items.flat"), "one")
        let valueSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:domain/Value.flat"), "one")
        let shadowSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:contracts/Value.flat"), "one")
        let ownerStream = Lexer().lex("class Box implements Items<Value> { construct() {} }")
        ownerStream.emit("start")
        let owner = PrimitiveClassParser().parse(ownerStream.consumeAll<Token>("data"), ownerSnapshot)
        let traitStream = Lexer().lex("trait Items<E> { public identity(E value) -> E { return value; } }")
        traitStream.emit("start")
        let contract = PrimitiveInterfaceParser().parse(traitStream.consumeAll<Token>("data"), traitSnapshot)
        let valueStream = Lexer().lex("class Value { construct() {} }")
        valueStream.emit("start")
        let value = PrimitiveClassParser().parse(valueStream.consumeAll<Token>("data"), valueSnapshot)
        let shadowStream = Lexer().lex("class Value { construct() {} }")
        shadowStream.emit("start")
        let shadow = PrimitiveClassParser().parse(shadowStream.consumeAll<Token>("data"), shadowSnapshot)
        let contexts = [PrimitiveSourceBindingContext("consumer", ownerSnapshot, [owner],
                importValues: [PrimitiveBindingImport("contracts/Items", owner.range),
                    PrimitiveBindingImport("domain/Value", owner.range)]),
            PrimitiveSourceBindingContext("contracts", traitSnapshot, PrimitiveClassSyntax[], [contract]),
            PrimitiveSourceBindingContext("domain", valueSnapshot, [value]),
            PrimitiveSourceBindingContext("contracts", shadowSnapshot, [shadow])]
        let ownerScope = PrimitiveResolvedDeclarationContext(contexts.first, contexts)
        let scope = PrimitiveResolvedDeclarationContext(contexts[1], contexts)
        let implementation = contract.methodValues().first.implementation()
        let resolver = PrimitiveStructuralTypeResolver(interfaces: [contract],
            implementationOwner: owner, implementationRange: implementation.range,
            declarationContext: scope, lookupRange: implementation.range)
        let expected = UserClassSemanticType(ownerScope.classIdentity(value))
        expect(resolver.resolve("E").value()).toBe(expected.value())
        let callback = (FunctionSemanticType)resolver.resolve("func(E)->E")
        expect(callback.parameterTypes().first.value()).toBe(expected.value())
        expect(callback.returnType.value()).toBe(expected.value())
        expect(resolver.resolve("E[]").value()).toBe(ArraySemanticType(expected).value())
    }

    async test `trait owner edges retain canonical imports`() {
        let baseSnapshot = SourceSnapshotIdentity(SourceIdentity("flat/datastruct/list/Array.flat"), "compiler-input")
        let memberSnapshot = SourceSnapshotIdentity(SourceIdentity("flat/datastruct/list/OrderedList.flat"), "compiler-input")
        let operatorSnapshot = SourceSnapshotIdentity(SourceIdentity("flat/operators/PlusOperator.flat"), "compiler-input")
        let baseStream = Lexer().lex("class Array<E> implements OrderedList<E>, PlusOperator<Array<E>, Array<E>> { construct() {} }")
        baseStream.emit("start")
        let owner = PrimitiveClassParser().parse(baseStream.consumeAll<Token>("data"), baseSnapshot)
        let memberStream = Lexer().lex("trait OrderedList<Type> { public identity(Int index, Type element) -> Type { return element; } }")
        memberStream.emit("start")
        let member = PrimitiveInterfaceParser().parse(memberStream.consumeAll<Token>("data"), memberSnapshot)
        let operatorStream = Lexer().lex("trait PlusOperator<In, Out> { public plus(In another) -> Out }")
        operatorStream.emit("start")
        let operator = PrimitiveInterfaceParser().parse(operatorStream.consumeAll<Token>("data"), operatorSnapshot)
        let empty = PrimitiveClassSyntax[]
        let contexts = [PrimitiveSourceBindingContext("flat/datastruct/list", baseSnapshot, [owner],
                importValues: [PrimitiveBindingImport("flat/operators", owner.range)]),
            PrimitiveSourceBindingContext("flat/datastruct/list", memberSnapshot, empty, [member]),
            PrimitiveSourceBindingContext("flat/operators", operatorSnapshot, empty, [operator])]
        let scope = PrimitiveResolvedDeclarationContext(contexts[1], contexts)
        let generic = GenericParameterSemanticType(PrimitiveResolvedDeclarationContext(contexts.first, contexts).classIdentity(owner), "E", 0)
        let members = member.methodValues()
        let implementation = members.first.implementation()
        let resolver = PrimitiveStructuralTypeResolver(genericParameter: generic, interfaces: [member, operator],
            implementationOwner: owner, implementationRange: implementation.range,
            declarationContext: scope, lookupRange: implementation.range)
        expect(resolver.resolve("Int").value()).toBe(SemanticTypes.intType().value())
        expect(resolver.resolve("Type").value()).toBe(generic.value())
    }

