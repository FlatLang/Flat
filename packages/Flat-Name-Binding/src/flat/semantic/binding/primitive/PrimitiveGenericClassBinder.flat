package flat/semantic/binding/primitive

import flat/compiler/models
import flat/parser/flat
import flat/semantic/types
import flat/bound

/** Instantiates one reduced reified generic class through bounded memoized work. */
class {
    public instantiate(
        PrimitiveClassSyntax syntax,
        SourceSnapshotIdentity snapshot,
        SemanticType argument,
        GenericInstantiationMemo memo
    ) -> BoundTypeUnit {
        return instantiateArguments(syntax, snapshot, [argument], memo)
    }

    public instantiateArguments(PrimitiveClassSyntax syntax, SourceSnapshotIdentity snapshot,
        SemanticType[] arguments, GenericInstantiationMemo memo) -> BoundTypeUnit {
        if (!syntax || !snapshot || !arguments || !memo || syntax.genericParameters().isEmpty) {
            throw Exception("Generic class instantiation requires generic syntax arguments and memo")
        }
        let bound = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let parameters = PrimitiveClassParameters.bind(syntax, bound.identity)
        let declaration = GenericDeclaration(bound.identity, parameters,
            GenericInstanceSemanticType(bound.semanticType, parameters))
        let work = memo.instantiate(declaration, arguments)
        let metadata = bound.metadata()
        for (parameter in parameters) {
            metadata.add(BoundMetadataUnit("reified", "type-argument", work.substitution.apply(parameter).value()))
        }
        metadata.add(BoundMetadataUnit("generic", "instantiation-key", work.key))
        return BoundTypeUnit(
            bound.identity, bound.semanticType, bound.functionUnits(), bound.range,
            metadataValues: metadata, fieldValues: bound.fieldUnits(), parentType: bound.parentType
        )
    }
}
