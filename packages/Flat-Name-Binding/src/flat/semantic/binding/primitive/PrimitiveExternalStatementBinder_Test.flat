package flat/semantic/binding/primitive

import flat/compiler/models
import flat/parser/flat
import flat/bound

/** Focused binding coverage for selected opaque external statements. */
testable class {
    test `binds selected target and preserves opaque source evidence`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:external-bind"), "revision:one"
        )
        let syntax = PrimitiveControlStatementParser().parse([
            token("external", Token.Type.IDENTIFIER, 1),
            token("js", Token.Type.IDENTIFIER, 10),
            token("{", Token.Type.SYMBOL, 13),
            token("code", Token.Type.CODE, 15),
            token("}", Token.Type.SYMBOL, 19)
        ], snapshot)
        let bound = PrimitiveControlStatementBinder().bind(syntax, snapshot).statements()
        let object = (Object)bound.first
        let value = (BoundExternalStatement)object

        expect(value.target).toBe("es6")
        expect(value.code).toBe("code")
        expect(value.range.snapshot).toBe(snapshot)
    }

    test `rejects mismatched target`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:external-bind-invalid"), "revision:one"
        )
        let syntax = PrimitiveControlStatementParser().parse([
            token("external", Token.Type.IDENTIFIER, 1),
            token("c", Token.Type.IDENTIFIER, 10),
            token("{", Token.Type.SYMBOL, 12),
            token("code", Token.Type.CODE, 14),
            token("}", Token.Type.SYMBOL, 18)
        ], snapshot)
        var rejected = false
        try { PrimitiveControlStatementBinder().bind(syntax, snapshot) }
        catch (Exception error) { rejected = true }
        expect(rejected).toBe(true)
    }

    token(String value, Int type, Int column) -> Token => Token(
        value: value,
        type: type,
        location: Location(lineNumber: 1, column: column)
    )
}
