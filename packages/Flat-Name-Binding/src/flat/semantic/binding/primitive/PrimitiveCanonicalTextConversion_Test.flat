package flat/semantic/binding/primitive

import flat/compiler/models
import flat/parser/flat
import flat/semantic/types
import flat/bound
import flat/lexer/Lexer

/** Canonical scalar text evidence, independent of shared partition fixtures. */
testable class {
    textCall(Object value) -> BoundCallExpression => (BoundCallExpression)value
    textReturn(Object value) -> BoundReturnStatement => (BoundReturnStatement)value
    textAssignment(Object value) -> BoundAssignmentStatement => (BoundAssignmentStatement)value
    textLocal(Object value) -> BoundLocalDeclarationStatement => (BoundLocalDeclarationStatement)value

    // Coordinator fail-first experiment: retain the new tests against the
    // pre-repair implementation for their wave, then validate the repaired source.
    // No package execution is authorized during the source-writing wave.
    test `explicit nullable structural suffix preserves array and function return boundaries`() {
        let resolver = PrimitiveStructuralTypeResolver()
        let optional = resolver.resolve("Int?")
        expect(optional.kind()).toBe("nullable")
        Object optionalSource = optional
        NullableSemanticType optionalType = (NullableSemanticType)optionalSource
        expect(optionalType.underlyingType.value()).toBe(SemanticTypes.intType().value())
        let array = resolver.resolve("Int[]?")
        expect(array.kind()).toBe("nullable")
        Object arraySource = array
        NullableSemanticType optionalArray = (NullableSemanticType)arraySource
        expect(optionalArray.underlyingType.kind()).toBe("array")
        let callback = resolver.resolve("func()->Int?")
        expect(callback.kind()).toBe("function")
        Object callbackSource = callback
        FunctionSemanticType callbackType = (FunctionSemanticType)callbackSource
        expect(callbackType.returnType.kind()).toBe("nullable")
        let optionalNative = resolver.resolveStorage("String?", nativeScalarStorage: true)
        Object nativeSource = optionalNative
        NullableSemanticType nativeType = (NullableSemanticType)nativeSource
        expect(nativeType.underlyingType.value()).toBe(SemanticTypes.stringType().value())
        var Bool rejected
        try { resolver.resolve("Int??") }
        catch (Exception error) { rejected = error.message.contains("cannot be nullable") }
        expect(rejected).toBe(true)
    }

    async test `explicit nullable locals and parameters retain absence only at annotated boundaries`() {
        let sources = textSources("Int")
        sources.add(textSource("app", "OptionalText",
            "class OptionalText { static accept(String? value = null) -> String { return value ?: \"fallback\"; } static run() { let String? absent = null; let String? present = \"text\"; absent = \"updated\"; absent = null; let result = accept(absent); accept(); accept(null); accept(\"boundary\"); let declared = \"nonnull\"; accept(declared); } }"))
        let units = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits()
        let owner = units.firstOrNull({ _.identity.name == "OptionalText" })
        let text = units.firstOrNull({ _.identity.name == "String" })
        let accept = owner.functionUnits().firstOrNull({ _.name == "accept" })
        expect(accept.parameterValues().first.semanticType.kind()).toBe("nullable")
        expect(accept.parameterValues().first.defaultValue.semanticType.kind()).toBe("nullable")
        Object defaultSource = accept.parameterValues().first.defaultValue
        BoundConversionExpression defaultValue = (BoundConversionExpression)defaultSource
        expect(defaultValue.value.semanticType.kind()).toBe("null")
        let returned = textReturn(accept.statements().first)
        expect(returned.value.semanticType.value()).toBe(text.semanticType.value())
        Object fallbackSource = returned.value
        BoundBinaryExpression fallback = (BoundBinaryExpression)fallbackSource
        expect(fallback.operator).toBe("?:")
        expect(fallback.left.semanticType.kind()).toBe("nullable")
        expect(textCall(fallback.right).target.callableKind.value).toBe("constructor")
        let statements = owner.functionUnits().firstOrNull({ _.name == "run" }).statements()
        let absent = textLocal(statements[0])
        expect(absent.local.semanticType.kind()).toBe("nullable")
        expect(absent.initializer.semanticType.kind()).toBe("null")
        expect(absent.conversion.applicable).toBe(true)
        expect(absent.conversion.toType.value()).toBe(absent.local.semanticType.value())
        let present = textLocal(statements[1])
        expect(present.local.semanticType.kind()).toBe("nullable")
        expect(textCall(present.initializer).target.callableKind.value).toBe("constructor")
        expect(textAssignment(statements[2]).conversion.conversionKind).toBe("nullable-lift")
        expect(textAssignment(statements[3]).conversion.conversionKind).toBe("null")
        expect(textLocal(statements[4]).local.semanticType.value()).toBe(text.semanticType.value())
        let nonnull = textLocal(statements[8])
        expect(nonnull.local.semanticType.value()).toBe(text.semanticType.value())
        Object nonnullCallSource = statements[9]
        BoundExpressionStatement nonnullStatement = (BoundExpressionStatement)nonnullCallSource
        let nonnullCall = textCall(nonnullStatement.expression)
        expect(nonnullCall.argumentValues().first.semanticType.value()).toBe(text.semanticType.value())
        expect(nonnullCall.argumentConversions().first.conversionKind).toBe("nullable-lift")
    }

    async test `nullable receiver safe access with fallback yields checked nonnullable consumer`() {
        let sources = [defaultSource("app", "Box",
            "class Box { visible Int count; static consume(Int value) {} static run(Box? value) { let Box? absent = null; let Int count = value?.count ?: 0; consume(count); } }")]
        let owner = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits().first
        let method = owner.functionUnits().firstOrNull({ _.name == "run" })
        expect(method.parameterValues().first.semanticType.kind()).toBe("nullable")
        let local = textLocal(method.statements()[1])
        expect(local.local.semanticType.value()).toBe(SemanticTypes.intType().value())
        Object fallbackSource = local.initializer
        BoundBinaryExpression fallback = (BoundBinaryExpression)fallbackSource
        expect(fallback.left.semanticType.kind()).toBe("nullable")
        expect(fallback.semanticType.value()).toBe(SemanticTypes.intType().value())
    }

    async test `nullable annotations do not relax nonnullable storage parameters or native text`() {
        String[] bodies = [
            "class InvalidOptional { static run() { let String value = null; } }",
            "class InvalidOptional { static run() { let value = \"present\"; value = null; } }",
            "class InvalidOptional { static run(String? optional, String value) { value = optional; } }",
            "class InvalidOptional { static consume(String value) {} static run(String? value) { consume(value); } }",
            "class InvalidOptional { static run(native String value) { let String? optional = value; } }"
        ]
        for (bodySource in bodies) {
            let sources = textSources("Int")
            sources.add(textSource("app", "InvalidOptional", bodySource))
            var Bool rejected
            try { PrimitiveClassPartitionBinder().bindContexts(sources) }
            catch (Exception error) { rejected = true }
            if (!rejected) throw Exception("Nullable negative fixture unexpectedly admitted: #bodySource")
            expect(rejected).toBe(true)
        }
    }

    async test `unannotated reference parameter null default must not infer nullable storage`() {
        String[] declarations = [
            "static consume(String value = null) {}",
            "public construct(visible String value = null) {}",
            "static consume(native String value = null) {}",
            "static consume(String[] value = null) {}"
        ]
        for (declaration in declarations) {
            let sources = textSources("Int")
            let invalid = textSource("app", "InvalidOptional", "class InvalidOptional { " + declaration + " }")
            sources.add(invalid)
            let parameter = declaration.contains("construct") ?
                invalid.classValues().first.constructorValues().first.parameterValues().first :
                invalid.classValues().first.methodValues().first.parameterValues().first
            var Bool rejected
            try { PrimitiveClassPartitionBinder().bindContexts(sources) }
            catch (PrimitiveContextBindingException error) {
                expect(error.diagnostic.code).toBe("binding.parameter-null-default")
                expect(error.diagnostic.range.snapshot.value).toBe(parameter.defaultValue.range.snapshot.value)
                expect(error.diagnostic.range.startTokenIndex).toBe(parameter.defaultValue.range.startTokenIndex)
                expect(error.diagnostic.range.endTokenIndex).toBe(parameter.defaultValue.range.endTokenIndex)
                expect(error.diagnostic.name.contains("value")).toBe(true)
                expect(error.diagnostic.name.contains("explicit nullable")).toBe(true)
                rejected = true
            }
            expect(rejected).toBe(true)
        }
    }

    async test `explicit nullable null defaults preserve declared method and constructor storage`() {
        let sources = textSources("Int")
        sources.add(textSource("app", "OptionalDefaults",
            "class OptionalDefaults { public construct(visible String? value = null) {} static consume(String? value = null) {} static run() { consume(); consume(null); } }"))
        let owner = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits().firstOrNull({ _.identity.name == "OptionalDefaults" })
        let selected = owner.functionUnits().filter((function) => function.constructorFunction || function.name == "consume")
        expect(selected.count).toBe(2)
        for (function in selected) {
            let parameter = function.parameterValues().first
            expect(parameter.semanticType.kind()).toBe("nullable")
            expect(parameter.defaultValue.semanticType.value()).toBe(parameter.semanticType.value())
        }
        expect(owner.fieldUnits().first.semanticType.kind()).toBe("nullable")
    }

    async test `normalized override dispatch is published for typed inferred and same owner calls`() {
        String[] results = ["-> Int", ""]
        for (result in results) {
            let sources = [defaultSource("flat", "Object", "class Object { public code() -> Int { return 0; } }"),
                defaultSource("flat", "Number", "class Number<E> extends Object { public construct() {} }"),
                defaultSource("flat", "Char", "class Char extends Number<Char> { public construct(Char value) {} public code() " + result + " { return 1; } public self() -> Int { return code(); } public static code(Int value) -> Int { return value; } }"),
                defaultSource("flat", "DispatchReader", "class DispatchReader { public static run() -> Int { return Char('a').code(); } }")]
            Bool[] schedules = [false, true]
            for (reverse in schedules) {
                let ordered = reverse ? sources.reverse() : sources
                let units = PrimitiveClassPartitionBinder().bindContexts(ordered).typeUnits()
                let root = units.firstOrNull((unit) => unit.identity.name == "Object")
                let child = units.firstOrNull((unit) => unit.identity.name == "Char")
                let reader = units.firstOrNull((unit) => unit.identity.name == "DispatchReader")
                let rootMethod = root.functionUnits().firstOrNull((method) => method.name == "code")
                let implementation = child.functionUnits().firstOrNull((method) => method.name == "code" && !method.staticFunction)
                expect(implementation.dispatchIdentity).toBe(rootMethod.dispatchIdentity ?: rootMethod.identity.value)
                let run = reader.functionUnits().firstOrNull((method) => method.name == "run")
                let selected = textCall(textReturn(run.statements().first).value)
                expect(selected.target.identity.declaration.value).toBe(implementation.identity.value)
                expect(selected.target.ownerType.value()).toBe(child.semanticType.value())
                expect(selected.target.dispatchIdentity).toBe(implementation.dispatchIdentity)
                let self = child.functionUnits().firstOrNull((method) => method.name == "self")
                let ownCall = textCall(textReturn(self.statements().first).value)
                expect(ownCall.target.dispatchIdentity).toBe(implementation.dispatchIdentity)
                expect(child.functionUnits().firstOrNull((method) => method.name == "code" && method.staticFunction).dispatchIdentity == null).toBe(true)
            }
        }
    }

    async test `native Char constructor setup publishes source storage through delegation`() {
        let source = defaultSource("app", "NativeText",
            "class NativeText { public construct(native_array native Char[] data) {} public construct(Char c) { native_array native Char[] chars; external js { chars = []; } this(chars); } }")
        let unit = PrimitiveClassPartitionBinder().bindContexts([source]).typeUnits().first
        let constructor = unit.functionUnits().firstOrNull((candidate) => candidate.constructorFunction &&
            candidate.parameterValues().first.semanticType.value() == SemanticTypes.charType().value())
        expect(constructor.constructorPlan != null).toBe(true)
        // Setup and its raw write must survive immutable constructor planning;
        // the direct substitution test verifies remapping to a helper local.
    }

    async test `source literal receiver constructs canonical String and preserves negative runtime index`() {
        let sources = [defaultSource("flat", "String", "class String { public construct(native String text) {} public substring(Int start, Int end) -> String { return this; } }"),
            defaultSource("flat", "LiteralReceiver", "class LiteralReceiver { public static run() -> String { \"abc\".substring(-1, 2); return \"abc\".substring(1, 3); } }")]
        let units = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits()
        let text = units.firstOrNull((unit) => unit.identity.name == "String")
        let owner = units.firstOrNull((unit) => unit.identity.name == "LiteralReceiver")
        let method = owner.functionUnits().firstOrNull((candidate) => candidate.name == "run")
        Object statementSource = method.statements().first
        BoundExpressionStatement statement = (BoundExpressionStatement)statementSource
        let invalidBounds = textCall(statement.expression)
        expect(invalidBounds.target.ownerType.value()).toBe(text.semanticType.value())
        let construction = textCall(invalidBounds.receiver)
        expect(construction.target.callableKind.value).toBe("constructor")
        expect(construction.argumentValues().first.expressionKind()).toBe("literal")
        expect(invalidBounds.argumentValues().first.semanticType.value()).toBe(SemanticTypes.intType().value())
        expect(invalidBounds.argumentValues().first.expressionKind()).toBe("unary")
        expect(textCall(textReturn(method.statements().last).value).target.name).toBe("substring")
    }

    async test `literal receiver bridge rejects native variables invalid argument type and arity`() {
        String[] expressions = ["value.substring(1, 2)", "\"abc\".substring(true, 2)", "\"abc\".substring()"]
        for (expression in expressions) {
            let sources = [defaultSource("flat", "String", "class String { public construct(native String text) {} public substring(Int start, Int end) -> String { return this; } }"),
                defaultSource("flat", "InvalidLiteralReceiver", "class InvalidLiteralReceiver { public static run(native String value) -> String { return " + expression + "; } }")]
            var Bool rejected
            try { PrimitiveClassPartitionBinder().bindContexts(sources) }
            catch (Exception error) {
                if (!error.message.contains("substring")) throw error
                rejected = true
            }
            expect(rejected).toBe(true)
        }
    }

    async test `inherited nullable field capture refines only checked condition local`() {
        let sources = [defaultSource("flat", "String", "class String { public construct(native String text) {} }"),
            defaultSource("flat", "Exception", "class Exception { public construct(visible String? message = \"\") {} }"),
            defaultSource("flat", "InvalidArgumentException", "class InvalidArgumentException extends Exception { public construct(String message) => super(message) }"),
            defaultSource("flat", "CaptureGuard", "class CaptureGuard { public static text(String value, String expected, String label) {} public static require(Bool value, String label) {} public static run() { try { throw InvalidArgumentException(\"bad input\"); } catch (InvalidArgumentException error) { if (let message = error.message) { text(message, \"bad input\", \"caught exception message\"); } else { require(false, \"caught exception message is present\"); } } } }")]
        let exceptionSource = sources[1]
        sources[1] = PrimitiveSourceBindingContext("flat/exception", exceptionSource.snapshot, exceptionSource.classValues())
        let childSource = sources[2]
        sources[2] = PrimitiveSourceBindingContext("flat/exception", childSource.snapshot, childSource.classValues())
        let consumerSource = sources[3]
        sources[3] = PrimitiveSourceBindingContext("flat", consumerSource.snapshot, consumerSource.classValues(),
            importValues: [PrimitiveBindingImport("flat/exception/InvalidArgumentException", consumerSource.classValues().first.range)])
        let units = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits()
        let owner = units.firstOrNull((unit) => unit.identity.name == "CaptureGuard")
        let method = owner.functionUnits().firstOrNull((candidate) => candidate.name == "run")
        expect(method.statements().first.unitKind()).toBe("try")
    }

    async test `condition capture cannot leak nonnull proof to else skipped scopes or after effects`() {
        String[] bodies = [
            "if (let message = error.message) {} else { text(message); }",
            "if (let message = error.message) {} text(message);",
            "if (gate && (let message = error.message)) {} else { text(message); }",
            "if (let message = error.message) { touch(); text(message); }",
            "if (let message = error.message) { text(error.message); }"
        ]
        for (body in bodies) {
            let sources = [defaultSource("flat", "String", "class String { public construct(native String text) {} }"),
                defaultSource("flat", "Exception", "class Exception { public construct(visible String? message = null) {} }"),
                defaultSource("flat", "InvalidCapture", "class InvalidCapture { public static text(String value) {} public static touch() {} public static run(Exception error, Bool gate) { " + body + " } }")]
            var Bool rejected
            try { PrimitiveClassPartitionBinder().bindContexts(sources) }
            catch (Exception failure) {
                if (!failure.message.contains("text") && !failure.message.contains("message")) throw failure
                rejected = true
            }
            expect(rejected).toBe(true)
        }
    }

    async test `catch descendant reads inherited nullable field with declaring identity and original receiver`() {
        let sources = [defaultSource("flat", "Array", "class Array<E> {}"),
            defaultSource("flat", "String", "class String { public construct(native String text) {} }"),
            defaultSource("flat/exception", "Exception", "class Exception { public construct(visible String? message = \"\") {} }"),
            defaultSource("flat/exception", "InvalidArgumentException", "class InvalidArgumentException extends Exception { public construct(String message) => super(message) }")]
        let raw = defaultSource("app", "CatchField", "class CatchField { public static run() { try { throw InvalidArgumentException(\"bad input\"); } catch (InvalidArgumentException error) { let retained = error.message; } } }")
        sources.add(PrimitiveSourceBindingContext("app", raw.snapshot, raw.classValues(),
            importValues: [PrimitiveBindingImport("flat/exception/InvalidArgumentException", raw.classValues().first.range)]))
        let units = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits()
        let parent = units.firstOrNull((unit) => unit.identity.name == "Exception")
        let owner = units.firstOrNull((unit) => unit.identity.name == "CatchField")
        let field = parent.fieldUnits().firstOrNull((candidate) => candidate.name == "message")
        let method = owner.functionUnits().firstOrNull((candidate) => candidate.name == "run")
        Object trySource = method.statements().first
        BoundTryStatement tried = (BoundTryStatement)trySource
        let caught = tried.catchValues().first
        Object accessSource = textLocal(caught.statements().first).initializer
        BoundMemberAccessExpression access = (BoundMemberAccessExpression)accessSource
        expect(access.memberIdentity.value).toBe(field.identity.value)
        expect(field.canonicalOwner().value).toBe(parent.identity.value)
        expect(access.semanticType.value()).toBe(field.semanticType.value())
        expect(access.semanticType.kind()).toBe("nullable")
        Object receiverSource = access.receiver
        BoundReferenceExpression receiver = (BoundReferenceExpression)receiverSource
        expect(receiver.symbolIdentity.value).toBe(caught.local.symbolIdentity.value)
        expect(access.range.snapshot.value).toBe(raw.snapshot.value)
    }

    async test `inherited field lookup preserves nearest shadow and rejects unrelated nullable receivers`() {
        let sources = [defaultSource("app", "Base", "class Base { visible Int message; }"),
            defaultSource("app", "Child", "class Child extends Base { visible Bool message; public construct() {} }"),
            defaultSource("app", "ReadShadow", "class ReadShadow { public static run(Child value) -> Bool { return value.message; } }")]
        let units = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits()
        let child = units.firstOrNull((unit) => unit.identity.name == "Child")
        let owner = units.firstOrNull((unit) => unit.identity.name == "ReadShadow")
        let method = owner.functionUnits().firstOrNull((candidate) => candidate.name == "run")
        Object accessSource = textReturn(method.statements().first).value
        BoundMemberAccessExpression access = (BoundMemberAccessExpression)accessSource
        expect(access.memberIdentity.value).toBe(child.fieldUnits().first.identity.value)
        String[] consumers = ["public static run(Child? value) -> Int { return value.message; }",
            "public static run(Other value) -> Int { return value.message; }"]
        for (consumer in consumers) {
            let invalid = [defaultSource("app", "Base", "class Base { visible Int message; }"),
                defaultSource("app", "Child", "class Child extends Base { public construct() {} }"),
                defaultSource("app", "Other", "class Other {}"),
                defaultSource("app", "InvalidField", "class InvalidField { " + consumer + " }")]
            var Bool rejected
            try { PrimitiveClassPartitionBinder().bindContexts(invalid) }
            catch (Exception error) {
                if (!error.message.contains("message")) throw error
                rejected = true
            }
            expect(rejected).toBe(true)
        }
    }

    async test `typed catch retains descendant identity through actual Exception ancestry`() {
        let sources = [defaultSource("flat", "Array", "class Array<E> {}"),
            defaultSource("flat/exception", "Exception", "class Exception { public construct() {} }"),
            defaultSource("flat/exception", "InvalidArgumentException", "class InvalidArgumentException extends Exception { public construct() {} }")]
        let raw = defaultSource("app", "CatchChild", "class CatchChild { public static run() { try { throw InvalidArgumentException(); } catch (InvalidArgumentException error) { let retained = error; } } }")
        sources.add(PrimitiveSourceBindingContext("app", raw.snapshot, raw.classValues(),
            importValues: [PrimitiveBindingImport("flat/exception/InvalidArgumentException", raw.classValues().first.range)]))
        let units = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits()
        let child = units.firstOrNull((unit) => unit.identity.name == "InvalidArgumentException")
        let owner = units.firstOrNull((unit) => unit.identity.name == "CatchChild")
        let method = owner.functionUnits().firstOrNull((candidate) => candidate.name == "run")
        Object trySource = method.statements().first
        BoundTryStatement tried = (BoundTryStatement)trySource
        let caught = tried.catchValues().first
        expect(caught.local.semanticType.value()).toBe(child.semanticType.value())
        let retained = textLocal(caught.statements().first)
        Object referenceSource = retained.initializer
        BoundReferenceExpression reference = (BoundReferenceExpression)referenceSource
        expect(reference.symbolIdentity.value).toBe(caught.local.symbolIdentity.value)
    }

