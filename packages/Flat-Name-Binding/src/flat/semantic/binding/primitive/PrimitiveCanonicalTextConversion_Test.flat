    async test `static runtime metadata names bind explicit local foreign and catch receivers`() {
        let sources = [defaultSource("flat", "Foreign", "class Foreign { public construct() {} }"),
            defaultSource("flat", "Exception", "class Exception { public construct() {} }")]
        sources.add(defaultSource("flat", "Names", "class Names { public static localName() -> String { let empty = Foreign(); return empty.class.name; } public static foreignName(Foreign Names) -> String { return Names.class.name; } public static caughtName() -> String { try { throw Exception(); } catch (Exception error) { return error.class.name; } return \"\"; } }"))
        let owner = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits().firstOrNull((unit) => unit.identity.name == "Names")
        let localMethod = owner.functionUnits().firstOrNull((method) => method.name == "localName")
        let local = textLocal(localMethod.statements().first)
        Object localNameSource = textReturn(localMethod.statements().last).value
        BoundClassNameExpression localName = (BoundClassNameExpression)localNameSource
        Object localReceiverSource = localName.receiver
        BoundReferenceExpression localReceiver = (BoundReferenceExpression)localReceiverSource
        expect(localReceiver.symbolIdentity.value).toBe(local.local.symbolIdentity.value)
        let foreignMethod = owner.functionUnits().firstOrNull((method) => method.name == "foreignName")
        Object foreignNameSource = textReturn(foreignMethod.statements().first).value
        BoundClassNameExpression foreignName = (BoundClassNameExpression)foreignNameSource
        Object foreignReceiverSource = foreignName.receiver
        BoundReferenceExpression foreignReceiver = (BoundReferenceExpression)foreignReceiverSource
        expect(foreignReceiver.symbolIdentity.value).toBe(foreignMethod.parameterValues().first.identity.value)
        expect(owner.functionUnits().any((method) => method.name == "caughtName")).toBe(true)
    }

