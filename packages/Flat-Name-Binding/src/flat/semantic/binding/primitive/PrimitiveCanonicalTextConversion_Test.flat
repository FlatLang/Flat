                }
                rejected = true
            }
            expect(rejected).toBe(true)
        }
    }

    async test `JS StringCharArray early null return retains lexical proof through stored count guard`() {
        let base = defaultSource("flat/datastruct/list", "StringCharArray",
            "class StringCharArray { visible Int count; public equals(StringCharArray? other) -> Bool { return other != null && count == other.count; } }")
        let overlay = textSource("flat/datastruct/list", "StringCharArray",
            "class StringCharArray { public equals(StringCharArray? other) -> Bool { if (other == null) { return false; } if (count != other.count) { return false; } return count == other.count; } }", "js-early")
