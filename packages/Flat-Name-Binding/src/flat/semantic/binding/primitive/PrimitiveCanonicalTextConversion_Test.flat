            }
            expect(rejected).toBe(true)
        }
    }

    async test `nullable local guards refine branches short circuit and early return only`() {
        let sources = [defaultSource("app", "Box",
            "class Box { visible Int count; static andRead(Box? value) -> Bool { return value != null && value.count > 0; } static present(Box? value) -> Int { if (value) { return value.count; } else { return 0; } } static early(Box? value) -> Int { if (value == null) { return 0; } return value.count; } static conditional(Box? value) -> Int { return value == null ? 0 : value.count; } static orRead(Box? value) -> Bool { return value == null || value.count > 0; } public receiverOr(Box? value) -> Int { return (value || !this) ? value.count : 0; } }")]
        let owner = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits().first
        expect(owner.functionUnits().filter({ _.staticFunction }).count).toBe(5)
        expect(owner.functionUnits().firstOrNull({ _.name == "receiverOr" }).parameterValues().first.semanticType.kind()).toBe("nullable")
        for (method in owner.functionUnits().filter({ _.staticFunction })) {
            expect(method.parameterValues().first.semanticType.kind()).toBe("nullable")
        }
    }

    async test `nullable local reassignment retains declared storage and requires a fresh guard`() {
        let sources = [defaultSource("app", "Box",
            "class Box { visible Int count; static run(Box? value) -> Int { if (value) { value = null; if (value != null) { return value.count; } } return 0; } }")]
        let owner = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits().first
        let method = owner.functionUnits().firstOrNull({ _.name == "run" })
        Object branchSource = method.statements().first
        BoundIfStatement branch = (BoundIfStatement)branchSource
        expect(method.parameterValues().first.semanticType.kind()).toBe("nullable")
        // Published assignment must still target nullable storage, not the
        // nonnullable read type established by the outer guard.
        let assignment = textAssignment(branch.thenValues().first)
        expect(assignment.target.semanticType.kind()).toBe("nullable")
        expect(assignment.value.semanticType.kind()).toBe("null")
        expect(assignment.conversion.applicable).toBe(true)
    }

    async test `nullable local proofs cannot escape branches writes calls closures or mutable fields`() {
        String[] sourcesText = [
            "class Box { visible Int count; static run(Box? value) -> Int { if (value) { return 0; } else { return value.count; } } }",
            "class Box { visible Int count; static run(Box? value) -> Int { if (value) { value = null; return value.count; } return 0; } }",
            "class Box { visible Int count; static touch() {} static run(Box? value) -> Int { if (value) { touch(); return value.count; } return 0; } }",
            "class Box { visible Int count; static consume(func()->Int callback) {} static run(Box? value) { if (value) { consume({ value.count }); } } }",
            "class Box { visible Int count; Box? field; public run() -> Int { if (field != null) { return field.count; } return 0; } }",
            "class Box { visible Int count; static run(Box? value, Bool other) -> Bool { return (value != null || other) && value.count > 0; } }",
            "class Box { visible Int count; static run(Box? value) -> Int { if (value) {} return value.count; } }",
            "class Box { visible Int count; static run(Box? value) -> Int { return value.count; } }"
        ]
        for (sourceText in sourcesText) {
            let sources = [defaultSource("app", "Box", sourceText)]
            var Bool rejected
            try { PrimitiveClassPartitionBinder().bindContexts(sources) }
            catch (Exception error) {
                if (!error.message.contains("Unknown member 'count'") || !error.message.contains("nullable:")) {
                    throw Exception("Proof invalidation fixture failed before the expected nullable member diagnostic: #{error.message}; source: #sourceText")
                }
                rejected = true
            }
            expect(rejected).toBe(true)
        }
    }

    async test `Exception constructor conditional refines parameter before text join and opaque projection`() {
        let sources = textSources("Int")
        sources[1] = textSource("flat", "String",
            "class String implements PlusOperator<String, String> { visible StringCharArray chars; public construct(native String str) {} public plus(String another) -> String { return this; } }")
        sources.add(textSource("flat", "StringCharArray", "class StringCharArray { native_array native Char[] data; }"))
        var String exceptionSource = "class Exception { public construct(visible String? message = \"\") { let text = message == null ? \"\" : message; external js { this.error = Error("
        exceptionSource += '#'
        exceptionSource += "{text.chars.data}); } } }"
        sources.add(textSource("app", "Exception", exceptionSource))
        let units = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits()
        let text = units.firstOrNull({ _.identity.name == "String" })
        let owner = units.firstOrNull({ _.identity.name == "Exception" })
        expect(owner.fieldUnits().first.semanticType.kind()).toBe("nullable")
        let entry = owner.functionUnits().firstOrNull({ _.constructorFunction })
        expect(entry.parameterValues().first.semanticType.kind()).toBe("nullable")
        let helpers = owner.functionUnits().filter({ !_.constructorFunction })
        var Bool found
        var Bool foundExternal
        for (helper in helpers) {
            for (statement in helper.statements()) {
                if (statement.class.isOfType(BoundLocalDeclarationStatement.class)) {
                    let local = textLocal(statement)
                    if (local.local.name == "text") {
                        expect(local.local.semanticType.value()).toBe(text.semanticType.value())
                        Object conditionalSource = local.initializer
                        BoundConditionalExpression conditional = (BoundConditionalExpression)conditionalSource
                        expect(conditional.whenTrue.semanticType.value()).toBe(text.semanticType.value())
                        expect(conditional.whenFalse.semanticType.value()).toBe(text.semanticType.value())
                        found = true
                    }
                }
                if (statement.class.isOfType(BoundExternalStatement.class)) {
                    Object externalSource = statement
                    BoundExternalStatement external = (BoundExternalStatement)externalSource
                    expect(external.segmentValues().any({ _.value != null })).toBe(true)
                    foundExternal = true
                }
            }
        }
        expect(found).toBe(true)
        expect(foundExternal).toBe(true)
    }

