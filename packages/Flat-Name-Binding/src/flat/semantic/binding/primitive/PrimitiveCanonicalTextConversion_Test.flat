        let method = owner.functionUnits().firstOrNull((function) => function.name == "equals")
        expect(method.identity.syntaxIdentity.snapshot.value).toBe(overlay.snapshot.value)
        expect(method.parameterValues().first.semanticType.kind()).toBe("nullable")
        expect(method.statements().count).toBe(3)
        Object guardSource = method.statements()[1]
        BoundIfStatement guard = (BoundIfStatement)guardSource
        Object conditionSource = guard.condition
