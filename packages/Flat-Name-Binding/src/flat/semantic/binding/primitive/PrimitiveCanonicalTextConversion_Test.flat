        expect(textConstruction.argumentValues().first.expressionKind()).toBe("literal")
        expect(textElement.semanticType.value()).toBe(root.semanticType.value())
        Object markerElementSource = elements.last
        BoundConversionExpression markerElement = (BoundConversionExpression)markerElementSource
        expect(markerElement.conversion.conversionKind).toBe("reference-upcast")
        expect(markerElement.value.expressionKind()).toBe("reference")
        Object referenceSource = markerElement.value
        BoundReferenceExpression reference = (BoundReferenceExpression)referenceSource
        expect(reference.symbolIdentity.value).toBe(marker.local.symbolIdentity.value)
        expect(reference.semanticType.value()).toBe(marker.local.semanticType.value())
        expect(markerElement.semanticType.value()).toBe(root.semanticType.value())
        // Both elements contain only a text constructor or the original local:
        // no marker.toString invocation, duplicate marker construction, or replay.
    }

    async test `explicit Object array rejects native references null and incompatible elements without inference changes`() {
        String[] bodies = [
