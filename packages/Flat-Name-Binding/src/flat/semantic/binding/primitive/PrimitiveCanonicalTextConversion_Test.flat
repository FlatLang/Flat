        }
    }

    async test `explicit exception child selects inherited method with canonical parent callable identity`() {
        let sources = [
            defaultSource("flat", "String", "class String { public construct(native String text) {} }"),
            defaultSource("flat", "Exception", "class Exception { public construct(String? message = \"\") {} public toString() -> String { return \"error\"; } }"),
            defaultSource("flat", "InvalidArgumentException", "class InvalidArgumentException extends Exception { public construct(String message) => super(message) }")
        ]
        sources.add(defaultSource("flat", "ExceptionWorkload", "class ExceptionWorkload { public static exceptions() -> String { let explicit = InvalidArgumentException(\"bad input\"); return explicit.toString(); } }"))
        let units = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits()
        let parent = units.firstOrNull((unit) => unit.identity.name == "Exception")
        let child = units.firstOrNull((unit) => unit.identity.name == "InvalidArgumentException")
        let owner = units.firstOrNull((unit) => unit.identity.name == "ExceptionWorkload")
        let method = owner.functionUnits().firstOrNull((candidate) => candidate.name == "exceptions")
        let local = textLocal(method.statements().first)
        let call = textCall(textReturn(method.statements().last).value)
        expect(call.target.ownerType.value()).toBe(parent.semanticType.value())
        let target = parent.functionUnits().firstOrNull((candidate) => candidate.name == "toString")
        expect(call.target.identity.declaration.value).toBe(target.identity.value)
        expect(call.receiver.semanticType.value()).toBe(child.semanticType.value())
        Object receiverSource = call.receiver
        BoundReferenceExpression receiver = (BoundReferenceExpression)receiverSource
        expect(receiver.symbolIdentity.value).toBe(local.local.symbolIdentity.value)
    }

    async test `inherited member lookup rejects nullable and unrelated receivers and invalid arguments`() {
        String[] consumers = [
            "public static run(Child? value) -> Int { return value.read(); }",
            "public static run(Other value) -> Int { return value.read(); }",
            "public static run(Child value) -> Int { return value.read(true); }"
        ]
        for (consumer in consumers) {
            let sources = [defaultSource("app", "Base", "class Base { public read(Int index) -> Int { return index; } }"),
                defaultSource("app", "Child", "class Child extends Base { public construct() {} }"),
                defaultSource("app", "Other", "class Other {}"),
                defaultSource("app", "InvalidInherited", "class InvalidInherited { " + consumer + " }")]
            var Bool rejected
            try { PrimitiveClassPartitionBinder().bindContexts(sources) }
            catch (Exception error) {
                if (!error.message.contains("read") && !error.message.contains("nullable:")) throw error
                rejected = true
            }
            expect(rejected).toBe(true)
        }
    }

    async test `runtime metadata name constructs canonical text around exactly one receiver intrinsic`() {
        let sources = [defaultSource("flat", "String", "class String { public construct(native String text) {} }"),
            defaultSource("flat", "Value", "class Value { public construct() {} }")]
        sources.add(defaultSource("flat", "MetadataText", "class MetadataText { public static next() -> Value { return Value(); } public static text(String value) {} public static run() { text(next().class.name); } }"))
        let units = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits()
        let owner = units.firstOrNull((unit) => unit.identity.name == "MetadataText")
        let canonical = units.firstOrNull((unit) => unit.identity.name == "String")
        let method = owner.functionUnits().firstOrNull((candidate) => candidate.name == "run")
        Object statementSource = method.statements().first
        BoundExpressionStatement statement = (BoundExpressionStatement)statementSource
        let consumer = textCall(statement.expression)
        let construction = textCall(consumer.argumentValues().first)
        expect(construction.target.ownerType.value()).toBe(canonical.semanticType.value())
        expect(construction.target.callableKind.value).toBe("constructor")
        expect(construction.argumentValues().count).toBe(1)
        Object intrinsicSource = construction.argumentValues().first
        BoundClassNameExpression intrinsic = (BoundClassNameExpression)intrinsicSource
        expect(intrinsic.semanticType.value()).toBe(SemanticTypes.stringType().value())
        expect(textCall(intrinsic.receiver).target.name).toBe("next")
        expect(construction.range.snapshot.value).toBe(intrinsic.range.snapshot.value)
        expect(construction.range.startTokenIndex).toBe(intrinsic.range.startTokenIndex)
    }

    async test `runtime metadata bridge does not adapt native text references`() {
