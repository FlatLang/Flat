    async test `Core String equals retains guarded local across stored count reads into JS overlay compareTo`() {
        let base = defaultSource("flat", "String",
            "class String { visible Int count; public equals(String? other) => (other || !this) && count == other.count && compareTo(other) == 0 public compareTo(String other) -> Int { return 0; } }")
        let overlay = textSource("flat", "String",
            "class String { public compareTo(String other) -> Int { return 0; } }", "js-compare")
        let merged = base.classValues().first.mergedWith(overlay.classValues().first)
        let sources = [PrimitiveSourceBindingContext("flat", base.snapshot, [merged]),
            PrimitiveSourceBindingContext("flat", overlay.snapshot, PrimitiveClassSyntax[])]
        let owner = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits().first
        let equals = owner.functionUnits().firstOrNull((method) => method.name == "equals")
        let compare = owner.functionUnits().firstOrNull((method) => method.name == "compareTo")
        expect(equals.parameterValues().first.semanticType.kind()).toBe("nullable")
        expect(compare.identity.syntaxIdentity.snapshot.value).toBe(overlay.snapshot.value)
        expect(compare.parameterValues().first.semanticType.value()).toBe(owner.semanticType.value())
        Object returnedSource = textReturn(equals.statements().first).value
        BoundBinaryExpression returned = (BoundBinaryExpression)returnedSource
        Object lastSource = returned.right
        BoundBinaryExpression last = (BoundBinaryExpression)lastSource
        let call = textCall(last.left)
        expect(call.target.identity.declaration.value).toBe(compare.identity.value)
        expect(call.target.ownerType.value()).toBe(owner.semanticType.value())
        expect(call.receiver.semanticType.value()).toBe(owner.semanticType.value())
        expect(call.argumentValues().first.semanticType.value()).toBe(owner.semanticType.value())
    }

    async test `presence proofs do not cross property getters or calls`() {
        String[] bodies = [
            "public Int count => touch() public touch() -> Int { return 0; } public run(Box? other) -> Bool { return other != null && count == other.count && consume(other) == 0; }",
            "visible Int count; public touch() -> Bool { return true; } public run(Box? other) -> Bool { return other != null && touch() && consume(other) == 0; }"
        ]
        for (body in bodies) {
            let source = defaultSource("app", "Box", "class Box { " + body + " public consume(Box other) -> Int { return 0; } }")
            var Bool rejected
            try { PrimitiveClassPartitionBinder().bindContexts([source]) }
            catch (Exception error) {
                let nullableMember = error.message.contains("Unknown member 'count'") &&
                    error.message.contains("nullable:")
                let nullableArgument = error.message.contains("consume") &&
                    error.message.contains("nullable:")
                if ((!nullableMember && !nullableArgument) || error.message.contains("syntax error")) {
                    throw Exception("Expected checked nullable rejection; actual #{error.message}; body #body")
                }
                rejected = true
            }
            expect(rejected).toBe(true)
        }
    }

    async test `interpolation cannot reuse presence proof after an earlier segment changes the local`() {
