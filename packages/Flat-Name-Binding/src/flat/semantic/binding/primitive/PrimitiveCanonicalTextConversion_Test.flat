    async test `List nullable Object absence guard uses null comparison without overloaded truthiness`() {
        let object = defaultSource("flat", "Object", "class Object {}")
        let source = defaultSource("flat/datastruct/list", "Presence",
            "class Presence { public equals(Object? another) => true { if (!another) { return false; } } public absent(Object? value) -> Bool { return !value; } public nonnull(Object value) -> Bool { return !value; } public boolean(Bool value) -> Bool { return !value; } }")
        let units = PrimitiveClassPartitionBinder().bindContexts([object, source]).typeUnits()
        let owner = units.firstOrNull((unit) => unit.identity.name == "Presence")
        let equals = owner.functionUnits().firstOrNull((function) => function.name == "equals")
        Object branchSource = equals.statements().first
        BoundIfStatement branch = (BoundIfStatement)branchSource
        Object conditionSource = branch.condition
        BoundBinaryExpression condition = (BoundBinaryExpression)conditionSource
        expect(condition.operator).toBe("==")
        expect(condition.semanticType.value()).toBe(SemanticTypes.boolType().value())
        expect(condition.left.semanticType.kind()).toBe("nullable")
        expect(condition.left.expressionKind()).toBe("reference")
        expect(condition.right.semanticType.kind()).toBe("null")
        expect(condition.range.snapshot.value).toBe(source.snapshot.value)
        let absent = owner.functionUnits().firstOrNull((function) => function.name == "absent")
        Object absentSource = textReturn(absent.statements().first).value
        BoundBinaryExpression absence = (BoundBinaryExpression)absentSource
        expect(absence.operator).toBe("==")
        expect(absence.left.expressionKind()).toBe("reference")
        let nonnull = owner.functionUnits().firstOrNull((function) => function.name == "nonnull")
        Object nonnullSource = textReturn(nonnull.statements().first).value
        BoundBinaryExpression nonnullAbsence = (BoundBinaryExpression)nonnullSource
        expect(nonnullAbsence.operator).toBe("==")
        expect(nonnullAbsence.left.expressionKind()).toBe("conversion")
        let boolean = owner.functionUnits().firstOrNull((function) => function.name == "boolean")
        Object booleanSource = textReturn(boolean.statements().first).value
        BoundUnaryExpression negation = (BoundUnaryExpression)booleanSource
        expect(negation.operator).toBe("!")
        expect(negation.operand.semanticType.value()).toBe(SemanticTypes.boolType().value())
    }

    async test `nullable scalar and composite negation do not borrow reference absence semantics`() {
        String[] bodies = [
            "public invalid(Int? value) -> Bool { return !value; }",
            "public invalid(Int value) -> Bool { return !value; }",
            "public invalid(Object? value) -> Bool { return !(value + 1); }"
        ]
        for (body in bodies) {
            let object = defaultSource("flat", "Object", "class Object {}")
            let source = defaultSource("app", "InvalidPresence", "class InvalidPresence { " + body + " }")
            var Bool rejected
            try { PrimitiveClassPartitionBinder().bindContexts([object, source]) }
            catch (Exception error) {
                let invalidOperator = error.message.contains("Operator '!'") || error.message.contains("Operator '+'")
                if ((!error.message.contains("type.unary") && !error.message.contains("type.binary") && !invalidOperator) ||
                    !error.message.contains("invalid")) {
                    throw Exception("Expected invalid unary/binary diagnostic; actual #{error.message}; body #body")
                }
                rejected = true
            }
            expect(rejected).toBe(true)
        }
    }

    async test `Core substring bounds source text constructs canonical String before nullable Exception argument lift`() {
        let sources = textSources("Int")
        sources.add(textSource("flat/exception", "Exception",
            "class Exception { public construct(visible String? message = \"\") {} }"))
        var String message = "\"Substring bounds of ["
        message += '#'
        message += "start, "
        message += '#'
        message += "end] are invalid\""
        let source = textSource("flat", "Bounds",
            "class Bounds { visible Int count; public validateSubstringBounds(Int start, Int end, Bool throwException = false) => true { if (start < 0 || end < start || end > count) { if (throwException) { throw Exception(" + message + "); } return false; } } static literal() { Exception(\"literal\"); } static absent() { Exception(null); } }")
        sources.add(source)
        let units = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits()
        let owner = units.firstOrNull((unit) => unit.identity.name == "Bounds")
        let text = units.firstOrNull((unit) => unit.identity.name == "String")
        let exception = units.firstOrNull((unit) => unit.identity.name == "Exception")
        let bounds = owner.functionUnits().firstOrNull((function) => function.name == "validateSubstringBounds")
        Object outerSource = bounds.statements().first
        BoundIfStatement outer = (BoundIfStatement)outerSource
        Object innerSource = outer.thenValues().first
        BoundIfStatement inner = (BoundIfStatement)innerSource
        Object throwSource = inner.thenValues().first
        BoundThrowStatement thrown = (BoundThrowStatement)throwSource
        let call = textCall(thrown.value)
        expect(call.target.ownerType.value()).toBe(exception.semanticType.value())
        expect(call.target.parameterTypes().first.kind()).toBe("nullable")
        expect(call.argumentConversions().first.conversionKind).toBe("nullable-lift")
        let constructed = textCall(call.argumentValues().first)
        expect(constructed.target.ownerType.value()).toBe(text.semanticType.value())
        expect(constructed.argumentValues().first.expressionKind()).toBe("interpolated-string")
        expect(constructed.argumentValues().first.range.snapshot.value).toBe(source.snapshot.value)
        let literal = owner.functionUnits().firstOrNull((function) => function.name == "literal")
        Object literalSource = literal.statements().first
        BoundExpressionStatement literalStatement = (BoundExpressionStatement)literalSource
        expect(textCall(literalStatement.expression).argumentConversions().first.conversionKind).toBe("nullable-lift")
        let absent = owner.functionUnits().firstOrNull((function) => function.name == "absent")
        Object absentSource = absent.statements().first
        BoundExpressionStatement absentStatement = (BoundExpressionStatement)absentSource
        expect(textCall(absentStatement.expression).argumentValues().first.semanticType.kind()).toBe("null")
        expect(textCall(absentStatement.expression).argumentConversions().first.conversionKind).toBe("null")
    }

