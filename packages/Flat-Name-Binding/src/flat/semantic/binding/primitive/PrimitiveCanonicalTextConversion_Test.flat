    async test `explicit constructed reference local uses checked transitive ancestor without primitive boxing`() {
        let sources = [
            defaultSource("flat", "Object", "class Object {}"),
            defaultSource("flat/primitive", "Primitive", "class Primitive {}"),
            defaultSource("flat/primitive/number", "Number", "class Number<Type> extends Primitive { public construct() {} }"),
            defaultSource("flat/primitive/number", "Double", "class Double extends Number<Double> { public construct(Double value) {} }")
        ]
        let number = sources[2]
        sources[2] = PrimitiveSourceBindingContext("flat/primitive/number", number.snapshot, number.classValues(),
            importValues: [PrimitiveBindingImport("flat/primitive/Primitive", number.classValues().first.range)])
        let raw = defaultSource("core/workloads", "LocalUpcast", "class LocalUpcast { public static run() { let Object zero = Double(0.0); } }")
        sources.add(PrimitiveSourceBindingContext("core/workloads", raw.snapshot, raw.classValues(),
            importValues: [PrimitiveBindingImport("flat/primitive/number/Double", raw.classValues().first.range)]))
        let units = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits()
        let owner = units.firstOrNull((unit) => unit.identity.name == "LocalUpcast")
        let root = units.firstOrNull((unit) => unit.identity.name == "Object")
        let constructed = units.firstOrNull((unit) => unit.identity.name == "Double")
        let method = owner.functionUnits().firstOrNull((candidate) => candidate.name == "run")
        let local = textLocal(method.statements().first)
        expect(local.local.semanticType.value()).toBe(root.semanticType.value())
        expect(local.conversion.conversionKind).toBe("reference-upcast")
        expect(local.conversion.implicit).toBe(true)
        expect(local.conversion.fromType.value()).toBe(constructed.semanticType.value())
        expect(local.conversion.toType.value()).toBe(root.semanticType.value())
        let call = textCall(local.initializer)
        expect(call.target.ownerType.value()).toBe(constructed.semanticType.value())
        expect(call.target.callableKind.value).toBe("constructor")
        expect(call.argumentValues().count).toBe(1)
        expect(call.argumentValues().first.semanticType.value()).toBe(SemanticTypes.doubleType().value())
        expect(call.argumentValues().first.expressionKind()).toBe("literal")
        expect(local.range.snapshot.value).toBe(raw.snapshot.value)
    }

