            "class Box { visible Int count; static run(Box? value) -> String { if (value) { return " + expression + "; } return \"\"; } }",
            "class Box { visible Int count; static run(Box? value) -> String { if (value) { let text = " + expression + "; return text; } return \"\"; } }"
        ]
