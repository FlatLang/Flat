            "let marker = ProductionDisplayValue(); let mixed = [\"hello\", marker];",
            "let Object marker = ProductionDisplayValue(); let mixed = [marker, \"hello\"];",
            "let Object[] mixed = existing;"
        ]
        for (body in bodies) {
            let sources = objectArraySources()
            let raw = defaultSource("app", "InvalidMixed", "class InvalidMixed { public static run(native String text, native_array native String[] existing) { " + body + " } }")
            sources.add(PrimitiveSourceBindingContext("app", raw.snapshot, raw.classValues(),
                importValues: [PrimitiveBindingImport("flat/Array", raw.classValues().first.range)]))
            var Bool rejected
            try { PrimitiveClassPartitionBinder().bindContexts(sources) }
            catch (Exception error) {
                if (!error.message.contains("Array element") && !error.message.contains("Local initializer type mismatch")) {
                    throw Exception("Expected checked array storage rejection: #{error.message}")
