        }
    }

    async test `production static trace writes retain canonical String owner and source order`() {
        let sources = textSources("Int")
        sources.add(textSource("core/workloads", "ProductionCoreWorkload",
            "class ProductionCoreWorkload { static String trace = \"\"; static leftDeclared(native String value) -> String { trace += \"L\"; return String(value); } static rightDeclared(native String value) -> String { trace += \"R\"; return String(value); } static concatenation() { trace = \"\"; let dd = leftDeclared(\"left\") + rightDeclared(\"right\"); trace += dd; } }"))
        let units = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits()
        let owner = units.firstOrNull({ _.identity.name == "ProductionCoreWorkload" })
        let text = units.firstOrNull({ _.identity.name == "String" })
        let field = owner.fieldUnits().firstOrNull({ _.name == "trace" })
        String[] methodNames = ["leftDeclared", "rightDeclared"]
        for (methodName in methodNames) {
            let method = owner.functionUnits().firstOrNull((candidate) => candidate.name == methodName)
            expect(method.statements().count).toBe(2)
            let write = textAssignment(method.statements().first)
            expect(write.target.symbolIdentity.value).toBe(field.identity.value)
            expect(write.target.staticOwner.value).toBe(owner.identity.value)
            expect(write.target.fieldOwnerIdentity.value).toBe(field.canonicalOwner().value)
            expect(write.target.range.snapshot.value).toBe(field.range.snapshot.value)
            let plus = textCall(write.value)
            expect(plus.target.name).toBe("plus")
            expect(plus.receiver == write.target).toBe(true)
            expect(plus.semanticType.value()).toBe(text.semanticType.value())
            let literal = textCall(plus.argumentValues().first)
            expect(literal.target.callableKind.value).toBe("constructor")
            expect(literal.argumentValues().first.expressionKind()).toBe("literal")
            let returned = textCall(textReturn(method.statements().last).value)
            expect(returned.target.callableKind.value).toBe("constructor")
            expect(returned.argumentValues().first.semanticType.value()).toBe(SemanticTypes.stringType().value())
            expect(write.range.endTokenIndex <= method.statements().last.range.startTokenIndex).toBe(true)
        }
        let sequence = owner.functionUnits().firstOrNull({ _.name == "concatenation" }).statements()
        expect(sequence.count).toBe(3)
        let reset = textAssignment(sequence.first)
        expect(reset.target.staticOwner.value).toBe(owner.identity.value)
        expect(textCall(reset.value).target.callableKind.value).toBe("constructor")
        let joined = textCall(textLocal(sequence[1]).initializer)
        expect(joined.target.name).toBe("plus")
        expect(textCall(joined.receiver).target.name).toBe("leftDeclared")
        expect(textCall(joined.argumentValues().first).target.name).toBe("rightDeclared")
        expect(textAssignment(sequence.last).target.symbolIdentity.value).toBe(field.identity.value)
    }

    async test `static field writes preserve lexical shadowing and instance method access`() {
        let sources = textSources("Int")
        sources.add(textSource("app", "Trace",
            "class Trace { static String trace = \"\"; public construct() {} public append() { trace = \"I\"; trace += \"N\"; } static shadow() { let String trace = \"local\"; trace = \"S\"; trace += \"L\"; } }"))
        let owner = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits().firstOrNull({ _.identity.name == "Trace" })
        let field = owner.fieldUnits().firstOrNull({ _.name == "trace" })
        let append = owner.functionUnits().firstOrNull({ _.name == "append" })
        for (statement in append.statements()) {
            let write = textAssignment(statement)
            expect(write.target.staticOwner.value).toBe(owner.identity.value)
            expect(write.target.symbolIdentity.value).toBe(field.identity.value)
        }
        let shadow = owner.functionUnits().firstOrNull({ _.name == "shadow" }).statements()
        let local = textLocal(shadow.first).local
        for (index in 1..3) {
            let write = textAssignment(shadow[index])
            expect(write.target.staticOwner == null).toBe(true)
            expect(write.target.symbolIdentity.value).toBe(local.symbolIdentity.value)
        }
    }

