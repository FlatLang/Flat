    async test `strict null initializer diagnostic retains exact local source range`() {
        let source = textSource("app", "StrictRange", "class StrictRange { static run() { let String absent = null; } }")
        let syntax = source.classValues().first.methodValues().first
        let expected = syntax.statements().first.range
        let statements = PrimitiveStatementSyntaxResult(syntax.statements())
        let sources = textSources("Int")
        sources.add(source)
        let resolver = PrimitiveStructuralTypeResolver(declarationContext:
            PrimitiveResolvedDeclarationContext(source, sources))
        var Bool rejected
        try { PrimitiveControlStatementBinder().bind(statements, source.snapshot, typeResolver: resolver) }
        catch (Exception error) {
            expect(error.class.isOfType(PrimitiveContextBindingException.class)).toBe(true)
            Object errorSource = error
            PrimitiveContextBindingException failure = (PrimitiveContextBindingException)errorSource
            expect(failure.diagnostic.code).toBe("binding.local-initializer-type")
            expect(failure.diagnostic.range.snapshot.value).toBe(expected.snapshot.value)
            expect(failure.diagnostic.range.startTokenIndex).toBe(expected.startTokenIndex)
            expect(failure.diagnostic.range.endTokenIndex).toBe(expected.endTokenIndex)
            rejected = true
        }
        expect(rejected).toBe(true)
    }

