    async test `intrinsic reference equality retains original operands and proves actual ancestor conversions in both orders`() {
        let sources = objectArraySources()
        sources.add(defaultSource("app", "Equality",
            "class Equality { public static forward(Object base, ProductionDisplayValue marker) -> Bool { return base == marker; } public static reverse(Object base, ProductionDisplayValue marker) -> Bool { return marker == base; } public static unequal(Object base, ProductionDisplayValue marker) -> Bool { return base != marker; } public static reverseUnequal(Object base, ProductionDisplayValue marker) -> Bool { return marker != base; } }"))
        let units = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits()
        let owner = units.firstOrNull((unit) => unit.identity.name == "Equality")
        let ancestor = units.firstOrNull((unit) => unit.identity.name == "Object")
        for (method in owner.functionUnits()) {
            if (method.name != "forward" && method.name != "reverse" &&
                method.name != "unequal" && method.name != "reverseUnequal") continue
            Object binarySource = textReturn(method.statements().first).value
            BoundBinaryExpression binary = (BoundBinaryExpression)binarySource
            let reversed = method.name == "reverse" || method.name == "reverseUnequal"
            expect(binary.operator).toBe(method.name == "unequal" || method.name == "reverseUnequal" ? "!=" : "==")
            expect(binary.left.semanticType.value()).toBe(ancestor.semanticType.value())
            expect(binary.right.semanticType.value()).toBe(ancestor.semanticType.value())
            Object conversionSource = reversed ? binary.left : binary.right
            BoundConversionExpression conversion = (BoundConversionExpression)conversionSource
            expect(conversion.conversion.conversionKind).toBe("reference-upcast")
            expect(conversion.conversion.implicit).toBe(true)
            expect(conversion.conversion.toType.value()).toBe(ancestor.semanticType.value())
            expect(conversion.value.expressionKind()).toBe("reference")
            Object markerSource = conversion.value
            BoundReferenceExpression marker = (BoundReferenceExpression)markerSource
            expect(marker.symbolIdentity.value).toBe(method.parameterValues().last.identity.value)
            expect(conversion.conversion.fromType.value()).toBe(marker.semanticType.value())
            Object baseSource = reversed ? binary.right : binary.left
            BoundReferenceExpression base = (BoundReferenceExpression)baseSource
            expect(base.symbolIdentity.value).toBe(method.parameterValues().first.identity.value)
            expect(conversion.range.snapshot.value).toBe(method.range.snapshot.value)
            expect(PrimitiveClassBinder.bindReferenceEquality(binary.operator,
                conversion.value, base, binary.range) == null).toBe(true)
        }
    }

    async test `generic reference equality retains only proven ancestor projection`() {
