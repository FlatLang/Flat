    async test `explicit Object array literal constructs source text and preserves ordered marker identity without display calls`() {
        let sources = objectArraySources()
        let raw = defaultSource("app", "Mixed",
            "class Mixed { public static run() { let marker = ProductionDisplayValue(); let Object[] mixed = [\"hello\", marker]; } }")
        sources.add(PrimitiveSourceBindingContext("app", raw.snapshot, raw.classValues(),
            importValues: [PrimitiveBindingImport("flat/Array", raw.classValues().first.range)]))
        let units = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits()
        let owner = units.firstOrNull((unit) => unit.identity.name == "Mixed")
        let method = owner.functionUnits().firstOrNull((candidate) => candidate.name == "run")
        expect(method.statements().count).toBe(2)
        let marker = textLocal(method.statements().first)
        let mixed = textLocal(method.statements().last)
        expect(mixed.local.semanticType.kind()).toBe("generic-instance")
        let construction = textCall(mixed.initializer)
        expect(construction.target.name).toBe("Array")
        Object storageSource = construction.argumentValues().first
        BoundArrayExpression storage = (BoundArrayExpression)storageSource
        let elements = storage.elementValues()
        expect(elements.count).toBe(2)
        Object textElementSource = elements.first
        BoundConversionExpression textElement = (BoundConversionExpression)textElementSource
        expect(textElement.conversion.conversionKind).toBe("reference-upcast")
        let textConstruction = textCall(textElement.value)
        let text = units.firstOrNull((unit) => unit.identity.name == "String")
        let root = units.firstOrNull((unit) => unit.identity.name == "Object")
        expect(textConstruction.target.callableKind.value).toBe("constructor")
