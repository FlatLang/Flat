    async test `short circuit declarations are visible only in definitely evaluated condition arms`() {
        String[] bodies = [
            "if (gate && (let selected = input)) { return selected.count; } else { return 0; }",
            "if (gate || (let selected = input)) { return 0; } else { return selected.count; }",
            "if (!(gate && (let selected = input))) { return 0; } else { return selected.count; }",
            "if (gate && (let selected = input) && selected.count > 0) { return selected.count; } return 0;",
            "return gate && (let selected = input) ? selected.count : 0;",
            "return gate || (let selected = input) ? 0 : selected.count;"
        ]
        for (body in bodies) {
            let source = defaultSource("app", "Box", "class Box { visible Int count; static run(Bool gate, Box input) -> Int { " + body + " } }")
            let owner = PrimitiveClassPartitionBinder().bindContexts([source]).typeUnits().first
            expect(owner.functionUnits().firstOrNull((function) => function.name == "run").returnType.value()).toBe(SemanticTypes.intType().value())
        }
    }

    async test `skipped short circuit declarations reject opposite arms ternary chains and continuation`() {
        String[] bodies = [
            "if (gate && (let selected = input)) { return selected.count; } else { return selected.count; }",
