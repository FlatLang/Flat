    async test `guarded native array capture preserves overlay field identity and setup free opaque references`() {
        let base = defaultSource("flat/datastruct/list", "StringCharArray",
            "class StringCharArray { visible Int count; }")
        var String body = "class StringCharArray { visible native_array native Char[] data; public equals(StringCharArray? other) -> Bool { if (other == null) { return false; } if (count != other.count) { return false; } native_array native Char[] otherData = other.data; external js { if ("
        body += '#'
        body += "{data} == null) return "
        body += '#'
        body += "{otherData} == null; return "
        body += '#'
        body += "{data} === "
        body += '#'
        body += "{otherData}; } } }"
        let overlay = textSource("flat/datastruct/list", "StringCharArray", body, "native-capture-js")
        let merged = base.classValues().first.mergedWith(overlay.classValues().first)
        let sources = [PrimitiveSourceBindingContext("flat/datastruct/list", base.snapshot, [merged]),
            PrimitiveSourceBindingContext("flat/datastruct/list", overlay.snapshot, PrimitiveClassSyntax[])]
        let owner = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits().first
        let field = owner.fieldUnits().firstOrNull((candidate) => candidate.name == "data")
        expect(field.nativeArrayStorage).toBe(true)
        expect(field.semanticType.kind()).toBe("array")
        expect(field.canonicalOwner().value).toBe(owner.identity.value)
        expect(field.identity.declaration.syntaxIdentity.snapshot.value).toBe(overlay.snapshot.value)
        expect(field.range.snapshot.value).toBe(overlay.snapshot.value)
        let method = owner.functionUnits().firstOrNull((candidate) => candidate.name == "equals")
        expect(method.statements().count).toBe(4)
        let capture = textLocal(method.statements()[2])
        expect(capture.local.name).toBe("otherData")
        expect(capture.local.semanticType.value()).toBe(field.semanticType.value())
        expect(capture.initializer.expressionKind()).toBe("member-access")
        Object accessSource = capture.initializer
        BoundMemberAccessExpression access = (BoundMemberAccessExpression)accessSource
        expect(access.memberIdentity.value).toBe(field.identity.value)
        expect(access.receiver.semanticType.value()).toBe(owner.semanticType.value())
        expect(access.range.snapshot.value).toBe(overlay.snapshot.value)
        let parsedMethod = merged.methodValues().firstOrNull((candidate) => candidate.name == "equals")
        Object parsedCaptureSource = parsedMethod.statements()[2]
        PrimitiveLocalDeclarationSyntax parsedCapture = (PrimitiveLocalDeclarationSyntax)parsedCaptureSource
        expect(parsedCapture.nativeArrayStorage).toBe(true)
        expect(parsedCapture.nativeScalarStorage).toBe(false)
        Object externalSource = method.statements().last
        BoundExternalStatement external = (BoundExternalStatement)externalSource
        let values = external.segmentValues().filter((segment) => segment.value != null)
        expect(values.count).toBe(4)
        var Int index
        for (segment in values) {
            if (index == 1 || index == 3) {
                expect(segment.value.expressionKind()).toBe("reference")
                Object referenceSource = segment.value
                BoundReferenceExpression reference = (BoundReferenceExpression)referenceSource
                expect(reference.symbolIdentity.value).toBe(capture.local.symbolIdentity.value)
                expect(reference.semanticType.value()).toBe(field.semanticType.value())
            } else {
                expect(segment.value.expressionKind()).toBe("member-access")
                Object fieldAccessSource = segment.value
                BoundMemberAccessExpression fieldAccess = (BoundMemberAccessExpression)fieldAccessSource
                expect(fieldAccess.memberIdentity.value).toBe(field.identity.value)
                expect(fieldAccess.semanticType.value()).toBe(field.semanticType.value())
                expect(fieldAccess.receiver.expressionKind()).toBe("reference")
                expect(fieldAccess.receiver.semanticType.value()).toBe(owner.semanticType.value())
            }
            expect(segment.range.snapshot.value).toBe(overlay.snapshot.value)
            index++
        }
    }

