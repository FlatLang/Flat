    async test `production native concatenation retains native local for Core String constructor overloads`() {
        let sources = textSources("Int")
        // Declared and native-storage Char[] are distinct overloads. Preserve
        // both source snapshots and storage contracts through overlay merging.
        let base = textSource("flat", "String",
            "class String implements PlusOperator<String, String> { public construct(Char[] chars) {} public construct(StringCharArray chars) {} public plus(String another) -> String { return this; } }", "base")
        let overlay = textSource("flat", "String",
            "class String { public construct(Char c) {} public construct(native_array native Char[] chars, Int count) {} public construct(native_array native Char[] chars) {} public construct(native String str) {} }", "js")
        let merged = base.classValues().first.mergedWith(overlay.classValues().first)
        expect(merged.constructorValues().count).toBe(6)
        let declaredArray = merged.constructorValues().firstOrNull((candidate) =>
            candidate.parameterValues().count == 1 && candidate.parameterValues().first.typeName == "Char[]" &&
            !candidate.parameterValues().first.nativeArrayStorage)
        expect(declaredArray.parameterValues().first.nativeArrayStorage).toBe(false)
        expect(declaredArray.parameterValues().first.nativeScalarStorage).toBe(false)
        expect(declaredArray.range.snapshot.value).toBe(base.snapshot.value)
        let charArray = merged.constructorValues().firstOrNull((candidate) =>
            candidate.parameterValues().count == 1 && candidate.parameterValues().first.typeName == "Char[]" &&
            candidate.parameterValues().first.nativeArrayStorage)
        expect(charArray.range.snapshot.value).toBe(overlay.snapshot.value)
        expect(charArray.parameterValues().first.nativeArrayStorage).toBe(true)
        // Parser stores native scalars only for non-array types; native Char[]
        // is represented by nativeArrayStorage, never by nativeScalarStorage.
        expect(charArray.parameterValues().first.nativeScalarStorage).toBe(false)
        expect(charArray.range.snapshot.value).toBe(overlay.snapshot.value)
        sources[1] = PrimitiveSourceBindingContext("flat", base.snapshot, [merged],
            importValues: [PrimitiveBindingImport("flat/operators/PlusOperator", merged.range)])
        sources.add(PrimitiveSourceBindingContext("flat", overlay.snapshot, PrimitiveClassSyntax[]))
        sources.add(textSource("flat", "StringCharArray", "class StringCharArray {}"))
        sources.add(textSource("core/workloads", "ProductionCoreWorkload",
            "class ProductionCoreWorkload { static String trace = \"\"; static text(String actual, String expected, String label) {} static leftNative(native String value) => value { trace += \"L\"; } static rightNative(native String value) => value { trace += \"R\"; } static concatenation() { trace = \"\"; let nn = leftNative(\"native-left|\") + rightNative(\"native-right\"); text(trace, \"LR\", \"native native evaluation\"); text(String(nn), \"native-left|native-right\", \"native native contents\"); } }"))
        let units = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits()
        let owner = units.firstOrNull({ _.identity.name == "ProductionCoreWorkload" })
        let text = units.firstOrNull({ _.identity.name == "String" })
        let constructors = text.functionUnits().filter({ _.constructorFunction })
        expect(constructors.count).toBe(6)
        let declaredArrayConstructor = constructors.firstOrNull((candidate) =>
            candidate.parameterValues().count == 1 &&
            candidate.parameterValues().first.semanticType.kind() == "array" &&
            candidate.identity.syntaxIdentity.snapshot.value == base.snapshot.value)
        let nativeArrayConstructor = constructors.firstOrNull((candidate) =>
            candidate.parameterValues().count == 1 &&
            candidate.parameterValues().first.semanticType.kind() == "array" &&
            candidate.identity.syntaxIdentity.snapshot.value == overlay.snapshot.value)
        expect(declaredArrayConstructor.range.startTokenIndex).toBe(declaredArray.range.startTokenIndex)
        expect(nativeArrayConstructor.range.startTokenIndex).toBe(charArray.range.startTokenIndex)
        expect(declaredArrayConstructor.identity.value == nativeArrayConstructor.identity.value).toBe(false)
        expect(declaredArrayConstructor.parameterValues().first.semanticType.value()).toBe(
            ArraySemanticType(SemanticTypes.charType()).value())
        expect(nativeArrayConstructor.parameterValues().first.semanticType.value()).toBe(
            ArraySemanticType(SemanticTypes.charType()).value())
        let statements = owner.functionUnits().firstOrNull({ _.name == "concatenation" }).statements()
        expect(statements.count).toBe(4)
        let nativeLocal = textLocal(statements[1])
        expect(nativeLocal.local.semanticType.value()).toBe(SemanticTypes.stringType().value())
        expect(nativeLocal.initializer.expressionKind()).toBe("binary")
        Object binarySource = nativeLocal.initializer
        BoundBinaryExpression binary = (BoundBinaryExpression)binarySource
        expect(textCall(binary.left).target.name).toBe("leftNative")
        expect(textCall(binary.right).target.name).toBe("rightNative")
        Object statementSource = statements.last
        BoundExpressionStatement statement = (BoundExpressionStatement)statementSource
        let call = textCall(statement.expression)
        let constructed = textCall(call.argumentValues().first)
        expect(constructed.target.callableKind.value).toBe("constructor")
        expect(constructed.target.ownerType.value()).toBe(text.semanticType.value())
        expect(constructed.target.parameterTypes().count).toBe(1)
        expect(constructed.target.parameterTypes().first.value()).toBe(SemanticTypes.stringType().value())
        expect(constructed.argumentValues().first.expressionKind()).toBe("reference")
        expect(constructed.argumentValues().first.semanticType.value()).toBe(SemanticTypes.stringType().value())
        Object referenceSource = constructed.argumentValues().first
        BoundReferenceExpression reference = (BoundReferenceExpression)referenceSource
        expect(reference.symbolIdentity.value).toBe(nativeLocal.local.symbolIdentity.value)
        for (index in 1..3) {
            let literal = textCall(call.argumentValues()[index])
            expect(literal.target.parameterTypes().first.value()).toBe(SemanticTypes.stringType().value())
        }
    }

    async test `inferred source text constructs String but inferred native references remain native`() {
        let sources = textSources("Int")
        sources.add(textSource("app", "Inference",
            "class Inference { static run(native String input) { let literal = \"source\"; let nativeValue = input; let constructed = String(nativeValue); } }"))
        let units = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits()
        let owner = units.firstOrNull({ _.identity.name == "Inference" })
        let text = units.firstOrNull({ _.identity.name == "String" })
        let statements = owner.functionUnits().firstOrNull({ _.name == "run" }).statements()
        expect(textLocal(statements[0]).local.semanticType.value()).toBe(text.semanticType.value())
        expect(textCall(textLocal(statements[0]).initializer).target.callableKind.value).toBe("constructor")
        expect(textLocal(statements[1]).local.semanticType.value()).toBe(SemanticTypes.stringType().value())
        expect(textLocal(statements[1]).initializer.expressionKind()).toBe("reference")
        expect(textCall(textLocal(statements[2]).initializer).target.parameterTypes().first.value()).toBe(SemanticTypes.stringType().value())

        let invalidSources = textSources("Int")
        invalidSources.add(textSource("app", "InvalidInference",
            "class InvalidInference { static accept(String value) {} static run(native String input) { let nativeValue = input; accept(nativeValue); } }"))
        var Bool rejected
        try { PrimitiveClassPartitionBinder().bindContexts(invalidSources) }
        catch (Exception error) { rejected = error.message.contains("No overload of 'accept'") }
        expect(rejected).toBe(true)
    }

    async test `production static text call constructs literal arguments without changing declared input`() {
        let sources = textSources("Int")
        sources.add(textSource("core/workloads", "ProductionCoreWorkload",
            "class ProductionCoreWorkload { static String trace = \"\"; static text(String actual, String expected, String label) {} static concatenation() { text(trace, \"LR\", \"declared declared evaluation\"); } }"))
        let units = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits()
        let owner = units.firstOrNull({ _.identity.name == "ProductionCoreWorkload" })
        let text = units.firstOrNull({ _.identity.name == "String" })
        let method = owner.functionUnits().firstOrNull({ _.name == "concatenation" })
        Object statementSource = method.statements().first
        BoundExpressionStatement statement = (BoundExpressionStatement)statementSource
        let call = textCall(statement.expression)
        expect(call.target.name).toBe("text")
        expect(call.target.callableKind.value).toBe("static-method")
        expect(call.receiver == null).toBe(true)
        expect(call.argumentValues().count).toBe(3)
        expect(call.argumentValues().first.expressionKind()).toBe("reference")
        for (index in 1..3) {
            let wrapped = textCall(call.argumentValues()[index])
            expect(wrapped.target.callableKind.value).toBe("constructor")
            expect(wrapped.target.ownerType.value()).toBe(text.semanticType.value())
            expect(wrapped.argumentValues().count).toBe(1)
            let literal = wrapped.argumentValues().first
            expect(literal.expressionKind()).toBe("literal")
            expect(literal.semanticType.value()).toBe(SemanticTypes.stringType().value())
            expect(wrapped.range.startTokenIndex).toBe(literal.range.startTokenIndex)
            expect(wrapped.range.endTokenIndex).toBe(literal.range.endTokenIndex)
        }
        expect(call.argumentValues()[1].range.endTokenIndex <= call.argumentValues()[2].range.startTokenIndex).toBe(true)
    }

    async test `static declared String parameters reject native references and retain native overloads`() {
        let sources = textSources("Int")
        sources.add(textSource("app", "NativeArguments",
            "class NativeArguments { static text(String actual, String expected, String label) {} static run(String actual, native String value) { text(actual, value, \"label\"); } }"))
        var Bool rejected
        try { PrimitiveClassPartitionBinder().bindContexts(sources) }
        catch (Exception error) { rejected = error.message.contains("No overload of 'text'") }
        expect(rejected).toBe(true)

        let overloadSources = textSources("Int")
        overloadSources.add(textSource("app", "NativeOverloads",
            "class NativeOverloads { static select(String value) {} static select(native String value) {} static run(native String value) { select(value); select(\"literal\"); } }"))
        let owner = PrimitiveClassPartitionBinder().bindContexts(overloadSources).typeUnits().firstOrNull({ _.identity.name == "NativeOverloads" })
        let run = owner.functionUnits().firstOrNull({ _.name == "run" })
