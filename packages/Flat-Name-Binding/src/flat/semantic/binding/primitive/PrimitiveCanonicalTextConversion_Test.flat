    async test `production String constructor accepts declared character copy with native overlay present`() {
        let array = defaultSource("flat", "Array", "class Array<E> { public construct() {} public add(E value) {} }")
        let rawStorage = defaultSource("flat/datastruct/list", "StringCharArray",
            "class StringCharArray { visible Char[] values; public construct(Char[] values) { this.values = values; } public toCharArray() -> Char[] { return values; } }")
        let storage = PrimitiveSourceBindingContext("flat/datastruct/list", rawStorage.snapshot, rawStorage.classValues(),
            importValues: [PrimitiveBindingImport("flat/Array", rawStorage.classValues().first.range)])
        let base = defaultSource("flat", "String",
            "class String { public construct(Char[] chars) {} public construct(StringCharArray chars) {} }")
        let overlay = textSource("flat", "String",
            "class String { public construct(Char c) {} public construct(native_array native Char[] chars, Int count) {} public construct(native_array native Char[] chars) {} public construct(native String str) {} }", "character-copy-js")
        let merged = base.classValues().first.mergedWith(overlay.classValues().first)
        let imports = [PrimitiveBindingImport("flat/datastruct/list/StringCharArray", merged.range)]
        let sources = [array, storage,
            PrimitiveSourceBindingContext("flat", base.snapshot, [merged], importValues: imports),
            PrimitiveSourceBindingContext("flat", overlay.snapshot, PrimitiveClassSyntax[],
                importValues: [PrimitiveBindingImport("flat/datastruct/list/StringCharArray", overlay.classValues().first.range)])]
        let published = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits()
        let text = published.firstOrNull((unit) => unit.identity.name == "String")
        let chars = published.firstOrNull((unit) => unit.identity.name == "StringCharArray")
        let copy = chars.functionUnits().firstOrNull((method) => method.name == "toCharArray")
        expect(copy.returnType.kind()).toBe("generic-instance")
        expect(text.functionUnits().filter((method) => method.constructorFunction).count).toBe(6)
        let declaredSyntax = merged.constructorValues().firstOrNull((candidate) =>
            candidate.parameterValues().count == 1 && candidate.parameterValues().first.typeName == "Char[]" &&
            !candidate.parameterValues().first.nativeArrayStorage)
        let nativeSyntax = merged.constructorValues().firstOrNull((candidate) =>
            candidate.parameterValues().count == 1 && candidate.parameterValues().first.typeName == "Char[]" &&
            candidate.parameterValues().first.nativeArrayStorage)
        expect(declaredSyntax.parameterValues().first.nativeArrayStorage).toBe(false)
        expect(declaredSyntax.parameterValues().first.nativeScalarStorage).toBe(false)
        expect(nativeSyntax.parameterValues().first.nativeArrayStorage).toBe(true)
        expect(nativeSyntax.parameterValues().first.nativeScalarStorage).toBe(false)
        expect(declaredSyntax.range.snapshot.value).toBe(base.snapshot.value)
        expect(nativeSyntax.range.snapshot.value).toBe(overlay.snapshot.value)
        let declaredConstructor = text.functionUnits().firstOrNull((method) =>
            method.constructorFunction && method.parameterValues().count == 1 &&
            method.parameterValues().first.semanticType.kind() == "generic-instance")
        expect(declaredConstructor.identity.syntaxIdentity.snapshot.value).toBe(base.snapshot.value)
        expect(declaredConstructor.parameterValues().first.semanticType.value()).toBe(copy.returnType.value())
        let nativeConstructor = text.functionUnits().firstOrNull((method) =>
            method.constructorFunction && method.parameterValues().count == 1 &&
            method.parameterValues().first.semanticType.kind() == "array")
        expect(nativeConstructor.parameterValues().first.semanticType.value()).toBe(
            ArraySemanticType(SemanticTypes.charType()).value())
        expect(nativeConstructor.identity.syntaxIdentity.snapshot.value).toBe(overlay.snapshot.value)
        let workload = defaultSource("core/workloads", "ProductionCoreWorkload",
            "class ProductionCoreWorkload { public static stringsAndCharacters(StringCharArray chars) -> String { let copy = chars.toCharArray(); copy.add('c'); return String(copy); } }")
        sources.add(PrimitiveSourceBindingContext("core/workloads", workload.snapshot, workload.classValues(),
            importValues: [PrimitiveBindingImport("flat/datastruct/list/StringCharArray", workload.classValues().first.range),
                PrimitiveBindingImport("flat/Array", workload.classValues().first.range)]))
        let units = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits()
        let owner = units.firstOrNull((unit) => unit.identity.name == "ProductionCoreWorkload")
        let method = owner.functionUnits().firstOrNull((candidate) => candidate.name == "stringsAndCharacters")
        let invocation = textCall(textReturn(method.statements().last).value)
        expect(invocation.target.ownerType.value()).toBe(text.semanticType.value())
        expect(invocation.target.identity.declaration.value).toBe(declaredConstructor.identity.value)
        expect(invocation.target.identity.declaration.syntaxIdentity.snapshot.value).toBe(base.snapshot.value)
        expect(invocation.argumentValues().first.semanticType.value()).toBe(copy.returnType.value())
        expect(invocation.target.parameterTypes().first.value()).toBe(copy.returnType.value())
    }

