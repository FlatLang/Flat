    async test `Exception catchType compares declared metadata locations through explicit nullable String equality`() {
        let sources = [
            defaultSource("flat", "String", "class String { public construct(native String text) {} public equals(String? other) -> Bool { return true; } public equals(Object? other) -> Bool { return false; } }"),
            defaultSource("flat/meta", "Class", "class Class<Type> { visible String location; public construct(String location) { this.location = location; } }")
        ]
        let source = defaultSource("flat/exception", "Exception",
            "class Exception { public static catchType(func(), Class exceptionType, Bool soft = false, Bool exact = false) -> Exception => null { if (soft) { try { func(); } catch all (Exception e) { if (e.class.location == exceptionType.location) { return e; } } } else { try { func(); } catch (Exception e) { if (e.class.location == exceptionType.location) { return e; } else { throw e; } } } } public static matches(Exception e, Class exceptionType) -> Bool { return e.class.location == exceptionType.location; } public static differs(Exception e, Class exceptionType) -> Bool => e.class.location != exceptionType.location }")
        sources.add(PrimitiveSourceBindingContext("flat/exception", source.snapshot, source.classValues(),
            importValues: [PrimitiveBindingImport("flat/meta/Class", source.classValues().first.range)]))
        let units = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits()
        let owner = units.firstOrNull((unit) => unit.identity.name == "Exception")
        let text = units.firstOrNull((unit) => unit.identity.name == "String")
        let metadata = units.firstOrNull((unit) => unit.identity.name == "Class")
        let location = metadata.fieldUnits().firstOrNull((field) => field.name == "location")
        expect(location.semanticType.value()).toBe(text.semanticType.value())
        expect(owner.functionUnits().any((method) => method.name == "catchType")).toBe(true)
        let method = owner.functionUnits().firstOrNull((candidate) => candidate.name == "matches")
        let call = textCall(textReturn(method.statements().first).value)
        expect(call.target.name).toBe("equals")
        expect(call.target.ownerType.value()).toBe(text.semanticType.value())
        expect(call.target.parameterTypes().first.kind()).toBe("nullable")
        Object parameterSource = call.target.parameterTypes().first
        NullableSemanticType parameter = (NullableSemanticType)parameterSource
        expect(parameter.underlyingType.value()).toBe(text.semanticType.value())
        expect(call.receiver.expressionKind()).toBe("member-access")
        Object receiverSource = call.receiver
        BoundMemberAccessExpression receiver = (BoundMemberAccessExpression)receiverSource
        expect(receiver.memberIdentity.value).toBe(location.identity.value)
        expect(receiver.receiver.semanticType.value()).toBe(metadata.semanticType.value())
        expect(call.argumentValues().first.semanticType.value()).toBe(text.semanticType.value())
        expect(call.range.snapshot.value).toBe(source.snapshot.value)
        let differs = owner.functionUnits().firstOrNull((candidate) => candidate.name == "differs")
        expect(textReturn(differs.statements().first).value.expressionKind()).toBe("unary")
    }

