    async test `constructed receiver inferred Bool reaches require from exact published owner`() {
        let range = defaultSource("flat/datastruct/list", "IntRange",
            "class IntRange { public construct(public Int start, public Int end) {} public contains(Int value) => value >= start && value < end }")
        let raw = defaultSource("core/workloads", "ProductionCoreWorkload",
            "class ProductionCoreWorkload { public static require(Bool condition) {} public static collectionsAndNumbers() { require(IntRange(2, 5).contains(2)); require(!IntRange(2, 5).contains(5)); } }")
        let workload = PrimitiveSourceBindingContext("core/workloads", raw.snapshot, raw.classValues(),
            importValues: [PrimitiveBindingImport("flat/datastruct/list/IntRange", raw.classValues().first.range)])
        let units = PrimitiveClassPartitionBinder().bindContexts([workload, range]).typeUnits()
        let producer = units.firstOrNull((unit) => unit.identity.name == "IntRange")
        let method = producer.functionUnits().firstOrNull((candidate) => candidate.name == "contains")
        expect(method.returnType.value()).toBe(SemanticTypes.boolType().value())
        let consumer = units.firstOrNull((unit) => unit.identity.name == "ProductionCoreWorkload")
        let body = consumer.functionUnits().firstOrNull((candidate) => candidate.name == "collectionsAndNumbers").statements()
        Object statementSource = body.first
        BoundExpressionStatement statement = (BoundExpressionStatement)statementSource
        let requireCall = textCall(statement.expression)
        let predicate = textCall(requireCall.argumentValues().first)
        expect(predicate.semanticType.value()).toBe(SemanticTypes.boolType().value())
        expect(predicate.target.identity.declaration.value).toBe(method.identity.value)
        expect(predicate.target.ownerType.value()).toBe(producer.semanticType.value())
        expect(predicate.target.identity.declaration.syntaxIdentity.snapshot.value).toBe(range.snapshot.value)
        expect(predicate.receiver.expressionKind()).toBe("call")
        expect(predicate.argumentValues().first.semanticType.value()).toBe(SemanticTypes.intType().value())
    }

    async test `constructed inferred non Bool and invalid predicate arguments cannot satisfy require`() {
        String[] predicates = [
            "public contains(Int value) => value",
            "public contains(Int value) => value > 0"
        ]
        var Int index
        for (predicate in predicates) {
            let producer = defaultSource("flat/datastruct/list", "IntRange", "class IntRange { public construct(Int start, Int end) {} " + predicate + " }")
            let argument = index == 0 ? "2" : "true"
            let raw = defaultSource("core/workloads", "InvalidPredicate", "class InvalidPredicate { public static require(Bool value) {} public static run() { require(IntRange(2, 5).contains(" + argument + ")); } }")
            let consumer = PrimitiveSourceBindingContext("core/workloads", raw.snapshot, raw.classValues(),
                importValues: [PrimitiveBindingImport("flat/datastruct/list/IntRange", raw.classValues().first.range)])
            var Bool rejected
            try { PrimitiveClassPartitionBinder().bindContexts([consumer, producer]) }
            catch (Exception error) {
                if (!error.message.contains("No overload of 'require'") && !error.message.contains("No overload of 'contains'")) {
                    throw Exception("Expected checked predicate rejection: #{error.message}")
                }
                rejected = true
            }
            expect(rejected).toBe(true)
            index++
        }
    }

    async test `inferred local literal constructs visible Array with canonical text and exact removal overload`() {
        let sources = inferredArraySources()
        sources.add(defaultSource("flat", "CollectionWorkload",
            "class CollectionWorkload { public static next() -> String { return \"last\"; } public static run() { let values = [\"first\", \"middle\", next()]; let removed = values.removeAtIndex(1); let several = values.removeAtIndex(0, 2); } }"))
        let units = PrimitiveClassPartitionBinder().bindContexts(sources).typeUnits()
        let owner = units.firstOrNull((unit) => unit.identity.name == "CollectionWorkload")
        let array = units.firstOrNull((unit) => unit.identity.name == "Array")
        let text = units.firstOrNull((unit) => unit.identity.name == "String")
        let method = owner.functionUnits().firstOrNull((candidate) => candidate.name == "run")
        let local = textLocal(method.statements().first)
        expect(local.local.semanticType.kind()).toBe("generic-instance")
        let construction = textCall(local.initializer)
        expect(construction.target.ownerType.value()).toBe(array.semanticType.value())
        Object constructedTypeSource = construction.semanticType
        GenericInstanceSemanticType constructedType = (GenericInstanceSemanticType)constructedTypeSource
        expect(constructedType.typeArguments().first.value()).toBe(text.semanticType.value())
        Object storageSource = construction.argumentValues().first
        BoundArrayExpression storage = (BoundArrayExpression)storageSource
        let elements = storage.elementValues()
        expect(elements.count).toBe(3)
        expect(textCall(elements.first).target.ownerType.value()).toBe(text.semanticType.value())
        expect(textCall(elements[1]).target.ownerType.value()).toBe(text.semanticType.value())
        expect(textCall(elements.last).target.name).toBe("next")
        // One ordered occurrence of next(), no conversion call or element replay.
        let removed = textCall(textLocal(method.statements()[1]).initializer)
        expect(removed.target.name).toBe("removeAtIndex")
        expect(removed.target.ownerType.value()).toBe(array.semanticType.value())
        expect(removed.target.parameterTypes().count).toBe(1)
        expect(removed.target.optionalParameterCount).toBe(0)
        expect(removed.semanticType.value()).toBe(text.semanticType.value())
        expect(removed.receiver.semanticType.value()).toBe(local.local.semanticType.value())
        let selected = array.functionUnits().firstOrNull((candidate) =>
            candidate.name == "removeAtIndex" && candidate.parameterValues().count == 1)
        expect(removed.target.identity.declaration.value).toBe(selected.identity.value)
        let several = textCall(textLocal(method.statements().last).initializer)
        expect(several.target.parameterTypes().count).toBe(2)
        expect(several.target.optionalParameterCount).toBe(1)
        expect(several.semanticType.value()).toBe(local.local.semanticType.value())
    }

