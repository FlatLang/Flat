package flat/semantic/binding/primitive

import flat/compiler/models
import flat/parser/flat
import flat/semantic/types
import flat/bound
import flat/lexer/Lexer

testable class {
    // Erase legacy generic-array projections before narrowing their bound node.
    arrayNode(Object value) -> BoundArrayExpression => (BoundArrayExpression)value
    arrayCall(Object value) -> BoundCallExpression => (BoundCallExpression)value
    arrayLiteral(Object value) -> BoundLiteralExpression => (BoundLiteralExpression)value
    arrayConversion(Object value) -> BoundConversionExpression => (BoundConversionExpression)value
    arrayFunction(Object value) -> FunctionSemanticType => (FunctionSemanticType)value
    arrayLambda(Object value) -> BoundLambdaExpression => (BoundLambdaExpression)value
    arrayRange(String name, Int start = 0) -> SourceRange => SourceRange(
        SourceSnapshotIdentity(SourceIdentity("memory:#name"), "one"), start, start + 1,
        Location(lineNumber: 1, column: start + 1), Location(lineNumber: 1, column: start + 2))

    callbackBoxingContext(SourceRange range, String name) -> PrimitiveResolvedDeclarationContext {
        let syntax = PrimitiveClassSyntax(range, name, null, null, PrimitiveFieldSyntax[],
            PrimitiveConstructorSyntax(range, PrimitiveFunctionParameterSyntax[], PrimitiveStatementSyntax[]),
            PrimitiveFunctionSyntax[])
        let source = PrimitiveSourceBindingContext(name == "Bool" ? "flat/primitive" : "flat/primitive/number",
            range.snapshot, [syntax])
        return PrimitiveResolvedDeclarationContext(source, [source])
    }

    callbackBoxingTarget(PrimitiveResolvedDeclarationContext context, SemanticType type) -> CallableSignature {
        let name = type.value().substring("primitive:".count)
        let owner = UserClassSemanticType(context.candidates(name == "Bool" ? "flat/primitive/Bool" :
            "flat/primitive/number/#name").first)
        return CallableSignature(SymbolIdentity(owner.declarationIdentity, "constructor"), name,
            CallableKind("constructor"), [type], owner, owner)
    }

    arrayTextContext(SourceRange range) -> PrimitiveResolvedDeclarationContext {
        let syntax = PrimitiveClassSyntax(range, "String", null, null, PrimitiveFieldSyntax[],
            PrimitiveConstructorSyntax(range, PrimitiveFunctionParameterSyntax[], PrimitiveStatementSyntax[]),
            PrimitiveFunctionSyntax[])
        let source = PrimitiveSourceBindingContext("flat", range.snapshot, [syntax])
        return PrimitiveResolvedDeclarationContext(source, [source])
    }

    arrayStorageConstructor(SourceRange range) -> CallableSignature {
        let owner = DeclarationIdentity(SyntaxIslandIdentity(range.snapshot, "class", 100), "class", "Array")
        let type = UserClassSemanticType(owner)
        let parameter = GenericParameterSemanticType(owner, "Type", 0)
        let declaration = GenericDeclaration(owner, [parameter], type)
        return CallableSignature(SymbolIdentity(owner, "constructor", 0), "Array", CallableKind("constructor"),
            [ArraySemanticType(parameter), SemanticTypes.intType()], type, type,
            ownerGenericDeclaration: declaration)
    }

    arrayTextConstructor(UserClassSemanticType type) -> CallableSignature => CallableSignature(
        SymbolIdentity(type.declarationIdentity, "constructor", 0), "String", CallableKind("constructor"),
        [SemanticTypes.stringType()], type, type)

    test `declared text array storage selection`() {
        let range = arrayRange("declared-string-array")
        let context = arrayTextContext(range)
        let text = UserClassSemanticType(context.candidates("flat/String").first)
        let arrayConstructor = arrayStorageConstructor(range)
        let textConstructor = arrayTextConstructor(text)
        let required = GenericInstanceSemanticType(arrayConstructor.ownerType, [text])
        let result = PrimitiveExpressionBinder().bind(PrimitiveArraySyntax(range, [
            PrimitiveLiteralSyntax(range, Token.Type.STRING, "\"B\""),
            PrimitiveLiteralSyntax(range, Token.Type.STRING, "\"KB\""),
            PrimitiveLiteralSyntax(range, Token.Type.STRING, "\"MB\"")]), required,
            callables: [arrayConstructor, textConstructor], declarationContext: context)
        expect(result.succeeded).toBe(true)
        let call = (BoundCallExpression)result.expression
        expect(call.target.identity.value).toBe(arrayConstructor.identity.value)
        expect(call.semanticType.value()).toBe(required.value())
        let storage = arrayNode(call.argumentValues().first)
        expect(storage.semanticType.value()).toBe(ArraySemanticType(text).value())
        expect(storage.elementValues().count).toBe(3)
        var Int index
        for (element in storage.elementValues()) {
            let wrapped = (BoundCallExpression)element
            expect(wrapped.target.identity.value).toBe(textConstructor.identity.value)
            expect(wrapped.argumentValues().count).toBe(1)
            expect(wrapped.argumentValues().first.semanticType.value()).toBe(SemanticTypes.stringType().value())
            index++
        }
        expect((arrayLiteral(call.argumentValues()[1])).sourceValue).toBe("3")
        let firstText = arrayCall(storage.elementValues()[0])
        let lastText = arrayCall(storage.elementValues()[2])
        expect((arrayLiteral(firstText.argumentValues().first)).sourceValue).toBe("\"B\"")
        expect((arrayLiteral(lastText.argumentValues().first)).sourceValue).toBe("\"MB\"")
    }

    test `mixed text array order`() {
        let range = arrayRange("mixed-string-array")
        let context = arrayTextContext(range)
        let text = UserClassSemanticType(context.candidates("flat/String").first)
        let arrayConstructor = arrayStorageConstructor(range)
        let owner = text.declarationIdentity
        let native = CallableSignature(SymbolIdentity(owner, "function", 1), "nativeText",
            CallableKind("function"), SemanticType[], SemanticTypes.stringType())
        let declared = CallableSignature(SymbolIdentity(owner, "function", 2), "declaredText",
            CallableKind("function"), SemanticType[], text)
        let required = GenericInstanceSemanticType(arrayConstructor.ownerType, [text])
        let result = PrimitiveExpressionBinder().bind(PrimitiveArraySyntax(range, [
            PrimitiveCallSyntax(range, "nativeText", PrimitiveExpressionSyntax[]),
            PrimitiveCallSyntax(range, "declaredText", PrimitiveExpressionSyntax[])]), required,
            callables: [declared, arrayTextConstructor(text), native, arrayConstructor], declarationContext: context)
        expect(result.succeeded).toBe(true)
        let storage = arrayNode(arrayCall(result.expression).argumentValues().first)
        let first = arrayCall(storage.elementValues()[0])
        expect((arrayCall(first.argumentValues().first)).target.identity.value).toBe(native.identity.value)
        expect((arrayCall(storage.elementValues()[1])).target.identity.value).toBe(declared.identity.value)
        expect(storage.elementValues().count).toBe(2)
    }

    test `empty array contextual storage`() {
        let range = arrayRange("empty-array-context")
        let syntax = PrimitiveArraySyntax(range, PrimitiveExpressionSyntax[])
        let binder = PrimitiveExpressionBinder()
        let untyped = binder.bind(syntax)
        expect(untyped.succeeded).toBe(false)
        expect(untyped.diagnostic.code).toBe("type.array-element-context")
        let native = binder.bind(syntax, ArraySemanticType(SemanticTypes.stringType()))
        expect(native.succeeded).toBe(true)
        expect((arrayNode(native.expression)).elementValues().count).toBe(0)
        let constructor = arrayStorageConstructor(range)
        let required = GenericInstanceSemanticType(constructor.ownerType, [SemanticTypes.stringType()])
        let declared = binder.bind(syntax, required, callables: [constructor])
        expect(declared.succeeded).toBe(true)
        let call = (BoundCallExpression)declared.expression
        expect(call.semanticType.value()).toBe(required.value())
        expect((arrayNode(call.argumentValues().first)).elementValues().count).toBe(0)
        expect((arrayLiteral(call.argumentValues()[1])).sourceValue).toBe("0")
    }

    test `text storage and numeric widening`() {
        let range = arrayRange("native-array-representation")
        let text = PrimitiveArraySyntax(range, [PrimitiveLiteralSyntax(range, Token.Type.STRING, "\"native\"")])
        let inferred = PrimitiveExpressionBinder().bind(text)
        let expected = PrimitiveExpressionBinder().bind(text, ArraySemanticType(SemanticTypes.stringType()))
        expect(inferred.succeeded).toBe(true)
        expect(expected.succeeded).toBe(true)
        expect(inferred.expression.semanticType.value()).toBe(ArraySemanticType(SemanticTypes.stringType()).value())
        expect((arrayNode(expected.expression)).elementValues().first.expressionKind()).toBe("literal")
        let widened = PrimitiveExpressionBinder().bind(PrimitiveArraySyntax(range, [
            PrimitiveLiteralSyntax(range, Token.Type.INTEGER, "1")]), ArraySemanticType(SemanticTypes.longType()))
        expect(widened.succeeded).toBe(true)
        let element = arrayConversion(arrayNode(widened.expression).elementValues().first)
        expect(element.semanticType.value()).toBe(SemanticTypes.longType().value())
        expect(element.value.semanticType.value()).toBe(SemanticTypes.intType().value())
    }

    test `nested array adaptation`() {
        let range = arrayRange("nested-array-context")
        let context = arrayTextContext(range)
        let text = UserClassSemanticType(context.candidates("flat/String").first)
        let constructor = arrayStorageConstructor(range)
        let inner = GenericInstanceSemanticType(constructor.ownerType, [text])
        let outer = GenericInstanceSemanticType(constructor.ownerType, [inner])
        let result = PrimitiveExpressionBinder().bind(PrimitiveArraySyntax(range, [
            PrimitiveArraySyntax(range, [PrimitiveLiteralSyntax(range, Token.Type.STRING, "\"inner\"")]),
            PrimitiveArraySyntax(range, PrimitiveExpressionSyntax[])]), outer,
            callables: [constructor, arrayTextConstructor(text)], declarationContext: context)
        expect(result.succeeded).toBe(true)
        let storage = arrayNode(arrayCall(result.expression).argumentValues().first)
        expect(storage.semanticType.value()).toBe(ArraySemanticType(inner).value())
        let first = arrayCall(storage.elementValues()[0])
        let innerStorage = arrayNode(first.argumentValues().first)
        expect(innerStorage.elementValues().first.semanticType.value()).toBe(text.value())
        let second = arrayCall(storage.elementValues()[1])
        expect((arrayNode(second.argumentValues().first)).elementValues().count).toBe(0)
    }

    test `invalid array element ranges`() {
        let range = arrayRange("invalid-array-element")
        let badRange = SourceRange(range.snapshot, 7, 8,
            Location(lineNumber: 1, column: 8), Location(lineNumber: 1, column: 9))
        let invalid = PrimitiveExpressionBinder().bind(PrimitiveArraySyntax(range, [
            PrimitiveLiteralSyntax(range, Token.Type.INTEGER, "1"),
            PrimitiveLiteralSyntax(badRange, Token.Type.BOOL, "true")]), ArraySemanticType(SemanticTypes.intType()))
        expect(invalid.succeeded).toBe(false)
        expect(invalid.diagnostic.code).toBe("type.array-element-conversion")
        expect(invalid.diagnostic.range.startTokenIndex).toBe(7)
        let context = arrayTextContext(range)
        let text = UserClassSemanticType(context.candidates("flat/String").first)
        let constructor = arrayStorageConstructor(range)
        let nullable = LocalBinding("maybe", SymbolIdentity(text.declarationIdentity, "local", 0), NullableSemanticType(text))
        let rejected = PrimitiveExpressionBinder().bind(PrimitiveArraySyntax(range, [
            PrimitiveReferenceSyntax(badRange, "maybe")]), GenericInstanceSemanticType(constructor.ownerType, [text]),
            locals: [nullable], callables: [constructor, arrayTextConstructor(text)], declarationContext: context)
        expect(rejected.succeeded).toBe(false)
        expect(rejected.diagnostic.code).toBe("type.array-element-conversion")
        expect(rejected.diagnostic.range.startTokenIndex).toBe(7)
    }

    test `missing text adaptation contracts`() {
        let range = arrayRange("array-missing-text-contract")
        let context = arrayTextContext(range)
        let text = UserClassSemanticType(context.candidates("flat/String").first)
        let constructor = arrayStorageConstructor(range)
        let required = GenericInstanceSemanticType(constructor.ownerType, [text])
        let syntax = PrimitiveArraySyntax(range, [PrimitiveLiteralSyntax(range, Token.Type.STRING, "\"value\"")])
        let missingContext = PrimitiveExpressionBinder().bind(syntax, required,
            callables: [constructor, arrayTextConstructor(text)])
        expect(missingContext.succeeded).toBe(false)
        expect(missingContext.diagnostic.code).toBe("type.array-element-conversion")
        let missingConstructor = PrimitiveExpressionBinder().bind(syntax, required,
            callables: [constructor], declarationContext: context)
        expect(missingConstructor.succeeded).toBe(false)
        expect(missingConstructor.diagnostic.code).toBe("type.array-element-conversion")
        let duplicate = arrayTextConstructor(text)
        let ambiguous = PrimitiveExpressionBinder().bind(syntax, required,
            callables: [constructor, duplicate, duplicate], declarationContext: context)
        expect(ambiguous.succeeded).toBe(false)
        expect(ambiguous.diagnostic.code).toBe("type.array-element-conversion")
    }

    test `noncanonical text adaptation rejection`() {
        let range = arrayRange("array-spoofed-string")
        let context = arrayTextContext(range)
        let shadow = UserClassSemanticType(DeclarationIdentity(
            SyntaxIslandIdentity(range.snapshot, "class", 20), "class", "String"))
        let constructor = arrayStorageConstructor(range)
        let required = GenericInstanceSemanticType(constructor.ownerType, [shadow])
        let result = PrimitiveExpressionBinder().bind(PrimitiveArraySyntax(range, [
            PrimitiveLiteralSyntax(range, Token.Type.STRING, "\"not-shadow\"")]), required,
            callables: [constructor, arrayTextConstructor(shadow)], declarationContext: context)
        expect(result.succeeded).toBe(false)
        expect(result.diagnostic.code).toBe("type.array-element-conversion")
    }

    test `text context invocation lifetime`() {
        let range = arrayRange("array-context-lifetime")
        let context = arrayTextContext(range)
        let text = UserClassSemanticType(context.candidates("flat/String").first)
        let constructor = arrayStorageConstructor(range)
        let required = GenericInstanceSemanticType(constructor.ownerType, [text])
        let syntax = PrimitiveArraySyntax(range, [PrimitiveLiteralSyntax(range, Token.Type.STRING, "\"value\"")])
        let binder = PrimitiveExpressionBinder()
        let first = binder.bind(syntax, required, callables: [constructor, arrayTextConstructor(text)],
            declarationContext: context)
        expect(first.succeeded).toBe(true)
        let second = binder.bind(syntax, required, callables: [constructor, arrayTextConstructor(text)])
        expect(second.succeeded).toBe(false)
        expect(second.diagnostic.code).toBe("type.array-element-conversion")
    }

    test `array branch and callback context`() {
        let range = arrayRange("array-branch-callback")
        let context = arrayTextContext(range)
        let text = UserClassSemanticType(context.candidates("flat/String").first)
        let constructor = arrayStorageConstructor(range)
        let required = GenericInstanceSemanticType(constructor.ownerType, [text])
        let branch = PrimitiveConditionalSyntax(range, PrimitiveLiteralSyntax(range, Token.Type.BOOL, "true"),
            PrimitiveArraySyntax(range, PrimitiveExpressionSyntax[]),
            PrimitiveArraySyntax(range, [PrimitiveLiteralSyntax(range, Token.Type.STRING, "\"right\"")]))
        let result = PrimitiveExpressionBinder().bind(branch, required,
            callables: [constructor, arrayTextConstructor(text)], declarationContext: context)
        expect(result.succeeded).toBe(true)
        expect(result.expression.semanticType.value()).toBe(required.value())
        let callback = PrimitiveExpressionBinder().bindCallback(
            PrimitiveLambdaSyntax(range, PrimitiveFunctionParameterSyntax[], branch),
            FunctionSemanticType(SemanticType[], required), LocalBinding[],
            [constructor, arrayTextConstructor(text)], declarationContext: context)
        expect(callback.succeeded).toBe(true)
        expect((arrayLambda(callback.expression)).body.semanticType.value()).toBe(required.value())
    }

    test `nested storage element adaptation`() {
        let range = arrayRange("nested-native-array")
        let inner = ArraySemanticType(SemanticTypes.longType())
        let result = PrimitiveExpressionBinder().bind(PrimitiveArraySyntax(range, [
            PrimitiveArraySyntax(range, [PrimitiveLiteralSyntax(range, Token.Type.INTEGER, "7")]),
            PrimitiveArraySyntax(range, PrimitiveExpressionSyntax[])]), ArraySemanticType(inner))
        expect(result.succeeded).toBe(true)
        let storage = arrayNode(result.expression)
        expect(storage.semanticType.value()).toBe(ArraySemanticType(inner).value())
        let first = arrayNode(storage.elementValues().first)
        expect(first.elementValues().first.semanticType.value()).toBe(SemanticTypes.longType().value())
        expect((arrayNode(storage.elementValues()[1])).elementValues().count).toBe(0)
    }

    test `array storage contract rejection`() {
        let range = arrayRange("array-storage-contract")
        let constructor = arrayStorageConstructor(range)
        let required = GenericInstanceSemanticType(constructor.ownerType, [SemanticTypes.stringType()])
        let syntax = PrimitiveArraySyntax(range, [PrimitiveLiteralSyntax(range, Token.Type.STRING, "\"value\"")])
        let missing = PrimitiveExpressionBinder().bind(syntax, required)
        expect(missing.succeeded).toBe(false)
        let wrong = CallableSignature(constructor.identity, "Array", CallableKind("constructor"),
            [ArraySemanticType(SemanticTypes.intType()), SemanticTypes.intType()], constructor.ownerType,
            constructor.ownerType, ownerGenericDeclaration: constructor.ownerGenericDeclaration)
        let invalid = PrimitiveExpressionBinder().bind(syntax, required, callables: [wrong])
        expect(invalid.succeeded).toBe(false)
    }

    test `function reference evidence retention`() {
        let range = arrayRange("async-function-reference")
        let identity = DeclarationIdentity(SyntaxIslandIdentity(range.snapshot, "function", 1), "function", "read")
        let target = CallableSignature(SymbolIdentity(identity, "function"), "read", CallableKind("function"),
            SemanticType[], SemanticTypes.intType(), asyncFunction: true, externalName: "readExternal")
        let result = PrimitiveExpressionBinder().bind(PrimitiveFunctionReferenceSyntax(range, "read"), callables: [target])
        expect(result.succeeded).toBe(true)
        let function = arrayFunction(result.expression.semanticType)
        expect(function.asyncFunction).toBe(true)
        let synchronous = PrimitiveExpressionBinder().bind(PrimitiveFunctionReferenceSyntax(range, "read"),
            FunctionSemanticType(SemanticType[], SemanticTypes.intType()), callables: [target])
        expect(synchronous.succeeded).toBe(false)
    }

    test `constructed call evidence retention`() {
        let range = arrayRange("external-constructor-copy")
        let owner = UserClassSemanticType(DeclarationIdentity(
            SyntaxIslandIdentity(range.snapshot, "class", 1), "class", "Example"))
        let target = CallableSignature(SymbolIdentity(owner.declarationIdentity, "constructor"), "Example",
            CallableKind("constructor"), SemanticType[], owner, owner, externalName: "ExternalExample")
        let result = PrimitiveExpressionBinder().bind(
            PrimitiveConstructionSyntax(range, "Example", PrimitiveExpressionSyntax[]), callables: [target])
        expect(result.succeeded).toBe(true)
        let call = (BoundCallExpression)result.expression
        expect(call.target.externalName).toBe("ExternalExample")
        expect(call.target.identity.value).toBe(target.identity.value)
    }

    async test `control expression fallback rejects intrinsic numeric unboxing`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:control-unbox-fallback"), "one")
        let stream = Lexer().lex("let converted = (Double)other;")
        stream.emit("start")
        let syntax = PrimitiveControlStatementParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let owner = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "function", 0), "function", "read")
        let local = LocalBinding("other", SymbolIdentity(owner, "local", 0), SemanticTypes.objectType())
        var PrimitiveContextBindingException failure
        try { PrimitiveControlStatementBinder().bind(syntax, snapshot, [local]) }
        catch (PrimitiveContextBindingException error) { failure = error }
        if (!failure) throw Exception("Control fallback emitted unchecked numeric unboxing")
        expect(failure.diagnostic.code).toBe("binding.numeric-unboxing-projection-unsupported")
        expect(failure.diagnostic.range.snapshot).toBe(snapshot)
        expect(failure.diagnostic.range.startTokenIndex).toBe(3)
        expect(failure.diagnostic.range.endTokenIndex).toBe(7)
    }
    test `numeric unboxing without projection evidence fails closed through direct and callback binding`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:unbox-fallback"), "one")
        let range = SourceRange(snapshot, 7, 9, Location(lineNumber: 1, column: 8), Location(lineNumber: 1, column: 10))
        let owner = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "function", 0), "function", "read")
        let local = LocalBinding("other", SymbolIdentity(owner, "local", 0), SemanticTypes.objectType())
        let reference = PrimitiveReferenceSyntax(range, "other")
        let cast = PrimitiveCastSyntax(range, "Double", reference)
        let binder = PrimitiveExpressionBinder()
        let direct = binder.bind(cast, locals: [local])
        let required = binder.bind(reference, requiredType: SemanticTypes.doubleType(),
            locals: [local], explicitConversion: true)
        let lambda = PrimitiveLambdaSyntax(range, PrimitiveFunctionParameterSyntax[], cast)
        let callback = binder.bindCallback(lambda, FunctionSemanticType(SemanticType[], SemanticTypes.doubleType()),
            [local], CallableSignature[])
        let results = [direct, required, callback]
        for (result in results) {
            expect(result.succeeded).toBe(false)
            expect(result.expression == null).toBe(true)
            expect(result.diagnostic.code).toBe("binding.numeric-unboxing-projection-unsupported")
            expect(result.diagnostic.range).toBe(range)
        }
    }
    test `primitive dispatch preserves signature and rejection`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:primitive-dispatch"), "one")
        let range = SourceRange(snapshot, 7, 8, Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 2))
        let owner = UserClassSemanticType(DeclarationIdentity(SyntaxIslandIdentity(snapshot, "class", 0), "class", "Int"))
        let identity = SymbolIdentity(DeclarationIdentity(SyntaxIslandIdentity(snapshot, "static-method", 1), "static-method", "encode"), "static-method")
        let signature = CallableSignature(identity, "encode", CallableKind("static-method"),
            [SemanticTypes.intType(), SemanticTypes.boolType()], SemanticTypes.stringType(), owner)
        let receiver = PrimitiveLiteralSyntax(range, Token.Type.INTEGER, "1")
        let syntax = PrimitiveMemberCallSyntax(range, receiver, "encode", [PrimitiveLiteralSyntax(range, Token.Type.BOOL, "false")])
        let result = PrimitiveExpressionBinder().bind(syntax, callables: [signature])
        expect(result.succeeded).toBe(true)
        let call = (BoundCallExpression)result.expression
        expect(call.target.identity.value).toBe(identity.value)
        expect(call.receiver).toBe(null)
        expect(call.argumentValues().first.semanticType.value()).toBe(SemanticTypes.intType().value())
        let invalidSyntax = PrimitiveMemberCallSyntax(range, receiver, "encode", [receiver])
        let rejected = PrimitiveExpressionBinder().bind(invalidSyntax, callables: [signature])
        expect(rejected.succeeded).toBe(false)
        expect(rejected.diagnostic.range).toBe(range)
        let missing = PrimitiveExpressionBinder().bind(syntax)
        expect(missing.succeeded).toBe(false)
        expect(missing.diagnostic.range).toBe(range)
    }

    test `generic callback boxing rejects missing ambiguous and shadow evidence`() {
        let range = arrayRange("generic-boxing-rejection")
        let owner = DeclarationIdentity(SyntaxIslandIdentity(range.snapshot, "function", 100), "function", "from")
        let declaration = FunctionSemanticType(SemanticType[], GenericParameterSemanticType(owner, "T", 0))
        let context = callbackBoxingContext(range, "Int")
        let target = callbackBoxingTarget(context, SemanticTypes.intType())
        let syntax = PrimitiveLambdaSyntax(range, PrimitiveFunctionParameterSyntax[],
            PrimitiveLiteralSyntax(range, Token.Type.INTEGER, "0"))
        for (mode in 0..4) {
            var CallableSignature[] targets = CallableSignature[]
            if (mode != 0) targets = [target]
            if (mode == 2) targets.add(target)
            let source = context.owner
            let shadow = PrimitiveSourceBindingContext("shadow", source.snapshot, source.classValues())
            let scope = mode == 3 ? PrimitiveResolvedDeclarationContext(shadow, [shadow]) : context
            let bound = PrimitiveExpressionBinder().bindCallback(syntax,
                FunctionSemanticType(SemanticType[], SemanticTypes.intType()), LocalBinding[], targets,
                originalContract: declaration, declarationContext: mode == 1 ? null : scope)
            expect(bound.succeeded).toBe(false)
            expect(bound.diagnostic.message.contains("boxing")).toBe(true)
        }
    }

    test `generic zero argument function reference publishes typed invocation adapter`() {
        let range = arrayRange("generic-function-reference")
        let owner = DeclarationIdentity(SyntaxIslandIdentity(range.snapshot, "function", 100), "function", "read")
        let type = FunctionSemanticType(SemanticType[], SemanticTypes.intType(), true)
        let target = CallableSignature(SymbolIdentity(owner, "function"), "read", CallableKind("function"),
            SemanticType[], SemanticTypes.intType(), asyncFunction: true)
        let selected = BoundFunctionValue(range, type, target)
        let declaration = FunctionSemanticType(SemanticType[], GenericParameterSemanticType(owner, "T", 0), true)
        let context = callbackBoxingContext(range, "Int")
        let boxing = callbackBoxingTarget(context, SemanticTypes.intType())
        let adapted = PrimitiveExpressionBinder.adaptCallbackReference(selected, declaration, context, [boxing])
        let lambda = arrayLambda(adapted)
        expect(lambda.declarationContract.value()).toBe(declaration.value())
        expect(lambda.resultBoxingConstructor.identity.value).toBe(boxing.identity.value)
        expect(lambda.statementValues().isEmpty).toBe(true)
        expect(lambda.body.expressionKind()).toBe("function-invocation")
        Object evidenceSource1 = lambda.body
        BoundFunctionInvocationExpression invocation = (BoundFunctionInvocationExpression)evidenceSource1
        Object selectedEvidence2Source = invocation.functionValue
        BoundFunctionValue selectedEvidence2 = (BoundFunctionValue)selectedEvidence2Source
        expect(selectedEvidence2.target.identity.value).toBe(target.identity.value)
        expect(invocation.argumentValues().isEmpty).toBe(true)
        expect(invocation.semanticType.value()).toBe("primitive:Int")
        let withParameter = FunctionSemanticType([SemanticTypes.intType()], SemanticTypes.intType(), true)
        let parameterTarget = CallableSignature(SymbolIdentity(owner, "function", 1), "read", CallableKind("function"),
            [SemanticTypes.intType()], SemanticTypes.intType(), asyncFunction: true)
        let concreteDeclaration = FunctionSemanticType([SemanticTypes.intType()], declaration.returnType, true)
        let parameterAdapter = arrayLambda(PrimitiveExpressionBinder.adaptCallbackReference(
            BoundFunctionValue(range, withParameter, parameterTarget), concreteDeclaration, context, [boxing]))
        expect(parameterAdapter.parameterValues().count).toBe(1)
        Object evidenceSource3 = parameterAdapter.body
        BoundFunctionInvocationExpression parameterInvocation = (BoundFunctionInvocationExpression)evidenceSource3
        expect(parameterInvocation.argumentValues().count).toBe(1)
        let parameterArguments = parameterInvocation.argumentValues()
        Object parameterReferenceSource = parameterArguments.first
        BoundReferenceExpression parameterReference = (BoundReferenceExpression)parameterReferenceSource
        expect(parameterReference.symbolIdentity.value).toBe(parameterAdapter.parameterValues().first.identity.value)
        var String failure
        try {
            PrimitiveExpressionBinder.adaptCallbackReference(BoundFunctionValue(range, withParameter, parameterTarget),
                FunctionSemanticType([declaration.returnType], declaration.returnType, true), context, [boxing])
        } catch (Exception error) { failure = error.message }
        if (!failure) throw Exception("Generic reference input representation was guessed")
        expect(failure.contains("parameter representation evidence")).toBe(true)
    }

    async test `generic callback return retains declaration ABI and concrete typed returns`() {
        let range = arrayRange("generic-callback-return")
        let owner = DeclarationIdentity(SyntaxIslandIdentity(range.snapshot, "function", 100), "function", "from")
        let generic = GenericParameterSemanticType(owner, "T", 0)
        let declaration = FunctionSemanticType(SemanticType[], generic, true)
        let values = ["0", "-42", "true", "false"]
        let bodyForms = [false, true]
        for (index in 0..values.count) {
            for (block in bodyForms) {
                let type = index < 2 ? SemanticTypes.intType() : SemanticTypes.boolType()
                let boxingContext = callbackBoxingContext(range, index < 2 ? "Int" : "Bool")
                let boxingTarget = callbackBoxingTarget(boxingContext, type)
                let text = block ? "{ return #{values[index]}; }" : "{ #{values[index]} }"
                let stream = Lexer().lex(text)
                stream.emit("start")
                Object evidenceSource4 = PrimitiveExpressionParser().parse(stream.consumeAll<Token>("data"), range.snapshot)
                PrimitiveLambdaSyntax syntax = (PrimitiveLambdaSyntax)evidenceSource4
                let result = PrimitiveExpressionBinder().bindCallback(syntax,
                    FunctionSemanticType(SemanticType[], type, true), LocalBinding[], [boxingTarget],
                    originalContract: declaration, declarationContext: boxingContext)
                expect(result.succeeded).toBe(true)
                let lambda = arrayLambda(result.expression)
                expect(lambda.declarationContract.value()).toBe(declaration.value())
                expect(lambda.resultBoxingConstructor.identity.value).toBe(boxingTarget.identity.value)
                expect(lambda.resultBoxingConstructor.parameterTypes().first.value()).toBe(type.value())
                expect(arrayFunction(lambda.semanticType).returnType.value()).toBe(type.value())
                expect(lambda.body.semanticType.value()).toBe(type.value())
                if (block) {
                    Object evidenceSource5 = lambda.statementValues().first
                    BoundReturnStatement returned = (BoundReturnStatement)evidenceSource5
                    expect(returned.requiredType.value()).toBe(type.value())
                    expect(returned.value.semanticType.value()).toBe(type.value())
                    expect(returned.conversion.conversionKind).toBe("identity")
                }
            }
        }
    }

    test `generic callback reference and null returns retain static representation evidence`() {
        let range = arrayRange("generic-callback-reference-return")
        let owner = DeclarationIdentity(SyntaxIslandIdentity(range.snapshot, "function", 100), "function", "from")
        let generic = GenericParameterSemanticType(owner, "T", 0)
        let declaration = FunctionSemanticType(SemanticType[], generic, true)
        let local = LocalBinding("original", SymbolIdentity(owner, "local", 0), SemanticTypes.objectType())
        let syntax = PrimitiveLambdaSyntax(range, PrimitiveFunctionParameterSyntax[], PrimitiveReferenceSyntax(range, "original"))
        let bound = PrimitiveExpressionBinder().bindCallback(syntax,
            FunctionSemanticType(SemanticType[], local.semanticType, true), [local], CallableSignature[],
            originalContract: declaration)
        expect(bound.succeeded).toBe(true)
        let lambda = arrayLambda(bound.expression)
        expect(lambda.declarationContract.returnType.value()).toBe(generic.value())
        expect(lambda.body.expressionKind()).toBe("reference")
        expect(lambda.body.semanticType.value()).toBe(local.semanticType.value())
        let nullSyntax = PrimitiveLambdaSyntax(range, PrimitiveFunctionParameterSyntax[],
            PrimitiveLiteralSyntax(range, Token.Type.NULL, "null"))
        let nullable = NullableSemanticType(local.semanticType)
        let nullBound = PrimitiveExpressionBinder().bindCallback(nullSyntax,
            FunctionSemanticType(SemanticType[], nullable, true), LocalBinding[], CallableSignature[],
            originalContract: declaration)
        expect(nullBound.succeeded).toBe(true)
        let nullLambda = arrayLambda(nullBound.expression)
        expect(nullLambda.declarationContract.returnType.value()).toBe(generic.value())
        expect(nullLambda.body.semanticType.value()).toBe(nullable.value())
        expect(arrayConversion(nullLambda.body).conversion.conversionKind).toBe("null")
    }

    async test `callback concrete return conversion precedes generic erasure`() {
        let range = arrayRange("callback-return-widening")
        let owner = DeclarationIdentity(SyntaxIslandIdentity(range.snapshot, "function", 100), "function", "from")
        let generic = GenericParameterSemanticType(owner, "T", 0)
        let declaration = FunctionSemanticType(SemanticType[], generic)
        let boxingContext = callbackBoxingContext(range, "Long")
        let boxingTarget = callbackBoxingTarget(boxingContext, SemanticTypes.longType())
        let syntax = PrimitiveLambdaSyntax(range, PrimitiveFunctionParameterSyntax[],
            PrimitiveLiteralSyntax(range, Token.Type.INTEGER, "42"))
        let result = PrimitiveExpressionBinder().bindCallback(syntax,
            FunctionSemanticType(SemanticType[], SemanticTypes.longType()), LocalBinding[], [boxingTarget],
            originalContract: declaration, declarationContext: boxingContext)
        expect(result.succeeded).toBe(true)
        let lambda = arrayLambda(result.expression)
        expect(lambda.declarationContract.returnType.value()).toBe(generic.value())
        expect(lambda.resultBoxingConstructor.identity.value).toBe(boxingTarget.identity.value)
        expect(arrayFunction(lambda.semanticType).returnType.value()).toBe("primitive:Long")
        let conversion = arrayConversion(lambda.body)
        expect(conversion.conversion.conversionKind).toBe("numeric-widening")
        expect(conversion.value.semanticType.value()).toBe("primitive:Int")
        let block = PrimitiveLambdaSyntax(range, PrimitiveFunctionParameterSyntax[],
            PrimitiveLiteralSyntax(range, Token.Type.NULL, "null"),
            statementValues: [PrimitiveReturnSyntax(range,
                PrimitiveLiteralSyntax(range, Token.Type.INTEGER, "42"))])
        let blockResult = PrimitiveExpressionBinder().bindCallback(block,
            FunctionSemanticType(SemanticType[], SemanticTypes.longType()), LocalBinding[], [boxingTarget],
            originalContract: declaration, declarationContext: boxingContext)
        expect(blockResult.succeeded).toBe(true)
        let blockLambda = arrayLambda(blockResult.expression)
        Object evidenceSource6 = blockLambda.statementValues().first
        BoundReturnStatement returned = (BoundReturnStatement)evidenceSource6
        expect(blockLambda.declarationContract.returnType.value()).toBe(generic.value())
        expect(blockLambda.resultBoxingConstructor.identity.value).toBe(boxingTarget.identity.value)
        expect(returned.requiredType.value()).toBe("primitive:Long")
        expect(returned.value.semanticType.value()).toBe("primitive:Int")
        expect(returned.conversion.conversionKind).toBe("numeric-widening")
    }

