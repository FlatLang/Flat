    test `binds fixed size array construction`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:array-construction-bind"), "revision:one"
        )
        let declaration = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "function", 0), "function", "allocate"
        )
        let syntax = PrimitiveExpressionParser().parse([
            token("new", Token.Type.IDENTIFIER, 1),
            token("Char", Token.Type.IDENTIFIER, 5),
            token("[", Token.Type.SYMBOL, 9),
            token("count", Token.Type.IDENTIFIER, 10),
            token("]", Token.Type.SYMBOL, 15)
        ], snapshot)
        let result = PrimitiveExpressionBinder().bind(syntax, locals: [
            LocalBinding(
                "count", SymbolIdentity(declaration, "parameter", 0),
