    test `rejects incompatible and ambiguous named member overloads`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:invalid-named-overloads"), "one")
        let range = SourceRange(snapshot, 0, 1,
            Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 2))
        let owner = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "class", 0), "class", "Box")
        let type = UserClassSemanticType(owner)
        let receiver = LocalBinding("box", SymbolIdentity(owner, "local", 0), type)
        let first = CallableSignature(SymbolIdentity(owner, "method", 0), "read",
            CallableKind("instance-method"), [SemanticTypes.intType()], SemanticTypes.intType(),
            ownerType: type, names: ["input"])
        let second = CallableSignature(SymbolIdentity(owner, "method", 1), "read",
            CallableKind("instance-method"), [SemanticTypes.intType()], SemanticTypes.intType(),
            ownerType: type, names: ["input"])
        let invalid = PrimitiveMemberCallSyntax(range, PrimitiveReferenceSyntax(range, "box"),
            "read", PrimitiveExpressionSyntax[], [PrimitiveMixedNamedArgumentSyntax(range,
                "input", PrimitiveLiteralSyntax(range, Token.Type.BOOL, "true"))])
        let noMatch = PrimitiveExpressionBinder().bind(invalid, locals: [receiver], callables: [first, second])
        expect(noMatch.succeeded).toBe(false)
        expect(noMatch.diagnostic.message).toBe("No overload of 'read' accepts the supplied receiver and arguments")
        let single = PrimitiveExpressionBinder().bind(invalid, locals: [receiver], callables: [first])
        expect(single.succeeded).toBe(false)
        expect(single.diagnostic.message).toBe(noMatch.diagnostic.message)
        let ambiguous = PrimitiveMemberCallSyntax(range, PrimitiveReferenceSyntax(range, "box"),
            "read", PrimitiveExpressionSyntax[], [PrimitiveMixedNamedArgumentSyntax(range,
                "input", PrimitiveLiteralSyntax(range, Token.Type.INTEGER, "1"))])
        let result = PrimitiveExpressionBinder().bind(ambiguous, locals: [receiver], callables: [first, second])
        let reversed = PrimitiveExpressionBinder().bind(ambiguous, locals: [receiver], callables: [second, first])
        expect(result.succeeded).toBe(false)
        expect(reversed.succeeded).toBe(false)
        expect(result.diagnostic.message.startsWith("Call to 'read' is ambiguous between ")).toBe(true)
        expect(reversed.diagnostic.message).toBe(result.diagnostic.message)
    }

