    test `block callback rejects mismatched return and missing result`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:block-invalid"), "one")
        let range = SourceRange(snapshot, 7, 8, Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 2))
        let syntax = PrimitiveLambdaSyntax(range, PrimitiveFunctionParameterSyntax[], PrimitiveLiteralSyntax(range, Token.Type.NULL, "null"),
            statementValues: [PrimitiveReturnSyntax(range, PrimitiveLiteralSyntax(range, Token.Type.BOOL, "true"))])
        let expected = FunctionSemanticType(SemanticType[], SemanticTypes.intType())
        let result = PrimitiveExpressionBinder().bindCallback(syntax, expected, LocalBinding[], CallableSignature[])
        expect(result.succeeded).toBe(false)
        expect(result.diagnostic.range).toBe(range)
        let incomplete = PrimitiveLambdaSyntax(range, PrimitiveFunctionParameterSyntax[], PrimitiveLiteralSyntax(range, Token.Type.NULL, "null"),
            statementValues: [PrimitiveExpressionStatementSyntax(range, PrimitiveLiteralSyntax(range, Token.Type.INTEGER, "1"))])
        let missing = PrimitiveExpressionBinder().bindCallback(incomplete, expected, LocalBinding[], CallableSignature[])
        expect(missing.succeeded).toBe(false)
        expect(missing.diagnostic.range).toBe(range)
    }

