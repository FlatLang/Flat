        expect(call.target.parameterTypes().first.value()).toBe(SemanticTypes.intType().value())
        expect(call.target.returnType.value()).toBe(SemanticTypes.intType().value())
        expect(call.semanticType.value()).toBe(SemanticTypes.intType().value())
    }

    test `mixed member overloads use positional offset and both argument types`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:mixed-member-overloads"), "one")
        let range = SourceRange(snapshot, 0, 1,
            Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 2))
        let owner = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "class", 0), "class", "Box")
        let type = UserClassSemanticType(owner)
        let receiver = LocalBinding("box", SymbolIdentity(owner, "local", 0), type)
        let first = CallableSignature(SymbolIdentity(owner, "method", 0), "read",
            CallableKind("instance-method"), [SemanticTypes.intType(), SemanticTypes.boolType()],
            SemanticTypes.intType(), ownerType: type, names: ["input", "other"])
        let second = CallableSignature(SymbolIdentity(owner, "method", 1), "read",
            CallableKind("instance-method"), [SemanticTypes.boolType(), SemanticTypes.intType()],
            SemanticTypes.intType(), ownerType: type, names: ["input", "other"])
        let body = PrimitiveMemberCallSyntax(range, PrimitiveReferenceSyntax(range, "box"),
            "read", [PrimitiveLiteralSyntax(range, Token.Type.INTEGER, "7")], [
                PrimitiveMixedNamedArgumentSyntax(range, "other",
                    PrimitiveLiteralSyntax(range, Token.Type.BOOL, "true"))])
        let result = PrimitiveExpressionBinder().bind(body, locals: [receiver], callables: [second, first])
        expect(result.succeeded).toBe(true)
        let call = (BoundCallExpression)result.expression
        expect(call.target.identity.value).toBe(first.identity.value)
        expect(call.argumentValues().count).toBe(2)
        expect(((BoundLiteralExpression)call.argumentValues()[0]).sourceValue).toBe("7")
        expect(((BoundLiteralExpression)call.argumentValues()[1]).sourceValue).toBe("true")
        let alternate = PrimitiveMemberCallSyntax(range, PrimitiveReferenceSyntax(range, "box"),
            "read", [PrimitiveLiteralSyntax(range, Token.Type.BOOL, "false")], [
                PrimitiveMixedNamedArgumentSyntax(range, "other",
                    PrimitiveLiteralSyntax(range, Token.Type.INTEGER, "9"))])
        let alternateResult = PrimitiveExpressionBinder().bind(alternate,
            locals: [receiver], callables: [first, second])
        expect(alternateResult.succeeded).toBe(true)
        let alternateCall = (BoundCallExpression)alternateResult.expression
        expect(alternateCall.target.identity.value).toBe(second.identity.value)
        expect(((BoundLiteralExpression)alternateCall.argumentValues()[0]).sourceValue).toBe("false")
        expect(((BoundLiteralExpression)alternateCall.argumentValues()[1]).sourceValue).toBe("9")
        let invalid = PrimitiveMemberCallSyntax(range, PrimitiveReferenceSyntax(range, "box"),
            "read", [PrimitiveLiteralSyntax(range, Token.Type.INTEGER, "7")], [
                PrimitiveMixedNamedArgumentSyntax(range, "other",
                    PrimitiveLiteralSyntax(range, Token.Type.INTEGER, "8"))])
        let rejected = PrimitiveExpressionBinder().bind(invalid, locals: [receiver], callables: [first, second])
        let reversedRejected = PrimitiveExpressionBinder().bind(invalid,
            locals: [receiver], callables: [second, first])
        expect(reversedRejected.succeeded).toBe(false)
        expect(reversedRejected.diagnostic.message).toBe(rejected.diagnostic.message)
        expect(rejected.succeeded).toBe(false)
        expect(rejected.diagnostic.message).toBe("No overload of 'read' accepts the supplied receiver and arguments")
    }

    test `named member labels disambiguate equal parameter types`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:label-overloads"), "one")
        let range = SourceRange(snapshot, 0, 1,
            Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 2))
        let owner = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "class", 0), "class", "Box")
        let type = UserClassSemanticType(owner)
        let receiver = LocalBinding("box", SymbolIdentity(owner, "local", 0), type)
        let first = CallableSignature(SymbolIdentity(owner, "method", 0), "read",
            CallableKind("instance-method"), [SemanticTypes.intType()], SemanticTypes.intType(),
            ownerType: type, names: ["input"])
        let second = CallableSignature(SymbolIdentity(owner, "method", 1), "read",
            CallableKind("instance-method"), [SemanticTypes.intType()], SemanticTypes.intType(),
            ownerType: type, names: ["other"])
        let targets = [first, second]
        var Int targetIndex
        while (targetIndex < targets.count) {
            let target = targets[targetIndex]
            let body = PrimitiveMemberCallSyntax(range, PrimitiveReferenceSyntax(range, "box"),
                "read", PrimitiveExpressionSyntax[], [PrimitiveMixedNamedArgumentSyntax(range,
                    target.parameterNames().first, PrimitiveLiteralSyntax(range, Token.Type.INTEGER, "1"))])
            let result = PrimitiveExpressionBinder().bind(body, locals: [receiver], callables: [first, second])
            let reversed = PrimitiveExpressionBinder().bind(body, locals: [receiver], callables: [second, first])
            expect(result.succeeded).toBe(true)
            expect(reversed.succeeded).toBe(true)
            expect(((BoundCallExpression)result.expression).target.identity.value).toBe(target.identity.value)
            expect(((BoundCallExpression)reversed.expression).target.identity.value).toBe(target.identity.value)
            targetIndex++
        }
        let invalid = PrimitiveMemberCallSyntax(range, PrimitiveReferenceSyntax(range, "box"),
            "read", PrimitiveExpressionSyntax[], [PrimitiveMixedNamedArgumentSyntax(range,
                "missing", PrimitiveReferenceSyntax(range, "unbound"))])
        let rejected = PrimitiveExpressionBinder().bind(invalid, locals: [receiver], callables: targets)
        expect(rejected.succeeded).toBe(false)
        expect(rejected.diagnostic.message).toBe("No overload of 'read' accepts the supplied receiver and arguments")
    }

