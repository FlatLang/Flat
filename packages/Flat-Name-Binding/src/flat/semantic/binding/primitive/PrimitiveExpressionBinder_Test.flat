        let first = LocalBinding("first", SymbolIdentity(owner, "local", 0), SemanticTypes.intType())
        let second = LocalBinding("second", SymbolIdentity(owner, "local", 1), SemanticTypes.intType())
        let unused = LocalBinding("unused", SymbolIdentity(owner, "local", 2), SemanticTypes.intType())
        let body = PrimitiveInterpolatedStringSyntax(range, [
            PrimitiveInterpolatedStringSegmentSyntax(range, "unused", null),
            PrimitiveInterpolatedStringSegmentSyntax(range, null,
                PrimitiveInterpolationPathSyntax(range, ["first"])),
            PrimitiveInterpolatedStringSegmentSyntax(range, null,
                PrimitiveReferenceSyntax(range, "second"))
        ])
        let result = PrimitiveExpressionBinder().bind(
            PrimitiveLambdaSyntax(range, PrimitiveFunctionParameterSyntax[], body),
            locals: [first, second, unused])
        expect(result.succeeded).toBe(true)
        let lambda = (BoundLambdaExpression)result.expression
        expect(lambda.captureValues().count).toBe(2)
        expect(lambda.captureValues()[0].symbolIdentity.value).toBe(first.identity.value)
        expect(lambda.captureValues()[1].symbolIdentity.value).toBe(second.identity.value)
    }

    test `captures conditional condition and both branches once`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:conditional-captures"), "one")
        let range = SourceRange(snapshot, 0, 1,
            Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 2))
        let owner = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "function", 0), "function", "read")
        let flag = LocalBinding("flag", SymbolIdentity(owner, "local", 0), SemanticTypes.boolType())
        let left = LocalBinding("left", SymbolIdentity(owner, "local", 1), SemanticTypes.intType())
        let right = LocalBinding("right", SymbolIdentity(owner, "local", 2), SemanticTypes.intType())
        let syntax = PrimitiveLambdaSyntax(range, PrimitiveFunctionParameterSyntax[],
            PrimitiveConditionalSyntax(range, PrimitiveReferenceSyntax(range, "flag"),
                PrimitiveReferenceSyntax(range, "left"), PrimitiveReferenceSyntax(range, "right")))
        let result = PrimitiveExpressionBinder().bind(syntax, locals: [flag, left, right])
        expect(result.succeeded).toBe(true)
        let lambda = (BoundLambdaExpression)result.expression
        expect(lambda.captureValues().count).toBe(3)
        expect(lambda.captureValues()[0].symbolIdentity.value).toBe(flag.identity.value)
        expect(lambda.captureValues()[1].symbolIdentity.value).toBe(left.identity.value)
        expect(lambda.captureValues()[2].symbolIdentity.value).toBe(right.identity.value)
    }

    test `captures cast operands and assignment and update locals`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:expression-captures"), "one")
        let range = SourceRange(snapshot, 0, 1,
            Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 2))
        let owner = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "function", 0), "function", "read")
        let target = LocalBinding("target", SymbolIdentity(owner, "local", 0), SemanticTypes.intType())
        let source = LocalBinding("source", SymbolIdentity(owner, "local", 1), SemanticTypes.intType())
        let PrimitiveExpressionSyntax[] expressions = [
            PrimitiveCastSyntax(range, "Double", PrimitiveReferenceSyntax(range, "target")),
            PrimitivePostfixUpdateSyntax(range, "++", PrimitiveReferenceSyntax(range, "target")),
            PrimitiveAssignmentValueSyntax(range, "target", PrimitiveReferenceSyntax(range, "source"))
        ]
        var Int index
        for (expression in expressions) {
            let result = PrimitiveExpressionBinder().bind(
                PrimitiveLambdaSyntax(range, PrimitiveFunctionParameterSyntax[], expression),
                locals: [target, source])
            expect(result.succeeded).toBe(true)
            let lambda = (BoundLambdaExpression)result.expression
            expect(lambda.captureValues().count).toBe(index == 2 ? 2 : 1)
            expect(lambda.captureValues().first.symbolIdentity.value).toBe(target.identity.value)
            if (index == 2) {
                expect(lambda.captureValues()[1].symbolIdentity.value).toBe(source.identity.value)
            }
            index++
        }
    }

