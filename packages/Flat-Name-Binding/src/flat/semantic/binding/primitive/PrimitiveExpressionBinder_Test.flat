package flat/semantic/binding/primitive

import flat/compiler/models
import flat/parser/flat
import flat/semantic/types
import flat/bound

testable class {
    test `contextually types async lambda parameters and captures`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:contextual-lambda"), "one")
        let syntax = PrimitiveExpressionParser().parse([
            token("lambda", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 7),
            token("Int", Token.Type.IDENTIFIER, 8), token("value", Token.Type.IDENTIFIER, 12),
            token(")", Token.Type.SYMBOL, 17), token("=>", Token.Type.SYMBOL, 19),
            token("value", Token.Type.IDENTIFIER, 22), token("+", Token.Type.SYMBOL, 28),
            token("captured", Token.Type.IDENTIFIER, 30)
        ], snapshot)
        let captured = LocalBinding("captured", SymbolIdentity(DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "local", 0), "local", "captured"
        ), "local"), SemanticTypes.intType())
        let expected = FunctionSemanticType([SemanticTypes.intType()], SemanticTypes.intType(), true)
        let result = PrimitiveExpressionBinder().bind(syntax, requiredType: expected, locals: [captured])
        expect(result.succeeded).toBe(true)
        let lambda = (BoundLambdaExpression)result.expression
        let type = (FunctionSemanticType)lambda.semanticType
        expect(type.asyncFunction).toBe(true)
        expect(lambda.captureValues().first.symbolIdentity.value).toBe(captured.identity.value)
        expect(lambda.parameterValues().first.semanticType.value()).toBe(SemanticTypes.intType().value())
        expect(PrimitiveExpressionBinder().bind(syntax,
            requiredType: FunctionSemanticType([SemanticTypes.boolType()], SemanticTypes.intType(), true),
            locals: [captured]).succeeded).toBe(false)
        expect(PrimitiveExpressionBinder().bind(syntax,
            requiredType: FunctionSemanticType(SemanticType[], SemanticTypes.intType(), true),
            locals: [captured]).succeeded).toBe(false)
    }

    test `invokes local callback expression`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:callback-expression-call"), "revision:one"
        )
        let declaration = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "function", 0), "function", "read"
        )
        let syntax = PrimitiveExpressionParser().parse([
            token("next", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 5),
            token("41", Token.Type.INTEGER, 6), token(")", Token.Type.SYMBOL, 8)
        ], snapshot)
        let result = PrimitiveExpressionBinder().bind(syntax, locals: [LocalBinding(
            "next", SymbolIdentity(declaration, "parameter", 0),
            FunctionSemanticType([SemanticTypes.intType()], SemanticTypes.intType())
        )])
        expect(result.succeeded).toBe(true)
        expect(result.expression.expressionKind()).toBe("function-invocation")
        expect(result.expression.semanticType.value()).toBe(SemanticTypes.intType().value())
    }

    test `publishes instantiated generic call target`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:generic-expression-call"), "revision:one"
        )
        let declaration = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "function", 0), "function", "identity"
        )
        let parameter = GenericParameterSemanticType(declaration, "Out", 0)
        let target = CallableSignature(
            SymbolIdentity(declaration, "function"), "identity", CallableKind("function"),
            [parameter], parameter, genericParameterValues: [parameter]
        )
        let syntax = PrimitiveExpressionParser().parse([
            token("identity", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 9),
            token("42", Token.Type.INTEGER, 10), token(")", Token.Type.SYMBOL, 12)
        ], snapshot)
        let result = PrimitiveExpressionBinder().bind(syntax, callables: [target])
        expect(result.succeeded).toBe(true)
        let expression = (Object)result.expression
        let call = (BoundCallExpression)expression
        expect(call.target.returnType.value()).toBe(SemanticTypes.intType().value())
        expect(call.target.parameterTypes().first.value()).toBe(SemanticTypes.intType().value())
        expect(target.returnType.value()).toBe(parameter.value())
    }

