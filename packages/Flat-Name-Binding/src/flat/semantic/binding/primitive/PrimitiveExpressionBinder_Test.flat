    test `captures member receiver and named value but not member or label names`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:named-member-capture"), "one")
        let range = SourceRange(snapshot, 0, 1,
            Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 2))
        let owner = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "class", 0), "class", "Box")
        let type = UserClassSemanticType(owner)
        let receiver = LocalBinding("box", SymbolIdentity(owner, "local", 0), type)
        let value = LocalBinding("value", SymbolIdentity(owner, "local", 1), SemanticTypes.intType())
        let methodName = LocalBinding("read", SymbolIdentity(owner, "local", 2), SemanticTypes.intType())
        let labelName = LocalBinding("input", SymbolIdentity(owner, "local", 3), SemanticTypes.intType())
        let target = CallableSignature(SymbolIdentity(owner, "method", 0), "read",
            CallableKind("instance-method"), [SemanticTypes.intType()], SemanticTypes.intType(),
            ownerType: type, names: ["input"])
        let body = PrimitiveMemberCallSyntax(range, PrimitiveReferenceSyntax(range, "box"),
            "read", PrimitiveExpressionSyntax[], [PrimitiveMixedNamedArgumentSyntax(range,
                "input", PrimitiveReferenceSyntax(range, "value"))])
        let unrelatedOwner = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", 2), "class", "OtherBox")
        let unrelated = CallableSignature(SymbolIdentity(unrelatedOwner, "method", 0), "read",
            CallableKind("instance-method"), [SemanticTypes.intType()], SemanticTypes.intType(),
            ownerType: UserClassSemanticType(unrelatedOwner), names: ["input"])
        let competing = CallableSignature(SymbolIdentity(owner, "method", 1), "read",
            CallableKind("instance-method"), [SemanticTypes.boolType()], SemanticTypes.intType(),
            ownerType: type, names: ["input"])
        let result = PrimitiveExpressionBinder().bind(
            PrimitiveLambdaSyntax(range, PrimitiveFunctionParameterSyntax[], body),
            locals: [receiver, value, methodName, labelName], callables: [unrelated, competing, target])
        expect(result.succeeded).toBe(true)
        let lambda = (BoundLambdaExpression)result.expression
        expect(lambda.captureValues().count).toBe(2)
        expect(lambda.captureValues()[0].symbolIdentity.value).toBe(receiver.identity.value)
        expect(lambda.captureValues()[1].symbolIdentity.value).toBe(value.identity.value)
        expect(((BoundCallExpression)lambda.body).target.identity.value).toBe(target.identity.value)
        let reversed = PrimitiveExpressionBinder().bind(
            PrimitiveLambdaSyntax(range, PrimitiveFunctionParameterSyntax[], body),
            locals: [receiver, value, methodName, labelName], callables: [target, competing, unrelated])
        expect(reversed.succeeded).toBe(true)
        let reversedLambda = (BoundLambdaExpression)reversed.expression
        expect(((BoundCallExpression)reversedLambda.body).target.identity.value).toBe(target.identity.value)
        expect(reversedLambda.captureValues()[0].symbolIdentity.value).toBe(receiver.identity.value)
        expect(reversedLambda.captureValues()[1].symbolIdentity.value).toBe(value.identity.value)
    }

