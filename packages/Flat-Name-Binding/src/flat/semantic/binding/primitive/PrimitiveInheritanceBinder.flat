package flat/semantic/binding/primitive

import flat/compiler/models
import flat/parser/flat
import flat/bound
import flat/semantic/types

/** Binds and validates one sealed parent/child inheritance component. */
class {
    public bind(
        PrimitiveClassSyntax parentSyntax,
        PrimitiveClassSyntax childSyntax,
        SourceSnapshotIdentity snapshot = null,
        CallableSignature[] availableConstructors = CallableSignature[],
        PrimitiveInterfaceSyntax[] interfaceSyntaxValues = PrimitiveInterfaceSyntax[],
        BoundFunctionUnit[] rootContractFunctions = BoundFunctionUnit[],
        BoundTypeUnit boundParent = null,
        BoundFieldUnit[] availableFields = BoundFieldUnit[],
        TypeHierarchyComponent conversionHierarchy = null
    ) -> PrimitiveInheritanceBindingResult {
        if (!parentSyntax || !childSyntax || !availableConstructors ||
            availableConstructors.any({ !_ }) || !availableFields ||
            availableFields.any({ !_ }) || !interfaceSyntaxValues ||
            interfaceSyntaxValues.any({ !_ }) || !rootContractFunctions ||
            rootContractFunctions.any({ !_ }) ||
            childSyntax.parentName != parentSyntax.name ||
            (parentSyntax.parentName && !boundParent) ||
            (boundParent && boundParent.identity.name != parentSyntax.name)) {
            throw Exception("Reduced inheritance requires one declared root parent and matching child")
        }
        let parentSnapshot = snapshot ?: parentSyntax.range.snapshot
        let childSnapshot = snapshot ?: childSyntax.range.snapshot
        let parent = boundParent ?: PrimitiveClassBinder().bind(
            parentSyntax, parentSnapshot,
            availableConstructors: availableConstructors,
            availableFields: availableFields, interfaceSyntaxValues: interfaceSyntaxValues,
            hierarchy: conversionHierarchy
        ).typeUnit
        let parentConstructor = constructorSignature(parent)
        let child = PrimitiveClassBinder().bind(
            childSyntax, childSnapshot, parentConstructor, parent.fieldUnits(),
            availableConstructors, availableFields, interfaceSyntaxValues, conversionHierarchy
        ).typeUnit
        let hierarchy = TypeHierarchyComponent()
        hierarchy.add(TypeHierarchyDeclaration(
            parent.semanticType, "class", UserClassSemanticType[]
        ))
        hierarchy.add(TypeHierarchyDeclaration(
            child.semanticType, "class", [parent.semanticType]
        ))
        hierarchy.seal()
        if (!hierarchy.valid || hierarchy.distance(child.semanticType, parent.semanticType) != 1) {
            throw Exception("Invalid reduced inheritance component")
        }
        let parentFunctions = normalizeParent(parent.functionUnits())
        let parentContracts = BoundFunctionUnit[]
        parentContracts.addAll(parentFunctions)
        let rootInstanceFunctions = BoundFunctionUnit[]
        for (function in rootContractFunctions) {
            if (!function.constructorFunction && !function.staticFunction) {
                rootInstanceFunctions.add(function)
            }
        }
        parentContracts.addAll(normalizeParent(rootInstanceFunctions))
        let childFunctions = normalizeChild(
            child.functionUnits(), parentContracts, childSyntax,
            interfaceSyntaxValues, availableConstructors, child.semanticType
        )
        return PrimitiveInheritanceBindingResult(
            BoundTypeUnit(
                parent.identity, parent.semanticType, parentFunctions, parent.range,
                metadataValues: parent.metadata(), fieldValues: parent.fieldUnits(),
                parentType: parent.parentType
            ),
            BoundTypeUnit(
                child.identity, child.semanticType, childFunctions, child.range,
                metadataValues: child.metadata(),
                fieldValues: child.fieldUnits(), parentType: parent.semanticType
            )
        )
    }

    constructorSignature(BoundTypeUnit typeUnit) -> CallableSignature {
        let constructor = typeUnit.functionUnits().firstOrNull({ _.constructorFunction })
        if (!constructor) throw Exception("Reduced parent requires a constructor")
        let parameterTypes = constructor.parameterValues().map({ _.semanticType })
        let optionalCount = constructor.parameterValues().filter({ _.defaultValue != null }).count
        var Int index = constructor.parameterValues().count - optionalCount
        while (index < constructor.parameterValues().count) {
            if (!constructor.parameterValues()[index].defaultValue) {
                throw Exception("Reduced parent constructor defaults must be trailing")
            }
            index++
        }
        return CallableSignature(
            SymbolIdentity(constructor.identity, "constructor"),
            typeUnit.identity.name,
            CallableKind("constructor"),
            parameterTypes,
            typeUnit.semanticType,
            typeUnit.semanticType,
            optionalCount
        )
    }

    normalizeParent(BoundFunctionUnit[] functions) -> BoundFunctionUnit[] {
        let result = BoundFunctionUnit[]
        for (function in functions) {
            result.add(copy(function,
                function.constructorFunction || function.staticFunction
                    ? null : function.identity.value
            ))
        }
        return result
    }

    normalizeChild(
        BoundFunctionUnit[] functions,
        BoundFunctionUnit[] parentFunctions,
        PrimitiveClassSyntax childSyntax,
        PrimitiveInterfaceSyntax[] interfaceSyntaxValues,
        CallableSignature[] availableConstructors,
        UserClassSemanticType childType
    ) -> BoundFunctionUnit[] {
        let result = BoundFunctionUnit[]
        for (function in functions) {
            if (function.constructorFunction) {
                result.add(copy(function, null))
                continue
            }
            let parent = parentFunctionMatching(parentFunctions, function)
            if (!parent) {
                let interfaceMethod = interfaceMethodNamed(
                    function.name, childSyntax, interfaceSyntaxValues
                )
                if (interfaceMethod) {
                    validateInterfaceMethod(function, childSyntax, interfaceSyntaxValues,
                        availableConstructors, childType)
                }
                result.add(copy(function, function.staticFunction ? null : function.identity.value))
                continue
            }
            var Bool returnMismatch
            let parentReturnValue = parent.returnType.value()
            var String functionReturnValue = function.returnType.value()
            var BoundFunctionUnit normalizedFunction = function
            if (functionReturnValue == "unknown" && parentReturnValue != "unknown") {
                normalizedFunction = copyWithReturnType(function, parent.returnType)
                functionReturnValue = parentReturnValue
            } else if (parent.abstractFunction && parentReturnValue != "unknown" &&
                functionReturnValue != parentReturnValue &&
                returnsConvertTo(function.statements(), parent.returnType)) {
                normalizedFunction = copyWithReturnType(function, parent.returnType)
                functionReturnValue = parentReturnValue
            }
            if (parentReturnValue != "unknown" && functionReturnValue != "unknown") {
                returnMismatch = parentReturnValue != functionReturnValue
            }
            if (returnMismatch ||
                !sameParameters(parent.parameterValues(), function.parameterValues())) {
                let interfaceMethod = interfaceMethodNamed(
                    function.name, childSyntax, interfaceSyntaxValues
                )
                if (interfaceMethod) {
                    validateInterfaceMethod(function, childSyntax, interfaceSyntaxValues,
                        availableConstructors, childType)
                    result.add(copy(function, function.identity.value))
                    continue
                }
                throw Exception("Invalid override '#{function.name}'")
            }
            result.add(copy(normalizedFunction, parent.dispatchIdentity))
        }
        return result
    }

    interfaceMethodNamed(
        String name,
        PrimitiveClassSyntax childSyntax,
        PrimitiveInterfaceSyntax[] interfaceSyntaxValues
    ) -> PrimitiveInterfaceMethodSyntax {
        for (implementedName in childSyntax.implementedTypeNames()) {
            let genericStart = implementedName.indexOf("<", defaultReturnValue: -1)
            let interfaceName = genericStart < 0 ? implementedName :
                implementedName.substring(0, genericStart)
            let syntax = interfaceSyntaxValues.firstOrNull({ _.name == interfaceName })
            if (syntax) {
                let method = syntax.methodValues().firstOrNull({ _.name == name })
                if (method) return method
            }
        }
        return null
    }

    validateInterfaceMethod(
        BoundFunctionUnit function,
        PrimitiveClassSyntax childSyntax,
        PrimitiveInterfaceSyntax[] interfaceSyntaxValues,
        CallableSignature[] availableConstructors,
        UserClassSemanticType childType
    ) {
        let implementedNames = childSyntax.implementedTypeNames()
        for (implementedName in implementedNames) {
            let genericStart = implementedName.indexOf("<", defaultReturnValue: -1)
            let interfaceName = genericStart < 0 ? implementedName :
                implementedName.substring(0, genericStart)
            let syntax = interfaceSyntaxValues.firstOrNull({ _.name == interfaceName })
            if (!syntax) continue
            let method = syntax.methodValues().firstOrNull({ _.name == function.name })
            if (!method) continue
            let contractParameters = GenericParameterSemanticType[]
            let contractIdentity = DeclarationIdentity(
                SyntaxIslandIdentity(syntax.range.snapshot, "interface", syntax.range.startTokenIndex),
                "interface", syntax.name
            )
            for (name in syntax.genericParameterNames()) {
                contractParameters.add(GenericParameterSemanticType(contractIdentity, name, contractParameters.count))
            }
            let resolver = PrimitiveStructuralTypeResolver(
                callables: availableConstructors, receiverType: childType,
                methodGenericParameters: contractParameters,
                interfaces: interfaceSyntaxValues
            )
            let typeArguments = SemanticType[]
            if (contractParameters.isNotEmpty) {
                if (genericStart < 0) throw Exception("Interface generic arguments are required")
                let argumentNames = implementedName.substring(genericStart + 1, implementedName.count - 1)
                let arguments = PrimitiveStructuralTypeResolver(
                    callables: availableConstructors, receiverType: childType,
                    genericParameter: childSyntax.genericParameterName ? GenericParameterSemanticType(
                        childType.declarationIdentity, childSyntax.genericParameterName, 0
                    ) : null, interfaces: interfaceSyntaxValues
                ).resolve("#{syntax.name}<#{argumentNames}>")
                let instance = (GenericInstanceSemanticType)arguments
                typeArguments.addAll(instance.typeArguments())
            }
            if (contractParameters.count != typeArguments.count) throw Exception("Interface generic arity mismatch")
            let substitution = GenericSubstitution(contractParameters, typeArguments)
            let parameterNames = method.parameterTypeNames()
            if (parameterNames.count != function.parameterValues().count) {
                throw Exception("Invalid interface method '#{function.name}'")
            }
            var Int index
            while (index < parameterNames.count) {
                let expected = substitution.apply(resolver.resolve(parameterNames[index]))
                if (function.parameterValues()[index].semanticType.value() != expected.value()) {
                    throw Exception("Invalid interface method '#{function.name}'")
                }
                index++
            }
            return
        }
        throw Exception("Child method '#{function.name}' must override a parent or interface method")
    }

    sameParameters(
        BoundFunctionParameter[] left,
        BoundFunctionParameter[] right
    ) -> Bool {
        if (left.count != right.count) return false
        var Int index
        while (index < left.count) {
            if (left[index].semanticType.value() != right[index].semanticType.value()) return false
            index++
        }
        return true
    }

    parentFunctionMatching(
        BoundFunctionUnit[] functions,
        BoundFunctionUnit target
    ) -> BoundFunctionUnit {
        for (function in functions) {
            if (function.name == target.name &&
                function.staticFunction == target.staticFunction &&
                sameParameters(function.parameterValues(), target.parameterValues())) {
                return function
            }
        }
        return null
    }

    returnsConvertTo(BoundStatement[] statements, SemanticType returnType) -> Bool {
        var Bool found
        for (statement in statements) {
            if (statement.class.isOfType(BoundReturnStatement.class)) {
                let returned = (BoundReturnStatement)statement
                let converted = TypeConversions.classify(
                    returned.value.semanticType, returnType
                )
                if (!returned.value || (!converted.applicable &&
                    returned.value.semanticType.kind() != "unknown")) return false
                found = true
            } else if (statement.class.isOfType(BoundIfStatement.class)) {
                let conditional = (BoundIfStatement)statement
                if (!returnsConvertTo(conditional.thenValues(), returnType) ||
                    !returnsConvertTo(conditional.elseValues(), returnType)) return false
                found = true
            } else if (statement.class.isOfType(BoundSwitchStatement.class)) {
                let cases = ((BoundSwitchStatement)statement).caseValues()
                for (caseValue in cases) {
                    if (caseValue.statementValues().isNotEmpty &&
                        !returnsConvertTo(caseValue.statementValues(), returnType)) return false
                }
                found = true
            } else if (statement.class.isOfType(BoundForEachStatement.class)) {
                if (!returnsConvertTo(
                    ((BoundForEachStatement)statement).body(), returnType
                )) return false
                found = true
            } else if (statement.class.isOfType(BoundWhileStatement.class)) {
                if (!returnsConvertTo(
                    ((BoundWhileStatement)statement).bodyValues(), returnType
                )) return false
                found = true
            } else if (statement.class.isOfType(BoundTryStatement.class)) {
                let attempted = (BoundTryStatement)statement
                if (!returnsConvertTo(attempted.tryValues(), returnType) ||
                    !returnsConvertTo(attempted.finallyValues(), returnType)) return false
                for (caught in attempted.catchValues()) {
                    if (!returnsConvertTo(caught.statements(), returnType)) return false
                }
                found = true
            }
        }
        return found
    }

    retypeReturns(BoundStatement[] statements, SemanticType returnType) -> BoundStatement[] {
        let result = BoundStatement[]
        for (statement in statements) {
            if (statement.class.isOfType(BoundReturnStatement.class)) {
                let returned = (BoundReturnStatement)statement
                var TypeConversion conversion = TypeConversions.classify(
                    returned.value.semanticType, returnType
                )
                if (!conversion.applicable &&
                    returned.value.semanticType.kind() == "unknown") {
                    conversion = TypeConversion(
                        returned.value.semanticType, returnType,
                        "deferred-inferred-return", true, false, true, 1000
                    )
                }
                if (!conversion.applicable) {
                    throw Exception("Cannot refine return '#{returned.value.semanticType.value()}' to '#{returnType.value()}'")
                }
                result.add(BoundReturnStatement(
                    returned.range, returnType, returned.value, conversion
                ))
            } else if (statement.class.isOfType(BoundIfStatement.class)) {
                let conditional = (BoundIfStatement)statement
                result.add(BoundIfStatement(
                    conditional.range, conditional.condition,
                    retypeReturns(conditional.thenValues(), returnType),
                    retypeReturns(conditional.elseValues(), returnType)
                ))
            } else if (statement.class.isOfType(BoundSwitchStatement.class)) {
                let switched = (BoundSwitchStatement)statement
                let cases = BoundSwitchCase[]
                for (caseValue in switched.caseValues()) {
                    cases.add(BoundSwitchCase(
                        caseValue.range, caseValue.label,
                        retypeReturns(caseValue.statementValues(), returnType),
                        caseValue.defaultCase, caseValue.fallsThrough
                    ))
                }
                result.add(BoundSwitchStatement(
                    switched.range, switched.value, cases
                ))
            } else if (statement.class.isOfType(BoundForEachStatement.class)) {
                let loop = (BoundForEachStatement)statement
                result.add(BoundForEachStatement(
                    loop.range, loop.initialization(), loop.condition,
                    retypeReturns(loop.body(), returnType), loop.advance(),
                    loop.loopLabel, loop.exitLabel
                ))
            } else if (statement.class.isOfType(BoundWhileStatement.class)) {
                let loop = (BoundWhileStatement)statement
                result.add(BoundWhileStatement(
                    loop.range, loop.condition,
                    retypeReturns(loop.bodyValues(), returnType)
                ))
            } else result.add(statement)
        }
        return result
    }

    copyWithReturnType(
        BoundFunctionUnit value,
        SemanticType returnType
    ) -> BoundFunctionUnit => BoundFunctionUnit(
        value.identity, value.name, returnType,
        retypeReturns(value.statements(), returnType), value.range,
        value.parameterValues(), value.staticFunction, value.mainFunction,
        value.constructorFunction, value.dispatchIdentity, value.parentConstructorCall,
        value.constructorDelegation,
        value.asyncFunction, value.externalName, value.abstractFunction
    )

    copy(BoundFunctionUnit value, String dispatchIdentity) -> BoundFunctionUnit =>
        BoundFunctionUnit(
            value.identity, value.name, value.returnType, value.statements(), value.range,
            value.parameterValues(), value.staticFunction, value.mainFunction,
            value.constructorFunction, dispatchIdentity, value.parentConstructorCall,
            value.constructorDelegation,
            value.asyncFunction, value.externalName, value.abstractFunction
        )
}
