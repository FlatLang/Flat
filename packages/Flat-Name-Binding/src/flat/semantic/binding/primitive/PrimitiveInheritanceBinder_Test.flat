package flat/semantic/binding/primitive

import flat/compiler/models
import flat/parser/flat

testable class {
    test `binds sealed parent child component and shared virtual slot`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:inheritance-bind"), "revision:one"
        )
        let parent = PrimitiveClassParser().parse(typeTokens("Parent", null, "1"), snapshot)
        let child = PrimitiveClassParser().parse(typeTokens("Child", "Parent", "2"), snapshot)
        let result = PrimitiveInheritanceBinder().bind(parent, child, snapshot)
        let parentMethod = result.parentType.functionUnits().last
        let childMethod = result.childType.functionUnits().last
        expect(result.childType.parentType.value()).toBe(result.parentType.semanticType.value())
        expect(childMethod.dispatchIdentity).toBe(parentMethod.dispatchIdentity)
    }

    test `binds parent constructor arguments with explicit conversion evidence`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:inheritance-constructor"), "revision:one"
        )
        let parent = PrimitiveClassParser().parse(parentWithConstructor("Parent"), snapshot)
        let child = PrimitiveClassParser().parse(childWithDelegation("Child", "Parent"), snapshot)
        let result = PrimitiveInheritanceBinder().bind(parent, child, snapshot)
        let constructor = result.childType.functionUnits().first
        let parentCall = constructor.parentConstructorCall

        expect(parentCall).toNotBe(null)
        expect(parentCall.target.ownerType.value()).toBe(result.parentType.semanticType.value())
        expect(parentCall.argumentValues().count).toBe(1)
        expect(parentCall.argumentValues().first.semanticType.value()).toBe("builtin:String")
        expect(parentCall.argumentConversions().first.conversionKind).toBe("identity")
    }

    test `rejects parent constructor arity and type mismatch`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:inheritance-constructor-invalid"), "revision:one"
        )
        let parent = PrimitiveClassParser().parse(parentWithConstructor("Parent"), snapshot)
        var Int rejected
        try {
            let child = PrimitiveClassParser().parse(
                childWithDelegation("Missing", "Parent", false), snapshot
            )
            PrimitiveInheritanceBinder().bind(parent, child, snapshot)
        } catch (Exception error) { rejected++ }
        try {
            let child = PrimitiveClassParser().parse([
                token("class", false), token("Wrong", false), token("extends", false),
                token("Parent", false), token("{", true), token("construct", false),
                token("(", true), token("Int", false), token("value", false), token(")", true),
                token("=>", true), token("super", false), token("(", true),
                token("value", false), token(")", true), token("}", true)
            ], snapshot)
            PrimitiveInheritanceBinder().bind(parent, child, snapshot)
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
    }

    test `rejects missing parent and invalid override`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:inheritance-invalid"), "revision:one"
        )
        var Int rejected
        try {
            let parent = PrimitiveClassParser().parse(typeTokens("Parent", null, "1"), snapshot)
            let child = PrimitiveClassParser().parse(typeTokens("Child", "Missing", "2"), snapshot)
            PrimitiveInheritanceBinder().bind(parent, child, snapshot)
        } catch (Exception error) { rejected++ }
        try {
            let parent = PrimitiveClassParser().parse(typeTokens("Parent", null, "1"), snapshot)
            let child = PrimitiveClassParser().parse(typeTokens("Child", "Parent", "true"), snapshot)
            PrimitiveInheritanceBinder().bind(parent, child, snapshot)
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
    }

    parentWithConstructor(String name) -> Token[] {
        return [
            token("class", false), token(name, false), token("{", true),
            token("construct", false), token("(", true), token("String", false),
            token("message", false), token(")", true), token("{", true), token("}", true),
            token("}", true)
        ]
    }

    childWithDelegation(
        String name,
        String parent,
        Bool includeArgument = true
    ) -> Token[] {
        let values = [
            token("class", false), token(name, false), token("extends", false),
            token(parent, false), token("{", true), token("construct", false),
            token("(", true), token("String", false), token("message", false),
            token(")", true), token("=>", true), token("super", false), token("(", true)
        ]
        if (includeArgument) values.add(token("message", false))
        values.addAll([token(")", true), token("}", true)])
        return values
    }

    typeTokens(String name, String parent, String returned) -> Token[] {
        let values = [token("class", false), token(name, false)]
        if (parent) values.addAll([token("extends", false), token(parent, false)])
        values.addAll([
            token("{", true), token("constructor", false), token("(", true), token(")", true),
            token("{", true), token("}", true), token("value", false), token("(", true),
            token(")", true), token("->", true), token(returned == "true" ? "Bool" : "Int", false),
            token("{", true), token("return", false),
            token(returned, false, returned == "true" ? Token.Type.BOOL : Token.Type.INTEGER),
            token(";", true), token("}", true), token("}", true)
        ])
        return values
    }

    token(String value, Bool symbol, Int type = Token.Type.IDENTIFIER) -> Token {
        return Token(value: value, type: symbol ? Token.Type.SYMBOL : type,
            location: Location(lineNumber: 1, column: 1))
    }
}
