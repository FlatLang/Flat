    async test `parent constructor failures retain candidate types without coercion`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:parent-constructor-invalid-types"), "one")
        let stream = Lexer().lex("class Parent { construct(Int value) {} } class Child extends Parent { construct() => super(true) }")
        stream.emit("start")
        let partitions = FlatSourceTypePartitioner().partition(stream.consumeAll<Token>("data"), snapshot)
        let syntaxes = PrimitiveClassSyntax[]
        for (partition in partitions) syntaxes.add(PrimitiveClassParser().parse(
            partition.tokenValues(), snapshot, partition.startTokenIndex))
        var String message = ""
        try { PrimitiveClassPartitionBinder().bind(syntaxes, snapshot) }
        catch (Exception error) { message = error.message }
        expect(message.contains("receiver=none")).toBe(true)
        expect(message.contains("actual=(primitive:Bool)")).toBe(true)
        expect(message.contains("expected=(primitive:Int)")).toBe(true)
        expect(message.contains("id=")).toBe(true)
        expect(message.contains("source=memory:parent-constructor-invalid-types")).toBe(true)
    }

    async test `Core String Char constructor retains native local setup before delegation`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("packages/Flat-Core/src/flat/String.js.flat:8-16"), "one")
        var String source = "class Text { visible Int marker = 1; public construct(Char c) { native_array native Char[] chars; external { chars = ["
        source += '#'
        source += "{c}]; } this(chars); } public construct(native_array native Char[] chars, public Int size = 1) {} }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let unit = PrimitiveClassBinder().bind(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot), snapshot).typeUnit
        let constructors = unit.functionUnits().filter({ _.constructorFunction })
        let plan = constructors.first.constructorPlan
        expect(plan.delegationPath().count).toBe(2)
        let setup = plan.preBaseStatements()
        expect(setup.first.unitKind()).toBe("local-declaration")
        expect(setup[1].unitKind()).toBe("external")
        let field = unit.functionUnits().firstOrNull((function) => function.identity.value == plan.fieldInitializer.value)
        expect(field.statements().count).toBe(1)
        let terminalIdentity = BoundConstructorPlan.bodyInitializerIdentity(constructors.last.identity)
        let terminal = unit.functionUnits().firstOrNull((function) => function.identity.value == terminalIdentity.value)
        expect(terminal.statements().first.unitKind()).toBe("member-assignment")
        expect(terminal.statements().count).toBe(1)
        expect(constructors.first.statements().isEmpty).toBe(true)
    }

    async test `late and repeated source delegations retain attributed rejection`() {
        let sources = [
            "class Bad { visible Int value; construct() { value = 1; this(0); } construct(Int n) {} }",
            "class Bad { construct() { this(0); this(1); } construct(Int n) {} }"
        ]
        for (source in sources) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:invalid-source-delegation"), "one")
            let stream = Lexer().lex(source)
            stream.emit("start")
            let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
            var String message = ""
            try { PrimitiveClassBinder().bind(syntax, snapshot) }
            catch (Exception error) { message = error.message }
            expect(message.contains("type=")).toBe(true)
            expect(message.contains("constructor=")).toBe(true)
            expect(message.contains("source=memory:invalid-source-delegation")).toBe(true)
            expect(message.contains("directDelegationCount=")).toBe(true)
            expect(message.contains("statementKinds=")).toBe(true)
            expect(message.contains("location=")).toBe(true)
        }
    }

    async test `constructor helper renames typed native parameters without changing literal text`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:constructor-native-identity"), "one")
        var String source = "class NativeValue { public construct(native String text) { external { consume("
        source += '#'
        source += "{text}); } } }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let unit = PrimitiveClassBinder().bind(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot), snapshot).typeUnit
        let entry = unit.functionUnits().firstOrNull((function) => function.constructorFunction)
        let call = entry.constructorPlan.initializationCalls().last
        let helper = unit.functionUnits().firstOrNull((function) => function.identity.value == call.target.identity.declaration.value)
        expect(helper.parameterValues().first.semanticType.value()).toBe(SemanticTypes.stringType().value())
        expect(helper.parameterValues().first.identity.declaration.value).toBe(helper.identity.value)
        expect(helper.parameterValues().first.identity.value == entry.parameterValues().first.identity.value).toBe(false)
        let statements = helper.statements()
        Object externalSource = statements.first
        BoundExternalStatement external = (BoundExternalStatement)externalSource
        let segment = external.segmentValues().firstOrNull((value) => value.value != null)
        Object referenceSource = segment.value
        BoundReferenceExpression reference = (BoundReferenceExpression)referenceSource
        expect(reference.symbolIdentity.value).toBe(helper.parameterValues().first.identity.value)
        expect(external.segmentValues().first.text.contains("consume(")).toBe(true)
    }

    async test `constructor plans reject cycles and receiver use before base`() {
        let sources = [
            "class Cycle { public construct() { this(1); } public construct(Int value) { this(); } }",
            "class Unsafe { visible Int value; public construct() { this(this.value); } public construct(Int value) {} }"
