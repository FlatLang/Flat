package flat/semantic/binding/primitive

import flat/compiler/models
import flat/parser/flat
import flat/lexer/Lexer
import flat/bound
import flat/semantic/types

testable class {
    async test `derived delegating primary publishes one checked allocation path`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:derived-this-initialization"), "one")
        let parentStream = Lexer().lex("class Object { public construct() {} }")
        parentStream.emit("start")
        let parent = PrimitiveClassParser().parse(parentStream.consumeAll<Token>("data"), snapshot)
        let childStream = Lexer().lex("class Buffer extends Object { visible Int count; public construct() { this(0); } public construct(Int size, Int capacity = size) { count = capacity; } }")
        childStream.emit("start")
        let child = PrimitiveClassParser().parse(childStream.consumeAll<Token>("data"), snapshot, 100)
        let bound = PrimitiveInheritanceBinder().bind(parent, child, snapshot).childType
        let constructors = bound.functionUnits().filter((function) => function.constructorFunction)
        expect(constructors.count).toBe(2)
        // Allocation must carry a checked terminal parent path, not infer super().
        // Proposed normalization removes same-owner delegation from this entry.
        expect(constructors.first.parentConstructorCall == null).toBe(true)
        expect(constructors.first.constructorDelegation == null).toBe(true)
        let plan = constructors.first.constructorPlan
        expect(plan != null).toBe(true)
        expect(plan.parentCall.target.ownerType.value()).toBe(bound.parentType.value())
        expect(plan.parentCall.argumentValues().count).toBe(0)
        expect(plan.delegationPath().count).toBe(2)
        expect(plan.initializationCalls().count).toBe(3)
        expect(plan.preBaseStatements().isNotEmpty).toBe(true)
        expect(constructors.first.statements().isEmpty).toBe(true)
    }

    async test `derived parent selection uses arguments rather than first overload`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:parent-overload-selection"), "one")
        let parentStream = Lexer().lex("class Parent { public construct(Int value) {} public construct(Bool value) {} }")
        parentStream.emit("start")
        let parent = PrimitiveClassParser().parse(parentStream.consumeAll<Token>("data"), snapshot)
        let childStream = Lexer().lex("class Child extends Parent { public construct() => super(true) }")
        childStream.emit("start")
        let child = PrimitiveClassParser().parse(childStream.consumeAll<Token>("data"), snapshot, 100)
        let bound = PrimitiveInheritanceBinder().bind(parent, child, snapshot).childType
        let constructor = bound.functionUnits().firstOrNull((function) => function.constructorFunction)
        expect(constructor.constructorPlan.parentCall.target.parameterTypes().first.value()).toBe(SemanticTypes.boolType().value())
        expect(constructor.constructorPlan.parentCall.argumentConversions().first.applicable).toBe(true)
    }

    async test `Array clone resolves generic inherited filter callback contract`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:Array-clone-List-filter"), "one")
        let traitStream = Lexer().lex("trait List<Type> { public filter(filterFunc(Type x, Int i, List<Type> list) -> Bool) -> List<Type> { return null; } }")
        traitStream.emit("start")
        let contract = PrimitiveInterfaceParser().parse(traitStream.consumeAll<Token>("data"), snapshot)
        let stream = Lexer().lex("class Object {} class Array<E> implements List<E> { override public filter(filterFunc(E x, Int i, Array<E> array) -> Bool) -> E[] { return null; } public clone() => filter({ true }) }")
        stream.emit("start")
        let partitions = FlatSourceTypePartitioner().partition(stream.consumeAll<Token>("data"), snapshot)
        let syntaxes = PrimitiveClassSyntax[]
        for (partition in partitions) syntaxes.add(PrimitiveClassParser().parse(partition.tokenValues(), snapshot, partition.startTokenIndex + 100))
        let contexts = [PrimitiveSourceBindingContext("flat/datastruct/list", snapshot, syntaxes, [contract])]
        let units = PrimitiveClassPartitionBinder().bindContexts(contexts).typeUnits()
        let unit = units.firstOrNull({ _.identity.name == "Array" })
        let method = unit.functionUnits().firstOrNull({ _.name == "clone" })
        Object returnSource = method.statements().first
        BoundReturnStatement returned = (BoundReturnStatement)returnSource
        Object callSource = returned.value
        BoundCallExpression call = (BoundCallExpression)callSource
        expect(call.target.name).toBe("filter")
        expect(call.target.parameterTypes().first.kind()).toBe("function")
        Object callbackSource = call.argumentValues().first
        BoundLambdaExpression callback = (BoundLambdaExpression)callbackSource
        expect(callback.parameterValues().count).toBe(3)
        expect(callback.parameterValues().first.semanticType.kind()).toBe("generic-parameter")
        expect(call.receiver.semanticType.value()).toBe(unit.semanticType.value())
    }

    async test `implicit predicate contexts retain all unused parameters across order and defaults`() {
        let predicates = ["{ true }", "{ _2 >= 0 }", "{ _ != null }"]
        for (predicate in predicates) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:predicate-context-matrix"), "one")
            let traitStream = Lexer().lex("trait List<Type> { public filter(filterFunc(Type x, Int i, List<Type> list) -> Bool) -> List<Type> { return null; } }")
            traitStream.emit("start")
            let contract = PrimitiveInterfaceParser().parse(traitStream.consumeAll<Token>("data"), snapshot)
            let stream = Lexer().lex("class Object {} class Array<E> implements List<E> { override public filter(filterFunc(E x, Int i, Array<E> array) -> Bool) -> E[] { return null; } public clone() => filter(" + predicate + ") public defaults(predicate(E x, Int i, Array<E> array) -> Bool = { true }) {} }")
            stream.emit("start")
            let partitions = FlatSourceTypePartitioner().partition(stream.consumeAll<Token>("data"), snapshot)
            let syntaxes = PrimitiveClassSyntax[]
            for (partition in partitions) syntaxes.add(PrimitiveClassParser().parse(partition.tokenValues(), snapshot, partition.startTokenIndex + 100))
            for (mode in 0..2) {
                let ordered = mode == 0 ? syntaxes : syntaxes.reverse()
                let units = PrimitiveClassPartitionBinder().bindContexts([
                    PrimitiveSourceBindingContext("flat/datastruct/list", snapshot, ordered, [contract])]).typeUnits()
                let unit = units.firstOrNull({ _.identity.name == "Array" })
                let clone = unit.functionUnits().firstOrNull({ _.name == "clone" })
                Object returnSource = clone.statements().first
                BoundReturnStatement returned = (BoundReturnStatement)returnSource
                Object callSource = returned.value
                BoundCallExpression call = (BoundCallExpression)callSource
                Object callbackSource = call.argumentValues().first
                BoundLambdaExpression callback = (BoundLambdaExpression)callbackSource
                expect(callback.parameterValues().count).toBe(3)
                Object typeSource = call.target.parameterTypes().first
                FunctionSemanticType type = (FunctionSemanticType)typeSource
                var Int index
                for (parameter in callback.parameterValues()) {
                    expect(parameter.semanticType.value()).toBe(type.parameterTypes()[index].value())
                    expect(parameter.identity.ordinal).toBe(index++)
                }
                let defaults = unit.functionUnits().firstOrNull({ _.name == "defaults" })
                Object defaultSource = defaults.parameterValues().first.defaultValue
                BoundLambdaExpression defaultCallback = (BoundLambdaExpression)defaultSource
                expect(defaultCallback.parameterValues().count).toBe(3)
            }
        }
    }

    async test `explicit zero argument predicate and wrong implicit result remain invalid`() {
