    async test `Core Short retains explicitly declared Number parent constructor specialization`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:Core-Short-Number-parent"), "one")
        let stream = Lexer().lex("abstract class Number<Type> {} class Short extends Number<Short> { public construct(public Short value) {} }")
        stream.emit("start")
        let partitions = FlatSourceTypePartitioner().partition(stream.consumeAll<Token>("data"), snapshot)
        let syntaxes = PrimitiveClassSyntax[]
        for (partition in partitions) syntaxes.add(PrimitiveClassParser().parse(
            partition.tokenValues(), snapshot, partition.startTokenIndex))
        let units = PrimitiveClassPartitionBinder().bind(syntaxes, snapshot).typeUnits()
        let child = units.firstOrNull({ _.identity.name == "Short" })
        let constructor = child.functionUnits().firstOrNull({ _.constructorFunction })
        let parent = constructor.constructorPlan.parentCall
        expect(parent.target.ownerType.declarationIdentity.name).toBe("Number")
        expect(parent.target.returnType.kind()).toBe("generic-instance")
        Object instanceSource = parent.target.returnType
        GenericInstanceSemanticType instance = (GenericInstanceSemanticType)instanceSource
        expect(instance.typeArguments().first.value()).toBe(SemanticTypes.shortType().value())
        expect(parent.argumentValues().isEmpty).toBe(true)
    }

    async test `declared base arguments specialize every parent overload before checking`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:declared-base-overloads"), "one")
        let stream = Lexer().lex("class Base<T> { construct(Bool flag) {} construct(T value) {} } class Child extends Base<Int> { construct() => super(1) }")
        stream.emit("start")
        let partitions = FlatSourceTypePartitioner().partition(stream.consumeAll<Token>("data"), snapshot)
        let syntaxes = PrimitiveClassSyntax[]
        for (partition in partitions) syntaxes.add(PrimitiveClassParser().parse(
            partition.tokenValues(), snapshot, partition.startTokenIndex))
        let units = PrimitiveClassPartitionBinder().bind(syntaxes, snapshot).typeUnits()
        let child = units.firstOrNull({ _.identity.name == "Child" })
        let constructor = child.functionUnits().firstOrNull({ _.constructorFunction })
        let call = constructor.constructorPlan.parentCall
        expect(call.target.parameterTypes().first.value()).toBe(SemanticTypes.intType().value())
        expect(call.target.returnType.kind()).toBe("generic-instance")
        expect(call.target.ownerType.declarationIdentity.name).toBe("Base")
        expect(call.argumentConversions().first.applicable).toBe(true)
    }

