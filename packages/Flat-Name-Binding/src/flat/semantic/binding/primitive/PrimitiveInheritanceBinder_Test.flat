            var Bool rejected
            try { PrimitiveClassBinder().bind(syntax, snapshot) }
            catch (Exception error) { rejected = true }
            expect(rejected).toBe(true)
            index++
        }
    }

    async test `constructor plans preserve field stage and body return scopes`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:constructor-stage-order"), "one")
        let stream = Lexer().lex("class Buffer { visible Int value = 7; public construct() { this(1); value = 2; } public construct(Int count) { value = count; return; } }")
        stream.emit("start")
        let unit = PrimitiveClassBinder().bind(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot), snapshot).typeUnit
        let entry = unit.functionUnits().firstOrNull((function) => function.constructorFunction)
        let plan = entry.constructorPlan
        let calls = plan.initializationCalls()
        let path = plan.delegationPath()
        expect(calls.count).toBe(3)
        expect(calls.first.target.identity.declaration.value).toBe(plan.fieldInitializer.value)
        expect(calls[1].target.identity.declaration.value).toBe(BoundConstructorPlan.bodyInitializerIdentity(path.last).value)
        expect(calls.last.target.identity.declaration.value).toBe(BoundConstructorPlan.bodyInitializerIdentity(path.first).value)
        let fields = unit.functionUnits().firstOrNull((function) => function.identity.value == plan.fieldInitializer.value)
        expect(fields.statements().count).toBe(1)
        let terminal = unit.functionUnits().firstOrNull((function) => function.identity.value == calls[1].target.identity.declaration.value)
        expect(terminal.statements().last.unitKind()).toBe("return")
        expect(entry.statements().isEmpty).toBe(true)
        expect(plan.parentCall == null).toBe(true)
    }

    async test `retained generic default validation uses specialized nullable parameter contract`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:first-or-specialization"), "one")
        let traitStream = Lexer().lex("trait List<Type> { public firstOr(Type fallback, func(Type x, Int i, List<Type> list) -> Bool = {true}) -> Type => fallback public firstOrNull(func(Type x, Int i, List<Type> list) -> Bool = {true}) -> Type => firstOr(null, func) }")
        traitStream.emit("start")
        let contract = PrimitiveInterfaceParser().parse(traitStream.consumeAll<Token>("data"), snapshot, 100)
        let parentStream = Lexer().lex("class Object {}")
        parentStream.emit("start")
        let parent = PrimitiveClassParser().parse(parentStream.consumeAll<Token>("data"), snapshot)
        let concreteStream = Lexer().lex("class Text implements List<Char> {}")
        concreteStream.emit("start")
        let concrete = PrimitiveClassParser().parse(concreteStream.consumeAll<Token>("data"), snapshot, 300)
        let genericStream = Lexer().lex("class Array<E> implements List<E> {}")
        genericStream.emit("start")
        let generic = PrimitiveClassParser().parse(genericStream.consumeAll<Token>("data"), snapshot, 400)
        let units = PrimitiveClassPartitionBinder().bind([parent, concrete, generic], snapshot,
            interfaceSyntaxValues: [contract]).typeUnits()
        let text = units.firstOrNull((unit) => unit.identity.name == "Text")
        let first = text.functionUnits().firstOrNull((function) => function.name == "firstOr")
        expect(first.parameterValues().first.semanticType.kind()).toBe("nullable")
        expect(first.parameterValues().first.semanticType.value()).toBe(NullableSemanticType(SemanticTypes.charType()).value())
        expect(first.returnType.value()).toBe(first.parameterValues().first.semanticType.value())
        let parameters = first.parameterValues()
        let callback = (FunctionSemanticType)parameters[1].semanticType
        expect(callback.parameterTypes().first.value()).toBe(SemanticTypes.charType().value())
        expect(callback.returnType.value()).toBe(SemanticTypes.boolType().value())
        expect(parameters[1].defaultValue != null).toBe(true)
        expect(first.range.snapshot).toBe(contract.methodValues().first.range.snapshot)
        expect(first.range.startTokenIndex).toBe(contract.methodValues().first.range.startTokenIndex)
        let array = units.firstOrNull((unit) => unit.identity.name == "Array")
        let genericFirst = array.functionUnits().firstOrNull((function) => function.name == "firstOr")
        expect(genericFirst.parameterValues().first.semanticType.kind()).toBe("generic-parameter")
        expect(genericFirst.returnType.value()).toBe(genericFirst.parameterValues().first.semanticType.value())
    }

    async test `concrete override cannot borrow retained default nullable specialization`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:first-or-invalid-override"), "one")
        let parentStream = Lexer().lex("class Parent {}")
        parentStream.emit("start")
        let parent = PrimitiveClassParser().parse(parentStream.consumeAll<Token>("data"), snapshot)
        let traitStream = Lexer().lex("trait List<Type> { public firstOr(Type fallback, func(Type x) -> Bool = {true}) -> Type => fallback public firstOrNull() -> Type => firstOr(null) }")
        traitStream.emit("start")
        let contract = PrimitiveInterfaceParser().parse(traitStream.consumeAll<Token>("data"), snapshot, 100)
        let childStream = Lexer().lex("class Child extends Parent implements List<Char> { public firstOr(Int fallback, func(Char x) -> Bool = {true}) -> Int => fallback }")
        childStream.emit("start")
        let child = PrimitiveClassParser().parse(childStream.consumeAll<Token>("data"), snapshot, 300)
        var Bool rejected
        try { PrimitiveInheritanceBinder().bind(parent, child, snapshot, interfaceSyntaxValues: [contract]) }
        catch (Exception error) { rejected = error.message.contains("Invalid interface method 'firstOr'") }
        expect(rejected).toBe(true)
    }

    async test `partition publishes nested inherited defaults in edge declaration scope`() {
        let contexts = PrimitiveSourceBindingContext[]
        let sources = [
            "trait Root<V> { public retained(V value) -> V { return value; } }",
            "trait Layer<T> extends Root<List<T>> {}",
            "class List<E> { public construct() {} }",
            "class Use implements Layer<Int> {}",
            "class List<E> { public construct() {} }",
            "trait Root<V> { public wrong(V value) -> V { return value; } }"
        ]
        let namespaces = ["contracts", "edges", "edges", "app", "app", "app"]
        var Int index
        for (source in sources) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:integrated-trait:#{index}"), "one")
            let stream = Lexer().lex(source)
            stream.emit("start")
            let tokens = stream.consumeAll<Token>("data")
            if (index < 2 || index == 5) {
                let contract = PrimitiveInterfaceParser().parse(tokens, snapshot)
                let imports = PrimitiveBindingImport[]
                if (index == 1) imports.add(PrimitiveBindingImport("contracts/Root", contract.range))
                contexts.add(PrimitiveSourceBindingContext(namespaces[index], snapshot, PrimitiveClassSyntax[], [contract],
                    importValues: imports))
            } else {
                let syntax = PrimitiveClassParser().parse(tokens, snapshot)
                let imports = PrimitiveBindingImport[]
                if (index == 3) imports.add(PrimitiveBindingImport("edges/Layer", syntax.range))
                contexts.add(PrimitiveSourceBindingContext(namespaces[index], snapshot, [syntax], importValues: imports))
            }
            index++
        }
        for (mode in 0..2) {
            let units = PrimitiveClassPartitionBinder().bindContexts(mode == 0 ? contexts : contexts.reverse()).typeUnits()
            let use = units.firstOrNull((unit) => unit.identity.name == "Use")
            let retained = use.functionUnits().firstOrNull((unit) => unit.name == "retained")
            expect(retained != null).toBe(true)
            let result = (GenericInstanceSemanticType)retained.returnType
            expect(result.declarationType.declarationIdentity.syntaxIdentity.snapshot.source.value)
                .toBe("memory:integrated-trait:2")
            expect(result.typeArguments().first.value()).toBe(SemanticTypes.intType().value())
            expect(retained.parameterValues().first.semanticType.value()).toBe(result.value())
        }
    }

    async test `retained defaults substitute nested List arguments across source scopes`() {
        let resolver = l03CollectionResolver("List<T>")
        let resolved = resolver.resolve("Value")
        expect(resolved.kind()).toBe("generic-instance")
        let instance = (GenericInstanceSemanticType)resolved
        expect(instance.declarationType.declarationIdentity.name).toBe("List")
        expect(instance.declarationType.declarationIdentity.syntaxIdentity.snapshot.source.value)
            .toBe("memory:l03:edge")
        expect(instance.typeArguments().first.value()).toBe(resolver.genericParameter.value())
    }

    async test `retained default callbacks preserve names arrays and async after substitution`() {
        let resolver = l03CollectionResolver("async func(T value,List<T> values)->T[]")
        let resolved = resolver.resolve("Value")
        expect(resolved.kind()).toBe("function")
        let callback = (FunctionSemanticType)resolved
        expect(callback.asyncFunction).toBe(true)
        expect(callback.parameterNames().first).toBe("value")
        expect(callback.parameterNames().last).toBe("values")
        expect(callback.parameterTypes().first.value()).toBe(resolver.genericParameter.value())
        let listParameter = callback.parameterTypes().last
        let list = (GenericInstanceSemanticType)listParameter
        expect(list.typeArguments().first.value()).toBe(resolver.genericParameter.value())
        expect(callback.returnType.kind()).toBe("generic-instance")
        let array = (GenericInstanceSemanticType)callback.returnType
        expect(array.declarationType.declarationIdentity.name).toBe("Array")
        expect(array.typeArguments().first.value()).toBe(resolver.genericParameter.value())
    }

    async test `native storage keeps its outer array apart from substituted collection elements`() {
        let resolver = l03CollectionResolver("List<T>", "Int")
        let resolved = resolver.resolveNativeArrayStorage("Value[]")
        expect(resolved.kind()).toBe("array")
        let storage = (ArraySemanticType)resolved
        expect(storage.elementType.kind()).toBe("generic-instance")
        let list = (GenericInstanceSemanticType)storage.elementType
        expect(list.typeArguments().first.value()).toBe(SemanticTypes.intType().value())
        let ordinary = resolver.resolve("Value[]")
        expect(ordinary.kind()).toBe("generic-instance")
        let array = (GenericInstanceSemanticType)ordinary
        expect(array.declarationType.declarationIdentity.name).toBe("Array")
        expect(array.typeArguments().first.value()).toBe(storage.elementType.value())
    }

    async test `rejects invalid inherited edge arity`() {
        PrimitiveStructuralTypeResolver resolver = l03CollectionResolver("List<T>", "Int,Int")
        var String message
        try {
            resolver.resolve("Value")
        } catch (Exception error) { message = error.message }
        expect(message).toBe("Trait implementation generic arity mismatch")
    }

    async test `retained parameter shadowing`() {
        PrimitiveStructuralTypeResolver inherited = l03CollectionResolver("List<T>")
        let parameter = GenericParameterSemanticType(
            inherited.receiverType.declarationIdentity, "Value", 1)
        let resolver = PrimitiveStructuralTypeResolver(
            syntaxes: inherited.syntaxes, genericParameter: inherited.genericParameter,
            receiverType: inherited.receiverType, methodGenericParameters: [parameter],
            interfaces: inherited.interfaces, implementationOwner: inherited.implementationOwner,
            implementationRange: inherited.implementationRange,
            declarationContext: inherited.declarationContext)
        expect(resolver.resolve("Value").value()).toBe(parameter.value())
    }

    /** Separate source scopes intentionally contain two unrelated List declarations. */
    async l03CollectionResolver(String edgeType, String classArgument = "E") -> PrimitiveStructuralTypeResolver {
        let contractSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:l03:contract"), "one")
        let edgeSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:l03:edge"), "one")
        let ownerSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:l03:owner"), "one")
        let contractStream = Lexer().lex("trait ValueSource<Value> { public retained() -> Value { return null; } }")
        contractStream.emit("start")
        let contract = PrimitiveInterfaceParser().parse(contractStream.consumeAll<Token>("data"), contractSnapshot)
        let layerStream = Lexer().lex("trait Layer<T> { }")
        layerStream.emit("start")
        let parsedLayer = PrimitiveInterfaceParser().parse(layerStream.consumeAll<Token>("data"), edgeSnapshot)
        let layer = PrimitiveInterfaceSyntax(parsedLayer.range, parsedLayer.name,
            parsedLayer.genericParameterName, parsedLayer.methodValues(),
            genericParameters: parsedLayer.genericParameterNames(),
            parentTypes: ["contracts/ValueSource<#{edgeType}>"])
        let listStream = Lexer().lex("trait List<Element> { }")
        listStream.emit("start")
        let list = PrimitiveInterfaceParser().parse(listStream.consumeAll<Token>("data"), edgeSnapshot, 100)
        let arrayStream = Lexer().lex("class Array<Element> { }")
        arrayStream.emit("start")
        let array = PrimitiveClassParser().parse(arrayStream.consumeAll<Token>("data"), edgeSnapshot, 200)
        let ownerStream = Lexer().lex("class Use<E> implements Layer<#{classArgument}> { }")
        ownerStream.emit("start")
        let owner = PrimitiveClassParser().parse(ownerStream.consumeAll<Token>("data"), ownerSnapshot)
        let shadowStream = Lexer().lex("class List { }")
        shadowStream.emit("start")
        let shadow = PrimitiveClassParser().parse(shadowStream.consumeAll<Token>("data"), ownerSnapshot, 100)
        let contractSource = PrimitiveSourceBindingContext("contracts", contractSnapshot,
            PrimitiveClassSyntax[], [contract])
        let edgeSource = PrimitiveSourceBindingContext("edge", edgeSnapshot, [array], [layer, list])
        let ownerSource = PrimitiveSourceBindingContext("consumer", ownerSnapshot, [owner, shadow],
            defaultImports: [PrimitiveDefaultImport("edge/Layer"), PrimitiveDefaultImport("edge/Array")])
        let scope = PrimitiveResolvedDeclarationContext(ownerSource, [ownerSource, edgeSource, contractSource])
        let identity = scope.classIdentity(owner)
        return PrimitiveStructuralTypeResolver(
            syntaxes: [owner, array, shadow], genericParameter: GenericParameterSemanticType(identity, "E", 0),
            receiverType: UserClassSemanticType(identity), interfaces: [contract, layer, list],
            implementationOwner: owner, implementationRange: contract.methodValues().first.range,
            declarationContext: scope)
    }
    async test `inherited fields do not shadow constructor or method parameters`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:inherited-parameter-shadow"), "one")
        let source = "class Parent { visible Int value; construct(Int value) { this.value = value; } } " +
            "class Child extends Parent { construct(Int value) => super(value) " +
            "public parameter(Int value) -> Int { return value; } " +
            "public inherited() -> Int { return value; } " +
            "public explicit(Int value) -> Int { return this.value; } }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let partitions = FlatSourceTypePartitioner().partition(stream.consumeAll<Token>("data"), snapshot)
        let parent = PrimitiveClassParser().parse(partitions.first.tokenValues(), snapshot, partitions.first.startTokenIndex)
        let child = PrimitiveClassParser().parse(partitions.last.tokenValues(), snapshot, partitions.last.startTokenIndex)
        let result = PrimitiveInheritanceBinder().bind(parent, child, snapshot)
        let constructor = result.childType.functionUnits().firstOrNull({ _.constructorFunction })
        let parentArgumentValue = constructor.constructorPlan.parentCall.argumentValues().first
        let parentArgument = (BoundReferenceExpression)parentArgumentValue
        expect(parentArgument.symbolIdentity.value).toBe(constructor.parameterValues().first.identity.value)
        let method = result.childType.functionUnits().firstOrNull({ _.name == "parameter" })
        let returnStatement = method.statements().first
        let returned = (BoundReturnStatement)returnStatement
        let reference = (BoundReferenceExpression)returned.value
        expect(reference.symbolIdentity.value).toBe(method.parameterValues().first.identity.value)
        let inherited = result.childType.functionUnits().firstOrNull({ _.name == "inherited" })
        let inheritedStatement = inherited.statements().first
        let inheritedReturn = (BoundReturnStatement)inheritedStatement
        let field = result.parentType.fieldUnits().first
        let inheritedReference = (BoundReferenceExpression)inheritedReturn.value
        expect(inheritedReference.symbolIdentity.value).toBe(field.identity.value)
        let explicit = result.childType.functionUnits().firstOrNull({ _.name == "explicit" })
        let explicitStatement = explicit.statements().first
        let explicitReturn = (BoundReturnStatement)explicitStatement
        let access = (BoundMemberAccessExpression)explicitReturn.value
        expect(access.memberIdentity.value).toBe(field.identity.value)
    }

    test `binds sealed parent child component and shared virtual slot`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:inheritance-bind"), "revision:one"
        )
        let parent = PrimitiveClassParser().parse(typeTokens("Parent", null, "1"), snapshot)
        let child = PrimitiveClassParser().parse(typeTokens("Child", "Parent", "2"), snapshot)
        let result = PrimitiveInheritanceBinder().bind(parent, child, snapshot)
        let parentMethod = result.parentType.functionUnits().last
        let childMethod = result.childType.functionUnits().last
        expect(result.childType.parentType.value()).toBe(result.parentType.semanticType.value())
        expect(childMethod.dispatchIdentity).toBe(parentMethod.dispatchIdentity)
    }

    test `binds parent constructor arguments with explicit conversion evidence`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:inheritance-constructor"), "revision:one"
        )
        let parent = PrimitiveClassParser().parse(parentWithConstructor("Parent"), snapshot)
        let child = PrimitiveClassParser().parse(childWithDelegation("Child", "Parent"), snapshot)
        let result = PrimitiveInheritanceBinder().bind(parent, child, snapshot)
        let constructor = result.childType.functionUnits().first
        let parentCall = constructor.constructorPlan.parentCall

        expect(parentCall).toNotBe(null)
        expect(parentCall.target.ownerType.value()).toBe(result.parentType.semanticType.value())
        expect(parentCall.argumentValues().count).toBe(1)
        expect(parentCall.argumentValues().first.semanticType.value()).toBe("builtin:String")
        expect(parentCall.argumentConversions().first.conversionKind).toBe("identity")
    }

    test `inherits explicit parent return for an inferred override`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:inheritance-inferred-return"), "revision:one"
        )
        let parent = PrimitiveClassParser().parse([
            token("class", false), token("Parent", false), token("{", true),
            token("value", false), token("(", true), token(")", true),
            token("->", true), token("String", false), token("=>", true),
            token("\"parent\"", false, Token.Type.STRING), token("}", true)
        ], snapshot)
        let child = PrimitiveClassParser().parse([
            token("class", false), token("Child", false), token("extends", false),
            token("Parent", false), token("{", true), token("value", false),
            token("(", true), token(")", true), token("=>", true),
            token("\"child\"", false, Token.Type.STRING), token("}", true)
        ], snapshot)
        let result = PrimitiveInheritanceBinder().bind(parent, child, snapshot)
        let parentMethod = result.parentType.functionUnits().last
        let childMethod = result.childType.functionUnits().last

        expect(childMethod.returnType.value()).toBe("builtin:String")
        expect(childMethod.dispatchIdentity).toBe(parentMethod.dispatchIdentity)
    }

    test `refines inferred numeric override to parent contract`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:inheritance-numeric-return"), "revision:one"
        )
        let parent = PrimitiveClassParser().parse([
            token("abstract", false), token("class", false), token("Parent", false),
            token("{", true), token("public", false), token("abstract", false),
            token("value", false), token("(", true), token(")", true),
            token("->", true), token("Double", false), token("}", true)
        ], snapshot)
        let child = PrimitiveClassParser().parse([
            token("class", false), token("Child", false), token("extends", false),
            token("Parent", false), token("{", true), token("value", false),
            token("(", true), token(")", true), token("=>", true),
            token("1", false, Token.Type.INTEGER), token("}", true)
        ], snapshot)
        let result = PrimitiveInheritanceBinder().bind(parent, child, snapshot)
        let method = result.childType.functionUnits().last

        expect(method.returnType.value()).toBe("primitive:Double")
    }

    async test `refines inferred switch override to parent contract`() {
        let source = "abstract class Parent { public abstract check(Char value) -> Bool } " +
            "class Child extends Parent { check(Char value) => false { " +
            "switch value { ' ' => fallthrough '\\n' => return true } } }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let tokens = stream.consumeAll<Token>("data")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:inheritance-switch-return"), "revision:one"
        )
        let partitions = FlatSourceTypePartitioner().partition(tokens, snapshot)
        let parent = PrimitiveClassParser().parse(
            partitions.first.tokenValues(), snapshot, partitions.first.startTokenIndex
        )
        let child = PrimitiveClassParser().parse(
            partitions.last.tokenValues(), snapshot, partitions.last.startTokenIndex
        )
        let result = PrimitiveInheritanceBinder().bind(parent, child, snapshot)
        let method = result.childType.functionUnits().last

        expect(method.returnType.value()).toBe("primitive:Bool")
    }

    test `keeps static overload separate from parent instance method`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:inheritance-static-overload"), "revision:one"
        )
        let parent = PrimitiveClassParser().parse(typeTokens("Parent", null, "1"), snapshot)
        let child = PrimitiveClassParser().parse([
            token("class", false), token("Child", false), token("extends", false),
            token("Parent", false), token("{", true), token("public", false),
            token("static", false), token("value", false), token("(", true),
            token("Int", false), token("input", false), token(")", true),
            token("=>", true), token("input", false), token("}", true)
        ], snapshot)
        let result = PrimitiveInheritanceBinder().bind(parent, child, snapshot)
        let method = result.childType.functionUnits().last

        expect(method.staticFunction).toBe(true)
        expect(method.returnType.value()).toBe("primitive:Int")
        expect(method.dispatchIdentity).toBe(null)
    }

    async test `rejects mismatched callback signature on implemented trait`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:callback-signature"), "one")
        let parentStream = Lexer().lex("class Parent {}")
        parentStream.emit("start")
        let parent = PrimitiveClassParser().parse(parentStream.consumeAll<Token>("data"), snapshot)
        let childStream = Lexer().lex("class Child extends Parent implements Contract { any(anyFunc(Bool x) -> Bool) -> Bool { return false; } }")
        childStream.emit("start")
        let child = PrimitiveClassParser().parse(childStream.consumeAll<Token>("data"), snapshot)
        let contractStream = Lexer().lex("trait Contract { any(anyFunc(Int x) -> Bool) -> Bool }")
        contractStream.emit("start")
        let contract = PrimitiveInterfaceParser().parse(contractStream.consumeAll<Token>("data"), snapshot)
        var Bool rejected
        try {
            PrimitiveInheritanceBinder().bind(parent, child, snapshot,
                interfaceSyntaxValues: [contract])
        } catch (Exception error) { rejected = error.message.contains("Invalid interface method 'any'") }
        expect(rejected).toBe(true)
    }

    test `preserves inheritance metadata`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:inheritance-interface-metadata"), "revision:one"
        )
        let parent = PrimitiveClassParser().parse(typeTokens("Parent", null, "1"), snapshot)
        let child = PrimitiveClassParser().parse([
            token("class", false), token("Child", false), token("extends", false),
            token("Parent", false), token("implements", false), token("Marker", false),
            token("{", true), token("extra", false), token("(", true), token(")", true),
            token("->", true), token("Int", false), token("=>", true),
            token("2", false, Token.Type.INTEGER), token("}", true)
        ], snapshot)
        let result = PrimitiveInheritanceBinder().bind(parent, child, snapshot)
        let implemented = result.childType.metadata().firstOrNull({
            _.metadataKind == "implements"
        })

        expect(implemented.value).toBe("Marker")
    }

    test `rejects parent constructor arity and type mismatch`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:inheritance-constructor-invalid"), "revision:one"
        )
        let parent = PrimitiveClassParser().parse(parentWithConstructor("Parent"), snapshot)
        var Int rejected
        try {
            let child = PrimitiveClassParser().parse(
                childWithDelegation("Missing", "Parent", false), snapshot
            )
            PrimitiveInheritanceBinder().bind(parent, child, snapshot)
        } catch (Exception error) { rejected++ }
        try {
            let child = PrimitiveClassParser().parse([
                token("class", false), token("Wrong", false), token("extends", false),
                token("Parent", false), token("{", true), token("construct", false),
                token("(", true), token("Int", false), token("value", false), token(")", true),
                token("=>", true), token("super", false), token("(", true),
                token("value", false), token(")", true), token("}", true)
            ], snapshot)
            PrimitiveInheritanceBinder().bind(parent, child, snapshot)
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
    }

    test `rejects missing parent and invalid override`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:inheritance-invalid"), "revision:one"
        )
        var Int rejected
        try {
            let parent = PrimitiveClassParser().parse(typeTokens("Parent", null, "1"), snapshot)
            let child = PrimitiveClassParser().parse(typeTokens("Child", "Missing", "2"), snapshot)
            PrimitiveInheritanceBinder().bind(parent, child, snapshot)
        } catch (Exception error) { rejected++ }
        try {
            let parent = PrimitiveClassParser().parse(typeTokens("Parent", null, "1"), snapshot)
            let child = PrimitiveClassParser().parse(typeTokens("Child", "Parent", "true"), snapshot)
            PrimitiveInheritanceBinder().bind(parent, child, snapshot)
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
    }

    parentWithConstructor(String name) -> Token[] {
        return [
            token("class", false), token(name, false), token("{", true),
            token("construct", false), token("(", true), token("String", false),
            token("message", false), token(")", true), token("{", true), token("}", true),
            token("}", true)
        ]
    }

    childWithDelegation(
        String name,
        String parent,
        Bool includeArgument = true
    ) -> Token[] {
        let values = [
            token("class", false), token(name, false), token("extends", false),
            token(parent, false), token("{", true), token("construct", false),
            token("(", true), token("String", false), token("message", false),
            token(")", true), token("=>", true), token("super", false), token("(", true)
        ]
        if (includeArgument) values.add(token("message", false))
        values.addAll([token(")", true), token("}", true)])
        return values
    }

    typeTokens(String name, String parent, String returned) -> Token[] {
        let values = [token("class", false), token(name, false)]
        if (parent) values.addAll([token("extends", false), token(parent, false)])
        values.addAll([
            token("{", true), token("constructor", false), token("(", true), token(")", true),
            token("{", true), token("}", true), token("value", false), token("(", true),
            token(")", true), token("->", true), token(returned == "true" ? "Bool" : "Int", false),
            token("{", true), token("return", false),
            token(returned, false, returned == "true" ? Token.Type.BOOL : Token.Type.INTEGER),
            token(";", true), token("}", true), token("}", true)
        ])
        return values
    }

    token(String value, Bool symbol, Int type = Token.Type.IDENTIFIER) -> Token {
        return Token(value: value, type: symbol ? Token.Type.SYMBOL : type,
            location: Location(lineNumber: 1, column: 1))
    }
}
