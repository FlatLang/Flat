    async test `static native interpolation reads other declared receiver field with source identity`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:Function-callStatic-path"), "one")
        var String source = "class Class { construct(visible native Object jsClass) {} } class Function { public static callStatic(Class c) { external { consume("
        source += '#'
        source += "{c.jsClass}); } } }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let partitions = FlatSourceTypePartitioner().partition(stream.consumeAll<Token>("data"), snapshot)
        let syntaxes = PrimitiveClassSyntax[]
        for (partition in partitions) syntaxes.add(PrimitiveClassParser().parse(partition.tokenValues(), snapshot, partition.startTokenIndex))
        let units = PrimitiveClassPartitionBinder().bind(syntaxes, snapshot).typeUnits()
        let owner = units.firstOrNull({ _.identity.name == "Class" })
        let unit = units.firstOrNull({ _.identity.name == "Function" })
        let method = unit.functionUnits().firstOrNull({ _.name == "callStatic" })
        Object externalSource = method.statements().first
        BoundExternalStatement external = (BoundExternalStatement)externalSource
        Object accessSource = external.segmentValues().firstOrNull({ _.value != null }).value
        BoundMemberAccessExpression access = (BoundMemberAccessExpression)accessSource
        expect(access.memberIdentity.value).toBe(owner.fieldUnits().first.identity.value)
        expect(access.semanticType.value()).toBe(owner.fieldUnits().first.semanticType.value())
        expect(owner.fieldUnits().first.canonicalOwner().value).toBe(owner.identity.value)
        expect(access.range.snapshot).toBe(snapshot)
    }

    async test `Function call default constructor uses declared Object array context`() {
        let sources = [
            "class Array<E> { construct() {} } class Function { call(Object obj, Object[] args = Array()) -> Object { return obj; } }",
            "class Array<E> { construct() {} } class Function { call(Object obj, Object[] args = Array<Object>()) -> Object { return obj; } }",
            "class Array<E> { construct() {} } class Function { call<T>(T obj, T[] args = Array()) -> T { return obj; } }"
        ]
        for (source in sources) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:Function-default-array"), "one")
            let stream = Lexer().lex(source)
            stream.emit("start")
            let partitions = FlatSourceTypePartitioner().partition(stream.consumeAll<Token>("data"), snapshot)
            let syntaxes = PrimitiveClassSyntax[]
            for (partition in partitions) syntaxes.add(PrimitiveClassParser().parse(
                partition.tokenValues(), snapshot, partition.startTokenIndex))
            let unit = PrimitiveClassPartitionBinder().bind(syntaxes, snapshot).typeUnits().last
            let method = unit.functionUnits().firstOrNull({ _.name == "call" })
            let parameter = method.parameterValues().last
            expect(parameter.defaultValue != null).toBe(true)
            expect(parameter.defaultValue.semanticType.value()).toBe(parameter.semanticType.value())
            Object callSource = parameter.defaultValue
            BoundCallExpression call = (BoundCallExpression)callSource
            expect(call.target.ownerType.declarationIdentity.name).toBe("Array")
            expect(call.target.returnType.value()).toBe(parameter.semanticType.value())
            expect(call.argumentValues().isEmpty).toBe(true)
            expect(parameter.semanticType.kind()).toBe("generic-instance")
            Object instanceSource = parameter.semanticType
            GenericInstanceSemanticType instance = (GenericInstanceSemanticType)instanceSource
            expect(instance.typeArguments().first.value()).toBe(method.returnType.value())
        }
    }

