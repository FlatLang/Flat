package flat/semantic/binding/primitive

import flat/compiler/models
import flat/parser/flat
import flat/bound
import flat/semantic/types

/** Focused binding coverage for selected opaque statements and interpolation. */
testable class PrimitiveOpaqueCodeBinder_Test {
    test `resolves declared member interpolation`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:external-member"), "one")
        let owner = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "class", 0), "class", "Box")
        let type = UserClassSemanticType(owner)
        let method = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "method", 1), "instance-method", "add")
        let signature = CallableSignature(SymbolIdentity(method, "instance-method"), "add",
            CallableKind("instance-method"), [SemanticTypes.intType()], SemanticTypes.intType(), type)
        let local = LocalBinding("box", SymbolIdentity(owner, "local"), type)
        var String code = "return "
        code += '#'
        code += "{box.add(42)};"
        let syntax = PrimitiveControlStatementParser().parse([
            token("external", Token.Type.IDENTIFIER, 1), token("{", Token.Type.SYMBOL, 10),
            token(code, Token.Type.CODE, 12), token("}", Token.Type.SYMBOL, 40)
        ], snapshot)
        let bound = PrimitiveControlStatementBinder().bind(syntax, snapshot, [local], [signature]).statements()
        let object = (Object)bound.first
        let statement = (BoundExternalStatement)object
        let segments = statement.segmentValues()
        let expressionObject = (Object)segments[1].value
        let call = (BoundCallExpression)expressionObject
        expect(call.target.identity.value).toBe(signature.identity.value)
    }

    test `preserves callback await suppression evidence`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:suppress-await"), "one")
        let declaration = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "method", 0), "static-method", "apply"
        )
        let parameter = LocalBinding("callback", SymbolIdentity(declaration, "parameter"),
            FunctionSemanticType([SemanticTypes.intType()], SemanticTypes.intType(), true))
        var String code = "return "
        code += '#'
        code += "{callback(1)$};"
        let syntax = PrimitiveControlStatementParser().parse([
            token("external", Token.Type.IDENTIFIER, 1), token("{", Token.Type.SYMBOL, 10),
            token(code, Token.Type.CODE, 12), token("}", Token.Type.SYMBOL, 40)
        ], snapshot)
        let bound = PrimitiveControlStatementBinder().bind(syntax, snapshot, [parameter]).statements()
        let object = (Object)bound.first
        let statement = (BoundExternalStatement)object
        let segments = statement.segmentValues()
        let expressionObject = (Object)segments[1].value
        let invocation = (BoundFunctionInvocationExpression)expressionObject
        expect(invocation.suppressAwait).toBe(true)
    }

    test `binds selected target and preserves literal source evidence`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:external-bind"), "revision:one"
        )
        let syntax = parse(snapshot, "code")
        let bound = PrimitiveControlStatementBinder().bind(syntax, snapshot).statements()
        let object = (Object)bound.first
        let value = (BoundExternalStatement)object

        expect(value.target).toBe("es6")
        expect(value.segmentValues().first.text).toBe("code")
        expect(value.range.snapshot).toBe(snapshot)
    }

    test `binds opaque parameter names`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:external-bind-parameter-name"), "revision:one"
        )
        let declaration = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "method", 0), "static-method", "sqrt"
        )
        let parameter = LocalBinding(
            "number", SymbolIdentity(declaration, "parameter"), SemanticTypes.doubleType()
        )
        let bound = PrimitiveControlStatementBinder().bind(
            parse(snapshot, "return Math.sqrt(number);"), snapshot, [parameter]
        ).statements()
        let statementObject = (Object)bound.first
        let statement = (BoundExternalStatement)statementObject
        let bindings = statement.nameBindingValues()
        let binding = bindings.first

        expect(binding.sourceName).toBe("number")
        expect(binding.value.symbolIdentity).toBe(parameter.identity)
    }

    test `binds string data interpolation to typed reference evidence`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:external-bind-interpolation"), "revision:one"
        )
        var String code = ""
        code += "Error("
        code += '#'
        code += "{message.chars.data})"
        let declaration = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "constructor", 0), "constructor", "Owner"
        )
        let local = LocalBinding(
            "message", SymbolIdentity(declaration, "parameter"), SemanticTypes.stringType()
        )
        let range = SourceRange(
            snapshot, 0, 5,
            Location(lineNumber: 1, column: 1),
            Location(lineNumber: 1, column: code.count + 20)
        )
        let syntaxSegments = PrimitiveExternalCodeSegmentSyntax[]
        syntaxSegments.add(PrimitiveExternalCodeSegmentSyntax(range, "Error(", String[]))
        syntaxSegments.add(PrimitiveExternalCodeSegmentSyntax(
            range, "", ["message", "chars", "data"]
        ))
        syntaxSegments.add(PrimitiveExternalCodeSegmentSyntax(range, ")", String[]))
        let syntax = result(syntaxSegments, range, code, "js")
        let bound = PrimitiveControlStatementBinder().bind(
            syntax, snapshot, [local]
        ).statements()
        let object = (Object)bound.first
        let statement = (BoundExternalStatement)object
        let segments = statement.segmentValues()

        expect(segments.count).toBe(3)
        expect(segments[1].value.semanticType.value()).toBe("builtin:String")
        expect(segments[1].rendering).toBe("es6-native-string")
        expect(((BoundReferenceExpression)segments[1].value).symbolIdentity).toBe(local.identity)
    }

    test `binds native array data expression interpolation`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:external-native-array-projection"), "revision:one"
        )
        let declaration = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "constructor", 0), "constructor", "Owner"
        )
        let local = LocalBinding(
            "data", SymbolIdentity(declaration, "parameter"),
            ArraySemanticType(SemanticTypes.charType())
        )
        let range = SourceRange(
            snapshot, 0, 4,
            Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 5)
        )
        var String code = ""
        code += '#'
        code += "{data.data}"
        let syntax = result([
            PrimitiveExternalCodeSegmentSyntax(
                range, "", String[], PrimitiveMemberAccessSyntax(
                    range, PrimitiveReferenceSyntax(range, "data"), "data"
                )
            )
        ], range, code, "js")
        let bound = PrimitiveControlStatementBinder().bind(
            syntax, snapshot, [local]
        ).statements()
        let object = (Object)bound.first
        let statement = (BoundExternalStatement)object

        expect(statement.segmentValues().first.value.expressionKind())
            .toBe("native-array-data")
    }

    test `binds native array path interpolation`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:external-native-array-path"), "revision:one"
        )
        let declaration = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "constructor", 0), "constructor", "Owner"
        )
        let local = LocalBinding(
            "data", SymbolIdentity(declaration, "parameter"),
            ArraySemanticType(SemanticTypes.charType())
        )
        let range = SourceRange(
            snapshot, 0, 2,
            Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 3)
        )
        let bound = PrimitiveControlStatementBinder().bind(
            result([
                PrimitiveExternalCodeSegmentSyntax(range, "", ["data", "data"]),
                PrimitiveExternalCodeSegmentSyntax(range, "", ["data", "count"])
            ], range, "native array paths", "js"),
            snapshot, [local]
        ).statements()
        let object = (Object)bound.first
        let statement = (BoundExternalStatement)object

        expect(statement.segmentValues().first.value.expressionKind())
            .toBe("native-array-data")
        expect(statement.segmentValues().last.value.expressionKind())
            .toBe("array-length")
    }

    test `binds parameter field path interpolation`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:external-parameter-field"), "revision:one"
        )
        let owner = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", 0), "class", "Owner"
        )
        let range = SourceRange(
            snapshot, 0, 2,
            Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 3)
        )
        let type = UserClassSemanticType(owner)
        let receiver = BoundReferenceExpression(
            range, type, "this", SymbolIdentity(owner, "receiver")
        )
        let field = BoundFieldUnit(
            "data", SymbolIdentity(owner, "field"),
            ArraySemanticType(SemanticTypes.charType()), range
        )
        let parameter = LocalBinding(
            "other", SymbolIdentity(owner, "parameter"), type
        )
        let syntax = result([
            PrimitiveExternalCodeSegmentSyntax(range, "", ["other", "data"])
        ], range, "parameter field", "js")
        let bound = PrimitiveControlStatementBinder().bind(
            syntax, snapshot, [parameter], receiver: receiver, fields: [field]
        ).statements()
        let statementObject = (Object)bound.first
        let statement = (BoundExternalStatement)statementObject
        let segments = statement.segmentValues()
        let selectedObject = (Object)segments.first.value
        let selected = (BoundMemberAccessExpression)selectedObject

        expect(selected.receiver.expressionKind()).toBe("reference")
        expect(selected.memberName).toBe("data")
        expect(selected.memberIdentity).toBe(field.identity)
    }

    test `binds parameter nested array data path interpolation`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:external-parameter-nested-array"), "revision:one"
        )
        let owner = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", 0), "class", "Owner"
        )
        let range = SourceRange(
            snapshot, 0, 2,
            Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 3)
        )
        let type = UserClassSemanticType(owner)
        let field = BoundFieldUnit(
            "chars", SymbolIdentity(owner, "field"),
            ArraySemanticType(SemanticTypes.charType()), range
        )
        let parameter = LocalBinding(
            "other", SymbolIdentity(owner, "parameter"), type
        )
        let bound = PrimitiveControlStatementBinder().bind(
            result([
                PrimitiveExternalCodeSegmentSyntax(
                    range, "", ["other", "chars", "data"]
                )
            ], range, "parameter nested field", "js"),
            snapshot, [parameter], fields: [field]
        ).statements()
        let object = (Object)bound.first
        let statement = (BoundExternalStatement)object

        expect(statement.segmentValues().first.value.expressionKind())
            .toBe("native-array-data")
    }

    test `binds canonical owner fields through nested opaque paths`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:external-canonical-owner-fields"), "revision:one"
        )
        let stringIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", 0), "class", "String"
        )
        let charsIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", 10), "class", "StringCharArray"
        )
        let range = SourceRange(
            snapshot, 0, 2,
            Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 3)
        )
        let stringType = UserClassSemanticType(stringIdentity)
        let charsType = UserClassSemanticType(charsIdentity)
        let chars = BoundFieldUnit(
            "chars", SymbolIdentity(stringIdentity, "field"), charsType, range
        )
        let data = BoundFieldUnit(
            "data", SymbolIdentity(charsIdentity, "field"),
            ArraySemanticType(SemanticTypes.charType()), range
        )
        let receiver = BoundReferenceExpression(
            range, stringType, "this", SymbolIdentity(stringIdentity, "receiver")
        )
        let other = LocalBinding(
            "other", SymbolIdentity(stringIdentity, "parameter"), stringType
        )
        let bound = PrimitiveControlStatementBinder().bind(
            result([
                PrimitiveExternalCodeSegmentSyntax(
                    range, "", ["chars", "data"]
                ),
                PrimitiveExternalCodeSegmentSyntax(
                    range, "", ["other", "chars", "data"]
                )
            ], range, "canonical owner fields", "js"),
            snapshot, [other], receiver: receiver, fields: [chars],
            availableFields: [chars, data]
        ).statements()
        let statementObject = (Object)bound.first
        let statement = (BoundExternalStatement)statementObject
        let segments = statement.segmentValues()
        let directObject = (Object)segments.first.value
        let direct = (BoundMemberAccessExpression)directObject
        let nestedObject = (Object)segments.last.value
        let nested = (BoundMemberAccessExpression)nestedObject
        let nestedReceiverObject = (Object)nested.receiver
        let nestedReceiver = (BoundMemberAccessExpression)nestedReceiverObject

        expect(direct.memberIdentity).toBe(data.identity)
        expect(direct.receiver.expressionKind()).toBe("member-access")
        expect(nested.memberIdentity).toBe(data.identity)
        expect(nestedReceiver.memberIdentity).toBe(chars.identity)
        expect(nested.range.snapshot).toBe(snapshot)
    }

    test `binds explicit receiver field interpolation`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:external-receiver-field"), "revision:one"
        )
        let owner = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", 0), "class", "Owner"
        )
        let range = SourceRange(
            snapshot, 0, 2,
            Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 3)
        )
        let receiver = BoundReferenceExpression(
            range, UserClassSemanticType(owner), "this", SymbolIdentity(owner, "receiver")
        )
        let field = BoundFieldUnit(
            "data", SymbolIdentity(owner, "field"),
            ArraySemanticType(SemanticTypes.charType()), range
        )
        let syntax = result([
            PrimitiveExternalCodeSegmentSyntax(range, "", ["this", "data"])
        ], range, "receiver field", "js")
        let bound = PrimitiveControlStatementBinder().bind(
            syntax, snapshot, receiver: receiver, fields: [field]
        ).statements()
        let object = (Object)bound.first
        let statement = (BoundExternalStatement)object

        expect(statement.segmentValues().first.value.expressionKind())
            .toBe("member-access")
    }

    test `rejects mismatched target unknown root and unsupported projection`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:external-bind-invalid"), "revision:one"
        )
        let declaration = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "constructor", 0), "constructor", "Owner"
        )
        let local = LocalBinding(
            "message", SymbolIdentity(declaration, "parameter"), SemanticTypes.stringType()
        )
        var Int rejected
        try { PrimitiveControlStatementBinder().bind(parse(snapshot, "code", "c"), snapshot) }
        catch (Exception error) { rejected++ }
        var String unknown = ""
        unknown += '#'
        unknown += "{missing.chars.data}"
        try { PrimitiveControlStatementBinder().bind(parse(snapshot, unknown), snapshot, [local]) }
        catch (Exception error) { rejected++ }
        var String unsupported = ""
        unsupported += '#'
        unsupported += "{message.length}"
        try { PrimitiveControlStatementBinder().bind(parse(snapshot, unsupported), snapshot, [local]) }
        catch (Exception error) { rejected++ }
        expect(rejected).toBe(3)
    }

    result(
        PrimitiveExternalCodeSegmentSyntax[] segments,
        SourceRange range,
        String code,
        String target
    ) -> PrimitiveStatementSyntaxResult => PrimitiveStatementSyntaxResult([
        PrimitiveExternalStatementSyntax(range, target, code, segments)
    ])

    parse(
        SourceSnapshotIdentity snapshot,
        String code,
        String target = "js"
    ) -> PrimitiveStatementSyntaxResult {
        let range = SourceRange(
            snapshot, 0, 5,
            Location(lineNumber: 1, column: 1),
            Location(lineNumber: 1, column: code.count + 20)
        )
        let segments = PrimitiveExternalCodeSegmentSyntax[]
        if (code.contains("missing.chars.data")) {
            segments.add(PrimitiveExternalCodeSegmentSyntax(
                range, "", ["missing", "chars", "data"]
            ))
        } else if (code.contains("message.length")) {
            segments.add(PrimitiveExternalCodeSegmentSyntax(
                range, "", ["message", "length"]
            ))
        } else if (code.contains("message.chars.data")) {
            segments.add(PrimitiveExternalCodeSegmentSyntax(range, "Error(", String[]))
            segments.add(PrimitiveExternalCodeSegmentSyntax(
                range, "", ["message", "chars", "data"]
            ))
            segments.add(PrimitiveExternalCodeSegmentSyntax(range, ")", String[]))
        } else segments.add(PrimitiveExternalCodeSegmentSyntax(range, code, String[]))
        return result(segments, range, code, target)
    }

    token(String value, Int type, Int column) -> Token => Token(
        value: value,
        type: type,
        location: Location(lineNumber: 1, column: column)
    )
}
