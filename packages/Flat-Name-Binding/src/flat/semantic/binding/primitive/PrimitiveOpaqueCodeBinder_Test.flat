package flat/semantic/binding/primitive

import flat/compiler/models
import flat/parser/flat
import flat/bound
import flat/semantic/types

/** Focused binding coverage for selected opaque statements and interpolation. */
testable class PrimitiveOpaqueCodeBinder_Test {
    test `opaque field lookup retains instance receiver and exact overlay member identity`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:array-native-field"), "one")
        let memberSnapshot = SourceSnapshotIdentity(SourceIdentity("memory:array-native-overlay"), "one")
        let range = SourceRange(snapshot, 0, 4, Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 5))
        let memberRange = SourceRange(memberSnapshot, 0, 4, Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 5))
        let owner = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "class", 0), "class", "Array")
        let memberOwner = DeclarationIdentity(SyntaxIslandIdentity(memberSnapshot, "class", 0), "class", "Array")
        let identity = SymbolIdentity(memberOwner, "field", 0)
        let type = ArraySemanticType(SemanticTypes.charType())
        let field = BoundFieldUnit("data", identity, type, memberRange, visibleField: true,
            nativeArrayStorage: true, ownerIdentity: owner)
        let receiver = BoundReferenceExpression(range, UserClassSemanticType(owner), "this", SymbolIdentity(owner, "receiver"))
        let lexical = LocalBinding("data", identity, type)
        var String code = ""
        code += '#'
        code += "{data} = new Array(2).fill(null);"
        PrimitiveExternalCodeSegmentSyntax[] syntaxSegments = [
            PrimitiveExternalCodeSegmentSyntax(range, "", ["data"]),
            PrimitiveExternalCodeSegmentSyntax(range, " = new Array(2).fill(null);", String[])
        ]
        let syntax = PrimitiveExternalStatementSyntax(range, "js", code, syntaxSegments)
        LocalBinding[] fieldLocals = [lexical]
        BoundFieldUnit[] published = [field]
        let bound = PrimitiveOpaqueCodeBinder().bind(syntax, fieldLocals, receiver, published,
            CallableSignature[], published)
        let segment = bound.segmentValues().firstOrNull((piece) => piece.value != null)
        expect(segment.value.expressionKind()).toBe("member-access")
        Object accessSource = segment.value
        BoundMemberAccessExpression access = (BoundMemberAccessExpression)accessSource
        expect(access.memberIdentity.value).toBe(identity.value)
        expect(access.receiver).toBe(receiver)
        expect(access.semanticType.value()).toBe(type.value())
        expect(access.range.snapshot.value).toBe(snapshot.value)
        expect(field.canonicalOwner().value).toBe(owner.value)
        expect(bound.nameBindingValues().count).toBe(0)
        let remapped = BoundReferenceExpression(range, receiver.semanticType, "allocated", SymbolIdentity(owner, "parameter", 0))
        let substitution = PrimitiveConstructorSubstitution()
        substitution.bind(receiver.symbolIdentity, remapped)
        Object substitutedSource = substitution.lowerExpression(access)
        BoundMemberAccessExpression substituted = (BoundMemberAccessExpression)substitutedSource
        expect(substituted.memberIdentity.value).toBe(identity.value)
        expect(((BoundReferenceExpression)substituted.receiver).symbolIdentity.value).toBe(remapped.symbolIdentity.value)
        var Bool prebaseRejected
        try { PrimitiveConstructorSubstitution(receiverFree: true).lowerExpression(access) }
        catch (Exception error) { prebaseRejected = error.message.contains("uninitialized receiver") }
        expect(prebaseRejected).toBe(true)
        let childOwner = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "class", 8), "class", "ChildArray")
        let childReceiver = BoundReferenceExpression(range, UserClassSemanticType(childOwner), "this", SymbolIdentity(childOwner, "receiver"))
        let inherited = PrimitiveOpaqueCodeBinder().bind(syntax, fieldLocals, childReceiver, availableFields: published)
        Object inheritedSource = inherited.segmentValues().firstOrNull((piece) => piece.value != null).value
        BoundMemberAccessExpression inheritedAccess = (BoundMemberAccessExpression)inheritedSource
        expect(inheritedAccess.memberIdentity.value).toBe(identity.value)
        expect(inheritedAccess.receiver).toBe(childReceiver)
        var Bool rejected
        try { PrimitiveOpaqueCodeBinder().bind(syntax, fieldLocals, fields: published, availableFields: published) }
        catch (Exception error) { rejected = error.message.contains("receiver") }
        expect(rejected).toBe(true)
        let parameter = LocalBinding("data", SymbolIdentity(owner, "parameter", 1), type)
        LocalBinding[] parameterLocals = [lexical, parameter]
        let shadowed = PrimitiveOpaqueCodeBinder().bind(syntax, parameterLocals, receiver, published)
        expect(shadowed.segmentValues().firstOrNull((piece) => piece.value != null).value.expressionKind()).toBe("reference")
        let local = LocalBinding("data", SymbolIdentity(owner, "local", 2), type, nativeArrayStorage: true)
        LocalBinding[] localLocals = [lexical, local]
        let localShadow = PrimitiveOpaqueCodeBinder().bind(syntax, localLocals, receiver, published)
        Object localSource = localShadow.segmentValues().firstOrNull((piece) => piece.value != null).value
        BoundReferenceExpression localReference = (BoundReferenceExpression)localSource
        expect(localReference.symbolIdentity.value).toBe(local.identity.value)
        expect(localShadow.nameBindingValues().count).toBe(1)
        let staticField = BoundFieldUnit("data", identity, type, memberRange, visibleField: true,
            staticField: true, nativeArrayStorage: true, ownerIdentity: owner)
        BoundFieldUnit[] staticFields = [staticField]
        let staticBound = PrimitiveOpaqueCodeBinder().bind(syntax, fieldLocals, fields: staticFields)
        Object staticSource = staticBound.segmentValues().firstOrNull((piece) => piece.value != null).value
        BoundReferenceExpression staticReference = (BoundReferenceExpression)staticSource
        expect(staticReference.staticOwner.value).toBe(owner.value)
        expect(staticReference.fieldOwnerIdentity.value).toBe(owner.value)
    }
    test `constructor storage substitution retains source name for renamed native setup local`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:native-setup-remap"), "one")
        let range = SourceRange(snapshot, 0, 4, Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 5))
        let owner = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "constructor", 0), "constructor", "Text")
        let original = BoundReferenceExpression(range, ArraySemanticType(SemanticTypes.charType()), "chars", SymbolIdentity(owner, "local", 0))
        let replacement = BoundReferenceExpression(range, original.semanticType, "setupChars", SymbolIdentity(owner, "local", 1))
        let statement = BoundExternalStatement(range, "es6", [BoundExternalCodeSegment(range, "chars = [];")],
            [BoundExternalNameBinding("chars", original)])
        let substitution = PrimitiveConstructorSubstitution(receiverFree: true)
        substitution.bind(original.symbolIdentity, replacement)
        let output = BoundStatement[]
        substitution.lowerStatement(statement, output)
        Object resultSource = output.first
        BoundExternalStatement result = (BoundExternalStatement)resultSource
        expect(result.nameBindingValues().first.sourceName).toBe("chars")
        expect(result.nameBindingValues().first.storageReference().symbolIdentity.value).toBe(replacement.symbolIdentity.value)
        expect(result.segmentValues().first.text).toBe("chars = [];")
    }

    test `native storage publication uses nearest lexical identity and declared nullable storage`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:native-lexical-storage"), "one")
        let range = SourceRange(snapshot, 0, 4, Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 5))
        let owner = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "function", 0), "function", "run")
        let parameter = SymbolIdentity(owner, "parameter", 0)
        let local = SymbolIdentity(owner, "local", 1)
        let optional = NullableSemanticType(SemanticTypes.stringType())
        let locals = [LocalBinding("chars", parameter, SemanticTypes.charType()),
            LocalBinding("chars", local, SemanticTypes.stringType(), declaredType: optional, nativeScalarStorage: true)]
        let syntax = PrimitiveExternalStatementSyntax(range, "js", "chars = null;", [PrimitiveExternalCodeSegmentSyntax(range, "chars = null;", String[])])
        let statement = PrimitiveOpaqueCodeBinder().bind(syntax, locals)
        expect(statement.nameBindingValues().count).toBe(1)
        let storage = statement.nameBindingValues().first.storageReference()
        expect(storage.symbolIdentity.value).toBe(local.value)
        expect(storage.semanticType.value()).toBe(optional.value())
        expect(PrimitiveNullableLocalFlow.clear(locals).last.nativeScalarStorage).toBe(true)
        let again = PrimitiveOpaqueCodeBinder().bind(syntax, PrimitiveNullableLocalFlow.clear(locals))
        expect(again.nameBindingValues().first.storageReference().symbolIdentity.value).toBe(local.value)
        let hidden = LocalBinding("chars", SymbolIdentity(owner, "local", 2), SemanticTypes.intType())
        let shadowed = LocalBinding[]:addAll(locals)
        shadowed.add(hidden)
        expect(PrimitiveOpaqueCodeBinder().bind(syntax, shadowed).nameBindingValues().count).toBe(0)
    }
    test `binds source-owned field and null interpolation in constructor`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:external-constructor-owner"), "one"
        )
        let owner = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", 4), "class", "Buffer"
        )
        let range = SourceRange(snapshot, 0, 4,
            Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 5))
        let receiver = BoundReferenceExpression(
            range, UserClassSemanticType(owner), "this", SymbolIdentity(owner, "receiver")
        )
        let data = BoundFieldUnit("data", SymbolIdentity(owner, "field", 0),
            ArraySemanticType(SemanticTypes.intType()), range)
        let count = LocalBinding("count", SymbolIdentity(owner, "parameter"),
            SemanticTypes.intType())
        let syntax = result([
            PrimitiveExternalCodeSegmentSyntax(range, "new Array(", String[]),
            PrimitiveExternalCodeSegmentSyntax(range, "", ["data"]),
            PrimitiveExternalCodeSegmentSyntax(range, "", ["count"]),
            PrimitiveExternalCodeSegmentSyntax(range, "", ["null"])
        ], range, "constructor interpolation", "js")
        let bound = PrimitiveControlStatementBinder().bind(
            syntax, snapshot, [count], receiver: receiver, fields: [data],
            availableFields: [data]
        ).statements()
        let object = (Object)bound.first
        let value = (BoundExternalStatement)object
        let segments = value.segmentValues()
        expect(segments[1].value.expressionKind()).toBe("member-access")
        expect(segments[2].value.expressionKind()).toBe("reference")
        expect(segments[3].value.semanticType.kind()).toBe("null")
    }

    test `resolves declared static call interpolation without a local owner value`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:external-static"), "one")
        let owner = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "class", 0), "class", "Char")
        let type = UserClassSemanticType(owner)
        let method = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "method", 1), "static-method", "repeat")
        let signature = CallableSignature(SymbolIdentity(method, "static-method"), "repeat",
            CallableKind("static-method"), [SemanticTypes.charType(), SemanticTypes.intType()],
            SemanticTypes.stringType(), type)
        var String code = "return "
        code += '#'
        code += "{Char.repeat('a', 3)};"
        let syntax = PrimitiveControlStatementParser().parse([
            token("external", Token.Type.IDENTIFIER, 1), token("{", Token.Type.SYMBOL, 10),
            token(code, Token.Type.CODE, 12), token("}", Token.Type.SYMBOL, 40)
        ], snapshot)
        let bound = PrimitiveControlStatementBinder().bind(syntax, snapshot,
            callables: [signature]).statements()
        let object = (Object)bound.first
        let statement = (BoundExternalStatement)object
        let segments = statement.segmentValues()
        let expressionObject = (Object)segments[1].value
        let call = (BoundCallExpression)expressionObject
        expect(call.target.identity.value).toBe(signature.identity.value)
        expect(call.semanticType.value()).toBe(SemanticTypes.stringType().value())
        expect(call.argumentValues().count).toBe(2)
    }

    test `resolves declared member interpolation`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:external-member"), "one")
        let owner = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "class", 0), "class", "Box")
        let type = UserClassSemanticType(owner)
        let method = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "method", 1), "instance-method", "add")
        let signature = CallableSignature(SymbolIdentity(method, "instance-method"), "add",
            CallableKind("instance-method"), [SemanticTypes.intType()], SemanticTypes.intType(), type)
        let local = LocalBinding("box", SymbolIdentity(owner, "local"), type)
        var String code = "return "
        code += '#'
        code += "{box.add(42)};"
        let syntax = PrimitiveControlStatementParser().parse([
            token("external", Token.Type.IDENTIFIER, 1), token("{", Token.Type.SYMBOL, 10),
            token(code, Token.Type.CODE, 12), token("}", Token.Type.SYMBOL, 40)
        ], snapshot)
        let bound = PrimitiveControlStatementBinder().bind(syntax, snapshot, [local], [signature]).statements()
        let object = (Object)bound.first
        let statement = (BoundExternalStatement)object
        let segments = statement.segmentValues()
        let expressionObject = (Object)segments[1].value
        let call = (BoundCallExpression)expressionObject
        expect(call.target.identity.value).toBe(signature.identity.value)
    }

    test `preserves callback await suppression evidence`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:suppress-await"), "one")
        let declaration = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "method", 0), "static-method", "apply"
        )
        let parameter = LocalBinding("callback", SymbolIdentity(declaration, "parameter"),
            FunctionSemanticType([SemanticTypes.intType()], SemanticTypes.intType(), true))
        var String code = "return "
        code += '#'
        code += "{callback(1)$};"
        let syntax = PrimitiveControlStatementParser().parse([
            token("external", Token.Type.IDENTIFIER, 1), token("{", Token.Type.SYMBOL, 10),
            token(code, Token.Type.CODE, 12), token("}", Token.Type.SYMBOL, 40)
        ], snapshot)
        let bound = PrimitiveControlStatementBinder().bind(syntax, snapshot, [parameter]).statements()
        let object = (Object)bound.first
        let statement = (BoundExternalStatement)object
        let segments = statement.segmentValues()
        let expressionObject = (Object)segments[1].value
        let invocation = (BoundFunctionInvocationExpression)expressionObject
        expect(invocation.suppressAwait).toBe(true)
    }

    test `binds selected target and preserves literal source evidence`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:external-bind"), "revision:one"
        )
        let syntax = parse(snapshot, "code")
        let bound = PrimitiveControlStatementBinder().bind(syntax, snapshot).statements()
        let object = (Object)bound.first
        let value = (BoundExternalStatement)object

        expect(value.target).toBe("es6")
        expect(value.segmentValues().first.text).toBe("code")
        expect(value.range.snapshot).toBe(snapshot)
    }

    test `binds opaque parameter names`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:external-bind-parameter-name"), "revision:one"
        )
        let declaration = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "method", 0), "static-method", "sqrt"
        )
        let parameter = LocalBinding(
            "number", SymbolIdentity(declaration, "parameter"), SemanticTypes.doubleType()
        )
        let bound = PrimitiveControlStatementBinder().bind(
            parse(snapshot, "return Math.sqrt(number);"), snapshot, [parameter]
        ).statements()
        let statementObject = (Object)bound.first
        let statement = (BoundExternalStatement)statementObject
        let bindings = statement.nameBindingValues()
        let binding = bindings.first

        expect(binding.sourceName).toBe("number")
        expect(binding.storageReference().symbolIdentity).toBe(parameter.identity)
    }

    test `binds string data interpolation to typed reference evidence`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:external-bind-interpolation"), "revision:one"
        )
        var String code = ""
        code += "Error("
        code += '#'
        code += "{message.chars.data})"
        let declaration = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "constructor", 0), "constructor", "Owner"
        )
        let local = LocalBinding(
            "message", SymbolIdentity(declaration, "parameter"), SemanticTypes.stringType()
        )
        let range = SourceRange(
            snapshot, 0, 5,
            Location(lineNumber: 1, column: 1),
            Location(lineNumber: 1, column: code.count + 20)
        )
        let syntaxSegments = PrimitiveExternalCodeSegmentSyntax[]
        syntaxSegments.add(PrimitiveExternalCodeSegmentSyntax(range, "Error(", String[]))
        syntaxSegments.add(PrimitiveExternalCodeSegmentSyntax(
            range, "", ["message", "chars", "data"]
        ))
        syntaxSegments.add(PrimitiveExternalCodeSegmentSyntax(range, ")", String[]))
        let syntax = result(syntaxSegments, range, code, "js")
        let bound = PrimitiveControlStatementBinder().bind(
            syntax, snapshot, [local]
        ).statements()
        let object = (Object)bound.first
        let statement = (BoundExternalStatement)object
        let segments = statement.segmentValues()

        expect(segments.count).toBe(3)
        expect(segments[1].value.semanticType.value()).toBe("builtin:String")
        expect(segments[1].rendering).toBe("es6-native-string")
        expect(((BoundReferenceExpression)segments[1].value).symbolIdentity).toBe(local.identity)
    }

    test `binds native array data expression interpolation`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:external-native-array-projection"), "revision:one"
        )
        let declaration = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "constructor", 0), "constructor", "Owner"
        )
        let local = LocalBinding(
            "data", SymbolIdentity(declaration, "parameter"),
            ArraySemanticType(SemanticTypes.charType())
        )
        let range = SourceRange(
            snapshot, 0, 4,
            Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 5)
        )
        var String code = ""
        code += '#'
        code += "{data.data}"
        let syntax = result([
            PrimitiveExternalCodeSegmentSyntax(
                range, "", String[], PrimitiveMemberAccessSyntax(
                    range, PrimitiveReferenceSyntax(range, "data"), "data"
                )
            )
        ], range, code, "js")
        let bound = PrimitiveControlStatementBinder().bind(
            syntax, snapshot, [local]
        ).statements()
        let object = (Object)bound.first
        let statement = (BoundExternalStatement)object

        expect(statement.segmentValues().first.value.expressionKind())
            .toBe("native-array-data")
    }

    test `binds native array path interpolation`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:external-native-array-path"), "revision:one"
        )
        let declaration = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "constructor", 0), "constructor", "Owner"
        )
        let local = LocalBinding(
            "data", SymbolIdentity(declaration, "parameter"),
            ArraySemanticType(SemanticTypes.charType())
        )
        let range = SourceRange(
            snapshot, 0, 2,
            Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 3)
        )
        let bound = PrimitiveControlStatementBinder().bind(
            result([
                PrimitiveExternalCodeSegmentSyntax(range, "", ["data", "data"]),
                PrimitiveExternalCodeSegmentSyntax(range, "", ["data", "count"])
            ], range, "native array paths", "js"),
            snapshot, [local]
        ).statements()
        let object = (Object)bound.first
        let statement = (BoundExternalStatement)object

        expect(statement.segmentValues().first.value.expressionKind())
            .toBe("native-array-data")
        expect(statement.segmentValues().last.value.expressionKind())
            .toBe("array-length")
    }

    test `binds parameter field path interpolation`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:external-parameter-field"), "revision:one"
        )
        let owner = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", 0), "class", "Owner"
        )
        let range = SourceRange(
            snapshot, 0, 2,
            Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 3)
        )
        let type = UserClassSemanticType(owner)
        let receiver = BoundReferenceExpression(
            range, type, "this", SymbolIdentity(owner, "receiver")
        )
        let field = BoundFieldUnit(
            "data", SymbolIdentity(owner, "field"),
            ArraySemanticType(SemanticTypes.charType()), range
        )
        let parameter = LocalBinding(
            "other", SymbolIdentity(owner, "parameter"), type
        )
        let syntax = result([
            PrimitiveExternalCodeSegmentSyntax(range, "", ["other", "data"])
        ], range, "parameter field", "js")
        let bound = PrimitiveControlStatementBinder().bind(
            syntax, snapshot, [parameter], receiver: receiver, fields: [field]
        ).statements()
        let statementObject = (Object)bound.first
        let statement = (BoundExternalStatement)statementObject
        let segments = statement.segmentValues()
        let selectedObject = (Object)segments.first.value
        let selected = (BoundMemberAccessExpression)selectedObject

        expect(selected.receiver.expressionKind()).toBe("reference")
        expect(selected.memberName).toBe("data")
        expect(selected.memberIdentity).toBe(field.identity)
    }

