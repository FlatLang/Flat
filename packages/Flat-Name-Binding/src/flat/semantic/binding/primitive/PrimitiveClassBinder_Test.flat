    async test `binds structured declared String local member call`() {
        let stream = Lexer().lex(
            "class String { indexOf(String search, Int start = 0) -> Int { return 0; } " +
                "replace(String search, Int start = 0) -> String { var output = this; " +
                "var Int index = start; index = output.indexOf(search, index); " +
                "return output; } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:string-local-member-call"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot
        ).typeUnit
        let replace = type.functionUnits().firstOrNull({ _.name == "replace" })
        let statements = replace.statements()
        let declarationObject = (Object)statements.first
        let declaration = (BoundLocalDeclarationStatement)declarationObject
        let assignmentObject = (Object)statements[2]
        let assignment = (BoundAssignmentStatement)assignmentObject
        let callObject = (Object)assignment.value
        let call = (BoundCallExpression)callObject

        expect(declaration.local.semanticType.value()).toBe(type.semanticType.value())
        expect(call.receiver.semanticType.value()).toBe(type.semanticType.value())
        expect(call.target.name).toBe("indexOf")
        expect(call.target.ownerType.value()).toBe(type.semanticType.value())
        expect(call.range.startTokenIndex).toBe(46)
    }

    async test `binds overloaded receiver calls in C style for clauses`() {
        let stream = Lexer().lex(
            "class String { visible Int count; " +
                "indexOf(Char search, Int start = 0) -> Int { return 1; } " +
                "indexOf(String search, Int start = 0) -> Int { return 2; } " +
                "split(String delimiter) -> Int { var Int lastI = 0; " +
                "for (var Int i = indexOf(delimiter); i != -1; " +
                "i = indexOf(delimiter, i + delimiter.count)) { lastI = i; } " +
                "return lastI; } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:for-clause-overload"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot
        ).typeUnit
        let split = type.functionUnits().firstOrNull({ _.name == "split" })
        let statements = split.statements()
        let loopObject = (Object)statements[1]
        let loop = (BoundForEachStatement)loopObject
        let initializers = loop.initialization()
        let initializerObject = (Object)initializers.first
        let initializer = (BoundLocalDeclarationStatement)initializerObject
        let initialCallObject = (Object)initializer.initializer
        let initialCall = (BoundCallExpression)initialCallObject
        let advances = loop.advance()
        let advanceObject = (Object)advances.first
        let advance = (BoundAssignmentStatement)advanceObject
        let advanceCallObject = (Object)advance.value
        let advanceCall = (BoundCallExpression)advanceCallObject

        expect(initialCall.target.parameterTypes().first.value())
            .toBe(type.semanticType.value())
        expect(advanceCall.target.parameterTypes().first.value())
            .toBe(type.semanticType.value())
        expect(advanceCall.argumentValues().count).toBe(2)
        expect(advanceCall.argumentValues().last.semanticType.value())
            .toBe("primitive:Int")
        expect(advanceCall.range.snapshot).toBe(snapshot)
    }

    async test `preserves declared String identity through chained receiver calls`() {
        let stream = Lexer().lex(
            "class String { " +
                "replace(String search, String replacement) -> String { return this; } " +
                "sanitize() -> String { let value = this.replace(\"a\", \"b\")" +
                ".replace(\"b\", \"c\").replace(\"c\", \"d\"); return value; } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:string-chained-receiver-calls"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot
        ).typeUnit
        let sanitize = type.functionUnits().firstOrNull({ _.name == "sanitize" })
        let statements = sanitize.statements()
        let declarationObject = (Object)statements.first
        let declaration = (BoundLocalDeclarationStatement)declarationObject
        let outerObject = (Object)declaration.initializer
        let outer = (BoundCallExpression)outerObject
        let middleObject = (Object)outer.receiver
        let middle = (BoundCallExpression)middleObject
        let innerObject = (Object)middle.receiver
        let inner = (BoundCallExpression)innerObject

        expect(inner.semanticType.value()).toBe(type.semanticType.value())
        expect(middle.semanticType.value()).toBe(type.semanticType.value())
        expect(outer.semanticType.value()).toBe(type.semanticType.value())
        expect(outer.target.ownerType.value()).toBe(type.semanticType.value())
        expect(outer.range.snapshot).toBe(snapshot)
    }

    async test `publishes inferred predicate result before dependent binding`() {
        let stream = Lexer().lex(
            "class String { " +
                "validate(Int start, Int end, Bool fail = false) => true { " +
                "if (fail) { return false; } } " +
                "substring(Int start, Int end) -> String { " +
                "if (!validate(start, end, true)) { return this; } return this; } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:inferred-predicate-signature"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot
        ).typeUnit
        let validate = type.functionUnits().firstOrNull({ _.name == "validate" })
        let substring = type.functionUnits().firstOrNull({ _.name == "substring" })
        let statements = substring.statements()
        let conditionalObject = (Object)statements.first
        let conditional = (BoundIfStatement)conditionalObject
        let conditionObject = (Object)conditional.condition
        let condition = (BoundUnaryExpression)conditionObject
        let callObject = (Object)condition.operand
        let call = (BoundCallExpression)callObject

        expect(validate.returnType.value()).toBe("primitive:Bool")
        expect(call.semanticType.value()).toBe("primitive:Bool")
        expect(condition.semanticType.value()).toBe("primitive:Bool")
        expect(call.range.snapshot).toBe(snapshot)
    }

