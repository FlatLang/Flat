    test `binds required method contract`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:abstract-bind"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse([
            token("abstract", false, 1), token("class", false, 10),
            token("Number", false, 16), token("{", true, 23),
            token("public", false, 25), token("abstract", false, 32),
            token("plus", false, 41), token("(", true, 45), token("Long", false, 46),
