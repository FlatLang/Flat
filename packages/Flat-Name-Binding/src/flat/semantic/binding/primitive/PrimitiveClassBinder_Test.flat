    async test `binds receiver field in instance parameter default`() {
        let stream = Lexer().lex(
            "class Value { Int count; read(Int start = count) -> Int { return start; } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:receiver-field-default"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot
        ).typeUnit
        let read = type.functionUnits().firstOrNull({ _.name == "read" })
        let parameter = read.parameterValues().first
        let defaultObject = (Object)parameter.defaultValue
        let selected = (BoundMemberAccessExpression)defaultObject

        expect(selected.semanticType.value()).toBe("primitive:Int")
        expect(selected.memberIdentity).toBe(type.fieldUnits().first.identity)
        expect(selected.receiver.semanticType.value()).toBe(type.semanticType.value())
        expect(selected.range.startTokenIndex).toBe(11)
    }

    async test `types inferred call result from comparison peer`() {
        let stream = Lexer().lex(
            "class Value { lookup() -> Int { return 0; } " +
                "matches(Int expected) -> Bool { return lookup() >= expected; } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:inferred-equality-peer"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot
        ).typeUnit
        let matches = type.functionUnits().firstOrNull({ _.name == "matches" })
        let statements = matches.statements()
        let returnedObject = (Object)statements.first
        let returned = (BoundReturnStatement)returnedObject
        let comparisonObject = (Object)returned.value
        let comparison = (BoundBinaryExpression)comparisonObject

        expect(comparison.left.semanticType.value()).toBe("primitive:Int")
        expect(comparison.semanticType.value()).toBe("primitive:Bool")
    }

    async test `preserves inferred String Char index result in equality`() {
        let stream = Lexer().lex(
            "class String { Char[] data; this[Int index] -> Char { " +
                "get { return data[index] } } " +
                "startsWith(Char search, Int start = 0) => this[start] == search }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:string-char-index-equality"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot
        ).typeUnit
        let startsWith = type.functionUnits().firstOrNull({ _.name == "startsWith" })
        let statements = startsWith.statements()
        let returnedObject = (Object)statements.first
        let returned = (BoundReturnStatement)returnedObject
        let comparisonObject = (Object)returned.value
        let comparison = (BoundBinaryExpression)comparisonObject
        let indexedObject = (Object)comparison.left
        let indexed = (BoundCallExpression)indexedObject

        expect(indexed.semanticType.value()).toBe("primitive:Char")
        expect(indexed.target.returnType.value()).toBe("primitive:Char")
        expect(comparison.semanticType.value()).toBe("primitive:Bool")
    }

    async test `selects reduced overload by mixed named argument label`() {
        let stream = Lexer().lex(
            "class String { " +
                "trimStart(Int count, Char[] other) -> this { return this; } " +
                "trimStart(Int start = 0, Char[] charsToTrim = Char[]) -> this { " +
                "return this; } " +
                "trimStart(Char charToTrim, Int start = 0) -> this { " +
                "return trimStart(start, charsToTrim: [charToTrim]); } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:mixed-named-overload"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot
        ).typeUnit
        let method = type.functionUnits().last
        let statements = method.statements()
        let returnedObject = (Object)statements.first
        let returned = (BoundReturnStatement)returnedObject
        let callObject = (Object)returned.value
        let call = (BoundCallExpression)callObject
        let arguments = call.argumentValues()

        expect(call.target.parameterNames()).toBe(["start", "charsToTrim"])
        expect(arguments.first.semanticType.value()).toBe("primitive:Int")
        expect(arguments.last.semanticType.kind()).toBe("array")
        let argumentTypeObject = (Object)arguments.last.semanticType
        var ArraySemanticType argumentType
        argumentType = (ArraySemanticType)argumentTypeObject
        expect(argumentType.elementType.value()).toBe("primitive:Char")
        expect(arguments.last.range.snapshot).toBe(snapshot)
        expect(call.range.snapshot).toBe(snapshot)
    }

    async test `binds typed array override accessors and indexed use`() {
        let source = "class Buffer { Char[] data; " +
            "this[Int index] -> Char { get { return data[index] } " +
            "set { data[index] = value } } " +
            "read(Int index) -> Char { return this[index] } " +
            "write(Int index, Char value) { this[index] = value } }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let sourceTokens = stream.consumeAll<Token>("data")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:array-override-bind"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(sourceTokens, snapshot), snapshot
        ).typeUnit
        expect(type.functionUnits().any({ _.name == "getAt" })).toBe(true)
        expect(type.functionUnits().any({ _.name == "setAt" })).toBe(true)
        expect(type.functionUnits().firstOrNull({ _.name == "getAt" }).returnType.value())
            .toBe("primitive:Char")
        expect(type.functionUnits().firstOrNull({ _.name == "getAt" }).parameterValues().count)
            .toBe(1)
        let read = type.functionUnits().firstOrNull({ _.name == "read" })
        let readStatements = read.statements()
        let returnedObject = (Object)readStatements.first
        let returned = (BoundReturnStatement)returnedObject
        let callObject = (Object)returned.value
        let indexedCall = (BoundCallExpression)callObject
        expect(indexedCall.semanticType.value()).toBe("primitive:Char")
        expect(indexedCall.target.returnType.value()).toBe("primitive:Char")
        expect(type.functionUnits().firstOrNull({ _.name == "setAt" }).returnType.value())
            .toBe("unit")
        expect(type.functionUnits().firstOrNull({ _.name == "setAt" }).parameterValues().count)
            .toBe(2)
    }

    test `rejects invalid reduced type bindings`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:class-bind-invalid"), "revision:one"
        )
        var Int rejected
        try {
            let values = tokens()
            values[14] = token("missing", false, 54)
            PrimitiveClassBinder().bind(PrimitiveClassParser().parse(values, snapshot), snapshot)
        } catch (Exception error) { rejected++ }
        try {
            let values = tokens()
            values[8] = token("String", false, 36)
            PrimitiveClassBinder().bind(PrimitiveClassParser().parse(values, snapshot), snapshot)
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
    }

    visibleConstructorTokens() -> Token[] {
        return [
            token("class", false, 1), token("Exception", false, 7), token("{", true, 17),
            token("construct", false, 19), token("(", true, 28), token("visible", false, 29),
            token("String", false, 37), token("message", false, 44), token("=", true, 52),
            stringToken("''", 54), token(")", true, 56), token("{", true, 58),
            token("}", true, 59), token("}", true, 61)
        ]
    }

    visibleConstructorDuplicateTokens() -> Token[] {
        return [
            token("class", false, 1), token("Exception", false, 7), token("{", true, 17),
            token("String", false, 19), token("message", false, 26), token(";", true, 33),
            token("construct", false, 35), token("(", true, 44), token("visible", false, 45),
            token("String", false, 53), token("message", false, 60), token(")", true, 67),
            token("{", true, 69), token("}", true, 70), token("}", true, 72)
        ]
    }

    exceptionTokens() -> Token[] {
        return [
            token("class", false, 1), token("Exception", false, 7), token("{", true, 17),
            token("visible", false, 19), token("String", false, 27), token("message", false, 34),
            token("=", true, 42), stringToken("''", 44), token(";", true, 46),
            token("construct", false, 48), token("(", true, 57), token("String", false, 58),
            token("message", false, 65), token("=", true, 73), stringToken("''", 75),
            token(")", true, 77), token("{", true, 79), token("native", false, 81),
            token("[", true, 87), token("es6", false, 88), token("]", true, 91),
            token("Math", false, 93), token(".", true, 97), token("max", false, 98),
            token("(", true, 101), token("1", false, 102, Token.Type.INTEGER),
            token(",", true, 103), token("2", false, 105, Token.Type.INTEGER),
            token(")", true, 106), token(";", true, 107), token("}", true, 109),
            token("}", true, 111)
        ]
    }

    tokens() -> Token[] {
        return [
            token("class", false, 1), token("Box", false, 7), token("{", true, 11),
            token("Int", false, 13), token("value", false, 17), token(";", true, 22),
            token("constructor", false, 24), token("(", true, 35), token("Int", false, 36), token("value", false, 40),
            token(")", true, 45), token("{", true, 47), token("this", false, 49), token(".", true, 53),
            token("value", false, 54), token("=", true, 60), token("value", false, 62), token(";", true, 67),
            token("}", true, 69), token("get", false, 71), token("(", true, 74), token(")", true, 75),
            token("->", true, 77), token("Int", false, 80), token("{", true, 84), token("return", false, 86),
            token("this", false, 93), token(".", true, 97), token("value", false, 98), token(";", true, 103),
            token("}", true, 105), token("}", true, 107)
        ]
    }

    stringToken(String value, Int column) -> Token => Token(
        value: value, type: Token.Type.STRING,
        location: Location(lineNumber: 1, column: column)
    )

    token(
        String value,
        Bool symbol,
        Int column,
        Int explicitType = Token.Type.IDENTIFIER
    ) -> Token {
        let type = symbol ? Token.Type.SYMBOL : explicitType
        return Token(value: value, type: type,
            location: Location(lineNumber: 1, column: column))
    }
}
