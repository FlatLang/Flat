    test `binds self primitive metadata to its declaration identity`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-class-metadata"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse([
            token("class", false, 1), token("Bool", false, 7), token("{", true, 12),
            token("public", false, 14), token("equals", false, 21),
            token("(", true, 27), token("Object", false, 28), token("other", false, 35),
            token(")", true, 40), token("=>", true, 42), token("other", false, 45),
            token(".", true, 50), token("class", false, 51), token(".", true, 56),
            token("isOfType", false, 57), token("(", true, 65), token("Bool", false, 66),
            token(".", true, 70), token("class", false, 71), token(")", true, 76),
            token("}", true, 78)
        ], snapshot)
        let type = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let method = type.functionUnits().last
        let statements = method.statements()
        let returnedObject = (Object)statements.first
        let returned = (BoundReturnStatement)returnedObject
        let expressionObject = (Object)returned.value
        let typeTest = (BoundTypeTestExpression)expressionObject

        expect(typeTest.typeMetadata.referencedType.declarationIdentity).toBe(type.identity)
    }

    test `binds null initialized reference field as nullable`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:nullable-field"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse([
            token("class", false, 1), token("App", false, 7), token("{", true, 11),
            token("static", false, 13), token("String", false, 20),
            token("name", false, 27), token("=", true, 32),
            token("null", false, 34, Token.Type.NULL), token("}", true, 39)
        ], snapshot)
        let field = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit.fieldUnits().first

        expect(field.staticField).toBe(true)
        expect(field.semanticType.kind()).toBe("nullable")
        expect(field.initializer.semanticType.kind()).toBe("null")

        var Bool rejected
        try {
            let invalid = PrimitiveClassParser().parse([
                token("class", false, 1), token("Bad", false, 7), token("{", true, 11),
                token("Int", false, 13), token("value", false, 17), token("=", true, 23),
                token("null", false, 25, Token.Type.NULL), token("}", true, 30)
            ], snapshot)
            PrimitiveClassBinder().bind(invalid, snapshot)
        } catch (Exception error) { rejected = true }
        expect(rejected).toBe(true)
    }

    test `binds structured static method body`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:structured-static-method"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse([
            token("class", false, 1), token("Math", false, 7), token("{", true, 12),
            token("public", false, 14), token("static", false, 21),
            token("gcd", false, 28), token("(", true, 31), token("Int", false, 32),
            token("a", false, 36), token(",", true, 37), token("Int", false, 39),
            token("b", false, 43), token(")", true, 44), token("->", true, 46),
            token("Int", false, 49), token("{", true, 53), token("let", false, 55),
            token("r", false, 59), token("=", true, 61),
            token("a", false, 63), token("%", true, 65), token("b", false, 67),
            token(";", true, 68), token("if", false, 70), token("(", true, 73),
            token("r", false, 74), token("==", true, 76),
            token("0", false, 79, Token.Type.INTEGER), token(")", true, 80),
            token("{", true, 82), token("return", false, 84), token("b", false, 91),
            token(";", true, 92), token("}", true, 94), token("return", false, 96),
            token("r", false, 103),
            token(";", true, 112), token("}", true, 114), token("}", true, 116)
        ], snapshot)
        let method = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit.functionUnits().last

        expect(method.statements().map({ _.unitKind() })).toBe([
            "local-declaration", "if", "return"
        ])
        expect(method.returnType.value()).toBe("primitive:Int")
    }

    async test `binds primitive wrapper comparison through value field`() {
        let source = "class Float { construct(public Float value) {} " +
            "equals(Object other) => (Float)other == value }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let tokens = stream.consumeAll<Token>("data")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-wrapper-comparison"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse(tokens, snapshot)
        let type = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let method = type.functionUnits().firstOrNull({ _.name == "equals" })
        let statements = method.statements()
        let returnObject = (Object)statements.first
        let returned = (BoundReturnStatement)returnObject
        let expressionObject = (Object)returned.value
        let comparison = (BoundBinaryExpression)expressionObject

        expect(comparison.left.expressionKind()).toBe("member-access")
        expect(comparison.right.expressionKind()).toBe("member-access")
        expect(comparison.right.semanticType.value()).toBe("primitive:Float")
    }

    async test `infers fallback method return through switch body`() {
        let source = "class Char { static isWhitespace(Char value) => false { " +
            "switch value { ' ' => fallthrough '\\n' => return true } } }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let tokens = stream.consumeAll<Token>("data")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:switch-fallback-bind"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse(tokens, snapshot)
        let type = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let method = type.functionUnits().firstOrNull({ _.name == "isWhitespace" })

        expect(method.returnType.value()).toBe("primitive:Bool")
    }

    async test `binds indexed Char case conversion intrinsically`() {
        let stream = Lexer().lex(
            "class Value { Char[] chars; upper() -> Char { " +
                "return chars[0].toUpperCase(); } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:indexed-char-case-conversion"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot
        ).typeUnit
        let method = type.functionUnits().firstOrNull({ _.name == "upper" })
        let statements = method.statements()
        let returnedObject = (Object)statements.first
        let returned = (BoundReturnStatement)returnedObject
        let callObject = (Object)returned.value
        let call = (BoundIntrinsicMemberCallExpression)callObject

        expect(call.memberName).toBe("toUpperCase")
        expect(call.semanticType.value()).toBe("primitive:Char")
        expect(call.receiver.semanticType.value()).toBe("primitive:Char")
        expect(call.range.snapshot).toBe(snapshot)
    }

    async test `prefers receiver method over same named constructor`() {
        let stream = Lexer().lex(
            "class Value { construct(Int value) {} repeat(Int times) -> Int { " +
                "return times; } repeat(String text) -> Int { return 0; } " +
                "multiply(Int times) -> Int { return repeat(times); } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:receiver-method-constructor-name"), "revision:one"
        )
        let typeIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", 100), "class", "Other"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot,
            availableConstructors: [CallableSignature(
                SymbolIdentity(
                    DeclarationIdentity(
                        SyntaxIslandIdentity(snapshot, "constructor", 101),
                        "constructor", "repeat"
                    ), "constructor"
                ),
                "repeat", CallableKind("constructor"),
                [SemanticTypes.intType()], UserClassSemanticType(typeIdentity),
                UserClassSemanticType(typeIdentity)
            )]
        ).typeUnit
        let method = type.functionUnits().firstOrNull({ _.name == "multiply" })
        let statements = method.statements()
        let returnedObject = (Object)statements.first
        let returned = (BoundReturnStatement)returnedObject
        let callObject = (Object)returned.value
        let call = (BoundCallExpression)callObject

        expect(call.target.name).toBe("repeat")
        expect(call.target.callableKind.value).toBe("instance-method")
        expect(call.receiver.semanticType.value()).toBe(type.semanticType.value())
        expect(call.range.snapshot).toBe(snapshot)
    }

    async test `binds interpolated String repeat intrinsic`() {
        var String source = "class Char { static repeat(Char value, Int times) => \""
        source += '#'
        source += "value\".repeat(times) }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let tokens = stream.consumeAll<Token>("data")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:string-repeat-intrinsic"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse(tokens, snapshot)
        let type = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let method = type.functionUnits().firstOrNull({ _.name == "repeat" })
        let statements = method.statements()
        let returnObject = (Object)statements.first
        let returned = (BoundReturnStatement)returnObject

        expect(returned.value.expressionKind()).toBe("intrinsic-member-call")
        expect(returned.value.semanticType.value()).toBe("builtin:String")
    }

