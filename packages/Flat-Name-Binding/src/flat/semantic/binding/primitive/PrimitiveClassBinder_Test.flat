        expect(method.abstractFunction).toBe(true)
        expect(method.statements().count).toBe(0)
        expect(method.returnType.value()).toBe("primitive:Long")
    }

    test `binds static method parameters without an instance receiver`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:static-class-bind"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse([
            token("class", false, 1), token("Object", false, 7), token("{", true, 14),
            token("public", false, 16), token("static", false, 23),
            token("referenceEquals", false, 30), token("(", true, 45),
            token("Object", false, 46), token("one", false, 53), token(",", true, 56),
            token("Object", false, 58), token("two", false, 65), token(")", true, 68),
            token("->", true, 70), token("Bool", false, 73), token("{", true, 78),
            token("return", false, 80), token("true", false, 87, Token.Type.BOOL),
            token(";", true, 91), token("}", true, 93), token("}", true, 95)
        ], snapshot)
        let method = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit.functionUnits().last

        expect(method.staticFunction).toBe(true)
        expect(method.name).toBe("referenceEquals")
        expect(method.parameterValues().count).toBe(2)
        expect(method.returnType.value()).toBe("primitive:Bool")
    }

