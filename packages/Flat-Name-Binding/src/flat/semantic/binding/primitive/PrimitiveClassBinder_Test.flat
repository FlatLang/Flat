    async test `binds callback invocation in static default`() {
        let stream = Lexer().lex(
            "class Value { static read(next(Int value)->Int, Int end = next(41)) -> Int { return end; } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:callback-default"), "one")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
