        let type = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let method = type.functionUnits().firstOrNull({ _.name == "read" })
        expect(method.parameterValues()[1].defaultValue.expressionKind()).toBe("function-invocation")
        expect(method.parameterValues()[1].defaultValue.semanticType.value()).toBe("primitive:Int")
    }

    async test `binds earlier parameter in static parameter default`() {
        let stream = Lexer().lex(
            "class Value { static read(Int start, Int end = start) -> Int { return end; } }"
