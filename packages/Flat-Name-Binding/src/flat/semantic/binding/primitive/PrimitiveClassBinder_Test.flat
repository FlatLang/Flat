        let syntax = PrimitiveClassParser().parse([
            token("class", false, 1), token("Iterator", false, 7), token("{", true, 16),
            token("construct", false, 18), token("(", true, 27),
            token("private", false, 28), token("Object", false, 36),
            token("range", false, 43), token(")", true, 48), token("{", true, 50),
            token("}", true, 51), token("}", true, 53)
        ], snapshot)
        let type = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let field = type.fieldUnits().first
        let constructor = type.functionUnits().first
        let statements = constructorBody(type, constructor)
        let assignmentObject = (Object)statements.first
        let fieldAssignment = (BoundMemberAssignmentStatement)assignmentObject

        expect(field.name).toBe("range")
        expect(field.visibleField).toBe(false)
        expect(field.range.start.column).toBe(28)
        expect(fieldAssignment.target.memberIdentity).toBe(field.identity)
    }

