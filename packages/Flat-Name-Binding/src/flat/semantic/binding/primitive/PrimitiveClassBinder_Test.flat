    async test `binds field sized array local and indexed copy loop`() {
        let source = "class Buffer { Int count; Char[] data; " +
            "copy() -> Char[] { let array = Array<Char>(count); " +
            "for (i in 0..count) { array[i] = data[i]; } return array; } }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let sourceTokens = stream.consumeAll<Token>("data")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:field-sized-array-copy"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(sourceTokens, snapshot), snapshot
        ).typeUnit
        let method = type.functionUnits().firstOrNull({ _.name == "copy" })

        expect(method.returnType.value()).toBe("array:1:primitive:Char")
        expect(method.statements().count).toBe(3)
        expect(method.statements().first.unitKind()).toBe("local-declaration")
        expect(method.statements()[1].unitKind()).toBe("foreach")
    }

    async test `infers expression array override element contract`() {
        let stream = Lexer().lex(
            "class Buffer { Char[] data; this[Int index] => data[index] }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:inferred-array-override-bind"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot
        ).typeUnit
        let getter = type.functionUnits().firstOrNull({ _.name == "getAt" })

        expect(getter.returnType.value()).toBe("primitive:Char")
        expect(getter.statements().first.unitKind()).toBe("return")
    }

    async test `preserves field context in structured conditional`() {
        let stream = Lexer().lex(
            "class Value { Int count; choose(Int start) -> Int { " +
                "if (true) { return start > count ? start : count; } return count; } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:field-conditional-context"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot
        ).typeUnit
        let choose = type.functionUnits().firstOrNull({ _.name == "choose" })
        let statements = choose.statements()
        let ifObject = (Object)statements.first
        let conditionalStatement = (BoundIfStatement)ifObject
        let thenValues = conditionalStatement.thenValues()
        let returnObject = (Object)thenValues.first
        let returned = (BoundReturnStatement)returnObject
        let conditionalObject = (Object)returned.value
        let conditional = (BoundConditionalExpression)conditionalObject
        let falseObject = (Object)conditional.whenFalse
        let field = (BoundMemberAccessExpression)falseObject

        expect(field.memberIdentity).toBe(type.fieldUnits().first.identity)
        expect(field.receiver.semanticType.value()).toBe(type.semanticType.value())
        expect(conditional.semanticType.value()).toBe("primitive:Int")
    }

    async test `binds array contains with indexed owning field argument`() {
        let stream = Lexer().lex(
            "class Value { Char[] chars; has(Char[] searches, Int start) -> Bool { " +
                "if (searches.contains(chars[start])) { return true; } return false; } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:field-index-array-contains"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot
        ).typeUnit
        let has = type.functionUnits().firstOrNull({ _.name == "has" })
        let statements = has.statements()
        let ifObject = (Object)statements.first
        let conditional = (BoundIfStatement)ifObject
        let callObject = (Object)conditional.condition
        let call = (BoundIntrinsicMemberCallExpression)callObject
        let arguments = call.argumentValues()
        let indexedObject = (Object)arguments.first
        let indexed = (BoundArrayAccessExpression)indexedObject
        let fieldObject = (Object)indexed.receiver
        let field = (BoundMemberAccessExpression)fieldObject

        expect(call.memberName).toBe("contains")
        expect(call.semanticType.value()).toBe("primitive:Bool")
        expect(indexed.semanticType.value()).toBe("primitive:Char")
        expect(field.memberIdentity).toBe(type.fieldUnits().first.identity)
    }

    async test `rejects parameter supplied both positionally and by name`() {
        let stream = Lexer().lex(
            "class Value { read(Int count, Int end = 0) -> Int { return count; } run() -> Int { return read(7, count: 9); } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:duplicate-call-parameter"), "one")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        var String failure
        try { PrimitiveClassBinder().bind(syntax, snapshot) }
        catch (Exception error) { failure = error.message }
        expect(failure).toBe("Method Value.run token 20: Parameter 'count' is supplied both positionally and by name")
    }

    async test `binds explicit empty callback argument`() {
        let stream = Lexer().lex(
            "class Value { read(next(Int value)) -> Int { next(7); return 7; } run() -> Int { return read({}) + read(next: {}); } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:explicit-empty-callback"), "one")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let type = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        expect(type.functionUnits().firstOrNull({ _.name == "run" }).returnType.value()).toBe("primitive:Int")
    }

    async test `binds omitted callback default in named instance call`() {
        let stream = Lexer().lex(
            "class Value { read(Int count = -1, next(Int value) = {}) -> Int { next(count); return count; } run() -> Int { return read(count: 7); } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:named-callback-default"), "one")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let type = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let method = type.functionUnits().firstOrNull({ _.name == "run" })
        expect(method.returnType.value()).toBe("primitive:Int")
        let statements = method.statements()
        let statementObject = (Object)statements.first
        let statement = (BoundReturnStatement)statementObject
        let callObject = (Object)statement.value
        let call = (BoundCallExpression)callObject
        let arguments = call.argumentValues()
        expect(arguments.count).toBe(1)
        expect(call.target.optionalParameterCount).toBe(2)
        let read = type.functionUnits().firstOrNull({ _.name == "read" })
        let callbackObject = (Object)read.parameterValues()[1].defaultValue
        let callback = (BoundLambdaExpression)callbackObject
        expect(callback.parameterValues().count).toBe(1)
        expect(callback.parameterValues().first.semanticType.value()).toBe("primitive:Int")
        expect(callback.captureValues().count).toBe(0)
        let parameterTypes = call.target.parameterTypes()
        expect(callback.semanticType.value()).toBe(parameterTypes.last.value())
    }

    async test `binds empty async callback default`() {
        let stream = Lexer().lex(
            "class Value { async read(Int maxParallel = -1, async onAfterChunk(Int count) = {}) -> Int { return maxParallel; } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:async-callback-default"), "one")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let type = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let method = type.functionUnits().firstOrNull({ _.name == "read" })
        expect(method.parameterValues()[0].defaultValue.semanticType.value()).toBe("primitive:Int")
        expect(method.parameterValues()[1].defaultValue.semanticType.value())
            .toBe(method.parameterValues()[1].semanticType.value())
    }

    async test `rejects empty callback default requiring a result`() {
        let stream = Lexer().lex(
            "class Value { read(next(Int count)->Int = {}) -> Int { return 1; } }"
