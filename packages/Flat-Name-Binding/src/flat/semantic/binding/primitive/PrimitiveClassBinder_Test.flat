        expect(returned.range.snapshot).toBe(snapshot)
    }

    async test `binds builtin String parameter receiver method`() {
        let stream = Lexer().lex(
            "class String { toLowerCase() -> this { return this; } " +
                "compareTo(String other) -> Int { return 0; } " +
                "equalsIgnoreCase(String other) -> Bool { return " +
                "other.toLowerCase().compareTo(toLowerCase()) == 0; } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:string-parameter-method"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let source = PrimitiveSourceBindingContext("flat", snapshot, [syntax])
        let context = PrimitiveResolvedDeclarationContext(source, [source])
        let type = PrimitiveClassBinder().bind(syntax, snapshot, resolvedContext: context).typeUnit
        let equals = type.functionUnits().firstOrNull({ _.name == "equalsIgnoreCase" })
        let statements = equals.statements()
        let returnedObject = (Object)statements.first
        let returned = (BoundReturnStatement)returnedObject

        expect(returned.value.semanticType.value()).toBe("primitive:Bool")
        let comparisonObject = (Object)returned.value
        let comparison = (BoundBinaryExpression)comparisonObject
        let callObject = (Object)comparison.left
        let call = (BoundCallExpression)callObject
        let receiverObject = (Object)call.receiver
        let chainedReceiver = (BoundCallExpression)receiverObject

        expect(chainedReceiver.semanticType.value()).toBe(type.semanticType.value())
        expect(chainedReceiver.range.startTokenIndex).toBe(34)
        expect(call.target.name).toBe("compareTo")
        expect(call.target.ownerType.value()).toBe(type.semanticType.value())
    }

