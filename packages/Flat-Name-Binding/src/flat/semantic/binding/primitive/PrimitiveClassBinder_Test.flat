package flat/semantic/binding/primitive

import flat/compiler/models
import flat/parser/flat
import flat/bound
import flat/lexer/Lexer
import flat/semantic/types

testable class {
    test `binds reduced type slice`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:class-bind"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse(tokens(), snapshot)
        let bound = PrimitiveClassBinder().bind(syntax, snapshot)
        let result = bound.typeUnit
        let functions = result.functionUnits()
        let constructor = functions.first
        let statements = constructor.statements()
        let assignmentObject = (Object)statements.first
        let assignment = (BoundMemberAssignmentStatement)assignmentObject

        expect(result.fieldUnits().first.name).toBe("value")
        expect(constructor.constructorFunction).toBe(true)
        expect(assignment.target.memberName).toBe("value")
        expect(result.functionUnits().last.returnType.value()).toBe("primitive:Int")
    }

    test `binds merged overlay field with canonical identity type and range`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:overlay-field-bind"), "revision:one"
        )
        let overlaySnapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:overlay-field-bind.js"), "revision:one"
        )
        let canonical = PrimitiveClassParser().parse([
            token("class", false, 1), token("Buffer", false, 7), token("{", true, 14),
            token("visible", false, 16), token("Char", false, 24),
            token("[", true, 28), token("]", true, 29), token("data", false, 31),
            token("}", true, 36)
        ], snapshot)
        let overlay = PrimitiveClassParser().parse([
            token("class", false, 1), token("Buffer", false, 7), token("{", true, 14),
            token("visible", false, 16), token("native_array", false, 24),
            token("native", false, 37), token("Char", false, 44),
            token("[", true, 48), token("]", true, 49), token("data", false, 51),
            token("}", true, 56)
        ], overlaySnapshot)
        let field = PrimitiveClassBinder().bind(
            canonical.mergedWith(overlay), snapshot
        ).typeUnit.fieldUnits().first

        expect(field.identity.declaration.syntaxIdentity.snapshot).toBe(snapshot)
        expect(field.range.snapshot).toBe(snapshot)
        expect(field.semanticType.kind()).toBe("array")
        expect(field.semanticType.value()).toBe("array:1:primitive:Char")
    }

    test `binds structured receiver member compound assignment`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:member-compound-bind"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse([
            token("class", false, 1), token("Counter", false, 7), token("{", true, 15),
            token("Int", false, 17), token("value", false, 21), token(";", true, 26),
            token("public", false, 28),
            token("increase", false, 39), token("(", true, 47), token("Int", false, 48),
            token("amount", false, 52), token(")", true, 58), token("{", true, 60),
            token("this", false, 62), token(".", true, 66), token("value", false, 67),
            token("+=", true, 73), token("amount", false, 76), token("}", true, 83),
            token("}", true, 85)
        ], snapshot)
        let type = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let functions = type.functionUnits()
        let method = functions.last
        let statements = method.statements()
        let statementObject = (Object)statements.first
        let assignment = (BoundMemberAssignmentStatement)statementObject

        expect(assignment.target.memberName).toBe("value")
        expect(assignment.value.expressionKind()).toBe("binary")
    }

    test `binds non Bool receiver negation through explicit truthiness conversion`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:receiver-truthiness"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse([
            token("class", false, 1), token("Value", false, 7), token("{", true, 13),
            token("public", false, 15), token("empty", false, 22),
            token("(", true, 27), token(")", true, 28), token("->", true, 30),
            token("Bool", false, 33), token("=>", true, 38), token("!", true, 41),
            token("this", false, 42), token("}", true, 47)
        ], snapshot)
        let type = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let functions = type.functionUnits()
        let statements = functions.last.statements()
        let returnedObject = (Object)statements.first
        let returned = (BoundReturnStatement)returnedObject
        let unary = (BoundUnaryExpression)returned.value

        expect(unary.semanticType.value()).toBe("primitive:Bool")
        expect(unary.operand.expressionKind()).toBe("conversion")
    }

    test `binds static native namespace member call without instance receiver`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:static-native-member"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse([
            token("class", false, 1), token("Numbers", false, 7), token("{", true, 15),
            token("public", false, 17), token("static", false, 24),
            token("absolute", false, 31), token("(", true, 39), token("Long", false, 40),
            token("value", false, 45), token(")", true, 50), token("=>", true, 52),
            token("Math", false, 55), token(".", true, 59), token("abs", false, 60),
            token("(", true, 63), token("value", false, 64), token(")", true, 69),
            token("}", true, 71)
        ], snapshot)
        let type = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let functions = type.functionUnits()
        let statements = functions.last.statements()
        let returnedObject = (Object)statements.first
        let returned = (BoundReturnStatement)returnedObject

        expect(returned.value.expressionKind()).toBe("native-call")
        expect(returned.value.semanticType.value()).toBe("primitive:Long")
    }

    test `binds self primitive metadata to its declaration identity`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-class-metadata"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse([
            token("class", false, 1), token("Bool", false, 7), token("{", true, 12),
            token("public", false, 14), token("equals", false, 21),
            token("(", true, 27), token("Object", false, 28), token("other", false, 35),
            token(")", true, 40), token("=>", true, 42), token("other", false, 45),
            token(".", true, 50), token("class", false, 51), token(".", true, 56),
            token("isOfType", false, 57), token("(", true, 65), token("Bool", false, 66),
            token(".", true, 70), token("class", false, 71), token(")", true, 76),
            token("}", true, 78)
        ], snapshot)
        let type = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let method = type.functionUnits().last
        let statements = method.statements()
        let returnedObject = (Object)statements.first
        let returned = (BoundReturnStatement)returnedObject
        let expressionObject = (Object)returned.value
        let typeTest = (BoundTypeTestExpression)expressionObject

        expect(typeTest.typeMetadata.referencedType.declarationIdentity).toBe(type.identity)
    }

    test `binds null initialized reference field as nullable`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:nullable-field"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse([
            token("class", false, 1), token("App", false, 7), token("{", true, 11),
            token("static", false, 13), token("String", false, 20),
            token("name", false, 27), token("=", true, 32),
            token("null", false, 34, Token.Type.NULL), token("}", true, 39)
        ], snapshot)
        let field = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit.fieldUnits().first

        expect(field.staticField).toBe(true)
        expect(field.semanticType.kind()).toBe("nullable")
        expect(field.initializer.semanticType.kind()).toBe("null")

        var Bool rejected
        try {
            let invalid = PrimitiveClassParser().parse([
                token("class", false, 1), token("Bad", false, 7), token("{", true, 11),
                token("Int", false, 13), token("value", false, 17), token("=", true, 23),
                token("null", false, 25, Token.Type.NULL), token("}", true, 30)
            ], snapshot)
            PrimitiveClassBinder().bind(invalid, snapshot)
        } catch (Exception error) { rejected = true }
        expect(rejected).toBe(true)
    }

    test `binds structured static method body`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:structured-static-method"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse([
            token("class", false, 1), token("Math", false, 7), token("{", true, 12),
            token("public", false, 14), token("static", false, 21),
            token("gcd", false, 28), token("(", true, 31), token("Int", false, 32),
            token("a", false, 36), token(",", true, 37), token("Int", false, 39),
            token("b", false, 43), token(")", true, 44), token("->", true, 46),
            token("Int", false, 49), token("{", true, 53), token("let", false, 55),
            token("r", false, 59), token("=", true, 61),
            token("a", false, 63), token("%", true, 65), token("b", false, 67),
            token(";", true, 68), token("if", false, 70), token("(", true, 73),
            token("r", false, 74), token("==", true, 76),
            token("0", false, 79, Token.Type.INTEGER), token(")", true, 80),
            token("{", true, 82), token("return", false, 84), token("b", false, 91),
            token(";", true, 92), token("}", true, 94), token("return", false, 96),
            token("r", false, 103),
            token(";", true, 112), token("}", true, 114), token("}", true, 116)
        ], snapshot)
        let method = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit.functionUnits().last

        expect(method.statements().map({ _.unitKind() })).toBe([
            "local-declaration", "if", "return"
        ])
        expect(method.returnType.value()).toBe("primitive:Int")
    }

    async test `binds primitive wrapper comparison through value field`() {
        let source = "class Float { construct(public Float value) {} " +
            "equals(Object other) => (Float)other == value }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let tokens = stream.consumeAll<Token>("data")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-wrapper-comparison"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse(tokens, snapshot)
        let type = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let method = type.functionUnits().firstOrNull({ _.name == "equals" })
        let statements = method.statements()
        let returnObject = (Object)statements.first
        let returned = (BoundReturnStatement)returnObject
        let expressionObject = (Object)returned.value
        let comparison = (BoundBinaryExpression)expressionObject

        expect(comparison.left.expressionKind()).toBe("member-access")
        expect(comparison.right.expressionKind()).toBe("member-access")
        expect(comparison.right.semanticType.value()).toBe("primitive:Float")
    }

    async test `infers fallback method return through switch body`() {
        let source = "class Char { static isWhitespace(Char value) => false { " +
            "switch value { ' ' => fallthrough '\\n' => return true } } }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let tokens = stream.consumeAll<Token>("data")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:switch-fallback-bind"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse(tokens, snapshot)
        let type = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let method = type.functionUnits().firstOrNull({ _.name == "isWhitespace" })

        expect(method.returnType.value()).toBe("primitive:Bool")
    }

    async test `binds interpolated String repeat intrinsic`() {
        var String source = "class Char { static repeat(Char value, Int times) => \""
        source += '#'
        source += "value\".repeat(times) }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let tokens = stream.consumeAll<Token>("data")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:string-repeat-intrinsic"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse(tokens, snapshot)
        let type = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let method = type.functionUnits().firstOrNull({ _.name == "repeat" })
        let statements = method.statements()
        let returnObject = (Object)statements.first
        let returned = (BoundReturnStatement)returnObject

        expect(returned.value.expressionKind()).toBe("intrinsic-member-call")
        expect(returned.value.semanticType.value()).toBe("builtin:String")
    }

    test `binds unqualified constructor field assignment to canonical member`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:constructor-field"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse([
            token("class", false, 1), token("Counter", false, 7), token("{", true, 15),
            token("Int", false, 17), token("count", false, 21),
            token("construct", false, 27), token("(", true, 36), token("Int", false, 37),
            token("value", false, 41), token(")", true, 46), token("{", true, 48),
            token("count", false, 50), token("=", true, 56), token("value", false, 58),
            token("}", true, 64), token("}", true, 66)
        ], snapshot)
        let type = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let constructor = type.functionUnits().first
        let statements = constructor.statements()
        let statementObject = (Object)statements.first
        let assignment = (BoundMemberAssignmentStatement)statementObject

        expect(assignment.target.memberIdentity).toBe(type.fieldUnits().first.identity)
        expect(assignment.value.expressionKind()).toBe("reference")
    }

    test `binds required method contract`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:abstract-bind"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse([
            token("abstract", false, 1), token("class", false, 10),
            token("Number", false, 16), token("{", true, 23),
            token("public", false, 25), token("abstract", false, 32),
            token("plus", false, 41), token("(", true, 45), token("Long", false, 46),
            token("other", false, 51), token(")", true, 56), token("->", true, 58),
            token("Long", false, 61), token("}", true, 66)
        ], snapshot)
        let method = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit.functionUnits().last

        expect(method.abstractFunction).toBe(true)
        expect(method.statements().count).toBe(0)
        expect(method.returnType.value()).toBe("primitive:Long")
    }

    test `binds static method parameters without an instance receiver`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:static-class-bind"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse([
            token("class", false, 1), token("Object", false, 7), token("{", true, 14),
            token("public", false, 16), token("static", false, 23),
            token("referenceEquals", false, 30), token("(", true, 45),
            token("Object", false, 46), token("one", false, 53), token(",", true, 56),
            token("Object", false, 58), token("two", false, 65), token(")", true, 68),
            token("->", true, 70), token("Bool", false, 73), token("{", true, 78),
            token("return", false, 80), token("true", false, 87, Token.Type.BOOL),
            token(";", true, 91), token("}", true, 93), token("}", true, 95)
        ], snapshot)
        let method = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit.functionUnits().last

        expect(method.staticFunction).toBe(true)
        expect(method.name).toBe("referenceEquals")
        expect(method.parameterValues().count).toBe(2)
        expect(method.returnType.value()).toBe("primitive:Bool")
    }

    test `binds initialized visible field default parameter and target native constructor`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:exception-bind"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse(exceptionTokens(), snapshot)
        let bound = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let field = bound.fieldUnits().first
        let constructor = bound.functionUnits().first
        let statements = constructor.statements()

        expect(field.visibleField).toBe(true)
        expect(field.initializer.expressionKind()).toBe("literal")
        expect(constructor.parameterValues().first.defaultValue.expressionKind()).toBe("literal")
        expect(statements.first.unitKind()).toBe("member-assignment")
        expect(statements.last.unitKind()).toBe("expression")
        let statementObject = (Object)statements.last
        let nativeStatement = (BoundExpressionStatement)statementObject
        expect(nativeStatement.expression.semanticType.value()).toBe("unit")
    }

    test `synthesizes visible constructor parameter field and initialization`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:visible-constructor-bind"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse(visibleConstructorTokens(), snapshot)
        let type = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let field = type.fieldUnits().first
        let constructor = type.functionUnits().first
        let statements = constructor.statements()
        let statementObject = (Object)statements.first
        let assignment = (BoundMemberAssignmentStatement)statementObject
        let valueObject = (Object)assignment.value
        let value = (BoundReferenceExpression)valueObject

        expect(type.fieldUnits().count).toBe(1)
        expect(field.name).toBe("message")
        expect(field.visibleField).toBe(true)
        expect(field.initializer).toBe(null)
        expect(assignment.target.memberIdentity).toBe(field.identity)
        expect(value.symbolIdentity).toBe(constructor.parameterValues().first.identity)
        expect(constructor.parameterValues().first.defaultValue.expressionKind()).toBe("literal")
    }

    test `rejects visible constructor parameter that duplicates explicit field`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:visible-constructor-duplicate"), "revision:one"
        )
        var rejected = false
        try {
            PrimitiveClassBinder().bind(
                PrimitiveClassParser().parse(visibleConstructorDuplicateTokens(), snapshot),
                snapshot
            )
        } catch (Exception error) { rejected = true }
        expect(rejected).toBe(true)
    }

    test `rejects non es6 target native constructor`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:exception-target-invalid"), "revision:one"
        )
        let values = exceptionTokens()
        values[20] = token("c", false, 88)
        var rejected = false
        try {
            PrimitiveClassBinder().bind(PrimitiveClassParser().parse(values, snapshot), snapshot)
        } catch (Exception error) { rejected = true }
        expect(rejected).toBe(true)
    }

    test `binds generic parameter metadata and memoizes reified instantiation`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:generic-bind"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse(genericTokens(), snapshot)
        let bound = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let memo = GenericInstantiationMemo(2)
        let first = PrimitiveGenericClassBinder().instantiate(
            syntax, snapshot, SemanticTypes.intType(), memo
        )
        let second = PrimitiveGenericClassBinder().instantiate(
            syntax, snapshot, SemanticTypes.intType(), memo
        )
        expect(bound.fieldUnits().first.semanticType.kind()).toBe("generic-parameter")
        let reified = first.metadata().firstOrNull((metadata) =>
            metadata.metadataKind == "reified" && metadata.value.equals("primitive:Int")
        )
        expect(reified != null).toBe(true)
        expect(second.metadata().last.value).toBe(first.metadata().last.value)
        expect(memo.count).toBe(1)
    }

    test `rejects non generic instantiation and bounded memo overflow`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:generic-invalid"), "revision:one"
        )
        var Int rejected
        try {
            PrimitiveGenericClassBinder().instantiate(
                PrimitiveClassParser().parse(tokens(), snapshot), snapshot,
                SemanticTypes.intType(), GenericInstantiationMemo(1)
            )
        } catch (Exception error) { rejected++ }
        try {
            let syntax = PrimitiveClassParser().parse(genericTokens(), snapshot)
            let memo = GenericInstantiationMemo(1)
            PrimitiveGenericClassBinder().instantiate(syntax, snapshot, SemanticTypes.intType(), memo)
            PrimitiveGenericClassBinder().instantiate(syntax, snapshot, SemanticTypes.stringType(), memo)
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
    }

    genericTokens() -> Token[] {
        return [
            token("class", false, 1), token("Box", false, 7), token("<", true, 10),
            token("T", false, 11), token(">", true, 12), token("{", true, 14),
            token("T", false, 16), token("value", false, 18), token(";", true, 23),
            token("constructor", false, 25), token("(", true, 36), token("T", false, 37),
            token("value", false, 39), token(")", true, 44), token("{", true, 46),
            token("this", false, 48), token(".", true, 52), token("value", false, 53),
            token("=", true, 59), token("value", false, 61), token(";", true, 66),
            token("}", true, 68), token("get", false, 70), token("(", true, 73),
            token(")", true, 74), token("->", true, 76), token("T", false, 79),
            token("{", true, 81), token("return", false, 83), token("this", false, 90),
            token(".", true, 94), token("value", false, 95), token(";", true, 100),
            token("}", true, 102), token("}", true, 104)
        ]
    }

    async test `binds native array data and count projections in constructor expressions`() {
        let source = "class Buffer { Char[] stored; Int count; " +
            "construct(native_array Char[] data) { stored = data.data; count = data.count; } }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let sourceTokens = stream.consumeAll<Token>("data")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:native-array-projection-bind"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(sourceTokens, snapshot), snapshot
        ).typeUnit
        expect(type.functionUnits().first.statements().first.unitKind())
            .toBe("member-assignment")
        expect(type.functionUnits().first.statements().count).toBe(2)
    }

    async test `selects non primary package constructor for StringCharArray argument`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:constructor-overload-bind"), "revision:one"
        )
        let charArrayStream = Lexer().lex(
            "class StringCharArray { construct() {} " +
                "toString() => String(this) }"
        )
        charArrayStream.emit("start")
        let stringCharArray = PrimitiveClassParser().parse(
            charArrayStream.consumeAll<Token>("data"), snapshot
        )
        let stringStream = Lexer().lex(
            "class String { construct(Char[] chars) {} " +
                "construct(StringCharArray chars) {} }"
        )
        stringStream.emit("start")
        let stringType = PrimitiveClassParser().parse(
            stringStream.consumeAll<Token>("data"), snapshot
        )
        let types = PrimitiveClassPartitionBinder().bind(
            [stringCharArray, stringType], snapshot
        ).typeUnits()
        let owner = types.firstOrNull({ _.identity.name == "StringCharArray" })
        expect(owner.functionUnits().firstOrNull({ _.name == "toString" })
            .statements().first.unitKind()).toBe("return")
    }

    async test `binds field sized array local and indexed copy loop`() {
        let source = "class Buffer { Int count; Char[] data; " +
            "copy() -> Char[] { let array = Array<Char>(count); " +
            "for (i in 0..count) { array[i] = data[i]; } return array; } }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let sourceTokens = stream.consumeAll<Token>("data")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:field-sized-array-copy"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(sourceTokens, snapshot), snapshot
        ).typeUnit
        let method = type.functionUnits().firstOrNull({ _.name == "copy" })

        expect(method.returnType.value()).toBe("array:1:primitive:Char")
        expect(method.statements().count).toBe(3)
        expect(method.statements().first.unitKind()).toBe("local-declaration")
        expect(method.statements()[1].unitKind()).toBe("foreach")
    }

    async test `binds typed array override accessors and indexed use`() {
        let source = "class Buffer { Char[] data; " +
            "this[Int index] -> Char { get { return data[index] } " +
            "set { data[index] = value } } " +
            "read(Int index) -> Char { return this[index] } " +
            "write(Int index, Char value) { this[index] = value } }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let sourceTokens = stream.consumeAll<Token>("data")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:array-override-bind"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(sourceTokens, snapshot), snapshot
        ).typeUnit
        expect(type.functionUnits().any({ _.name == "getAt" })).toBe(true)
        expect(type.functionUnits().any({ _.name == "setAt" })).toBe(true)
        expect(type.functionUnits().firstOrNull({ _.name == "getAt" }).returnType.value())
            .toBe("primitive:Char")
        expect(type.functionUnits().firstOrNull({ _.name == "getAt" }).parameterValues().count)
            .toBe(1)
        expect(type.functionUnits().firstOrNull({ _.name == "setAt" }).returnType.value())
            .toBe("unit")
        expect(type.functionUnits().firstOrNull({ _.name == "setAt" }).parameterValues().count)
            .toBe(2)
    }

    test `rejects invalid reduced type bindings`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:class-bind-invalid"), "revision:one"
        )
        var Int rejected
        try {
            let values = tokens()
            values[14] = token("missing", false, 54)
            PrimitiveClassBinder().bind(PrimitiveClassParser().parse(values, snapshot), snapshot)
        } catch (Exception error) { rejected++ }
        try {
            let values = tokens()
            values[8] = token("String", false, 36)
            PrimitiveClassBinder().bind(PrimitiveClassParser().parse(values, snapshot), snapshot)
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
    }

    visibleConstructorTokens() -> Token[] {
        return [
            token("class", false, 1), token("Exception", false, 7), token("{", true, 17),
            token("construct", false, 19), token("(", true, 28), token("visible", false, 29),
            token("String", false, 37), token("message", false, 44), token("=", true, 52),
            stringToken("''", 54), token(")", true, 56), token("{", true, 58),
            token("}", true, 59), token("}", true, 61)
        ]
    }

    visibleConstructorDuplicateTokens() -> Token[] {
        return [
            token("class", false, 1), token("Exception", false, 7), token("{", true, 17),
            token("String", false, 19), token("message", false, 26), token(";", true, 33),
            token("construct", false, 35), token("(", true, 44), token("visible", false, 45),
            token("String", false, 53), token("message", false, 60), token(")", true, 67),
            token("{", true, 69), token("}", true, 70), token("}", true, 72)
        ]
    }

    exceptionTokens() -> Token[] {
        return [
            token("class", false, 1), token("Exception", false, 7), token("{", true, 17),
            token("visible", false, 19), token("String", false, 27), token("message", false, 34),
            token("=", true, 42), stringToken("''", 44), token(";", true, 46),
            token("construct", false, 48), token("(", true, 57), token("String", false, 58),
            token("message", false, 65), token("=", true, 73), stringToken("''", 75),
            token(")", true, 77), token("{", true, 79), token("native", false, 81),
            token("[", true, 87), token("es6", false, 88), token("]", true, 91),
            token("Math", false, 93), token(".", true, 97), token("max", false, 98),
            token("(", true, 101), token("1", false, 102, Token.Type.INTEGER),
            token(",", true, 103), token("2", false, 105, Token.Type.INTEGER),
            token(")", true, 106), token(";", true, 107), token("}", true, 109),
            token("}", true, 111)
        ]
    }

    tokens() -> Token[] {
        return [
            token("class", false, 1), token("Box", false, 7), token("{", true, 11),
            token("Int", false, 13), token("value", false, 17), token(";", true, 22),
            token("constructor", false, 24), token("(", true, 35), token("Int", false, 36), token("value", false, 40),
            token(")", true, 45), token("{", true, 47), token("this", false, 49), token(".", true, 53),
            token("value", false, 54), token("=", true, 60), token("value", false, 62), token(";", true, 67),
            token("}", true, 69), token("get", false, 71), token("(", true, 74), token(")", true, 75),
            token("->", true, 77), token("Int", false, 80), token("{", true, 84), token("return", false, 86),
            token("this", false, 93), token(".", true, 97), token("value", false, 98), token(";", true, 103),
            token("}", true, 105), token("}", true, 107)
        ]
    }

    stringToken(String value, Int column) -> Token => Token(
        value: value, type: Token.Type.STRING,
        location: Location(lineNumber: 1, column: column)
    )

    token(
        String value,
        Bool symbol,
        Int column,
        Int explicitType = Token.Type.IDENTIFIER
    ) -> Token {
        let type = symbol ? Token.Type.SYMBOL : explicitType
        return Token(value: value, type: type,
            location: Location(lineNumber: 1, column: column))
    }
}
