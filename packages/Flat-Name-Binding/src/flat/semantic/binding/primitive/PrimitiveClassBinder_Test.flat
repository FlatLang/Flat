    test `binds initialized visible field default parameter and target native constructor`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:exception-bind"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse(exceptionTokens(), snapshot)
        let bound = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let field = bound.fieldUnits().first
        let constructor = bound.functionUnits().first
        let statements = constructorBody(bound, constructor)
        let fieldStage = bound.functionUnits().firstOrNull((function) => function.identity.value == constructor.constructorPlan.fieldInitializer.value)

        expect(field.visibleField).toBe(true)
        expect(field.initializer.expressionKind()).toBe("literal")
        expect(constructor.parameterValues().first.defaultValue.expressionKind()).toBe("literal")
        expect(fieldStage.statements().first.unitKind()).toBe("member-assignment")
        expect(statements.last.unitKind()).toBe("expression")
        let statementObject = (Object)statements.last
        let nativeStatement = (BoundExpressionStatement)statementObject
        expect(nativeStatement.expression.semanticType.value()).toBe("unit")
    }

    test `synthesizes visible constructor parameter field and initialization`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:visible-constructor-bind"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse(visibleConstructorTokens(), snapshot)
        let type = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let field = type.fieldUnits().first
        let constructor = type.functionUnits().first
        let statements = constructorBody(type, constructor)
        let statementObject = (Object)statements.first
        let assignment = (BoundMemberAssignmentStatement)statementObject
        let valueObject = (Object)assignment.value
        let value = (BoundReferenceExpression)valueObject

        expect(type.fieldUnits().count).toBe(1)
        expect(field.name).toBe("message")
        expect(field.visibleField).toBe(true)
        expect(field.initializer).toBe(null)
        expect(assignment.target.memberIdentity).toBe(field.identity)
        let helperIdentity = BoundConstructorPlan.bodyInitializerIdentity(constructor.identity)
        let helper = type.functionUnits().firstOrNull((function) => function.identity.value == helperIdentity.value)
        expect(value.symbolIdentity).toBe(helper.parameterValues().first.identity)
        expect(constructor.parameterValues().first.defaultValue.expressionKind()).toBe("literal")

        let overloaded = PrimitiveClassParser().parse([
            token("class", false, 1), token("Range", false, 7), token("{", true, 13),
            token("construct", false, 15), token("(", true, 24), token(")", true, 25),
            token("{", true, 27), token("}", true, 28),
            token("construct", false, 30), token("(", true, 39),
            token("public", false, 40), token("Int", false, 47),
            token("start", false, 51), token(")", true, 56),
            token("{", true, 58), token("}", true, 59), token("}", true, 61)
        ], snapshot)
        let overloadedType = PrimitiveClassBinder().bind(overloaded, snapshot).typeUnit
        expect(overloadedType.fieldUnits().first.name).toBe("start")
        expect(overloadedType.functionUnits().last.statements().first.unitKind()).toBe(
            "member-assignment"
        )
    }

