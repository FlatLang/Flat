package flat/semantic/binding/primitive

import flat/compiler/models
import flat/parser/flat
import flat/bound
import flat/lexer/Lexer
import flat/semantic/types

testable class {
    constructorBody(BoundTypeUnit owner, BoundFunctionUnit constructor) -> BoundStatement[] {
        let identity = BoundConstructorPlan.bodyInitializerIdentity(constructor.identity)
        return owner.functionUnits().firstOrNull((function) => function.identity.value == identity.value).statements()
    }

    async test `declared null guard retains structured equality without nullable storage`() {
        let stream = Lexer().lex("class StringCharArray { visible Int count; public equals(StringCharArray other) -> Bool { if (other == null) { return false; } if (count != other.count) { return false; } return true; } public present() -> Bool => this != null }")
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:char-array-null-guard"), "one")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let unit = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let method = unit.functionUnits().firstOrNull((function) => function.name == "equals")
        let statements = method.statements()
        Object guardSource = statements.first
        BoundIfStatement guard = (BoundIfStatement)guardSource
        Object binarySource = guard.condition
        BoundBinaryExpression binary = (BoundBinaryExpression)binarySource
        expect(binary.operator).toBe("==")
        expect(binary.semanticType.value()).toBe(SemanticTypes.boolType().value())
        expect(binary.left.semanticType.value()).toBe(unit.semanticType.value())
        expect(binary.left.expressionKind()).toBe("reference")
        expect(binary.right.semanticType.kind()).toBe("null")
        let sourceMethod = syntax.methodValues().firstOrNull((function) => function.name == "equals")
        let sourceStatements = sourceMethod.statements()
        Object sourceGuardValue = sourceStatements.first
        PrimitiveIfSyntax sourceGuard = (PrimitiveIfSyntax)sourceGuardValue
        expect(binary.range).toBe(sourceGuard.condition.range)
        expect(TypeConversions.classify(SemanticTypes.nullType(), unit.semanticType).applicable).toBe(false)
        let invalidStream = Lexer().lex("class StringCharArray { public invalid() { StringCharArray value = null; } }")
        invalidStream.emit("start")
        let invalid = PrimitiveClassParser().parse(invalidStream.consumeAll<Token>("data"), snapshot)
        var Bool rejected
        try { PrimitiveClassBinder().bind(invalid, snapshot) }
        catch (Exception error) { rejected = true }
        expect(rejected).toBe(true)
    }

    async test `conditional return context cannot authorize numeric narrowing`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:conditional-context-narrowing"), "one")
        let stream = Lexer().lex("class Box { visible Double value; public read(Bool choose) -> Int => choose ? this.value : 1 }")
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        var Bool rejected
        try { PrimitiveClassBinder().bind(syntax, snapshot) }
        catch (Exception error) { rejected = true }
        expect(rejected).toBe(true)
        let explicitStream = Lexer().lex("class Box { visible Double value; public read(Bool choose) -> Int => choose ? (Int)this.value : 1 }")
        explicitStream.emit("start")
        let explicitSyntax = PrimitiveClassParser().parse(explicitStream.consumeAll<Token>("data"), snapshot)
        let unit = PrimitiveClassBinder().bind(explicitSyntax, snapshot).typeUnit
        let method = unit.functionUnits().firstOrNull((function) => function.name == "read")
        let statements = method.statements()
        Object returnSource = statements.first
        BoundReturnStatement returned = (BoundReturnStatement)returnSource
        Object conditionalSource = returned.value
        BoundConditionalExpression conditional = (BoundConditionalExpression)conditionalSource
        Object castSource = conditional.whenTrue
        BoundConversionExpression cast = (BoundConversionExpression)castSource
        expect(cast.conversion.conversionKind).toBe("numeric-cast")
        expect(cast.conversion.implicit).toBe(false)
        expect(conditional.semanticType.value()).toBe(SemanticTypes.intType().value())
    }

    async test `plain local assignment still rejects numeric narrowing`() {
        let stream = Lexer().lex("class Box { static run() -> Int { var Int value = 7; value = 2.5; return value; } }")
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:plain-local-narrow"), "one")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        var Bool rejected
        try { PrimitiveClassBinder().bind(syntax, snapshot) }
        catch (Exception error) { rejected = true }
        expect(rejected).toBe(true)
    }
    async test `local compound narrowing retains numeric cast evidence`() {
        let stream = Lexer().lex("class Box { static run() -> Int { var Int value = -7; value -= 2.5; return value; } }")
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:local-compound-narrow"), "one")
        let type = PrimitiveClassBinder().bind(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot), snapshot).typeUnit
        let method = type.functionUnits().firstOrNull({ _.name == "run" })
        let statementObject = method.statements()[1]
        let assignment = (BoundAssignmentStatement)statementObject
        expect(assignment.conversion.conversionKind).toBe("numeric-cast")
    }
    async test `compound field statement retains one receiver evaluation`() {
        let stream = Lexer().lex("class Box { visible Int count; static run(func()->Box next) -> Int { next().count += 2; return 0; } }")
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:compound-receiver-once"), "one")
        let type = PrimitiveClassBinder().bind(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot), snapshot).typeUnit
        let method = type.functionUnits().firstOrNull({ _.name == "run" })
        let statementObject = method.statements().first
        expect(statementObject.unitKind()).toBe("expression")
        let statement = (BoundExpressionStatement)statementObject
        expect(statement.expression.expressionKind()).toBe("evaluation")
        Object evaluationSource = statement.expression
        BoundEvaluationExpression evaluation = (BoundEvaluationExpression)evaluationSource
        let setup = evaluation.setup()
        expect(setup.count).toBe(3)
        Object receiverSource = setup.first
        BoundLocalDeclarationStatement retained = (BoundLocalDeclarationStatement)receiverSource
        expect(retained.initializer.expressionKind()).toBe("function-invocation")
        Object writeSource = setup.last
        BoundMemberAssignmentStatement write = (BoundMemberAssignmentStatement)writeSource
        Object referenceSource = write.target.receiver
        BoundReferenceExpression reference = (BoundReferenceExpression)referenceSource
        expect(reference.symbolIdentity.value).toBe(retained.local.symbolIdentity.value)
    }
    async test `binds explicit local field assignment in static method`() {
        let stream = Lexer().lex("class Box { visible Int count; static run(Box value) -> Int { value.count = 7; return (value.count += 2); } }")
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:static-local-field-store"), "one")
        let type = PrimitiveClassBinder().bind(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot), snapshot).typeUnit
        let method = type.functionUnits().firstOrNull({ _.name == "run" })
        let statementObject = method.statements().first
        let assignment = (BoundMemberAssignmentStatement)statementObject
        expect(assignment.target.memberName).toBe("count")
        expect(assignment.target.receiver.expressionKind()).toBe("reference")
    }
    async test `safe field access publishes nullable selected field`() {
        let stream = Lexer().lex("class Box { visible Int count; static run(Box value) -> Int { return value?.count ?: 0; } }")
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:safe-field-binding"), "one")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let bound = PrimitiveClassPartitionBinder().bind([syntax], snapshot).typeUnits().first
        let method = bound.functionUnits().firstOrNull({ _.name == "run" })
        let statementObject = method.statements().first
        let returned = (BoundReturnStatement)statementObject
        let expressionObject = returned.value
        let fallback = (BoundBinaryExpression)expressionObject
        expect(fallback.left.semanticType.kind()).toBe("nullable")
    }
    async test `safe syntax cannot silently bind as ordinary dereference`() {
        let sources = ["class Box { read() -> Int { return 1; } static run(Box value) -> Int { return value?.read(); } }"]
        for (source in sources) {
            let stream = Lexer().lex(source)
            stream.emit("start")
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:safe-binding"), "one")
            let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
            var String failure
            try { PrimitiveClassBinder().bind(syntax, snapshot) }
            catch (Exception error) { failure = error.message }
            expect(failure != null).toBe(true)
            expect(failure.contains("cannot return")).toBe(true)
        }
    }
    async test `publishes lazy static getter semantics`() {
        let stream = Lexer().lex("class Cache { visible static lazy Int value => 7 }")
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:lazy-binding"), "one")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let bound = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        expect(bound.functionUnits().firstOrNull({ _.name == "value" }).lazyProperty).toBe(true)
        let partition = PrimitiveClassPartitionBinder().bind([syntax], snapshot).typeUnits().first
        expect(partition.functionUnits().firstOrNull({ _.name == "value" }).lazyProperty).toBe(true)
    }
    async test `rejects scalar native storage in direct binding`() {
        let sources = ["class Buffer { visible native_array Int data; }",
            "class Buffer { construct(native_array Int data) {} }",
            "class Buffer { run(native_array Int data) -> Void {} }",
            "class Buffer { run() -> Void { native_array Int data; } }"]
        for (source in sources) {
            let stream = Lexer().lex(source)
            stream.emit("start")
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:direct-native-storage"), "one")
            var String failure
            try { PrimitiveClassBinder().bind(
                PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot), snapshot
            ) } catch (Exception error) { failure = error.message }
            expect(failure != null).toBe(true)
        }
    }
    async test `rejects invalid prefix update operands`() {
        let sources = ["class Value { run(String i) -> String { return ++i; } }",
            "class Value { run() -> Int { return ++42; } }"]
        for (source in sources) {
            let stream = Lexer().lex(source)
            stream.emit("start")
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:invalid-prefix"), "one")
            var String failure
            try { PrimitiveClassBinder().bind(
                PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot), snapshot
            ) } catch (Exception error) { failure = error.message }
            expect(failure != null).toBe(true)
        }
    }
    async test `binds prefix local update result`() {
        let stream = Lexer().lex("class Value { run(Int i) -> Int { return ++i; } }")
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:prefix-local"), "one")
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot), snapshot
        ).typeUnit
        let statements = type.functionUnits().firstOrNull({ _.name == "run" }).statements()
        let statement = (Object)statements.first
        let returned = (BoundReturnStatement)statement
        expect(returned.value.expressionKind()).toBe("assignment-value")
    }
    async test `instantiates own generic method receiver`() {
        let stream = Lexer().lex("class Buffer<E> { construct(E value) {} echo(E value) -> E { return value; } run() -> Int { let buffer = Buffer<Int>(42); return buffer.echo(42); } }")
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:own-generic-method"), "one")
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot), snapshot
        ).typeUnit
        let statements = type.functionUnits().firstOrNull({ _.name == "run" }).statements()
        let statement = (Object)statements.last
        let returned = (BoundReturnStatement)statement
        expect(returned.value.semanticType.value()).toBe(SemanticTypes.intType().value())
    }

    async test `instantiates own generic allocation`() {
        let stream = Lexer().lex("class Buffer<E> { construct(E value) {} run() -> Void { let value = Buffer<Int>(42); } }")
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:own-generic-allocation"), "one")
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot), snapshot
        ).typeUnit
        let method = type.functionUnits().firstOrNull({ _.name == "run" })
        let statements = method.statements()
        let statement = (Object)statements.first
        let local = (BoundLocalDeclarationStatement)statement
        expect(local.initializer.semanticType.kind()).toBe("generic-instance")
        let call = (BoundCallExpression)local.initializer
        expect(call.target.parameterTypes().first.value()).toBe(SemanticTypes.intType().value())
    }
    async test `rejects named arguments rather than dropping them in structured returns`() {
        let calls = ["this.pick(1, ignored: 2)", "pick(1, ignored: 2)"]
        for (call in calls) {
            let stream = Lexer().lex(
                "class Value { pick(Int value) -> Int { return value; } " +
                    "run() -> Int { let local = 0; return " + call + "; } }"
            )
            stream.emit("start")
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:structured-named-reject"), "one")
            var String failure
            try {
                PrimitiveClassBinder().bind(
                    PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot), snapshot
                )
            } catch (Exception error) { failure = error.message }
            expect(failure.contains("Named arguments require matching source-order parameters in structured expressions")).toBe(true)
        }
    }
    async test `binds source ordered named arguments in structured returns`() {
        let calls = ["this.pick(1, other: 2)", "pick(1, other: 2)",
            "this.pick(value: 1, other: 2)", "pick(value: 1, other: 2)"]
        for (call in calls) {
            let stream = Lexer().lex("class Value { pick(Int value, Int other) -> Int { return value + other; } pick(Bool value, Bool other) -> Int { return 99; } run() -> Int { let local = 0; return " + call + "; } }")
            stream.emit("start")
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:structured-named"), "one")
            let type = PrimitiveClassBinder().bind(
                PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot), snapshot
            ).typeUnit
            let method = type.functionUnits().firstOrNull({ _.name == "run" })
            let statements = method.statements()
            let returnedObject = (Object)statements.last
            let returned = (BoundReturnStatement)returnedObject
            let selected = (BoundCallExpression)returned.value
            expect(selected.target.parameterTypes().first.value()).toBe(SemanticTypes.intType().value())
            expect(selected.target.parameterTypes().last.value()).toBe(SemanticTypes.intType().value())
            expect(selected.argumentValues().count).toBe(2)
            expect(selected.receiver != null).toBe(true)
        }
    }

    async test `rejects incompatible named argument overload combinations`() {
        let calls = ["this.pick(1, other: true)", "pick(true, other: 2)"]
        for (call in calls) {
            let stream = Lexer().lex("class Value { pick(Int value, Int other) -> Int { return value + other; } pick(Bool value, Bool other) -> Int { return 99; } run() -> Int { let local = 0; return " + call + "; } }")
            stream.emit("start")
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:named-overload-invalid"), "one")
            var String failure
            try {
                PrimitiveClassBinder().bind(
                    PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot), snapshot
                )
            } catch (Exception error) { failure = error.message }
            expect(failure.contains("No overload of 'pick'")).toBe(true)
        }
    }

    async test `named structured call does not bypass shadowing local`() {
        let stream = Lexer().lex("class Value { pick(Int value) -> Int { return value; } run() -> Int { let pick = lambda(Int value) => value + 1; return pick(value: 41); } }")
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:named-local-shadow"), "one")
        var String failure
        try {
            PrimitiveClassBinder().bind(
                PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot), snapshot
            )
        } catch (Exception error) { failure = error.message }
        expect(failure.contains("Named arguments for local 'pick' require callable parameter binding")).toBe(true)
    }

    async test `binds native String constructor member assignment`() {
        let stream = Lexer().lex(
            "class Value { Int count; this chars; construct(this input) { " +
                "this.chars = input; } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:native-string-constructor-member"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot
        ).typeUnit
        let constructor = type.functionUnits().firstOrNull({ _.constructorFunction })

        expect(constructorBody(type, constructor).last.unitKind()).toBe("member-assignment")
    }

    async test `binds constructor local receiver field member access`() {
        let stream = Lexer().lex(
                "class Value { Int count; construct(this input) { count = input.count; } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:constructor-member-access-bind"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot
        ).typeUnit
        let constructor = type.functionUnits().firstOrNull({ _.constructorFunction })
        let statements = constructorBody(type, constructor)
        let assignmentObject = (Object)statements.first
        let assignment = (BoundMemberAssignmentStatement)assignmentObject
        let selectedObject = (Object)assignment.value
        let selected = (BoundMemberAccessExpression)selectedObject

        expect(selected.receiver.expressionKind()).toBe("reference")
        expect(selected.memberName).toBe("count")
        expect(selected.memberIdentity).toBe(type.fieldUnits().first.identity)
    }

    async test `binds native array constructor parameter count projection`() {
        let stream = Lexer().lex(
            "class Value { Int count; construct(native_array native Char[] chars) { " +
                "count = chars.count; } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:native-array-constructor-count"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot
        ).typeUnit
        let constructor = type.functionUnits().firstOrNull({ _.constructorFunction })
        let statements = constructorBody(type, constructor)
        let assignmentObject = (Object)statements.first
        let assignment = (BoundMemberAssignmentStatement)assignmentObject
        let projectedObject = (Object)assignment.value
        let projected = (BoundArrayLengthExpression)projectedObject
        let parameterObject = (Object)projected.receiver
        let parameter = (BoundReferenceExpression)parameterObject

        expect(projected.expressionKind()).toBe("array-length")
        expect(projected.range.startTokenIndex).toBe(18)
        expect(parameter.semanticType.kind()).toBe("array")
        expect(parameter.name).toBe("chars")
        expect(parameter.range.startTokenIndex).toBe(18)
    }

    async test `binds constructor local call to receiver method signature`() {
        let stream = Lexer().lex(
            "class Value { Int value; construct(Int input) { value = calculateSize(input); } " +
                "calculateSize(Int input) -> Int { return input; } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:constructor-local-call-bind"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot
        ).typeUnit
        let constructor = type.functionUnits().firstOrNull({ _.constructorFunction })
        let statements = constructorBody(type, constructor)
        let assignmentObject = (Object)statements.first
        let assignment = (BoundMemberAssignmentStatement)assignmentObject
        let callObject = (Object)assignment.value
        let call = (BoundCallExpression)callObject

        expect(call.receiver.expressionKind()).toBe("reference")
        expect(call.target.name).toBe("calculateSize")
        expect(call.target.ownerType.value()).toBe(type.semanticType.value())
        expect(call.argumentConversions().first.conversionKind).toBe("identity")
    }

    async test `binds callable invocation with implicit field array argument`() {
        let stream = Lexer().lex(
            "class Value { Char[] chars; transform(map(Char, Int) -> Char) -> Char { " +
                "return map(chars[0], 0); } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:callable-field-array"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot
        ).typeUnit
        let method = type.functionUnits().firstOrNull({ _.name == "transform" })
        let statements = method.statements()
        let returnedObject = (Object)statements.first
        let returned = (BoundReturnStatement)returnedObject
        let boundValue = returned.value

        expect(boundValue.expressionKind()).toBe("function-invocation")
        expect(boundValue.semanticType.value()).toBe("primitive:Char")
        expect(boundValue.range.snapshot).toBe(snapshot)
    }

    async test `reconciles intrinsic Char plus with declared String conditional branch`() {
        let stream = Lexer().lex(
            "class String { Char[] chars; this[Int index] -> Char { " +
                "get { return chars[index]; } } substring(Int start) -> String { " +
                "return this; } capitalize() -> String { return true ? " +
                "this[0].toUpperCase() + substring(1) : this; } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:declared-string-conditional"), "revision:one"
        )
        var Bool rejected
        try {
            let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot
        ).typeUnit
        } catch (Exception error) {
            rejected = error.message.contains("Text representation adapter unavailable")
        }
        expect(rejected).toBe(true)
    }

    async test `binds required Char conditional fallback with explicit conversion evidence`() {
        let stream = Lexer().lex(
            "class Value { first() -> Char { return true ? 'a' : 0; } }"
        )
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:char-conditional-bind"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot
        ).typeUnit
        let functions = type.functionUnits()
        let method = functions.firstOrNull({ _.name == "first" })
        let statements = method.statements()
        let returnedObject = (Object)statements.first
        let returned = (BoundReturnStatement)returnedObject
        let conditionalObject = (Object)returned.value
        let conditional = (BoundConditionalExpression)conditionalObject
        let fallbackObject = (Object)conditional.whenFalse
        let fallback = (BoundConversionExpression)fallbackObject

        expect(conditional.semanticType.value()).toBe("primitive:Char")
        expect(fallback.conversion.conversionKind).toBe("numeric-cast")
        expect(fallback.semanticType.value()).toBe("primitive:Char")
    }

    test `binds local object field access in structured expression`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:local-receiver-field-bind"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse([
            token("class", false, 1), token("Value", false, 7), token("{", true, 13),
            token("Int", false, 15), token("count", false, 19), token(";", true, 24),
            token("equals", false, 26), token("(", true, 32), token("this", false, 33),
            token("other", false, 39), token(")", true, 44), token("->", true, 46),
            token("Bool", false, 49), token("{", true, 54), token("return", false, 56),
            token("count", false, 63), token("==", true, 69), token("other", false, 72),
            token(".", true, 77), token("count", false, 78), token(";", true, 83),
            token("}", true, 85), token("}", true, 87)
        ], snapshot)
        let type = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let functions = type.functionUnits()
        let method = functions.firstOrNull({ _.name == "equals" })
        let statements = method.statements()
        let returnedObject = (Object)statements.first
        let returned = (BoundReturnStatement)returnedObject
        let comparisonObject = (Object)returned.value
        let comparison = (BoundBinaryExpression)comparisonObject
        let selectedObject = (Object)comparison.right
        let selected = (BoundMemberAccessExpression)selectedObject

        expect(selected.receiver.expressionKind()).toBe("reference")
        expect(selected.memberName).toBe("count")
        expect(selected.memberIdentity).toBe(type.fieldUnits().first.identity)
        expect(selected.semanticType.value()).toBe("primitive:Int")
    }

    test `binds reduced type slice`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:class-bind"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse(tokens(), snapshot)
        let bound = PrimitiveClassBinder().bind(syntax, snapshot)
        let result = bound.typeUnit
        let functions = result.functionUnits()
        let constructor = functions.first
        let statements = constructorBody(result, constructor)
        let assignmentObject = (Object)statements.first
        let assignment = (BoundMemberAssignmentStatement)assignmentObject

        expect(result.fieldUnits().first.name).toBe("value")
        expect(constructor.constructorFunction).toBe(true)
        expect(assignment.target.memberName).toBe("value")
        expect(result.functionUnits().last.returnType.value()).toBe("primitive:Int")
    }

    test `binds merged overlay field with canonical identity type and range`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:overlay-field-bind"), "revision:one"
        )
        let overlaySnapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:overlay-field-bind.js"), "revision:one"
        )
        let canonical = PrimitiveClassParser().parse([
            token("class", false, 1), token("Buffer", false, 7), token("{", true, 14),
            token("visible", false, 16), token("Char", false, 24),
            token("[", true, 28), token("]", true, 29), token("data", false, 31),
            token("}", true, 36)
        ], snapshot)
        let overlay = PrimitiveClassParser().parse([
            token("class", false, 1), token("Buffer", false, 7), token("{", true, 14),
            token("visible", false, 16), token("native_array", false, 24),
            token("native", false, 37), token("Char", false, 44),
            token("[", true, 48), token("]", true, 49), token("data", false, 51),
            token("}", true, 56)
        ], overlaySnapshot)
        let field = PrimitiveClassBinder().bind(
            canonical.mergedWith(overlay), snapshot
        ).typeUnit.fieldUnits().first

        expect(field.identity.declaration.syntaxIdentity.snapshot).toBe(snapshot)
        expect(field.range.snapshot).toBe(snapshot)
        expect(field.semanticType.kind()).toBe("array")
        expect(field.semanticType.value()).toBe("array:1:primitive:Char")
    }

    async test `overlay only field retains source snapshot despite equal base token positions`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:Class.flat"), "one")
        let overlaySnapshot = SourceSnapshotIdentity(SourceIdentity("memory:Class.js.flat"), "one")
        let baseStream = Lexer().lex("class Class { visible Int baseValue; }")
        baseStream.emit("start")
        let base = PrimitiveClassParser().parse(baseStream.consumeAll<Token>("data"), snapshot)
        let overlayStream = Lexer().lex("class Class { visible Int jsClass; }")
        overlayStream.emit("start")
        let overlay = PrimitiveClassParser().parse(overlayStream.consumeAll<Token>("data"), overlaySnapshot)
        let merged = base.mergedWith(overlay)
        let first = PrimitiveClassBinder().bind(merged, snapshot).typeUnit
        let second = PrimitiveClassBinder().bind(merged, snapshot).typeUnit
        let baseField = first.fieldUnits().firstOrNull({ _.name == "baseValue" })
        let overlayField = first.fieldUnits().firstOrNull({ _.name == "jsClass" })
        expect(baseField.range.startTokenIndex).toBe(overlayField.range.startTokenIndex)
        expect(first.identity.syntaxIdentity.snapshot).toBe(snapshot)
        expect(overlayField.canonicalOwner().value).toBe(first.identity.value)
        expect(baseField.canonicalOwner().value).toBe(first.identity.value)
        expect(baseField.range.snapshot).toBe(snapshot)
        expect(overlayField.range.snapshot).toBe(overlaySnapshot)
        expect(overlayField.identity.declaration.syntaxIdentity.snapshot).toBe(overlaySnapshot)
        expect(baseField.identity.value == overlayField.identity.value).toBe(false)
        expect(second.fieldUnits().firstOrNull({ _.name == "jsClass" }).identity.value).toBe(overlayField.identity.value)
        expect(overlayField.range.startTokenIndex).toBe(overlay.fieldValues().first.range.startTokenIndex)
        expect(overlayField.range.endTokenIndex).toBe(overlay.fieldValues().first.range.endTokenIndex)
        let published = PrimitiveClassPartitionBinder().bind([merged], snapshot).typeUnits().first
        let field = published.fieldUnits().firstOrNull({ _.name == "jsClass" })
        expect(field.identity.value).toBe(overlayField.identity.value)
        expect(field.range.snapshot).toBe(overlaySnapshot)
    }

    async test `overlay static and instance field access preserve explicit canonical owner`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:FieldOwner.flat"), "one")
        let overlaySnapshot = SourceSnapshotIdentity(SourceIdentity("memory:FieldOwner.js.flat"), "one")
        let baseStream = Lexer().lex("class Holder {}")
        baseStream.emit("start")
        let base = PrimitiveClassParser().parse(baseStream.consumeAll<Token>("data"), snapshot)
        let overlayStream = Lexer().lex("class Holder { visible static Int shared; visible Int value; static readShared() -> Int { return shared; } readValue() -> Int { return this.value; } }")
        overlayStream.emit("start")
        let overlay = PrimitiveClassParser().parse(overlayStream.consumeAll<Token>("data"), overlaySnapshot)
        let merged = base.mergedWith(overlay)
        let clientStream = Lexer().lex("class Client { read(Holder item) -> Int { return item.value; } static readShared() -> Int { return Holder.shared; } }")
        clientStream.emit("start")
        let client = PrimitiveClassParser().parse(clientStream.consumeAll<Token>("data"), snapshot, 100)
        let units = PrimitiveClassPartitionBinder().bind([merged, client], snapshot).typeUnits()
        let holder = units.firstOrNull({ _.identity.name == "Holder" })
        let consumer = units.firstOrNull({ _.identity.name == "Client" })
        let shared = holder.fieldUnits().firstOrNull({ _.name == "shared" })
        let field = holder.fieldUnits().firstOrNull({ _.name == "value" })
        expect(shared.canonicalOwner().value).toBe(holder.identity.value)
        expect(shared.range.snapshot).toBe(overlaySnapshot)
        let owners = [holder, consumer]
        for (owner in owners) {
            let method = owner.functionUnits().firstOrNull({ _.name == "readShared" })
            Object returnSource = method.statements().first
            BoundReturnStatement returned = (BoundReturnStatement)returnSource
            Object referenceSource = returned.value
            BoundReferenceExpression reference = (BoundReferenceExpression)referenceSource
            expect(reference.symbolIdentity.value).toBe(shared.identity.value)
            expect(reference.staticOwner.value).toBe(holder.identity.value)
            expect(reference.fieldOwnerIdentity.value).toBe(holder.identity.value)
        }
        let method = consumer.functionUnits().firstOrNull({ _.name == "read" })
        Object returnSource = method.statements().first
        BoundReturnStatement returned = (BoundReturnStatement)returnSource
        Object accessSource = returned.value
        BoundMemberAccessExpression access = (BoundMemberAccessExpression)accessSource
        expect(access.memberIdentity.value).toBe(field.identity.value)
        expect(field.identity.declaration.syntaxIdentity.snapshot).toBe(overlaySnapshot)
    }

    async test `overlay native interpolation separates static owner from member source`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:NativeOwner.flat"), "one")
        let overlaySnapshot = SourceSnapshotIdentity(SourceIdentity("memory:NativeOwner.js.flat"), "one")
        let baseStream = Lexer().lex("class NativeOwner {}")
        baseStream.emit("start")
        let base = PrimitiveClassParser().parse(baseStream.consumeAll<Token>("data"), snapshot)
        var String source = "class NativeOwner { visible static Int shared; visible Int value; static emitStatic() { external { consume("
        source += '#'
        source += "{shared}, "
        source += '#'
        source += "{NativeOwner.shared}); } } emitInstance() { external { consume("
        source += '#'
        source += "{this.value}); } } }"
        let overlayStream = Lexer().lex(source)
        overlayStream.emit("start")
        let overlay = PrimitiveClassParser().parse(overlayStream.consumeAll<Token>("data"), overlaySnapshot)
        let unit = PrimitiveClassPartitionBinder().bind([base.mergedWith(overlay)], snapshot).typeUnits().first
        let shared = unit.fieldUnits().firstOrNull({ _.name == "shared" })
        let value = unit.fieldUnits().firstOrNull({ _.name == "value" })
        let method = unit.functionUnits().firstOrNull({ _.name == "emitStatic" })
        Object externalSource = method.statements().first
        BoundExternalStatement external = (BoundExternalStatement)externalSource
        let interpolations = external.segmentValues().filter({ _.value != null })
        expect(interpolations.count).toBe(2)
        for (segment in interpolations) {
            Object referenceSource = segment.value
            BoundReferenceExpression reference = (BoundReferenceExpression)referenceSource
            expect(reference.symbolIdentity.value).toBe(shared.identity.value)
            expect(reference.staticOwner.value).toBe(unit.identity.value)
            expect(reference.fieldOwnerIdentity.value).toBe(unit.identity.value)
            expect(reference.symbolIdentity.declaration.syntaxIdentity.snapshot).toBe(overlaySnapshot)
        }
        let instanceMethod = unit.functionUnits().firstOrNull({ _.name == "emitInstance" })
        Object instanceSource = instanceMethod.statements().first
        BoundExternalStatement instanceExternal = (BoundExternalStatement)instanceSource
        Object accessSource = instanceExternal.segmentValues().firstOrNull({ _.value != null }).value
        BoundMemberAccessExpression access = (BoundMemberAccessExpression)accessSource
        expect(access.memberIdentity.value).toBe(value.identity.value)
        expect(access.memberIdentity.declaration.syntaxIdentity.snapshot).toBe(overlaySnapshot)
        expect(value.range.snapshot).toBe(overlaySnapshot)
        expect(value.canonicalOwner().value).toBe(unit.identity.value)
    }

    async test `overlay constructor backed field keeps member source through inheritance copy`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:ParameterOwner.flat"), "one")
        let overlaySnapshot = SourceSnapshotIdentity(SourceIdentity("memory:ParameterOwner.js.flat"), "one")
        let baseStream = Lexer().lex("class Parent {}")
        baseStream.emit("start")
        let base = PrimitiveClassParser().parse(baseStream.consumeAll<Token>("data"), snapshot)
        let overlayStream = Lexer().lex("class Parent { construct(public Int value = 1) {} }")
        overlayStream.emit("start")
        let overlay = PrimitiveClassParser().parse(overlayStream.consumeAll<Token>("data"), overlaySnapshot)
        let merged = base.mergedWith(overlay)
        let childStream = Lexer().lex("class Child extends Parent { read() -> Int { return value; } }")
        childStream.emit("start")
        let child = PrimitiveClassParser().parse(childStream.consumeAll<Token>("data"), snapshot, 100)
        let result = PrimitiveInheritanceBinder().bind(merged, child, snapshot)
        let field = result.parentType.fieldUnits().first
        expect(field.range.snapshot).toBe(overlaySnapshot)
        expect(field.identity.declaration.syntaxIdentity.snapshot).toBe(overlaySnapshot)
        expect(field.canonicalOwner().value).toBe(result.parentType.identity.value)
        expect(field.range.startTokenIndex).toBe(overlay.constructorValues().first.parameterValues().first.range.startTokenIndex)
        let original = PrimitiveClassBinder().bind(merged, snapshot).typeUnit.fieldUnits().first
        expect(field.identity.value).toBe(original.identity.value)
        let published = PrimitiveClassPartitionBinder().bind([merged], snapshot).typeUnits().first.fieldUnits().first
        expect(published.identity.value).toBe(field.identity.value)
        expect(published.canonicalOwner().value).toBe(field.canonicalOwner().value)
        let method = result.childType.functionUnits().firstOrNull({ _.name == "read" })
        Object returnSource = method.statements().first
        BoundReturnStatement returned = (BoundReturnStatement)returnSource
        Object accessSource = returned.value
        BoundReferenceExpression access = (BoundReferenceExpression)accessSource
        expect(access.symbolIdentity.value).toBe(field.identity.value)
    }

    test `binds structured receiver member compound assignment`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:member-compound-bind"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse([
            token("class", false, 1), token("Counter", false, 7), token("{", true, 15),
            token("Int", false, 17), token("value", false, 21), token(";", true, 26),
            token("public", false, 28),
            token("increase", false, 39), token("(", true, 47), token("Int", false, 48),
            token("amount", false, 52), token(")", true, 58), token("{", true, 60),
            token("this", false, 62), token(".", true, 66), token("value", false, 67),
            token("+=", true, 73), token("amount", false, 76), token("}", true, 83),
            token("}", true, 85)
        ], snapshot)
        let type = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        let functions = type.functionUnits()
        let method = functions.last
        let statements = method.statements()
        let statementObject = (Object)statements.first
        let expressionStatement = (BoundExpressionStatement)statementObject
        let expressionObject = expressionStatement.expression
        let evaluation = (BoundEvaluationExpression)expressionObject
        let setup = evaluation.setup()
        expect(setup.count).toBe(3)
        Object storedSource = setup[1]
        BoundLocalDeclarationStatement stored = (BoundLocalDeclarationStatement)storedSource
        Object operationSource = stored.initializer
        BoundBinaryExpression operation = (BoundBinaryExpression)operationSource
        expect(operation.operator).toBe("+")
        Object fieldSource = operation.left
        BoundMemberAccessExpression field = (BoundMemberAccessExpression)fieldSource
        expect(field.memberName).toBe("value")
        Object writeSource = setup.last
        BoundMemberAssignmentStatement write = (BoundMemberAssignmentStatement)writeSource
        expect(write.target.memberIdentity.value).toBe(field.memberIdentity.value)
        Object storedValueSource = write.value
        BoundReferenceExpression storedValue = (BoundReferenceExpression)storedValueSource
        expect(storedValue.symbolIdentity.value).toBe(stored.local.symbolIdentity.value)
    }

