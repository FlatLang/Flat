package flat/semantic/binding/primitive

import flat/compiler/models
import flat/parser/flat
import flat/bound
import flat/lexer/Lexer
import flat/semantic/types

testable class {
    async test `binds compound for advance with scoped step`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:compound-for"), "one")
        let stream = Lexer().lex("var Int step = 2; for (var Int i = 0; i < 6; i += step) { continue; }")
        stream.emit("start")
        let syntax = PrimitiveControlStatementParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let statements = PrimitiveControlStatementBinder().bind(syntax, snapshot).statements()
        let loopObject = (Object)statements.last
        let loop = (BoundForEachStatement)loopObject
        expect(loop.advance().first.unitKind()).toBe("assignment")
    }
    async test `rejects invalid compound for advance`() {
        let sources = ["for (var Int i = 0; i < 6; i += true) {}",
            "var Int j = 0; for (var Int i = 0; i < 6; j += 2) {}"]
        for (source in sources) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:invalid-compound-for"), "one")
            let stream = Lexer().lex(source)
            stream.emit("start")
            let syntax = PrimitiveControlStatementParser().parse(stream.consumeAll<Token>("data"), snapshot)
            var String failure
            try { PrimitiveControlStatementBinder().bind(syntax, snapshot) }
            catch (Exception error) { failure = error.message }
            expect(failure != null).toBe(true)
        }
    }

    test `binds C style for mechanics and loop local scope`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-c-style-for-bind"), "revision:one"
        )
        let syntax = PrimitiveControlStatementParser().parse([
            token("for", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 5),
            token("var", Token.Type.IDENTIFIER, 6), token("Int", Token.Type.IDENTIFIER, 10),
            token("i", Token.Type.IDENTIFIER, 14), token("=", Token.Type.SYMBOL, 16),
            token("0", Token.Type.INTEGER, 18), token(";", Token.Type.SYMBOL, 19),
            token("i", Token.Type.IDENTIFIER, 21), token("<", Token.Type.SYMBOL, 23),
            token("3", Token.Type.INTEGER, 25), token(";", Token.Type.SYMBOL, 26),
            token("i", Token.Type.IDENTIFIER, 28), token("=", Token.Type.SYMBOL, 30),
            token("i", Token.Type.IDENTIFIER, 32), token("+", Token.Type.SYMBOL, 34),
            token("1", Token.Type.INTEGER, 36), token(")", Token.Type.SYMBOL, 37),
            token("{", Token.Type.SYMBOL, 39), token("return", Token.Type.IDENTIFIER, 41),
            token("i", Token.Type.IDENTIFIER, 48), token("}", Token.Type.SYMBOL, 50)
        ], snapshot)
        let result = PrimitiveControlStatementBinder().bind(syntax, snapshot)
        let statements = result.statements()
        let loopObject = (Object)statements.first
        let loop = (BoundForEachStatement)loopObject
        let initializationValues = loop.initialization()
        let initializationObject = (Object)initializationValues.first
        var BoundLocalDeclarationStatement initialization
        initialization = (BoundLocalDeclarationStatement)initializationObject

        expect(initialization.local.semanticType.value()).toBe("primitive:Int")
        expect(loop.condition.semanticType.value()).toBe("primitive:Bool")
        expect(loop.body().first.unitKind()).toBe("return")
        expect(loop.advance().first.unitKind()).toBe("assignment")
    }

    test `binds collection foreach with stable element scope`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-collection-foreach-bind"), "revision:one"
        )
        let declaration = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "function", 0), "function", "iterate"
        )
        let chars = LocalBinding(
            "chars", SymbolIdentity(declaration, "parameter", 0),
            ArraySemanticType(SemanticTypes.charType())
        )
        let syntax = PrimitiveControlStatementParser().parse([
            token("for", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 5),
            token("char", Token.Type.IDENTIFIER, 6), token("in", Token.Type.IDENTIFIER, 11),
            token("chars", Token.Type.IDENTIFIER, 14), token(")", Token.Type.SYMBOL, 19),
            token("{", Token.Type.SYMBOL, 21), token("return", Token.Type.IDENTIFIER, 23),
            token("char", Token.Type.IDENTIFIER, 30), token("}", Token.Type.SYMBOL, 35)
        ], snapshot)
        let result = PrimitiveControlStatementBinder().bind(syntax, snapshot, [chars])
        let statements = result.statements()
        let loopObject = (Object)statements.first
        let loop = (BoundForEachStatement)loopObject
        let body = loop.body()
        let declarationObject = (Object)body.first
        var BoundLocalDeclarationStatement iterator
        iterator = (BoundLocalDeclarationStatement)declarationObject

        expect(loop.initialization().count).toBe(2)
        expect(loop.condition.expressionKind()).toBe("binary")
        expect(iterator.local.semanticType.value()).toBe("primitive:Char")
        expect(iterator.initializer.expressionKind()).toBe("array-access")
        expect(body[1].unitKind()).toBe("return")
    }

    test `binds exclusive integer range foreach mechanics and loop scope`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-foreach-bind"), "revision:one"
        )
        let declaration = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "function", 0), "function", "iterate"
        )
        let count = LocalBinding(
            "count", SymbolIdentity(declaration, "parameter", 0), SemanticTypes.intType()
        )
        let total = LocalBinding(
            "total", SymbolIdentity(declaration, "local", 1), SemanticTypes.intType()
        )
        let syntax = PrimitiveControlStatementParser().parse([
            token("for", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 5),
            token("i", Token.Type.IDENTIFIER, 6), token("in", Token.Type.IDENTIFIER, 8),
            token("0", Token.Type.INTEGER, 11), token("..", Token.Type.SYMBOL, 12),
            token("count", Token.Type.IDENTIFIER, 14), token(")", Token.Type.SYMBOL, 19),
            token("{", Token.Type.SYMBOL, 21), token("total", Token.Type.IDENTIFIER, 23),
            token("+=", Token.Type.SYMBOL, 29), token("i", Token.Type.IDENTIFIER, 32),
            token("}", Token.Type.SYMBOL, 34)
        ], snapshot)
        let result = PrimitiveControlStatementBinder().bind(
            syntax, snapshot, [count, total]
        )
        let boundStatements = result.statements()
        let loopObject = (Object)boundStatements.first
        let loop = (BoundForEachStatement)loopObject

        expect(loop.initialization().first.unitKind()).toBe("local-declaration")
        expect(loop.condition.semanticType.value()).toBe("primitive:Bool")
        expect(loop.body().first.unitKind()).toBe("assignment")
        expect(loop.advance().first.unitKind()).toBe("assignment")
        expect(result.locals().map({ _.name })).toBe(["count", "total"])
    }

    test `binds Bool conditions and isolates nested local scopes`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-control-bind"), "revision:one"
        )
        let syntax = PrimitiveControlStatementParser().parse([
            token("if", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 4),
            token("true", Token.Type.BOOL, 5), token(")", Token.Type.SYMBOL, 9),
            token("{", Token.Type.SYMBOL, 11), token("let", Token.Type.IDENTIFIER, 13),
            token("inside", Token.Type.IDENTIFIER, 17), token("=", Token.Type.SYMBOL, 24),
            token("1", Token.Type.INTEGER, 26), token(";", Token.Type.SYMBOL, 27),
            token("}", Token.Type.SYMBOL, 29), token("else", Token.Type.IDENTIFIER, 31),
            token("{", Token.Type.SYMBOL, 36), token("return", Token.Type.IDENTIFIER, 38),
            token(";", Token.Type.SYMBOL, 44), token("}", Token.Type.SYMBOL, 46),
            token("return", Token.Type.IDENTIFIER, 48), token(";", Token.Type.SYMBOL, 54)
        ], snapshot)
        let result = PrimitiveControlStatementBinder().bind(syntax, snapshot)
        let boundStatements = result.statements()
        let conditionalObject = (Object)boundStatements.first
        let conditional = (BoundIfStatement)conditionalObject
        let condition = conditional.condition
        let thenStatements = conditional.thenValues()

        expect(condition.semanticType.value()).toBe("primitive:Bool")
        expect(thenStatements.first.unitKind()).toBe("local-declaration")
        expect(result.locals().count).toBe(0)
        expect(result.statements().count).toBe(2)
    }

    async test `binds constructor call in structured expression`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:structured-constructor-call"), "revision:one"
        )
        let exceptionIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", 1), "class", "Exception"
        )
        let exceptionType = UserClassSemanticType(exceptionIdentity)
        let constructor = CallableSignature(
            SymbolIdentity(exceptionIdentity, "constructor"), "Exception",
            CallableKind("constructor"), [SemanticTypes.stringType()],
            exceptionType, exceptionType
        )
        let stream = Lexer().lex(
            "if (true) { throw Exception(\"invalid\") }"
        )
        stream.emit("start")
        let statements = PrimitiveControlStatementBinder().bind(
            PrimitiveControlStatementParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot, callables: [constructor]
        ).statements()
        let ifObject = (Object)statements.first
        let conditional = (BoundIfStatement)ifObject
        let thenValues = conditional.thenValues()
        let throwObject = (Object)thenValues.first
        var BoundThrowStatement thrown
        thrown = (BoundThrowStatement)throwObject
        let callObject = (Object)thrown.value
        var BoundCallExpression call
        call = (BoundCallExpression)callObject

        expect(call.target).toBe(constructor)
        expect(call.argumentConversions().first.conversionKind).toBe("identity")
        expect(call.range.startTokenIndex).toBe(6)
    }

    async test `binds continue through switch nested in loop`() {
        let source = "while (true) { switch value { ' ' => continue default => return false } }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-continue-bind"), "revision:one"
        )
        let syntax = PrimitiveControlStatementParser().parse(
            stream.consumeAll<Token>("data"), snapshot
        )
        let owner = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "function", 0), "function", "run"
        )
        let local = LocalBinding(
            name: "value", identity: SymbolIdentity(owner, "parameter"),
            semanticType: SemanticTypes.charType()
        )
        let statements = PrimitiveControlStatementBinder().bind(
            syntax, snapshot, locals: [local]
        ).statements()
        let whileObject = (Object)statements.first
        let loop = (BoundWhileStatement)whileObject
        let loopBody = loop.bodyValues()
        let switchObject = (Object)loopBody.first
        var BoundSwitchStatement switched
        switched = (BoundSwitchStatement)switchObject
        let cases = switched.caseValues()
        let continued = cases.first.statementValues()

        expect(continued.first.unitKind()).toBe("continue")
    }

    async test `binds typed switch cases and fallthrough`() {
        let source = "switch value { ' ' => fallthrough '\\n' => return true }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let tokens = stream.consumeAll<Token>("data")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-switch-bind"), "revision:one"
        )
        let syntax = PrimitiveControlStatementParser().parse(tokens, snapshot)
        let owner = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "function", 0), "function", "run"
        )
        var LocalBinding local = LocalBinding(
            name: "value", identity: SymbolIdentity(owner, "parameter"),
            semanticType: SemanticTypes.charType()
        )
        let result = PrimitiveControlStatementBinder().bind(
            syntax, snapshot, locals: [local]
        )
        let statements = result.statements()
        let switchObject = (Object)statements.first
        let value = (BoundSwitchStatement)switchObject
        let cases = value.caseValues()

        expect(value.value.semanticType.value()).toBe("primitive:Char")
        expect(cases.first.fallsThrough).toBe(true)
        expect(cases.last.label.semanticType.value()).toBe("primitive:Char")
    }

    test `rejects non Bool and unknown-reference conditions`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-control-invalid"), "revision:one"
        )
        var Int rejected
        try {
            let integer = PrimitiveControlStatementParser().parse([
                token("if", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 4),
                token("1", Token.Type.INTEGER, 5), token(")", Token.Type.SYMBOL, 6),
                token("{", Token.Type.SYMBOL, 8), token("return", Token.Type.IDENTIFIER, 10),
                token(";", Token.Type.SYMBOL, 16), token("}", Token.Type.SYMBOL, 18)
            ], snapshot)
            PrimitiveControlStatementBinder().bind(integer, snapshot)
        } catch (Exception error) { rejected++ }
        try {
            let unknown = PrimitiveControlStatementParser().parse([
                token("while", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 7),
                token("missing", Token.Type.IDENTIFIER, 8), token(")", Token.Type.SYMBOL, 15),
                token("{", Token.Type.SYMBOL, 17), token("return", Token.Type.IDENTIFIER, 19),
                token(";", Token.Type.SYMBOL, 25), token("}", Token.Type.SYMBOL, 27)
            ], snapshot)
            PrimitiveControlStatementBinder().bind(unknown, snapshot)
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
    }

    test `binds typed throw catch scopes and finally control`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-exception-bind"), "revision:one"
        )
        let syntax = PrimitiveControlStatementParser().parse([
            token("try", Token.Type.IDENTIFIER, 1), token("{", Token.Type.SYMBOL, 5),
            token("throw", Token.Type.IDENTIFIER, 7), token("'failure'", Token.Type.STRING, 13),
            token(";", Token.Type.SYMBOL, 22), token("}", Token.Type.SYMBOL, 24),
            token("catch", Token.Type.IDENTIFIER, 26), token("(", Token.Type.SYMBOL, 32),
            token("String", Token.Type.IDENTIFIER, 33), token("error", Token.Type.IDENTIFIER, 40),
            token(")", Token.Type.SYMBOL, 45), token("{", Token.Type.SYMBOL, 47),
            token("return", Token.Type.IDENTIFIER, 49), token("error", Token.Type.IDENTIFIER, 56),
            token(";", Token.Type.SYMBOL, 61), token("}", Token.Type.SYMBOL, 63),
            token("finally", Token.Type.IDENTIFIER, 65), token("{", Token.Type.SYMBOL, 73),
            token("return", Token.Type.IDENTIFIER, 75), token(";", Token.Type.SYMBOL, 81),
            token("}", Token.Type.SYMBOL, 83)
        ], snapshot)
        let result = PrimitiveControlStatementBinder().bind(syntax, snapshot)
        let statements = result.statements()
        let statementObject = (Object)statements.first
        let value = (BoundTryStatement)statementObject
        let tryValues = value.tryValues()
        let catches = value.catchValues()
        expect(tryValues.first.unitKind()).toBe("throw")
        expect(catches.first.local.semanticType.value()).toBe("builtin:String")
        expect(value.finallyValues().count).toBe(1)
    }

    async test `binds static method reference as structured return argument`() {
        let source = "class Char { public static toLowerCase(Char value) -> Char { " +
            "return value; } public apply(transform(Char) -> Char, Char value) -> Char { " +
            "return value; } public lower(Char value) -> Char { " +
            "return apply(Char.toLowerCase, value); } }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:structured-static-method-reference"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot
        ).typeUnit
        let method = type.functionUnits().firstOrNull({ _.name == "lower" })
        let statements = method.statements()
        let returnedObject = (Object)statements.first
        let returned = (BoundReturnStatement)returnedObject
        let callObject = (Object)returned.value
        let call = (BoundCallExpression)callObject
        let argument = call.argumentValues().first

        expect(argument.expressionKind()).toBe("function-reference")
        expect(argument.semanticType.value()).toBe("function:(primitive:Char)->primitive:Char")
        expect(argument.range.snapshot).toBe(snapshot)
    }

    async test `binds receiver property references in structured condition`() {
        let source = "class Value { Int first => 1 " +
            "public matches(Int expected) -> Bool { if (first == expected) { return true; } " +
            "return false; } }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:structured-property-reference"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot
        ).typeUnit
        let method = type.functionUnits().firstOrNull({ _.name == "matches" })
        let statements = method.statements()
        let ifObject = (Object)statements.first
        let conditional = (BoundIfStatement)ifObject
        let comparisonObject = (Object)conditional.condition
        let comparison = (BoundBinaryExpression)comparisonObject
        let propertyObject = (Object)comparison.left
        let property = (BoundCallExpression)propertyObject

        expect(property.target.name).toBe("first")
        expect(property.receiver.semanticType.value()).toBe(type.semanticType.value())
        expect(property.range.snapshot).toBe(snapshot)
    }

    async test `binds compound Float field assignment with explicit narrowing`() {
        let source = "class Float { construct(public Float value) {} " +
            "plusEqualsReal(Double other) => this.value += other }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let tokens = stream.consumeAll<Token>("data")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-float-member-assignment"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse(tokens, snapshot)
        let result = PrimitiveClassBinder().bind(syntax, snapshot)
        let method = result.typeUnit.functionUnits().firstOrNull({ _.name == "plusEqualsReal" })
        let statements = method.statements()
        let assignmentObject = (Object)statements.first
        var BoundMemberAssignmentStatement assignment
        assignment = (BoundMemberAssignmentStatement)assignmentObject

        expect(assignment.conversion.conversionKind).toBe("numeric-cast")
        expect(assignment.value.semanticType.value()).toBe("primitive:Double")
    }

    test `rejects non throwable values and catch types`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-exception-invalid"), "revision:one"
        )
        var Int rejected
        try {
            let syntax = PrimitiveControlStatementParser().parse([
                token("try", Token.Type.IDENTIFIER, 1), token("{", Token.Type.SYMBOL, 5),
                token("throw", Token.Type.IDENTIFIER, 7), token("1", Token.Type.INTEGER, 13),
                token(";", Token.Type.SYMBOL, 14), token("}", Token.Type.SYMBOL, 16),
                token("finally", Token.Type.IDENTIFIER, 18), token("{", Token.Type.SYMBOL, 26),
                token("return", Token.Type.IDENTIFIER, 28), token(";", Token.Type.SYMBOL, 34),
                token("}", Token.Type.SYMBOL, 36)
            ], snapshot)
            PrimitiveControlStatementBinder().bind(syntax, snapshot)
        } catch (Exception error) { rejected++ }
        try {
            let syntax = PrimitiveControlStatementParser().parse([
                token("try", Token.Type.IDENTIFIER, 1), token("{", Token.Type.SYMBOL, 5),
                token("return", Token.Type.IDENTIFIER, 7), token(";", Token.Type.SYMBOL, 13),
                token("}", Token.Type.SYMBOL, 15), token("catch", Token.Type.IDENTIFIER, 17),
                token("(", Token.Type.SYMBOL, 23), token("Int", Token.Type.IDENTIFIER, 24),
                token("error", Token.Type.IDENTIFIER, 28), token(")", Token.Type.SYMBOL, 33),
                token("{", Token.Type.SYMBOL, 35), token("return", Token.Type.IDENTIFIER, 37),
                token(";", Token.Type.SYMBOL, 43), token("}", Token.Type.SYMBOL, 45)
            ], snapshot)
            PrimitiveControlStatementBinder().bind(syntax, snapshot)
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
    }

    token(String value, Int type, Int column) -> Token {
        return Token(value: value, type: type,
            location: Location(lineNumber: 1, column: column))
    }
}
