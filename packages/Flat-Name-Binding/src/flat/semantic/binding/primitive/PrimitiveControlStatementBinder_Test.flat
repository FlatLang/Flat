package flat/semantic/binding/primitive

import flat/compiler/models
import flat/parser/flat
import flat/bound
import flat/lexer/Lexer
import flat/semantic/types

testable class {
    test `nullable Bool call condition captures once at its operand site`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:nullable-bool-once"), "one")
        let range = SourceRange(snapshot, 10, 14, Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 5))
        let nullable = NullableSemanticType(SemanticTypes.boolType())
        let identity = SymbolIdentity(DeclarationIdentity(SyntaxIslandIdentity(snapshot, "function", 10),
            "function", "next"), "function")
        let target = CallableSignature(identity, "next", CallableKind("function"), SemanticType[], nullable)
        let call = BoundCallExpression(range, nullable, target, BoundExpression[], TypeConversion[])
        let outerSetup = BoundStatement[]
        let tested = PrimitiveControlStatementBinder().conditionValue(call, outerSetup)
        expect(outerSetup.count).toBe(0)
        expect(tested.expressionKind()).toBe("evaluation")
        let evaluation = (BoundEvaluationExpression)tested
        let setup = evaluation.setup()
        expect(setup.count).toBe(1)
        let declarationObject = (Object)setup.first
        let declaration = (BoundLocalDeclarationStatement)declarationObject
        expect(declaration.initializer).toBe(call)
        let check = (BoundBinaryExpression)evaluation.value
        expect(check.operator).toBe("&&")
        let presence = (BoundBinaryExpression)check.left
        let reference = (BoundReferenceExpression)presence.left
        expect(reference.symbolIdentity.value).toBe(declaration.local.symbolIdentity.value)
        let unwrapped = (BoundConversionExpression)check.right
        let unwrappedReference = (BoundReferenceExpression)unwrapped.value
        expect(unwrappedReference.symbolIdentity.value).toBe(reference.symbolIdentity.value)
        setup.clear()
        expect(evaluation.setup().count).toBe(1)
        let repeated = PrimitiveControlStatementBinder().conditionValue(call)
        expect(repeated.expressionKind()).toBe("evaluation")
    }

    test `nullable Bool local condition needs no setup`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:nullable-bool-local"), "one")
        let range = SourceRange(snapshot, 0, 1, Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 2))
        let identity = SymbolIdentity(DeclarationIdentity(SyntaxIslandIdentity(snapshot, "local", 0), "local", "ready"), "local")
        let local = BoundReferenceExpression(range, NullableSemanticType(SemanticTypes.boolType()), "ready", identity)
        let tested = PrimitiveControlStatementBinder().conditionValue(local)
        expect(tested.expressionKind()).toBe("binary")
        expect(tested.semanticType.value()).toBe(SemanticTypes.boolType().value())
    }

    test `binds nullable Bool loop and short circuit at evaluation sites`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:nullable-bool-loop"), "one")
        let range = SourceRange(snapshot, 10, 14, Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 5))
        let identity = SymbolIdentity(DeclarationIdentity(SyntaxIslandIdentity(snapshot, "function", 10),
            "function", "next"), "function")
        let target = CallableSignature(identity, "next", CallableKind("function"), SemanticType[],
            NullableSemanticType(SemanticTypes.boolType()))
        let condition = PrimitiveBinarySyntax(range, "&&",
            PrimitiveLiteralSyntax(range, Token.Type.BOOL, "false"),
            PrimitiveCallSyntax(range, "next", PrimitiveExpressionSyntax[]))
        let syntax = PrimitiveStatementSyntaxResult([
            PrimitiveWhileSyntax(range, condition, PrimitiveStatementSyntax[])])
        let result = PrimitiveControlStatementBinder().bind(syntax, snapshot, callables: [target])
        let statements = result.statements()
        expect(statements.count).toBe(1)
        let loopObject = (Object)statements.first
        let loop = (BoundWhileStatement)loopObject
        let conjunction = (BoundBinaryExpression)loop.condition
        expect(conjunction.left.expressionKind()).toBe("literal")
        expect(conjunction.right.expressionKind()).toBe("evaluation")
        let evaluation = (BoundEvaluationExpression)conjunction.right
        expect(evaluation.setup().count).toBe(1)
    }

    test `nullable Bool conditional call retains capture inside expression`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:nullable-bool-ternary"), "one")
        let range = SourceRange(snapshot, 10, 14, Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 5))
        let identity = SymbolIdentity(DeclarationIdentity(SyntaxIslandIdentity(snapshot, "function", 10),
            "function", "next"), "function")
        let target = CallableSignature(identity, "next", CallableKind("function"), SemanticType[],
            NullableSemanticType(SemanticTypes.boolType()))
        let conditional = PrimitiveConditionalSyntax(range, PrimitiveCallSyntax(range, "next", PrimitiveExpressionSyntax[]),
            PrimitiveLiteralSyntax(range, Token.Type.INTEGER, "1"),
            PrimitiveLiteralSyntax(range, Token.Type.INTEGER, "2"))
        let result = PrimitiveExpressionBinder().bind(conditional, callables: [target])
        expect(result.succeeded).toBe(true)
        let expression = (BoundConditionalExpression)result.expression
        expect(expression.condition.expressionKind()).toBe("evaluation")
        expect(expression.whenTrue.expressionKind()).toBe("literal")
        expect(expression.whenFalse.expressionKind()).toBe("literal")
    }

    async test `binds Long table loop and Array clamp assignments with structured interpolation`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:core-shaped-structured-block"), "one")
        var String source = "let values = [1, 2, 3]; var Int index = 0; var Int limit = 8; " +
            "limit = limit > values.count ? values.count : limit; " +
            "limit = limit < 0 ? 0 : limit; " +
            "while (index < values.count - 1 && index < limit) { index += 1; } return \""
        source += '#'
        source += "{index > 0 ? values[index] : 0}:"
        source += '#'
        source += "{values.count}\";"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let syntax = PrimitiveControlStatementParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let result = PrimitiveControlStatementBinder().bind(syntax, snapshot)
        let statements = result.statements()
        expect(statements.count).toBe(7)
        let firstAssignmentObject = (Object)statements[3]
        let firstAssignment = (BoundAssignmentStatement)firstAssignmentObject
        expect(firstAssignment.value.expressionKind()).toBe("conditional")
        let secondAssignmentObject = (Object)statements[4]
        let secondAssignment = (BoundAssignmentStatement)secondAssignmentObject
        expect(secondAssignment.value.expressionKind()).toBe("conditional")
        let loopObject = (Object)statements[5]
        let loop = (BoundWhileStatement)loopObject
        expect(loop.condition.semanticType.value()).toBe(SemanticTypes.boolType().value())
        expect(loop.bodyValues().count).toBe(1)
        let returnedObject = (Object)statements.last
        let returned = (BoundReturnStatement)returnedObject
        let interpolation = (BoundInterpolatedStringExpression)returned.value
        let expressions = interpolation.segmentValues().filter((segment) => !segment.literal())
        expect(expressions.count).toBe(2)
        let firstSegmentObject = (Object)expressions.first
        let firstSegment = (BoundInterpolatedStringSegment)firstSegmentObject
        expect(firstSegment.expression.expressionKind()).toBe("conditional")
        let lastSegmentObject = (Object)expressions.last
        let lastSegment = (BoundInterpolatedStringSegment)lastSegmentObject
        expect(lastSegment.expression.expressionKind()).toBe("array-length")
    }

    async test `delegates member access on nested array receiver inside structured branch`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:nested-array-member-control"), "one")
        let stream = Lexer().lex("let values = [[1], [2, 3]]; var Int count = 0; " +
            "if (values.count > 0) { count = values[0].count > 0 ? values[1].count : 0; } return count;")
        stream.emit("start")
        let syntax = PrimitiveControlStatementParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let statements = PrimitiveControlStatementBinder().bind(syntax, snapshot).statements()
        expect(statements.count).toBe(4)
        let branchObject = (Object)statements[2]
        let branch = (BoundIfStatement)branchObject
        let branchStatements = branch.thenValues()
        let assignmentObject = (Object)branchStatements.first
        let assignment = (BoundAssignmentStatement)assignmentObject
        let conditional = (BoundConditionalExpression)assignment.value
        expect(conditional.whenTrue.expressionKind()).toBe("array-length")
        expect(conditional.semanticType.value()).toBe(SemanticTypes.intType().value())
    }

    async test `List shaped callback branch retains one postfix argument evaluation`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:list-callback-control"), "one")
        let range = SourceRange(snapshot, 0, 1, Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 2))
        let identity = SymbolIdentity(DeclarationIdentity(SyntaxIslandIdentity(snapshot, "parameter", 0),
            "parameter", "accept"), "parameter")
        let callback = LocalBinding("accept", identity,
            FunctionSemanticType([SemanticTypes.intType(), SemanticTypes.intType()], SemanticTypes.boolType()))
        let stream = Lexer().lex("let values = [1, 2]; var Int i = 0; " +
            "for (element in values) { if (accept(element, i++)) return element; } return 0;")
        stream.emit("start")
        let syntax = PrimitiveControlStatementParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let statements = PrimitiveControlStatementBinder().bind(syntax, snapshot, locals: [callback]).statements()
        expect(statements.count).toBe(4)
        let loopObject = (Object)statements[2]
        let loop = (BoundForEachStatement)loopObject
        expect(loop.body().count).toBe(2)
        let branchObject = (Object)loop.body()[1]
        let branch = (BoundIfStatement)branchObject
        let invocation = (BoundFunctionInvocationExpression)branch.condition
        expect(invocation.argumentValues().count).toBe(2)
        let postfixObject = (Object)invocation.argumentValues()[1]
        let postfix = (BoundPostfixUpdateExpression)postfixObject
        expect(postfix.expressionKind()).toBe("postfix-update")
        let target = (BoundReferenceExpression)postfix.target
        expect(target.name).toBe("i")
        expect(branch.thenValues().count).toBe(1)
        expect(branch.thenValues().first.unitKind()).toBe("return")
    }

    test `loop declaration condition initializes at every condition evaluation site`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:loop-declaration-condition"), "one")
        let range = SourceRange(snapshot, 0, 1, Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 2))
        let declaration = PrimitiveDeclarationValueSyntax(range, "ready",
            PrimitiveLiteralSyntax(range, Token.Type.BOOL, "false"))
        let syntax = PrimitiveStatementSyntaxResult([
            PrimitiveWhileSyntax(range, declaration, [PrimitiveReturnSyntax(range, PrimitiveReferenceSyntax(range, "ready"))])])
        let statements = PrimitiveControlStatementBinder().bind(syntax, snapshot).statements()
        expect(statements.count).toBe(1)
        let loopObject = (Object)statements.first
        let loop = (BoundWhileStatement)loopObject
        let evaluation = (BoundEvaluationExpression)loop.condition
        expect(evaluation.setup().count).toBe(1)
        let evaluationSetup = evaluation.setup()
        let declarationObject = (Object)evaluationSetup.first
        let initialized = (BoundLocalDeclarationStatement)declarationObject
        expect(initialized.local.name).toBe("ready")
        let tested = (BoundReferenceExpression)evaluation.value
        expect(tested.symbolIdentity.value).toBe(initialized.local.symbolIdentity.value)
        expect(loop.bodyValues().count).toBe(1)
    }

    async test `static table reads preserve canonical field ownership without an instance`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:static-table-control"), "one")
        let sources = ["class Long { static native_array Int[] FILE_SIZES = [1, 2]; " +
                "public static count() -> Int { var Int index = 0; while (index < FILE_SIZES.count - 1) { index += 1; } return FILE_SIZES[index]; } " +
                "public static native_array table() -> Int[] { return FILE_SIZES; } }",
            "class Other { static native_array Int[] FILE_SIZES = [3]; }"]
        let syntaxes = PrimitiveClassSyntax[]
        var Int offset
        for (source in sources) {
            let stream = Lexer().lex(source)
            stream.emit("start")
            syntaxes.add(PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot, offset))
            offset += 200
        }
        let units = PrimitiveClassPartitionBinder().bindContexts([
            PrimitiveSourceBindingContext("app", snapshot, syntaxes)]).typeUnits()
        let owner = units.firstOrNull({ _.identity.name == "Long" })
        let field = owner.fieldUnits().firstOrNull({ _.name == "FILE_SIZES" })
        expect(field.staticField).toBe(true)
        expect(field.nativeArrayStorage).toBe(true)
        let table = owner.functionUnits().firstOrNull({ _.name == "table" })
        let statements = table.statements()
        let statementObject = (Object)statements.first
        let returned = (BoundReturnStatement)statementObject
        let valueObject = (Object)returned.value
        let reference = (BoundReferenceExpression)valueObject
        expect(reference.staticOwner.value).toBe(owner.identity.value)
        expect(reference.symbolIdentity.value).toBe(field.identity.value)
        expect(reference.semanticType.value()).toBe(field.semanticType.value())
        expect(reference.range.snapshot).toBe(snapshot)
        expect(owner.functionUnits().firstOrNull({ _.name == "count" }).returnType.value()).toBe(SemanticTypes.intType().value())
    }

    async test `static table fallback never grants access to instance storage`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:instance-table-rejection"), "one")
        let sources = ["class Long { native_array Int[] FILE_SIZES; public static count() -> Int { var Int index = 0; while (index < FILE_SIZES.count) { index += 1; } return index; } }",
            "class Long { native_array Int[] FILE_SIZES; public static native_array table() -> Int[] { return FILE_SIZES; } }"]
        for (source in sources) {
            let stream = Lexer().lex(source)
            stream.emit("start")
            let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
            var String failure
            try { PrimitiveClassPartitionBinder().bindContexts([PrimitiveSourceBindingContext("app", snapshot, [syntax])]) }
            catch (Exception error) { failure = error.message }
            expect(failure != null).toBe(true)
            expect(failure.contains("instance field")).toBe(true)
        }
    }

    async test `while continue retains loop context inside try`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:while-try-continue"), "one")
        let stream = Lexer().lex("while (true) { try { continue; } finally { let done = 1; } }")
        stream.emit("start")
        let syntax = PrimitiveControlStatementParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let result = PrimitiveControlStatementBinder().bind(syntax, snapshot)
        let statements = result.statements()
        let loopObject = (Object)statements.first
        let loop = (BoundWhileStatement)loopObject
        let loopBody = loop.bodyValues()
        let guardedObject = (Object)loopBody.first
        let guarded = (BoundTryStatement)guardedObject
        expect(guarded.tryValues().count).toBe(1)
        expect(guarded.tryValues().first.unitKind()).toBe("continue")
        expect(guarded.tryValues().first.range.snapshot).toBe(snapshot)
        expect(guarded.catchValues().count).toBe(0)
        expect(guarded.finallyValues().count).toBe(1)
    }

    async test `while continue retains loop context inside catch`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:while-catch-continue"), "one")
        let stream = Lexer().lex("while (true) { try { throw \"failure\"; } catch (String error) { continue; } }")
        stream.emit("start")
        let syntax = PrimitiveControlStatementParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let result = PrimitiveControlStatementBinder().bind(syntax, snapshot)
        let statements = result.statements()
        let loopObject = (Object)statements.first
        let loop = (BoundWhileStatement)loopObject
        let loopBody = loop.bodyValues()
        let guardedObject = (Object)loopBody.first
        let guarded = (BoundTryStatement)guardedObject
        expect(guarded.tryValues().first.unitKind()).toBe("throw")
        expect(guarded.catchValues().count).toBe(1)
        let caught = guarded.catchValues().first
        expect(caught.local.semanticType.value()).toBe("builtin:String")
        expect(caught.statements().count).toBe(1)
        expect(caught.statements().first.unitKind()).toBe("continue")
        expect(caught.statements().first.range.snapshot).toBe(snapshot)
    }

    async test `while continue retains loop context inside finally`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:while-finally-continue"), "one")
        let stream = Lexer().lex("while (true) { try { let work = 1; } finally { continue; } }")
        stream.emit("start")
        let syntax = PrimitiveControlStatementParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let result = PrimitiveControlStatementBinder().bind(syntax, snapshot)
        let statements = result.statements()
        let loopObject = (Object)statements.first
        let loop = (BoundWhileStatement)loopObject
        let loopBody = loop.bodyValues()
        let guardedObject = (Object)loopBody.first
        let guarded = (BoundTryStatement)guardedObject
        expect(guarded.tryValues().count).toBe(1)
        expect(guarded.finallyValues().count).toBe(1)
        expect(guarded.finallyValues().first.unitKind()).toBe("continue")
        expect(guarded.finallyValues().first.range.snapshot).toBe(snapshot)
    }

    async test `nested while inside guarded foreach owns its continues`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:nested-while-continue"), "one")
        let stream = Lexer().lex("for (i in 0..2) { try { while (true) { " +
            "try { continue; } catch (String error) { continue; } finally { continue; } " +
            "} } finally { let done = 1; } }")
        stream.emit("start")
        let syntax = PrimitiveControlStatementParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let binder = PrimitiveControlStatementBinder()
        // The inner while resets the foreach cleanup target, without removing either loop.
        expect(binder.controlDiagnostic(syntax.statements()) == null).toBe(true)
        let result = binder.bind(syntax, snapshot)
        let outerStatements = result.statements()
        let outerObject = (Object)outerStatements.first
        let outer = (BoundForEachStatement)outerObject
        let outerBody = outer.body()
        let outerGuardObject = (Object)outerBody.first
        let outerGuard = (BoundTryStatement)outerGuardObject
        let guardedBody = outerGuard.tryValues()
        let innerObject = (Object)guardedBody.first
        let inner = (BoundWhileStatement)innerObject
        let innerBody = inner.bodyValues()
        let innerGuardObject = (Object)innerBody.first
        let innerGuard = (BoundTryStatement)innerGuardObject
        expect(innerGuard.tryValues().first.unitKind()).toBe("continue")
        expect(innerGuard.catchValues().first.statements().first.unitKind()).toBe("continue")
        expect(innerGuard.finallyValues().first.unitKind()).toBe("continue")
        expect(outer.body().count).toBe(1)
        expect(outerGuard.finallyValues().count).toBe(1)
        expect(inner.bodyValues().count).toBe(1)
        expect(innerGuard.range.snapshot).toBe(snapshot)
    }

    async test `continue outside lexical loop is rejected even after nested loop`() {
        let sources = ["continue;",
            "try { while (true) { continue; } continue; } finally { let done = 1; }",
            "try { let work = 1; } catch (String error) { continue; }",
            "try { let work = 1; } finally { continue; }"]
        for (source in sources) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:outside-loop-continue"), "one")
            let stream = Lexer().lex(source)
            stream.emit("start")
            let syntax = PrimitiveControlStatementParser().parse(stream.consumeAll<Token>("data"), snapshot)
            var String failure
            try { PrimitiveControlStatementBinder().bind(syntax, snapshot) }
            catch (Exception error) { failure = error.message }
            expect(failure).toBe("Continue requires an enclosing loop")
        }
    }

    async test `binds compound for advance with scoped step`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:compound-for"), "one")
        let stream = Lexer().lex("var Int step = 2; for (var Int i = 0; i < 6; i += step) { continue; }")
        stream.emit("start")
        let syntax = PrimitiveControlStatementParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let statements = PrimitiveControlStatementBinder().bind(syntax, snapshot).statements()
        let loopObject = (Object)statements.last
        let loop = (BoundForEachStatement)loopObject
        expect(loop.advance().first.unitKind()).toBe("assignment")
    }
    async test `rejects invalid compound for advance`() {
        let sources = ["for (var Int i = 0; i < 6; i += true) {}",
            "var Int j = 0; for (var Int i = 0; i < 6; j += 2) {}"]
        for (source in sources) {
            let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:invalid-compound-for"), "one")
            let stream = Lexer().lex(source)
            stream.emit("start")
            let syntax = PrimitiveControlStatementParser().parse(stream.consumeAll<Token>("data"), snapshot)
            var String failure
            try { PrimitiveControlStatementBinder().bind(syntax, snapshot) }
            catch (Exception error) { failure = error.message }
            expect(failure != null).toBe(true)
        }
    }

    test `binds C style for mechanics and loop local scope`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-c-style-for-bind"), "revision:one"
        )
        let syntax = PrimitiveControlStatementParser().parse([
            token("for", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 5),
            token("var", Token.Type.IDENTIFIER, 6), token("Int", Token.Type.IDENTIFIER, 10),
            token("i", Token.Type.IDENTIFIER, 14), token("=", Token.Type.SYMBOL, 16),
            token("0", Token.Type.INTEGER, 18), token(";", Token.Type.SYMBOL, 19),
            token("i", Token.Type.IDENTIFIER, 21), token("<", Token.Type.SYMBOL, 23),
            token("3", Token.Type.INTEGER, 25), token(";", Token.Type.SYMBOL, 26),
            token("i", Token.Type.IDENTIFIER, 28), token("=", Token.Type.SYMBOL, 30),
            token("i", Token.Type.IDENTIFIER, 32), token("+", Token.Type.SYMBOL, 34),
            token("1", Token.Type.INTEGER, 36), token(")", Token.Type.SYMBOL, 37),
            token("{", Token.Type.SYMBOL, 39), token("return", Token.Type.IDENTIFIER, 41),
            token("i", Token.Type.IDENTIFIER, 48), token("}", Token.Type.SYMBOL, 50)
        ], snapshot)
        let result = PrimitiveControlStatementBinder().bind(syntax, snapshot)
        let statements = result.statements()
        let loopObject = (Object)statements.first
        let loop = (BoundForEachStatement)loopObject
        let initializationValues = loop.initialization()
        let initializationObject = (Object)initializationValues.first
        var BoundLocalDeclarationStatement initialization
        initialization = (BoundLocalDeclarationStatement)initializationObject

        expect(initialization.local.semanticType.value()).toBe("primitive:Int")
        expect(loop.condition.semanticType.value()).toBe("primitive:Bool")
        expect(loop.body().first.unitKind()).toBe("return")
        expect(loop.advance().first.unitKind()).toBe("assignment")
    }

    test `binds collection foreach with stable element scope`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-collection-foreach-bind"), "revision:one"
        )
        let declaration = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "function", 0), "function", "iterate"
        )
        let chars = LocalBinding(
            "chars", SymbolIdentity(declaration, "parameter", 0),
            ArraySemanticType(SemanticTypes.charType())
        )
        let syntax = PrimitiveControlStatementParser().parse([
            token("for", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 5),
            token("char", Token.Type.IDENTIFIER, 6), token("in", Token.Type.IDENTIFIER, 11),
            token("chars", Token.Type.IDENTIFIER, 14), token(")", Token.Type.SYMBOL, 19),
            token("{", Token.Type.SYMBOL, 21), token("return", Token.Type.IDENTIFIER, 23),
            token("char", Token.Type.IDENTIFIER, 30), token("}", Token.Type.SYMBOL, 35)
        ], snapshot)
        let result = PrimitiveControlStatementBinder().bind(syntax, snapshot, [chars])
        let statements = result.statements()
        let loopObject = (Object)statements.first
        let loop = (BoundForEachStatement)loopObject
        let body = loop.body()
        let declarationObject = (Object)body.first
        var BoundLocalDeclarationStatement iterator
        iterator = (BoundLocalDeclarationStatement)declarationObject

        expect(loop.initialization().count).toBe(2)
        expect(loop.condition.expressionKind()).toBe("binary")
        expect(iterator.local.semanticType.value()).toBe("primitive:Char")
        expect(iterator.initializer.expressionKind()).toBe("array-access")
        expect(body[1].unitKind()).toBe("return")
    }

    test `binds exclusive integer range foreach mechanics and loop scope`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-foreach-bind"), "revision:one"
        )
        let declaration = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "function", 0), "function", "iterate"
        )
        let count = LocalBinding(
            "count", SymbolIdentity(declaration, "parameter", 0), SemanticTypes.intType()
        )
        let total = LocalBinding(
            "total", SymbolIdentity(declaration, "local", 1), SemanticTypes.intType()
        )
        let syntax = PrimitiveControlStatementParser().parse([
            token("for", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 5),
            token("i", Token.Type.IDENTIFIER, 6), token("in", Token.Type.IDENTIFIER, 8),
            token("0", Token.Type.INTEGER, 11), token("..", Token.Type.SYMBOL, 12),
            token("count", Token.Type.IDENTIFIER, 14), token(")", Token.Type.SYMBOL, 19),
            token("{", Token.Type.SYMBOL, 21), token("total", Token.Type.IDENTIFIER, 23),
            token("+=", Token.Type.SYMBOL, 29), token("i", Token.Type.IDENTIFIER, 32),
            token("}", Token.Type.SYMBOL, 34)
        ], snapshot)
        let result = PrimitiveControlStatementBinder().bind(
            syntax, snapshot, [count, total]
        )
        let boundStatements = result.statements()
        let loopObject = (Object)boundStatements.first
        let loop = (BoundForEachStatement)loopObject

        expect(loop.initialization().first.unitKind()).toBe("local-declaration")
        expect(loop.condition.semanticType.value()).toBe("primitive:Bool")
        expect(loop.body().first.unitKind()).toBe("assignment")
        expect(loop.advance().first.unitKind()).toBe("assignment")
        expect(result.locals().map({ _.name })).toBe(["count", "total"])
    }

    test `binds Bool conditions and isolates nested local scopes`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-control-bind"), "revision:one"
        )
        let syntax = PrimitiveControlStatementParser().parse([
            token("if", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 4),
            token("true", Token.Type.BOOL, 5), token(")", Token.Type.SYMBOL, 9),
            token("{", Token.Type.SYMBOL, 11), token("let", Token.Type.IDENTIFIER, 13),
            token("inside", Token.Type.IDENTIFIER, 17), token("=", Token.Type.SYMBOL, 24),
            token("1", Token.Type.INTEGER, 26), token(";", Token.Type.SYMBOL, 27),
            token("}", Token.Type.SYMBOL, 29), token("else", Token.Type.IDENTIFIER, 31),
            token("{", Token.Type.SYMBOL, 36), token("return", Token.Type.IDENTIFIER, 38),
            token(";", Token.Type.SYMBOL, 44), token("}", Token.Type.SYMBOL, 46),
            token("return", Token.Type.IDENTIFIER, 48), token(";", Token.Type.SYMBOL, 54)
        ], snapshot)
        let result = PrimitiveControlStatementBinder().bind(syntax, snapshot)
        let boundStatements = result.statements()
        let conditionalObject = (Object)boundStatements.first
        let conditional = (BoundIfStatement)conditionalObject
        let condition = conditional.condition
        let thenStatements = conditional.thenValues()

        expect(condition.semanticType.value()).toBe("primitive:Bool")
        expect(thenStatements.first.unitKind()).toBe("local-declaration")
        expect(result.locals().count).toBe(0)
        expect(result.statements().count).toBe(2)
    }

    async test `binds constructor call in structured expression`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:structured-constructor-call"), "revision:one"
        )
        let exceptionIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", 1), "class", "Exception"
        )
        let exceptionType = UserClassSemanticType(exceptionIdentity)
        let constructor = CallableSignature(
            SymbolIdentity(exceptionIdentity, "constructor"), "Exception",
            CallableKind("constructor"), [SemanticTypes.stringType()],
            exceptionType, exceptionType
        )
        let stream = Lexer().lex(
            "if (true) { throw Exception(\"invalid\") }"
        )
        stream.emit("start")
        let statements = PrimitiveControlStatementBinder().bind(
            PrimitiveControlStatementParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot, callables: [constructor]
        ).statements()
        let ifObject = (Object)statements.first
        let conditional = (BoundIfStatement)ifObject
        let thenValues = conditional.thenValues()
        let throwObject = (Object)thenValues.first
        var BoundThrowStatement thrown
        thrown = (BoundThrowStatement)throwObject
        let callObject = (Object)thrown.value
        var BoundCallExpression call
        call = (BoundCallExpression)callObject

        expect(call.target).toBe(constructor)
        expect(call.argumentConversions().first.conversionKind).toBe("identity")
        expect(call.range.startTokenIndex).toBe(6)
    }

    async test `binds continue through switch nested in loop`() {
        let source = "while (true) { switch value { ' ' => continue default => return false } }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-continue-bind"), "revision:one"
        )
        let syntax = PrimitiveControlStatementParser().parse(
            stream.consumeAll<Token>("data"), snapshot
        )
        let owner = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "function", 0), "function", "run"
        )
        let local = LocalBinding(
            name: "value", identity: SymbolIdentity(owner, "parameter"),
            semanticType: SemanticTypes.charType()
        )
        let statements = PrimitiveControlStatementBinder().bind(
            syntax, snapshot, locals: [local]
        ).statements()
        let whileObject = (Object)statements.first
        let loop = (BoundWhileStatement)whileObject
        let loopBody = loop.bodyValues()
        let switchObject = (Object)loopBody.first
        var BoundSwitchStatement switched
        switched = (BoundSwitchStatement)switchObject
        let cases = switched.caseValues()
        let continued = cases.first.statementValues()

        expect(continued.first.unitKind()).toBe("continue")
    }

    async test `binds typed switch cases and fallthrough`() {
        let source = "switch value { ' ' => fallthrough '\\n' => return true }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let tokens = stream.consumeAll<Token>("data")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-switch-bind"), "revision:one"
        )
        let syntax = PrimitiveControlStatementParser().parse(tokens, snapshot)
        let owner = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "function", 0), "function", "run"
        )
        var LocalBinding local = LocalBinding(
            name: "value", identity: SymbolIdentity(owner, "parameter"),
            semanticType: SemanticTypes.charType()
        )
        let result = PrimitiveControlStatementBinder().bind(
            syntax, snapshot, locals: [local]
        )
        let statements = result.statements()
        let switchObject = (Object)statements.first
        let value = (BoundSwitchStatement)switchObject
        let cases = value.caseValues()

        expect(value.value.semanticType.value()).toBe("primitive:Char")
        expect(cases.first.fallsThrough).toBe(true)
        expect(cases.last.label.semanticType.value()).toBe("primitive:Char")
    }

    test `rejects non Bool and unknown-reference conditions`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-control-invalid"), "revision:one"
        )
        var Int rejected
        try {
            let integer = PrimitiveControlStatementParser().parse([
                token("if", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 4),
                token("1", Token.Type.INTEGER, 5), token(")", Token.Type.SYMBOL, 6),
                token("{", Token.Type.SYMBOL, 8), token("return", Token.Type.IDENTIFIER, 10),
                token(";", Token.Type.SYMBOL, 16), token("}", Token.Type.SYMBOL, 18)
            ], snapshot)
            PrimitiveControlStatementBinder().bind(integer, snapshot)
        } catch (Exception error) { rejected++ }
        try {
            let unknown = PrimitiveControlStatementParser().parse([
                token("while", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 7),
                token("missing", Token.Type.IDENTIFIER, 8), token(")", Token.Type.SYMBOL, 15),
                token("{", Token.Type.SYMBOL, 17), token("return", Token.Type.IDENTIFIER, 19),
                token(";", Token.Type.SYMBOL, 25), token("}", Token.Type.SYMBOL, 27)
            ], snapshot)
            PrimitiveControlStatementBinder().bind(unknown, snapshot)
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
    }

    test `binds typed throw catch scopes and finally control`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-exception-bind"), "revision:one"
        )
        let syntax = PrimitiveControlStatementParser().parse([
            token("try", Token.Type.IDENTIFIER, 1), token("{", Token.Type.SYMBOL, 5),
            token("throw", Token.Type.IDENTIFIER, 7), token("'failure'", Token.Type.STRING, 13),
            token(";", Token.Type.SYMBOL, 22), token("}", Token.Type.SYMBOL, 24),
            token("catch", Token.Type.IDENTIFIER, 26), token("(", Token.Type.SYMBOL, 32),
            token("String", Token.Type.IDENTIFIER, 33), token("error", Token.Type.IDENTIFIER, 40),
            token(")", Token.Type.SYMBOL, 45), token("{", Token.Type.SYMBOL, 47),
            token("return", Token.Type.IDENTIFIER, 49), token("error", Token.Type.IDENTIFIER, 56),
            token(";", Token.Type.SYMBOL, 61), token("}", Token.Type.SYMBOL, 63),
            token("finally", Token.Type.IDENTIFIER, 65), token("{", Token.Type.SYMBOL, 73),
            token("return", Token.Type.IDENTIFIER, 75), token(";", Token.Type.SYMBOL, 81),
            token("}", Token.Type.SYMBOL, 83)
        ], snapshot)
        let result = PrimitiveControlStatementBinder().bind(syntax, snapshot)
        let statements = result.statements()
        let statementObject = (Object)statements.first
        let value = (BoundTryStatement)statementObject
        let tryValues = value.tryValues()
        let catches = value.catchValues()
        expect(tryValues.first.unitKind()).toBe("throw")
        expect(catches.first.local.semanticType.value()).toBe("builtin:String")
        expect(value.finallyValues().count).toBe(1)
    }

    async test `binds static method reference as structured return argument`() {
        let source = "class Char { public static toLowerCase(Char value) -> Char { " +
            "return value; } public apply(transform(Char) -> Char, Char value) -> Char { " +
            "return value; } public lower(Char value) -> Char { " +
            "return apply(Char.toLowerCase, value); } }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:structured-static-method-reference"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot
        ).typeUnit
        let method = type.functionUnits().firstOrNull({ _.name == "lower" })
        let statements = method.statements()
        let returnedObject = (Object)statements.first
        let returned = (BoundReturnStatement)returnedObject
        let callObject = (Object)returned.value
        let call = (BoundCallExpression)callObject
        let argument = call.argumentValues().first

        expect(argument.expressionKind()).toBe("function-reference")
        expect(argument.semanticType.value()).toBe("function:(primitive:Char)->primitive:Char")
        expect(argument.range.snapshot).toBe(snapshot)
    }

    async test `binds receiver property references in structured condition`() {
        let source = "class Value { Int first => 1 " +
            "public matches(Int expected) -> Bool { if (first == expected) { return true; } " +
            "return false; } }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:structured-property-reference"), "revision:one"
        )
        let type = PrimitiveClassBinder().bind(
            PrimitiveClassParser().parse(
                stream.consumeAll<Token>("data"), snapshot
            ), snapshot
        ).typeUnit
        let method = type.functionUnits().firstOrNull({ _.name == "matches" })
        let statements = method.statements()
        let ifObject = (Object)statements.first
        let conditional = (BoundIfStatement)ifObject
        let comparisonObject = (Object)conditional.condition
        let comparison = (BoundBinaryExpression)comparisonObject
        let propertyObject = (Object)comparison.left
        let property = (BoundCallExpression)propertyObject

        expect(property.target.name).toBe("first")
        expect(property.receiver.semanticType.value()).toBe(type.semanticType.value())
        expect(property.range.snapshot).toBe(snapshot)
    }

    async test `binds compound Float field assignment with explicit narrowing`() {
        let source = "class Float { construct(public Float value) {} " +
            "plusEqualsReal(Double other) => this.value += other }"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let tokens = stream.consumeAll<Token>("data")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-float-member-assignment"), "revision:one"
        )
        let syntax = PrimitiveClassParser().parse(tokens, snapshot)
        let result = PrimitiveClassBinder().bind(syntax, snapshot)
        let method = result.typeUnit.functionUnits().firstOrNull({ _.name == "plusEqualsReal" })
        let statements = method.statements()
        let expressionObject = (Object)statements.first
        let expressionStatement = (BoundExpressionStatement)expressionObject
        Object evaluationObject = expressionStatement.expression
        BoundEvaluationExpression evaluation = (BoundEvaluationExpression)evaluationObject
        let setup = evaluation.setup()
        expect(setup.count).toBe(3)
        Object storedObject = setup[1]
        BoundLocalDeclarationStatement stored = (BoundLocalDeclarationStatement)storedObject
        expect(stored.conversion.conversionKind).toBe("numeric-cast")
        expect(stored.initializer.semanticType.value()).toBe("primitive:Double")
        expect(stored.local.semanticType.value()).toBe("primitive:Float")
        Object writeObject = setup.last
        BoundMemberAssignmentStatement assignment = (BoundMemberAssignmentStatement)writeObject
        expect(assignment.conversion.conversionKind).toBe("identity")
        Object valueObject = assignment.value
        BoundReferenceExpression value = (BoundReferenceExpression)valueObject
        expect(value.symbolIdentity.value).toBe(stored.local.symbolIdentity.value)
    }

    test `rejects non throwable values and catch types`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-exception-invalid"), "revision:one"
        )
        var Int rejected
        try {
            let syntax = PrimitiveControlStatementParser().parse([
                token("try", Token.Type.IDENTIFIER, 1), token("{", Token.Type.SYMBOL, 5),
                token("throw", Token.Type.IDENTIFIER, 7), token("1", Token.Type.INTEGER, 13),
                token(";", Token.Type.SYMBOL, 14), token("}", Token.Type.SYMBOL, 16),
                token("finally", Token.Type.IDENTIFIER, 18), token("{", Token.Type.SYMBOL, 26),
                token("return", Token.Type.IDENTIFIER, 28), token(";", Token.Type.SYMBOL, 34),
                token("}", Token.Type.SYMBOL, 36)
            ], snapshot)
            PrimitiveControlStatementBinder().bind(syntax, snapshot)
        } catch (Exception error) { rejected++ }
        try {
            let syntax = PrimitiveControlStatementParser().parse([
                token("try", Token.Type.IDENTIFIER, 1), token("{", Token.Type.SYMBOL, 5),
                token("return", Token.Type.IDENTIFIER, 7), token(";", Token.Type.SYMBOL, 13),
                token("}", Token.Type.SYMBOL, 15), token("catch", Token.Type.IDENTIFIER, 17),
                token("(", Token.Type.SYMBOL, 23), token("Int", Token.Type.IDENTIFIER, 24),
                token("error", Token.Type.IDENTIFIER, 28), token(")", Token.Type.SYMBOL, 33),
                token("{", Token.Type.SYMBOL, 35), token("return", Token.Type.IDENTIFIER, 37),
                token(";", Token.Type.SYMBOL, 43), token("}", Token.Type.SYMBOL, 45)
            ], snapshot)
            PrimitiveControlStatementBinder().bind(syntax, snapshot)
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
    }

    token(String value, Int type, Int column) -> Token {
        return Token(value: value, type: type,
            location: Location(lineNumber: 1, column: column))
    }
}
