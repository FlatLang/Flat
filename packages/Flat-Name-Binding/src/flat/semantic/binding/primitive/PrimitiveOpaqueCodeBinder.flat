package flat/semantic/binding/primitive

import flat/parser/flat
import flat/bound
import flat/semantic/types

/** Resolves opaque-code interpolation roots and selected ES6 runtime projections. */
class PrimitiveOpaqueCodeBinder {
    var PrimitiveStructuralTypeResolver currentTypeResolver
    var TypeHierarchyComponent currentHierarchy
    var BoundFieldUnit[] currentAvailableFields

    public bind(
        PrimitiveExternalStatementSyntax syntax,
        LocalBinding[] locals,
        BoundReferenceExpression receiver = null,
        BoundFieldUnit[] fields = BoundFieldUnit[],
        CallableSignature[] callables = CallableSignature[],
        BoundFieldUnit[] availableFields = BoundFieldUnit[],
        PrimitiveStructuralTypeResolver typeResolver = null,
        TypeHierarchyComponent hierarchy = null
    ) -> BoundExternalStatement {
        if (!syntax || !locals || !fields || !availableFields ||
            availableFields.any({ !_ })) {
            throw Exception("Opaque-code binding requires input")
        }
        if (syntax.target != "js") throw Exception("Opaque target is unavailable")
        currentTypeResolver = typeResolver
        currentHierarchy = hierarchy
        currentAvailableFields = availableFields
        let pieces = BoundExternalCodeSegment[]
        let syntaxPieces = syntax.segmentValues()
        var Int pieceIndex
        while (pieceIndex < syntaxPieces.count) {
            let piece = syntaxPieces[pieceIndex]
            if (!piece.interpolated()) {
                pieces.add(BoundExternalCodeSegment(piece.range, piece.text))
            } else if (piece.expressionSegment()) {
                let bound = bindExpression(
                    piece.expression, locals, receiver, fields, callables, piece.suppressAwait
                )
                pieces.add(BoundExternalCodeSegment(
                    piece.range, "", bound, "identity"
                ))
            } else {
                let path = piece.pathValues()
                if (path.count == 1 && path.first == "null") {
                    pieces.add(BoundExternalCodeSegment(
                        piece.range, "", BoundLiteralExpression(
                            piece.range, SemanticTypes.nullType(), "null"
                        ), "identity"
                    ))
                    pieceIndex++
                    continue
                }
                var LocalBinding root
                var Int candidateIndex = locals.count - 1
                while (candidateIndex >= 0 && !root) {
                    let candidate = locals[candidateIndex]
                    if (candidate.name == path.first) root = candidate
                    candidateIndex--
                }
                if (!root) {
                    let lexicalStatic = path.count == 1 ? fields.firstOrNull((field) =>
                        field.staticField && field.name == path.first) : null
                    if (lexicalStatic) {
                        pieces.add(BoundExternalCodeSegment(piece.range, "", BoundReferenceExpression(
                            piece.range, lexicalStatic.semanticType, lexicalStatic.name, lexicalStatic.identity,
                            staticOwner: lexicalStatic.canonicalOwner(),
                            fieldOwnerIdentity: lexicalStatic.canonicalOwner()), "identity"))
                        pieceIndex++
                        continue
                    }
                    if (path.count == 2 && path.first != "this" && path.first != "super" &&
                        fields.none({ _.name == path.first })) {
                        let access = PrimitiveMemberAccessSyntax(piece.range,
                            PrimitiveReferenceSyntax(piece.range, path.first), path[1])
                        let value = PrimitiveClassBinder().bindScopedExpression(access, receiver, fields,
                            locals, callables, typeResolver: currentTypeResolver,
                            availableFields: availableFields, hierarchy: currentHierarchy)
                        pieces.add(BoundExternalCodeSegment(piece.range, "", value, "identity"))
                        pieceIndex++
                        continue
                    }
                    if (path.first == "this" && receiver && path.count >= 2) {
                        let field = ownerField(
                            receiver.semanticType, path[1], fields, availableFields
                        )
                        if (!field) throw Exception("Unknown interpolation root")
                        var BoundExpression value = BoundMemberAccessExpression(
                            piece.range, field.semanticType, receiver,
                            field.name, field.identity
                        )
                        if (path.count == 3 && path[2] == "data" &&
                            value.semanticType.kind() == "array") {
                            value = BoundNativeArrayDataExpression(piece.range, value)
                        } else if (path.count != 2) {
                            throw Exception("Unsupported interpolation path")
                        }
                        pieces.add(BoundExternalCodeSegment(
                            piece.range, "", value, "identity"
                        ))
                        pieceIndex++
                        continue
                    }
                    if (!receiver) throw Exception("Unknown interpolation root")
                    let field = ownerField(
                        receiver.semanticType, path.first, fields, availableFields
                    )
                    if (!field) throw Exception("Unknown interpolation root")
                    var BoundExpression value = BoundMemberAccessExpression(
                        piece.range, field.semanticType, receiver, field.name, field.identity
                    )
                    if (path.count == 2 && path[1] == "data") {
                        if (value.semanticType.kind() == "array") {
                            value = BoundNativeArrayDataExpression(piece.range, value)
                        } else {
                            let nestedField = ownerField(
                                value.semanticType, path[1], fields, availableFields
                            )
                            if (!nestedField) throw Exception(
                                "Unsupported interpolation path"
                            )
                            value = BoundMemberAccessExpression(
                                piece.range, nestedField.semanticType, value,
                                nestedField.name, nestedField.identity
                            )
                        }
                    } else if (path.count == 3) {
                        let nestedField = ownerField(
                            value.semanticType, path[2], fields, availableFields
                        )
                        if (!nestedField) throw Exception(
                            "Unsupported interpolation path"
                        )
                        value = BoundMemberAccessExpression(
                            piece.range, nestedField.semanticType, value,
                            nestedField.name, nestedField.identity
                        )
                    } else if (path.count != 1) throw Exception(
                        "Unsupported interpolation path"
                    )
                    pieces.add(BoundExternalCodeSegment(
                        piece.range, "", value, "identity"
                    ))
                    pieceIndex++
                    continue
                }
                let value = BoundReferenceExpression(
                    piece.range, root.semanticType, root.name, root.identity
                )
                var BoundExpression projected = value
                var String rendering = "identity"
                if (path.count == 2 && root.semanticType.kind() == "generic-instance") {
                    let access = PrimitiveMemberAccessSyntax(piece.range,
                        PrimitiveReferenceSyntax(piece.range, root.name), path[1])
                    projected = PrimitiveClassBinder().bindScopedExpression(
                        access, receiver, fields, locals, callables, availableFields: availableFields)
                } else if (path.count == 3 && root.semanticType.kind() == "user-class") {
                    let field = ownerField(
                        root.semanticType, path[1], fields, availableFields
                    )
                    if (!field) throw Exception("Unsupported interpolation path")
                    projected = BoundMemberAccessExpression(
                        piece.range, field.semanticType, value,
                        field.name, field.identity
                    )
                    if (path[2] == "data") {
                        if (projected.semanticType.kind() == "array") {
                            projected = BoundNativeArrayDataExpression(
                                piece.range, projected
                            )
                        } else {
                            let nestedField = ownerField(
                                projected.semanticType, path[2], fields, availableFields
                            )
                            if (!nestedField) throw Exception(
                                "Unsupported interpolation path"
                            )
                            projected = BoundMemberAccessExpression(
                                piece.range, nestedField.semanticType, projected,
                                nestedField.name, nestedField.identity
                            )
                        }
                    } else throw Exception("Unsupported interpolation path")
                } else if (path.count == 2 && root.semanticType.kind() == "user-class") {
                    let access = PrimitiveMemberAccessSyntax(piece.range,
                        PrimitiveReferenceSyntax(piece.range, root.name), path[1])
                    projected = PrimitiveClassBinder().bindScopedExpression(access, receiver, fields,
                        locals, callables, typeResolver: currentTypeResolver,
                        availableFields: availableFields, hierarchy: currentHierarchy)
                } else if (path.count == 2 && root.semanticType.kind() == "array") {
                    if (path[1] == "data") {
                        projected = BoundNativeArrayDataExpression(piece.range, value)
                    } else if (path[1] == "count") {
                        projected = BoundArrayLengthExpression(piece.range, value)
                    } else throw Exception("Unsupported interpolation path")
                } else rendering = renderingFor(value, path)
                pieces.add(BoundExternalCodeSegment(
                    piece.range, "", projected, rendering
                ))
            }
            pieceIndex++
        }
        var String selectedTarget = ""
        selectedTarget += "es"
        selectedTarget += "6"
        let nameBindings = BoundExternalNameBinding[]
        for (local in locals) {
            if (local.identity.symbolKind == "parameter") {
                nameBindings.add(BoundExternalNameBinding(
                    local.name,
                    BoundReferenceExpression(
                        syntax.range, local.semanticType, local.name, local.identity
                    )
                ))
            }
        }
        return BoundExternalStatement(syntax.range, selectedTarget, pieces, nameBindings)
    }

    bindExpression(
        PrimitiveExpressionSyntax syntax,
        LocalBinding[] locals,
        BoundReferenceExpression receiver,
        BoundFieldUnit[] fields,
        CallableSignature[] callables,
        Bool suppressAwait = false
    ) -> BoundExpression {
        if (syntax.class.isOfType(PrimitiveMemberCallSyntax.class)) {
            let call = (PrimitiveMemberCallSyntax)syntax
            if (call.receiver.class.isOfType(PrimitiveReferenceSyntax.class)) {
                let ownerName = ((PrimitiveReferenceSyntax)call.receiver).name
                if (!locals.any({ _.name == ownerName }) && !fields.any({ _.name == ownerName }) &&
                    callables.any((candidate) => candidate.callableKind.value == "static-method" &&
                        candidate.ownerType && candidate.ownerType.declarationIdentity.name == ownerName &&
                        candidate.name == call.memberName)) {
                    return PrimitiveClassBinder().bindScopedExpression(syntax, receiver, fields, locals,
                        callables, typeResolver: currentTypeResolver,
                        availableFields: currentAvailableFields, hierarchy: currentHierarchy)
                }
            }
        }
        if (syntax.class.isOfType(PrimitiveCallSyntax.class)) {
            let call = (PrimitiveCallSyntax)syntax
            let function = locals.reverse().firstOrNull({ _.name == call.name })
            if (!function || function.semanticType.kind() != "function") {
                throw Exception("Unknown external interpolation function '#{call.name}'")
            }
            let typeObject = (Object)function.semanticType
            var FunctionSemanticType functionType
            functionType = (FunctionSemanticType)typeObject
            let arguments = BoundExpression[]
            for (argument in call.argumentValues()) {
                arguments.add(bindExpression(
                    argument, locals, receiver, fields, callables
                ))
            }
            return BoundFunctionInvocationExpression(
                call.range,
                BoundReferenceExpression(
                    call.range, function.semanticType, function.name, function.identity
                ),
                functionType,
                arguments,
                suppressAwait
            )
        }
        if (syntax.class.isOfType(PrimitiveArrayAccessSyntax.class)) {
            let access = (PrimitiveArrayAccessSyntax)syntax
            var BoundExpression projectedReceiver = bindExpression(
                access.receiver, locals, receiver, fields, callables
            )
            if (projectedReceiver.semanticType.kind() != "array" &&
                access.receiver.class.isOfType(PrimitiveReferenceSyntax.class)) {
                let name = ((PrimitiveReferenceSyntax)access.receiver).name
                let field = fields.firstOrNull((candidate) =>
                    candidate.name == name
                )
                if (field && receiver) projectedReceiver = BoundMemberAccessExpression(
                    access.receiver.range, field.semanticType, receiver,
                    field.name, field.identity
                )
            }
            let index = bindExpression(
                access.index, locals, receiver, fields, callables
            )
            if (projectedReceiver.semanticType.kind() == "user-class" ||
                projectedReceiver.semanticType.kind() == "generic-instance") {
                let indexedOwner = projectedReceiver.semanticType.kind() == "generic-instance"
                    ? ((GenericInstanceSemanticType)projectedReceiver.semanticType).declarationType.value()
                    : projectedReceiver.semanticType.value()
                let getter = callables.firstOrNull((candidate) =>
                    candidate.identity.symbolKind == "array-getter" &&
                    candidate.ownerType.value() == indexedOwner
                )
                if (getter) {
                    let checked = CallTypeChecker.check(
                        getter, projectedReceiver.semanticType,
                        [index.semanticType], access.range
                    )
                    if (!checked.valid) throw Exception(checked.diagnostic.message)
                    let selected = projectedReceiver.semanticType.kind() == "generic-instance" &&
                        getter.ownerGenericDeclaration ? getter.instantiateReceiver(
                            (GenericInstanceSemanticType)projectedReceiver.semanticType
                        ) : getter
                    return BoundCallExpression(
                        access.range, checked.semanticType, selected, projectedReceiver,
                        [index], checked.argumentConversions()
                    )
                }
            }
            if (projectedReceiver.semanticType.kind() != "array") {
                throw Exception("External array access requires an array receiver")
            }
            let typeObject = (Object)projectedReceiver.semanticType
            var ArraySemanticType arrayType
            arrayType = (ArraySemanticType)typeObject
            return BoundArrayAccessExpression(
                access.range, arrayType.elementType, projectedReceiver, index
            )
        }
        if (syntax.class.isOfType(PrimitiveMemberAccessSyntax.class)) {
            let access = (PrimitiveMemberAccessSyntax)syntax
            let projectedReceiver = bindExpression(
                access.receiver, locals, receiver, fields, callables
            )
            if (projectedReceiver.semanticType.kind() == "array") {
                if (access.memberName == "data") {
                    return BoundNativeArrayDataExpression(
                        access.range, projectedReceiver
                    )
                }
                if (access.memberName == "count") {
                    return BoundArrayLengthExpression(
                        access.range, projectedReceiver
                    )
                }
            }
        }
        if (syntax.class.isOfType(PrimitiveReferenceSyntax.class)) {
            let reference = (PrimitiveReferenceSyntax)syntax
            let local = locals.reverse().firstOrNull({ _.name == reference.name })
            if (local && local.identity.symbolKind == "field") {
                let field = fields.firstOrNull({ _.identity == local.identity })
                if (!field) throw Exception("Invalid external field reference")
                if (field.staticField) return BoundReferenceExpression(reference.range, field.semanticType,
                    field.name, field.identity, staticOwner: field.canonicalOwner(),
                    fieldOwnerIdentity: field.canonicalOwner())
                if (!receiver) throw Exception("Invalid external instance field reference")
                return BoundMemberAccessExpression(
                    reference.range, field.semanticType, receiver, field.name, field.identity
                )
            }
            if (!local) {
                let field = fields.firstOrNull({ _.name == reference.name })
                if (field && field.staticField) return BoundReferenceExpression(reference.range, field.semanticType,
                    field.name, field.identity, staticOwner: field.canonicalOwner(),
                    fieldOwnerIdentity: field.canonicalOwner())
                if (field && receiver) return BoundMemberAccessExpression(
                    reference.range, field.semanticType, receiver, field.name, field.identity
                )
            }
        }
        let result = PrimitiveExpressionBinder().bind(syntax, locals: locals, callables: callables)
        if (!result.succeeded) throw Exception(result.diagnostic.message)
        return result.expression
    }

    ownerField(
        SemanticType ownerType,
        String name,
        BoundFieldUnit[] fields,
        BoundFieldUnit[] availableFields
    ) -> BoundFieldUnit {
        if (!ownerType || ownerType.kind() != "user-class") return null
        let expectedOwner = ((UserClassSemanticType)ownerType).declarationIdentity.value
        let field = fields.firstOrNull((candidate) =>
            candidate.name == name &&
            candidate.canonicalOwner().value == expectedOwner
        )
        if (field) return field
        return availableFields.firstOrNull((candidate) =>
            candidate.name == name &&
            candidate.canonicalOwner().value == expectedOwner
        )
    }

    renderingFor(BoundReferenceExpression value, String[] path) -> String {
        var String rendering = "identity"
        if (path.count == 3) {
            if (path[1] == "chars" && path[2] == "data" &&
                value.semanticType.value() == SemanticTypes.stringType().value()) {
                rendering = "es6-native-string"
            } else throw Exception("Unsupported interpolation path")
        } else if (path.count != 1) throw Exception("Unsupported interpolation path")
        return rendering
    }
}
