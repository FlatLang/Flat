package flat/semantic/binding/primitive

import flat/compiler/models
import flat/parser/flat
import flat/bound
import flat/semantic/types
import flat/semantic/binding/BindingDiagnostic

/** Types immutable primitive syntax into reduced Bound expressions. */
class {
    var PrimitiveFunctionSyntax[] functionDeclarations
    var String[] defaultExpansionPath
    var String[] defaultExpansionSites

    public construct(PrimitiveFunctionSyntax[] declarations = PrimitiveFunctionSyntax[], String[] expansionPath = String[],
        String[] expansionSites = String[]) {
        if (!declarations || declarations.any((value) => !value) || !expansionPath)
            throw Exception("Expression binding requires valid function declarations")
        functionDeclarations = PrimitiveFunctionSyntax[]:addAll(declarations)
        defaultExpansionPath = String[]:addAll(expansionPath)
        defaultExpansionSites = String[]:addAll(expansionSites)
    }

    /** Identity-based immutable declaration lookup; never borrow caller locals by spelling. */
    functionDeclaration(CallableSignature target) -> PrimitiveFunctionSyntax {
        return functionDeclarations.firstOrNull((value) => DeclarationIdentity(
            SyntaxIslandIdentity(value.range.snapshot, "function", value.range.startTokenIndex),
            "function", value.name).value == target.identity.declaration.value)
    }

    var SymbolIdentity[] specializedGenericParameters = SymbolIdentity[]
    var FunctionSemanticType originalCallbackContract
    var SourceRange originalCallbackRange
    var LocalBinding[] implicitParameters = LocalBinding[]
    /** Local prefix updates store and yield the new value using the assignment-value contract. */
    public static bindPrefixUpdate(SourceRange range, String operator, BoundExpression operand) -> BoundExpression {
        if (!operand.class.isOfType(BoundReferenceExpression.class)) {
            throw Exception("Prefix update requires a local reference")
        }
        let target = (BoundReferenceExpression)operand
        if (!TypeOperations.unary("+", target.semanticType, range).valid) {
            throw Exception("Prefix update requires a numeric local")
        }
        let operation = operator == "++" ? "+" : "-"
        let one = BoundLiteralExpression(range, SemanticTypes.intType(), "1")
        let typed = TypeOperations.binary(operation, target.semanticType, one.semanticType, range)
        if (!typed.valid || typed.semanticType.value() != target.semanticType.value()) {
            throw Exception("Prefix update requires a numeric local")
        }
        let updated = BoundBinaryExpression(range, typed.semanticType, operation, target, one)
        return BoundAssignmentValueExpression(range, target.semanticType, target, updated,
            TypeConversions.classify(updated.semanticType, target.semanticType))
    }

    var Int implicitParameterIndex
    var TypeHierarchyComponent currentHierarchy
    var PrimitiveResolvedDeclarationContext currentDeclarationContext

    /** Context supplies parameter types; call applicability validates the inferred result. */
    statementReferences(BoundStatement[] statements, String identity) -> Bool {
        for (statement in statements) {
            if (statement.class.isOfType(BoundExpressionStatement.class) &&
                boundReferences(((BoundExpressionStatement)statement).expression, identity)) return true
            if (statement.class.isOfType(BoundReturnStatement.class)) {
                let returned = (BoundReturnStatement)statement
                if (returned.value && boundReferences(returned.value, identity)) return true
            }
            if (statement.class.isOfType(BoundLocalDeclarationStatement.class)) {
                let local = (BoundLocalDeclarationStatement)statement
                if (local.initializer && boundReferences(local.initializer, identity)) return true
            }
            if (statement.class.isOfType(BoundIfStatement.class)) {
                let branch = (BoundIfStatement)statement
                if (boundReferences(branch.condition, identity) || statementReferences(branch.thenValues(), identity) ||
                    statementReferences(branch.elseValues(), identity)) return true
            }
            if (statement.class.isOfType(BoundWhileStatement.class)) {
                let loop = (BoundWhileStatement)statement
                if (boundReferences(loop.condition, identity) || statementReferences(loop.bodyValues(), identity)) return true
            }
        }
        return false
    }

    boundReferences(BoundExpression expression, String identity) -> Bool {
        if (expression.class.isOfType(BoundEvaluationExpression.class)) {
            let evaluation = (BoundEvaluationExpression)expression
            return statementReferences(evaluation.setup(), identity) || boundReferences(evaluation.value, identity)
        }
        if (expression.class.isOfType(BoundReferenceExpression.class))
            return ((BoundReferenceExpression)expression).symbolIdentity.value == identity
        if (expression.class.isOfType(BoundFunctionInvocationExpression.class)) {
            let invocation = (BoundFunctionInvocationExpression)expression
            return boundReferences(invocation.functionValue, identity) || invocation.argumentValues().any({ boundReferences(_, identity) })
        }
        if (expression.class.isOfType(BoundBinaryExpression.class)) {
            let binary = (BoundBinaryExpression)expression
            return boundReferences(binary.left, identity) || boundReferences(binary.right, identity)
        }
        if (expression.class.isOfType(BoundUnaryExpression.class)) return boundReferences(((BoundUnaryExpression)expression).operand, identity)
        if (expression.class.isOfType(BoundConversionExpression.class)) return boundReferences(((BoundConversionExpression)expression).value, identity)
        if (expression.class.isOfType(BoundMemberAccessExpression.class)) return boundReferences(((BoundMemberAccessExpression)expression).receiver, identity)
        if (expression.class.isOfType(BoundCallExpression.class)) {
            let call = (BoundCallExpression)expression
            return (call.receiver && boundReferences(call.receiver, identity)) || call.argumentValues().any({ boundReferences(_, identity) })
        }
        if (expression.class.isOfType(BoundLambdaExpression.class)) return ((BoundLambdaExpression)expression).captureValues().any({ _.symbolIdentity.value == identity })
        return false
    }

    statementReturns(BoundStatement[] statements) -> BoundReturnStatement[] {
        let result = BoundReturnStatement[]
        for (statement in statements) {
            if (statement.class.isOfType(BoundReturnStatement.class)) result.add((BoundReturnStatement)statement)
            else if (statement.class.isOfType(BoundIfStatement.class)) {
                let branch = (BoundIfStatement)statement
                result.addAll(statementReturns(branch.thenValues()))
                result.addAll(statementReturns(branch.elseValues()))
            }
        }
        return result
    }

    /** Keep concrete return conversions explicit before an ABI pass erases generic slots. */
    typedCallbackReturns(BoundStatement[] statements, SemanticType resultType) -> BoundStatement[] {
        let result = BoundStatement[]
        for (statement in statements) {
            if (statement.class.isOfType(BoundReturnStatement.class)) {
                let returned = (BoundReturnStatement)statement
                if (!returned.value || (resultType.value() == SemanticTypes.unitType().value() &&
                    returned.requiredType.kind() == "null")) {
                    result.add(statement)
                } else {
                    let conversion = TypeConversions.classify(returned.value.semanticType, resultType,
                        hierarchy: currentHierarchy)
                    if (!conversion.applicable) throw Exception("Callback return type mismatch at token #{returned.range.startTokenIndex}")
                    result.add(BoundReturnStatement(returned.range, resultType, returned.value, conversion))
                }
            } else if (statement.class.isOfType(BoundIfStatement.class)) {
                let branch = (BoundIfStatement)statement
                result.add(BoundIfStatement(branch.range, branch.condition,
                    typedCallbackReturns(branch.thenValues(), resultType),
                    typedCallbackReturns(branch.elseValues(), resultType)))
            } else result.add(statement)
        }
        return result
    }

    terminalStatements(BoundStatement[] statements) -> Bool {
        for (statement in statements) {
            if (statement.class.isOfType(BoundReturnStatement.class) || statement.class.isOfType(BoundThrowStatement.class)) return true
            if (statement.class.isOfType(BoundIfStatement.class)) {
                let branch = (BoundIfStatement)statement
                if (terminalStatements(branch.thenValues()) && terminalStatements(branch.elseValues())) return true
            }
        }
        return false
    }

    /** Reference truth follows the language null-check contract, never unknown or numeric coercion. */
    public static bindReferenceNegation(SourceRange range, BoundExpression operand) -> BoundExpression {
        let kind = operand.semanticType.kind()
        if (kind != "user-class" && kind != "generic-instance" && kind != "generic-parameter" &&
            kind != "object" && kind != "string" && kind != "array" && kind != "function") return null
        var BoundExpression compared = operand
        if (kind != "generic-parameter") {
            let lifted = NullableSemanticType(operand.semanticType)
            compared = BoundConversionExpression(range, lifted, operand,
                TypeConversions.classify(operand.semanticType, lifted))
        }
        return BoundBinaryExpression(range, SemanticTypes.boolType(), "==", compared,
            BoundLiteralExpression(range, SemanticTypes.nullType(), "null"))
    }

    specializedNullOperand(BoundExpression operand) -> BoundExpression {
        if (!operand.class.isOfType(BoundReferenceExpression.class)) return operand
        let reference = (BoundReferenceExpression)operand
        if (!specializedGenericParameters.contains(reference.symbolIdentity) || operand.semanticType.kind() != "primitive") return operand
        let lifted = NullableSemanticType(operand.semanticType)
        return BoundConversionExpression(operand.range, lifted, operand, TypeConversions.classify(operand.semanticType, lifted))
    }

    arrayDiagnostic(String code, String message, SourceRange range) -> PrimitiveContextBindingException =>
        PrimitiveContextBindingException(BindingDiagnostic(code, message,
            SyntaxIslandIdentity(range.snapshot, "array-element", range.startTokenIndex), range))

    /** Each element remains one expression, in source order, with a truthful storage type. */
    adaptArrayElement(BoundExpression value, SemanticType required,
        CallableSignature[] callables) -> BoundExpression {
        var BoundExpression adapted = value
        if (required.kind() == "user-class" &&
            ((UserClassSemanticType)required).declarationIdentity.name == "String" &&
            value.semanticType.kind() == "string") {
            try {
                adapted = PrimitiveStringAdapter.wrap(value, required, currentDeclarationContext, callables)
            } catch (Exception error) {
                throw arrayDiagnostic(
                    "type.array-element-conversion", error.message ?: "Invalid array text element", value.range)
            }
        }
        let conversion = TypeConversions.classify(adapted.semanticType, required, hierarchy: currentHierarchy)
        if (!conversion.applicable) throw arrayDiagnostic(
            "type.array-element-conversion",
            "Array element '#{adapted.semanticType.value()}' cannot convert to '#{required.value()}'", value.range)
        if (conversion.conversionKind == "identity") return adapted
        return BoundConversionExpression(value.range, required, adapted, conversion)
    }

    /** Resolve representation evidence while canonical source identities are available.
     * A generic result is boxed only after its concrete return conversion.
     */
    public static callbackBoxingConstructor(SemanticType concrete, FunctionSemanticType declaration,
        PrimitiveResolvedDeclarationContext context, CallableSignature[] callables) -> CallableSignature {
        if (!declaration || declaration.returnType.kind() != "generic-parameter" ||
            concrete.kind() != "primitive") return null
        if (!context) throw Exception("Generic callback result requires canonical boxing declaration evidence")
        let name = concrete.value().substring("primitive:".count)
        let location = name == "Bool" ? "flat/primitive/Bool" : "flat/primitive/number/#name"
        let declarations = context.candidates(location)
        if (declarations.count != 1) throw Exception("Generic callback result requires one canonical boxing declaration")
        let owner = UserClassSemanticType(declarations.first)
        let targets = callables.filter((candidate) => candidate.callableKind.value == "constructor" &&
            !candidate.asyncFunction && candidate.ownerType && candidate.ownerType.value() == owner.value() &&
            candidate.returnType.value() == owner.value() && candidate.parameterTypes().count == 1 &&
            candidate.optionalParameterCount == 0 && candidate.parameterTypes().first.value() == concrete.value())
        if (targets.count != 1) throw Exception("Generic callback result requires one canonical storage boxing constructor")
        return targets.first
    }

    /** Static references are immutable selections: adapting them introduces no eager call. */
    public static adaptCallbackReference(BoundExpression value, FunctionSemanticType declaration,
        PrimitiveResolvedDeclarationContext context, CallableSignature[] callables) -> BoundExpression {
        if (!declaration || !value.class.isOfType(BoundFunctionValue.class)) return value
        Object referenceTypeSource = value.semanticType
        FunctionSemanticType type = (FunctionSemanticType)referenceTypeSource
        if (declaration.returnType.kind() != "generic-parameter") return value
        if (declaration.parameterTypes().any({ _.kind() == "generic-parameter" })) {
            throw Exception("Generic function reference adapter requires resolved parameter representation evidence")
        }
        let parameters = BoundFunctionParameter[]
        let arguments = BoundExpression[]
        var Int index
        for (parameterType in type.parameterTypes()) {
            let owner = DeclarationIdentity(SyntaxIslandIdentity(value.range.snapshot, "callback-reference", value.range.startTokenIndex),
                "callback-reference", "argument#index")
            let identity = SymbolIdentity(owner, "parameter", index)
            let name = "argument#index"
            parameters.add(BoundFunctionParameter(name, identity, parameterType))
            arguments.add(BoundReferenceExpression(value.range, parameterType, name, identity))
            index++
        }
        let invocation = BoundFunctionInvocationExpression(value.range, value, type, arguments)
        return BoundLambdaExpression(value.range, type, parameters, BoundReferenceExpression[],
            invocation, declarationContract: declaration,
            resultBoxingConstructor: callbackBoxingConstructor(type.returnType, declaration, context, callables))
    }

    public bindCallback(PrimitiveLambdaSyntax syntax, FunctionSemanticType context,
        LocalBinding[] locals, CallableSignature[] callables,
        TypeHierarchyComponent hierarchy = null,
        FunctionSemanticType originalContract = null,
        PrimitiveResolvedDeclarationContext declarationContext = null) -> PrimitiveExpressionBindingResult {
        originalCallbackContract = originalContract
        originalCallbackRange = syntax.range
        specializedGenericParameters = SymbolIdentity[]
        currentHierarchy = hierarchy
        currentDeclarationContext = declarationContext
        try {
            return PrimitiveExpressionBindingResult(expression: bindSyntax(syntax, locals, callables, context))
        } catch (Exception error) {
            if (error.class.isOfType(PrimitiveContextBindingException.class)) {
                let diagnostic = ((PrimitiveContextBindingException)error).diagnostic
                return PrimitiveExpressionBindingResult(diagnostic: PrimitiveExpressionDiagnostic(
                    diagnostic.code, diagnostic.name, diagnostic.range))
            }
            return PrimitiveExpressionBindingResult(diagnostic: PrimitiveExpressionDiagnostic(
                "semantic.primitive-expression", error.message, syntax.range
            ))
        } finally {
            originalCallbackContract = null
            originalCallbackRange = null
            specializedGenericParameters = SymbolIdentity[]
        }
    }

    /** Nested statement expressions retain the enclosing callback's semantic authority. */
    public bindNested(PrimitiveExpressionSyntax syntax, LocalBinding[] locals, CallableSignature[] callables) -> PrimitiveExpressionBindingResult {
        return bind(syntax, locals: locals, callables: callables,
            hierarchy: currentHierarchy, declarationContext: currentDeclarationContext)
    }

    public bind(
        PrimitiveExpressionSyntax syntax,
        SemanticType requiredType = null,
        LocalBinding[] locals = LocalBinding[],
        CallableSignature[] callables = CallableSignature[],
        Bool explicitConversion = false,
        TypeHierarchyComponent hierarchy = null,
        PrimitiveResolvedDeclarationContext declarationContext = null
    ) -> PrimitiveExpressionBindingResult {
        currentHierarchy = hierarchy
        currentDeclarationContext = declarationContext
        if (!syntax || !locals || !callables) throw Exception("Primitive binding requires syntax, locals, and callables")
        try {
            if (requiredType && requiredType.kind() == "function" &&
                syntax.class.isOfType(PrimitiveLambdaSyntax.class)) {
                let lambda = (PrimitiveLambdaSyntax)syntax
                if (lambda.emptyBody) {
                    let type = (FunctionSemanticType)requiredType
                    if (type.returnType.value() != SemanticTypes.unitType().value()) {
                        throw Exception("Empty callback requires a Unit return type")
                    }
                    let parameters = BoundFunctionParameter[]
                    var Int index
                    for (parameterType in type.parameterTypes()) {
                        let name = "argument#index"
                        let owner = DeclarationIdentity(
                            SyntaxIslandIdentity(lambda.range.snapshot, "lambda", lambda.range.startTokenIndex),
                            "lambda-parameter", name
                        )
                        parameters.add(BoundFunctionParameter(
                            name, SymbolIdentity(owner, "lambda-parameter", index), parameterType
                        ))
                        index++
                    }
                    return PrimitiveExpressionBindingResult(expression: BoundLambdaExpression(
                        lambda.range, type, parameters, BoundReferenceExpression[],
                        BoundLiteralExpression(lambda.range, SemanticTypes.unitType(), "null"),
                        declarationContract: type
                    ))
                }
            }
            var BoundExpression expression = bindSyntax(syntax, locals, callables, requiredType)
            if (requiredType && requiredType.kind() == "function") expression = adaptCallbackReference(
                expression, (FunctionSemanticType)requiredType, currentDeclarationContext, callables)
            if (!requiredType) return PrimitiveExpressionBindingResult(expression: expression)
            let conversion = TypeConversions.classify(
                expression.semanticType, requiredType, explicit: explicitConversion, hierarchy: currentHierarchy
            )
            if (!conversion.applicable) {
                return PrimitiveExpressionBindingResult(diagnostic: PrimitiveExpressionDiagnostic(
                    "type.primitive-conversion",
                    "Primitive expression '#{expression.semanticType.value()}' cannot convert to '#{requiredType.value()}'",
                    expression.range
                ))
            }
            if (conversion.conversionKind == "numeric-unboxing") {
                return PrimitiveExpressionBindingResult(diagnostic: PrimitiveExpressionDiagnostic(
                    "binding.numeric-unboxing-projection-unsupported",
                    "Numeric unboxing requires resolved Number projection evidence", expression.range))
            }
            if (conversion.conversionKind == "identity") {
                return PrimitiveExpressionBindingResult(expression: expression)
            }
            return PrimitiveExpressionBindingResult(expression: BoundConversionExpression(
                expression.range, requiredType, expression, conversion
            ))
        } catch (Exception error) {
            if (error.class.isOfType(PrimitiveContextBindingException.class)) {
                let diagnostic = ((PrimitiveContextBindingException)error).diagnostic
                return PrimitiveExpressionBindingResult(diagnostic: PrimitiveExpressionDiagnostic(
                    diagnostic.code, diagnostic.name, diagnostic.range))
            }
            return PrimitiveExpressionBindingResult(diagnostic: PrimitiveExpressionDiagnostic(
                "semantic.primitive-expression",
                error.message ?: "Invalid primitive expression",
                syntax.range
            ))
        }
    }

    namedType(String name) -> SemanticType {
        if (name == "Bool") return SemanticTypes.boolType()
        if (name == "Byte") return SemanticTypes.byteType()
        if (name == "Short") return SemanticTypes.shortType()
        if (name == "Int") return SemanticTypes.intType()
        if (name == "Long") return SemanticTypes.longType()
        if (name == "Float") return SemanticTypes.floatType()
        if (name == "Double") return SemanticTypes.doubleType()
        if (name == "Char") return SemanticTypes.charType()
        if (name == "String") return SemanticTypes.stringType()
        throw Exception("Unknown lambda parameter type '#name'")
    }

    referencesName(PrimitiveExpressionSyntax syntax, String name) -> Bool {
        if (syntax.class.isOfType(PrimitiveReferenceSyntax.class)) {
            return ((PrimitiveReferenceSyntax)syntax).name == name
        }
        if (syntax.class.isOfType(PrimitiveConstructionSyntax.class)) {
            return ((PrimitiveConstructionSyntax)syntax).argumentValues().any({ referencesName(_, name) })
        }
        if (syntax.class.isOfType(PrimitiveArrayConstructionSyntax.class)) {
            return referencesName(((PrimitiveArrayConstructionSyntax)syntax).size, name)
        }
        if (syntax.class.isOfType(PrimitiveArraySyntax.class)) {
            return ((PrimitiveArraySyntax)syntax).elementValues().any({ referencesName(_, name) })
        }
        if (syntax.class.isOfType(PrimitiveArrayAccessSyntax.class)) {
            let access = (PrimitiveArrayAccessSyntax)syntax
            return referencesName(access.receiver, name) || referencesName(access.index, name)
        }
        if (syntax.class.isOfType(PrimitiveInterpolationPathSyntax.class)) {
            return ((PrimitiveInterpolationPathSyntax)syntax).pathValues().first == name
        }
        if (syntax.class.isOfType(PrimitiveInterpolatedStringSyntax.class)) {
            return ((PrimitiveInterpolatedStringSyntax)syntax).segmentValues().any((segment) =>
                !segment.literal() && referencesName(segment.expression, name))
        }
        if (syntax.class.isOfType(PrimitiveConditionalSyntax.class)) {
            let conditional = (PrimitiveConditionalSyntax)syntax
            return referencesName(conditional.condition, name) ||
                referencesName(conditional.whenTrue, name) || referencesName(conditional.whenFalse, name)
        }
        if (syntax.class.isOfType(PrimitiveCastSyntax.class)) {
            return referencesName(((PrimitiveCastSyntax)syntax).value, name)
        }
        if (syntax.class.isOfType(PrimitivePostfixUpdateSyntax.class)) {
            return referencesName(((PrimitivePostfixUpdateSyntax)syntax).operand, name)
        }
        if (syntax.class.isOfType(PrimitiveDeclarationValueSyntax.class)) {
            return referencesName(((PrimitiveDeclarationValueSyntax)syntax).value, name)
        }
        if (syntax.class.isOfType(PrimitiveAssignmentValueSyntax.class)) {
            let assignment = (PrimitiveAssignmentValueSyntax)syntax
            return assignment.name == name || referencesName(assignment.value, name)
        }
        if (syntax.class.isOfType(PrimitiveLambdaSyntax.class)) {
            let lambda = (PrimitiveLambdaSyntax)syntax
            return !lambda.emptyBody &&
                !lambda.parameterValues().any({ _.name == name }) &&
                referencesName(lambda.body, name)
        }
        if (syntax.class.isOfType(PrimitiveUnarySyntax.class)) {
            return referencesName(((PrimitiveUnarySyntax)syntax).operand, name)
        }
        if (syntax.class.isOfType(PrimitiveBinarySyntax.class)) {
            let value = (PrimitiveBinarySyntax)syntax
            return referencesName(value.left, name) || referencesName(value.right, name)
        }
        if (syntax.class.isOfType(PrimitiveMemberCallSyntax.class)) {
            let call = (PrimitiveMemberCallSyntax)syntax
            return referencesName(call.receiver, name) ||
                call.argumentValues().any({ referencesName(_, name) }) ||
                call.namedArgumentValues().any({ referencesName(_.value, name) })
        }
        if (syntax.class.isOfType(PrimitiveCallSyntax.class)) {
            let call = (PrimitiveCallSyntax)syntax
            return call.name == name || call.argumentValues().any({ referencesName(_, name) })
        }
        return false
    }

    /** Candidate-local contextual binding; defaults expand only after unique selection. */
    bindDeclaredFunctionCall(PrimitiveCallSyntax syntax, LocalBinding[] locals,
        CallableSignature[] callables) -> BoundExpression {
        let candidates = callables.filter((candidate) => candidate.name == syntax.name &&
            (candidate.callableKind.value == "function" || candidate.callableKind.value == "static-method" ||
             candidate.callableKind.value == "constructor"))
        let checks = CallCheckResult[]
        let calls = BoundCallExpression[]
        for (candidate in candidates) {
            if (syntax.argumentValues().count > candidate.parameterTypes().count ||
                syntax.argumentValues().count < candidate.parameterTypes().count - candidate.optionalParameterCount) continue
            try {
                let arguments = BoundExpression[]
                let candidateLocals = LocalBinding[]:addAll(locals)
                var Int index
                for (argument in syntax.argumentValues()) {
                    let binder = PrimitiveExpressionBinder(functionDeclarations, defaultExpansionPath, defaultExpansionSites)
                    let required = candidate.parameterTypes()[index]
                    let result = argument.class.isOfType(PrimitiveLambdaSyntax.class) && required.kind() == "function"
                        ? binder.bindCallback((PrimitiveLambdaSyntax)argument, (FunctionSemanticType)required,
                            candidateLocals, callables, currentHierarchy, (FunctionSemanticType)required, currentDeclarationContext)
                        : binder.bind(argument, locals: candidateLocals, callables: callables,
                            hierarchy: currentHierarchy, declarationContext: currentDeclarationContext)
                    if (!result.succeeded) throw Exception(result.diagnostic.message)
                    arguments.add(required.kind() == "function" ? adaptCallbackReference(result.expression,
                        (FunctionSemanticType)required, currentDeclarationContext, callables) : result.expression)
                    index++
                }
                let checked = CallTypeChecker.check(candidate, null,
                    arguments.map((argument) => argument.semanticType), syntax.range, currentHierarchy)
                if (!checked.valid) continue
                checks.add(checked)
                calls.add(BoundCallExpression(syntax.range, checked.semanticType, checked.target,
                    arguments, checked.argumentConversions()))
            } catch (Exception error) {
                // A candidate owns its contextual failure; other overloads remain independent.
            }
        }
        let resolution = OverloadResolver.resolveChecked(syntax.name, candidates, checks, syntax.range)
        if (!resolution.resolved) throw Exception(resolution.diagnostic.message)
        let call = calls.firstOrNull((value) => value.target.identity.value == resolution.selected.identity.value)
        if (call.argumentValues().count == call.target.parameterTypes().count) return call
        let declaration = functionDeclaration(call.target)
        if (!declaration) throw Exception("Omitted arguments require selected declaration default evidence")
        if (defaultExpansionPath.contains(call.target.identity.value))
            throw Exception("Cyclic omitted parameter default expansion")
        let expansionPath = String[]:addAll(defaultExpansionPath)
        expansionPath.add(call.target.identity.value)
        let expansionSites = String[]:addAll(defaultExpansionSites)
        expansionSites.add(syntax.range.snapshot.value + ":" + syntax.range.startTokenIndex)
        let arguments = BoundExpression[]
        let defaultLocals = LocalBinding[]
        let supplied = call.argumentValues()
        let conversions = call.argumentConversions()
        let parameters = declaration.parameterValues()
        var Int index
        for (parameter in parameters) {
            let type = call.target.parameterTypes()[index]
            var BoundExpression value
            var TypeConversion conversion
            if (index < supplied.count) {
                value = supplied[index]
                conversion = conversions[index]
            } else {
                if (!parameter.defaultValue) throw Exception("Missing selected parameter default")
                let result = PrimitiveExpressionBinder(functionDeclarations, expansionPath, expansionSites).bind(parameter.defaultValue,
                    requiredType: type, locals: defaultLocals, callables: callables,
                    hierarchy: currentHierarchy, declarationContext: currentDeclarationContext)
                if (!result.succeeded) throw Exception(result.diagnostic.message)
                value = result.expression
                conversion = TypeConversions.classify(value.semanticType, type, hierarchy: currentHierarchy)
            }
            let identity = SymbolIdentity(DeclarationIdentity(
                SyntaxIslandIdentity(syntax.range.snapshot, "call-default", syntax.range.startTokenIndex),
                "call-default", call.target.identity.value + ":" + defaultExpansionSites.join("|")), "argument", index)
            let retained = BoundReferenceExpression(syntax.range, type, "argument#index", identity)
            arguments.add(BoundEvaluationExpression(syntax.range, type,
                [BoundLocalDeclarationStatement(syntax.range, retained, value, conversion, evaluationLocal: true)], retained))
            defaultLocals.add(LocalBinding(parameter.name, identity, type))
            index++
        }
        let checked = CallTypeChecker.check(call.target, null,
            arguments.map((argument) => argument.semanticType), syntax.range, currentHierarchy)
        if (!checked.valid) throw Exception(checked.diagnostic.message)
        return BoundCallExpression(syntax.range, checked.semanticType, checked.target,
            arguments, checked.argumentConversions())
    }

    bindSyntax(
        PrimitiveExpressionSyntax syntax,
        LocalBinding[] locals,
        CallableSignature[] callables,
        SemanticType requiredType = null
    ) -> BoundExpression {
        let floatingLiteral = PrimitiveFloatingLiteralBinder.bind(syntax, requiredType)
        if (floatingLiteral) return floatingLiteral
        if (syntax.class.isOfType(PrimitiveMemberCallSyntax.class) &&
            ((PrimitiveMemberCallSyntax)syntax).memberName == "isOfType") {
            let call = (PrimitiveMemberCallSyntax)syntax
            if (call.receiver.class.isOfType(PrimitiveMemberAccessSyntax.class) &&
                ((PrimitiveMemberAccessSyntax)call.receiver).memberName == "class" &&
                call.argumentValues().count == 1 &&
                call.argumentValues().first.class.isOfType(PrimitiveMemberAccessSyntax.class)) {
                let argumentValues = call.argumentValues()
                let metadataObject = (Object)argumentValues.first
                let metadata = (PrimitiveMemberAccessSyntax)metadataObject
                if (metadata.memberName == "class" && metadata.receiver.class.isOfType(PrimitiveReferenceSyntax.class)) {
                    let name = ((PrimitiveReferenceSyntax)metadata.receiver).name
                    let owners = callables.filter((candidate) => candidate.ownerType &&
                        candidate.ownerType.declarationIdentity.name == name)
                    if (owners.isNotEmpty && owners.all((candidate) => candidate.ownerType.value() == owners.first.ownerType.value())) {
                        return BoundTypeTestExpression(call.range,
                            bindSyntax(((PrimitiveMemberAccessSyntax)call.receiver).receiver, locals, callables),
                            BoundTypeMetadataExpression(metadata.range, owners.first.ownerType))
                    }
                }
            }
        }
        if (syntax.class.isOfType(PrimitiveMemberCallSyntax.class)) {
            let value = (PrimitiveMemberCallSyntax)syntax
            if (value.safeAccess) throw Exception("Safe member call requires null-propagating binding")
            if (value.typeArgumentNames().isNotEmpty) {
                throw Exception("Explicit member type arguments require call instantiation")
            }
            let namedArguments = value.namedArgumentValues()
            if (namedArguments.isNotEmpty) {
                let positionalArguments = value.argumentValues()
                let owner = bindSyntax(value.receiver, locals, callables)
                let candidates = callables.filter((candidate) =>
                    candidate.callableKind.value == "instance-method" &&
                    candidate.ownerType.value() == owner.semanticType.value() &&
                    candidate.name == value.memberName &&
                    candidate.parameterNames().count == candidate.parameterTypes().count &&
                    candidate.parameterTypes().count == positionalArguments.count +
                        namedArguments.count
                )
                if (candidates.count > 1) {
                    let applicable = CallableSignature[]
                    for (candidate in candidates) {
                        let names = candidate.parameterNames()
                        var Bool matches = true
                        var Int index
                        while (index < namedArguments.count) {
                            if (names[positionalArguments.count + index] !=
                                namedArguments[index].name) matches = false
                            index++
                        }
                        if (matches) applicable.add(candidate)
                    }
                    if (applicable.isEmpty) {
                        let resolution = OverloadResolver.resolve(value.memberName, applicable,
                            owner.semanticType, SemanticType[], value.range)
                        throw Exception(resolution.diagnostic.message)
                    }
                    let arguments = BoundExpression[]
                    for (argument in positionalArguments) {
                        arguments.add(bindSyntax(argument, locals, callables))
                    }
                    for (argument in namedArguments) {
                        arguments.add(bindSyntax(argument.value, locals, callables))
                    }
                    let resolution = OverloadResolver.resolve(
                        value.memberName, applicable, owner.semanticType,
                        arguments.map({ _.semanticType }), value.range
                    )
                    if (!resolution.resolved) throw Exception(resolution.diagnostic.message)
                    let checked = CallTypeChecker.check(
                        resolution.selected, owner.semanticType,
                        arguments.map({ _.semanticType }), value.range
                    )
                    if (!checked.valid) throw Exception(checked.diagnostic.message)
                    return BoundCallExpression(value.range, checked.semanticType,
                        resolution.selected, owner, arguments, checked.argumentConversions())
                }
                if (candidates.isEmpty) {
                    let resolution = OverloadResolver.resolve(value.memberName, candidates,
                        owner.semanticType, SemanticType[], value.range)
                    throw Exception(resolution.diagnostic.message)
                }
                let target = candidates.first
                let ordered = BoundExpression[]
                let names = target.parameterNames()
                for (argument in namedArguments) {
                    if (!names.any({ _ == argument.name })) {
                        throw Exception("Unknown named member argument '#{argument.name}'")
                    }
                    var Int positionalIndex
                    while (positionalIndex < positionalArguments.count) {
                        if (names[positionalIndex] == argument.name) {
                            throw Exception("Member argument '#{argument.name}' supplied positionally and by name")
                        }
                        positionalIndex++
                    }
                }
                var Int namedIndex
                while (namedIndex < namedArguments.count) {
                    if (namedArguments[namedIndex].name !=
                        names[positionalArguments.count + namedIndex]) {
                        throw Exception("Reordered named member arguments require source-order lowering")
                    }
                    namedIndex++
                }
                for (argument in positionalArguments) {
                    ordered.add(bindSyntax(argument, locals, callables))
                }
                for (argument in namedArguments) {
                    ordered.add(bindSyntax(argument.value, locals, callables))
                }
                let resolution = OverloadResolver.resolve(value.memberName, candidates,
                    owner.semanticType, ordered.map({ _.semanticType }), value.range)
                if (!resolution.resolved) throw Exception(resolution.diagnostic.message)
                let checked = CallTypeChecker.check(
                    resolution.selected, owner.semanticType, ordered.map({ _.semanticType }), value.range
                )
                if (!checked.valid) throw Exception(checked.diagnostic.message)
                return BoundCallExpression(
                    value.range, checked.semanticType, resolution.selected, owner,
                    ordered, checked.argumentConversions()
                )
            }
            if (value.receiver.class.isOfType(PrimitiveEmptyArrayConstructionSyntax.class) &&
                value.memberName == "add" && value.argumentValues().count == 1) {
                let empty = (PrimitiveEmptyArrayConstructionSyntax)value.receiver
                let arrayType = ArraySemanticType(namedType(empty.elementTypeName))
                let argument = bindSyntax(value.argumentValues().first, locals, callables)
                let conversion = TypeConversions.classify(
                    argument.semanticType, arrayType.elementType
                )
                if (!conversion.applicable) throw Exception("Array add argument type mismatch")
                return BoundArrayExpression(value.range, arrayType, [argument])
            }
            let receiver = bindSyntax(value.receiver, locals, callables)
            let candidates = callables.filter((candidate) =>
                candidate.callableKind.value == "instance-method" &&
                candidate.name == value.memberName
            )
            let arguments = BoundExpression[]
            for (argument in value.argumentValues()) {
                arguments.add(bindSyntax(argument, locals, callables))
            }
            if (receiver.semanticType.kind() == "primitive") {
                let primitiveName = ((PrimitiveSemanticType)receiver.semanticType).name
                let staticCandidates = callables.filter((candidate) =>
                    candidate.callableKind.value == "static-method" &&
                    candidate.ownerType && candidate.ownerType.declarationIdentity.name == primitiveName &&
                    candidate.name == value.memberName && candidate.parameterTypes().isNotEmpty &&
                    candidate.parameterTypes().first.value() == receiver.semanticType.value()
                )
                if (staticCandidates.isNotEmpty) {
                    let staticArguments = BoundExpression[]
                    staticArguments.add(receiver)
                    staticArguments.addAll(arguments)
                    let staticResolution = OverloadResolver.resolve(value.memberName, staticCandidates, null,
                        staticArguments.map({ _.semanticType }), value.range, currentHierarchy)
                    if (!staticResolution.resolved) throw Exception(staticResolution.diagnostic.message)
                    let staticChecked = CallTypeChecker.check(staticResolution.selected, null,
                        staticArguments.map({ _.semanticType }), value.range, currentHierarchy)
                    if (!staticChecked.valid) throw Exception(staticChecked.diagnostic.message)
                    return BoundCallExpression(value.range, staticChecked.semanticType, staticChecked.target,
                        staticArguments, staticChecked.argumentConversions())
                }
            }
            let resolution = OverloadResolver.resolve(
                value.memberName, candidates, receiver.semanticType,
                arguments.map({ _.semanticType }), value.range, currentHierarchy
            )
            if (!resolution.resolved) throw Exception(resolution.diagnostic.message)
            let target = resolution.selected
            let checked = CallTypeChecker.check(
                target, receiver.semanticType, arguments.map({ _.semanticType }), value.range,
                currentHierarchy
            )
            if (!checked.valid) throw Exception(checked.diagnostic.message)
            return BoundCallExpression(
                value.range, checked.semanticType, checked.target, receiver,
                arguments, checked.argumentConversions(), false,
                TypeConversions.classify(receiver.semanticType, target.receiverType(), hierarchy: currentHierarchy)
            )
        }
        if (syntax.class.isOfType(PrimitiveDeclarationValueSyntax.class)) {
            let value = (PrimitiveDeclarationValueSyntax)syntax
            if (locals.any({ _.name == value.name })) {
                throw Exception("Duplicate declaration local '#{value.name}'")
            }
            let initialized = bindSyntax(value.value, locals, callables)
            let identity = SymbolIdentity(
                DeclarationIdentity(
                    SyntaxIslandIdentity(
                        value.range.snapshot, "declaration-value", value.range.startTokenIndex
                    ),
                    "declaration-value", value.name
                ),
                "local"
            )
            let local = BoundReferenceExpression(
                value.range, initialized.semanticType, value.name, identity
            )
            locals.add(LocalBinding(value.name, identity, initialized.semanticType))
            let storage = initialized.semanticType.kind() == "unknown"
                ? TypeConversion(
                    initialized.semanticType, initialized.semanticType,
                    "deferred-declaration-value", true, false, true, 1000
                )
                : TypeConversions.classify(
                    initialized.semanticType, initialized.semanticType
                )
            return BoundDeclarationValueExpression(
                value.range, initialized.semanticType, local, initialized, storage
            )
        }
        if (syntax.class.isOfType(PrimitivePostfixUpdateSyntax.class)) {
            let value = (PrimitivePostfixUpdateSyntax)syntax
            if (!value.operand.class.isOfType(PrimitiveReferenceSyntax.class)) {
                throw Exception("Postfix update requires a local reference")
            }
            let reference = (PrimitiveReferenceSyntax)value.operand
            let local = locals.reverse().firstOrNull({ _.name == reference.name })
            if (!local) throw Exception("Unknown postfix update local '#{reference.name}'")
            let target = BoundReferenceExpression(
                value.range, local.semanticType, local.name, local.identity
            )
            let one = BoundLiteralExpression(
                value.range, SemanticTypes.intType(), "1"
            )
            let operator = value.updateOperator == "++" ? "+" : "-"
            let typed = TypeOperations.binary(
                operator, target.semanticType, one.semanticType, value.range
            )
            if (!typed.valid ||
                typed.semanticType.value() != target.semanticType.value()) {
                throw Exception("Postfix update requires a numeric local")
            }
            return BoundPostfixUpdateExpression(
                value.range, target.semanticType, target, value.updateOperator
            )
        }
        if (syntax.class.isOfType(PrimitiveAssignmentValueSyntax.class)) {
            let value = (PrimitiveAssignmentValueSyntax)syntax
            let local = locals.reverse().firstOrNull({ _.name == value.name })
            if (!local) throw Exception("Unknown assignment local '#{value.name}'")
            let target = BoundReferenceExpression(
                value.range, local.semanticType, local.name, local.identity
            )
            let assigned = bindSyntax(value.value, locals, callables)
            let conversion = TypeConversions.classify(
                assigned.semanticType, target.semanticType
            )
            if (!conversion.applicable) throw Exception("Assignment value type mismatch")
            return BoundAssignmentValueExpression(
                value.range, target.semanticType, target, assigned, conversion
            )
        }
        if (syntax.class.isOfType(PrimitiveMemberAssignmentValueSyntax.class)) {
            throw Exception("Member assignment value requires class receiver context")
        }
        if (syntax.class.isOfType(PrimitiveCastSyntax.class)) {
            let value = (PrimitiveCastSyntax)syntax
            let operand = bindSyntax(value.value, locals, callables)
            let target = namedType(value.typeName)
            let conversion = TypeConversions.classify(
                operand.semanticType, target, explicit: true
            )
            if (conversion.conversionKind == "numeric-unboxing") {
                throw PrimitiveContextBindingException(BindingDiagnostic(
                    "binding.numeric-unboxing-projection-unsupported",
                    "Numeric unboxing requires resolved Number projection evidence",
                    SyntaxIslandIdentity(value.range.snapshot, "numeric-unboxing", value.range.startTokenIndex), value.range))
            }
            if (!conversion.applicable) throw Exception("Explicit cast type mismatch")
            return BoundConversionExpression(value.range, target, operand, conversion)
        }
        if (syntax.class.isOfType(PrimitiveLiteralSyntax.class)) {
            let value = (PrimitiveLiteralSyntax)syntax
            var SemanticType type
            if (value.tokenType == Token.Type.INTEGER) type = SemanticTypes.intType()
            else if (value.tokenType == Token.Type.FLOAT) type = SemanticTypes.doubleType()
            else if (value.tokenType == Token.Type.BOOL) type = SemanticTypes.boolType()
            else if (value.tokenType == Token.Type.STRING) type = SemanticTypes.stringType()
            else if (value.tokenType == Token.Type.CHAR) type = SemanticTypes.charType()
            else if (value.tokenType == Token.Type.NULL) type = SemanticTypes.nullType()
            else throw Exception("Unsupported primitive literal '#{value.sourceValue}'")
            return BoundLiteralExpression(value.range, type, value.sourceValue)
        }
        if (syntax.class.isOfType(PrimitiveInterpolatedStringSyntax.class)) {
            let value = (PrimitiveInterpolatedStringSyntax)syntax
            let segments = BoundInterpolatedStringSegment[]
            for (segment in value.segmentValues()) {
                if (segment.literal()) {
                    segments.add(BoundInterpolatedStringSegment(
                        segment.range, segment.literalSourceValue, null
                    ))
                } else if (segment.expression.class.isOfType(PrimitiveInterpolationPathSyntax.class)) {
                    let path = (PrimitiveInterpolationPathSyntax)segment.expression
                    if (path.pathValues().count != 1) {
                        throw Exception("Generic interpolation binding supports local roots")
                    }
                    let local = locals.reverse().firstOrNull({ _.name == path.pathValues().first })
                    if (!local) throw Exception("Unknown interpolation root '#{path.pathValues().first}'")
                    segments.add(BoundInterpolatedStringSegment(
                        segment.range, null,
                        BoundReferenceExpression(
                            path.range, local.semanticType, local.name, local.identity
                        )
                    ))
                } else {
                    segments.add(BoundInterpolatedStringSegment(
                        segment.range, null, bindSyntax(segment.expression, locals, callables)
                    ))
                }
            }
            return BoundInterpolatedStringExpression(value.range, segments)
        }
        if (syntax.class.isOfType(PrimitiveClassNameSyntax.class)) {
            let value = (PrimitiveClassNameSyntax)syntax
            let receiver = bindSyntax(value.receiver, locals, callables)
            return BoundClassNameExpression(value.range, receiver)
        }
        if (syntax.class.isOfType(PrimitiveEmptyArrayConstructionSyntax.class)) {
            let value = (PrimitiveEmptyArrayConstructionSyntax)syntax
            return BoundArrayExpression(
                value.range, ArraySemanticType(namedType(value.elementTypeName)),
                BoundExpression[]
            )
        }
        if (syntax.class.isOfType(PrimitiveArrayConstructionSyntax.class)) {
            let value = (PrimitiveArrayConstructionSyntax)syntax
            let size = bindSyntax(value.size, locals, callables)
            if (size.semanticType.value() != SemanticTypes.intType().value()) {
                throw Exception("Array construction size requires Int")
            }
            return BoundArrayExpression(
                value.range, ArraySemanticType(namedType(value.elementTypeName)), size
            )
        }
        if (syntax.class.isOfType(PrimitiveConstructionSyntax.class)) {
            let value = (PrimitiveConstructionSyntax)syntax
            let typeArguments = value.typeArgumentNames()
            let candidates = callables.filter((candidate) =>
                candidate.callableKind.value == "constructor" &&
                candidate.ownerType.declarationIdentity.name == value.typeName
            ).map((candidate) => typeArguments.isEmpty ? candidate :
                candidate.instantiateConstructor(typeArguments.map({ namedType(_) })))
            if (candidates.isEmpty && value.typeName == "Array" &&
                typeArguments.count == 1 && value.argumentValues().count == 1) {
                let size = bindSyntax(value.argumentValues().first, locals, callables)
                if (size.semanticType.value() != SemanticTypes.intType().value()) {
                    throw Exception("Array construction size requires Int")
                }
                return BoundArrayExpression(value.range,
                    ArraySemanticType(namedType(typeArguments.first)), size)
            }
            if (candidates.isEmpty) throw Exception("Unknown constructed type '#{value.typeName}'")
            let arguments = BoundExpression[]
            for (argument in value.argumentValues()) {
                arguments.add(bindSyntax(argument, locals, callables))
            }
            let resolution = OverloadResolver.resolve(
                value.typeName,
                candidates.map((candidate) => CallableSignature(
                    candidate.identity,
                    value.typeName,
                    candidate.callableKind,
                    candidate.parameterTypes(),
                    candidate.returnType,
                    candidate.ownerType,
                    candidate.optionalParameterCount,
                    candidate.parameterNames(), candidate.genericParameters(), candidate.ownerGenericDeclaration,
                    candidate.ownerInstance, candidate.asyncFunction, candidate.externalName, candidate.dispatchIdentity
                )),
                null,
                arguments.map({ _.semanticType }),
                value.range
            )
            if (!resolution.resolved) throw Exception(resolution.diagnostic.message)
            let target = resolution.selected
            let checked = CallTypeChecker.check(
                target, null, arguments.map({ _.semanticType }), value.range
            )
            if (!checked.valid) throw Exception(checked.diagnostic.message)
            return BoundCallExpression(
                value.range,
                checked.semanticType,
                target,
                arguments,
                checked.argumentConversions()
            )
        }
        if (syntax.class.isOfType(PrimitiveReferenceSyntax.class)) {
            let value = (PrimitiveReferenceSyntax)syntax
            if (value.name == "_x" && implicitParameters.isNotEmpty &&
                !locals.any({ _.name == "_x" })) {
                let parameter = implicitParameters.first
                return BoundReferenceExpression(value.range, parameter.semanticType,
                    parameter.name, parameter.identity)
            }
            if (value.name == "_i" && implicitParameters.count > 1 &&
                !locals.any({ _.name == "_i" })) {
                let parameter = implicitParameters[1]
                return BoundReferenceExpression(value.range, parameter.semanticType,
                    parameter.name, parameter.identity)
            }
            if (value.name == "_" && implicitParameters.isNotEmpty) {
                if (implicitParameterIndex >= implicitParameters.count) {
                    throw Exception("Too many implicit lambda parameter references")
                }
                let parameter = implicitParameters[implicitParameterIndex++]
                return BoundReferenceExpression(value.range, parameter.semanticType,
                    parameter.name, parameter.identity)
            }
            let local = locals.reverse().firstOrNull({ _.name == value.name })
            if (!local) {
                let diagnostic = PrimitiveExpressionDiagnostic.unresolvedReference(value.name, value.range)
                throw PrimitiveContextBindingException(BindingDiagnostic(diagnostic.code, diagnostic.message,
                    SyntaxIslandIdentity(value.range.snapshot, "unresolved-reference", value.range.startTokenIndex), diagnostic.range))
            }
            return BoundReferenceExpression(
                value.range, local.semanticType, local.name, local.identity
            )
        }
        if (syntax.class.isOfType(PrimitiveRichCollectionSyntax.class)) {
            let value = (PrimitiveRichCollectionSyntax)syntax
            let canonical = bindSyntax(value.canonicalExpression, locals, callables)
            if (value.featureKind == "async") {
                return BoundDeferredExpression(
                    value.range, canonical.semanticType, "async", BoundStatement[], canonical
                )
            }
            return BoundRichCollectionExpression(
                value.range, canonical.semanticType, value.featureKind, canonical
            )
        }
        if (syntax.class.isOfType(PrimitiveNamedCallSyntax.class)) {
            let value = (PrimitiveNamedCallSyntax)syntax
            let candidates = callables.filter({ _.name == value.name })
            if (candidates.count != 1) throw Exception("Named call '#{value.name}' requires one target")
            let target = candidates.first
            let parameterTypes = target.parameterTypes()
            let parameters = BoundCallParameter[]
            var Int parameterIndex
            while (parameterIndex < parameterTypes.count) {
                let defaultValue = parameterIndex == 0 ? BoundLiteralExpression(
                    value.range, parameterTypes[parameterIndex], "1"
                ) : null
                let defaultConversion = defaultValue ? TypeConversions.classify(
                    defaultValue.semanticType, parameterTypes[parameterIndex]
                ) : null
                parameters.add(BoundCallParameter(
                    parameterIndex == 0 ? "left" : "right",
                    parameterTypes[parameterIndex], defaultValue, defaultConversion
                ))
                parameterIndex++
            }
            let supplied = BoundNamedArgument[]
            for (argument in value.argumentValues()) {
                if (supplied.any({ _.name == argument.name })) {
                    throw Exception("Duplicate named argument '#{argument.name}'")
                }
                let parameter = parameters.firstOrNull({ _.name == argument.name })
                if (!parameter) throw Exception("Unknown named argument '#{argument.name}'")
                let expression = bindSyntax(argument.value, locals, callables)
                let conversion = TypeConversions.classify(expression.semanticType, parameter.semanticType)
                if (!conversion.applicable) throw Exception("Named argument type mismatch")
                supplied.add(BoundNamedArgument(argument.name, expression, conversion))
            }
            return BoundNamedCallExpression(
                value.range, target.returnType, target, parameters, supplied
            )
        }
        if (syntax.class.isOfType(PrimitiveLambdaSyntax.class)) {
            let value = (PrimitiveLambdaSyntax)syntax
            var FunctionSemanticType expected
            if (requiredType && requiredType.kind() == "function") {
                expected = (FunctionSemanticType)requiredType
                if (value.parameterValues().isNotEmpty &&
                    value.parameterValues().count != expected.parameterTypes().count) {
                    throw Exception("Lambda parameter count does not match expected function")
                }
            }
            let parameters = BoundFunctionParameter[]
            let lambdaLocals = LocalBinding[]
            lambdaLocals.addAll(locals)
            var Int parameterIndex
            while (parameterIndex < value.parameterValues().count) {
                let parameter = value.parameterValues()[parameterIndex]
                if (parameters.any({ _.name == parameter.name })) {
                    throw Exception("Duplicate lambda parameter '#{parameter.name}'")
                }
                let type = namedType(parameter.typeName)
                if (expected && type.value() != expected.parameterTypes()[parameterIndex].value()) {
                    throw Exception("Lambda parameter type does not match expected function")
                }
                let identity = SymbolIdentity(
                    DeclarationIdentity(
                        SyntaxIslandIdentity(value.range.snapshot, "lambda", value.range.startTokenIndex),
                        "lambda-parameter", parameter.name
                    ),
                    "lambda-parameter", parameterIndex
                )
                parameters.add(BoundFunctionParameter(parameter.name, identity, type))
                lambdaLocals.add(LocalBinding(parameter.name, identity, type))
                parameterIndex++
            }
            let previousImplicitParameters = implicitParameters
            let previousImplicitIndex = implicitParameterIndex
            implicitParameters = LocalBinding[]
            implicitParameterIndex = 0
            if (expected && value.parameterValues().isEmpty) {
                var Int index
                for (type in expected.parameterTypes()) {
                    let names = expected.parameterNames()
                    let name = names.count > index && names[index].isNotEmpty ? "_#{names[index]}" : "_#{index + 1}"
                    let identity = SymbolIdentity(DeclarationIdentity(
                        SyntaxIslandIdentity(value.range.snapshot, "lambda", value.range.startTokenIndex),
                        "lambda-parameter", name
                    ), "lambda-parameter", index++)
                    parameters.add(BoundFunctionParameter(name, identity, type))
                    if (originalCallbackContract && originalCallbackRange == value.range && index <= originalCallbackContract.parameterTypes().count &&
                        originalCallbackContract.parameterTypes()[index - 1].kind() == "generic-parameter") specializedGenericParameters.add(identity)
                    let local = LocalBinding(name, identity, type)
                    implicitParameters.add(local)
                    lambdaLocals.add(local)
                    lambdaLocals.add(LocalBinding("_#{index}", identity, type))
                }
            }
            var BoundExpression body
            let statements = BoundStatement[]
            try {
                if (value.statementValues().isNotEmpty) {
                    if (!expected) throw Exception("Statement callback requires contextual function type");
                    let boundStatements = PrimitiveControlStatementBinder().bind(
                        PrimitiveStatementSyntaxResult(value.statementValues()), value.range.snapshot,
                        lambdaLocals, callables, expressionBinder: this, hierarchy: currentHierarchy).statements()
                    let returns = statementReturns(boundStatements)
                    var SemanticType resultType = expected.returnType
                    if (resultType.kind() == "unknown" || resultType.kind() == "generic-parameter") {
                        resultType = returns.isEmpty ? SemanticTypes.unitType() : returns.first.requiredType
                    }
                    statements.addAll(typedCallbackReturns(boundStatements, resultType))
                    if (resultType.value() != SemanticTypes.unitType().value() && !terminalStatements(statements)) {
                        throw Exception("Callback may complete without returning a value")
                    }
                    body = BoundLiteralExpression(value.range, resultType, "null")
                } else body = value.emptyBody
                    ? BoundLiteralExpression(value.range, SemanticTypes.unitType(), "null")
                    : bindSyntax(value.body, lambdaLocals, callables, expected ? expected.returnType : null)
            } finally {
                implicitParameters = previousImplicitParameters
                implicitParameterIndex = previousImplicitIndex
            }
            if (expected && expected.returnType.kind() == "unit" && body.semanticType.kind() != "unit" &&
                value.statementValues().isEmpty) {
                statements.add(BoundExpressionStatement(value.body.range, body))
                body = BoundLiteralExpression(value.range, SemanticTypes.unitType(), "null")
            }
            if (expected && body.semanticType.kind() == "null" &&
                expected.returnType.kind() == "generic-parameter") {
                let conversion = TypeConversions.classify(body.semanticType, expected.returnType,
                    hierarchy: currentHierarchy)
                if (conversion.applicable) body = BoundConversionExpression(
                    body.range, expected.returnType, body, conversion)
            }
            if (expected && value.statementValues().isEmpty &&
                expected.returnType.kind() != "unknown" && expected.returnType.kind() != "generic-parameter" &&
                expected.returnType.value() != body.semanticType.value()) {
                let conversion = TypeConversions.classify(body.semanticType, expected.returnType,
                    hierarchy: currentHierarchy)
                // Preserve independently inferred results when they cannot convert here.
                // The selected call's FunctionTypeChecker must reject incompatible contracts;
                // bindCallback also serves inference callers before a target is selected.
                if (conversion.applicable) body = BoundConversionExpression(body.range, expected.returnType, body, conversion)
            }
            let parameterNames = value.parameterValues().map({ _.name })
            let captures = BoundReferenceExpression[]
            for (local in locals) {
                let selected = locals.reverse().firstOrNull({ _.name == local.name })
                if (selected.identity.value == local.identity.value &&
                    (referencesName(value.body, local.name) || statementReferences(statements, local.identity.value)) && !parameterNames.contains(local.name)) {
                    captures.add(BoundReferenceExpression(
                        value.range, local.semanticType, local.name, local.identity
                    ))
                }
            }
            var FunctionSemanticType declaration = expected
            if (originalCallbackRange == value.range && originalCallbackContract) declaration = originalCallbackContract
            CallableSignature boxing = callbackBoxingConstructor(body.semanticType, declaration, currentDeclarationContext, callables)
            return BoundLambdaExpression(
                value.range,
                FunctionSemanticType(parameters.map({ _.semanticType }), body.semanticType,
                    expected ? expected.asyncFunction : false),
                parameters, captures, body, statements,
                declarationContract: declaration, resultBoxingConstructor: boxing)
        }
        if (syntax.class.isOfType(PrimitiveFunctionReferenceSyntax.class)) {
            let value = (PrimitiveFunctionReferenceSyntax)syntax
            let candidates = callables.filter({ _.name == value.name })
            if (candidates.count != 1) throw Exception("Function reference '#{value.name}' must select exactly one target")
            let target = candidates.first
            return BoundFunctionValue(
                value.range,
                FunctionSemanticType(target.parameterTypes(), target.returnType, target.asyncFunction),
                target
            )
        }
        if (syntax.class.isOfType(PrimitiveArraySyntax.class)) {
            let value = (PrimitiveArraySyntax)syntax
            // Context fixes storage representation before overload selection. Never
            // reinterpret a native String[] as storage of declared String objects.
            var SemanticType elementType
            if (requiredType && requiredType.kind() == "array") {
                elementType = ((ArraySemanticType)requiredType).elementType
            } else if (requiredType && requiredType.kind() == "generic-instance") {
                let instance = (GenericInstanceSemanticType)requiredType
                if (instance.declarationType.declarationIdentity.name == "Array" &&
                    instance.typeArguments().count == 1) elementType = instance.typeArguments().first
            }
            let elements = BoundExpression[]
            for (element in value.elementValues()) {
                let bound = bindSyntax(element, locals, callables, elementType)
                if (!elementType) elementType = bound.semanticType
                elements.add(adaptArrayElement(bound, elementType, callables))
            }
            if (!elementType) throw arrayDiagnostic(
                "type.array-element-context", "Empty array literal requires an element type", value.range)
            let storage = BoundArrayExpression(
                value.range, ArraySemanticType(elementType), elements
            )
            if (requiredType && requiredType.kind() == "generic-instance") {
                if (TypeConversions.classify(storage.semanticType, requiredType,
                    hierarchy: currentHierarchy).applicable) return storage
                let instance = (GenericInstanceSemanticType)requiredType
                let candidates = callables.filter((candidate) =>
                    candidate.callableKind.value == "constructor" && candidate.name == "Array" &&
                    candidate.ownerType.declarationIdentity.value ==
                        instance.declarationType.declarationIdentity.value
                ).map({ _.instantiateConstructor(instance.typeArguments()) })
                let count = BoundLiteralExpression(value.range, SemanticTypes.intType(), "#{elements.count}")
                let resolution = OverloadResolver.resolve("Array", candidates, null,
                    [storage.semanticType, count.semanticType], value.range)
                if (!resolution.resolved) throw Exception(resolution.diagnostic.message)
                let checked = CallTypeChecker.check(resolution.selected, null,
                    [storage.semanticType, count.semanticType], value.range)
                if (!checked.valid) throw Exception(checked.diagnostic.message)
                return BoundCallExpression(value.range, checked.semanticType, resolution.selected,
                    [storage, count], checked.argumentConversions())
            }
            return storage
        }
        if (syntax.class.isOfType(PrimitiveArrayAccessSyntax.class)) {
            let value = (PrimitiveArrayAccessSyntax)syntax
            let receiver = bindSyntax(value.receiver, locals, callables)
            if (receiver.semanticType.kind() == "user-class" ||
                receiver.semanticType.kind() == "generic-instance") {
                let indexedOwner = receiver.semanticType.kind() == "generic-instance"
                    ? ((GenericInstanceSemanticType)receiver.semanticType).declarationType.value()
                    : receiver.semanticType.value()
                let getter = callables.firstOrNull((candidate) =>
                    candidate.identity.symbolKind == "array-getter" &&
                    candidate.ownerType.value() == indexedOwner
                )
                if (getter) {
                    let index = bindSyntax(value.index, locals, callables)
                    let selected = receiver.semanticType.kind() == "generic-instance" &&
                        getter.ownerGenericDeclaration ? getter.instantiateReceiver(
                            (GenericInstanceSemanticType)receiver.semanticType
                        ) : getter
                    let checked = CallTypeChecker.check(
                        selected, receiver.semanticType, [index.semanticType], value.range, currentHierarchy
                    )
                    if (!checked.valid) throw Exception(checked.diagnostic.message)
                    return BoundCallExpression(
                        value.range, checked.semanticType, checked.target, receiver,
                        [index], checked.argumentConversions()
                    )
                }
            }
            if (receiver.semanticType.kind() != "array") {
                throw Exception("Array access requires an array receiver")
            }
            let index = bindSyntax(value.index, locals, callables)
            if (index.semanticType.value() != SemanticTypes.intType().value()) {
                throw Exception("Array index requires Int")
            }
            let arrayType = (ArraySemanticType)receiver.semanticType
            return BoundArrayAccessExpression(
                value.range, arrayType.elementType, receiver, index
            )
        }
        if (syntax.class.isOfType(PrimitiveCallSyntax.class)) {
            let value = (PrimitiveCallSyntax)syntax
            if (value.namedArgumentValues().isNotEmpty) {
                throw Exception("Named call arguments require callable parameter binding")
            }
            let local = locals.reverse().firstOrNull({ _.name == value.name })
            if (!local && callables.any((candidate) => candidate.name == value.name))
                return bindDeclaredFunctionCall(value, locals, callables)
            let arguments = BoundExpression[]
            for (argument in value.argumentValues()) {
                arguments.add(bindSyntax(argument, locals, callables))
            }
            if (local) {
                if (local.semanticType.kind() != "function") {
                    throw Exception("Local '#{value.name}' is not callable")
                }
                let typeObject = (Object)local.semanticType
                let functionType = (FunctionSemanticType)typeObject
                if (arguments.count != functionType.parameterTypes().count) throw Exception("Callback argument count mismatch")
                var Int argumentIndex
                for (type in functionType.parameterTypes()) {
                    let argument = arguments[argumentIndex]
                    let conversion = TypeConversions.classify(argument.semanticType, type, hierarchy: currentHierarchy)
                    if (!conversion.applicable) throw Exception("Callback argument type mismatch")
                    if (argument.semanticType.value() != type.value()) arguments[argumentIndex] =
                        BoundConversionExpression(argument.range, type, argument, conversion)
                    argumentIndex++
                }
                return BoundFunctionInvocationExpression(
                    value.range,
                    BoundReferenceExpression(value.range, local.semanticType, local.name, local.identity),
                    functionType, arguments
                )
            }
            let candidates = callables.filter({ _.name == value.name })
            if (candidates.isEmpty && value.name == "String" && arguments.count == 1 &&
                (arguments.first.semanticType.kind() == "array" ||
                 arguments.first.semanticType.kind() == "char")) {
                return BoundNativeCallExpression(
                    value.range, SemanticTypes.stringType(), "String", arguments
                )
            }
            if (candidates.isEmpty) throw Exception("Unknown function '#{value.name}'")
            let resolution = OverloadResolver.resolve(
                value.name, candidates, null,
                arguments.map({ _.semanticType }), value.range
            )
            if (!resolution.resolved) throw Exception(resolution.diagnostic.message)
            let target = resolution.selected
            let checked = CallTypeChecker.check(
                target, null, arguments.map({ _.semanticType }), value.range
            )
            if (!checked.valid) throw Exception(checked.diagnostic.message)
            return BoundCallExpression(
                value.range,
                checked.semanticType,
                target,
                arguments,
                checked.argumentConversions()
            )
        }
        if (syntax.class.isOfType(PrimitiveConditionalSyntax.class)) {
            let value = (PrimitiveConditionalSyntax)syntax
            let condition = PrimitiveControlStatementBinder().conditionValue(
                bindSyntax(value.condition, locals, callables))
            var BoundExpression whenTrue = bindSyntax(value.whenTrue, locals, callables, requiredType)
            var BoundExpression whenFalse = bindSyntax(value.whenFalse, locals, callables, requiredType)
            if (requiredType) {
                whenTrue = PrimitiveStringAdapter.conditionalText(value.whenTrue, whenTrue,
                    requiredType, currentDeclarationContext, callables)
                whenFalse = PrimitiveStringAdapter.conditionalText(value.whenFalse, whenFalse,
                    requiredType, currentDeclarationContext, callables)
            }
            whenTrue = PrimitiveStringAdapter.conditionalText(value.whenTrue, whenTrue,
                whenFalse.semanticType, currentDeclarationContext, callables)
            whenFalse = PrimitiveStringAdapter.conditionalText(value.whenFalse, whenFalse,
                whenTrue.semanticType, currentDeclarationContext, callables)
            let joined = TypeOperations.conditional(condition.semanticType,
                whenTrue.semanticType, whenFalse.semanticType, value.range, currentHierarchy)
            if (!joined.valid) throw PrimitiveContextBindingException(BindingDiagnostic(
                joined.diagnostic.code, joined.diagnostic.message,
                SyntaxIslandIdentity(value.range.snapshot, "conditional", value.range.startTokenIndex),
                joined.diagnostic.range))
            let trueConversion = TypeConversions.classify(whenTrue.semanticType, joined.semanticType,
                hierarchy: currentHierarchy)
            let falseConversion = TypeConversions.classify(whenFalse.semanticType, joined.semanticType,
                hierarchy: currentHierarchy)
            if (!trueConversion.applicable || !trueConversion.implicit ||
                !falseConversion.applicable || !falseConversion.implicit)
                throw Exception("Conditional join requires applicable implicit branch conversions")
            if (trueConversion.conversionKind != "identity") whenTrue = BoundConversionExpression(
                value.whenTrue.range, joined.semanticType, whenTrue, trueConversion)
            if (falseConversion.conversionKind != "identity") whenFalse = BoundConversionExpression(
                value.whenFalse.range, joined.semanticType, whenFalse, falseConversion)
            return BoundConditionalExpression(
                value.range, joined.semanticType, condition, whenTrue, whenFalse
            )
        }
        if (syntax.class.isOfType(PrimitiveUnarySyntax.class)) {
            let value = (PrimitiveUnarySyntax)syntax
            let operand = bindSyntax(value.operand, locals, callables)
            if (value.operator == "++" || value.operator == "--") {
                return bindPrefixUpdate(value.range, value.operator, operand)
            }
            if (value.operator == "!") {
                let absence = bindReferenceNegation(value.range, operand)
                if (absence) return absence
            }
            let typed = TypeOperations.unary(value.operator, operand.semanticType, value.range)
            if (!typed.valid) throw PrimitiveContextBindingException(BindingDiagnostic(
                typed.diagnostic.code, typed.diagnostic.message,
                SyntaxIslandIdentity(value.range.snapshot, "unary", value.range.startTokenIndex), typed.diagnostic.range))
            return BoundUnaryExpression(
                value.range, typed.semanticType, value.operator, operand
            )
        }
        if (syntax.class.isOfType(PrimitiveBinarySyntax.class)) {
            let value = (PrimitiveBinarySyntax)syntax
            var BoundExpression left = bindSyntax(value.left, locals, callables)
            var BoundExpression right = bindSyntax(value.right, locals, callables)
            if (value.operator == "&&" || value.operator == "||") {
                left = PrimitiveControlStatementBinder().conditionValue(left)
                right = PrimitiveControlStatementBinder().conditionValue(right)
            }
            if (value.operator == "==" || value.operator == "!=") {
                if (right.semanticType.kind() == "null") left = specializedNullOperand(left)
                if (left.semanticType.kind() == "null") right = specializedNullOperand(right)
            }
            let typed = TypeOperations.binary(
                value.operator, left.semanticType, right.semanticType, value.range
            )
            if (!typed.valid) throw PrimitiveContextBindingException(BindingDiagnostic(
                typed.diagnostic.code, typed.diagnostic.message,
                SyntaxIslandIdentity(value.range.snapshot, "binary", value.range.startTokenIndex), typed.diagnostic.range))
            return BoundBinaryExpression(
                value.range, typed.semanticType, value.operator, left, right
            )
        }
        throw Exception("Unsupported primitive expression syntax '#{syntax.expressionKind()}'")
    }
}
