package flat/semantic/binding/primitive

import flat/compiler/models
import flat/parser/flat
import flat/bound
import flat/semantic/types

/** Types immutable primitive syntax into reduced Bound expressions. */
class {
    var LocalBinding[] implicitParameters = LocalBinding[]
    /** Local prefix updates store and yield the new value using the assignment-value contract. */
    public static bindPrefixUpdate(SourceRange range, String operator, BoundExpression operand) -> BoundExpression {
        if (!operand.class.isOfType(BoundReferenceExpression.class)) {
            throw Exception("Prefix update requires a local reference")
        }
        let target = (BoundReferenceExpression)operand
        if (!TypeOperations.unary("+", target.semanticType, range).valid) {
            throw Exception("Prefix update requires a numeric local")
        }
        let operation = operator == "++" ? "+" : "-"
        let one = BoundLiteralExpression(range, SemanticTypes.intType(), "1")
        let typed = TypeOperations.binary(operation, target.semanticType, one.semanticType, range)
        if (!typed.valid || typed.semanticType.value() != target.semanticType.value()) {
            throw Exception("Prefix update requires a numeric local")
        }
        let updated = BoundBinaryExpression(range, typed.semanticType, operation, target, one)
        return BoundAssignmentValueExpression(range, target.semanticType, target, updated,
            TypeConversions.classify(updated.semanticType, target.semanticType))
    }

    var Int implicitParameterIndex
    var TypeHierarchyComponent currentHierarchy

    /** Context supplies parameter types; call applicability validates the inferred result. */
    public bindCallback(PrimitiveLambdaSyntax syntax, FunctionSemanticType context,
        LocalBinding[] locals, CallableSignature[] callables,
        TypeHierarchyComponent hierarchy = null) -> PrimitiveExpressionBindingResult {
        currentHierarchy = hierarchy
        try {
            return PrimitiveExpressionBindingResult(expression: bindSyntax(syntax, locals, callables, context))
        } catch (Exception error) {
            return PrimitiveExpressionBindingResult(diagnostic: PrimitiveExpressionDiagnostic(
                "semantic.primitive-expression", error.message, syntax.range
            ))
        }
    }

    public bind(
        PrimitiveExpressionSyntax syntax,
        SemanticType requiredType = null,
        LocalBinding[] locals = LocalBinding[],
        CallableSignature[] callables = CallableSignature[],
        Bool explicitConversion = false
    ) -> PrimitiveExpressionBindingResult {
        if (!syntax || !locals || !callables) throw Exception("Primitive binding requires syntax, locals, and callables")
        try {
            if (requiredType && requiredType.kind() == "function" &&
                syntax.class.isOfType(PrimitiveLambdaSyntax.class)) {
                let lambda = (PrimitiveLambdaSyntax)syntax
                if (lambda.emptyBody) {
                    let type = (FunctionSemanticType)requiredType
                    if (type.returnType.value() != SemanticTypes.unitType().value()) {
                        throw Exception("Empty callback requires a Unit return type")
                    }
                    let parameters = BoundFunctionParameter[]
                    var Int index
                    for (parameterType in type.parameterTypes()) {
                        let name = "argument#index"
                        let owner = DeclarationIdentity(
                            SyntaxIslandIdentity(lambda.range.snapshot, "lambda", lambda.range.startTokenIndex),
                            "lambda-parameter", name
                        )
                        parameters.add(BoundFunctionParameter(
                            name, SymbolIdentity(owner, "lambda-parameter", index), parameterType
                        ))
                        index++
                    }
                    return PrimitiveExpressionBindingResult(expression: BoundLambdaExpression(
                        lambda.range, type, parameters, BoundReferenceExpression[],
                        BoundLiteralExpression(lambda.range, SemanticTypes.unitType(), "null")
                    ))
                }
            }
            let expression = bindSyntax(syntax, locals, callables, requiredType)
            if (!requiredType) return PrimitiveExpressionBindingResult(expression: expression)
            let conversion = TypeConversions.classify(
                expression.semanticType, requiredType, explicit: explicitConversion
            )
            if (!conversion.applicable) {
                return PrimitiveExpressionBindingResult(diagnostic: PrimitiveExpressionDiagnostic(
                    "type.primitive-conversion",
                    "Primitive expression '#{expression.semanticType.value()}' cannot convert to '#{requiredType.value()}'",
                    expression.range
                ))
            }
            if (conversion.conversionKind == "identity") {
                return PrimitiveExpressionBindingResult(expression: expression)
            }
            return PrimitiveExpressionBindingResult(expression: BoundConversionExpression(
                expression.range, requiredType, expression, conversion
            ))
        } catch (Exception error) {
            return PrimitiveExpressionBindingResult(diagnostic: PrimitiveExpressionDiagnostic(
                "semantic.primitive-expression",
                error.message ?: "Invalid primitive expression",
                syntax.range
            ))
        }
    }

    namedType(String name) -> SemanticType {
        if (name == "Bool") return SemanticTypes.boolType()
        if (name == "Byte") return SemanticTypes.byteType()
        if (name == "Short") return SemanticTypes.shortType()
        if (name == "Int") return SemanticTypes.intType()
        if (name == "Long") return SemanticTypes.longType()
        if (name == "Float") return SemanticTypes.floatType()
        if (name == "Double") return SemanticTypes.doubleType()
        if (name == "Char") return SemanticTypes.charType()
        if (name == "String") return SemanticTypes.stringType()
        throw Exception("Unknown lambda parameter type '#name'")
    }

    referencesName(PrimitiveExpressionSyntax syntax, String name) -> Bool {
        if (syntax.class.isOfType(PrimitiveReferenceSyntax.class)) {
            return ((PrimitiveReferenceSyntax)syntax).name == name
        }
        if (syntax.class.isOfType(PrimitiveConstructionSyntax.class)) {
            return ((PrimitiveConstructionSyntax)syntax).argumentValues().any({ referencesName(_, name) })
        }
        if (syntax.class.isOfType(PrimitiveArrayConstructionSyntax.class)) {
            return referencesName(((PrimitiveArrayConstructionSyntax)syntax).size, name)
        }
        if (syntax.class.isOfType(PrimitiveArraySyntax.class)) {
            return ((PrimitiveArraySyntax)syntax).elementValues().any({ referencesName(_, name) })
        }
        if (syntax.class.isOfType(PrimitiveArrayAccessSyntax.class)) {
            let access = (PrimitiveArrayAccessSyntax)syntax
            return referencesName(access.receiver, name) || referencesName(access.index, name)
        }
        if (syntax.class.isOfType(PrimitiveInterpolationPathSyntax.class)) {
            return ((PrimitiveInterpolationPathSyntax)syntax).pathValues().first == name
        }
        if (syntax.class.isOfType(PrimitiveInterpolatedStringSyntax.class)) {
            return ((PrimitiveInterpolatedStringSyntax)syntax).segmentValues().any((segment) =>
                !segment.literal() && referencesName(segment.expression, name))
        }
        if (syntax.class.isOfType(PrimitiveConditionalSyntax.class)) {
            let conditional = (PrimitiveConditionalSyntax)syntax
            return referencesName(conditional.condition, name) ||
                referencesName(conditional.whenTrue, name) || referencesName(conditional.whenFalse, name)
        }
        if (syntax.class.isOfType(PrimitiveCastSyntax.class)) {
            return referencesName(((PrimitiveCastSyntax)syntax).value, name)
        }
        if (syntax.class.isOfType(PrimitivePostfixUpdateSyntax.class)) {
            return referencesName(((PrimitivePostfixUpdateSyntax)syntax).operand, name)
        }
        if (syntax.class.isOfType(PrimitiveDeclarationValueSyntax.class)) {
            return referencesName(((PrimitiveDeclarationValueSyntax)syntax).value, name)
        }
        if (syntax.class.isOfType(PrimitiveAssignmentValueSyntax.class)) {
            let assignment = (PrimitiveAssignmentValueSyntax)syntax
            return assignment.name == name || referencesName(assignment.value, name)
        }
        if (syntax.class.isOfType(PrimitiveLambdaSyntax.class)) {
            let lambda = (PrimitiveLambdaSyntax)syntax
            return !lambda.emptyBody &&
                !lambda.parameterValues().any({ _.name == name }) &&
                referencesName(lambda.body, name)
        }
        if (syntax.class.isOfType(PrimitiveUnarySyntax.class)) {
            return referencesName(((PrimitiveUnarySyntax)syntax).operand, name)
        }
        if (syntax.class.isOfType(PrimitiveBinarySyntax.class)) {
            let value = (PrimitiveBinarySyntax)syntax
            return referencesName(value.left, name) || referencesName(value.right, name)
        }
        if (syntax.class.isOfType(PrimitiveMemberCallSyntax.class)) {
            let call = (PrimitiveMemberCallSyntax)syntax
            return referencesName(call.receiver, name) ||
                call.argumentValues().any({ referencesName(_, name) }) ||
                call.namedArgumentValues().any({ referencesName(_.value, name) })
        }
        if (syntax.class.isOfType(PrimitiveCallSyntax.class)) {
            let call = (PrimitiveCallSyntax)syntax
            return call.name == name || call.argumentValues().any({ referencesName(_, name) })
        }
        return false
    }

    bindSyntax(
        PrimitiveExpressionSyntax syntax,
        LocalBinding[] locals,
        CallableSignature[] callables,
        SemanticType requiredType = null
    ) -> BoundExpression {
        if (syntax.class.isOfType(PrimitiveMemberCallSyntax.class)) {
            let value = (PrimitiveMemberCallSyntax)syntax
            if (value.safeAccess) throw Exception("Safe member call requires null-propagating binding")
            if (value.typeArgumentNames().isNotEmpty) {
                throw Exception("Explicit member type arguments require call instantiation")
            }
            let namedArguments = value.namedArgumentValues()
            if (namedArguments.isNotEmpty) {
                let positionalArguments = value.argumentValues()
                let owner = bindSyntax(value.receiver, locals, callables)
                let candidates = callables.filter((candidate) =>
                    candidate.callableKind.value == "instance-method" &&
                    candidate.ownerType.value() == owner.semanticType.value() &&
                    candidate.name == value.memberName &&
                    candidate.parameterNames().count == candidate.parameterTypes().count &&
                    candidate.parameterTypes().count == positionalArguments.count +
                        namedArguments.count
                )
                if (candidates.count > 1) {
                    let applicable = CallableSignature[]
                    for (candidate in candidates) {
                        let names = candidate.parameterNames()
                        var Bool matches = true
                        var Int index
                        while (index < namedArguments.count) {
                            if (names[positionalArguments.count + index] !=
                                namedArguments[index].name) matches = false
                            index++
                        }
                        if (matches) applicable.add(candidate)
                    }
                    if (applicable.isEmpty) {
                        let resolution = OverloadResolver.resolve(value.memberName, applicable,
                            owner.semanticType, SemanticType[], value.range)
                        throw Exception(resolution.diagnostic.message)
                    }
                    let arguments = BoundExpression[]
                    for (argument in positionalArguments) {
                        arguments.add(bindSyntax(argument, locals, callables))
                    }
                    for (argument in namedArguments) {
                        arguments.add(bindSyntax(argument.value, locals, callables))
                    }
                    let resolution = OverloadResolver.resolve(
                        value.memberName, applicable, owner.semanticType,
                        arguments.map({ _.semanticType }), value.range
                    )
                    if (!resolution.resolved) throw Exception(resolution.diagnostic.message)
                    let checked = CallTypeChecker.check(
                        resolution.selected, owner.semanticType,
                        arguments.map({ _.semanticType }), value.range
                    )
                    if (!checked.valid) throw Exception(checked.diagnostic.message)
                    return BoundCallExpression(value.range, checked.semanticType,
                        resolution.selected, owner, arguments, checked.argumentConversions())
                }
                if (candidates.isEmpty) {
                    let resolution = OverloadResolver.resolve(value.memberName, candidates,
                        owner.semanticType, SemanticType[], value.range)
                    throw Exception(resolution.diagnostic.message)
                }
                let target = candidates.first
                let ordered = BoundExpression[]
                let names = target.parameterNames()
                for (argument in namedArguments) {
                    if (!names.any({ _ == argument.name })) {
                        throw Exception("Unknown named member argument '#{argument.name}'")
                    }
                    var Int positionalIndex
                    while (positionalIndex < positionalArguments.count) {
                        if (names[positionalIndex] == argument.name) {
                            throw Exception("Member argument '#{argument.name}' supplied positionally and by name")
                        }
                        positionalIndex++
                    }
                }
                var Int namedIndex
                while (namedIndex < namedArguments.count) {
                    if (namedArguments[namedIndex].name !=
                        names[positionalArguments.count + namedIndex]) {
                        throw Exception("Reordered named member arguments require source-order lowering")
                    }
                    namedIndex++
                }
                for (argument in positionalArguments) {
                    ordered.add(bindSyntax(argument, locals, callables))
                }
                for (argument in namedArguments) {
                    ordered.add(bindSyntax(argument.value, locals, callables))
                }
                let resolution = OverloadResolver.resolve(value.memberName, candidates,
                    owner.semanticType, ordered.map({ _.semanticType }), value.range)
                if (!resolution.resolved) throw Exception(resolution.diagnostic.message)
                let checked = CallTypeChecker.check(
                    resolution.selected, owner.semanticType, ordered.map({ _.semanticType }), value.range
                )
                if (!checked.valid) throw Exception(checked.diagnostic.message)
                return BoundCallExpression(
                    value.range, checked.semanticType, resolution.selected, owner,
                    ordered, checked.argumentConversions()
                )
            }
            if (value.receiver.class.isOfType(PrimitiveEmptyArrayConstructionSyntax.class) &&
                value.memberName == "add" && value.argumentValues().count == 1) {
                let empty = (PrimitiveEmptyArrayConstructionSyntax)value.receiver
                let arrayType = ArraySemanticType(namedType(empty.elementTypeName))
                let argument = bindSyntax(value.argumentValues().first, locals, callables)
                let conversion = TypeConversions.classify(
                    argument.semanticType, arrayType.elementType
                )
                if (!conversion.applicable) throw Exception("Array add argument type mismatch")
                return BoundArrayExpression(value.range, arrayType, [argument])
            }
            let receiver = bindSyntax(value.receiver, locals, callables)
            let candidates = callables.filter((candidate) =>
                candidate.callableKind.value == "instance-method" &&
                candidate.name == value.memberName
            )
            let arguments = BoundExpression[]
            for (argument in value.argumentValues()) {
                arguments.add(bindSyntax(argument, locals, callables))
            }
            let resolution = OverloadResolver.resolve(
                value.memberName, candidates, receiver.semanticType,
                arguments.map({ _.semanticType }), value.range, currentHierarchy
            )
            if (!resolution.resolved) throw Exception(resolution.diagnostic.message)
            let target = resolution.selected
            let checked = CallTypeChecker.check(
                target, receiver.semanticType, arguments.map({ _.semanticType }), value.range,
                currentHierarchy
            )
            if (!checked.valid) throw Exception(checked.diagnostic.message)
            return BoundCallExpression(
                value.range, checked.semanticType, target, receiver,
                arguments, checked.argumentConversions(), false,
                TypeConversions.classify(receiver.semanticType, target.receiverType(), hierarchy: currentHierarchy)
            )
        }
        if (syntax.class.isOfType(PrimitiveDeclarationValueSyntax.class)) {
            let value = (PrimitiveDeclarationValueSyntax)syntax
            if (locals.any({ _.name == value.name })) {
                throw Exception("Duplicate declaration local '#{value.name}'")
            }
            let initialized = bindSyntax(value.value, locals, callables)
            let identity = SymbolIdentity(
                DeclarationIdentity(
                    SyntaxIslandIdentity(
                        value.range.snapshot, "declaration-value", value.range.startTokenIndex
                    ),
                    "declaration-value", value.name
                ),
                "local"
            )
            let local = BoundReferenceExpression(
                value.range, initialized.semanticType, value.name, identity
            )
            locals.add(LocalBinding(value.name, identity, initialized.semanticType))
            let storage = initialized.semanticType.kind() == "unknown"
                ? TypeConversion(
                    initialized.semanticType, initialized.semanticType,
                    "deferred-declaration-value", true, false, true, 1000
                )
                : TypeConversions.classify(
                    initialized.semanticType, initialized.semanticType
                )
            return BoundDeclarationValueExpression(
                value.range, initialized.semanticType, local, initialized, storage
            )
        }
        if (syntax.class.isOfType(PrimitivePostfixUpdateSyntax.class)) {
            let value = (PrimitivePostfixUpdateSyntax)syntax
            if (!value.operand.class.isOfType(PrimitiveReferenceSyntax.class)) {
                throw Exception("Postfix update requires a local reference")
            }
            let reference = (PrimitiveReferenceSyntax)value.operand
            let local = locals.reverse().firstOrNull({ _.name == reference.name })
            if (!local) throw Exception("Unknown postfix update local '#{reference.name}'")
            let target = BoundReferenceExpression(
                value.range, local.semanticType, local.name, local.identity
            )
            let one = BoundLiteralExpression(
                value.range, SemanticTypes.intType(), "1"
            )
            let operator = value.updateOperator == "++" ? "+" : "-"
            let typed = TypeOperations.binary(
                operator, target.semanticType, one.semanticType, value.range
            )
            if (!typed.valid ||
                typed.semanticType.value() != target.semanticType.value()) {
                throw Exception("Postfix update requires a numeric local")
            }
            return BoundPostfixUpdateExpression(
                value.range, target.semanticType, target, value.updateOperator
            )
        }
        if (syntax.class.isOfType(PrimitiveAssignmentValueSyntax.class)) {
            let value = (PrimitiveAssignmentValueSyntax)syntax
            let local = locals.reverse().firstOrNull({ _.name == value.name })
            if (!local) throw Exception("Unknown assignment local '#{value.name}'")
            let target = BoundReferenceExpression(
                value.range, local.semanticType, local.name, local.identity
            )
            let assigned = bindSyntax(value.value, locals, callables)
            let conversion = TypeConversions.classify(
                assigned.semanticType, target.semanticType
            )
            if (!conversion.applicable) throw Exception("Assignment value type mismatch")
            return BoundAssignmentValueExpression(
                value.range, target.semanticType, target, assigned, conversion
            )
        }
        if (syntax.class.isOfType(PrimitiveMemberAssignmentValueSyntax.class)) {
            throw Exception("Member assignment value requires class receiver context")
        }
        if (syntax.class.isOfType(PrimitiveCastSyntax.class)) {
            let value = (PrimitiveCastSyntax)syntax
            let operand = bindSyntax(value.value, locals, callables)
            let target = namedType(value.typeName)
            let conversion = TypeConversions.classify(
                operand.semanticType, target, explicit: true
            )
            if (!conversion.applicable) throw Exception("Explicit cast type mismatch")
            return BoundConversionExpression(value.range, target, operand, conversion)
        }
        if (syntax.class.isOfType(PrimitiveLiteralSyntax.class)) {
            let value = (PrimitiveLiteralSyntax)syntax
            var SemanticType type
            if (value.tokenType == Token.Type.INTEGER) type = SemanticTypes.intType()
            else if (value.tokenType == Token.Type.FLOAT) type = SemanticTypes.doubleType()
            else if (value.tokenType == Token.Type.BOOL) type = SemanticTypes.boolType()
            else if (value.tokenType == Token.Type.STRING) type = SemanticTypes.stringType()
            else if (value.tokenType == Token.Type.CHAR) type = SemanticTypes.charType()
            else if (value.tokenType == Token.Type.NULL) type = SemanticTypes.nullType()
            else throw Exception("Unsupported primitive literal '#{value.sourceValue}'")
            return BoundLiteralExpression(value.range, type, value.sourceValue)
        }
        if (syntax.class.isOfType(PrimitiveInterpolatedStringSyntax.class)) {
            let value = (PrimitiveInterpolatedStringSyntax)syntax
            let segments = BoundInterpolatedStringSegment[]
            for (segment in value.segmentValues()) {
                if (segment.literal()) {
                    segments.add(BoundInterpolatedStringSegment(
                        segment.range, segment.literalSourceValue, null
                    ))
                } else if (segment.expression.class.isOfType(PrimitiveInterpolationPathSyntax.class)) {
                    let path = (PrimitiveInterpolationPathSyntax)segment.expression
                    if (path.pathValues().count != 1) {
                        throw Exception("Generic interpolation binding supports local roots")
                    }
                    let local = locals.reverse().firstOrNull({ _.name == path.pathValues().first })
                    if (!local) throw Exception("Unknown interpolation root '#{path.pathValues().first}'")
                    segments.add(BoundInterpolatedStringSegment(
                        segment.range, null,
                        BoundReferenceExpression(
                            path.range, local.semanticType, local.name, local.identity
                        )
                    ))
                } else {
                    segments.add(BoundInterpolatedStringSegment(
                        segment.range, null, bindSyntax(segment.expression, locals, callables)
                    ))
                }
            }
            return BoundInterpolatedStringExpression(value.range, segments)
        }
        if (syntax.class.isOfType(PrimitiveClassNameSyntax.class)) {
            let value = (PrimitiveClassNameSyntax)syntax
            let receiver = bindSyntax(value.receiver, locals, callables)
            return BoundClassNameExpression(value.range, receiver)
        }
        if (syntax.class.isOfType(PrimitiveEmptyArrayConstructionSyntax.class)) {
            let value = (PrimitiveEmptyArrayConstructionSyntax)syntax
            return BoundArrayExpression(
                value.range, ArraySemanticType(namedType(value.elementTypeName)),
                BoundExpression[]
            )
        }
        if (syntax.class.isOfType(PrimitiveArrayConstructionSyntax.class)) {
            let value = (PrimitiveArrayConstructionSyntax)syntax
            let size = bindSyntax(value.size, locals, callables)
            if (size.semanticType.value() != SemanticTypes.intType().value()) {
                throw Exception("Array construction size requires Int")
            }
            return BoundArrayExpression(
                value.range, ArraySemanticType(namedType(value.elementTypeName)), size
            )
        }
        if (syntax.class.isOfType(PrimitiveConstructionSyntax.class)) {
            let value = (PrimitiveConstructionSyntax)syntax
            let typeArguments = value.typeArgumentNames()
            let candidates = callables.filter((candidate) =>
                candidate.callableKind.value == "constructor" &&
                candidate.ownerType.declarationIdentity.name == value.typeName
            ).map((candidate) => typeArguments.isEmpty ? candidate :
                candidate.instantiateConstructor(typeArguments.map({ namedType(_) })))
            if (candidates.isEmpty && value.typeName == "Array" &&
                typeArguments.count == 1 && value.argumentValues().count == 1) {
                let size = bindSyntax(value.argumentValues().first, locals, callables)
                if (size.semanticType.value() != SemanticTypes.intType().value()) {
                    throw Exception("Array construction size requires Int")
                }
                return BoundArrayExpression(value.range,
                    ArraySemanticType(namedType(typeArguments.first)), size)
            }
            if (candidates.isEmpty) throw Exception("Unknown constructed type '#{value.typeName}'")
            let arguments = BoundExpression[]
            for (argument in value.argumentValues()) {
                arguments.add(bindSyntax(argument, locals, callables))
            }
            let resolution = OverloadResolver.resolve(
                value.typeName,
                candidates.map((candidate) => CallableSignature(
                    candidate.identity,
                    value.typeName,
                    candidate.callableKind,
                    candidate.parameterTypes(),
                    candidate.returnType,
                    candidate.ownerType,
                    candidate.optionalParameterCount,
                    candidate.parameterNames(), candidate.genericParameters(), candidate.ownerGenericDeclaration
                )),
                null,
                arguments.map({ _.semanticType }),
                value.range
            )
            if (!resolution.resolved) throw Exception(resolution.diagnostic.message)
            let target = resolution.selected
            let checked = CallTypeChecker.check(
                target, null, arguments.map({ _.semanticType }), value.range
            )
            if (!checked.valid) throw Exception(checked.diagnostic.message)
            return BoundCallExpression(
                value.range,
                checked.semanticType,
                target,
                arguments,
                checked.argumentConversions()
            )
        }
        if (syntax.class.isOfType(PrimitiveReferenceSyntax.class)) {
            let value = (PrimitiveReferenceSyntax)syntax
            if (value.name == "_x" && implicitParameters.isNotEmpty &&
                !locals.any({ _.name == "_x" })) {
                let parameter = implicitParameters.first
                return BoundReferenceExpression(value.range, parameter.semanticType,
                    parameter.name, parameter.identity)
            }
            if (value.name == "_i" && implicitParameters.count > 1 &&
                !locals.any({ _.name == "_i" })) {
                let parameter = implicitParameters[1]
                return BoundReferenceExpression(value.range, parameter.semanticType,
                    parameter.name, parameter.identity)
            }
            if (value.name == "_" && implicitParameters.isNotEmpty) {
                if (implicitParameterIndex >= implicitParameters.count) {
                    throw Exception("Too many implicit lambda parameter references")
                }
                let parameter = implicitParameters[implicitParameterIndex++]
                return BoundReferenceExpression(value.range, parameter.semanticType,
                    parameter.name, parameter.identity)
            }
            let local = locals.reverse().firstOrNull({ _.name == value.name })
            if (!local) throw Exception("Unknown local '#{value.name}'")
            return BoundReferenceExpression(
                value.range, local.semanticType, local.name, local.identity
            )
        }
        if (syntax.class.isOfType(PrimitiveRichCollectionSyntax.class)) {
            let value = (PrimitiveRichCollectionSyntax)syntax
            let canonical = bindSyntax(value.canonicalExpression, locals, callables)
            if (value.featureKind == "async") {
                return BoundDeferredExpression(
                    value.range, canonical.semanticType, "async", BoundStatement[], canonical
                )
            }
            return BoundRichCollectionExpression(
                value.range, canonical.semanticType, value.featureKind, canonical
            )
        }
        if (syntax.class.isOfType(PrimitiveNamedCallSyntax.class)) {
            let value = (PrimitiveNamedCallSyntax)syntax
            let candidates = callables.filter({ _.name == value.name })
            if (candidates.count != 1) throw Exception("Named call '#{value.name}' requires one target")
            let target = candidates.first
            let parameterTypes = target.parameterTypes()
            let parameters = BoundCallParameter[]
            var Int parameterIndex
            while (parameterIndex < parameterTypes.count) {
                let defaultValue = parameterIndex == 0 ? BoundLiteralExpression(
                    value.range, parameterTypes[parameterIndex], "1"
                ) : null
                let defaultConversion = defaultValue ? TypeConversions.classify(
                    defaultValue.semanticType, parameterTypes[parameterIndex]
                ) : null
                parameters.add(BoundCallParameter(
                    parameterIndex == 0 ? "left" : "right",
                    parameterTypes[parameterIndex], defaultValue, defaultConversion
                ))
                parameterIndex++
            }
            let supplied = BoundNamedArgument[]
            for (argument in value.argumentValues()) {
                if (supplied.any({ _.name == argument.name })) {
                    throw Exception("Duplicate named argument '#{argument.name}'")
                }
                let parameter = parameters.firstOrNull({ _.name == argument.name })
                if (!parameter) throw Exception("Unknown named argument '#{argument.name}'")
                let expression = bindSyntax(argument.value, locals, callables)
                let conversion = TypeConversions.classify(expression.semanticType, parameter.semanticType)
                if (!conversion.applicable) throw Exception("Named argument type mismatch")
                supplied.add(BoundNamedArgument(argument.name, expression, conversion))
            }
            return BoundNamedCallExpression(
                value.range, target.returnType, target, parameters, supplied
            )
        }
        if (syntax.class.isOfType(PrimitiveLambdaSyntax.class)) {
            let value = (PrimitiveLambdaSyntax)syntax
            if (value.statementValues().isNotEmpty) {
                throw Exception("Statement-bodied callback requires bound statement lambda support")
            }
            var FunctionSemanticType expected
            if (requiredType && requiredType.kind() == "function") {
                expected = (FunctionSemanticType)requiredType
                if (value.parameterValues().isNotEmpty &&
                    value.parameterValues().count != expected.parameterTypes().count) {
                    throw Exception("Lambda parameter count does not match expected function")
                }
            }
            let parameters = BoundFunctionParameter[]
            let lambdaLocals = LocalBinding[]
            lambdaLocals.addAll(locals)
            var Int parameterIndex
            while (parameterIndex < value.parameterValues().count) {
                let parameter = value.parameterValues()[parameterIndex]
                if (parameters.any({ _.name == parameter.name })) {
                    throw Exception("Duplicate lambda parameter '#{parameter.name}'")
                }
                let type = namedType(parameter.typeName)
                if (expected && type.value() != expected.parameterTypes()[parameterIndex].value()) {
                    throw Exception("Lambda parameter type does not match expected function")
                }
                let identity = SymbolIdentity(
                    DeclarationIdentity(
                        SyntaxIslandIdentity(value.range.snapshot, "lambda", value.range.startTokenIndex),
                        "lambda-parameter", parameter.name
                    ),
                    "lambda-parameter", parameterIndex
                )
                parameters.add(BoundFunctionParameter(parameter.name, identity, type))
                lambdaLocals.add(LocalBinding(parameter.name, identity, type))
                parameterIndex++
            }
            let previousImplicitParameters = implicitParameters
            let previousImplicitIndex = implicitParameterIndex
            implicitParameters = LocalBinding[]
            implicitParameterIndex = 0
            if (expected && value.parameterValues().isEmpty) {
                var Int index
                for (type in expected.parameterTypes()) {
                    let name = "_#{index + 1}"
                    let identity = SymbolIdentity(DeclarationIdentity(
                        SyntaxIslandIdentity(value.range.snapshot, "lambda", value.range.startTokenIndex),
                        "lambda-parameter", name
                    ), "lambda-parameter", index++)
                    parameters.add(BoundFunctionParameter(name, identity, type))
                    let local = LocalBinding(name, identity, type)
                    implicitParameters.add(local)
                    lambdaLocals.add(local)
                }
            }
            var BoundExpression body
            try {
                body = value.emptyBody
                    ? BoundLiteralExpression(value.range, SemanticTypes.unitType(), "null")
                    : bindSyntax(value.body, lambdaLocals, callables)
            } finally {
                implicitParameters = previousImplicitParameters
                implicitParameterIndex = previousImplicitIndex
            }
            let parameterNames = value.parameterValues().map({ _.name })
            let captures = BoundReferenceExpression[]
            for (local in locals) {
                let selected = locals.reverse().firstOrNull({ _.name == local.name })
                if (selected.identity.value == local.identity.value &&
                    referencesName(value.body, local.name) && !parameterNames.contains(local.name)) {
                    captures.add(BoundReferenceExpression(
                        value.range, local.semanticType, local.name, local.identity
                    ))
                }
            }
            return BoundLambdaExpression(
                value.range,
                FunctionSemanticType(parameters.map({ _.semanticType }), body.semanticType,
                    expected ? expected.asyncFunction : false),
                parameters, captures, body
            )
        }
        if (syntax.class.isOfType(PrimitiveFunctionReferenceSyntax.class)) {
            let value = (PrimitiveFunctionReferenceSyntax)syntax
            let candidates = callables.filter({ _.name == value.name })
            if (candidates.count != 1) throw Exception("Function reference '#{value.name}' must select exactly one target")
            let target = candidates.first
            return BoundFunctionValue(
                value.range,
                FunctionSemanticType(target.parameterTypes(), target.returnType),
                target
            )
        }
        if (syntax.class.isOfType(PrimitiveArraySyntax.class)) {
            let value = (PrimitiveArraySyntax)syntax
            let elements = BoundExpression[]
            for (element in value.elementValues()) {
                elements.add(bindSyntax(element, locals, callables))
            }
            let elementType = elements.first.semanticType
            if (elements.any({
                !TypeConversions.classify(_.semanticType, elementType).applicable
            })) throw Exception("Array elements require a common type")
            let storage = BoundArrayExpression(
                value.range, ArraySemanticType(elementType), elements
            )
            if (requiredType && requiredType.kind() == "generic-instance") {
                let instance = (GenericInstanceSemanticType)requiredType
                let candidates = callables.filter((candidate) =>
                    candidate.callableKind.value == "constructor" && candidate.name == "Array" &&
                    candidate.ownerType.declarationIdentity.value ==
                        instance.declarationType.declarationIdentity.value
                ).map({ _.instantiateConstructor(instance.typeArguments()) })
                let count = BoundLiteralExpression(value.range, SemanticTypes.intType(), "#{elements.count}")
                let resolution = OverloadResolver.resolve("Array", candidates, null,
                    [storage.semanticType, count.semanticType], value.range)
                if (!resolution.resolved) throw Exception(resolution.diagnostic.message)
                let checked = CallTypeChecker.check(resolution.selected, null,
                    [storage.semanticType, count.semanticType], value.range)
                if (!checked.valid) throw Exception(checked.diagnostic.message)
                return BoundCallExpression(value.range, checked.semanticType, resolution.selected,
                    [storage, count], checked.argumentConversions())
            }
            return storage
        }
        if (syntax.class.isOfType(PrimitiveArrayAccessSyntax.class)) {
            let value = (PrimitiveArrayAccessSyntax)syntax
            let receiver = bindSyntax(value.receiver, locals, callables)
            if (receiver.semanticType.kind() == "user-class" ||
                receiver.semanticType.kind() == "generic-instance") {
                let indexedOwner = receiver.semanticType.kind() == "generic-instance"
                    ? ((GenericInstanceSemanticType)receiver.semanticType).declarationType.value()
                    : receiver.semanticType.value()
                let getter = callables.firstOrNull((candidate) =>
                    candidate.identity.symbolKind == "array-getter" &&
                    candidate.ownerType.value() == indexedOwner
                )
                if (getter) {
                    let index = bindSyntax(value.index, locals, callables)
                    let checked = CallTypeChecker.check(
                        getter, receiver.semanticType, [index.semanticType], value.range
                    )
                    if (!checked.valid) throw Exception(checked.diagnostic.message)
                    let selected = receiver.semanticType.kind() == "generic-instance" &&
                        getter.ownerGenericDeclaration ? getter.instantiateReceiver(
                            (GenericInstanceSemanticType)receiver.semanticType
                        ) : getter
                    return BoundCallExpression(
                        value.range, checked.semanticType, selected, receiver,
                        [index], checked.argumentConversions()
                    )
                }
            }
            if (receiver.semanticType.kind() != "array") {
                throw Exception("Array access requires an array receiver")
            }
            let index = bindSyntax(value.index, locals, callables)
            if (index.semanticType.value() != SemanticTypes.intType().value()) {
                throw Exception("Array index requires Int")
            }
            let arrayType = (ArraySemanticType)receiver.semanticType
            return BoundArrayAccessExpression(
                value.range, arrayType.elementType, receiver, index
            )
        }
        if (syntax.class.isOfType(PrimitiveCallSyntax.class)) {
            let value = (PrimitiveCallSyntax)syntax
            if (value.namedArgumentValues().isNotEmpty) {
                throw Exception("Named call arguments require callable parameter binding")
            }
            let arguments = BoundExpression[]
            for (argument in value.argumentValues()) {
                arguments.add(bindSyntax(argument, locals, callables))
            }
            let local = locals.reverse().firstOrNull({ _.name == value.name })
            if (local) {
                if (local.semanticType.kind() != "function") {
                    throw Exception("Local '#{value.name}' is not callable")
                }
                let typeObject = (Object)local.semanticType
                let functionType = (FunctionSemanticType)typeObject
                return BoundFunctionInvocationExpression(
                    value.range,
                    BoundReferenceExpression(value.range, local.semanticType, local.name, local.identity),
                    functionType, arguments
                )
            }
            let candidates = callables.filter({ _.name == value.name })
            if (candidates.isEmpty && value.name == "String" && arguments.count == 1 &&
                (arguments.first.semanticType.kind() == "array" ||
                 arguments.first.semanticType.kind() == "char")) {
                return BoundNativeCallExpression(
                    value.range, SemanticTypes.stringType(), "String", arguments
                )
            }
            if (candidates.isEmpty) throw Exception("Unknown function '#{value.name}'")
            let resolution = OverloadResolver.resolve(
                value.name, candidates, null,
                arguments.map({ _.semanticType }), value.range
            )
            if (!resolution.resolved) throw Exception(resolution.diagnostic.message)
            let target = resolution.selected
            let checked = CallTypeChecker.check(
                target, null, arguments.map({ _.semanticType }), value.range
            )
            if (!checked.valid) throw Exception(checked.diagnostic.message)
            return BoundCallExpression(
                value.range,
                checked.semanticType,
                target,
                arguments,
                checked.argumentConversions()
            )
        }
        if (syntax.class.isOfType(PrimitiveConditionalSyntax.class)) {
            let value = (PrimitiveConditionalSyntax)syntax
            let condition = bindSyntax(value.condition, locals, callables)
            if (condition.semanticType.value() != SemanticTypes.boolType().value()) {
                throw Exception("Conditional expression requires Bool condition")
            }
            let whenTrue = bindSyntax(value.whenTrue, locals, callables)
            let whenFalse = bindSyntax(value.whenFalse, locals, callables)
            if (whenTrue.semanticType.value() != whenFalse.semanticType.value()) {
                throw Exception("Conditional expression branches require common type")
            }
            return BoundConditionalExpression(
                value.range, whenTrue.semanticType, condition, whenTrue, whenFalse
            )
        }
        if (syntax.class.isOfType(PrimitiveUnarySyntax.class)) {
            let value = (PrimitiveUnarySyntax)syntax
            let operand = bindSyntax(value.operand, locals, callables)
            if (value.operator == "++" || value.operator == "--") {
                return bindPrefixUpdate(value.range, value.operator, operand)
            }
            let typed = TypeOperations.unary(value.operator, operand.semanticType, value.range)
            if (!typed.valid) throw Exception(typed.diagnostic.message)
            return BoundUnaryExpression(
                value.range, typed.semanticType, value.operator, operand
            )
        }
        if (syntax.class.isOfType(PrimitiveBinarySyntax.class)) {
            let value = (PrimitiveBinarySyntax)syntax
            let left = bindSyntax(value.left, locals, callables)
            let right = bindSyntax(value.right, locals, callables)
            let typed = TypeOperations.binary(
                value.operator, left.semanticType, right.semanticType, value.range
            )
            if (!typed.valid) throw Exception(typed.diagnostic.message)
            return BoundBinaryExpression(
                value.range, typed.semanticType, value.operator, left, right
            )
        }
        throw Exception("Unsupported primitive expression syntax '#{syntax.expressionKind()}'")
    }
}
