package flat/semantic/binding/primitive

import flat/compiler/models
import flat/parser/flat
import flat/bound

testable class {
    test `binds locals assignments references and returns with stable identity`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-statements"), "revision:one"
        )
        let syntax = PrimitiveStatementParser().parse([
            token("let", Token.Type.IDENTIFIER, 1),
            token("value", Token.Type.IDENTIFIER, 5),
            token("=", Token.Type.SYMBOL, 11),
            token("1", Token.Type.INTEGER, 13),
            token(";", Token.Type.SYMBOL, 14),
            token("value", Token.Type.IDENTIFIER, 16),
            token("=", Token.Type.SYMBOL, 22),
            token("2", Token.Type.INTEGER, 24),
            token(";", Token.Type.SYMBOL, 25),
            token("return", Token.Type.IDENTIFIER, 27),
            token("value", Token.Type.IDENTIFIER, 34)
        ], snapshot)
        let result = PrimitiveStatementBinder().bind(syntax, snapshot)
        let statements = result.statements()
        let declaration = (BoundLocalDeclarationStatement)statements[0]
        let assignment = (BoundAssignmentStatement)statements[1]

        expect(statements.map({ _.unitKind() })).toBe([
            "local-declaration", "assignment", "return"
        ])
        expect(result.locals().count).toBe(1)
        expect(result.locals().first.identity.value.contains("local")).toBe(true)
    }

    test `rejects duplicate unknown and incompatible locals`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-statement-invalid"), "revision:one"
        )
        var Int rejected
        try {
            let duplicate = PrimitiveStatementParser().parse([
                token("let", Token.Type.IDENTIFIER, 1), token("value", Token.Type.IDENTIFIER, 5),
                token("=", Token.Type.SYMBOL, 11), token("1", Token.Type.INTEGER, 13),
                token(";", Token.Type.SYMBOL, 14), token("let", Token.Type.IDENTIFIER, 16),
                token("value", Token.Type.IDENTIFIER, 20), token("=", Token.Type.SYMBOL, 26),
                token("2", Token.Type.INTEGER, 28)
            ], snapshot)
            PrimitiveStatementBinder().bind(duplicate, snapshot)
        } catch (Exception error) { rejected++ }
        try {
            let unknown = PrimitiveStatementParser().parse([
                token("missing", Token.Type.IDENTIFIER, 1),
                token("=", Token.Type.SYMBOL, 9), token("1", Token.Type.INTEGER, 11)
            ], snapshot)
            PrimitiveStatementBinder().bind(unknown, snapshot)
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
    }

    token(String value, Int type, Int column) -> Token {
        return Token(
            value: value,
            type: type,
            location: Location(lineNumber: 1, column: column)
        )
    }
}
