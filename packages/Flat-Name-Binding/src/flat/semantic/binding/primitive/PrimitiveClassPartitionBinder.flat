package flat/semantic/binding/primitive

import flat/parser/flat
import flat/compiler/models
import flat/bound
import flat/semantic/types

/**
 * Binds a finite source/package class partition after all class signatures are
 * known. Root classes bind independently; reduced parent/child components bind
 * only after their named parent is available.
 */
class {
    var PrimitiveInterfaceSyntax[] interfaces
    var PrimitiveResolvedDeclarationContext signatureContext
    var SourceRange signatureLookupRange

    public bind(
        PrimitiveClassSyntax[] syntaxValues,
        SourceSnapshotIdentity snapshot = null,
        Int maxTypes = 256,
        PrimitiveInterfaceSyntax[] interfaceSyntaxValues = PrimitiveInterfaceSyntax[],
        PrimitiveClassSyntax arrayDeclaration = null
    ) -> PrimitiveClassPartitionBindingResult {
        if (!syntaxValues || syntaxValues.any({ !_ }) || maxTypes <= 0 ||
            !interfaceSyntaxValues || interfaceSyntaxValues.any({ !_ })) {
            throw Exception("Primitive class partition binding requires syntax snapshot and capacity")
        }
        interfaces = PrimitiveInterfaceSyntax[]:addAll(interfaceSyntaxValues)
        let effectiveSyntaxValues = syntaxValues.map({
            withImplicitRootParent(withTraitImplementations(_), syntaxValues)
        })
        if (effectiveSyntaxValues.count > maxTypes) {
            throw Exception("Primitive class partition exceeds configured type capacity")
        }
        var Int index
        while (index < effectiveSyntaxValues.count) {
            let syntax = effectiveSyntaxValues[index]
            if (effectiveSyntaxValues.take(index).any({ _.name == syntax.name })) {
                throw Exception("Duplicate reduced class '#{syntax.name}'")
            }
            index++
        }

        let hierarchy = arrayDeclaration
            ? arrayHierarchy(arrayDeclaration, syntaxValues, snapshot) : null
        let rootSyntax = effectiveSyntaxValues.firstOrNull({ _.name == "Object" })
        var TypeHierarchyComponent rootHierarchy
        if (rootSyntax) {
            let rootIdentity = DeclarationIdentity(
                SyntaxIslandIdentity(snapshot ?: rootSyntax.range.snapshot,
                    "class", rootSyntax.range.startTokenIndex), "class", rootSyntax.name)
            let root = UserClassSemanticType(rootIdentity)
            if (hierarchy) rootHierarchy = hierarchy
            else {
                rootHierarchy = TypeHierarchyComponent()
                rootHierarchy.add(TypeHierarchyDeclaration(root, "class", UserClassSemanticType[]))
                rootHierarchy.registerRootDeclaration(root)
                rootHierarchy.seal()
                if (!rootHierarchy.valid) throw Exception("Invalid reduced root hierarchy")
            }
        }
        let constructorSignatures = constructorSignatures(effectiveSyntaxValues, snapshot)
        constructorSignatures.addAll(methodSignatures(effectiveSyntaxValues, snapshot))
        constructorSignatures.addAll(inheritedMethodSignatures(
            effectiveSyntaxValues, constructorSignatures, snapshot
        ))
        constructorSignatures.addAll(arrayAccessorSignatures(effectiveSyntaxValues, snapshot))
        let declaredFields = fieldUnits(effectiveSyntaxValues, snapshot)
        let result = BoundTypeUnit[]
        let boundNames = String[]
        while (result.count < effectiveSyntaxValues.count) {
            var Bool progressed
            index = 0
            while (index < effectiveSyntaxValues.count) {
                let syntax = effectiveSyntaxValues[index]
                if (boundNames.contains(syntax.name)) {
                    index++
                    continue
                }
                if (awaitInferredMember(syntax, effectiveSyntaxValues,
                    constructorSignatures, declaredFields, boundNames)) {
                    index++
                    continue
                }
                if (!syntax.parentName) {
                    let syntaxSnapshot = snapshot ?: syntax.range.snapshot
                    result.add(PrimitiveClassBinder().bind(
                        syntax, syntaxSnapshot,
                        availableConstructors: constructorSignatures,
                        availableFields: declaredFields,
                        interfaceSyntaxValues: interfaces, hierarchy: rootHierarchy ?: hierarchy ?: (
                            syntax.implementedTypeNames().isNotEmpty && syntax.implementedTypeNames().all({ _.contains("<") })
                                ? arrayHierarchy(syntax, effectiveSyntaxValues, snapshot, false) : null)
                    ).typeUnit)
                    boundNames.add(syntax.name)
                    progressed = true
                } else if (boundNames.contains(syntax.parentName)) {
                    let parentSyntax = effectiveSyntaxValues.firstOrNull({ _.name == syntax.parentName })
                    if (!parentSyntax) throw Exception("Missing reduced parent '#{syntax.parentName}'")
                    let rootContract = result.firstOrNull({ _.identity.name == "Object" })
                    let boundParent = result.firstOrNull({ _.identity.name == parentSyntax.name })
                    let inherited = PrimitiveInheritanceBinder().bind(
                        parentSyntax, syntax, snapshot, constructorSignatures,
                        interfaceSyntaxValues,
                        rootContract ? rootContract.functionUnits() : BoundFunctionUnit[],
                        boundParent,
                        declaredFields, rootHierarchy ?: hierarchy
                    )
                    var Int parentIndex
                    while (result[parentIndex].identity.name != parentSyntax.name) parentIndex++
                    result[parentIndex] = inherited.parentType
                    result.add(inherited.childType)
                    boundNames.add(syntax.name)
                    progressed = true
                }
                if (boundNames.contains(syntax.name)) {
                    let justBound = result.firstOrNull({ _.identity.name == syntax.name })
                    for (function in justBound.functionUnits()) {
                        var Int signatureIndex
                        while (signatureIndex < constructorSignatures.count) {
                            let signature = constructorSignatures[signatureIndex]
                            if (signature.ownerType &&
                                signature.ownerType.value() == justBound.semanticType.value() &&
                                signature.identity.declaration.value == function.identity.value &&
                                signature.returnType.kind() == "unknown" &&
                                function.returnType.kind() != "unknown") {
                                constructorSignatures[signatureIndex] = CallableSignature(
                                    signature.identity, signature.name, signature.callableKind,
                                    signature.parameterTypes(), function.returnType, signature.ownerType,
                                    signature.optionalParameterCount, signature.parameterNames(),
                                    signature.genericParameters(), signature.ownerGenericDeclaration,
                                    ownerInstance: signature.ownerInstance, asyncFunction: signature.asyncFunction,
                                    externalName: signature.externalName, dispatchIdentity: signature.dispatchIdentity
                                )
                            }
                            signatureIndex++
                        }
                    }
                }
                index++
            }
            if (!progressed) {
                let unresolved = effectiveSyntaxValues.filter((candidate) =>
                    !boundNames.contains(candidate.name)
                ).map((candidate) =>
                    candidate.parentName
                        ? "#{candidate.name}->#{candidate.parentName}"
                        : candidate.name
                ).sort({ _a.compareTo(_b) })
                throw Exception(
                    "Missing or cyclic reduced parent for #{unresolved.join(", ")}"
                )
            }
        }
        return PrimitiveClassPartitionBindingResult(result)
    }

    /** Seal only the caller-admitted finite declaration component, never the project.
     * Synchronous: capacity is checked before signatures; failure publishes no partial result.
     * No pending work queue or interruptible cancellation is introduced.
     */
    /** Register only exact source-qualified Core identities before sealing the component. */
    registerScalarDeclarations(TypeHierarchyComponent hierarchy, PrimitiveResolvedDeclarationContext scope) {
        if (!scope) return
        let names = ["Byte", "Short", "Int", "Long", "Float", "Double", "Char"]
        for (name in names) {
            let declarations = scope.candidates("flat/primitive/number/#name")
            if (declarations.count > 1) throw Exception("Canonical scalar declaration must be unique")
            if (declarations.isEmpty) continue
            SemanticType resolvedPrimitive = PrimitiveStructuralTypeResolver().resolve(name)
            PrimitiveSemanticType primitiveType = (PrimitiveSemanticType)resolvedPrimitive
            let canonicalType = UserClassSemanticType(declarations.first)
            hierarchy.registerPrimitiveDeclaration(primitiveType, canonicalType)
        }
        let booleans = scope.candidates("flat/primitive/Bool")
        if (booleans.count > 1) throw Exception("Canonical Bool declaration must be unique")
        if (booleans.isNotEmpty) {
            SemanticType resolvedBoolean = SemanticTypes.boolType()
            PrimitiveSemanticType booleanType = (PrimitiveSemanticType)resolvedBoolean
            let canonicalBoolean = UserClassSemanticType(booleans.first)
            hierarchy.registerPrimitiveDeclaration(booleanType, canonicalBoolean)
        }
    }

    public bindContexts(
        PrimitiveSourceBindingContext[] contexts,
        Int maxTypes = 256,
        DeclarationIdentity arrayDeclaration = null,
        Int maxContexts = 256,
        Int maxImportsPerContext = 256
    ) -> PrimitiveClassPartitionBindingResult {
        if (!contexts || contexts.any({ !_ }) || maxTypes <= 0 || maxContexts <= 0 ||
            maxImportsPerContext <= 0 || contexts.count > maxContexts) {
            throw Exception("Context binding requires a bounded declaration component")
        }
        let ordered = contexts.sort({ _a.snapshot.value.compareTo(_b.snapshot.value) })
        let syntaxes = PrimitiveClassSyntax[]
        let contracts = PrimitiveInterfaceSyntax[]
        for (source in ordered) {
            if (source.importValues().count + source.defaultImportValues().count > maxImportsPerContext ||
                syntaxes.count + contracts.count + source.classValues().count + source.interfaceValues().count > maxTypes) {
                throw Exception("Context binding exceeds configured declaration or import capacity")
            }
            syntaxes.addAll(source.classValues())
            contracts.addAll(source.interfaceValues())
        }
        let signatures = CallableSignature[]
        let fields = BoundFieldUnit[]
        let effectiveSyntaxes = PrimitiveClassSyntax[]
        try {
            for (source in ordered) {
                signatureContext = PrimitiveResolvedDeclarationContext(source, ordered)
                for (syntax in source.classValues()) {
                    let found = signatureContext.candidates(source.namespaceName.isEmpty ? syntax.name :
                        "#{source.namespaceName}/#{syntax.name}")
                    if (found.count > 1) signatureContext.fail("binding.namespace-duplicate", syntax.name, syntax.range, found)
                }
                signatureContext.validateImports()
                interfaces = contracts
                for (original in source.classValues()) {
                    let syntax = withTraitImplementations(withImplicitRootParent(original, syntaxes))
                    effectiveSyntaxes.add(syntax)
                    signatureLookupRange = syntax.range
                    signatures.addAll(constructorSignatures([syntax], null))
                    signatures.addAll(methodSignatures([syntax], null))
                    signatures.addAll(arrayAccessorSignatures([syntax], null))
                    fields.addAll(fieldUnits([syntax], null))
                }
            }
        } finally {
            signatureContext = null
            signatureLookupRange = null
        }
        for (source in ordered) {
            let scope = PrimitiveResolvedDeclarationContext(source, ordered)
            for (contract in source.interfaceValues()) {
                let owner = UserClassSemanticType(scope.resolve(contract.name, contract.range))
                let parameters = GenericParameterSemanticType[]
                var Int ordinal
                for (name in contract.genericParameterNames()) parameters.add(
                    GenericParameterSemanticType(owner.declarationIdentity, name, ordinal++))
                let resolver = PrimitiveStructuralTypeResolver(interfaces: contracts,
                    methodGenericParameters: parameters, declarationContext: scope,
                    lookupRange: contract.range)
                for (member in contract.methodValues()) {
                    let implementation = member.declaration()
                    if (implementation) {
                        let identity = DeclarationIdentity(SyntaxIslandIdentity(member.range.snapshot,
                            "instance-method", member.range.startTokenIndex), "instance-method", member.name)
                        let methodParameters = GenericParameterSemanticType[]
                        for (name in implementation.genericParameterNames()) methodParameters.add(
                            GenericParameterSemanticType(identity, name, methodParameters.count))
                        let visibleParameters = GenericParameterSemanticType[]:addAll(parameters)
                        visibleParameters.addAll(methodParameters)
                        let memberResolver = PrimitiveStructuralTypeResolver(interfaces: contracts,
                            methodGenericParameters: visibleParameters, declarationContext: scope,
                            lookupRange: member.range)
                        let selfArguments = SemanticType[]
                        for (parameter in parameters) selfArguments.add(parameter)
                        var SemanticType returnType = implementation.inferredReturnType ? SemanticTypes.unknownType() :
                            implementation.returnTypeName == "this" ? (parameters.isEmpty ? owner : GenericInstanceSemanticType(owner, selfArguments)) :
                            implementation.nativeArrayReturnModifierRange ? memberResolver.resolveNativeArrayStorage(implementation.returnTypeName) :
                            implementation.nativeReturnModifierRange && implementation.returnTypeName == "String" ? SemanticTypes.stringType() :
                            memberResolver.resolve(implementation.returnTypeName)
                        if (returnType.kind() == "unknown") {
                            var CallableSignature published
                            for (candidate in signatures) {
                                if (candidate.identity.declaration.value == identity.value && candidate.returnType.kind() != "unknown") published = candidate
                            }
                            if (published) {
                                let ownerSyntax = scope.classFor(published.ownerType.declarationIdentity)
                                var String implementedName
                                if (ownerSyntax) {
                                    for (name in ownerSyntax.implementedTypeNames()) {
                                        if (name.startsWith("#{contract.name}<")) implementedName = name
                                    }
                                }
                                if (ownerSyntax && ownerSyntax.genericParameterName && parameters.count == 1 &&
                                    implementedName == "#{contract.name}<#{ownerSyntax.genericParameterName}>") {
                                    returnType = GenericSubstitution([GenericParameterSemanticType(published.ownerType.declarationIdentity,
                                        ownerSyntax.genericParameterName, 0)], [parameters.first]).apply(published.returnType)
                                } else returnType = published.returnType
                            }
                        }
                        let argumentTypes = SemanticType[]
                        let argumentNames = String[]
                        var Int optionalCount
                        for (parameter in implementation.parameterValues()) {
                            argumentTypes.add(memberResolver.resolveParameter(parameter))
                            argumentNames.add(parameter.name)
                            if (parameter.defaultValue) optionalCount++
                        }
                        signatures.add(CallableSignature(SymbolIdentity(identity, "instance-method"), member.name,
                            CallableKind("instance-method"), argumentTypes, returnType, owner,
                            optionalCount, argumentNames, methodParameters,
                            parameters.isEmpty ? null : GenericDeclaration(owner.declarationIdentity, parameters, owner),
                            asyncFunction: implementation.asyncMethod, externalName: implementation.externalName))
                        continue
                    }
                    let identity = DeclarationIdentity(SyntaxIslandIdentity(member.range.snapshot,
                        "instance-method", member.range.startTokenIndex), "instance-method", member.name)
                    signatures.add(CallableSignature(SymbolIdentity(identity, "instance-method"),
                        member.name, CallableKind("instance-method"), SemanticType[],
                        member.nativeArrayReturnModifierRange ? resolver.resolveNativeArrayStorage(member.returnTypeName) :
                            member.nativeReturnModifierRange && member.returnTypeName == "String" ? SemanticTypes.stringType() :
                            resolver.resolve(member.returnTypeName), owner,
                        ownerGenericDeclaration: parameters.isEmpty ? null :
                            GenericDeclaration(owner.declarationIdentity, parameters, owner)))
                }
            }
        }
        var TypeHierarchyComponent contextHierarchy
        if (!arrayDeclaration) {
            let canonical = ordered.firstOrNull((source) => source.namespaceName == "flat/datastruct/list" &&
                source.classValues().any({ _.name == "Array" }))
            let canonicalSyntax = canonical ? canonical.classValues().firstOrNull({ _.name == "Array" }) : null
            let selected = canonicalSyntax ? effectiveSyntaxes.firstOrNull((syntax) =>
                syntax.name == "Array" && syntax.range.snapshot == canonicalSyntax.range.snapshot &&
                syntax.range.startTokenIndex == canonicalSyntax.range.startTokenIndex) : null
            if (selected) contextHierarchy = arrayHierarchy(selected, effectiveSyntaxes, null,
                context: PrimitiveResolvedDeclarationContext(canonical, ordered))
        }
        if (arrayDeclaration) {
            let selected = effectiveSyntaxes.firstOrNull((syntax) =>
                DeclarationIdentity(SyntaxIslandIdentity(syntax.range.snapshot, "class", syntax.range.startTokenIndex), "class", syntax.name).value == arrayDeclaration.value
            )
            if (!selected) throw Exception("Selected Array declaration is outside the admitted component")
            let source = ordered.firstOrNull((candidate) => candidate.classValues().any((syntax) =>
                syntax.range.snapshot == selected.range.snapshot && syntax.range.startTokenIndex == selected.range.startTokenIndex))
            let scope = PrimitiveResolvedDeclarationContext(source, ordered)
            contextHierarchy = arrayHierarchy(selected, effectiveSyntaxes, null, context: scope)
        }
        if (!contextHierarchy) {
            contextHierarchy = TypeHierarchyComponent()
            for (source in ordered) {
                let scope = PrimitiveResolvedDeclarationContext(source, ordered)
                for (syntax in source.classValues()) {
                    let type = UserClassSemanticType(scope.classIdentity(syntax))
                    let parents = UserClassSemanticType[]
                    if (syntax.parentName) parents.add(UserClassSemanticType(scope.resolve(syntax.parentName, syntax.range)))
                    else if (syntax.name != "Object" && syntaxes.any({ _.name == "Object" })) {
                        parents.add(UserClassSemanticType(scope.resolve("Object", syntax.range)))
                    }
                    let genericParameters = GenericParameterSemanticType[]
                    if (syntax.genericParameterName) genericParameters.add(GenericParameterSemanticType(
                        type.declarationIdentity, syntax.genericParameterName, 0))
                    contextHierarchy.add(TypeHierarchyDeclaration(type, "class", parents,
                        genericParameters: genericParameters))
                    // Only the admitted canonical declaration owns universal-root authority.
                    // Unrelated lexical classes named Object remain ordinary declarations.
                    if (source.namespaceName == "flat" && syntax.name == "Object") {
                        contextHierarchy.registerRootDeclaration(type)
                    }
                }
            }
            registerScalarDeclarations(contextHierarchy, PrimitiveResolvedDeclarationContext(ordered.first, ordered))
            contextHierarchy.seal()
            if (!contextHierarchy.valid) throw Exception("Invalid source component hierarchy")
        }
        let units = BoundTypeUnit[]
        let completed = String[]
        while (units.count < syntaxes.count) {
            var Bool progressed
            for (source in ordered) {
                let scope = PrimitiveResolvedDeclarationContext(source, ordered)
                for (original in source.classValues()) {
                    let identity = scope.classIdentity(original)
                    let syntax = effectiveSyntaxes.firstOrNull({ scope.classIdentity(_).value == identity.value })
                    if (completed.contains(identity.value)) continue
                    var Bool waiting
                    try {
                        signatureContext = scope
                        waiting = awaitInferredMember(syntax, effectiveSyntaxes, signatures, fields, completed)
                    } finally { signatureContext = null }
                    if (waiting) continue
                    let parentIdentity = syntax.parentName ? scope.resolve(syntax.parentName, syntax.range) : null
                    if (parentIdentity && !completed.contains(parentIdentity.value)) continue
                    if (parentIdentity) {
                        let parentSyntax = scope.classFor(parentIdentity)
                        let parentUnit = units.firstOrNull({ _.identity.value == parentIdentity.value })
                        let inherited = PrimitiveInheritanceBinder().bind(parentSyntax, syntax,
                            availableConstructors: signatures, interfaceSyntaxValues: contracts,
                            boundParent: parentUnit, availableFields: fields, conversionHierarchy: contextHierarchy,
                            rootContractFunctions: units.firstOrNull({ _.identity.name == "Object" })?.functionUnits() ?: BoundFunctionUnit[],
                            parentContext: scope.scopeFor(parentIdentity), childContext: scope)
                        units.add(inherited.childType)
                    } else units.add(PrimitiveClassBinder().bind(syntax, source.snapshot,
                        availableConstructors: signatures, availableFields: fields,
                        interfaceSyntaxValues: contracts, hierarchy: contextHierarchy, resolvedContext: scope).typeUnit)
                    let justBound = units.last
                    var Int signatureIndex
                    while (signatureIndex < signatures.count) {
                        let signature = signatures[signatureIndex]
                        let function = justBound.functionUnits().firstOrNull({ _.identity.value == signature.identity.declaration.value })
                        if (function && signature.ownerType.value() == justBound.semanticType.value() &&
                            signature.returnType.kind() == "unknown" && function.returnType.kind() != "unknown") {
                            signatures[signatureIndex] = CallableSignature(signature.identity, signature.name,
                                signature.callableKind, signature.parameterTypes(), function.returnType, signature.ownerType,
                                signature.optionalParameterCount, signature.parameterNames(), signature.genericParameters(),
                                signature.ownerGenericDeclaration, signature.ownerInstance,
                                signature.asyncFunction, signature.externalName, signature.dispatchIdentity)
                        }
                        signatureIndex++
                    }
                    completed.add(identity.value)
                    progressed = true
                }
            }
            if (!progressed) throw Exception("Missing or cyclic resolved parent in admitted declaration component")
        }
        if (arrayDeclaration && units.none({ _.identity.value == arrayDeclaration.value })) {
            throw Exception("Selected Array declaration is outside the admitted component")
        }
        return PrimitiveClassPartitionBindingResult(units)
    }

    /** Defer only a consumer that selects an unpublished inferred owner member. */
    awaitInferredMember(
        PrimitiveClassSyntax syntax, PrimitiveClassSyntax[] syntaxes,
        CallableSignature[] signatures, BoundFieldUnit[] fields, String[] boundNames
    ) -> Bool {
        for (method in syntax.methodValues()) {
            for (statement in method.statements()) {
                if (awaitInStatement(statement, syntax, method, syntaxes,
                    signatures, fields, boundNames)) return true
            }
        }
        return false
    }

    awaitInStatement(
        PrimitiveStatementSyntax statement, PrimitiveClassSyntax syntax,
        PrimitiveFunctionSyntax method, PrimitiveClassSyntax[] syntaxes,
        CallableSignature[] signatures, BoundFieldUnit[] fields, String[] boundNames
    ) -> Bool {
        if (statement.class.isOfType(PrimitiveWhileSyntax.class)) {
            let value = (PrimitiveWhileSyntax)statement
            if (awaitInExpression(value.condition, syntax, method, syntaxes,
                signatures, fields, boundNames)) return true
            for (nested in value.bodyValues()) {
                if (awaitInStatement(nested, syntax, method, syntaxes,
                    signatures, fields, boundNames)) return true
            }
        }
        if (statement.class.isOfType(PrimitiveIfSyntax.class)) {
            let value = (PrimitiveIfSyntax)statement
            if (awaitInExpression(value.condition, syntax, method, syntaxes,
                signatures, fields, boundNames)) return true
            for (nested in value.thenValues()) {
                if (awaitInStatement(nested, syntax, method, syntaxes,
                    signatures, fields, boundNames)) return true
            }
            for (nested in value.elseValues()) {
                if (awaitInStatement(nested, syntax, method, syntaxes,
                    signatures, fields, boundNames)) return true
            }
        }
        if (statement.class.isOfType(PrimitiveReturnSyntax.class)) {
            let value = (PrimitiveReturnSyntax)statement
            if (value.value && awaitInExpression(value.value, syntax, method,
                syntaxes, signatures, fields, boundNames)) return true
        }
        if (statement.class.isOfType(PrimitiveExpressionStatementSyntax.class)) {
            let value = (PrimitiveExpressionStatementSyntax)statement
            return awaitInExpression(value.expression, syntax, method,
                syntaxes, signatures, fields, boundNames)
        }
        if (statement.class.isOfType(PrimitiveLocalDeclarationSyntax.class)) {
            let value = (PrimitiveLocalDeclarationSyntax)statement
            return value.initializer && awaitInExpression(value.initializer, syntax,
                method, syntaxes, signatures, fields, boundNames)
        }
        return false
    }

    awaitInExpression(
        PrimitiveExpressionSyntax expression, PrimitiveClassSyntax syntax,
        PrimitiveFunctionSyntax method, PrimitiveClassSyntax[] syntaxes,
        CallableSignature[] signatures, BoundFieldUnit[] fields, String[] boundNames,
        FunctionSemanticType callbackContext = null
    ) -> Bool {
        if (expression.class.isOfType(PrimitiveLambdaSyntax.class)) {
            let lambda = (PrimitiveLambdaSyntax)expression
            if (lambda.body && awaitInExpression(lambda.body, syntax, method, syntaxes,
                signatures, fields, boundNames, callbackContext)) return true
            return false
        }
        if (expression.class.isOfType(PrimitiveBinarySyntax.class)) {
            let value = (PrimitiveBinarySyntax)expression
            return awaitInExpression(value.left, syntax, method, syntaxes,
                signatures, fields, boundNames, callbackContext) || awaitInExpression(value.right,
                    syntax, method, syntaxes, signatures, fields, boundNames, callbackContext)
        }
        if (expression.class.isOfType(PrimitiveMemberCallSyntax.class)) {
            let call = (PrimitiveMemberCallSyntax)expression
            if (awaitInExpression(call.receiver, syntax, method, syntaxes,
                signatures, fields, boundNames)) return true
            for (argument in call.argumentValues()) {
                if (awaitInExpression(argument, syntax, method, syntaxes,
                    signatures, fields, boundNames)) return true
            }
            if (call.receiver.class.isOfType(PrimitiveConstructionSyntax.class)) {
                let construction = (PrimitiveConstructionSyntax)call.receiver
                let target = syntaxes.firstOrNull({ _.name == construction.typeName })
                if (target && signatures.any((candidate) => candidate.ownerType &&
                    candidate.ownerType.declarationIdentity.name == target.name &&
                    candidate.name == call.memberName && candidate.returnType.kind() == "unknown") &&
                    !boundNames.contains(target.name) && target.name != syntax.name) return true
            }
            if (call.receiver.class.isOfType(PrimitiveReferenceSyntax.class)) {
                let reference = (PrimitiveReferenceSyntax)call.receiver
                let parameter = method.parameterValues().firstOrNull({ _.name == reference.name })
                var SemanticType type
                if (callbackContext && (reference.name == "_" || reference.name == "_1" || reference.name == "_x") &&
                    callbackContext.parameterTypes().isNotEmpty) type = callbackContext.parameterTypes().first
                if (!type && parameter) {
                    let resolver = PrimitiveStructuralTypeResolver(
                        syntaxes: syntaxes, interfaces: interfaces,
                        genericParameter: syntax.genericParameterName ? GenericParameterSemanticType(
                            DeclarationIdentity(SyntaxIslandIdentity(syntax.range.snapshot,
                                "class", syntax.range.startTokenIndex), "class", syntax.name),
                            syntax.genericParameterName, 0) : null,
                        methodGenericParameters: method.genericParameterNames().map((name) =>
                            GenericParameterSemanticType(DeclarationIdentity(
                                SyntaxIslandIdentity(method.range.snapshot,
                                    method.staticMethod ? "static-method" : "instance-method",
                                    method.range.startTokenIndex),
                                method.staticMethod ? "static-method" : "instance-method",
                                method.name), name, 0)
                        ), implementationOwner: syntax, implementationRange: method.range,
                        declarationContext: signatureContext ? signatureContext.scopeForSnapshot(method.range.snapshot) : null,
                        lookupRange: parameter.range
                    )
                    type = resolver.resolveParameter(parameter)
                } else if (method.parameterValues().none({ _.name == reference.name })) {
                    let field = fields.firstOrNull((candidate) =>
                        candidate.name == reference.name &&
                        candidate.identity.declaration.value ==
                            DeclarationIdentity(SyntaxIslandIdentity(syntax.range.snapshot,
                                "class", syntax.range.startTokenIndex), "class", syntax.name).value)
                    if (field) type = field.semanticType
                }
                if (type && type.kind() == "primitive") {
                    let primitiveName = ((PrimitiveSemanticType)type).name
                    if (signatures.any((candidate) => candidate.ownerType &&
                        candidate.ownerType.declarationIdentity.name == primitiveName &&
                        candidate.callableKind.value == "static-method" && candidate.name == call.memberName &&
                        candidate.returnType.kind() == "unknown" &&
                        !boundNames.contains(signatureContext ? candidate.ownerType.declarationIdentity.value : primitiveName) &&
                        primitiveName != syntax.name)) return true
                }
                if (!type && !parameter && signatures.any((candidate) => candidate.ownerType &&
                    candidate.ownerType.declarationIdentity.name == reference.name &&
                    candidate.callableKind.value == "static-method" && candidate.name == call.memberName &&
                    candidate.returnType.kind() == "unknown" &&
                    !boundNames.contains(signatureContext ? candidate.ownerType.declarationIdentity.value : reference.name) &&
                    reference.name != syntax.name)) return true
                if (type) {
                    let owner = type.kind() == "generic-instance"
                        ? ((GenericInstanceSemanticType)type).declarationType : type
                    if (signatures.any((candidate) => candidate.ownerType &&
                        candidate.ownerType.value() == owner.value() &&
                        candidate.name == call.memberName &&
                        candidate.returnType.kind() == "unknown" &&
                        !boundNames.contains(signatureContext ? candidate.ownerType.declarationIdentity.value :
                            candidate.ownerType.declarationIdentity.name) &&
                        candidate.ownerType.declarationIdentity.value !=
                            DeclarationIdentity(SyntaxIslandIdentity(syntax.range.snapshot,
                                "class", syntax.range.startTokenIndex), "class", syntax.name).value)) {
                        return true
                    }
                }
            }
        }
        if (expression.class.isOfType(PrimitiveConditionalSyntax.class)) {
            let value = (PrimitiveConditionalSyntax)expression
            return awaitInExpression(value.condition, syntax, method, syntaxes,
                signatures, fields, boundNames) || awaitInExpression(value.whenTrue,
                    syntax, method, syntaxes, signatures, fields, boundNames) ||
                awaitInExpression(value.whenFalse, syntax, method, syntaxes,
                    signatures, fields, boundNames)
        }
        if (expression.class.isOfType(PrimitiveCallSyntax.class)) {
            let value = (PrimitiveCallSyntax)expression
            let ownerIdentity = signatureContext ? signatureContext.classIdentity(syntax) :
                DeclarationIdentity(SyntaxIslandIdentity(syntax.range.snapshot, "class", syntax.range.startTokenIndex),
                    "class", syntax.name)
            let candidates = signatures.filter((candidate) => candidate.ownerType &&
                candidate.ownerType.declarationIdentity.value == ownerIdentity.value &&
                candidate.name == value.name && callbackArgumentShapeForReadiness(candidate, value.argumentValues()))
            var Int argumentIndex
            for (argument in value.argumentValues()) {
                let types = candidates.count == 1 ? candidates.first.parameterTypes() : SemanticType[]
                let context = argumentIndex < types.count && types[argumentIndex].kind() == "function"
                    ? (FunctionSemanticType)types[argumentIndex] : null
                if (awaitInExpression(argument, syntax, method, syntaxes,
                    signatures, fields, boundNames, context)) return true
                argumentIndex++
            }
        }
        return false
    }

    /** Only use an unambiguous callback shape to discover a suspended declaration dependency. */
    callbackArgumentShapeForReadiness(CallableSignature candidate, PrimitiveExpressionSyntax[] arguments) -> Bool {
        let types = candidate.parameterTypes()
        if (arguments.count > types.count || arguments.count < types.count - candidate.optionalParameterCount) return false
        var Int index
        for (argument in arguments) {
            if (argument.class.isOfType(PrimitiveLambdaSyntax.class) && types[index].kind() != "function") return false
            index++
        }
        return true
    }

    /** Seals the selected array's direct interface component, not the whole package. */
    arrayHierarchy(PrimitiveClassSyntax array, PrimitiveClassSyntax[] syntaxes,
        SourceSnapshotIdentity snapshot, Bool registerArray = true,
        PrimitiveResolvedDeclarationContext context = null) -> TypeHierarchyComponent {
        if (!syntaxes.any({ Object.referenceEquals(_, array) }) || (registerArray && !array.genericParameterName)) {
            throw Exception("Array declaration must be a generic class in the bound partition")
        }
        let resolvedType = PrimitiveStructuralTypeResolver(
            syntaxes: syntaxes, snapshot: snapshot, interfaces: interfaces,
            declarationContext: context, lookupRange: array.range
        ).resolve(array.name)
        let type = (UserClassSemanticType)resolvedType
        let parameter = array.genericParameterName ? GenericParameterSemanticType(type.declarationIdentity, array.genericParameterName, 0) : null
        let resolver = PrimitiveStructuralTypeResolver(syntaxes: syntaxes, snapshot: snapshot,
            interfaces: interfaces, genericParameter: parameter,
            declarationContext: context, lookupRange: array.range)
        let parents = UserClassSemanticType[]
        let templates = GenericInstanceSemanticType[]
        let hierarchy = TypeHierarchyComponent()
        let published = String[]
        for (name in array.implementedTypeNames()) {
            let parent = resolver.resolve(name)
            if (parent.kind() != "generic-instance") throw Exception("Array interface requires generic arguments")
            let instance = (GenericInstanceSemanticType)parent
            let declaration = instance.declarationType
            let contract = context ? context.interfaceFor(declaration.declarationIdentity) :
                interfaces.firstOrNull({ _.name == declaration.declarationIdentity.name })
            if (!contract || instance.typeArguments().count != contract.genericParameterNames().count) {
                throw Exception("Array interface type argument count must match its declaration")
            }
            if (!parents.any({ _.value() == declaration.value() })) {
                publishInterface(contract, declaration, syntaxes, snapshot, hierarchy, published,
                    context ? context.scopeFor(declaration.declarationIdentity) : null)
                parents.add(declaration)
            }
            templates.add(instance)
        }
        let parameters = GenericParameterSemanticType[]
        if (parameter) parameters.add(parameter)
        hierarchy.add(TypeHierarchyDeclaration(type, "class", parents,
            genericParameters: parameters, genericParents: templates))
        if (registerArray) hierarchy.registerArrayDeclaration(type)
        // Keep both language contracts in this scoped component: selecting a
        // separate root-only component would erase registered array conversions.
        let rootSyntax = syntaxes.firstOrNull({ _.name == "Object" })
        if (rootSyntax) {
            let root = UserClassSemanticType(DeclarationIdentity(
                SyntaxIslandIdentity(snapshot ?: rootSyntax.range.snapshot,
                    "class", rootSyntax.range.startTokenIndex), "class", rootSyntax.name))
            if (root.value() != type.value())
                hierarchy.add(TypeHierarchyDeclaration(root, "class", UserClassSemanticType[]))
            hierarchy.registerRootDeclaration(root)
        }
        for (syntax in syntaxes) {
            if (syntax.name == array.name || syntax.name == "Object") continue
            let identity = DeclarationIdentity(SyntaxIslandIdentity(snapshot ?: syntax.range.snapshot,
                "class", syntax.range.startTokenIndex), "class", syntax.name)
            let scope = context ? context.scopeFor(identity) : null
            let concreteGeneric = syntax.genericParameterName ? GenericParameterSemanticType(
                identity, syntax.genericParameterName, 0) : null
            let concreteResolver = PrimitiveStructuralTypeResolver(syntaxes: syntaxes, snapshot: snapshot,
                genericParameter: concreteGeneric, interfaces: interfaces, declarationContext: scope, lookupRange: syntax.range)
            let concreteParents = GenericInstanceSemanticType[]
            for (name in syntax.implementedTypeNames()) {
                let resolved = concreteResolver.resolve(name)
                if (resolved.kind() != "generic-instance") continue
                let instance = (GenericInstanceSemanticType)resolved
                let contract = scope ? scope.interfaceFor(instance.declarationType.declarationIdentity) :
                    interfaces.firstOrNull({ _.name == instance.declarationType.declarationIdentity.name })
                if (!contract) continue
                publishInterface(contract, instance.declarationType, syntaxes, snapshot, hierarchy, published,
                    scope ? scope.scopeFor(instance.declarationType.declarationIdentity) : null)
                concreteParents.add(instance)
            }
            let directParents = UserClassSemanticType[]
            if (syntax.parentName) {
                // Parent edges identify source declarations, not expression types.
                // In particular String/Bool/numeric spellings resolve to builtin
                // value types in the structural resolver, never hierarchy nodes.
                if (!syntax.parentName.contains("<")) {
                    let parentSyntax = syntaxes.firstOrNull({ _.name == syntax.parentName })
                    if (!scope && !parentSyntax) throw Exception("Unknown hierarchy parent '#{syntax.parentName}'")
                    let parentIdentity = scope ? scope.resolve(syntax.parentName, syntax.range) : DeclarationIdentity(
                        SyntaxIslandIdentity(snapshot ?: parentSyntax.range.snapshot, "class", parentSyntax.range.startTokenIndex),
                        "class", parentSyntax.name)
                    directParents.add(UserClassSemanticType(parentIdentity))
                } else {
                    let parent = concreteResolver.resolve(syntax.parentName)
                    let instance = (GenericInstanceSemanticType)parent
                    directParents.add(instance.declarationType)
                    concreteParents.add(instance)
                }
            } else if (rootSyntax) directParents.add(UserClassSemanticType(DeclarationIdentity(
                SyntaxIslandIdentity(snapshot ?: rootSyntax.range.snapshot, "class", rootSyntax.range.startTokenIndex),
                "class", rootSyntax.name)))
            for (parent in concreteParents) {
                if (directParents.none({ _.value() == parent.declarationType.value() })) directParents.add(parent.declarationType)
            }
            let declaredGenerics = GenericParameterSemanticType[]
            if (concreteGeneric) declaredGenerics.add(concreteGeneric)
            hierarchy.add(TypeHierarchyDeclaration(UserClassSemanticType(identity), "class", directParents,
                genericParameters: declaredGenerics, genericParents: concreteParents))
        }
        registerScalarDeclarations(hierarchy, context)
        hierarchy.seal()
        if (!hierarchy.valid) {
            let diagnostic = hierarchy.diagnostics().first
            throw Exception("Invalid array interface hierarchy: #{diagnostic.code} #{diagnostic.semanticType.value()}: #{diagnostic.message}")
        }
        return hierarchy
    }

    publishInterface(PrimitiveInterfaceSyntax contract, UserClassSemanticType declaration,
        PrimitiveClassSyntax[] syntaxes, SourceSnapshotIdentity snapshot,
        TypeHierarchyComponent hierarchy, String[] published,
        PrimitiveResolvedDeclarationContext context = null) {
        if (published.contains(declaration.value())) return
        published.add(declaration.value())
        let parameters = GenericParameterSemanticType[]
        for (name in contract.genericParameterNames()) {
            parameters.add(GenericParameterSemanticType(declaration.declarationIdentity, name, parameters.count))
        }
        let resolver = PrimitiveStructuralTypeResolver(syntaxes: syntaxes, snapshot: snapshot,
            interfaces: interfaces, methodGenericParameters: parameters,
            declarationContext: context, lookupRange: contract.range)
        let parents = UserClassSemanticType[]
        let templates = GenericInstanceSemanticType[]
        for (name in contract.parentTypeNames()) {
            let resolved = resolver.resolve(name)
            if (resolved.kind() != "generic-instance") throw Exception("Inherited interface requires generic arguments")
            let instance = (GenericInstanceSemanticType)resolved
            let parent = instance.declarationType
            let parentSyntax = context ? context.interfaceFor(parent.declarationIdentity) :
                interfaces.firstOrNull({ _.name == parent.declarationIdentity.name })
            if (!parentSyntax || parentSyntax.genericParameterNames().count != instance.typeArguments().count) {
                throw Exception("Inherited interface type argument count must match declaration")
            }
            if (!parents.any({ _.value() == parent.value() })) parents.add(parent)
            templates.add(instance)
            publishInterface(parentSyntax, parent, syntaxes, snapshot, hierarchy, published,
                context ? context.scopeFor(parent.declarationIdentity) : null)
        }
        hierarchy.add(TypeHierarchyDeclaration(declaration, "interface", parents,
            genericParameters: parameters, genericParents: templates))
    }

    /** Publish default bodies before signatures, scoped to this finite class partition. */
    withTraitImplementations(PrimitiveClassSyntax syntax) -> PrimitiveClassSyntax {
        let methods = syntax.methodValues()
        let fields = syntax.fieldValues()
        for (name in syntax.implementedTypeNames()) {
            publishTraitDefaults(syntax, name, methods, String[])
            publishTraitStorage(syntax, name, fields, String[])
        }
        if (methods.count == syntax.methodValues().count && fields.count == syntax.fieldValues().count) return syntax
        return PrimitiveClassSyntax(syntax.range, syntax.name, syntax.genericParameterName,
            syntax.parentName, fields, syntax.constructorValue, methods,
            syntax.implementedTypeNames(), syntax.abstractClass,
            syntax.arrayOverrideValues(), syntax.constructorValues())
    }

    publishTraitStorage(PrimitiveClassSyntax syntax, String implementedName,
        PrimitiveFieldSyntax[] fields, String[] path) {
        let open = implementedName.indexOf("<", defaultReturnValue: -1)
        let name = open < 0 ? implementedName : implementedName.substring(0, open)
        if (path.contains(name)) throw Exception("Trait storage cycle '#name'")
        let contract = signatureContext ? signatureContext.interfaceFor(
            signatureContext.resolve(name, syntax.range)) : interfaces.firstOrNull({ _.name == name })
        if (!contract) return
        let arguments = open < 0 ? String[] : splitOverrideTypes(implementedName.substring(open + 1, implementedName.count - 1))
        let parameters = contract.genericParameterNames()
        if (parameters.count != arguments.count) throw Exception("Trait storage generic arity mismatch")
        for (member in contract.methodValues()) {
            if (!member.storageProperty || fields.any({ _.name == member.name }) ||
                syntax.methodValues().any({ _.name == member.name })) continue
            let typeName = substituteTraitTypeNames(member.returnTypeName, parameters, arguments)
            fields.add(PrimitiveFieldSyntax(member.range, typeName, member.name, true,
                member.defaultValue, mutableField: true,
                nativeArrayStorage: member.nativeArrayReturnModifierRange != null,
                nativeScalarStorage: member.nativeReturnModifierRange != null &&
                    member.nativeArrayReturnModifierRange == null))
        }
        let visited = String[]:addAll(path)
        visited.add(name)
        for (parent in contract.parentTypeNames()) {
            let instantiated = substituteTraitTypeNames(parent, parameters, arguments)
            publishTraitStorage(syntax, instantiated, fields, visited)
        }
    }

    /** Substitute complete type identifiers simultaneously, never substrings or inserted arguments. */
    substituteTraitTypeNames(String value, String[] parameters, String[] arguments) -> String {
        var String result = ""
        var Int index
        let identifierCharacters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
        while (index < value.count) {
            let start = index
            while (index < value.count &&
                identifierCharacters.contains(value.substring(index, index + 1))) index++
            if (start == index) {
                result += value.substring(index, index + 1)
                index++
                continue
            }
            let name = value.substring(start, index)
            var String replacement = name
            var Int parameterIndex
            for (parameter in parameters) {
                if (name == parameter) replacement = arguments[parameterIndex]
                parameterIndex++
            }
            result += replacement
        }
        return result
    }

    /** Resolve each contract edge before publishing defaults; the path bounds cycles to this partition. */
    publishTraitDefaults(PrimitiveClassSyntax syntax, String implementedName,
        PrimitiveFunctionSyntax[] methods, String[] path) {
        let open = implementedName.indexOf("<", defaultReturnValue: -1)
        let contractName = open < 0 ? implementedName : implementedName.substring(0, open)
        let contract = signatureContext ? signatureContext.interfaceFor(
            signatureContext.resolve(contractName, syntax.range)) : interfaces.firstOrNull({ _.name == contractName })
        if (!contract) return
        if (path.contains(contractName)) throw Exception("Cyclic trait inheritance '#contractName'")
        let visited = String[]:addAll(path)
        visited.add(contractName)
        let arguments = open < 0 ? String[] :
            splitOverrideTypes(implementedName.substring(open + 1, implementedName.count - 1))
        let parameters = contract.genericParameterNames()
        if (arguments.count != parameters.count) throw Exception("Trait implementation generic arity mismatch")
        for (member in contract.methodValues()) {
            let implementation = member.implementation()
            if (!implementation || syntax.methodValues().any((method) =>
                overridesTraitMethod(syntax, implementedName, contract, method, member))) continue
            if (methods.any((method) => method.name == member.name &&
                method.range.snapshot == implementation.range.snapshot &&
                method.range.startTokenIndex == implementation.range.startTokenIndex)) continue
            if (methods.any((method) =>
                overridesTraitMethod(syntax, implementedName, contract, method, member))) {
                throw Exception("Ambiguous trait default '#{member.name}' requires a class implementation")
            }
            methods.add(implementation)
        }
        for (parentName in contract.parentTypeNames()) {
            let parentOpen = parentName.indexOf("<", defaultReturnValue: -1)
            if (parentOpen < 0) {
                publishTraitDefaults(syntax, parentName, methods, visited)
                continue
            }
            let instantiated = String[]
            for (argument in splitOverrideTypes(parentName.substring(
                parentOpen + 1, parentName.count - 1))) {
                let position = parameters.indexOf(argument, defaultReturnValue: -1)
                instantiated.add(position < 0 ? argument : arguments[position])
            }
            publishTraitDefaults(syntax,
                parentName.substring(0, parentOpen) + "<" + instantiated.join(",") + ">",
                methods, visited)
        }
    }

    /** Compare instantiated trait parameters with a class declaration. A callback may
     * specialize a self-typed trait parameter to its implementing class. */
    overridesTraitMethod(PrimitiveClassSyntax syntax, String implementedName,
        PrimitiveInterfaceSyntax contract, PrimitiveFunctionSyntax method,
        PrimitiveInterfaceMethodSyntax member) -> Bool {
        if (method.name != member.name ||
            method.parameterValues().count != member.parameterTypeNames().count) return false
        let genericStart = implementedName.indexOf("<", defaultReturnValue: -1)
        let arguments = genericStart < 0 ? String[] :
            splitOverrideTypes(implementedName.substring(genericStart + 1, implementedName.count - 1))
        let parameters = contract.genericParameterNames()
        if (arguments.count != parameters.count) return false
        let memberGenerics = member.implementation()?.genericParameterNames() ?: String[]
        let methodGenerics = method.genericParameterNames()
        if (memberGenerics.count != methodGenerics.count) return false
        let memberTypes = member.parameterTypeNames()
        let methodParameters = method.parameterValues()
        var Int index
        while (index < memberTypes.count) {
            if (!sameOverrideType(memberTypes[index], methodParameters[index].typeName,
                contract.name, syntax.name, parameters, arguments,
                memberGenerics, methodGenerics)) return false
            index++
        }
        return true
    }

    sameOverrideType(String traitType, String classType, String traitName,
        String className, String[] parameters, String[] arguments,
        String[] memberGenerics, String[] methodGenerics) -> Bool {
        var Int index
        while (index < parameters.count) {
            if (traitType == parameters[index]) return classType == arguments[index]
            index++
        }
        index = 0
        while (index < memberGenerics.count) {
            if (traitType == memberGenerics[index]) return classType == methodGenerics[index]
            index++
        }
        if (traitType == classType) return true
        let traitOpen = traitType.indexOf("<", defaultReturnValue: -1)
        let classOpen = classType.indexOf("<", defaultReturnValue: -1)
        if (traitOpen >= 0 && classOpen >= 0 && traitType.endsWith(">") && classType.endsWith(">")) {
            let traitBase = traitType.substring(0, traitOpen)
            let classBase = classType.substring(0, classOpen)
            if (traitBase != classBase &&
                !(traitBase == traitName && classBase == className)) return false
            let traitArgs = splitOverrideTypes(traitType.substring(traitOpen + 1, traitType.count - 1))
            let classArgs = splitOverrideTypes(classType.substring(classOpen + 1, classType.count - 1))
            if (traitArgs.count != classArgs.count) return false
            index = 0
            while (index < traitArgs.count) {
                if (!sameOverrideType(traitArgs[index], classArgs[index], traitName,
                    className, parameters, arguments, memberGenerics, methodGenerics)) return false
                index++
            }
            return true
        }
        let traitFunction = traitType.indexOf("(", defaultReturnValue: -1)
        let classFunction = classType.indexOf("(", defaultReturnValue: -1)
        if (traitFunction < 0 || classFunction < 0) return false
        // The parser retains the callback parameter name for trait signatures,
        // while class function types use the canonical "func" marker.
        let traitPrefix = traitType.substring(0, traitFunction)
        let classPrefix = classType.substring(0, classFunction)
        if (classPrefix != "func" && traitPrefix != classPrefix) return false
        let traitClose = traitType.lastIndexOf(")", defaultReturnValue: -1)
        let classClose = classType.lastIndexOf(")", defaultReturnValue: -1)
        if (traitClose < 0 || classClose < 0) return false
        let traitArgs = splitOverrideTypes(traitType.substring(traitFunction + 1, traitClose))
        let classArgs = splitOverrideTypes(classType.substring(classFunction + 1, classClose))
        if (traitArgs.count != classArgs.count ||
            !sameOverrideType(traitType.substring(traitClose + 1),
                classType.substring(classClose + 1), traitName, className,
                parameters, arguments, memberGenerics, methodGenerics)) return false
        index = 0
        while (index < traitArgs.count) {
            if (!sameOverrideType(traitArgs[index], classArgs[index], traitName,
                className, parameters, arguments, memberGenerics, methodGenerics)) return false
            index++
        }
        return true
    }

    splitOverrideTypes(String value) -> String[] {
        let result = String[]
        if (value.isEmpty) return result
        var Int start
        var Int depth
        var Int index
        while (index < value.count) {
            let character = value.substring(index, index + 1)
            if (character == "(" || character == "<") depth++
            else if (character == ")" ||
                (character == ">" && (index == 0 || value.substring(index - 1, index) != "-"))) depth--
            else if (character == "," && depth == 0) {
                result.add(value.substring(start, index))
                start = index + 1
            }
            index++
        }
        result.add(value.substring(start))
        return result
    }

    withImplicitRootParent(
        PrimitiveClassSyntax syntax,
        PrimitiveClassSyntax[] syntaxes
    ) -> PrimitiveClassSyntax {
        if (syntax.parentName || syntax.name == "Object" ||
            syntaxes.none({ _.name == "Object" })) return syntax
        return PrimitiveClassSyntax(
            syntax.range, syntax.name, syntax.genericParameterName, "Object",
            syntax.fieldValues(), syntax.constructorValue, syntax.methodValues(),
            syntax.implementedTypeNames(), syntax.abstractClass,
            syntax.arrayOverrideValues(), syntax.constructorValues()
        )
    }

    methodSignatures(
        PrimitiveClassSyntax[] syntaxes,
        SourceSnapshotIdentity snapshot
    ) -> CallableSignature[] {
        let result = CallableSignature[]
        for (syntax in syntaxes) {
            let syntaxSnapshot = snapshot ?: syntax.range.snapshot
            let ownerIdentity = DeclarationIdentity(
                SyntaxIslandIdentity(syntaxSnapshot, "class", syntax.range.startTokenIndex),
                "class", syntax.name
            )
            let owner = UserClassSemanticType(ownerIdentity)
            var Int ordinal
            for (method in syntax.methodValues()) {
                let methodKind = method.staticMethod ? "static-method" : "instance-method"
                let methodIdentity = DeclarationIdentity(
                    SyntaxIslandIdentity(method.range.snapshot, methodKind, method.range.startTokenIndex),
                    methodKind, method.name
                )
                let methodGenerics = GenericParameterSemanticType[]
                for (genericName in method.genericParameterNames()) {
                    methodGenerics.add(GenericParameterSemanticType(
                        methodIdentity, genericName, methodGenerics.count
                    ))
                }
                let classGeneric = syntax.genericParameterName ? GenericParameterSemanticType(
                    ownerIdentity, syntax.genericParameterName, 0
                ) : null
                var SemanticType[] parameterTypes = method.parameterValues().map((parameter) =>
                    signatureType(parameter.typeName, syntaxes, snapshot, classGeneric, methodGenerics,
                        syntax, method.range, parameter.nativeArrayStorage, parameter.nativeScalarStorage)
                )
                var Int provenanceIndex
                for (parameter in method.parameterValues()) {
                    parameterTypes[provenanceIndex] = PrimitiveStructuralTypeResolver(interfaces: interfaces).specializedParameterType(method, provenanceIndex, parameterTypes[provenanceIndex])
                    provenanceIndex++
                }
                var Int callbackIndex
                for (parameter in method.parameterValues()) {
                    parameterTypes[callbackIndex] = PrimitiveStructuralTypeResolver().withCallbackNames(
                        parameterTypes[callbackIndex], parameter.callbackParameterNames())
                    callbackIndex++
                }
                var SemanticType inferredMethodReturn = SemanticTypes.unknownType()
                let methodStatements = method.statements()
                let returnAnchor = methodStatements.isNotEmpty &&
                    methodStatements.first.class.isOfType(PrimitiveReturnSyntax.class)
                    ? methodStatements.first : methodStatements.isNotEmpty ? methodStatements.last : null
                if (method.inferredReturnType && returnAnchor &&
                    returnAnchor.class.isOfType(PrimitiveReturnSyntax.class)) {
                    let inferredObject = (Object)returnAnchor
                    let inferredSyntax = (PrimitiveReturnSyntax)inferredObject
                    if (inferredSyntax.value && inferredSyntax.value.class.isOfType(PrimitiveReferenceSyntax.class) &&
                        ((PrimitiveReferenceSyntax)inferredSyntax.value).name == "this") inferredMethodReturn = owner
                    if (inferredSyntax.value &&
                        inferredSyntax.value.class.isOfType(PrimitiveReferenceSyntax.class)) {
                        let reference = (PrimitiveReferenceSyntax)inferredSyntax.value
                        var Int parameterIndex
                        for (parameter in method.parameterValues()) {
                            if (parameter.name == reference.name) {
                                inferredMethodReturn = parameterTypes[parameterIndex]
                                break
                            }
                            parameterIndex++
                        }
                    }
                    if (inferredMethodReturn.kind() == "unknown" && inferredSyntax.value &&
                        inferredSyntax.value.class.isOfType(PrimitiveCallSyntax.class)) {
                        let call = (PrimitiveCallSyntax)inferredSyntax.value
                        let targets = syntax.methodValues().filter((candidate) => candidate.name == call.name &&
                            candidate.parameterValues().count == call.argumentValues().count)
                        let results = SemanticType[]
                        for (target in targets) {
                            // Generic results must be instantiated by typed call selection, not
                            // copied into the caller's declaration scope during signature seeding.
                            if (target.genericParameterNames().isNotEmpty) continue
                            var SemanticType resultType = target.inferredReturnType ? SemanticTypes.unknownType() :
                                signatureType(target.returnTypeName, syntaxes, snapshot, classGeneric, GenericParameterSemanticType[], syntax, target.range,
                                    nativeArrayStorage: target.nativeArrayReturnModifierRange != null,
                                    nativeScalarStorage: target.nativeReturnModifierRange != null && target.nativeArrayReturnModifierRange == null)
                            if (resultType.kind() == "unknown") {
                                var SemanticType literalResult
                                var Bool conflictingLiteral
                                for (statement in target.statements()) {
                                    if (statement.class.isOfType(PrimitiveReturnSyntax.class)) {
                                        let returned = (PrimitiveReturnSyntax)statement
                                        if (returned.value && returned.value.class.isOfType(PrimitiveLiteralSyntax.class)) {
                                            let typed = PrimitiveExpressionBinder().bind(returned.value,
                                                declarationContext: signatureContext ? signatureContext.scopeForSnapshot(target.range.snapshot) : null)
                                            if (typed.succeeded) {
                                                if (literalResult && literalResult.value() != typed.expression.semanticType.value()) conflictingLiteral = true
                                                literalResult = typed.expression.semanticType
                                            }
                                        }
                                    }
                                }
                                if (literalResult && !conflictingLiteral) resultType = PrimitiveStructuralTypeResolver(
                                    declarationContext: signatureContext ? signatureContext.scopeForSnapshot(target.range.snapshot) : null
                                ).inferredExpressionResult(literalResult)
                            }
                            resultType = PrimitiveStructuralTypeResolver(interfaces: interfaces).fallbackResultType(target, resultType)
                            if (resultType.kind() != "unknown") results.add(resultType)
                        }
                        if (results.count == targets.count && results.isNotEmpty &&
                            results.all({ _.value() == results.first.value() })) inferredMethodReturn = results.first
                    }
                    if (inferredMethodReturn.kind() == "unknown" && inferredSyntax.value) {
                        let inferredResolver = PrimitiveStructuralTypeResolver(
                            declarationContext: signatureContext ? signatureContext.scopeForSnapshot(method.range.snapshot) : null,
                            implementationOwner: syntax, implementationRange: method.range)
                        inferredMethodReturn = inferredResolver.constructorResult(inferredSyntax.value)
                    }
                    if (inferredMethodReturn.kind() == "unknown" && inferredSyntax.value) {
                        let inferred = PrimitiveExpressionBinder().bind(inferredSyntax.value,
                            declarationContext: signatureContext ? signatureContext.scopeForSnapshot(method.range.snapshot) : null)
                        if (inferred.succeeded) inferredMethodReturn = PrimitiveStructuralTypeResolver(
                            declarationContext: signatureContext ? signatureContext.scopeForSnapshot(method.range.snapshot) : null,
                            implementationOwner: syntax, implementationRange: method.range
                        ).inferredExpressionResult(inferred.expression.semanticType)
                    }
                }
                let declaredReturnType = method.inferredReturnType
                    ? inferredMethodReturn
                    : method.returnTypeName == "this"
                    ? owner :
                    signatureType(method.returnTypeName, syntaxes, snapshot, classGeneric, methodGenerics, syntax, method.range,
                        nativeArrayStorage: method.nativeArrayReturnModifierRange != null,
                        nativeScalarStorage: method.nativeReturnModifierRange != null && method.nativeArrayReturnModifierRange == null)
                let returnType = PrimitiveStructuralTypeResolver(interfaces: interfaces).fallbackResultType(
                    method, declaredReturnType)
                let identity = DeclarationIdentity(
                    SyntaxIslandIdentity(
                        method.range.snapshot,
                        method.staticMethod ? "static-method" : "instance-method",
                        method.range.startTokenIndex
                    ),
                    method.staticMethod ? "static-method" : "instance-method",
                    method.name
                )
                result.add(CallableSignature(
                    SymbolIdentity(
                        identity,
                        method.staticMethod ? "static-method" : "instance-method"
                    ),
                    method.name,
                    CallableKind(method.staticMethod ? "static-method" : "instance-method"),
                    parameterTypes, returnType, owner,
                    method.parameterValues().filter({ _.defaultValue != null }).count,
                    method.parameterValues().map({ _.name }), methodGenerics,
                    classGeneric ? GenericDeclaration(owner.declarationIdentity, [classGeneric], owner) : null,
                    asyncFunction: method.asyncMethod, externalName: method.externalName
                ))
                ordinal++
            }
        }
        return result
    }

    constructorSignatures(
        PrimitiveClassSyntax[] syntaxes,
        SourceSnapshotIdentity snapshot
    ) -> CallableSignature[] {
        let result = CallableSignature[]
        for (syntax in syntaxes) {
            let syntaxSnapshot = snapshot ?: syntax.range.snapshot
            let typeIdentity = DeclarationIdentity(
                SyntaxIslandIdentity(syntaxSnapshot, "class", syntax.range.startTokenIndex),
                "class", syntax.name
            )
            let type = UserClassSemanticType(typeIdentity)
            let classGeneric = syntax.genericParameterName ?
                GenericParameterSemanticType(typeIdentity, syntax.genericParameterName, 0) : null
            for (constructor in syntax.constructorValues()) {
                let constructorIdentity = DeclarationIdentity(
                    SyntaxIslandIdentity(
                        constructor.range.snapshot,
                        constructor == syntax.constructorValue
                            ? "constructor" : "constructor-overload",
                        constructor.range.startTokenIndex
                    ),
                    "constructor",
                    syntax.name
                )
                let parameterTypes = SemanticType[]
                var Int optionalCount
                var Bool optionalStarted
                for (parameter in constructor.parameterValues()) {
                    let parameterType = signatureType(
                        parameter.typeName, syntaxes, snapshot, classGeneric,
                        implementationOwner: syntax, implementationRange: parameter.range,
                        nativeArrayStorage: parameter.nativeArrayStorage, nativeScalarStorage: parameter.nativeScalarStorage
                    )
                    parameterTypes.add(parameter.defaultValue &&
                        parameter.defaultValue.class.isOfType(PrimitiveLiteralSyntax.class) &&
                        ((PrimitiveLiteralSyntax)parameter.defaultValue).sourceValue == "null" &&
                        (parameterType.kind() == "array" || parameterType.kind() == "user-class" ||
                        parameterType.kind() == "generic-instance" || parameterType.kind() == "string" ||
                        parameterType.kind() == "object" || parameterType.kind() == "function")
                        ? NullableSemanticType(parameterType) : parameterType)
                    if (parameter.defaultValue) {
                        optionalStarted = true
                        optionalCount++
                    } else if (optionalStarted) {
                        throw Exception("Default constructor parameters must be trailing")
                    }
                }
                result.add(CallableSignature(
                    SymbolIdentity(constructorIdentity, "constructor"),
                    syntax.name,
                    CallableKind("constructor"),
                    parameterTypes,
                    type,
                    type,
                    optionalCount,
                    constructor.parameterValues().map({ _.name }),
                    ownerGenericDeclaration: classGeneric ? GenericDeclaration(typeIdentity, [classGeneric], type) : null
                ))
            }
        }
        return result
    }

    inheritedMethodSignatures(
        PrimitiveClassSyntax[] syntaxes,
        CallableSignature[] declared,
        SourceSnapshotIdentity snapshot
    ) -> CallableSignature[] {
        let result = CallableSignature[]
        for (syntax in syntaxes) {
            if (!syntax.parentName) continue
            let ownerIdentity = DeclarationIdentity(
                SyntaxIslandIdentity(
                    snapshot ?: syntax.range.snapshot,
                    "class", syntax.range.startTokenIndex
                ),
                "class", syntax.name
            )
            let owner = UserClassSemanticType(ownerIdentity)
            var String parentName = syntax.parentName
            let visited = String[]
            while (parentName && !visited.contains(parentName)) {
                visited.add(parentName)
                let parent = syntaxes.firstOrNull({ _.name == parentName })
                if (!parent) break
                for (candidate in declared.filter((signature) =>
                    signature.callableKind.value == "instance-method" &&
                    signature.ownerType.declarationIdentity.name == parentName
                )) {
                    let overridden = declared.any((signature) =>
                        signature.callableKind.value == "instance-method" &&
                        signature.ownerType.value() == owner.value() &&
                        signature.name == candidate.name &&
                        sameTypes(signature.parameterTypes(), candidate.parameterTypes())
                    )
                    if (!overridden && result.none((signature) =>
                        signature.ownerType.value() == owner.value() &&
                        signature.name == candidate.name &&
                        sameTypes(signature.parameterTypes(), candidate.parameterTypes())
                    )) {
                        result.add(CallableSignature(
                            candidate.identity, candidate.name, candidate.callableKind,
                            candidate.parameterTypes(), candidate.returnType, owner,
                            candidate.optionalParameterCount, candidate.parameterNames(), candidate.genericParameters(),
                            candidate.ownerGenericDeclaration, candidate.ownerInstance,
                            candidate.asyncFunction, candidate.externalName, candidate.dispatchIdentity
                        ))
                    }
                }
                parentName = parent.parentName
            }
        }
        return result
    }

    sameTypes(SemanticType[] left, SemanticType[] right) -> Bool {
        if (left.count != right.count) return false
        var Int index
        while (index < left.count) {
            if (left[index].value() != right[index].value()) return false
            index++
        }
        return true
    }

    arrayAccessorSignatures(
        PrimitiveClassSyntax[] syntaxes,
        SourceSnapshotIdentity snapshot
    ) -> CallableSignature[] {
        let result = CallableSignature[]
        for (syntax in syntaxes) {
            if (syntax.arrayOverrideValues().isEmpty) continue
            let override = syntax.arrayOverrideValues().first
            let syntaxSnapshot = snapshot ?: syntax.range.snapshot
            let ownerIdentity = DeclarationIdentity(
                SyntaxIslandIdentity(syntaxSnapshot, "class", syntax.range.startTokenIndex),
                "class", syntax.name
            )
            let owner = UserClassSemanticType(ownerIdentity)
            let classGeneric = syntax.genericParameterName ? GenericParameterSemanticType(
                ownerIdentity, syntax.genericParameterName, 0
            ) : null
            let ownerGenerics = classGeneric ? GenericDeclaration(
                ownerIdentity, [classGeneric], owner
            ) : null
            let indexType = signatureType(
                override.indexParameter.typeName, syntaxes, snapshot
            )
            var SemanticType elementType = override.elementTypeName == "inferred"
                ? SemanticTypes.unknownType()
                : signatureType(override.elementTypeName, syntaxes, snapshot, classGeneric)
            if (override.elementTypeName == "inferred" && override.getterValues().count == 1) {
                let statement = override.getterValues().first
                if (statement.class.isOfType(PrimitiveReturnSyntax.class)) {
                    let returned = (PrimitiveReturnSyntax)statement
                    if (returned.value && returned.value.class.isOfType(PrimitiveArrayAccessSyntax.class)) {
                        let access = (PrimitiveArrayAccessSyntax)returned.value
                        if (access.receiver.class.isOfType(PrimitiveReferenceSyntax.class)) {
                            let reference = (PrimitiveReferenceSyntax)access.receiver
                            let field = syntax.fieldValues().firstOrNull({ _.name == reference.name })
                            if (field) {
                                let storage = signatureType(field.typeName, syntaxes, snapshot,
                                    classGeneric, nativeArrayStorage: field.nativeArrayStorage, nativeScalarStorage: field.nativeScalarStorage)
                                if (storage.kind() == "array") {
                                    let array = (ArraySemanticType)storage
                                    elementType = array.elementType
                                }
                            }
                        }
                    }
                }
            }
            if (override.getterValues().isNotEmpty) {
                let identity = DeclarationIdentity(
                    SyntaxIslandIdentity(
                        override.range.snapshot, "array-getter", override.range.startTokenIndex
                    ),
                    "array-getter", "getAt"
                )
                result.add(CallableSignature(
                    SymbolIdentity(identity, "array-getter"), "getAt",
                    CallableKind("instance-method"), [indexType], elementType, owner,
                    ownerGenericDeclaration: ownerGenerics
                ))
            }
            if (override.setterValues().isNotEmpty) {
                let identity = DeclarationIdentity(
                    SyntaxIslandIdentity(
                        override.range.snapshot, "array-setter", override.range.startTokenIndex
                    ),
                    "array-setter", "setAt"
                )
                result.add(CallableSignature(
                    SymbolIdentity(identity, "array-setter"), "setAt",
                    CallableKind("instance-method"), [indexType, elementType],
                    SemanticTypes.unitType(), owner, ownerGenericDeclaration: ownerGenerics
                ))
            }
        }
        return result
    }

    fieldUnits(
        PrimitiveClassSyntax[] syntaxes,
        SourceSnapshotIdentity snapshot
    ) -> BoundFieldUnit[] {
        let result = BoundFieldUnit[]
        for (syntax in syntaxes) {
            let syntaxSnapshot = snapshot ?: syntax.range.snapshot
            let ownerIdentity = DeclarationIdentity(
                SyntaxIslandIdentity(syntaxSnapshot, "class", syntax.range.startTokenIndex),
                "class", syntax.name
            )
            let classGeneric = syntax.genericParameterName ? GenericParameterSemanticType(
                ownerIdentity, syntax.genericParameterName, 0
            ) : null
            var Int ordinal
            for (field in syntax.fieldValues()) {
                let fieldRange = SourceRange(
                    syntaxSnapshot, field.range.startTokenIndex, field.range.endTokenIndex,
                    field.range.start, field.range.end
                )
                result.add(BoundFieldUnit(
                    field.name, SymbolIdentity(ownerIdentity, "field", ordinal),
                    signatureType(field.typeName, syntaxes, snapshot, classGeneric,
                        implementationOwner: syntax, implementationRange: field.range,
                        nativeArrayStorage: field.nativeArrayStorage, nativeScalarStorage: field.nativeScalarStorage), fieldRange,
                    field.visibleField, staticField: field.staticField,
                    mutableField: field.mutableField, nativeArrayStorage: field.nativeArrayStorage
                ))
                ordinal++
            }
            let constructorFields = PrimitiveFunctionParameterSyntax[]
            for (constructor in syntax.constructorValues()) {
                for (parameter in constructor.parameterValues().filter((value) =>
                    value.visibleParameter || value.privateParameter
                )) {
                    if (constructorFields.none({ _.name == parameter.name })) {
                        constructorFields.add(parameter)
                    }
                }
            }
            for (parameter in constructorFields) {
                if (syntax.fieldValues().any({ _.name == parameter.name })) continue
                let parameterRange = SourceRange(
                    syntaxSnapshot, parameter.range.startTokenIndex, parameter.range.endTokenIndex,
                    parameter.range.start, parameter.range.end
                )
                let parameterType = signatureType(parameter.typeName, syntaxes, snapshot,
                    classGeneric, implementationOwner: syntax, implementationRange: parameter.range,
                    nativeArrayStorage: parameter.nativeArrayStorage, nativeScalarStorage: parameter.nativeScalarStorage)
                let nullableDefault = parameter.defaultValue &&
                    parameter.defaultValue.class.isOfType(PrimitiveLiteralSyntax.class) &&
                    ((PrimitiveLiteralSyntax)parameter.defaultValue).sourceValue == "null"
                result.add(BoundFieldUnit(
                    parameter.name, SymbolIdentity(ownerIdentity, "field", ordinal),
                    nullableDefault && (parameterType.kind() == "array" ||
                        parameterType.kind() == "user-class" || parameterType.kind() == "generic-instance" ||
                        parameterType.kind() == "string" || parameterType.kind() == "object" ||
                        parameterType.kind() == "function")
                        ? NullableSemanticType(parameterType) : parameterType, parameterRange,
                    parameter.visibleParameter, nativeArrayStorage: parameter.nativeArrayStorage                ))
                ordinal++
            }
        }
        return result
    }

    signatureType(
        String name,
        PrimitiveClassSyntax[] syntaxes,
        SourceSnapshotIdentity snapshot,
        GenericParameterSemanticType classGeneric = null,
        GenericParameterSemanticType[] methodGenerics = GenericParameterSemanticType[],
        PrimitiveClassSyntax implementationOwner = null,
        SourceRange implementationRange = null,
        Bool nativeArrayStorage = false,
        Bool nativeScalarStorage = false
    ) -> SemanticType {
        if (nativeScalarStorage && name == "String") return SemanticTypes.stringType()
        var String normalized = name
        while (normalized.startsWith("native")) {
            normalized = normalized.substring("native".count)
            if (normalized.startsWith("_array")) {
                normalized = normalized.substring("_array".count)
            }
        }
        let resolver = PrimitiveStructuralTypeResolver(
            syntaxes: syntaxes, snapshot: snapshot,
            genericParameter: classGeneric, methodGenericParameters: methodGenerics,
            interfaces: interfaces, implementationOwner: implementationOwner,
            implementationRange: implementationRange,
            declarationContext: signatureContext && implementationRange ?
                signatureContext.scopeForSnapshot(implementationRange.snapshot) : signatureContext,
            lookupRange: implementationRange ?: signatureLookupRange
        )
        return nativeArrayStorage ? resolver.resolveNativeArrayStorage(normalized) : resolver.resolve(normalized)
    }
}
