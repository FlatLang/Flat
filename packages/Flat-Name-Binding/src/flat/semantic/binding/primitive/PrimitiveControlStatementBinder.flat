package flat/semantic/binding/primitive

import flat/compiler/models
import flat/parser/flat
import flat/bound
import flat/semantic/types

/** Recursively binds structured control syntax with branch-local lexical scopes. */
class {
    public bind(
        PrimitiveStatementSyntaxResult syntax,
        SourceSnapshotIdentity snapshot,
        LocalBinding[] locals = LocalBinding[],
        CallableSignature[] callables = CallableSignature[]
    ) -> PrimitiveStatementBindingResult {
        if (!syntax || !snapshot || !locals || !callables) {
            throw Exception("Primitive control binding requires syntax snapshot, locals, and callables")
        }
        let bound = bindStatements(syntax.statements(), snapshot, locals, callables)
        return PrimitiveStatementBindingResult(bound, locals)
    }

    bindStatements(
        PrimitiveStatementSyntax[] statements,
        SourceSnapshotIdentity snapshot,
        LocalBinding[] parentLocals,
        CallableSignature[] callables
    ) -> BoundStatement[] {
        let result = BoundStatement[]
        var LocalBinding[] scopeLocals = LocalBinding[]
        scopeLocals.addAll(parentLocals)
        for (statement in statements) {
            if (statement.class.isOfType(PrimitiveExternalStatementSyntax.class)) {
                let value = (PrimitiveExternalStatementSyntax)statement
                if (value.target != "js") {
                    throw Exception("External block is unavailable for selected target")
                }
                result.add(BoundExternalStatement(value.range, "es6", value.code))
            } else if (statement.class.isOfType(PrimitiveIfSyntax.class)) {
                let value = (PrimitiveIfSyntax)statement
                let condition = bindCondition(value.condition, scopeLocals, callables)
                result.add(BoundIfStatement(
                    value.range,
                    condition,
                    bindStatements(value.thenValues(), snapshot, scopeLocals, callables),
                    bindStatements(value.elseValues(), snapshot, scopeLocals, callables)
                ))
            } else if (statement.class.isOfType(PrimitiveWhileSyntax.class)) {
                let value = (PrimitiveWhileSyntax)statement
                let condition = bindCondition(value.condition, scopeLocals, callables)
                result.add(BoundWhileStatement(
                    value.range,
                    condition,
                    bindStatements(value.bodyValues(), snapshot, scopeLocals, callables)
                ))
            } else if (statement.class.isOfType(PrimitiveTrySyntax.class)) {
                let value = (PrimitiveTrySyntax)statement
                if (value.catchValues().count > 1) {
                    throw Exception("Reduced exception binding supports one catch clause")
                }
                let catches = BoundCatchClause[]
                var Int catchIndex
                while (catchIndex < value.catchValues().count) {
                    let caught = value.catchValues()[catchIndex]
                    let catchType = exceptionType(caught.typeName)
                    let identity = SymbolIdentity(
                        DeclarationIdentity(
                            SyntaxIslandIdentity(snapshot, "catch", caught.range.startTokenIndex),
                            "catch", caught.name
                        ),
                        "catch"
                    )
                    let local = BoundReferenceExpression(
                        caught.range, catchType, caught.name, identity
                    )
                    let catchLocals = LocalBinding[]
                    catchLocals.addAll(scopeLocals)
                    catchLocals.add(LocalBinding(caught.name, identity, catchType))
                    catches.add(BoundCatchClause(
                        caught.range, local,
                        bindStatements(caught.statements(), snapshot, catchLocals, callables)
                    ))
                    catchIndex++
                }
                result.add(BoundTryStatement(
                    value.range,
                    bindStatements(value.tryValues(), snapshot, scopeLocals, callables),
                    catches,
                    bindStatements(value.finallyValues(), snapshot, scopeLocals, callables)
                ))
            } else if (statement.class.isOfType(PrimitiveThrowSyntax.class)) {
                let value = (PrimitiveThrowSyntax)statement
                let expression = PrimitiveExpressionBinder().bind(
                    value.value, locals: scopeLocals, callables: callables
                )
                if (!expression.succeeded) throw Exception(expression.diagnostic.message)
                result.add(BoundThrowStatement(value.range, expression.expression))
            } else {
                let simple = PrimitiveStatementSyntaxResult([statement])
                let bound = PrimitiveStatementBinder().bind(
                    simple, snapshot, scopeLocals, callables
                )
                result.addAll(bound.statements())
                scopeLocals = bound.locals()
            }
        }
        return result
    }

    exceptionType(String name) -> SemanticType {
        if (name == "String") return SemanticTypes.stringType()
        if (name == "Object" || name == "Exception") return SemanticTypes.objectType()
        throw Exception("Catch type '#name' is not throwable")
    }

    bindCondition(
        PrimitiveExpressionSyntax syntax,
        LocalBinding[] locals,
        CallableSignature[] callables
    ) -> BoundExpression {
        let result = PrimitiveExpressionBinder().bind(
            syntax, SemanticTypes.boolType(), locals, callables
        )
        if (!result.succeeded) throw Exception(result.diagnostic.message)
        return result.expression
    }
}
