package flat/semantic/binding/primitive

import flat/compiler/models
import flat/parser/flat
import flat/bound
import flat/semantic/types

/** Recursively binds structured control syntax with branch-local lexical scopes. */
class {
    var PrimitiveExpressionBinder currentExpressions
    var TypeHierarchyComponent currentHierarchy
    var PrimitiveStructuralTypeResolver currentTypeResolver
    var CallableSignature currentArrayGetter
    var CallableSignature currentArraySetter
    var BoundFieldUnit[] currentAvailableFields

    /** Lexical target check before publishing bound statements; nested loops reset cleanup depth. */
    public controlDiagnostic(PrimitiveStatementSyntax[] statements, Bool foreachTarget = false,
        Int cleanupDepth = 0) -> PrimitiveExpressionDiagnostic {
        for (statement in statements) {
            if (statement.class.isOfType(PrimitiveContinueSyntax.class) && foreachTarget && cleanupDepth > 0) {
                return PrimitiveExpressionDiagnostic("semantic.cleanup-crossing-continue",
                    "Foreach continue through try/catch/finally is not supported", statement.range)
            }
            var PrimitiveExpressionDiagnostic diagnostic
            if (statement.class.isOfType(PrimitiveForEachSyntax.class)) {
                diagnostic = controlDiagnostic(((PrimitiveForEachSyntax)statement).bodyValues(), true, 0)
            } else if (statement.class.isOfType(PrimitiveWhileSyntax.class)) {
                diagnostic = controlDiagnostic(((PrimitiveWhileSyntax)statement).bodyValues(), false, 0)
            } else if (statement.class.isOfType(PrimitiveForSyntax.class)) {
                diagnostic = controlDiagnostic(((PrimitiveForSyntax)statement).bodyValues(), false, 0)
            } else if (statement.class.isOfType(PrimitiveIfSyntax.class)) {
                let branch = (PrimitiveIfSyntax)statement
                diagnostic = controlDiagnostic(branch.thenValues(), foreachTarget, cleanupDepth)
                if (!diagnostic) diagnostic = controlDiagnostic(branch.elseValues(), foreachTarget, cleanupDepth)
            } else if (statement.class.isOfType(PrimitiveSwitchSyntax.class)) {
                for (branch in ((PrimitiveSwitchSyntax)statement).caseValues()) {
                    if (!diagnostic) diagnostic = controlDiagnostic(branch.statementValues(), foreachTarget, cleanupDepth)
                }
            } else if (statement.class.isOfType(PrimitiveTrySyntax.class)) {
                let guarded = (PrimitiveTrySyntax)statement
                diagnostic = controlDiagnostic(guarded.tryValues(), foreachTarget, cleanupDepth + 1)
                for (caught in guarded.catchValues()) {
                    if (!diagnostic) diagnostic = controlDiagnostic(caught.statements(), foreachTarget, cleanupDepth + 1)
                }
                if (!diagnostic) diagnostic = controlDiagnostic(guarded.finallyValues(), foreachTarget, cleanupDepth + 1)
            }
            if (diagnostic) return diagnostic
        }
        return null
    }

    public bind(
        PrimitiveStatementSyntaxResult syntax,
        SourceSnapshotIdentity snapshot,
        LocalBinding[] locals = LocalBinding[],
        CallableSignature[] callables = CallableSignature[],
        BoundReferenceExpression receiver = null,
        BoundFieldUnit[] fields = BoundFieldUnit[],
        CallableSignature arrayGetter = null,
        CallableSignature arraySetter = null,
        BoundFieldUnit[] availableFields = BoundFieldUnit[],
        PrimitiveStructuralTypeResolver typeResolver = null,
        TypeHierarchyComponent hierarchy = null,
        PrimitiveExpressionBinder expressionBinder = null
    ) -> PrimitiveStatementBindingResult {
        if (!syntax || !snapshot || !locals || !callables || !fields ||
            !availableFields || availableFields.any({ !_ })) {
            throw Exception("Primitive control binding requires syntax snapshot, locals, callables, and fields")
        }
        let diagnostic = controlDiagnostic(syntax.statements())
        if (diagnostic) throw Exception("#{diagnostic.code} at #{diagnostic.range.startTokenIndex}..#{diagnostic.range.endTokenIndex}: #{diagnostic.message}")
        currentExpressions = expressionBinder ?: PrimitiveExpressionBinder()
        currentHierarchy = hierarchy
        currentTypeResolver = typeResolver ?: PrimitiveStructuralTypeResolver(callables: callables)
        currentArrayGetter = arrayGetter
        currentArraySetter = arraySetter
        currentAvailableFields = BoundFieldUnit[]
        currentAvailableFields.addAll(availableFields)
        let bound = bindStatements(
            syntax.statements(), snapshot, locals, callables, receiver, fields
        )
        return PrimitiveStatementBindingResult(bound, locals)
    }

    bindStatements(
        PrimitiveStatementSyntax[] statements,
        SourceSnapshotIdentity snapshot,
        LocalBinding[] parentLocals,
        CallableSignature[] callables,
        BoundReferenceExpression receiver,
        BoundFieldUnit[] fields,
        Bool loopBody = false
    ) -> BoundStatement[] {
        let result = BoundStatement[]
        var LocalBinding[] scopeLocals = LocalBinding[]
        scopeLocals.addAll(parentLocals)
        for (statement in statements) {
            if (statement.class.isOfType(PrimitiveExternalStatementSyntax.class)) {
                let value = (PrimitiveExternalStatementSyntax)statement
                let binder = PrimitiveOpaqueCodeBinder()
                let opaque = binder.bind(
                    value, scopeLocals, receiver, fields, callables,
                    currentAvailableFields, currentTypeResolver, currentHierarchy
                )
                result.add(opaque)
            } else if (statement.class.isOfType(PrimitiveContinueSyntax.class)) {
                if (!loopBody) throw Exception("Continue requires an enclosing loop")
                result.add(BoundContinueStatement(statement.range))
            } else if (statement.class.isOfType(PrimitiveIfSyntax.class)) {
                let value = (PrimitiveIfSyntax)statement
                let conditionLocals = LocalBinding[]:addAll(scopeLocals)
                let condition = bindCondition(
                    value.condition, conditionLocals, callables, receiver, fields, result
                )
                if (condition.class.isOfType(BoundDeclarationValueExpression.class)) {
                    let declaration = (BoundDeclarationValueExpression)condition
                    result.add(BoundLocalDeclarationStatement(declaration.range, declaration.local))
                }
                result.add(BoundIfStatement(
                    value.range,
                    condition,
                    bindStatements(value.thenValues(), snapshot, conditionLocals, callables, receiver, fields, loopBody),
                    bindStatements(value.elseValues(), snapshot, conditionLocals, callables, receiver, fields, loopBody)
                ))
            } else if (statement.class.isOfType(PrimitiveSwitchSyntax.class)) {
                let value = (PrimitiveSwitchSyntax)statement
                let switchedExpression = classExpression(
                    value.value, receiver, fields, scopeLocals, callables
                )
                let cases = BoundSwitchCase[]
                for (caseValue in value.caseValues()) {
                    var BoundExpression label
                    if (!caseValue.defaultCase) {
                        let boundLabel = PrimitiveExpressionBinder().bind(
                            caseValue.label, requiredType: switchedExpression.semanticType,
                            locals: scopeLocals, callables: callables,
                            explicitConversion: true
                        )
                        if (!boundLabel.succeeded) throw Exception(boundLabel.diagnostic.message)
                        label = boundLabel.expression
                    }
                    cases.add(BoundSwitchCase(
                        caseValue.range, label,
                        bindStatements(
                            caseValue.statementValues(), snapshot, scopeLocals,
                            callables, receiver, fields, loopBody
                        ),
                        caseValue.defaultCase, caseValue.fallsThrough
                    ))
                }
                result.add(BoundSwitchStatement(value.range, switchedExpression, cases))
            } else if (statement.class.isOfType(PrimitiveForSyntax.class)) {
                let value = (PrimitiveForSyntax)statement
                if (scopeLocals.any({ _.name == value.initializer.name })) {
                    throw Exception("Duplicate for local '#{value.initializer.name}'")
                }
                let initialized = classExpression(
                    value.initializer.initializer, receiver, fields,
                    scopeLocals, callables
                )
                var SemanticType localType = initialized.semanticType
                if (value.initializer.declaredTypeName) {
                    localType = value.initializer.nativeScalarStorage && value.initializer.declaredTypeName == "String" ?
                        SemanticTypes.stringType() : value.initializer.nativeArrayStorage ?
                        currentTypeResolver.resolveNativeArrayStorage(value.initializer.declaredTypeName) :
                        loopLocalType(value.initializer.declaredTypeName)
                }
                var TypeConversion conversion = TypeConversions.classify(
                    initialized.semanticType, localType
                )
                if (!conversion.applicable && initialized.semanticType.kind() == "unknown") {
                    conversion = TypeConversion(
                        initialized.semanticType, localType,
                        "deferred-for-initializer", true, false, true, 1000
                    )
                }
                if (!conversion.applicable) throw Exception("For initializer type mismatch")
                let identity = SymbolIdentity(
                    DeclarationIdentity(
                        SyntaxIslandIdentity(snapshot, "for", value.range.startTokenIndex),
                        "for", value.initializer.name
                    ),
                    "local"
                )
                let local = BoundReferenceExpression(
                    value.initializer.range, localType, value.initializer.name, identity
                )
                let loopLocals = LocalBinding[]
                loopLocals.addAll(scopeLocals)
                loopLocals.add(LocalBinding(value.initializer.name, identity, localType))
                let condition = bindCondition(
                    value.condition, loopLocals, callables, receiver, fields
                )
                if (value.advance.name != value.initializer.name) {
                    throw Exception("For advance must assign the loop local")
                }
                var BoundExpression advanced = value.advance.assignmentOperator == "++" ||
                    value.advance.assignmentOperator == "--" ?
                    BoundLiteralExpression(value.advance.range, SemanticTypes.intType(), "1") :
                    classExpression(value.advance.value, receiver, fields, loopLocals, callables)
                if (value.advance.assignmentOperator != "=") {
                    let operator = binaryOperator(value.advance.assignmentOperator)
                    let operation = TypeOperations.binary(
                        operator, localType, advanced.semanticType, value.advance.range)
                    if (!operation.valid) throw Exception(operation.diagnostic.message)
                    advanced = BoundBinaryExpression(value.advance.range,
                        operation.semanticType, operator, local, advanced)
                }
                var TypeConversion advanceConversion = TypeConversions.classify(
                    advanced.semanticType, localType
                )
                if (!advanceConversion.applicable && advanced.semanticType.kind() == "unknown") {
                    advanceConversion = TypeConversion(
                        advanced.semanticType, localType,
                        "deferred-for-advance", true, false, true, 1000
                    )
                }
                if (!advanceConversion.applicable) throw Exception("For advance type mismatch")
                result.add(BoundForEachStatement(
                    value.range,
                    [BoundLocalDeclarationStatement(
                        value.initializer.range, local, initialized, conversion
                    )],
                    condition,
                    bindStatements(
                        value.bodyValues(), snapshot, loopLocals, callables, receiver, fields, true
                    ),
                    [BoundAssignmentStatement(
                        value.advance.range, local, advanced, advanceConversion
                    )],
                    "for:#{snapshot.value}:#{value.range.startTokenIndex}",
                    "for-exit:#{snapshot.value}:#{value.range.startTokenIndex}"
                ))
            } else if (statement.class.isOfType(PrimitiveForEachSyntax.class)) {
                let value = (PrimitiveForEachSyntax)statement
                if (scopeLocals.any({ _.name == value.indexName })) {
                    throw Exception("Duplicate foreach iterator '#{value.indexName}'")
                }
                if (value.collectionLoop()) {
                    let collectionExpression = classExpression(
                        value.collection, receiver, fields, scopeLocals, callables
                    )
                    if (collectionExpression.semanticType.kind() != "array") {
                        let acquired = protocolProperty(collectionExpression, "iterator", value.range, callables)
                        let storageIdentity = SymbolIdentity(DeclarationIdentity(
                            SyntaxIslandIdentity(snapshot, "foreach-iterator", value.range.startTokenIndex),
                            "foreach-iterator", value.indexName), "local")
                        let storage = BoundReferenceExpression(value.range, acquired.semanticType,
                            "#{value.indexName}Iterator", storageIdentity)
                        let condition = protocolProperty(storage, "hasNext", value.range, callables)
                        if (condition.semanticType.value() != SemanticTypes.boolType().value())
                            throw Exception("Iterator hasNext must return Bool")
                        let next = protocolProperty(storage, "stepNext", value.range, callables)
                        let itemIdentity = SymbolIdentity(DeclarationIdentity(
                            SyntaxIslandIdentity(snapshot, "foreach", value.range.startTokenIndex),
                            "foreach", value.indexName), "local")
                        let item = BoundReferenceExpression(value.range, next.semanticType, value.indexName, itemIdentity)
                        let loopLocals = LocalBinding[]:addAll(scopeLocals)
                        loopLocals.add(LocalBinding(value.indexName, itemIdentity, next.semanticType))
                        let body = BoundStatement[]
                        body.add(BoundLocalDeclarationStatement(value.range, item, next,
                            TypeConversions.classify(next.semanticType, next.semanticType)))
                        body.addAll(bindStatements(value.bodyValues(), snapshot, loopLocals, callables, receiver, fields, true))
                        result.add(BoundForEachStatement(value.range,
                            [BoundLocalDeclarationStatement(value.range, storage, acquired,
                                TypeConversions.classify(acquired.semanticType, acquired.semanticType))],
                            condition, body, BoundStatement[],
                            "foreach:#{snapshot.value}:#{value.range.startTokenIndex}",
                            "foreach-exit:#{snapshot.value}:#{value.range.startTokenIndex}"))
                        continue
                    }
                    let elementType = collectionElementType(collectionExpression.semanticType)
                    let identity = SymbolIdentity(
                        DeclarationIdentity(
                            SyntaxIslandIdentity(snapshot, "foreach", value.range.startTokenIndex),
                            "foreach", value.indexName
                        ),
                        "local"
                    )
                    var BoundReferenceExpression iterator
                    iterator = BoundReferenceExpression(
                        value.range, elementType, value.indexName, identity
                    )
                    let storageIdentity = SymbolIdentity(
                        DeclarationIdentity(
                            SyntaxIslandIdentity(snapshot, "foreach", value.range.startTokenIndex),
                            "foreach-storage", value.indexName
                        ),
                        "local"
                    )
                    var BoundReferenceExpression storage
                    storage = BoundReferenceExpression(
                        value.range, collectionExpression.semanticType, value.indexName + "Collection", storageIdentity
                    )
                    let indexIdentity = SymbolIdentity(
                        DeclarationIdentity(
                            SyntaxIslandIdentity(snapshot, "foreach", value.range.startTokenIndex),
                            "foreach-index", value.indexName
                        ),
                        "local"
                    )
                    let indexLocal = BoundReferenceExpression(
                        value.range, SemanticTypes.intType(), value.indexName + "Index", indexIdentity
                    )
                    let loopLocals = LocalBinding[]
                    loopLocals.addAll(scopeLocals)
                    loopLocals.add(LocalBinding(value.indexName, identity, elementType))
                    let zero = BoundLiteralExpression(value.range, SemanticTypes.intType(), "0")
                    let one = BoundLiteralExpression(value.range, SemanticTypes.intType(), "1")
                    var BoundLocalDeclarationStatement iteratorDeclaration
                    iteratorDeclaration = BoundLocalDeclarationStatement(
                        value.range, iterator,
                        BoundArrayAccessExpression(
                            value.range, elementType, storage, indexLocal
                        ),
                        TypeConversions.classify(elementType, elementType)
                    )
                    let body = BoundStatement[]
                    body.add(iteratorDeclaration)
                    body.addAll(bindStatements(
                        value.bodyValues(), snapshot, loopLocals, callables, receiver, fields, true
                    ))
                    let advanceValue = BoundBinaryExpression(
                        value.range, SemanticTypes.intType(), "+", indexLocal, one
                    )
                    result.add(BoundForEachStatement(
                        value.range,
                        [
                            BoundLocalDeclarationStatement(
                                value.range, storage, collectionExpression,
                                TypeConversions.classify(
                                    collectionExpression.semanticType, collectionExpression.semanticType
                                )
                            ),
                            BoundLocalDeclarationStatement(
                                value.range, indexLocal, zero,
                                TypeConversions.classify(
                                    zero.semanticType, SemanticTypes.intType()
                                )
                            )
                        ],
                        BoundBinaryExpression(
                            value.range, SemanticTypes.boolType(), "<", indexLocal,
                            BoundArrayLengthExpression(value.range, storage)
                        ),
                        body,
                        [BoundAssignmentStatement(
                            value.range, indexLocal, advanceValue,
                            TypeConversions.classify(
                                advanceValue.semanticType, SemanticTypes.intType()
                            )
                        )],
                        "foreach:#{snapshot.value}:#{value.range.startTokenIndex}",
                        "foreach-exit:#{snapshot.value}:#{value.range.startTokenIndex}"
                    ))
                    continue
                }
                let startExpression = classExpression(
                    value.rangeStart, receiver, fields, scopeLocals, callables
                )
                let endExpression = classExpression(
                    value.rangeEnd, receiver, fields, scopeLocals, callables
                )
                if (startExpression.semanticType.value() != SemanticTypes.intType().value() ||
                    endExpression.semanticType.value() != SemanticTypes.intType().value()) {
                    throw Exception("Foreach range bounds require Int")
                }
                let identity = SymbolIdentity(
                    DeclarationIdentity(
                        SyntaxIslandIdentity(snapshot, "foreach", value.range.startTokenIndex),
                        "foreach", value.indexName
                    ),
                    "local"
                )
                let indexLocal = BoundReferenceExpression(
                    value.range, SemanticTypes.intType(), value.indexName, identity
                )
                let loopLocals = LocalBinding[]
                loopLocals.addAll(scopeLocals)
                loopLocals.add(LocalBinding(value.indexName, identity, SemanticTypes.intType()))
                let one = BoundLiteralExpression(
                    value.range, SemanticTypes.intType(), "1"
                )
                let advanceValue = BoundBinaryExpression(
                    value.range, SemanticTypes.intType(), "+", indexLocal, one
                )
                result.add(BoundForEachStatement(
                    value.range,
                    [BoundLocalDeclarationStatement(
                        value.range, indexLocal, startExpression,
                        TypeConversions.classify(
                            startExpression.semanticType, SemanticTypes.intType()
                        )
                    )],
                    BoundBinaryExpression(
                        value.range, SemanticTypes.boolType(), "<", indexLocal, endExpression
                    ),
                    bindStatements(
                        value.bodyValues(), snapshot, loopLocals, callables, receiver, fields, true
                    ),
                    [BoundAssignmentStatement(
                        value.range, indexLocal, advanceValue,
                        TypeConversions.classify(
                            advanceValue.semanticType, SemanticTypes.intType()
                        )
                    )],
                    "foreach:#{snapshot.value}:#{value.range.startTokenIndex}",
                    "foreach-exit:#{snapshot.value}:#{value.range.startTokenIndex}"
                ))
            } else if (statement.class.isOfType(PrimitiveWhileSyntax.class)) {
                let value = (PrimitiveWhileSyntax)statement
                let condition = bindCondition(
                    value.condition, scopeLocals, callables, receiver, fields
                )
                result.add(BoundWhileStatement(
                    value.range,
                    condition,
                    bindStatements(value.bodyValues(), snapshot, scopeLocals, callables, receiver, fields, true)
                ))
            } else if (statement.class.isOfType(PrimitiveTrySyntax.class)) {
                let value = (PrimitiveTrySyntax)statement
                if (value.catchValues().count > 1) {
                    throw Exception("Reduced exception binding supports one catch clause")
                }
                let catches = BoundCatchClause[]
                var Int catchIndex
                while (catchIndex < value.catchValues().count) {
                    let caught = value.catchValues()[catchIndex]
                    let catchType = exceptionType(caught.typeName, callables)
                    let identity = SymbolIdentity(
                        DeclarationIdentity(
                            SyntaxIslandIdentity(snapshot, "catch", caught.range.startTokenIndex),
                            "catch", caught.name
                        ),
                        "catch"
                    )
                    let local = BoundReferenceExpression(
                        caught.range, catchType, caught.name, identity
                    )
                    let catchLocals = LocalBinding[]
                    catchLocals.addAll(scopeLocals)
                    catchLocals.add(LocalBinding(caught.name, identity, catchType))
                    catches.add(BoundCatchClause(
                        caught.range, local,
                        bindStatements(caught.statements(), snapshot, catchLocals, callables, receiver, fields, loopBody),
                        acceptsSoftExceptions: caught.acceptsSoftExceptions
                    ))
                    catchIndex++
                }
                result.add(BoundTryStatement(
                    value.range,
                    bindStatements(value.tryValues(), snapshot, scopeLocals, callables, receiver, fields, loopBody),
                    catches,
                    bindStatements(value.finallyValues(), snapshot, scopeLocals, callables, receiver, fields, loopBody)
                ))
            } else if (statement.class.isOfType(PrimitiveThrowSyntax.class)) {
                let value = (PrimitiveThrowSyntax)statement
                let expression = classExpression(
                    value.value, receiver, fields, scopeLocals, callables
                )
                result.add(BoundThrowStatement(value.range, expression))
            } else if (statement.class.isOfType(PrimitiveArrayAssignmentSyntax.class)) {
                let value = (PrimitiveArrayAssignmentSyntax)statement
                let target = classExpression(
                    value.target, receiver, fields, scopeLocals, callables
                )
                let expressionValue = classExpression(
                    value.value, receiver, fields, scopeLocals, callables
                )
                if (target.class.isOfType(BoundCallExpression.class)) {
                    let getterCall = (BoundCallExpression)target
                    let indexedType = getterCall.receiver.semanticType
                    let indexedOwner = indexedType.kind() == "generic-instance"
                        ? ((GenericInstanceSemanticType)indexedType).declarationType.value()
                        : indexedType.value()
                    var CallableSignature setter = currentArraySetter
                    if (!setter || setter.ownerType.value() != indexedOwner) {
                        setter = callables.firstOrNull((candidate) =>
                            candidate.identity.symbolKind == "array-setter" &&
                            candidate.ownerType.value() == indexedOwner
                        )
                    }
                    if (!setter || !getterCall.receiver) {
                        throw Exception("Indexed receiver does not declare a setter")
                    }
                    var BoundExpression expression = expressionValue
                    if (value.assignmentOperator != "=") {
                        let operation = TypeOperations.binary(
                            binaryOperator(value.assignmentOperator),
                            getterCall.semanticType, expression.semanticType, value.range
                        )
                        if (!operation.valid) throw Exception(operation.diagnostic.message)
                        expression = BoundBinaryExpression(
                            value.range, operation.semanticType,
                            binaryOperator(value.assignmentOperator), getterCall, expression
                        )
                    }
                    let checked = CallTypeChecker.check(
                        setter, getterCall.receiver.semanticType,
                        [getterCall.argumentValues().first.semanticType, expression.semanticType],
                        value.range
                    )
                    if (!checked.valid) throw Exception(checked.diagnostic.message)
                    let selected = indexedType.kind() == "generic-instance" &&
                        setter.ownerGenericDeclaration ? setter.instantiateReceiver(
                            (GenericInstanceSemanticType)indexedType
                        ) : setter
                    result.add(BoundExpressionStatement(
                        value.range, BoundCallExpression(
                            value.range, checked.semanticType, selected,
                            getterCall.receiver,
                            [getterCall.argumentValues().first, expression],
                            checked.argumentConversions()
                        )
                    ))
                    continue
                }
                let targetExpression = (BoundArrayAccessExpression)target
                if (value.assignmentOperator == "=" && expressionValue.semanticType.kind() == "null") {
                    let storage = nativeStorageIdentity(targetExpression.receiver, scopeLocals, fields)
                    if (storage) {
                        result.add(BoundNativeArrayClearStatement(value.range, BoundArrayAccessExpression(
                            targetExpression.range, targetExpression.semanticType,
                            targetExpression.receiver, targetExpression.index,
                            nativeStorageDeclaration: storage)))
                        continue
                    }
                }
                var BoundExpression expression = expressionValue
                if (value.assignmentOperator != "=") {
                    expression = BoundBinaryExpression(
                        value.range, targetExpression.semanticType,
                        binaryOperator(value.assignmentOperator), targetExpression, expression
                    )
                }
                let conversion = TypeConversions.classify(
                    expression.semanticType, targetExpression.semanticType,
                    explicit: value.assignmentOperator != "="
                )
                if (!conversion.applicable) throw Exception("Array assignment type mismatch")
                result.add(BoundArrayAssignmentStatement(
                    value.range, targetExpression, expression, conversion
                ))
            } else if (statement.class.isOfType(PrimitiveMemberAssignmentSyntax.class)) {
                let value = (PrimitiveMemberAssignmentSyntax)statement
                var BoundExpression targetObject
                if (value.target.receiver.class.isOfType(PrimitiveReferenceSyntax.class) &&
                    ((PrimitiveReferenceSyntax)value.target.receiver).name == "this") {
                    if (!receiver) throw Exception("Member assignment requires an instance receiver")
                    targetObject = member(value.target, receiver, fields)
                } else {
                    targetObject = classExpression(value.target, receiver, fields, scopeLocals, callables)
                }
                if (!targetObject.class.isOfType(BoundMemberAccessExpression.class)) {
                    throw Exception("Member assignment requires a stored field")
                }
                let target = (BoundMemberAccessExpression)targetObject
                if (target.safeAccess) throw Exception("Safe member assignment is not supported")
                let operand = classExpression(
                    value.value, receiver, fields, scopeLocals, callables
                )
                var BoundExpression expression = operand
                if (value.assignmentOperator != "=") {
                    let operator = binaryOperator(value.assignmentOperator)
                    let operation = TypeOperations.binary(
                        operator, target.semanticType, expression.semanticType, value.range
                    )
                    if (!operation.valid) throw Exception(operation.diagnostic.message)
                    let storage = TypeConversions.classify(operation.semanticType, target.semanticType)
                    if (storage.applicable && operation.semanticType.value() == target.semanticType.value()) {
                        result.add(BoundExpressionStatement(value.range,
                            BoundMemberAssignmentValueExpression(value.range, operation.semanticType,
                                target, operator, operand, storage)))
                        continue
                    }
                    let narrowed = TypeConversions.classify(operation.semanticType, target.semanticType, explicit: true)
                    if (!narrowed.applicable) throw Exception("Member assignment type mismatch")
                    result.add(BoundMemberAssignmentStatement(value.range, target, operand, narrowed, operator))
                    continue
                }
                let conversion = TypeConversions.classify(
                    expression.semanticType, target.semanticType,
                    explicit: value.assignmentOperator != "="
                )
                if (!conversion.applicable) throw Exception("Member assignment type mismatch")
                result.add(BoundMemberAssignmentStatement(
                    value.range, target, expression, conversion
                ))
            } else if (statement.class.isOfType(PrimitiveAssignmentSyntax.class)) {
                let value = (PrimitiveAssignmentSyntax)statement
                let local = scopeLocals.reverse().firstOrNull({ _.name == value.name })
                if (!local || local.identity.symbolKind == "field") {
                    if (!receiver) throw Exception("Field assignment requires an instance receiver")
                    var BoundFieldUnit field = fields.firstOrNull({ _.name == value.name })
                    if (!field) field = currentAvailableFields.firstOrNull({
                        _.name == value.name
                    })
                    if (!field) throw Exception("Unknown local '#{value.name}'")
                    let target = BoundMemberAccessExpression(
                        value.range, field.semanticType, receiver, field.name, field.identity
                    )
                    var BoundExpression expression = classExpression(
                        value.value, receiver, fields, scopeLocals, callables
                    )
                    if (value.assignmentOperator != "=") {
                        let operator = binaryOperator(value.assignmentOperator)
                        let operation = TypeOperations.binary(
                            operator, target.semanticType, expression.semanticType, value.range
                        )
                        if (!operation.valid) throw Exception(operation.diagnostic.message)
                        expression = BoundBinaryExpression(
                            value.range, operation.semanticType, operator, target, expression
                        )
                    }
                    let conversion = TypeConversions.classify(
                        expression.semanticType, target.semanticType,
                        explicit: value.assignmentOperator != "="
                    )
                    if (!conversion.applicable) throw Exception("Field assignment type mismatch")
                    result.add(BoundMemberAssignmentStatement(
                        value.range, target, expression, conversion
                    ))
                } else if (value.assignmentOperator == "=") {
                    let target = BoundReferenceExpression(
                        value.range, local.semanticType, local.name, local.identity
                    )
                    var BoundExpression expression = classExpression(
                        value.value, receiver, fields, scopeLocals, callables
                    )
                    var TypeConversion conversion = TypeConversions.classify(
                        expression.semanticType, target.semanticType
                    )
                    let declaredStringAssignment = receiver &&
                        target.semanticType.value() == receiver.semanticType.value() &&
                        expression.semanticType.value() == SemanticTypes.stringType().value() &&
                        callables.any((candidate) =>
                            candidate.ownerType &&
                            candidate.ownerType.value() == receiver.semanticType.value() &&
                            candidate.ownerType.declarationIdentity.name == "String"
                        )
                    if (!conversion.applicable && declaredStringAssignment) {
                        expression = PrimitiveStringAdapter.wrap(expression, target.semanticType,
                            currentTypeResolver.declarationContext, callables)
                        conversion = TypeConversions.classify(expression.semanticType, target.semanticType)
                    }
                    if (!conversion.applicable) throw Exception("Assignment value type mismatch")
                    result.add(BoundAssignmentStatement(
                        value.range, target, expression, conversion
                    ))
                } else {
                    let target = BoundReferenceExpression(value.range, local.semanticType, local.name, local.identity)
                    let operand = classExpression(value.value, receiver, fields, scopeLocals, callables)
                    let operator = binaryOperator(value.assignmentOperator)
                    let operation = TypeOperations.binary(operator, target.semanticType, operand.semanticType, value.range)
                    if (!operation.valid) throw Exception(operation.diagnostic.message)
                    let expression = BoundBinaryExpression(value.range, operation.semanticType, operator, target, operand)
                    let conversion = TypeConversions.classify(expression.semanticType, target.semanticType, explicit: true)
                    if (!conversion.applicable) throw Exception("Compound assignment value type mismatch")
                    result.add(BoundAssignmentStatement(value.range, target, expression, conversion))
                }
            } else if (statement.class.isOfType(PrimitiveLocalDeclarationSyntax.class)) {
                let value = (PrimitiveLocalDeclarationSyntax)statement
                let existing = scopeLocals.reverse().firstOrNull({ _.name == value.name })
                if (existing && existing.identity.symbolKind != "field") {
                    throw Exception("Duplicate local '#{value.name}'")
                }
                var SemanticType semanticType = value.declaredTypeName ?
                    (value.nativeScalarStorage && value.declaredTypeName == "String" ? SemanticTypes.stringType() :
                        value.nativeArrayStorage ? currentTypeResolver.resolveNativeArrayStorage(value.declaredTypeName) :
                        localType(value.declaredTypeName, callables, receiver)) :
                    SemanticTypes.unknownType()
                var BoundExpression initialized
                if (value.initializer) {
                    initialized = value.initializer.class.isOfType(PrimitiveEmptyArrayConstructionSyntax.class)
                        ? classExpression(value.initializer, receiver, fields, scopeLocals, callables)
                        : PrimitiveClassBinder().bindScopedExpression(
                        value.initializer, receiver, fields, scopeLocals, callables,
                        currentArrayGetter, currentArraySetter, currentTypeResolver, currentAvailableFields, currentHierarchy
                    )
                    if (!value.declaredTypeName) semanticType = initialized.semanticType
                }
                let identity = SymbolIdentity(
                    DeclarationIdentity(
                        SyntaxIslandIdentity(snapshot, "local", value.range.startTokenIndex),
                        "local", value.name
                    ),
                    "local"
                )
                if (!value.initializer && value.declaredTypeName && currentTypeResolver &&
                    currentTypeResolver.specializedNullLocal(value.declaredTypeName)) {
                    if (semanticType.kind() != "nullable" && semanticType.kind() != "generic-parameter") semanticType = NullableSemanticType(semanticType)
                    initialized = BoundLiteralExpression(value.range, SemanticTypes.nullType(), "null")
                }
                let local = BoundReferenceExpression(
                    value.range, semanticType, value.name, identity
                )
                scopeLocals.add(LocalBinding(value.name, identity, semanticType,
                    nativeArrayStorage: value.nativeArrayStorage))
                var TypeConversion initializerConversion
                if (initialized) {
                    initializerConversion = TypeConversions.classify(
                        initialized.semanticType, semanticType
                    )
                    let declaredStringInitializer = semanticType.kind() == "user-class" &&
                        initialized.semanticType.kind() == "string"
                    if (!initializerConversion.applicable && declaredStringInitializer) {
                        initialized = PrimitiveStringAdapter.wrap(initialized, semanticType,
                            currentTypeResolver.declarationContext, callables)
                        initializerConversion = TypeConversions.classify(initialized.semanticType, semanticType)
                    }
                }
                result.add(BoundLocalDeclarationStatement(
                    value.range, local, initialized, initializerConversion
                ))
            } else if (statement.class.isOfType(PrimitiveReturnSyntax.class)) {
                let value = (PrimitiveReturnSyntax)statement
                if (!value.value) result.add(BoundReturnStatement(
                    value.range, SemanticTypes.unitType()
                ))
                else {
                    let returned = classExpression(
                        value.value, receiver, fields, scopeLocals, callables
                    )
                    result.add(BoundReturnStatement(
                        value.range, returned.semanticType, returned,
                        TypeConversions.classify(
                            returned.semanticType, returned.semanticType
                        )
                    ))
                }
            } else if (statement.class.isOfType(PrimitiveExpressionStatementSyntax.class)) {
                let value = (PrimitiveExpressionStatementSyntax)statement
                if (value.expression.class.isOfType(PrimitiveNativeSyntax.class)) {
                    let external = PrimitiveNativeBinder().bind(
                        (PrimitiveNativeSyntax)value.expression, "es6", scopeLocals,
                        SemanticTypes.unitType()
                    )
                    result.add(BoundExpressionStatement(value.range, external.nativeCall))
                } else result.add(BoundExpressionStatement(
                    value.range,
                    classExpression(
                        value.expression, receiver, fields, scopeLocals, callables
                    )
                ))
            } else {
                let simple = PrimitiveStatementSyntaxResult([statement])
                let bound = PrimitiveStatementBinder().bind(
                    simple, snapshot, scopeLocals, callables
                )
                result.addAll(bound.statements())
                scopeLocals = bound.locals()
            }
        }
        return result
    }

    bindStructuredNamedCall(
        SourceRange range, String name, BoundExpression owner,
        PrimitiveExpressionSyntax[] positional, PrimitiveMixedNamedArgumentSyntax[] named,
        BoundReferenceExpression receiver, BoundFieldUnit[] fields,
        LocalBinding[] locals, CallableSignature[] callables
    ) -> BoundExpression {
        if (!owner) throw Exception("Named structured call requires an instance receiver")
        let candidates = callables.filter((candidate) =>
            candidate.name == name && candidate.callableKind.value == "instance-method" &&
            candidate.ownerType.value() == owner.semanticType.value() &&
            candidate.parameterTypes().count == positional.count + named.count &&
            candidate.parameterNames().count == positional.count + named.count
        )
        let applicable = CallableSignature[]
        for (candidate in candidates) {
            let names = candidate.parameterNames()
            var Bool matches = true
            var Int i
            while (i < named.count) {
                if (named[i].name != names[positional.count + i]) matches = false
                i++
            }
            if (matches) applicable.add(candidate)
        }
        if (applicable.isEmpty) throw Exception("Named arguments require matching source-order parameters in structured expressions")
        let arguments = BoundExpression[]
        for (argument in positional) arguments.add(classExpression(argument, receiver, fields, locals, callables))
        for (argument in named) arguments.add(classExpression(argument.value, receiver, fields, locals, callables))
        let resolution = OverloadResolver.resolve(name, applicable, owner.semanticType,
            arguments.map({ _.semanticType }), range)
        if (!resolution.resolved) throw Exception(resolution.diagnostic.message)
        let checked = CallTypeChecker.check(resolution.selected, owner.semanticType,
            arguments.map({ _.semanticType }), range)
        if (!checked.valid) throw Exception(checked.diagnostic.message)
        return BoundCallExpression(range, checked.semanticType, resolution.selected, owner,
            arguments, checked.argumentConversions())
    }

    classExpression(
        PrimitiveExpressionSyntax syntax,
        BoundReferenceExpression receiver,
        BoundFieldUnit[] fields,
        LocalBinding[] locals,
        CallableSignature[] callables
    ) -> BoundExpression {
        if (syntax.class.isOfType(PrimitiveMemberCallSyntax.class) &&
            ((PrimitiveMemberCallSyntax)syntax).memberName == "isOfType") {
            return PrimitiveClassBinder().bindScopedExpression(syntax, receiver, fields, locals,
                callables, currentArrayGetter, currentArraySetter, currentTypeResolver,
                currentAvailableFields, currentHierarchy)
        }
        if (syntax.class.isOfType(PrimitiveInterpolatedStringSyntax.class)) {
            return PrimitiveClassBinder().bindScopedExpression(syntax, receiver, fields, locals,
                callables, currentArrayGetter, currentArraySetter, currentTypeResolver,
                currentAvailableFields, currentHierarchy)
        }
        if (syntax.class.isOfType(PrimitiveReferenceSyntax.class)) {
            let value = (PrimitiveReferenceSyntax)syntax
            let local = locals.reverse().firstOrNull({ _.name == value.name })
            if (local && local.identity.symbolKind == "field") {
                let field = fields.firstOrNull({ _.identity == local.identity })
                if (!field) throw Exception("Invalid field reference '#{value.name}'")
                if (field.staticField) return BoundReferenceExpression(value.range, field.semanticType,
                    field.name, field.identity, staticOwner: field.identity.declaration)
                if (!receiver) throw Exception("Invalid field reference '#{value.name}'")
                return BoundMemberAccessExpression(
                    value.range, field.semanticType, receiver, field.name, field.identity
                )
            }
            if (local) return BoundReferenceExpression(
                value.range, local.semanticType, local.name, local.identity
            )
            var BoundFieldUnit field = fields.firstOrNull({ _.name == value.name })
            if (!field && receiver) field = currentAvailableFields.firstOrNull((candidate) =>
                candidate.name == value.name &&
                candidate.identity.declaration.name ==
                    receiver.symbolIdentity.declaration.name
            )
            if (field) {
                if (field.staticField) return BoundReferenceExpression(value.range, field.semanticType,
                    field.name, field.identity, staticOwner: field.identity.declaration)
                if (!receiver) throw Exception("Static method cannot reference instance field")
                return BoundMemberAccessExpression(
                    value.range, field.semanticType, receiver, field.name, field.identity
                )
            }
            let properties = callables.filter((candidate) =>
                candidate.callableKind.value == "instance-method" && receiver &&
                candidate.ownerType.value() == receiver.semanticType.value() &&
                candidate.name == value.name && candidate.parameterTypes().isEmpty
            )
            if (properties.isNotEmpty) {
                let resolution = OverloadResolver.resolve(
                    value.name, properties, receiver.semanticType,
                    SemanticType[], value.range
                )
                if (!resolution.resolved) throw Exception(resolution.diagnostic.message)
                let target = resolution.selected
                let checked = CallTypeChecker.check(
                    target, receiver.semanticType, SemanticType[], value.range
                )
                if (!checked.valid) throw Exception(checked.diagnostic.message)
                return BoundCallExpression(
                    value.range, checked.semanticType, target, receiver,
                    BoundExpression[], checked.argumentConversions()
                )
            }
        }
        if (syntax.class.isOfType(PrimitiveMemberAssignmentValueSyntax.class)) {
            let value = (PrimitiveMemberAssignmentValueSyntax)syntax
            let targetObject = classExpression(value.target, receiver, fields, locals, callables)
            if (!targetObject.class.isOfType(BoundMemberAccessExpression.class)) throw Exception("Member assignment value requires a stored field")
            let target = (BoundMemberAccessExpression)targetObject
            if (target.safeAccess) throw Exception("Safe member assignment is not supported")
            let operand = classExpression(value.value, receiver, fields, locals, callables)
            let operator = binaryOperator(value.assignmentOperator)
            let typed = TypeOperations.binary(operator, target.semanticType, operand.semanticType, value.range)
            if (!typed.valid) throw Exception(typed.diagnostic.message)
            let conversion = TypeConversions.classify(typed.semanticType, target.semanticType)
            if (!conversion.applicable) throw Exception("Member assignment value type mismatch")
            return BoundMemberAssignmentValueExpression(value.range, typed.semanticType, target, operator, operand, conversion)
        }
        if (syntax.class.isOfType(PrimitiveMemberAccessSyntax.class)) {
            let value = (PrimitiveMemberAccessSyntax)syntax
            if (value.receiver.class.isOfType(PrimitiveReferenceSyntax.class)) {
                let ownerName = ((PrimitiveReferenceSyntax)value.receiver).name
                if (!locals.any({ _.name == ownerName })) {
                    let staticCandidates = callables.filter((candidate) =>
                        candidate.callableKind.value == "static-method" &&
                        candidate.ownerType.declarationIdentity.name == ownerName &&
                        candidate.name == value.memberName
                    )
                    if (staticCandidates.count == 1) {
                        let target = staticCandidates.first
                        return BoundFunctionValue(
                            value.range,
                            FunctionSemanticType(
                                target.parameterTypes(), target.returnType
                            ),
                            target
                        )
                    }
                    if (staticCandidates.count > 1) throw Exception(
                        "Static method reference '#{ownerName}.#{value.memberName}' is ambiguous"
                    )
                }
            }
            let projectedReceiver = classExpression(
                value.receiver, receiver, fields, locals, callables
            )
            if (value.memberName == "class" &&
                value.receiver.class.isOfType(PrimitiveReferenceSyntax.class)) {
                let metadata = callables.filter((candidate) =>
                    candidate.callableKind.value == "constructor" &&
                    candidate.ownerType.declarationIdentity.name == "Class")
                let declaredField = currentAvailableFields.firstOrNull((candidate) =>
                    candidate.name == value.memberName &&
                    projectedReceiver.semanticType.value() ==
                        "class:#{candidate.identity.declaration.value}")
                if (!declaredField && metadata.count == 1 &&
                    projectedReceiver.class.isOfType(BoundReferenceExpression.class)) {
                    let reference = (BoundReferenceExpression)projectedReceiver
                    return BoundMemberAccessExpression(
                        value.range, metadata.first.ownerType, projectedReceiver,
                        value.memberName, reference.symbolIdentity
                    )
                }
            }
            if (projectedReceiver.semanticType.value() == SemanticTypes.stringType().value()) {
                let field = currentAvailableFields.firstOrNull((candidate) =>
                    candidate.identity.declaration.name == "String" && candidate.visibleField &&
                    !candidate.staticField && candidate.name == value.memberName)
                if (field) return BoundMemberAccessExpression(value.range, field.semanticType,
                    projectedReceiver, field.name, field.identity)
            }
            if (projectedReceiver.semanticType.kind() == "generic-instance" ||
                projectedReceiver.semanticType.kind() == "user-class") {
                return PrimitiveClassBinder().bindScopedExpression(
                    syntax, receiver, fields, locals, callables,
                    currentArrayGetter, currentArraySetter, currentTypeResolver, currentAvailableFields, currentHierarchy)
            }
            if (projectedReceiver.semanticType.kind() == "array") {
                if (value.memberName == "data") {
                    return BoundNativeArrayDataExpression(value.range, projectedReceiver)
                }
                if (value.memberName == "count") {
                    return BoundArrayLengthExpression(value.range, projectedReceiver)
                }
            }
            if (receiver && projectedReceiver.semanticType.value() == receiver.semanticType.value()) {
                let field = fields.firstOrNull({ _.name == value.memberName })
                if (field) return BoundMemberAccessExpression(
                    value.range, field.semanticType, projectedReceiver,
                    field.name, field.identity
                )
                let propertyCandidates = callables.filter((candidate) =>
                    candidate.callableKind.value == "instance-method" &&
                    candidate.ownerType.value() == projectedReceiver.semanticType.value() &&
                    candidate.name == value.memberName &&
                    candidate.parameterTypes().isEmpty
                )
                if (propertyCandidates.count == 1) {
                    let target = propertyCandidates.first
                    let checked = CallTypeChecker.check(
                        target, projectedReceiver.semanticType,
                        SemanticType[], value.range
                    )
                    if (!checked.valid) throw Exception(checked.diagnostic.message)
                    return BoundCallExpression(
                        value.range, checked.semanticType, target, projectedReceiver,
                        BoundExpression[], checked.argumentConversions()
                    )
                }
            }
            if (projectedReceiver.semanticType.kind() == "user-class") {
                var BoundFieldUnit field = currentAvailableFields.firstOrNull((candidate) =>
                    projectedReceiver.semanticType.value() ==
                        "class:#{candidate.identity.declaration.value}" &&
                    candidate.name == value.memberName
                )
                if (!field) field = fields.firstOrNull((candidate) =>
                    projectedReceiver.semanticType.value() ==
                        "class:#{candidate.identity.declaration.value}" &&
                    candidate.name == value.memberName
                )
                if (field) return BoundMemberAccessExpression(
                    value.range, field.semanticType, projectedReceiver,
                    field.name, field.identity
                )
            }
            if (value.receiver.class.isOfType(PrimitiveMemberAccessSyntax.class)) {
                return PrimitiveClassBinder().bindScopedExpression(
                    syntax, receiver, fields, locals, callables,
                    currentArrayGetter, currentArraySetter, currentTypeResolver, currentAvailableFields, currentHierarchy)
            }
        }
        if (syntax.class.isOfType(PrimitiveArrayConstructionSyntax.class)) {
            let value = (PrimitiveArrayConstructionSyntax)syntax
            let size = classExpression(
                value.size, receiver, fields, locals, callables
            )
            if (size.semanticType.value() != SemanticTypes.intType().value()) {
                throw Exception("Array construction size requires Int")
            }
            return BoundArrayExpression(
                value.range, ArraySemanticType(loopLocalType(value.elementTypeName)), size
            )
        }
        if (syntax.class.isOfType(PrimitiveConstructionSyntax.class)) {
            let value = (PrimitiveConstructionSyntax)syntax
            let typeArguments = value.typeArgumentNames()
            let arguments = BoundExpression[]
            for (argument in value.argumentValues()) {
                if (argument.class.isOfType(PrimitiveMemberAccessSyntax.class)) {
                    let access = (PrimitiveMemberAccessSyntax)argument
                    if (access.receiver.class.isOfType(PrimitiveReferenceSyntax.class)) {
                        let receiverName = ((PrimitiveReferenceSyntax)access.receiver).name
                        let local = locals.reverse().firstOrNull({ _.name == receiverName })
                        if (local && local.semanticType.kind() == "array" &&
                            access.memberName == "count") {
                            arguments.add(BoundArrayLengthExpression(
                                access.range, BoundReferenceExpression(
                                    access.receiver.range, local.semanticType,
                                    local.name, local.identity
                                )
                            ))
                            continue
                        }
                    }
                }
                arguments.add(classExpression(
                    argument, receiver, fields, locals, callables
                ))
            }
            let candidates = callables.filter((candidate) =>
                candidate.callableKind.value == "constructor" &&
                candidate.ownerType.declarationIdentity.name == value.typeName
            ).map((candidate) => typeArguments.isEmpty ? candidate :
                candidate.instantiateConstructor(typeArguments.map({ currentTypeResolver.resolve(_) })))
            if (candidates.isEmpty && value.typeName == "Array" &&
                typeArguments.count == 1 && arguments.count == 1) {
                if (arguments.first.semanticType.value() != SemanticTypes.intType().value()) {
                    throw Exception("Array construction size requires Int")
                }
                return BoundArrayExpression(value.range,
                    ArraySemanticType(currentTypeResolver.resolve(typeArguments.first)),
                    arguments.first)
            }
            let resolution = OverloadResolver.resolve(
                value.typeName, candidates, null,
                arguments.map({ _.semanticType }), value.range
            )
            if (!resolution.resolved) throw Exception(resolution.diagnostic.message)
            let target = resolution.selected
            let checked = CallTypeChecker.check(
                target, null, arguments.map({ _.semanticType }), value.range
            )
            if (!checked.valid) throw Exception(checked.diagnostic.message)
            return BoundCallExpression(
                value.range, checked.semanticType, target,
                arguments, checked.argumentConversions()
            )
        }
        if (syntax.class.isOfType(PrimitiveArrayAccessSyntax.class)) {
            let value = (PrimitiveArrayAccessSyntax)syntax
            var BoundExpression target = classExpression(
                value.receiver, receiver, fields, locals, callables
            )
            let index = classExpression(
                value.index, receiver, fields, locals, callables
            )
            if (target.semanticType.kind() == "user-class" ||
                target.semanticType.kind() == "generic-instance") {
                let indexedType = target.semanticType
                let indexedOwner = indexedType.kind() == "generic-instance"
                    ? ((GenericInstanceSemanticType)indexedType).declarationType.value()
                    : indexedType.value()
                let getter = callables.firstOrNull((candidate) =>
                    candidate.identity.symbolKind == "array-getter" &&
                    candidate.ownerType.value() == indexedOwner
                )
                if (getter) {
                    let checked = CallTypeChecker.check(
                        getter, indexedType, [index.semanticType], value.range
                    )
                    if (!checked.valid) throw Exception(checked.diagnostic.message)
                    let selected = indexedType.kind() == "generic-instance" &&
                        getter.ownerGenericDeclaration ? getter.instantiateReceiver(
                            (GenericInstanceSemanticType)indexedType
                        ) : getter
                    return BoundCallExpression(
                        value.range, checked.semanticType, selected, target,
                        [index], checked.argumentConversions()
                    )
                }
            }
            if (target.semanticType.kind() != "array") {
                throw Exception("Array access requires an array or indexed class receiver")
            }
            let typeObject = (Object)target.semanticType
            var ArraySemanticType arrayType
            arrayType = (ArraySemanticType)typeObject
            return BoundArrayAccessExpression(
                value.range, arrayType.elementType, target, index
            )
        }
        if (syntax.class.isOfType(PrimitiveUnarySyntax.class)) {
            let value = (PrimitiveUnarySyntax)syntax
            let operand = classExpression(
                value.operand, receiver, fields, locals, callables
            )
            if (value.operator == "++" || value.operator == "--") {
                return PrimitiveExpressionBinder.bindPrefixUpdate(value.range, value.operator, operand)
            }
            if (value.operator == "!") {
                let absence = PrimitiveExpressionBinder.bindReferenceNegation(value.range, operand)
                if (absence) return absence
            }
            let typed = TypeOperations.unary(
                value.operator, operand.semanticType, value.range
            )
            if (!typed.valid) throw Exception(typed.diagnostic.message)
            return BoundUnaryExpression(
                value.range, typed.semanticType, value.operator, operand
            )
        }
        if (syntax.class.isOfType(PrimitivePostfixUpdateSyntax.class)) {
            let value = (PrimitivePostfixUpdateSyntax)syntax
            if (!value.operand.class.isOfType(PrimitiveReferenceSyntax.class)) {
                throw Exception("Postfix update requires a local reference")
            }
            let reference = (PrimitiveReferenceSyntax)value.operand
            let local = locals.reverse().firstOrNull({ _.name == reference.name })
            var BoundExpression target
            if (local) {
                target = BoundReferenceExpression(
                    value.range, local.semanticType, local.name, local.identity
                )
            } else {
                let field = fields.firstOrNull({ _.name == reference.name })
                if (!field || !receiver) {
                    throw Exception("Unknown postfix update local '#{reference.name}'")
                }
                if (!field.mutableField) {
                    throw Exception("Postfix update requires mutable field '#{reference.name}'")
                }
                target = BoundMemberAccessExpression(
                    value.range, field.semanticType, receiver,
                    field.name, field.identity
                )
            }
            let one = BoundLiteralExpression(value.range, SemanticTypes.intType(), "1")
            let typed = TypeOperations.binary(
                value.updateOperator == "++" ? "+" : "-",
                target.semanticType, one.semanticType, value.range
            )
            if (!typed.valid ||
                typed.semanticType.value() != target.semanticType.value()) {
                throw Exception("Postfix update requires a numeric local")
            }
            return BoundPostfixUpdateExpression(
                value.range, target.semanticType, target, value.updateOperator
            )
        }
        if (syntax.class.isOfType(PrimitiveAssignmentValueSyntax.class)) {
            let value = (PrimitiveAssignmentValueSyntax)syntax
            let local = locals.reverse().firstOrNull({ _.name == value.name })
            if (!local) throw Exception("Unknown assignment local '#{value.name}'")
            let target = BoundReferenceExpression(
                value.range, local.semanticType, local.name, local.identity
            )
            var BoundExpression assigned = classExpression(
                value.value, receiver, fields, locals, callables
            )
            var TypeConversion conversion = TypeConversions.classify(
                assigned.semanticType, target.semanticType
            )
            if (!conversion.applicable && assigned.semanticType.kind() == "unknown") {
                conversion = TypeConversion(
                    assigned.semanticType, target.semanticType,
                    "deferred-assignment-value", true, false, true, 1000
                )
            }
            let declaredStringAssignment = receiver &&
                target.semanticType.value() == receiver.semanticType.value() &&
                (assigned.semanticType.value() == SemanticTypes.stringType().value() ||
                 assigned.semanticType.kind() == "unknown") &&
                callables.any((candidate) =>
                    candidate.ownerType &&
                    candidate.ownerType.value() == receiver.semanticType.value() &&
                    candidate.ownerType.declarationIdentity.name == "String"
                )
            if (!conversion.applicable && declaredStringAssignment) {
                assigned = PrimitiveStringAdapter.wrap(assigned, target.semanticType,
                    currentTypeResolver.declarationContext, callables)
                conversion = TypeConversions.classify(assigned.semanticType, target.semanticType)
            }
            if (!conversion.applicable) throw Exception("Assignment value type mismatch")
            return BoundAssignmentValueExpression(
                value.range, target.semanticType, target, assigned, conversion
            )
        }
        if (syntax.class.isOfType(PrimitiveConditionalSyntax.class)) {
            let value = (PrimitiveConditionalSyntax)syntax
            let condition = conditionValue(classExpression(
                value.condition, receiver, fields, locals, callables
            ))
            var BoundExpression whenTrue = classExpression(
                value.whenTrue, receiver, fields, locals, callables
            )
            var BoundExpression whenFalse = classExpression(
                value.whenFalse, receiver, fields, locals, callables
            )
            if (whenTrue.semanticType.kind() == "string" && whenFalse.semanticType.kind() == "user-class")
                whenTrue = PrimitiveStringAdapter.wrap(whenTrue, whenFalse.semanticType, currentTypeResolver.declarationContext, callables)
            else if (whenFalse.semanticType.kind() == "string" && whenTrue.semanticType.kind() == "user-class")
                whenFalse = PrimitiveStringAdapter.wrap(whenFalse, whenTrue.semanticType, currentTypeResolver.declarationContext, callables)
            let joined = TypeOperations.conditional(condition.semanticType, whenTrue.semanticType, whenFalse.semanticType, value.range)
            if (!joined.valid) throw Exception(joined.diagnostic.message)
            let trueJoin = TypeConversions.classify(whenTrue.semanticType, joined.semanticType)
            let falseJoin = TypeConversions.classify(whenFalse.semanticType, joined.semanticType)
            if (trueJoin.conversionKind != "identity") whenTrue = BoundConversionExpression(
                value.whenTrue.range, joined.semanticType, whenTrue, trueJoin)
            if (falseJoin.conversionKind != "identity") whenFalse = BoundConversionExpression(
                value.whenFalse.range, joined.semanticType, whenFalse, falseJoin)
            return BoundConditionalExpression(
                value.range, joined.semanticType, condition, whenTrue, whenFalse
            )
        }
        if (syntax.class.isOfType(PrimitiveBinarySyntax.class)) {
            let value = (PrimitiveBinarySyntax)syntax
            var BoundExpression left = classExpression(
                value.left, receiver, fields, locals, callables
            )
            var BoundExpression right = classExpression(
                value.right, receiver, fields, locals, callables
            )
            if (value.operator == "+") {
                let resolved = PrimitiveStringAdapter.plus(left, right,
                    currentTypeResolver ? currentTypeResolver.declarationContext : null, callables, currentHierarchy)
                if (resolved) return resolved
            }
            let declaredStringOperands = value.operator == "+" && receiver &&
                left.semanticType.value() == receiver.semanticType.value() &&
                right.semanticType.value() == receiver.semanticType.value() &&
                callables.any((candidate) =>
                    candidate.ownerType &&
                    candidate.ownerType.value() == receiver.semanticType.value() &&
                    candidate.ownerType.declarationIdentity.name == "String"
                )
            if (declaredStringOperands) {
                left = BoundConversionExpression(
                    value.left.range, SemanticTypes.stringType(), left,
                    PrimitiveStringAdapter.unsupported(
                        left.semanticType, SemanticTypes.stringType(),
                        "declared-string-operator", true, false, true, 0
                    )
                )
                right = BoundConversionExpression(
                    value.right.range, SemanticTypes.stringType(), right,
                    PrimitiveStringAdapter.unsupported(
                        right.semanticType, SemanticTypes.stringType(),
                        "declared-string-operator", true, false, true, 0
                    )
                )
            }
            let typed = TypeOperations.binary(
                value.operator, left.semanticType, right.semanticType, value.range
            )
            if (!typed.valid) throw Exception(typed.diagnostic.message)
            return BoundBinaryExpression(
                value.range, typed.semanticType, value.operator, left, right
            )
        }
        if (syntax.class.isOfType(PrimitiveEmptyArrayConstructionSyntax.class)) {
            let array = (PrimitiveEmptyArrayConstructionSyntax)syntax
            let type = currentTypeResolver.declarationContext ? currentTypeResolver.resolve(array.elementTypeName + "[]") :
                ArraySemanticType(currentTypeResolver.resolve(array.elementTypeName))
            if (type.kind() == "generic-instance") {
                return PrimitiveClassBinder().bindScopedExpression(syntax, receiver, fields, locals, callables,
                    currentArrayGetter, currentArraySetter, currentTypeResolver, currentAvailableFields, currentHierarchy)
            }
            return BoundArrayExpression(array.range, (ArraySemanticType)type, BoundExpression[])
        }
        if (syntax.class.isOfType(PrimitiveDeclarationValueSyntax.class)) {
            let declaration = (PrimitiveDeclarationValueSyntax)syntax
            if (locals.any({ _.name == declaration.name })) throw Exception("Duplicate condition local '#{declaration.name}'")
            let initialized = classExpression(declaration.value, receiver, fields, locals, callables)
            let identity = SymbolIdentity(DeclarationIdentity(
                SyntaxIslandIdentity(declaration.range.snapshot, "declaration-value", declaration.range.startTokenIndex),
                "declaration-value", declaration.name), "local")
            let local = BoundReferenceExpression(declaration.range, initialized.semanticType, declaration.name, identity)
            locals.add(LocalBinding(declaration.name, identity, initialized.semanticType))
            return BoundDeclarationValueExpression(declaration.range, initialized.semanticType, local, initialized,
                TypeConversions.classify(initialized.semanticType, initialized.semanticType))
        }
        if (syntax.class.isOfType(PrimitiveMemberCallSyntax.class)) {
            let value = (PrimitiveMemberCallSyntax)syntax
            if (value.receiver.class.isOfType(PrimitiveReferenceSyntax.class)) {
                let ownerName = ((PrimitiveReferenceSyntax)value.receiver).name
                if (locals.none({ _.name == ownerName }) && fields.none({ _.name == ownerName })) {
                    var CallableSignature[] candidates = callables.filter((candidate) =>
                        candidate.callableKind.value == "static-method" &&
                        candidate.ownerType.declarationIdentity.name == ownerName &&
                        candidate.name == value.memberName)
                    if (candidates.isNotEmpty) {
                        if (value.namedArgumentValues().isNotEmpty) throw Exception("Structured static named calls require argument mapping")
                        if (value.typeArgumentNames().isNotEmpty) {
                            let types = value.typeArgumentNames().map({ currentTypeResolver.resolve(_) })
                            candidates = candidates.filter({ _.genericParameters().count == types.count }).map((candidate) => {
                                let substitution = GenericSubstitution(candidate.genericParameters(), types)
                                return CallableSignature(candidate.identity, candidate.name, candidate.callableKind,
                                    candidate.parameterTypes().map({ substitution.apply(_) }),
                                    substitution.apply(candidate.returnType), candidate.ownerType,
                                    candidate.optionalParameterCount, candidate.parameterNames())
                            })
                        }
                        if (value.argumentValues().any({ _.class.isOfType(PrimitiveLambdaSyntax.class) })) {
                            return PrimitiveClassBinder().bindScopedExpression(syntax, receiver, fields, locals, callables,
                                currentArrayGetter, currentArraySetter, currentTypeResolver, currentAvailableFields, currentHierarchy)
                        }
                        let arguments = value.argumentValues().map({ classExpression(_, receiver, fields, locals, callables) })
                        let resolution = OverloadResolver.resolve(value.memberName, candidates, null,
                            arguments.map({ _.semanticType }), value.range, hierarchy: currentHierarchy)
                        if (!resolution.resolved) throw Exception(resolution.diagnostic.message)
                        let checked = CallTypeChecker.check(resolution.selected, null,
                            arguments.map({ _.semanticType }), value.range, hierarchy: currentHierarchy)
                        if (!checked.valid) throw Exception(checked.diagnostic.message)
                        return BoundCallExpression(value.range, checked.semanticType, checked.target,
                            arguments, checked.argumentConversions())
                    }
                }
            }
            if (value.argumentValues().any({ _.class.isOfType(PrimitiveLambdaSyntax.class) }) ||
                value.receiver.class.isOfType(PrimitiveMemberAccessSyntax.class)) {
                return PrimitiveClassBinder().bindScopedExpression(syntax, receiver, fields, locals, callables,
                    currentArrayGetter, currentArraySetter, currentTypeResolver, currentAvailableFields, currentHierarchy)
            }
            if (value.typeArgumentNames().isNotEmpty) throw Exception("Explicit instance type arguments require call instantiation")
            if (value.namedArgumentValues().isNotEmpty) {
                if (currentTypeResolver && currentTypeResolver.declarationContext)
                    return PrimitiveClassBinder().bindScopedExpression(syntax, receiver, fields, locals,
                        callables, currentArrayGetter, currentArraySetter, currentTypeResolver,
                        currentAvailableFields, currentHierarchy)
                let owner = classExpression(value.receiver, receiver, fields, locals, callables)
                return bindStructuredNamedCall(value.range, value.memberName, owner,
                    value.argumentValues(), value.namedArgumentValues(), receiver, fields, locals, callables)
            }
            let owner = classExpression(
                value.receiver, receiver, fields, locals, callables
            )
            if (owner.semanticType.kind() == "generic-parameter" ||
                (owner.semanticType.kind() == "generic-instance" && value.memberName == "set")) {
                return PrimitiveClassBinder().bindScopedExpression(syntax, receiver, fields, locals,
                    callables, currentArrayGetter, currentArraySetter, currentTypeResolver,
                    currentAvailableFields, currentHierarchy)
            }
            let arguments = BoundExpression[]
            for (argument in value.argumentValues()) {
                arguments.add(classExpression(
                    argument, receiver, fields, locals, callables
                ))
            }
            if (owner.semanticType.kind() == "array" &&
                value.memberName == "set" && arguments.count == 2) {
                if (arguments.first.semanticType.value() != SemanticTypes.intType().value()) {
                    throw Exception("Array set index requires Int")
                }
                let elementType = collectionElementType(owner.semanticType)
                let conversion = TypeConversions.classify(
                    arguments.last.semanticType, elementType
                )
                if (!conversion.applicable) throw Exception("Array set value type mismatch")
                return BoundIntrinsicMemberCallExpression(
                    value.range, SemanticTypes.unitType(), owner,
                    "set", arguments
                )
            }
            if (owner.semanticType.kind() == "array" &&
                value.memberName == "add" && arguments.count == 1) {
                let elementType = collectionElementType(owner.semanticType)
                let conversion = TypeConversions.classify(
                    arguments.first.semanticType, elementType
                )
                if (!conversion.applicable) throw Exception("Array add argument type mismatch")
                return BoundIntrinsicMemberCallExpression(
                    value.range, SemanticTypes.unitType(), owner,
                    "add", arguments
                )
            }
            if (owner.semanticType.kind() == "array" &&
                value.memberName == "contains" && arguments.count == 1) {
                let elementType = collectionElementType(owner.semanticType)
                let conversion = TypeConversions.classify(
                    arguments.first.semanticType, elementType
                )
                if (!conversion.applicable) throw Exception("Array contains argument type mismatch")
                return BoundIntrinsicMemberCallExpression(
                    value.range, SemanticTypes.boolType(), owner,
                    "contains", arguments
                )
            }
            let instance = owner.semanticType.kind() == "generic-instance" ?
                (GenericInstanceSemanticType)owner.semanticType : null
            let ownerType = instance ? instance.declarationType.value() : owner.semanticType.value()
            let candidates = callables.filter((candidate) =>
                candidate.callableKind.value == "instance-method" &&
                candidate.ownerType.value() == ownerType &&
                candidate.name == value.memberName
            ).map((candidate) => instance && candidate.ownerGenericDeclaration
                ? candidate.instantiateReceiver(instance) : candidate)
            if (candidates.isEmpty && owner.class.isOfType(BoundMemberAccessExpression.class)) {
                return PrimitiveClassBinder().bindScopedExpression(syntax, receiver, fields, locals,
                    callables, currentArrayGetter, currentArraySetter, currentTypeResolver,
                    currentAvailableFields, currentHierarchy)
            }
            if (candidates.isNotEmpty) {
                return PrimitiveStringAdapter.call(value.memberName, candidates, owner, arguments,
                    currentTypeResolver ? currentTypeResolver.declarationContext : null, callables, currentHierarchy)
            }
        }
        if (syntax.class.isOfType(PrimitiveConstructionSyntax.class)) {
            let value = (PrimitiveConstructionSyntax)syntax
            let typeArguments = value.typeArgumentNames()
            let arguments = BoundExpression[]
            for (argument in value.argumentValues()) {
                if (argument.class.isOfType(PrimitiveReferenceSyntax.class) && receiver &&
                    ((PrimitiveReferenceSyntax)argument).name == "this" &&
                    currentTypeResolver.genericParameter &&
                    receiver.semanticType.kind() == "user-class") {
                    arguments.add(BoundReferenceExpression(
                        argument.range,
                        GenericInstanceSemanticType(
                            (UserClassSemanticType)receiver.semanticType,
                            [currentTypeResolver.genericParameter]
                        ), "this", receiver.symbolIdentity
                    ))
                } else arguments.add(classExpression(
                    argument, receiver, fields, locals, callables
                ))
            }
            let resolvedOwner = currentTypeResolver.declarationContext ?
                currentTypeResolver.declarationContext.resolve(value.typeName, value.range) : null
            let candidates = callables.filter((candidate) =>
                candidate.callableKind.value == "constructor" &&
                (resolvedOwner ? candidate.ownerType.declarationIdentity.value == resolvedOwner.value :
                    candidate.name == value.typeName)
            ).map((candidate) => typeArguments.isEmpty ? candidate :
                candidate.instantiateConstructor(typeArguments.map({ currentTypeResolver.resolve(_) })))
            if (candidates.isEmpty && value.typeName == "Array" &&
                typeArguments.count == 1 && arguments.count == 1) {
                if (arguments.first.semanticType.value() != SemanticTypes.intType().value()) {
                    throw Exception("Array construction size requires Int")
                }
                return BoundArrayExpression(value.range,
                    ArraySemanticType(currentTypeResolver.resolve(typeArguments.first)),
                    arguments.first)
            }
            if (candidates.isNotEmpty) {
                return PrimitiveStringAdapter.call(value.typeName, candidates, null, arguments,
                    currentTypeResolver.declarationContext, callables, currentHierarchy, callRange: value.range)
            }
        }
        if (syntax.class.isOfType(PrimitiveCallSyntax.class)) {
            let value = (PrimitiveCallSyntax)syntax
            if (value.argumentValues().any({ _.class.isOfType(PrimitiveLambdaSyntax.class) }) &&
                !locals.any({ _.name == value.name }) && receiver) {
                return PrimitiveClassBinder().bindScopedExpression(syntax, receiver, fields, locals, callables,
                    currentArrayGetter, currentArraySetter, currentTypeResolver, currentAvailableFields, currentHierarchy)
            }
            if (value.namedArgumentValues().isNotEmpty) {
                if (locals.any({ _.name == value.name })) {
                    throw Exception("Named arguments for local '#{value.name}' require callable parameter binding")
                }
                return bindStructuredNamedCall(value.range, value.name, receiver,
                    value.argumentValues(), value.namedArgumentValues(), receiver, fields, locals, callables)
            }
            let localFunction = locals.reverse().firstOrNull((candidate) =>
                candidate.name == value.name &&
                candidate.semanticType.kind() == "function"
            )
            if (localFunction) {
                let typeObject = (Object)localFunction.semanticType
                var FunctionSemanticType functionType
                functionType = (FunctionSemanticType)typeObject
                let invocationArguments = BoundExpression[]
                for (argument in value.argumentValues()) {
                    invocationArguments.add(classExpression(
                        argument, receiver, fields, locals, callables
                    ))
                }
                if (invocationArguments.count != functionType.parameterTypes().count)
                    throw Exception("Callback argument count mismatch")
                var Int argumentIndex
                while (argumentIndex < invocationArguments.count) {
                    var BoundExpression argument = invocationArguments[argumentIndex]
                    let target = functionType.parameterTypes()[argumentIndex]
                    if (receiver && argument.class.isOfType(BoundReferenceExpression.class) &&
                        ((BoundReferenceExpression)argument).symbolIdentity.value == receiver.symbolIdentity.value &&
                        currentTypeResolver.genericParameter && receiver.semanticType.kind() == "user-class") {
                        argument = BoundReferenceExpression(argument.range,
                            GenericInstanceSemanticType((UserClassSemanticType)receiver.semanticType,
                                [currentTypeResolver.genericParameter]), receiver.name, receiver.symbolIdentity)
                        invocationArguments[argumentIndex] = argument
                    }
                    if (receiver && argument.class.isOfType(BoundReferenceExpression.class) &&
                        ((BoundReferenceExpression)argument).symbolIdentity.value == receiver.symbolIdentity.value &&
                        target.kind() == "generic-instance" &&
                        receiver.semanticType.kind() == "user-class") {
                        let instance = (GenericInstanceSemanticType)target
                        if (instance.declarationType.value() == receiver.semanticType.value() &&
                            currentTypeResolver.genericParameter &&
                            instance.typeArguments().count == 1 &&
                            instance.typeArguments().first.value() ==
                                currentTypeResolver.genericParameter.value()) {
                            argument = BoundReferenceExpression(
                                argument.range, instance, receiver.name, receiver.symbolIdentity
                            )
                            invocationArguments[argumentIndex] = argument
                        }
                    }
                    let conversion = TypeConversions.classify(argument.semanticType, target, hierarchy: currentHierarchy)
                    if (!conversion.applicable) throw Exception("Callback argument #argumentIndex cannot convert '#{argument.semanticType.value()}' to '#{target.value()}'")
                    if (argument.semanticType.value() != target.value()) invocationArguments[argumentIndex] =
                        BoundConversionExpression(argument.range, target, argument, conversion)
                    argumentIndex++
                }
                return BoundFunctionInvocationExpression(
                    value.range,
                    BoundReferenceExpression(
                        value.range, localFunction.semanticType,
                        localFunction.name, localFunction.identity
                    ),
                    functionType,
                    invocationArguments
                )
            }
            let arguments = BoundExpression[]
            for (argument in value.argumentValues()) {
                arguments.add(classExpression(
                    argument, receiver, fields, locals, callables
                ))
            }
            let constructorCandidates = callables.filter((candidate) =>
                candidate.callableKind.value == "constructor" &&
                candidate.name == value.name
            )
            if (constructorCandidates.isNotEmpty) {
                return PrimitiveStringAdapter.call(value.name, constructorCandidates, null, arguments,
                    currentTypeResolver.declarationContext, callables, currentHierarchy, callRange: value.range)
            }
            let candidates = callables.filter((candidate) =>
                candidate.name == value.name &&
                candidate.callableKind.value == "instance-method" && receiver &&
                candidate.ownerType.value() == receiver.semanticType.value()
            )
            if (candidates.isNotEmpty) {
                let resolution = OverloadResolver.resolve(
                    value.name, candidates, receiver.semanticType,
                    arguments.map({ _.semanticType }), value.range
                )
                if (!resolution.resolved) throw Exception(resolution.diagnostic.message)
                let target = resolution.selected
                let checked = CallTypeChecker.check(
                    target, receiver.semanticType,
                    arguments.map({ _.semanticType }), value.range
                )
                if (!checked.valid) throw Exception(checked.diagnostic.message)
                return BoundCallExpression(
                    value.range, checked.semanticType, target, receiver,
                    arguments, checked.argumentConversions()
                )
            }
        }
        let result = currentExpressions.bind(
            syntax, locals: locals, callables: callables
        )
        if (!result.succeeded) {
            throw Exception(
                "Structured expression #{syntax.expressionKind()} token #{syntax.range.startTokenIndex}: #{result.diagnostic.message}"
            )
        }
        return result.expression
    }

    localType(
        String name,
        CallableSignature[] callables,
        BoundReferenceExpression receiver
    ) -> SemanticType {
        return currentTypeResolver.resolve(name)
    }

    /** Authority follows the resolved declaration, never a matching identifier spelling or alias. */
    nativeStorageIdentity(BoundExpression expression, LocalBinding[] locals, BoundFieldUnit[] fields) -> SymbolIdentity {
        var SymbolIdentity identity
        if (expression.class.isOfType(BoundReferenceExpression.class)) {
            identity = ((BoundReferenceExpression)expression).symbolIdentity
            let local = locals.firstOrNull({ _.identity.value == identity.value })
            if (local && local.nativeArrayStorage) return identity
        } else if (expression.class.isOfType(BoundMemberAccessExpression.class)) {
            let member = (BoundMemberAccessExpression)expression
            if (member.safeAccess) return null
            identity = member.memberIdentity
        }
        if (!identity) return null
        let field = fields.firstOrNull({ _.identity.value == identity.value })
        return field && field.nativeArrayStorage ? identity : null
    }

    member(
        PrimitiveMemberAccessSyntax syntax,
        BoundReferenceExpression receiver,
        BoundFieldUnit[] fields
    ) -> BoundMemberAccessExpression {
        if (!syntax.receiver.class.isOfType(PrimitiveReferenceSyntax.class) ||
            ((PrimitiveReferenceSyntax)syntax.receiver).name != "this") {
            throw Exception("Reduced field assignment requires 'this'")
        }
        let field = fields.firstOrNull({ _.name == syntax.memberName })
        if (!field) throw Exception("Unknown field '#{syntax.memberName}'")
        return BoundMemberAccessExpression(
            syntax.range, field.semanticType, receiver, field.name, field.identity
        )
    }


    loopLocalType(String name) -> SemanticType {
        if (name == "Int") return SemanticTypes.intType()
        if (name == "Long") return SemanticTypes.longType()
        if (name == "Char") return SemanticTypes.charType()
        if (name == "String") return SemanticTypes.stringType()
        throw Exception("Unsupported for local type '#name'")
    }

    collectionElementType(SemanticType type) -> SemanticType {
        let typeObject = (Object)type
        var ArraySemanticType arrayType
        arrayType = (ArraySemanticType)typeObject
        return arrayType.elementType
    }

    binaryOperator(String assignmentOperator) -> String {
        if (assignmentOperator == "++") return "+"
        if (assignmentOperator == "--") return "-"
        if (assignmentOperator == "+=") return "+"
        if (assignmentOperator == "-=") return "-"
        if (assignmentOperator == "*=") return "*"
        if (assignmentOperator == "/=") return "/"
        if (assignmentOperator == "%=") return "%"
        throw Exception("Unsupported member compound assignment operator '#assignmentOperator'")
    }

    exceptionType(String name, CallableSignature[] callables) -> SemanticType {
        if (name == "String") return SemanticTypes.stringType()
        if (name == "Object") return SemanticTypes.objectType()
        if (name == "Exception") {
            let declarations = callables.filter((candidate) =>
                candidate.callableKind.value == "constructor" &&
                candidate.ownerType.declarationIdentity.name == name)
            if (declarations.count == 1) return declarations.first.ownerType
            return SemanticTypes.objectType()
        }
        throw Exception("Catch type '#name' is not throwable")
    }

    protocolProperty(BoundExpression owner, String name, SourceRange range,
        CallableSignature[] callables) -> BoundExpression {
        let declaration = owner.semanticType.kind() == "generic-instance"
            ? ((GenericInstanceSemanticType)owner.semanticType).declarationType : owner.semanticType
        let candidates = callables.filter((candidate) =>
            candidate.callableKind.value == "instance-method" &&
            candidate.ownerType.value() == declaration.value() &&
            candidate.name == name && candidate.parameterTypes().isEmpty
        ).map((candidate) => owner.semanticType.kind() == "generic-instance" &&
            candidate.ownerGenericDeclaration ? candidate.instantiateReceiver(
                (GenericInstanceSemanticType)owner.semanticType) : candidate)
        if (candidates.count != 1) throw Exception("Iterator protocol requires one '#name' property on '#{owner.semanticType.value()}'")
        let checked = CallTypeChecker.check(candidates.first, owner.semanticType, SemanticType[], range)
        if (!checked.valid) throw Exception(checked.diagnostic.message)
        return BoundCallExpression(range, checked.semanticType, checked.target, owner,
            BoundExpression[], checked.argumentConversions())
    }

    bindCondition(
        PrimitiveExpressionSyntax syntax,
        LocalBinding[] locals,
        CallableSignature[] callables,
        BoundReferenceExpression receiver,
        BoundFieldUnit[] fields,
        BoundStatement[] conditionSetup = null
    ) -> BoundExpression {
        var BoundExpression expression = classExpression(syntax, receiver, fields, locals, callables)
        if (expression.class.isOfType(BoundDeclarationValueExpression.class) && conditionSetup) {
            let declaration = (BoundDeclarationValueExpression)expression
            conditionSetup.add(BoundLocalDeclarationStatement(declaration.range, declaration.local,
                declaration.value, declaration.storageConversion))
            let localObject = (Object)declaration.local
            expression = (BoundExpression)localObject
        }
        return conditionValue(expression, conditionSetup)
    }

    /** Oracle reference conditions test presence; never target-language truthiness. */
    public conditionValue(BoundExpression input, BoundStatement[] conditionSetup = null) -> BoundExpression {
        var BoundExpression expression = input
        let type = expression.semanticType
        if (type.value() == SemanticTypes.boolType().value()) return expression
        if (type.kind() == "generic-parameter" || type.kind() == "nullable" ||
            type.kind() == "user-class" || type.kind() == "generic-instance" ||
            type.kind() == "object" || type.kind() == "string" || type.kind() == "array" ||
            type.kind() == "function") {
            var BoundExpression compared = expression
            if (type.kind() != "generic-parameter" && type.kind() != "nullable") {
                let lifted = NullableSemanticType(type)
                compared = BoundConversionExpression(expression.range, lifted, expression,
                    TypeConversions.classify(type, lifted))
            }
            let present = BoundBinaryExpression(expression.range, SemanticTypes.boolType(), "!=", compared,
                BoundLiteralExpression(expression.range, SemanticTypes.nullType(), "null"))
            if (type.kind() == "nullable") {
                let nullable = (NullableSemanticType)type
                if (nullable.underlyingType.value() == SemanticTypes.boolType().value()) {
                    if (!conditionSetup) throw Exception("Nullable Bool condition requires scoped evaluation")
                    // The declaration path already captured the initializer once.
                    if (!expression.class.isOfType(BoundReferenceExpression.class)) {
                        let identity = SymbolIdentity(DeclarationIdentity(
                            SyntaxIslandIdentity(expression.range.snapshot, "condition-value", expression.range.startTokenIndex),
                            "condition-value", "condition"), "local")
                        let local = BoundReferenceExpression(expression.range, type, "condition", identity)
                        conditionSetup.add(BoundLocalDeclarationStatement(expression.range, local, expression,
                            TypeConversions.classify(type, type)))
                        let retainedObject = (Object)local
                        expression = (BoundExpression)retainedObject
                        let retainedPresent = BoundBinaryExpression(expression.range, SemanticTypes.boolType(), "!=", expression,
                            BoundLiteralExpression(expression.range, SemanticTypes.nullType(), "null"))
                        let retainedValue = BoundConversionExpression(expression.range, SemanticTypes.boolType(), expression,
                            TypeConversions.classify(type, SemanticTypes.boolType(), explicit: true))
                        return BoundBinaryExpression(expression.range, SemanticTypes.boolType(), "&&", retainedPresent, retainedValue)
                    }
                    let value = BoundConversionExpression(expression.range, SemanticTypes.boolType(), expression,
                        TypeConversions.classify(type, SemanticTypes.boolType(), explicit: true))
                    return BoundBinaryExpression(expression.range, SemanticTypes.boolType(), "&&", present, value)
                }
            }
            return present
        }
        throw Exception("Control condition requires Bool")
    }
}
