package flat/semantic/binding/primitive

import flat/compiler/models
import flat/parser/flat
import flat/semantic/types
import flat/semantic/binding/BindingDiagnostic

/** One immutable owner-local declaration view within a finite admitted component. */
class {
    var PrimitiveSourceBindingContext[] sources
    var PrimitiveSourceBindingContext[] lexicalSources
    visible PrimitiveSourceBindingContext owner

    public construct(PrimitiveSourceBindingContext owner, PrimitiveSourceBindingContext[] contexts,
        PrimitiveSourceBindingContext[] lexicalSources = PrimitiveSourceBindingContext[]) {
        if (!owner || !contexts || contexts.any({ !_ })) throw Exception("Resolved declaration scope requires sources")
        this.owner = owner
        sources = PrimitiveSourceBindingContext[]:addAll(contexts)
        this.lexicalSources = PrimitiveSourceBindingContext[]:addAll(lexicalSources)
        if (this.lexicalSources.isEmpty) this.lexicalSources.add(owner)
    }

    public classIdentity(PrimitiveClassSyntax syntax) -> DeclarationIdentity => DeclarationIdentity(
        SyntaxIslandIdentity(syntax.range.snapshot, "class", syntax.range.startTokenIndex), "class", syntax.name)

    public interfaceIdentity(PrimitiveInterfaceSyntax syntax) -> DeclarationIdentity => DeclarationIdentity(
        SyntaxIslandIdentity(syntax.range.snapshot, "interface", syntax.range.startTokenIndex), "interface", syntax.name)

    public candidates(String qualifiedName) -> DeclarationIdentity[] {
        let result = DeclarationIdentity[]
        for (source in sources) {
            for (syntax in source.classValues()) {
                let qualified = source.namespaceName.isEmpty ? syntax.name : "#{source.namespaceName}/#{syntax.name}"
                if (qualified == qualifiedName) {
                    let identity = classIdentity(syntax)
                    if (result.none((existing) => existing.value == identity.value)) result.add(identity)
                }
            }
            for (syntax in source.interfaceValues()) {
                let qualified = source.namespaceName.isEmpty ? syntax.name : "#{source.namespaceName}/#{syntax.name}"
                if (qualified == qualifiedName) {
                    let identity = interfaceIdentity(syntax)
                    if (result.none((existing) => existing.value == identity.value)) result.add(identity)
                }
            }
        }
        return result.sort({ _a.value.compareTo(_b.value) })
    }

    /** Match a class first, otherwise expand exactly the admitted namespace, as Flat imports do. */
    importCandidates(String importedName) -> DeclarationIdentity[] {
        let exact = candidates(importedName)
        if (exact.isNotEmpty) return exact
        let result = DeclarationIdentity[]
        for (source in sources) {
            if (source.namespaceName != importedName) continue
            for (syntax in source.classValues()) result.add(classIdentity(syntax))
            for (syntax in source.interfaceValues()) result.add(interfaceIdentity(syntax))
        }
        return result.sort({ _a.value.compareTo(_b.value) })
    }

    public fail(String code, String name, SourceRange range, DeclarationIdentity[] candidates = DeclarationIdentity[]) {
        throw PrimitiveContextBindingException(BindingDiagnostic(code, name,
            SyntaxIslandIdentity(range.snapshot, "binding-context", range.startTokenIndex), range,
            candidates.map({ _.value })))
    }

    public validateImports() {
        let imports = owner.importValues().sort({ _a.range.startTokenIndex - _b.range.startTokenIndex })
        for (value in imports) {
            if (value.staticImport) fail("binding.import-static-unsupported", value.importedName, value.range)
            if (value.alias != null) fail("binding.import-alias-unsupported", value.importedName, value.range)
            if (value.importedName.contains("*")) fail("binding.import-wildcard-unsupported", value.importedName, value.range)
            let found = importCandidates(value.importedName)
            if (found.isEmpty) fail("binding.import-unresolved", value.importedName, value.range)
            for (selected in found) {
                let conflicts = DeclarationIdentity[]
                for (other in imports) {
                    for (identity in importCandidates(other.importedName)) {
                        if (identity.name == selected.name && conflicts.none({ _.value == identity.value })) {
                            conflicts.add(identity)
                        }
                    }
                }
                if (conflicts.count > 1) fail("binding.import-ambiguous", selected.name, value.range,
                    conflicts.sort({ _a.value.compareTo(_b.value) }))
            }
        }
    }

    /** Fixed language defaults from FileDeclaration.DEFAULT_IMPORTS; only real admitted declarations participate. */
    defaultCandidates(String name) -> DeclarationIdentity[] {
        let locations = ["flat/exception/ExceptionData", "flat/exception/Exception",
            "flat/exception/DivideByZeroException", "flat/primitive/number/Number",
            "flat/primitive/number/Byte", "flat/primitive/number/Short", "flat/primitive/number/Int",
            "flat/primitive/number/Long", "flat/primitive/number/Float", "flat/primitive/number/Double",
            "flat/primitive/Null", "flat/primitive/number/Char", "flat/primitive/Bool",
            "flat/datastruct/list/List", "flat/datastruct/list/Array", "flat/datastruct/list/IntRange",
            "flat/Math", "flat/Object", "flat/String", "flat/meta/Class", "flat/meta/Field", "flat/meta/Function"]
        let result = DeclarationIdentity[]
        for (location in locations) {
            let slash = location.lastIndexOf("/", defaultReturnValue: -1)
            if (location.substring(slash + 1) == name) result.addAll(candidates(location))
        }
        return result.sort({ _a.value.compareTo(_b.value) })
    }

    /** Range-free configuration is diagnosed only at the actual consumer. */
    public configuredTypeCandidates(String name, SourceRange consumerRange) -> DeclarationIdentity[] {
        let found = DeclarationIdentity[]
        for (lexical in lexicalSources) {
            for (value in lexical.defaultImportValues()) {
                if (value.staticImport) continue
                let selected = importCandidates(value.location)
                if (selected.isEmpty && value.location.substring(value.location.lastIndexOf("/") + 1) == name && consumerRange)
                    fail("binding.import-unresolved", value.location, consumerRange)
                for (identity in selected) {
                    if (identity.name == name && found.none({ _.value == identity.value })) found.add(identity)
                }
            }
        }
        return found.sort({ _a.value.compareTo(_b.value) })
    }

    /** Only configured canonical owners which declare this static member are admitted. */
    public staticDefaultOwners(String memberName, SourceRange consumerRange) -> DeclarationIdentity[] {
        let found = DeclarationIdentity[]
        for (lexical in lexicalSources) {
            for (value in lexical.defaultImportValues()) {
                if (!value.staticImport) continue
                let selected = candidates(value.location)
                if (selected.isEmpty) fail("binding.import-unresolved", value.location, consumerRange)
                if (selected.count != 1) fail("binding.import-ambiguous", value.location, consumerRange, selected)
                let syntax = classFor(selected.first)
                if (syntax && syntax.methodValues().any((method) => method.staticMethod && method.name == memberName) &&
                    found.none({ _.value == selected.first.value })) found.add(selected.first)
            }
        }
        return found.sort({ _a.value.compareTo(_b.value) })
    }

    public visibleCandidates(String name, SourceRange consumerRange = null) -> DeclarationIdentity[] {
        if (name.contains("/")) return candidates(name)
        let found = candidates(owner.namespaceName.isEmpty ? name : "#{owner.namespaceName}/#name")
        if (found.isNotEmpty) return found
        for (lexical in lexicalSources) {
            for (value in lexical.importValues()) {
                for (identity in importCandidates(value.importedName)) {
                    if (identity.name == name && found.none({ _.value == identity.value })) found.add(identity)
                }
            }
        }
        if (found.isNotEmpty) return found.sort({ _a.value.compareTo(_b.value) })
        let configured = configuredTypeCandidates(name, consumerRange)
        if (configured.isNotEmpty) return configured
        return defaultCandidates(name)
    }

    /** Canonical spelling is used only while transporting already-resolved syntax type edges. */
    public qualifiedName(DeclarationIdentity identity) -> String {
        for (source in sources) {
            for (syntax in source.classValues()) {
                if (classIdentity(syntax).value == identity.value)
                    return source.namespaceName.isEmpty ? syntax.name : source.namespaceName + "/" + syntax.name
            }
            for (syntax in source.interfaceValues()) {
                if (interfaceIdentity(syntax).value == identity.value)
                    return source.namespaceName.isEmpty ? syntax.name : source.namespaceName + "/" + syntax.name
            }
        }
        throw Exception("Declaration identity is not admitted in this context")
    }

    public resolve(String name, SourceRange range) -> DeclarationIdentity {
        let found = visibleCandidates(name, range)
        if (found.isEmpty) fail("binding.type-unresolved", name, range)
        if (found.count != 1) fail("binding.import-ambiguous", name, range, found)
        return found.first
    }

    public classFor(DeclarationIdentity identity) -> PrimitiveClassSyntax {
        for (source in sources) {
            let syntax = source.classValues().firstOrNull({ classIdentity(_).value == identity.value })
            if (syntax) return syntax
        }
        return null
    }

    public interfaceFor(DeclarationIdentity identity) -> PrimitiveInterfaceSyntax {
        for (source in sources) {
            let syntax = source.interfaceValues().firstOrNull({ interfaceIdentity(_).value == identity.value })
            if (syntax) return syntax
        }
        return null
    }

    public scopeForSnapshot(SourceSnapshotIdentity snapshot) -> PrimitiveResolvedDeclarationContext {
        let source = sources.firstOrNull({ _.snapshot == snapshot })
        if (!source || source == owner) return this
        // Canonical type membership is global to the admitted component, but imports
        // and configured defaults are lexical to the source that wrote this member.
        // Merging target declarations must never merge their import namespaces.
        return PrimitiveResolvedDeclarationContext(source, sources)
    }

    public scopeFor(DeclarationIdentity identity) -> PrimitiveResolvedDeclarationContext {
        let source = sources.firstOrNull((candidate) =>
            candidate.classValues().any((syntax) => classIdentity(syntax).value == identity.value) ||
            candidate.interfaceValues().any((syntax) => interfaceIdentity(syntax).value == identity.value))
        if (!source) throw Exception("Resolved declaration requires an admitted owner")
        return PrimitiveResolvedDeclarationContext(source, sources)
    }
}
