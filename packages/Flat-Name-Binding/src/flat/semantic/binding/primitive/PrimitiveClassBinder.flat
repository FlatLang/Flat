package flat/semantic/binding/primitive

import flat/compiler/models
import flat/parser/flat
import flat/bound
import flat/semantic/types

/** Binds one reduced class with fields, constructor, and instance methods. */
class {
    var GenericParameterSemanticType genericParameter
    var CallableSignature[] constructors
    var UserClassSemanticType boundType
    var CallableSignature arrayGetter
    var CallableSignature arraySetter
    var BoundFieldUnit[] publishedFields
    var PrimitiveClassSyntax boundSyntax
    var PrimitiveInterfaceSyntax[] interfaces = PrimitiveInterfaceSyntax[]
    var TypeHierarchyComponent typeHierarchy
    var PrimitiveStructuralTypeResolver scopedTypeResolver

    var PrimitiveResolvedDeclarationContext declarationContext
    var SourceRange declarationLookupRange
    var LocalBinding[] callbackParameters = LocalBinding[]
    var Int callbackParameterIndex

    public bind(
        PrimitiveClassSyntax syntax,
        SourceSnapshotIdentity snapshot,
        CallableSignature parentConstructor = null,
        BoundFieldUnit[] inheritedFields = BoundFieldUnit[],
        CallableSignature[] availableConstructors = CallableSignature[],
        BoundFieldUnit[] availableFields = BoundFieldUnit[],
        PrimitiveInterfaceSyntax[] interfaceSyntaxValues = PrimitiveInterfaceSyntax[],
        TypeHierarchyComponent hierarchy = null,
        PrimitiveResolvedDeclarationContext resolvedContext = null
    ) -> PrimitiveClassBindingResult {
        if (!syntax || !snapshot || !inheritedFields || inheritedFields.any({ !_ }) ||
            !availableConstructors || availableConstructors.any({ !_ }) ||
            !availableFields || availableFields.any({ !_ }) ||
            !interfaceSyntaxValues || interfaceSyntaxValues.any({ !_ })) {
            throw Exception("Primitive class binding requires syntax snapshot and inherited fields")
        }
        declarationContext = resolvedContext
        declarationLookupRange = syntax.range
        if ((syntax.parentName != null) != (parentConstructor != null) ||
            (!parentConstructor && inheritedFields.isNotEmpty) ||
            (parentConstructor && (parentConstructor.callableKind.value != "constructor" ||
                (resolvedContext ? parentConstructor.ownerType.declarationIdentity.value !=
                    resolvedContext.resolve(syntax.parentName, syntax.range).value :
                    parentConstructor.ownerType.declarationIdentity.name != syntax.parentName)))) {
            throw Exception("Primitive class parent requires its selected constructor signature")
        }
        typeHierarchy = hierarchy
        interfaces = PrimitiveInterfaceSyntax[]:addAll(interfaceSyntaxValues)
        boundSyntax = syntax
        let typeIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", syntax.range.startTokenIndex),
            "class", syntax.name
        )
        let type = UserClassSemanticType(typeIdentity)
        boundType = type
        genericParameter = syntax.genericParameterName ? GenericParameterSemanticType(
            typeIdentity, syntax.genericParameterName, 0
        ) : null
        publishedFields = BoundFieldUnit[]
        publishedFields.addAll(availableFields)
        constructors = CallableSignature[]
        constructors.addAll(availableConstructors)
        var Int constructorSignatureIndex
        while (constructorSignatureIndex < syntax.constructorValues().count) {
            let constructorSyntax = syntax.constructorValues()[constructorSignatureIndex]
            let constructorIdentity = DeclarationIdentity(
                SyntaxIslandIdentity(
                    constructorSyntax.range.snapshot,
                    constructorSignatureIndex == 0 ? "constructor" : "constructor-overload",
                    constructorSyntax.range.startTokenIndex
                ),
                "constructor", syntax.name
            )
            if (!constructors.any({
                _.identity.declaration.value == constructorIdentity.value
            })) constructors.add(CallableSignature(
                SymbolIdentity(constructorIdentity, "constructor"), syntax.name,
                CallableKind("constructor"),
                constructorSyntax.parameterValues().map((parameter) => typeOf(parameter.typeName, parameter.nativeArrayStorage, parameter.nativeScalarStorage)),
                type, type,
                constructorSyntax.parameterValues().filter({ _.defaultValue != null }).count,
                constructorSyntax.parameterValues().map({ _.name }),
                ownerGenericDeclaration: genericParameter ? GenericDeclaration(
                    typeIdentity, [genericParameter], type
                ) : null
            ))
            constructorSignatureIndex++
        }
        arrayGetter = null
        arraySetter = null
        if (syntax.arrayOverrideValues().isNotEmpty) {
            let override = syntax.arrayOverrideValues().first
            let indexType = typeOf(override.indexParameter.typeName)
            let elementType = override.elementTypeName == "inferred"
                ? SemanticTypes.unknownType() : typeOf(override.elementTypeName)
            let ownerGenerics = genericParameter ? GenericDeclaration(
                typeIdentity, [genericParameter], type
            ) : null
            if (override.getterValues().isNotEmpty) {
                let identity = DeclarationIdentity(
                    SyntaxIslandIdentity(
                        override.range.snapshot, "array-getter", override.range.startTokenIndex
                    ),
                    "array-getter", "getAt"
                )
                arrayGetter = CallableSignature(
                    SymbolIdentity(identity, "array-getter"), "getAt",
                    CallableKind("instance-method"), [indexType], elementType, type,
                    ownerGenericDeclaration: ownerGenerics
                )
                constructors.add(arrayGetter)
            }
            if (override.setterValues().isNotEmpty) {
                let identity = DeclarationIdentity(
                    SyntaxIslandIdentity(
                        override.range.snapshot, "array-setter", override.range.startTokenIndex
                    ),
                    "array-setter", "setAt"
                )
                arraySetter = CallableSignature(
                    SymbolIdentity(identity, "array-setter"), "setAt",
                    CallableKind("instance-method"), [indexType, elementType],
                    SemanticTypes.unitType(), type, ownerGenericDeclaration: ownerGenerics
                )
                constructors.add(arraySetter)
            }
        }
        for (method in syntax.methodValues()) {
            let methodKind = method.staticMethod ? "static-method" : "instance-method"
            let methodIdentity = DeclarationIdentity(
                SyntaxIslandIdentity(
                    method.range.snapshot, methodKind, method.range.startTokenIndex
                ),
                methodKind, method.name
            )
            var SemanticType[] parameterTypes = method.parameterValues().map((parameter) =>
                methodTypeResolver(method).resolveParameter(parameter))
            var Int provenanceIndex
            for (parameter in method.parameterValues()) {
                parameterTypes[provenanceIndex] = PrimitiveStructuralTypeResolver(interfaces: interfaces).specializedParameterType(method, provenanceIndex, parameterTypes[provenanceIndex])
                provenanceIndex++
            }
            var Int callbackIndex
            for (parameter in method.parameterValues()) {
                parameterTypes[callbackIndex] = PrimitiveStructuralTypeResolver().withCallbackNames(
                    parameterTypes[callbackIndex], parameter.callbackParameterNames())
                callbackIndex++
            }
            var SemanticType inferredMethodReturn = SemanticTypes.unknownType()
            let methodStatements = method.statements()
            let returnAnchor = methodStatements.isNotEmpty &&
                methodStatements.first.class.isOfType(PrimitiveReturnSyntax.class)
                ? methodStatements.first : methodStatements.isNotEmpty ? methodStatements.last : null
            if (method.inferredReturnType && returnAnchor &&
                returnAnchor.class.isOfType(PrimitiveReturnSyntax.class)) {
                let inferredObject = (Object)returnAnchor
                let inferredSyntax = (PrimitiveReturnSyntax)inferredObject
                if (inferredSyntax.value && inferredSyntax.value.class.isOfType(PrimitiveReferenceSyntax.class) &&
                    ((PrimitiveReferenceSyntax)inferredSyntax.value).name == "this") inferredMethodReturn = type
                if (inferredSyntax.value &&
                    inferredSyntax.value.class.isOfType(PrimitiveReferenceSyntax.class)) {
                    let reference = (PrimitiveReferenceSyntax)inferredSyntax.value
                    var Int parameterIndex
                    for (parameter in method.parameterValues()) {
                        if (parameter.name == reference.name) {
                            inferredMethodReturn = parameterTypes[parameterIndex]
                            break
                        }
                        parameterIndex++
                    }
                }
                if (inferredMethodReturn.kind() == "unknown" && inferredSyntax.value)
                    inferredMethodReturn = methodTypeResolver(method).constructorResult(inferredSyntax.value)
                if (inferredMethodReturn.kind() == "unknown" && inferredSyntax.value) {
                    let inferred = PrimitiveExpressionBinder().bind(inferredSyntax.value)
                    if (inferred.succeeded) inferredMethodReturn = methodTypeResolver(method).inferredExpressionResult(inferred.expression.semanticType)
                }
            }
            var SemanticType declaredMethodReturnType = method.inferredReturnType
                ? inferredMethodReturn
                : method.returnTypeName == "this"
                ? type : methodTypeOf(method.returnTypeName, method)
            let methodReturnType = PrimitiveStructuralTypeResolver(interfaces: interfaces).fallbackResultType(
                method, declaredMethodReturnType)
            let existing = constructors.firstOrNull((candidate) =>
                candidate.identity.declaration.value == methodIdentity.value && candidate.ownerType && candidate.ownerType.value() == type.value()
            )
            let methodGenerics = GenericParameterSemanticType[]
            for (genericName in method.genericParameterNames()) {
                methodGenerics.add(GenericParameterSemanticType(methodIdentity, genericName, methodGenerics.count))
            }
            if (!existing) constructors.add(CallableSignature(
                SymbolIdentity(methodIdentity, methodKind), method.name,
                CallableKind(methodKind), parameterTypes, methodReturnType, type,
                method.parameterValues().filter({ _.defaultValue != null }).count,
                method.parameterValues().map({ _.name }), methodGenerics,
                genericParameter ? GenericDeclaration(typeIdentity, [genericParameter], type) : null
            ))
        }
        let fields = BoundFieldUnit[]
        let fieldSyntaxValues = syntax.fieldValues()
        let fieldParameters = PrimitiveFunctionParameterSyntax[]
        for (constructorSyntax in syntax.constructorValues()) {
            for (parameter in constructorSyntax.parameterValues().filter((value) =>
                value.visibleParameter || value.privateParameter
            )) {
                if (fieldParameters.none({ _.name == parameter.name })) {
                    fieldParameters.add(parameter)
                }
            }
        }
        for (parameter in fieldParameters) {
            let declared = fieldSyntaxValues.firstOrNull({ _.name == parameter.name })
            if (declared && (declared.typeName != parameter.typeName ||
                declared.nativeArrayStorage != parameter.nativeArrayStorage ||
                declared.nativeScalarStorage != parameter.nativeScalarStorage ||
                declared.staticField || declared.visibleField != parameter.visibleParameter)) {
                throw Exception("Constructor parameter conflicts with field '#{parameter.name}'")
            }
        }
        var Int fieldIndex
        while (fieldIndex < fieldSyntaxValues.count) {
            let field = fieldSyntaxValues[fieldIndex]
            let identity = SymbolIdentity(typeIdentity, "field", fieldIndex)
            let fieldRange = SourceRange(
                snapshot, field.range.startTokenIndex, field.range.endTokenIndex,
                field.range.start, field.range.end
            )
            var SemanticType fieldType = typeOf(field.typeName, field.nativeArrayStorage, field.nativeScalarStorage)
            if (fieldParameters.any((parameter) => parameter.name == field.name && nullDefault(parameter))) {
                if (!referenceType(fieldType)) {
                    throw Exception("Primitive field '#{field.name}' cannot be null")
                }
                fieldType = NullableSemanticType(fieldType)
            }
            var BoundExpression initializer
            if (field.initializer) {
                let untyped = PrimitiveExpressionBinder().bind(
                    field.initializer, callables: constructors
                )
                if (!untyped.succeeded) throw Exception(untyped.diagnostic.message)
                if (untyped.expression.semanticType.kind() == "null") {
                    if (!referenceType(fieldType)) {
                        throw Exception("Primitive field '#{field.name}' cannot be null")
                    }
                    fieldType = fieldType.kind() == "nullable" ? fieldType : NullableSemanticType(fieldType)
                    initializer = untyped.expression
                } else {
                    let bound = PrimitiveExpressionBinder().bind(
                        field.initializer, requiredType: fieldType,
                        callables: constructors
                    )
                    if (!bound.succeeded) throw Exception(bound.diagnostic.message)
                    initializer = bound.expression
                }
            }
            fields.add(BoundFieldUnit(
                field.name, identity, fieldType, fieldRange,
                field.visibleField, initializer, field.staticField, field.mutableField,
                nativeArrayStorage: field.nativeArrayStorage
            ))
            fieldIndex++
        }
        for (parameter in fieldParameters) {
            if (fieldSyntaxValues.none({ _.name == parameter.name })) {
                fields.add(BoundFieldUnit(
                    parameter.name, SymbolIdentity(typeIdentity, "field", fieldIndex),
                    nullDefault(parameter) ? NullableSemanticType(
                        typeOf(parameter.typeName, parameter.nativeArrayStorage, parameter.nativeScalarStorage)
                    ) : typeOf(parameter.typeName, parameter.nativeArrayStorage, parameter.nativeScalarStorage),
                    parameter.range, parameter.visibleParameter,
                    nativeArrayStorage: parameter.nativeArrayStorage                ))
                fieldIndex++
            }
        }
        let functions = BoundFunctionUnit[]
        var Int constructorIndex
        while (constructorIndex < syntax.constructorValues().count) {
            functions.add(bindConstructor(
                syntax, syntax.constructorValues()[constructorIndex], constructorIndex,
                typeIdentity, type, fields, parentConstructor, inheritedFields
            ))
            constructorIndex++
        }
        for (override in syntax.arrayOverrideValues()) {
            if (arrayGetter) functions.add(bindArrayOverrideAccessor(
                override, arrayGetter, typeIdentity, type, fields, inheritedFields,
                override.getterValues(), false
            ))
            if (arraySetter) functions.add(bindArrayOverrideAccessor(
                override, arraySetter, typeIdentity, type, fields, inheritedFields,
                override.setterValues(), true
            ))
        }
        let methods = syntax.methodValues()
        let boundMethods = BoundFunctionUnit[]
        for (method in methods) boundMethods.add(null)
        var Int remaining = methods.count
        while (remaining > 0) {
            var Bool progressed
            var Int methodIndex
            while (methodIndex < methods.count) {
                if (boundMethods[methodIndex]) {
                    methodIndex++
                    continue
                }
                let method = methods[methodIndex]
                var Bool pending
                let shadowed = method.parameterValues().map({ _.name })
                for (statement in method.statements()) {
                    if (awaitSameOwnerStatement(statement, type, shadowed)) pending = true
                }
                if (pending) {
                    methodIndex++
                    continue
                }
                try {
                    let boundMethod = bindMethod(method, typeIdentity, type,
                        fields, inheritedFields, methodIndex)
                    boundMethods[methodIndex] = boundMethod
                    remaining--
                    progressed = true
                    var Int signatureIndex
                    while (signatureIndex < constructors.count) {
                        let signature = constructors[signatureIndex]
                        if (signature.identity.declaration.value == boundMethod.identity.value &&
                            signature.ownerType && signature.ownerType.value() == type.value() &&
                            signature.returnType.kind() == "unknown" &&
                            boundMethod.returnType.kind() != "unknown") {
                            constructors[signatureIndex] = CallableSignature(
                                signature.identity, signature.name, signature.callableKind,
                                signature.parameterTypes(), boundMethod.returnType, signature.ownerType,
                                signature.optionalParameterCount, signature.parameterNames(),
                                signature.genericParameters(), signature.ownerGenericDeclaration
                            )
                        }
                        signatureIndex++
                    }
                } catch (Exception error) {
                    throw Exception("Method #{syntax.name}.#{method.name} token #{method.range.startTokenIndex}: #{error.message}")
                }
                methodIndex++
            }
            if (!progressed) throw Exception("Cyclic inferred method return in '#{syntax.name}'")
        }
        functions.addAll(boundMethods)
        let metadata = BoundMetadataUnit[]
        if (genericParameter) {
            metadata.add(BoundMetadataUnit("generic", genericParameter.name, genericParameter.value()))
            metadata.add(BoundMetadataUnit("reified", genericParameter.name, genericParameter.value()))
        }
        for (implementedType in syntax.implementedTypeNames()) {
            metadata.add(BoundMetadataUnit("implements", implementedType, implementedType))
        }
        return PrimitiveClassBindingResult(BoundTypeUnit(
            typeIdentity, type, functions, syntax.range,
            metadataValues: metadata, fieldValues: fields
        ))
    }

    bindConstructor(
        PrimitiveClassSyntax owner,
        PrimitiveConstructorSyntax syntax,
        Int ordinal,
        DeclarationIdentity typeIdentity,
        UserClassSemanticType type,
        BoundFieldUnit[] fields,
        CallableSignature parentConstructor,
        BoundFieldUnit[] inheritedFields
    ) -> BoundFunctionUnit {
        let identity = DeclarationIdentity(
            SyntaxIslandIdentity(
                syntax.range.snapshot,
                ordinal == 0 ? "constructor" : "constructor-overload",
                syntax.range.startTokenIndex
            ),
            "constructor", owner.name
        )
        let parameters = parameters(syntax.parameterValues(), identity)
        var LocalBinding[] locals = localBindings(parameters)
        locals.addAll(inheritedFieldBindings(inheritedFields))
        let allFields = BoundFieldUnit[]
        allFields.addAll(fields)
        allFields.addAll(inheritedFields)
        let ownerFields = publishedFields.filter({
            _.identity.declaration.name == owner.name
        })
        for (publishedField in ownerFields) {
            if (allFields.none({ _.name == publishedField.name })) {
                allFields.add(publishedField)
            }
        }
        for (field in allFields) {
            if (!locals.any({ _.name == field.name })) {
                locals.add(LocalBinding(field.name, field.identity, field.semanticType))
            }
        }
        let receiver = receiver(syntax.range, typeIdentity, type)
        let statements = BoundStatement[]
        for (parameterSyntax in syntax.parameterValues().filter((parameter) =>
            parameter.visibleParameter || parameter.privateParameter
        )) {
            let parameter = parameters.firstOrNull({ _.name == parameterSyntax.name })
            let field = fields.firstOrNull({ _.name == parameterSyntax.name })
            if (!parameter || !field) {
                throw Exception(
                    "Constructor-backed field '#{parameterSyntax.name}' requires its declared field"
                )
            }
            let target = BoundMemberAccessExpression(
                parameterSyntax.range,
                field.semanticType,
                receiver,
                field.name,
                field.identity
            )
            let value = BoundReferenceExpression(
                parameterSyntax.range,
                parameter.semanticType,
                parameter.name,
                parameter.identity
            )
            statements.add(BoundMemberAssignmentStatement(
                parameterSyntax.range,
                target,
                value,
                TypeConversions.classify(value.semanticType, field.semanticType)
            ))
        }
        for (field in fields) {
            if (field.initializer && !field.staticField) {
                let target = BoundMemberAccessExpression(
                    field.range, field.semanticType, receiver, field.name, field.identity
                )
                statements.add(BoundMemberAssignmentStatement(
                    field.range, target, field.initializer,
                    TypeConversions.classify(field.initializer.semanticType, field.semanticType)
                ))
            }
        }
        var BoundConstructorDelegation delegation
        let delegationSyntax = syntax.statements().firstOrNull({
            _.class.isOfType(PrimitiveConstructorDelegationSyntax.class)
        })
        if (delegationSyntax) {
            let value = (PrimitiveConstructorDelegationSyntax)delegationSyntax
            let arguments = BoundExpression[]
            for (argumentSyntax in value.argumentValues()) {
                arguments.add(expression(argumentSyntax, receiver, fields, locals))
            }
            let candidates = constructors.filter((candidate) =>
                candidate.callableKind.value == "constructor" &&
                candidate.ownerType.value() == type.value() &&
                candidate.identity.declaration.value != identity.value
            )
            let resolution = OverloadResolver.resolve(
                owner.name, candidates, null,
                arguments.map({ _.semanticType }), value.range
            )
            if (!resolution.resolved) throw Exception(resolution.diagnostic.message)
            let checked = CallTypeChecker.check(
                resolution.selected, null, arguments.map({ _.semanticType }), value.range
            )
            if (!checked.valid) throw Exception(checked.diagnostic.message)
            delegation = BoundConstructorDelegation(
                resolution.selected, arguments, checked.argumentConversions(), value.range
            )
        }
        var PrimitiveStatementBindingResult bodyBinding
        try {
            bodyBinding = PrimitiveControlStatementBinder().bind(
                PrimitiveStatementSyntaxResult(syntax.statements().filter({
                    !_.class.isOfType(PrimitiveConstructorDelegationSyntax.class)
                })), syntax.range.snapshot,
                locals, constructors, receiver, allFields, arrayGetter, arraySetter,
                publishedFields
            )
        } catch (Exception error) {
            throw Exception("Constructor #{owner.name} token #{syntax.range.startTokenIndex}: #{error.message}")
        }
        statements.addAll(bodyBinding.statements())
        locals = bodyBinding.locals()
        var BoundParentConstructorCall parentCall
        if (parentConstructor && !delegation) {
            let arguments = BoundExpression[]
            for (argumentSyntax in syntax.parentArgumentValues()) {
                arguments.add(expression(argumentSyntax, receiver, fields, locals))
            }
            let checked = CallTypeChecker.check(
                parentConstructor, null, arguments.map({ _.semanticType }), syntax.range
            )
            if (!checked.valid) throw Exception(checked.diagnostic.message)
            parentCall = BoundParentConstructorCall(
                parentConstructor, arguments, checked.argumentConversions(), syntax.range
            )
        } else if (syntax.parentArgumentValues().isNotEmpty) {
            throw Exception("Root constructor cannot delegate to a parent")
        }
        return BoundFunctionUnit(
            identity, owner.name, SemanticTypes.unitType(), statements,
            syntax.range, parameters, constructorFunction: true,
            parentConstructorCall: parentCall,
            constructorDelegation: delegation
        )
    }

    bindConstructorOpaqueCode(
        PrimitiveExternalStatementSyntax syntax,
        LocalBinding[] locals
    ) -> BoundExternalStatement {
        return PrimitiveOpaqueCodeBinder().bind(syntax, locals)
    }

    bindArrayOverrideAccessor(
        PrimitiveArrayOverrideSyntax syntax,
        CallableSignature signature,
        DeclarationIdentity typeIdentity,
        UserClassSemanticType type,
        BoundFieldUnit[] fields,
        BoundFieldUnit[] inheritedFields,
        PrimitiveStatementSyntax[] syntaxStatements,
        Bool setter
    ) -> BoundFunctionUnit {
        if (setter && syntax.elementTypeName == "inferred") {
            if (!arrayGetter || arrayGetter.returnType.kind() == "unknown") {
                throw Exception("Inferred array setter requires resolved getter")
            }
            arraySetter = CallableSignature(signature.identity, signature.name, signature.callableKind,
                [signature.parameterTypes().first, arrayGetter.returnType], SemanticTypes.unitType(),
                signature.ownerType, ownerGenericDeclaration: signature.ownerGenericDeclaration)
        }
        let identity = signature.identity.declaration
        let parameters = BoundFunctionParameter[]
        parameters.add(BoundFunctionParameter(
            syntax.indexParameter.name,
            SymbolIdentity(identity, "parameter", 0),
            signature.parameterTypes().first
        ))
        if (setter) parameters.add(BoundFunctionParameter(
            "value", SymbolIdentity(identity, "parameter", 1),
            (syntax.elementTypeName == "inferred" ? arraySetter : signature).parameterTypes().last
        ))
        let locals = localBindings(parameters)
        let receiver = receiver(syntax.range, typeIdentity, type)
        let allFields = BoundFieldUnit[]
        allFields.addAll(fields)
        allFields.addAll(inheritedFields)
        var CallableSignature effectiveSignature = signature
        if (syntax.elementTypeName == "inferred" && !setter) {
            let inferredResult = PrimitiveControlStatementBinder().bind(
                PrimitiveStatementSyntaxResult(syntaxStatements),
                syntax.range.snapshot, locals, constructors, receiver, allFields,
                arrayGetter, arraySetter, publishedFields
            ).statements()
            let inferredType = firstReturnType(inferredResult)
            if (!inferredType) throw Exception("Inferred array override requires return value")
            effectiveSignature = CallableSignature(
                signature.identity, signature.name, signature.callableKind,
                signature.parameterTypes(), inferredType, signature.ownerType,
                signature.optionalParameterCount, signature.parameterNames(),
                signature.genericParameters(), signature.ownerGenericDeclaration, signature.ownerInstance
            )
            arrayGetter = effectiveSignature
        }
        let bound = PrimitiveControlStatementBinder().bind(
            PrimitiveStatementSyntaxResult(syntaxStatements),
            syntax.range.snapshot, locals, constructors, receiver, allFields,
            arrayGetter, arraySetter, publishedFields
        ).statements()
        validateReturns(
            bound, effectiveSignature.name, effectiveSignature.returnType, false
        )
        return BoundFunctionUnit(
            identity, effectiveSignature.name, effectiveSignature.returnType,
            retypeReturns(bound, effectiveSignature.returnType), syntax.range, parameters
        )
    }

    /** Scoped readiness for calls in for/while/if bodies, returns, and local initializers.
     * Other syntax remains on the existing binding path; this is not a package barrier.
     */
    awaitSameOwnerStatement(PrimitiveStatementSyntax statement, UserClassSemanticType type,
        String[] shadowed) -> Bool {
        if (statement.class.isOfType(PrimitiveForSyntax.class)) {
            let loop = (PrimitiveForSyntax)statement
            let scope = String[]:addAll(shadowed)
            if (loop.initializer) {
                if (awaitSameOwnerExpression(loop.initializer.initializer, type, scope)) return true
                scope.add(loop.initializer.name)
            }
            if (awaitSameOwnerExpression(loop.condition, type, scope) ||
                (loop.advance && awaitSameOwnerExpression(loop.advance.value, type, scope))) return true
            for (nested in loop.bodyValues()) {
                if (awaitSameOwnerStatement(nested, type, scope)) return true
            }
        }
        if (statement.class.isOfType(PrimitiveIfSyntax.class)) {
            let branch = (PrimitiveIfSyntax)statement
            if (awaitSameOwnerExpression(branch.condition, type, shadowed)) return true
            let thenScope = String[]:addAll(shadowed)
            for (nested in branch.thenValues()) {
                if (awaitSameOwnerStatement(nested, type, thenScope)) return true
            }
            let elseScope = String[]:addAll(shadowed)
            for (nested in branch.elseValues()) {
                if (awaitSameOwnerStatement(nested, type, elseScope)) return true
            }
        }
        if (statement.class.isOfType(PrimitiveWhileSyntax.class)) {
            let loop = (PrimitiveWhileSyntax)statement
            if (awaitSameOwnerExpression(loop.condition, type, shadowed)) return true
            let scope = String[]:addAll(shadowed)
            for (nested in loop.bodyValues()) {
                if (awaitSameOwnerStatement(nested, type, scope)) return true
            }
        }
        if (statement.class.isOfType(PrimitiveExpressionStatementSyntax.class))
            return awaitSameOwnerExpression(((PrimitiveExpressionStatementSyntax)statement).expression, type, shadowed)
        if (statement.class.isOfType(PrimitiveReturnSyntax.class))
            return awaitSameOwnerExpression(((PrimitiveReturnSyntax)statement).value, type, shadowed)
        if (statement.class.isOfType(PrimitiveLocalDeclarationSyntax.class)) {
            let local = (PrimitiveLocalDeclarationSyntax)statement
            let pending = awaitSameOwnerExpression(local.initializer, type, shadowed)
            shadowed.add(local.name)
            return pending
        }
        return false
    }

    awaitSameOwnerExpression(PrimitiveExpressionSyntax value, UserClassSemanticType type,
        String[] shadowed) -> Bool {
        if (!value) return false
        if (value.class.isOfType(PrimitiveCallSyntax.class)) {
            let call = (PrimitiveCallSyntax)value
            let candidates = constructors.filter((candidate) => candidate.ownerType &&
                candidate.ownerType.value() == type.value() &&
                (candidate.callableKind.value == "instance-method" ||
                    candidate.callableKind.value == "static-method") && candidate.name == call.name &&
                call.argumentValues().count + call.namedArgumentValues().count >=
                    candidate.parameterTypes().count - candidate.optionalParameterCount &&
                call.argumentValues().count + call.namedArgumentValues().count <=
                    candidate.parameterTypes().count)
            // A local owns lookup. A typed overload must be allowed to resolve
            // without waiting for an unrelated inferred-return counterpart.
            let exactCandidates = candidates.filter({ _.parameterTypes().count ==
                call.argumentValues().count + call.namedArgumentValues().count })
            let readyCandidates = exactCandidates.isNotEmpty ? exactCandidates : candidates
            if (!shadowed.contains(call.name) && readyCandidates.isNotEmpty &&
                readyCandidates.all({ _.returnType.kind() == "unknown" })) return true
            for (argument in call.argumentValues()) {
                if (awaitSameOwnerExpression(argument, type, shadowed)) return true
            }
            for (argument in call.namedArgumentValues()) {
                if (awaitSameOwnerExpression(argument.value, type, shadowed)) return true
            }
        }
        if (value.class.isOfType(PrimitiveMemberCallSyntax.class)) {
            let call = (PrimitiveMemberCallSyntax)value
            if (awaitSameOwnerExpression(call.receiver, type, shadowed)) return true
            for (argument in call.argumentValues()) {
                if (awaitSameOwnerExpression(argument, type, shadowed)) return true
            }
        }
        if (value.class.isOfType(PrimitiveMemberAccessSyntax.class))
            return awaitSameOwnerExpression(((PrimitiveMemberAccessSyntax)value).receiver, type, shadowed)
        if (value.class.isOfType(PrimitiveUnarySyntax.class))
            return awaitSameOwnerExpression(((PrimitiveUnarySyntax)value).operand, type, shadowed)
        if (value.class.isOfType(PrimitiveBinarySyntax.class)) {
            let binary = (PrimitiveBinarySyntax)value
            return awaitSameOwnerExpression(binary.left, type, shadowed) ||
                awaitSameOwnerExpression(binary.right, type, shadowed)
        }
        return false
    }

    bindMethod(
        PrimitiveFunctionSyntax syntax,
        DeclarationIdentity typeIdentity,
        UserClassSemanticType type,
        BoundFieldUnit[] fields,
        BoundFieldUnit[] inheritedFields,
        Int ordinal
    ) -> BoundFunctionUnit {
        let previousResolver = scopedTypeResolver
        let previousContext = declarationContext
        let previousRange = declarationLookupRange
        scopedTypeResolver = methodTypeResolver(syntax)
        declarationContext = scopedTypeResolver.declarationContext
        declarationLookupRange = syntax.range
        try {
            return bindMethodBody(syntax, typeIdentity, type, fields, inheritedFields, ordinal)
        } finally {
            scopedTypeResolver = previousResolver
            declarationContext = previousContext
            declarationLookupRange = previousRange
        }
    }

    bindMethodBody(
        PrimitiveFunctionSyntax syntax,
        DeclarationIdentity typeIdentity,
        UserClassSemanticType type,
        BoundFieldUnit[] fields,
        BoundFieldUnit[] inheritedFields,
        Int ordinal
    ) -> BoundFunctionUnit {
        let methodKind = syntax.staticMethod ? "static-method" : "instance-method"
        let identity = DeclarationIdentity(
            SyntaxIslandIdentity(syntax.range.snapshot, methodKind, syntax.range.startTokenIndex),
            methodKind, syntax.name
        )
        let receiver = syntax.staticMethod
            ? null
            : receiver(syntax.range, typeIdentity, type)
        let allFields = BoundFieldUnit[]
        allFields.addAll(fields)
        allFields.addAll(inheritedFields)
        let ownerFields = publishedFields.filter({
            _.identity.declaration.name == typeIdentity.name
        })
        for (publishedField in ownerFields) {
            if (allFields.none({ _.name == publishedField.name })) {
                allFields.add(publishedField)
            }
        }
        let parameters = parameters(
            syntax.parameterValues(), identity, type, receiver, allFields, syntax
        )
        let locals = localBindings(parameters)
        locals.addAll(inheritedFieldBindings(inheritedFields))
        let publishedSignature = constructors.firstOrNull((candidate) =>
            candidate.identity.declaration.value == identity.value && candidate.ownerType && candidate.ownerType.value() == type.value()
        )
        let publishedInferredReturn = syntax.inferredReturnType && publishedSignature &&
            publishedSignature.returnType.kind() != "unknown"
        let declaredReturnType = publishedInferredReturn
            ? publishedSignature.returnType
            : syntax.returnTypeName == "this" ||
            (type.declarationIdentity.name == "String" &&
             syntax.returnTypeName == "String")
            ? type
            : methodTypeOf(syntax.returnTypeName, syntax)
        var SemanticType returnType = PrimitiveStructuralTypeResolver(interfaces: interfaces).fallbackResultType(
            syntax, declaredReturnType)
        let statements = BoundStatement[]
        let opaqueLocals = LocalBinding[]
        opaqueLocals.addAll(locals)
        if (receiver) {
            opaqueLocals.add(LocalBinding(
                "this", receiver.symbolIdentity, receiver.semanticType
            ))
        }
        let syntaxStatements = syntax.statements()
        var Bool structured
        for (statement in syntaxStatements) {
            if (!statement.class.isOfType(PrimitiveExternalStatementSyntax.class) &&
                !statement.class.isOfType(PrimitiveReturnSyntax.class)) structured = true
        }
        if (structured) {
            let bound = PrimitiveControlStatementBinder().bind(
                PrimitiveStatementSyntaxResult(syntaxStatements),
                syntax.range.snapshot,
                opaqueLocals,
                constructors,
                receiver,
                allFields,
                arrayGetter,
                arraySetter,
                publishedFields,
                methodTypeResolver(syntax), typeHierarchy
            ).statements()
            if (syntax.inferredReturnType) {
                let inferred = firstReturnType(bound)
                if (inferred && !publishedInferredReturn) returnType = methodTypeResolver(syntax).inferredExpressionResult(inferred)
            }
            validateReturns(
                bound, syntax.name, returnType, syntax.inferredReturnType
            )
            statements.addAll(retypeReturns(bound, returnType))
        } else {
            let allFields = BoundFieldUnit[]
            allFields.addAll(fields)
            allFields.addAll(inheritedFields)
            for (statement in syntaxStatements) {
            if (statement.class.isOfType(PrimitiveExternalStatementSyntax.class)) {
                statements.add(PrimitiveOpaqueCodeBinder().bind(
                    (PrimitiveExternalStatementSyntax)statement, opaqueLocals,
                    receiver, allFields, constructors, publishedFields,
                    methodTypeResolver(syntax), typeHierarchy
                ))
                continue
            }
            let returned = (PrimitiveReturnSyntax)statement
            if (!returned.value) throw Exception("Reduced method requires return value")
            var BoundExpression value = expression(
                returned.value, receiver, allFields, opaqueLocals,
                syntax.inferredReturnType && !publishedInferredReturn ? null : returnType
            )
            if (syntax.inferredReturnType && !publishedInferredReturn) {
                returnType = methodTypeResolver(syntax).inferredExpressionResult(value.semanticType)
                value = adaptText(value, returnType)
            }
            var TypeConversion conversion = TypeConversions.classify(
                value.semanticType, returnType, hierarchy: typeHierarchy
            )
            if (!conversion.applicable && value.semanticType.kind() == "unknown") {
                conversion = TypeConversion(
                    value.semanticType, returnType,
                    "deferred-inferred-return", true, false, true, 1000
                )
            }
            if (!conversion.applicable && value.semanticType.kind() == "null" &&
                referenceType(returnType)) {
                conversion = TypeConversion(
                    value.semanticType, returnType,
                    "null-reference-return", true, true, false, 1
                )
            }
            if (!conversion.applicable) {
                throw Exception(
                    "Method '#{syntax.name}' cannot return '#{value.semanticType.value()}' as '#{returnType.value()}'"
                )
            }
            statements.add(BoundReturnStatement(returned.range, returnType, value, conversion))
            }
        }
        if (syntax.returnTypeName == "this" && statements.isNotEmpty) {
            statements.add(BoundReturnStatement(
                syntax.range, type, receiver, TypeConversions.classify(type, type)
            ))
        }
        return BoundFunctionUnit(
            identity, syntax.name, returnType, statements, syntax.range, parameters,
            staticFunction: syntax.staticMethod,
            asyncFunction: syntax.asyncMethod,
            externalName: syntax.externalName,
            abstractFunction: syntax.abstractMethod,
            lazyProperty: syntax.lazyProperty
        )
    }

    firstReturnType(BoundStatement[] statements) -> SemanticType => null {
        for (statement in statements) {
            if (statement.class.isOfType(BoundReturnStatement.class)) {
                let returned = (BoundReturnStatement)statement
                if (returned.value) return returned.value.semanticType
            } else if (statement.class.isOfType(BoundIfStatement.class)) {
                let conditional = (BoundIfStatement)statement
                let thenType = firstReturnType(conditional.thenValues())
                if (thenType) return thenType
                let elseType = firstReturnType(conditional.elseValues())
                if (elseType) return elseType
            } else if (statement.class.isOfType(BoundSwitchStatement.class)) {
                for (caseValue in ((BoundSwitchStatement)statement).caseValues()) {
                    let caseType = firstReturnType(caseValue.statementValues())
                    if (caseType) return caseType
                }
            } else if (statement.class.isOfType(BoundForEachStatement.class)) {
                let bodyType = firstReturnType(
                    ((BoundForEachStatement)statement).body()
                )
                if (bodyType) return bodyType
            } else if (statement.class.isOfType(BoundWhileStatement.class)) {
                let bodyType = firstReturnType(
                    ((BoundWhileStatement)statement).bodyValues()
                )
                if (bodyType) return bodyType
            }
        }
    }

    retypeReturns(
        BoundStatement[] statements,
        SemanticType returnType
    ) -> BoundStatement[] {
        let result = BoundStatement[]
        for (statement in statements) {
            if (statement.class.isOfType(BoundReturnStatement.class)) {
                let returned = (BoundReturnStatement)statement
                let returnedValue = adaptText(returned.value, returnType)
                var TypeConversion conversion = TypeConversions.classify(
                    returnedValue.semanticType, returnType, hierarchy: typeHierarchy
                )
                if (!conversion.applicable &&
                    returned.value.semanticType.kind() == "null" &&
                    referenceType(returnType)) {
                    conversion = TypeConversion(
                        returned.value.semanticType, returnType,
                        "null-reference-return", true, true, false, 1
                    )
                }
                if (!conversion.applicable &&
                    returned.value.semanticType.kind() == "unknown") {
                    conversion = TypeConversion(
                        returned.value.semanticType, returnType,
                        "deferred-inferred-return", true, false, true, 1000
                    )
                }
                result.add(returned.value ? BoundReturnStatement(
                    returned.range, returnType, returnedValue, conversion
                ) : BoundReturnStatement(returned.range, returnType))
            } else if (statement.class.isOfType(BoundIfStatement.class)) {
                let conditional = (BoundIfStatement)statement
                result.add(BoundIfStatement(
                    conditional.range, conditional.condition,
                    retypeReturns(conditional.thenValues(), returnType),
                    retypeReturns(conditional.elseValues(), returnType)
                ))
            } else if (statement.class.isOfType(BoundSwitchStatement.class)) {
                let switched = (BoundSwitchStatement)statement
                let cases = BoundSwitchCase[]
                for (caseValue in switched.caseValues()) {
                    cases.add(BoundSwitchCase(
                        caseValue.range, caseValue.label,
                        retypeReturns(caseValue.statementValues(), returnType),
                        caseValue.defaultCase, caseValue.fallsThrough
                    ))
                }
                result.add(BoundSwitchStatement(
                    switched.range, switched.value, cases
                ))
            } else if (statement.class.isOfType(BoundForEachStatement.class)) {
                let loop = (BoundForEachStatement)statement
                result.add(BoundForEachStatement(
                    loop.range, loop.initialization(), loop.condition,
                    retypeReturns(loop.body(), returnType), loop.advance(),
                    loop.loopLabel, loop.exitLabel
                ))
            } else if (statement.class.isOfType(BoundWhileStatement.class)) {
                let loop = (BoundWhileStatement)statement
                result.add(BoundWhileStatement(
                    loop.range, loop.condition, retypeReturns(loop.bodyValues(), returnType)
                ))
            } else result.add(statement)
        }
        return result
    }

    validateReturns(
        BoundStatement[] statements,
        String methodName,
        SemanticType returnType,
        Bool deferredUnknown = false
    ) {
        for (statement in statements) {
            if (statement.class.isOfType(BoundReturnStatement.class)) {
                let returned = (BoundReturnStatement)statement
                if (!returned.value) {
                    if (returnType.value() != SemanticTypes.unitType().value()) {
                        throw Exception("Method '#methodName' requires a return value")
                    }
                    continue
                }
                var TypeConversion conversion = TypeConversions.classify(
                    adaptText(returned.value, returnType).semanticType, returnType, hierarchy: typeHierarchy
                )
                if (!conversion.applicable &&
                    returned.value.semanticType.kind() == "null" &&
                    referenceType(returnType)) {
                    conversion = TypeConversion(
                        returned.value.semanticType, returnType,
                        "null-reference-return", true, true, false, 1
                    )
                }
                if (!conversion.applicable && deferredUnknown &&
                    returned.value.semanticType.kind() == "unknown") continue
                if (!conversion.applicable) {
                    throw Exception(
                        "Method '#methodName' cannot return '#{returned.value.semanticType.value()}' as '#{returnType.value()}'"
                    )
                }
            } else if (statement.class.isOfType(BoundIfStatement.class)) {
                let conditional = (BoundIfStatement)statement
                validateReturns(conditional.thenValues(), methodName, returnType, deferredUnknown)
                validateReturns(conditional.elseValues(), methodName, returnType, deferredUnknown)
            } else if (statement.class.isOfType(BoundSwitchStatement.class)) {
                for (caseValue in ((BoundSwitchStatement)statement).caseValues()) {
                    validateReturns(
                        caseValue.statementValues(), methodName, returnType, deferredUnknown
                    )
                }
            } else if (statement.class.isOfType(BoundForEachStatement.class)) {
                validateReturns(
                    ((BoundForEachStatement)statement).body(), methodName,
                    returnType, deferredUnknown
                )
            } else if (statement.class.isOfType(BoundWhileStatement.class)) {
                validateReturns(
                    ((BoundWhileStatement)statement).bodyValues(), methodName, returnType, deferredUnknown
                )
            } else if (statement.class.isOfType(BoundTryStatement.class)) {
                let attempted = (BoundTryStatement)statement
                validateReturns(attempted.tryValues(), methodName, returnType, deferredUnknown)
                for (caught in attempted.catchValues()) {
                    validateReturns(caught.statements(), methodName, returnType, deferredUnknown)
                }
                validateReturns(attempted.finallyValues(), methodName, returnType, deferredUnknown)
            }
        }
    }

    inheritedFieldBindings(BoundFieldUnit[] fields) -> LocalBinding[] {
        let result = LocalBinding[]
        for (field in fields) {
            result.add(LocalBinding(field.name, field.identity, field.semanticType))
        }
        return result
    }

    localBindings(BoundFunctionParameter[] parameters) -> LocalBinding[] {
        let result = LocalBinding[]
        for (parameter in parameters) {
            result.add(LocalBinding(parameter.name, parameter.identity, parameter.semanticType))
        }
        return result
    }

    parameters(
        PrimitiveFunctionParameterSyntax[] values,
        DeclarationIdentity owner,
        UserClassSemanticType receiverType = null,
        BoundReferenceExpression receiver = null,
        BoundFieldUnit[] fields = BoundFieldUnit[],
        PrimitiveFunctionSyntax method = null
    ) -> BoundFunctionParameter[] {
        let result = BoundFunctionParameter[]
        var Int index
        while (index < values.count) {
            let value = values[index]
            if (value.defaultValue && values.skip(index + 1).any({ _.defaultValue == null })) {
                throw Exception("Default constructor parameters must be trailing")
            }
            var SemanticType type = method ? methodTypeResolver(method).resolveParameter(value) :
                typeOf(value.typeName, value.nativeArrayStorage, value.nativeScalarStorage)
            if (nullDefault(value) && referenceType(type)) type = NullableSemanticType(type)
            if (method) type = PrimitiveStructuralTypeResolver(interfaces: interfaces).specializedParameterType(method, index, type)
            var BoundExpression defaultValue
            if (value.defaultValue) {
                var PrimitiveExpressionBindingResult bound
                let defaultLocals = LocalBinding[]
                for (parameter in result) {
                    defaultLocals.add(LocalBinding(
                        parameter.name, parameter.identity, parameter.semanticType
                    ))
                }
                if (value.defaultValue.class.isOfType(PrimitiveLambdaSyntax.class)) {
                    bound = PrimitiveExpressionBinder().bind(
                        value.defaultValue, requiredType: type, locals: defaultLocals
                    )
                    if (!bound.succeeded) throw Exception(bound.diagnostic.message)
                    defaultValue = bound.expression
                } else if (receiver) {
                    defaultValue = expression(
                        value.defaultValue, receiver, fields, defaultLocals
                    )
                } else {
                    bound = PrimitiveExpressionBinder().bind(value.defaultValue, locals: defaultLocals)
                    if (!bound.succeeded) throw Exception(bound.diagnostic.message)
                    defaultValue = bound.expression
                }
                defaultValue = adaptText(defaultValue, type)
                var TypeConversion conversion = TypeConversions.classify(
                    defaultValue.semanticType, type, explicit: true
                )
                if (!conversion.applicable) throw Exception(
                    "Primitive expression '#{defaultValue.semanticType.value()}' cannot convert to '#{type.value()}'"
                )
                if (conversion.conversionKind != "identity") {
                    defaultValue = BoundConversionExpression(
                        defaultValue.range, type, defaultValue, conversion
                    )
                }
            }
            result.add(BoundFunctionParameter(
                value.name, SymbolIdentity(owner, "parameter", index), type, defaultValue
            ))
            index++
        }
        return result
    }

    receiver(
        SourceRange range,
        DeclarationIdentity typeIdentity,
        UserClassSemanticType type
    ) -> BoundReferenceExpression => BoundReferenceExpression(
        range, type, "this", SymbolIdentity(typeIdentity, "receiver")
    )

    public bindScopedExpression(
        PrimitiveExpressionSyntax syntax,
        BoundReferenceExpression receiver,
        BoundFieldUnit[] fields,
        LocalBinding[] locals,
        CallableSignature[] callables,
        CallableSignature scopedArrayGetter = null,
        CallableSignature scopedArraySetter = null,
        PrimitiveStructuralTypeResolver typeResolver = null,
        BoundFieldUnit[] availableFields = BoundFieldUnit[],
        TypeHierarchyComponent hierarchy = null
    ) -> BoundExpression {
        if (!availableFields || availableFields.any({ !_ })) {
            throw Exception("Scoped expression requires valid published fields")
        }
        let previousHierarchy = typeHierarchy
        if (hierarchy) typeHierarchy = hierarchy
        let previousFields = publishedFields
        publishedFields = BoundFieldUnit[]
        publishedFields.addAll(availableFields)
        let previousConstructors = constructors
        let previousTypeResolver = scopedTypeResolver
        let previousDeclarationContext = declarationContext
        let previousLookupRange = declarationLookupRange
        if (typeResolver) declarationContext = typeResolver.declarationContext
        declarationLookupRange = syntax.range
        scopedTypeResolver = typeResolver
        let previousBoundType = boundType
        let previousGenericParameter = genericParameter
        if (typeResolver) genericParameter = typeResolver.genericParameter
        let previousArrayGetter = arrayGetter
        let previousArraySetter = arraySetter
        constructors = callables
        if (scopedArrayGetter) arrayGetter = scopedArrayGetter
        if (scopedArraySetter) arraySetter = scopedArraySetter
        if (!boundType && receiver && receiver.semanticType.kind() == "user-class") {
            let receiverObject = (Object)receiver.semanticType
            boundType = (UserClassSemanticType)receiverObject
        }
        try {
            return expression(syntax, receiver, fields, locals)
        } finally {
            typeHierarchy = previousHierarchy
            constructors = previousConstructors
            publishedFields = previousFields
            scopedTypeResolver = previousTypeResolver
            declarationContext = previousDeclarationContext
            declarationLookupRange = previousLookupRange
            boundType = previousBoundType
            genericParameter = previousGenericParameter
            arrayGetter = previousArrayGetter
            arraySetter = previousArraySetter
        }
    }

    /** Member-bearing callback bodies use the same published contracts as ordinary expressions. */
    bindCallback(PrimitiveLambdaSyntax syntax, FunctionSemanticType context,
        LocalBinding[] locals, CallableSignature[] callables,
        TypeHierarchyComponent hierarchy = null,
        FunctionSemanticType originalContract = null) -> PrimitiveExpressionBindingResult {
        let fallbackResult = PrimitiveExpressionBinder().bindCallback(syntax, context, locals,
            callables, hierarchy, originalContract: originalContract)
        if (fallbackResult.succeeded || syntax.statementValues().isNotEmpty || syntax.emptyBody) return fallbackResult
        if (syntax.parameterValues().isNotEmpty &&
            syntax.parameterValues().count != context.parameterTypes().count) return fallbackResult
        let parameters = BoundFunctionParameter[]
        let declared = syntax.parameterValues()
        var Int parameterIndex
        for (type in context.parameterTypes()) {
            let names = context.parameterNames()
            var String name = "_#{parameterIndex + 1}"
            if (declared.isNotEmpty) {
                name = declared[parameterIndex].name
            } else if (names.count > parameterIndex && names[parameterIndex].isNotEmpty) {
                name = "_#{names[parameterIndex]}"
            }
            if (parameters.any({ _.name == name })) return fallbackResult
            if (declared.isNotEmpty && typeOf(declared[parameterIndex].typeName).value() != type.value()) return fallbackResult
            let identity = SymbolIdentity(DeclarationIdentity(
                SyntaxIslandIdentity(syntax.range.snapshot, "lambda", syntax.range.startTokenIndex),
                "lambda-parameter", name), "lambda-parameter", parameterIndex)
            parameterIndex++
            parameters.add(BoundFunctionParameter(name, identity, type))
        }
        let scoped = LocalBinding[]:addAll(locals)
        let previousParameters = callbackParameters
        let previousIndex = callbackParameterIndex
        callbackParameters = LocalBinding[]
        callbackParameterIndex = 0
        for (parameter in parameters) {
            let local = LocalBinding(parameter.name, parameter.identity, parameter.semanticType)
            scoped.add(local)
            if (syntax.parameterValues().isEmpty) {
                callbackParameters.add(local)
                scoped.add(LocalBinding("_#{callbackParameters.count}", parameter.identity, parameter.semanticType))
            }
        }
        try {
            let capturedReceiver = locals.reverse().firstOrNull({ _.name == "this" })
            let receiver = capturedReceiver ? BoundReferenceExpression(syntax.range,
                capturedReceiver.semanticType, "this", capturedReceiver.identity) : null
            let body = expression(syntax.body, receiver, publishedFields, scoped)
            let captures = BoundReferenceExpression[]
            for (local in locals) {
                let selected = locals.reverse().firstOrNull({ _.name == local.name })
                if (selected.identity.value == local.identity.value &&
                    !parameters.any({ _.name == local.name }) &&
                    callbackReferences(body, local.identity.value)) {
                    captures.add(BoundReferenceExpression(syntax.range, local.semanticType, local.name, local.identity))
                }
            }
            return PrimitiveExpressionBindingResult(expression: BoundLambdaExpression(syntax.range,
                FunctionSemanticType(parameters.map({ _.semanticType }), body.semanticType,
                    context.asyncFunction), parameters, captures, body))
        } catch (Exception error) {
            return PrimitiveExpressionBindingResult(diagnostic: PrimitiveExpressionDiagnostic(
                "semantic.primitive-expression", error.message, syntax.range))
        } finally {
            callbackParameters = previousParameters
            callbackParameterIndex = previousIndex
        }
    }

    callbackReferences(BoundExpression value, String identity) -> Bool {
        if (value.class.isOfType(BoundReferenceExpression.class))
            return ((BoundReferenceExpression)value).symbolIdentity.value == identity
        if (value.class.isOfType(BoundMemberAccessExpression.class))
            return callbackReferences(((BoundMemberAccessExpression)value).receiver, identity)
        if (value.class.isOfType(BoundBinaryExpression.class)) {
            let binary = (BoundBinaryExpression)value
            return callbackReferences(binary.left, identity) || callbackReferences(binary.right, identity)
        }
        if (value.class.isOfType(BoundConversionExpression.class))
            return callbackReferences(((BoundConversionExpression)value).value, identity)
        if (value.class.isOfType(BoundCallExpression.class)) {
            let call = (BoundCallExpression)value
            return (call.receiver && callbackReferences(call.receiver, identity)) ||
                call.argumentValues().any({ callbackReferences(_, identity) })
        }
        if (value.class.isOfType(BoundUnaryExpression.class))
            return callbackReferences(((BoundUnaryExpression)value).operand, identity)
        if (value.class.isOfType(BoundLambdaExpression.class))
            return ((BoundLambdaExpression)value).captureValues().any({ _.symbolIdentity.value == identity })
        return false
    }

    expression(
        PrimitiveExpressionSyntax syntax,
        BoundReferenceExpression receiver,
        BoundFieldUnit[] fields,
        LocalBinding[] locals,
        SemanticType requiredType = null,
        FunctionSemanticType originalCallbackContract = null
    ) -> BoundExpression {
        let value = expressionValue(syntax, receiver, fields, locals, requiredType, originalCallbackContract)
        return adaptText(value, requiredType)
    }

    /** Scalar representation changes publish a real, resolved constructor invocation. */
    adaptText(BoundExpression value, SemanticType requiredType) -> BoundExpression {
        if (value && requiredType && requiredType.kind() == "user-class" &&
            ((UserClassSemanticType)requiredType).declarationIdentity.name == "String" &&
            value.semanticType.value() == SemanticTypes.stringType().value()) {
            try {
                return PrimitiveStringAdapter.wrap(value, requiredType, declarationContext, constructors)
            } catch (Exception error) {
                throw Exception("Text representation adapter unavailable: #{error.message}")
            }
        }
        return value
    }

    expressionValue(
        PrimitiveExpressionSyntax syntax,
        BoundReferenceExpression receiver,
        BoundFieldUnit[] fields,
        LocalBinding[] locals,
        SemanticType requiredType = null,
        FunctionSemanticType originalCallbackContract = null
    ) -> BoundExpression {
        if (!syntax) throw Exception("Reduced method expression syntax is required")
        if (syntax.class.isOfType(PrimitiveMemberCallSyntax.class) &&
            ((PrimitiveMemberCallSyntax)syntax).chainNavigation) {
            let chain = (PrimitiveMemberCallSyntax)syntax
            let owner = expression(chain.receiver, receiver, fields, locals)
            let identity = SymbolIdentity(DeclarationIdentity(
                SyntaxIslandIdentity(chain.range.snapshot, "chain-receiver", chain.range.startTokenIndex),
                "local", "chainReceiver"), "local")
            let retained = BoundReferenceExpression(chain.receiver.range, owner.semanticType, "chainReceiver", identity)
            let scoped = LocalBinding[]:addAll(locals)
            scoped.add(LocalBinding("chainReceiver", identity, owner.semanticType))
            let invocationSyntax = PrimitiveMemberCallSyntax(chain.range,
                PrimitiveReferenceSyntax(chain.receiver.range, "chainReceiver"), chain.memberName,
                chain.argumentValues(), chain.namedArgumentValues(), chain.typeArgumentNames(),
                chain.safeAccess, chain.suppressImplicitAwait)
            let invocation = expression(invocationSyntax, receiver, fields, scoped)
            let functionType = FunctionSemanticType([owner.semanticType], owner.semanticType)
            let lambda = BoundLambdaExpression(chain.range, functionType,
                [BoundFunctionParameter("chainReceiver", identity, owner.semanticType)],
                BoundReferenceExpression[], retained, [BoundExpressionStatement(chain.range, invocation),
                    BoundReturnStatement(chain.range, owner.semanticType, retained,
                        TypeConversions.classify(owner.semanticType, owner.semanticType))])
            return BoundFunctionInvocationExpression(chain.range, lambda, functionType, [owner])
        }
        if (syntax.class.isOfType(PrimitiveMemberAccessSyntax.class) &&
            ((PrimitiveMemberAccessSyntax)syntax).safeAccess) {
            let access = (PrimitiveMemberAccessSyntax)syntax
            let owner = expression(access.receiver, receiver, fields, locals)
            let ownerType = owner.semanticType.kind() == "nullable" ?
                ((NullableSemanticType)owner.semanticType).underlyingType : owner.semanticType
            let candidates = BoundFieldUnit[]
            candidates.addAll(fields)
            candidates.addAll(publishedFields)
            let field = candidates.firstOrNull((candidate) =>
                !candidate.staticField && candidate.name == access.memberName &&
                ownerType.value() == "class:#{candidate.identity.declaration.value}")
            if (!field) throw Exception("Safe member requires a resolved instance field")
            let resultType = field.semanticType.kind() == "nullable" ? field.semanticType :
                NullableSemanticType(field.semanticType)
            return BoundMemberAccessExpression(access.range, resultType, owner,
                field.name, field.identity, safeAccess: true)
        }
        if (syntax.class.isOfType(PrimitiveMemberCallSyntax.class) &&
            ((PrimitiveMemberCallSyntax)syntax).safeAccess) {
            let call = (PrimitiveMemberCallSyntax)syntax
            if (call.namedArgumentValues().isNotEmpty || call.typeArgumentNames().isNotEmpty) {
                throw Exception("Safe call requires positional arguments without explicit type arguments")
            }
            let owner = expression(call.receiver, receiver, fields, locals)
            let arguments = BoundExpression[]
            for (argument in call.argumentValues()) arguments.add(expression(argument, receiver, fields, locals))
            let candidates = constructors.filter((candidate) =>
                candidate.callableKind.value == "instance-method" && candidate.name == call.memberName)
            return PrimitiveStringAdapter.call(call.memberName, candidates, owner, arguments,
                declarationContext, constructors, typeHierarchy, safeAccess: true)
        }
        if (requiredType && syntax.class.isOfType(PrimitiveLambdaSyntax.class)) {
            let bound = bindCallback(
                (PrimitiveLambdaSyntax)syntax, (FunctionSemanticType)requiredType,
                locals, constructors, typeHierarchy,
                originalContract: originalCallbackContract
            )
            if (!bound.succeeded) throw Exception(bound.diagnostic.message)
            return bound.expression
        }
        if (!receiver && syntax.class.isOfType(PrimitiveClassNameSyntax.class)) {
            throw Exception("Static method cannot access an instance receiver")
        }
        if (syntax.class.isOfType(PrimitiveInterpolatedStringSyntax.class)) {
            let value = (PrimitiveInterpolatedStringSyntax)syntax
            let segments = BoundInterpolatedStringSegment[]
            for (segment in value.segmentValues()) {
                if (segment.literal()) {
                    segments.add(BoundInterpolatedStringSegment(
                        segment.range, segment.literalSourceValue, null
                    ))
                } else if (segment.expression.class.isOfType(PrimitiveInterpolationPathSyntax.class)) {
                    let path = (PrimitiveInterpolationPathSyntax)segment.expression
                    let parts = path.pathValues()
                    var BoundExpression boundValue
                    if (parts.count == 3 && parts[0] == "this" &&
                        parts[1] == "class" && parts[2] == "name") {
                        if (!receiver) throw Exception("Static method cannot interpolate 'this'")
                        boundValue = BoundClassNameExpression(path.range, receiver)
                    } else if (parts.count == 1) {
                        let local = locals.firstOrNull({ _.name == parts.first })
                        if (local) {
                            boundValue = BoundReferenceExpression(
                                path.range, local.semanticType, local.name, local.identity
                            )
                        } else {
                            let field = fields.firstOrNull({ _.name == parts.first })
                            if (field) {
                                if (!receiver) throw Exception("Static method cannot interpolate instance fields")
                                boundValue = BoundMemberAccessExpression(
                                    path.range, field.semanticType, receiver, field.name, field.identity
                                )
                            } else {
                                let property = constructors.firstOrNull((candidate) =>
                                    candidate.callableKind.value == "instance-method" &&
                                    candidate.name == parts.first && receiver && candidate.ownerType &&
                                    candidate.ownerType.value() == receiver.semanticType.value() &&
                                    candidate.parameterTypes().isEmpty
                                )
                                if (!property) throw Exception("Unknown interpolation root '#{parts.first}'")
                                if (!receiver) throw Exception("Static method cannot interpolate instance properties")
                                let checked = CallTypeChecker.check(
                                    property, receiver.semanticType, SemanticType[], path.range
                                )
                                if (!checked.valid) throw Exception(checked.diagnostic.message)
                                boundValue = BoundCallExpression(
                                    path.range, checked.semanticType, property, receiver,
                                    BoundExpression[], checked.argumentConversions()
                                )
                            }
                        }
                    } else throw Exception("Unsupported interpolation path")
                    segments.add(BoundInterpolatedStringSegment(segment.range, null, boundValue))
                } else {
                    segments.add(BoundInterpolatedStringSegment(
                        segment.range, null,
                        expression(segment.expression, receiver, fields, locals)
                    ))
                }
            }
            return BoundInterpolatedStringExpression(value.range, segments)
        }
        if (syntax.class.isOfType(PrimitiveMemberCallSyntax.class)) {
            let value = (PrimitiveMemberCallSyntax)syntax
            if (value.typeArgumentNames().isNotEmpty &&
                (!value.receiver.class.isOfType(PrimitiveReferenceSyntax.class) ||
                 value.namedArgumentValues().isNotEmpty ||
                 locals.any({ _.name == ((PrimitiveReferenceSyntax)value.receiver).name }) ||
                 fields.any({ _.name == ((PrimitiveReferenceSyntax)value.receiver).name }))) {
                throw Exception("Explicit member type arguments require a positional static call")
            }
            if (value.namedArgumentValues().isNotEmpty) {
                let owner = expression(value.receiver, receiver, fields, locals)
                let declaredString = owner.semanticType.value() ==
                    SemanticTypes.stringType().value() ? constructors.firstOrNull((candidate) =>
                        candidate.callableKind.value == "instance-method" &&
                        candidate.ownerType.declarationIdentity.name == "String" &&
                        candidate.name == value.memberName
                    ) : null
                let candidateReceiverType = declaredString ? declaredString.ownerType : owner.semanticType
                let candidates = constructors.filter((candidate) =>
                    candidate.callableKind.value == "instance-method" &&
                    candidate.ownerType.value() == candidateReceiverType.value() &&
                    candidate.name == value.memberName &&
                    candidate.parameterNames().isNotEmpty &&
                    candidate.parameterTypes().count >= value.argumentValues().count +
                        value.namedArgumentValues().count &&
                    value.namedArgumentValues().all((argument) => candidate.parameterNames().contains(argument.name))
                )
                let checks = CallCheckResult[]
                let calls = BoundExpression[]
                var Int adaptationPass
                // Prefer every ordinary applicable overload before considering text construction.
                while (adaptationPass < 2 && checks.isEmpty) {
                for (candidate in candidates) {
                    let named = candidate.parameterNames()
                    let supplied = BoundExpression[]
                    let omitted = candidate.parameterNames().skip(value.argumentValues().count)
                        .any((name) => !value.namedArgumentValues().any({ _.name == name }))
                    let retainedIdentity = SymbolIdentity(DeclarationIdentity(
                        SyntaxIslandIdentity(value.range.snapshot, "default-receiver", value.range.startTokenIndex),
                        "local", "defaultReceiver"), "local")
                    let retained = BoundReferenceExpression(value.receiver.range, candidateReceiverType,
                        "defaultReceiver", retainedIdentity)
                    let parameters = BoundFunctionParameter[]
                    let inputs = BoundExpression[]
                    let inputTypes = SemanticType[]
                    let inputReferences = BoundExpression[]
                    let statements = BoundStatement[]
                    if (omitted) {
                        parameters.add(BoundFunctionParameter("defaultReceiver", retainedIdentity, candidateReceiverType))
                        inputs.add(adaptText(owner, candidateReceiverType))
                        inputTypes.add(candidateReceiverType)
                        let syntaxes = PrimitiveExpressionSyntax[]:addAll(value.argumentValues())
                        for (namedArgument in value.namedArgumentValues()) syntaxes.add(namedArgument.value)
                        for (inputSyntax in syntaxes) {
                            let input = expression(inputSyntax, receiver, fields, locals)
                            let inputIdentity = SymbolIdentity(retainedIdentity.declaration, "argument", inputs.count)
                            let inputName = "defaultInput#{inputs.count}"
                            parameters.add(BoundFunctionParameter(inputName, inputIdentity, input.semanticType))
                            inputs.add(input)
                            inputTypes.add(input.semanticType)
                            inputReferences.add(BoundReferenceExpression(input.range, input.semanticType, inputName, inputIdentity))
                        }
                    }
                    let defaultLocals = LocalBinding[]
                    var Bool complete = true
                    var Int argumentIndex
                    while (argumentIndex < candidate.parameterTypes().count) {
                        var PrimitiveExpressionSyntax argumentSyntax
                        if (argumentIndex < value.argumentValues().count) {
                            argumentSyntax = value.argumentValues()[argumentIndex]
                        } else {
                            let matching = value.namedArgumentValues().firstOrNull({
                                _.name == named[argumentIndex]
                            })
                            if (matching) argumentSyntax = matching.value
                            else argumentSyntax = namedDefaultSyntax(candidate, argumentIndex)
                        }
                        if (!argumentSyntax) {
                            complete = false
                            break
                        }
                        var Int inputIndex = argumentIndex < value.argumentValues().count ? argumentIndex : -1
                        if (inputIndex < 0) {
                            var Int namedIndex
                            for (namedArgument in value.namedArgumentValues()) {
                                if (namedArgument.name == named[argumentIndex]) inputIndex = value.argumentValues().count + namedIndex
                                namedIndex++
                            }
                        }
                        var BoundExpression argument = omitted ? (inputIndex >= 0 ? inputReferences[inputIndex] :
                            bindNamedDefault(candidate, argumentSyntax, retained, defaultLocals)) :
                            expression(argumentSyntax, receiver, fields, locals)
                        if (adaptationPass == 1 &&
                            !TypeConversions.classify(argument.semanticType,
                                candidate.parameterTypes()[argumentIndex], hierarchy: typeHierarchy).applicable) {
                            try {
                                argument = adaptText(argument, candidate.parameterTypes()[argumentIndex])
                            } catch (Exception error) {
                                complete = false
                                break
                            }
                        }
                        if (omitted) {
                            let parameterIdentity = SymbolIdentity(candidate.identity.declaration, "default-parameter", argumentIndex)
                            let parameterReference = BoundReferenceExpression(argument.range,
                                candidate.parameterTypes()[argumentIndex], named[argumentIndex], parameterIdentity)
                            let conversion = TypeConversions.classify(argument.semanticType, parameterReference.semanticType,
                                hierarchy: typeHierarchy)
                            if (!conversion.applicable) { complete = false; break }
                            statements.add(BoundLocalDeclarationStatement(argument.range, parameterReference, argument, conversion))
                            defaultLocals.add(LocalBinding(named[argumentIndex], parameterIdentity, parameterReference.semanticType))
                            supplied.add(parameterReference)
                        } else supplied.add(argument)
                        argumentIndex++
                    }
                    if (complete) {
                        let checked = CallTypeChecker.check(candidate, candidateReceiverType,
                            supplied.map({ _.semanticType }), value.range, typeHierarchy)
                        if (checked.valid) {
                            checks.add(checked)
                            let invocation = BoundCallExpression(value.range, checked.semanticType, checked.target,
                                omitted ? retained : adaptText(owner, candidateReceiverType), supplied, checked.argumentConversions())
                            if (omitted) {
                                statements.add(BoundReturnStatement(value.range, checked.semanticType, invocation,
                                    TypeConversions.classify(checked.semanticType, checked.semanticType)))
                                let functionType = FunctionSemanticType(inputTypes, checked.semanticType)
                                let lambda = BoundLambdaExpression(value.range, functionType, parameters,
                                    BoundReferenceExpression[], invocation, statements)
                                calls.add(BoundFunctionInvocationExpression(value.range, lambda, functionType, inputs))
                            } else calls.add(invocation)
                        }
                    }
                }
                adaptationPass++
                }
                let resolution = OverloadResolver.resolveChecked(
                    value.memberName, candidates, checks, value.range
                )
                if (resolution.diagnostic) throw Exception(resolution.diagnostic.message)
                var Int selectedIndex
                while (selectedIndex < checks.count) {
                    if (checks[selectedIndex].target.identity.value == resolution.selected.identity.value) return calls[selectedIndex]
                    selectedIndex++
                }
                throw Exception("Resolved named call has no bound invocation")
            }
            if (value.receiver.class.isOfType(PrimitiveEmptyArrayConstructionSyntax.class) &&
                value.memberName == "add" && value.argumentValues().count == 1) {
                let empty = (PrimitiveEmptyArrayConstructionSyntax)value.receiver
                let arrayType = ArraySemanticType(typeOf(empty.elementTypeName))
                let argument = expression(
                    value.argumentValues().first, receiver, fields, locals
                )
                let conversion = TypeConversions.classify(
                    argument.semanticType, arrayType.elementType
                )
                if (!conversion.applicable) throw Exception("Array add argument type mismatch")
                return BoundArrayExpression(value.range, arrayType, [argument])
            }
            if (value.receiver.class.isOfType(PrimitiveReferenceSyntax.class)) {
                let ownerName = ((PrimitiveReferenceSyntax)value.receiver).name
                if (!locals.any({ _.name == ownerName }) &&
                    !fields.any({ _.name == ownerName })) {
                    let ownerIdentity = declarationContext ? declarationContext.resolve(ownerName, value.range) : null
                    var CallableSignature[] staticCandidates = constructors.filter((candidate) =>
                        candidate.callableKind.value == "static-method" &&
                        (ownerIdentity ? candidate.ownerType.declarationIdentity.value == ownerIdentity.value :
                            candidate.ownerType.declarationIdentity.name == ownerName) &&
                        candidate.name == value.memberName
                    )
                    if (value.typeArgumentNames().isNotEmpty) {
                        let arguments = value.typeArgumentNames().map({ typeOf(_) })
                        staticCandidates = staticCandidates.filter({ _.genericParameters().count >= arguments.count }).map((candidate) => {
                            let remaining = candidate.genericParameters().skip(arguments.count)
                            let inferredParameters = GenericParameterSemanticType[]
                            var Int ordinal
                            for (parameter in remaining) inferredParameters.add(GenericParameterSemanticType(
                                parameter.ownerIdentity, parameter.name, ordinal++, parameter.constraint))
                            let explicitSubstitution = GenericSubstitution(candidate.genericParameters().take(arguments.count), arguments)
                            let remainingSubstitution = GenericSubstitution(remaining, inferredParameters.map({ (SemanticType)_ }))
                            return CallableSignature(candidate.identity, candidate.name, candidate.callableKind,
                                candidate.parameterTypes().map({ remainingSubstitution.apply(explicitSubstitution.apply(_)) }),
                                remainingSubstitution.apply(explicitSubstitution.apply(candidate.returnType)), candidate.ownerType,
                                candidate.optionalParameterCount, candidate.parameterNames(), inferredParameters)
                        })
                        if (staticCandidates.isEmpty) throw Exception("Explicit static type argument arity mismatch")
                    }
                    if (staticCandidates.isNotEmpty) {
                        if (value.argumentValues().any({ _.class.isOfType(PrimitiveLambdaSyntax.class) })) {
                            let candidates = staticCandidates.filter({ _.parameterTypes().count == value.argumentValues().count })
                            let checks = CallCheckResult[]
                            let boundCalls = BoundCallExpression[]
                            for (candidate in candidates) {
                            try {
                            let formals = SemanticType[]
                            let actuals = SemanticType[]
                            let arguments = BoundExpression[]
                            var Int index
                            for (argument in value.argumentValues()) {
                                if (argument.class.isOfType(PrimitiveLambdaSyntax.class)) arguments.add(null)
                                else {
                                    let bound = expression(argument, receiver, fields, locals)
                                    arguments.add(bound)
                                    formals.add(candidate.parameterTypes()[index])
                                    actuals.add(bound.semanticType)
                                }
                                index++
                            }
                            var GenericSubstitution substitution = GenericSubstitution(GenericParameterSemanticType[], SemanticType[])
                            if (candidate.genericParameters().isNotEmpty) {
                                let partial = GenericInference.inferPartial(GenericDeclaration(
                                    candidate.identity.declaration, candidate.genericParameters(), candidate.returnType
                                ), formals, actuals, value.range)
                                if (!partial.inferred) throw Exception(partial.diagnostic.message)
                                substitution = partial.substitution
                            }
                            index = 0
                            for (argument in value.argumentValues()) {
                                if (arguments[index] == null) {
                                    let context = substitution.apply(candidate.parameterTypes()[index])
                                    if (context.kind() != "function") throw Exception("Lambda argument requires function parameter")
                                    let callbackLocals = LocalBinding[]:addAll(locals)
                                    if (receiver) callbackLocals.add(LocalBinding("this", receiver.symbolIdentity,
                                        genericParameter ? GenericInstanceSemanticType(boundType, [genericParameter]) : receiver.semanticType))
                                    let bound = bindCallback(
                                        (PrimitiveLambdaSyntax)argument, (FunctionSemanticType)context,
                                        callbackLocals, constructors, typeHierarchy
                                    )
                                    if (!bound.succeeded) throw Exception(bound.diagnostic.message)
                                    arguments[index] = bound.expression
                                }
                                index++
                            }
                            let checked = CallTypeChecker.check(candidate, null,
                                arguments.map({ _.semanticType }), value.range, typeHierarchy)
                            if (checked.valid) {
                                checks.add(checked)
                                boundCalls.add(BoundCallExpression(value.range, checked.semanticType, checked.target,
                                    arguments, checked.argumentConversions()))
                            }
                            } catch (Exception error) {
                                // Invalid contextual bodies reject only their owning candidate.
                            }
                            }
                            let resolution = OverloadResolver.resolveChecked(value.memberName, candidates, checks, value.range)
                            if (!resolution.resolved) throw Exception(resolution.diagnostic.message)
                            return boundCalls.firstOrNull({ _.target.identity.value == resolution.selected.identity.value })
                        }
                        let arguments = BoundExpression[]
                        for (argument in value.argumentValues()) {
                            arguments.add(expression(argument, receiver, fields, locals))
                        }
                        let resolution = OverloadResolver.resolve(
                            value.memberName, staticCandidates, null,
                            arguments.map({ _.semanticType }), value.range
                        )
                        if (!resolution.resolved) throw Exception(resolution.diagnostic.message)
                        let target = resolution.selected
                        let checked = CallTypeChecker.check(
                            target, null, arguments.map({ _.semanticType }), value.range
                        )
                        if (!checked.valid) throw Exception(checked.diagnostic.message)
                        return BoundCallExpression(
                            value.range, checked.semanticType, target,
                            arguments, checked.argumentConversions()
                        )
                    }
                }
            }
            if (!receiver && value.receiver.class.isOfType(PrimitiveReferenceSyntax.class)) {
                let ownerName = ((PrimitiveReferenceSyntax)value.receiver).name
                if (!locals.any({ _.name == ownerName })) {
                    let arguments = BoundExpression[]
                    for (argument in value.argumentValues()) {
                        arguments.add(expression(argument, receiver, fields, locals))
                    }
                    var SemanticType resultType = SemanticTypes.doubleType()
                    if (value.memberName == "abs" && arguments.count == 1) {
                        resultType = arguments.first.semanticType
                    }
                    return BoundNativeCallExpression(
                        value.range, resultType,
                        ownerName + "." + value.memberName,
                        arguments
                    )
                }
            }
            if (value.memberName == "isOfType") {
                if (value.argumentValues().count == 1) {
                    let argument = value.argumentValues().first
                    if (argument.class.isOfType(PrimitiveMemberAccessSyntax.class)) {
                        let metadataAccess = (PrimitiveMemberAccessSyntax)argument
                        if (metadataAccess.memberName == "class") {
                            if (metadataAccess.receiver.class.isOfType(PrimitiveReferenceSyntax.class)) {
                                let referencedName = ((PrimitiveReferenceSyntax)metadataAccess.receiver).name
                                var PrimitiveExpressionSyntax testedSyntax = value.receiver
                                if (testedSyntax.class.isOfType(PrimitiveMemberAccessSyntax.class) &&
                                    ((PrimitiveMemberAccessSyntax)testedSyntax).memberName == "class") {
                                    testedSyntax = ((PrimitiveMemberAccessSyntax)testedSyntax).receiver
                                }
                                var BoundExpression tested = expression(testedSyntax, receiver, fields, locals)
                                if (tested.class.isOfType(BoundClassNameExpression.class)) {
                                    tested = ((BoundClassNameExpression)tested).receiver
                                }
                                return BoundTypeTestExpression(
                                    value.range, tested,
                                    BoundTypeMetadataExpression(
                                        value.range, declaredClassType(referencedName)
                                    )
                                )
                            }
                        }
                    }
                }
            }
            let owner = expression(value.receiver, receiver, fields, locals)
            if (value.argumentValues().any({ _.class.isOfType(PrimitiveLambdaSyntax.class) }) &&
                (owner.semanticType.kind() == "user-class" || owner.semanticType.kind() == "generic-instance")) {
                let instance = owner.semanticType.kind() == "generic-instance" ?
                    (GenericInstanceSemanticType)owner.semanticType : null
                let candidates = constructors.filter((candidate) =>
                    candidate.callableKind.value == "instance-method" &&
                    candidate.name == value.memberName &&
                    candidate.ownerType.value() == (instance ? instance.declarationType.value() : owner.semanticType.value()) &&
                    candidate.parameterTypes().count == value.argumentValues().count
                ).map({ instance ? _.instantiateReceiver(instance) : _ })
                let checks = CallCheckResult[]
                let boundCalls = BoundCallExpression[]
                for (candidate in candidates) {
                    try {
                        let arguments = BoundExpression[]
                        let formals = SemanticType[]
                        let actuals = SemanticType[]
                        var Int index
                        for (argument in value.argumentValues()) {
                            if (argument.class.isOfType(PrimitiveLambdaSyntax.class)) arguments.add(null)
                            else {
                                let bound = expression(argument, receiver, fields, locals)
                                arguments.add(bound)
                                formals.add(candidate.parameterTypes()[index])
                                actuals.add(bound.semanticType)
                            }
                            index++
                        }
                        var GenericSubstitution substitution = GenericSubstitution(GenericParameterSemanticType[], SemanticType[])
                        if (candidate.genericParameters().isNotEmpty) {
                            let partial = GenericInference.inferPartial(GenericDeclaration(
                                candidate.identity.declaration, candidate.genericParameters(), candidate.returnType
                            ), formals, actuals, value.range)
                            if (!partial.inferred) throw Exception(partial.diagnostic.message)
                            substitution = partial.substitution
                        }
                        index = 0
                        for (argument in value.argumentValues()) {
                            if (arguments[index] == null) {
                                let context = substitution.apply(candidate.parameterTypes()[index])
                                if (context.kind() != "function") throw Exception("Lambda argument requires function parameter")
                                let callbackLocals = LocalBinding[]:addAll(locals)
                                if (receiver) callbackLocals.add(LocalBinding("this", receiver.symbolIdentity,
                                    genericParameter ? GenericInstanceSemanticType(boundType, [genericParameter]) : receiver.semanticType))
                                let bound = bindCallback(
                                    (PrimitiveLambdaSyntax)argument, (FunctionSemanticType)context,
                                    callbackLocals, constructors, typeHierarchy)
                                if (!bound.succeeded) throw Exception(bound.diagnostic.message)
                                arguments[index] = bound.expression
                            }
                            index++
                        }
                        let checked = CallTypeChecker.check(candidate, owner.semanticType,
                            arguments.map({ _.semanticType }), value.range, typeHierarchy)
                        if (checked.valid) {
                            checks.add(checked)
                            boundCalls.add(BoundCallExpression(value.range, checked.semanticType, checked.target,
                                owner, arguments, checked.argumentConversions()))
                        }
                    } catch (Exception error) {
                        // Contextual failure rejects this candidate, not unrelated overloads.
                    }
                }
                let resolution = OverloadResolver.resolveChecked(value.memberName, candidates, checks, value.range)
                if (!resolution.resolved) throw Exception(resolution.diagnostic.message)
                return boundCalls.firstOrNull({ _.target.identity.value == resolution.selected.identity.value })
            }
            let arguments = BoundExpression[]
            for (argument in value.argumentValues()) {
                arguments.add(expression(argument, receiver, fields, locals))
            }
            if (owner.semanticType.value() == SemanticTypes.charType().value() &&
                (value.memberName == "toLowerCase" ||
                 value.memberName == "toUpperCase") && arguments.isEmpty) {
                return BoundIntrinsicMemberCallExpression(
                    value.range, SemanticTypes.charType(), owner,
                    value.memberName, arguments
                )
            }
            if (owner.semanticType.value() == SemanticTypes.stringType().value() &&
                value.memberName == "repeat" && arguments.count == 1 &&
                arguments.first.semanticType.value() == SemanticTypes.intType().value()) {
                return BoundIntrinsicMemberCallExpression(
                    value.range, SemanticTypes.stringType(), owner,
                    value.memberName, arguments
                )
            }
            if (owner.semanticType.kind() == "array") {
                let ownerObject = (Object)owner.semanticType
                var ArraySemanticType arrayType
                arrayType = (ArraySemanticType)ownerObject
                if (value.memberName == "map" && arguments.count == 1 &&
                    arguments.first.semanticType.kind() == "function") {
                    let argumentObject = (Object)arguments.first.semanticType
                    var FunctionSemanticType mapperType
                    mapperType = (FunctionSemanticType)argumentObject
                    let returnConversion = TypeConversions.classify(
                        mapperType.returnType, arrayType.elementType
                    )
                    var Bool compatibleReturn = returnConversion.applicable
                    if (!compatibleReturn && mapperType.returnType.kind() == "user-class" &&
                        arrayType.elementType.value() == SemanticTypes.stringType().value()) {
                        let returnObject = (Object)mapperType.returnType
                        var UserClassSemanticType returnClass
                        returnClass = (UserClassSemanticType)returnObject
                        compatibleReturn = returnClass.declarationIdentity.name == "String"
                    }
                    if (mapperType.parameterTypes().isEmpty && compatibleReturn) {
                        return BoundIntrinsicMemberCallExpression(
                            value.range, owner.semanticType, owner,
                            value.memberName, arguments
                        )
                    }
                }
                if (value.memberName == "join" && arguments.isEmpty) {
                    return BoundIntrinsicMemberCallExpression(
                        value.range, SemanticTypes.stringType(), owner,
                        value.memberName, arguments
                    )
                }
            }
            if (value.memberName == "set" && arguments.count == 2 && owner.semanticType.kind() == "generic-instance") {
                let instance = (GenericInstanceSemanticType)owner.semanticType
                let setter = constructors.firstOrNull((candidate) => candidate.identity.symbolKind == "array-setter" &&
                    candidate.ownerType.value() == instance.declarationType.value())
                if (setter) {
                    let target = setter.instantiateReceiver(instance)
                    let checked = CallTypeChecker.check(target, instance,
                        arguments.map({ _.semanticType }), value.range, typeHierarchy)
                    if (!checked.valid) throw Exception(checked.diagnostic.message)
                    return BoundCallExpression(value.range, checked.semanticType, target, owner,
                        arguments, checked.argumentConversions())
                }
            }
            if (value.memberName == "get" && arguments.count == 1 && owner.semanticType.kind() == "generic-instance") {
                let instance = (GenericInstanceSemanticType)owner.semanticType
                let getter = constructors.firstOrNull((candidate) => candidate.identity.symbolKind == "array-getter" &&
                    candidate.ownerType.value() == instance.declarationType.value())
                if (getter) {
                    let target = getter.instantiateReceiver(instance)
                    let checked = CallTypeChecker.check(target, instance,
                        arguments.map({ _.semanticType }), value.range, typeHierarchy)
                    if (!checked.valid) throw Exception(checked.diagnostic.message)
                    return BoundCallExpression(value.range, checked.semanticType, target, owner,
                        arguments, checked.argumentConversions())
                }
            }
            let genericRoot = owner.semanticType.kind() == "generic-parameter" && typeHierarchy ?
                constructors.firstOrNull((candidate) => candidate.ownerType &&
                    typeHierarchy.isRootClass(candidate.ownerType) && candidate.callableKind.value == "instance-method" &&
                    candidate.name == value.memberName) : null
            let candidateReceiverType = genericRoot ? genericRoot.ownerType : owner.semanticType.value() ==
                SemanticTypes.stringType().value() && boundType &&
                boundType.declarationIdentity.name == "String"
                ? boundType : owner.semanticType
            let receiverInstance = candidateReceiverType.kind() == "generic-instance" ?
                (GenericInstanceSemanticType)candidateReceiverType : null
            let candidates = constructors.filter((candidate) =>
                candidate.callableKind.value == "instance-method" &&
                candidate.ownerType.value() == (receiverInstance ?
                    receiverInstance.declarationType.value() : candidateReceiverType.value()) &&
                candidate.name == value.memberName
            ).map({ receiverInstance ? _.instantiateReceiver(receiverInstance) : _ })
            var BoundExpression callOwner = owner
            if (owner.semanticType.value() != candidateReceiverType.value()) {
                if (genericRoot) {
                    callOwner = BoundConversionExpression(value.receiver.range, candidateReceiverType, owner,
                        TypeConversions.classify(owner.semanticType, candidateReceiverType, hierarchy: typeHierarchy))
                } else callOwner = PrimitiveStringAdapter.wrap(owner, candidateReceiverType, declarationContext, constructors)
            }
            return PrimitiveStringAdapter.call(value.memberName, candidates, callOwner,
                arguments, declarationContext, constructors, typeHierarchy)
        }
        if (syntax.class.isOfType(PrimitivePostfixUpdateSyntax.class)) {
            let value = (PrimitivePostfixUpdateSyntax)syntax
            if (!value.operand.class.isOfType(PrimitiveReferenceSyntax.class)) {
                throw Exception("Postfix update requires a local reference")
            }
            let reference = (PrimitiveReferenceSyntax)value.operand
            let local = locals.reverse().firstOrNull({ _.name == reference.name })
            var BoundExpression target
            if (local) {
                target = BoundReferenceExpression(
                    value.range, local.semanticType, local.name, local.identity
                )
            } else {
                let field = fields.firstOrNull({ _.name == reference.name })
                if (!field || !receiver) {
                    throw Exception("Unknown postfix update local '#{reference.name}'")
                }
                if (!field.mutableField) {
                    throw Exception("Postfix update requires mutable field '#{reference.name}'")
                }
                target = BoundMemberAccessExpression(
                    value.range, field.semanticType, receiver,
                    field.name, field.identity
                )
            }
            let one = BoundLiteralExpression(value.range, SemanticTypes.intType(), "1")
            let typed = TypeOperations.binary(
                value.updateOperator == "++" ? "+" : "-",
                target.semanticType, one.semanticType, value.range
            )
            if (!typed.valid ||
                typed.semanticType.value() != target.semanticType.value()) {
                throw Exception("Postfix update requires a numeric local")
            }
            return BoundPostfixUpdateExpression(
                value.range, target.semanticType, target, value.updateOperator
            )
        }
        if (syntax.class.isOfType(PrimitiveAssignmentValueSyntax.class)) {
            let value = (PrimitiveAssignmentValueSyntax)syntax
            let local = locals.reverse().firstOrNull({ _.name == value.name })
            if (!local) throw Exception("Unknown assignment local '#{value.name}'")
            let target = BoundReferenceExpression(
                value.range, local.semanticType, local.name, local.identity
            )
            let assigned = expression(value.value, receiver, fields, locals)
            let conversion = TypeConversions.classify(
                assigned.semanticType, target.semanticType
            )
            if (!conversion.applicable) throw Exception("Assignment value type mismatch")
            return BoundAssignmentValueExpression(
                value.range, target.semanticType, target, assigned, conversion
            )
        }
        if (syntax.class.isOfType(PrimitiveDeclarationValueSyntax.class)) {
            let value = (PrimitiveDeclarationValueSyntax)syntax
            if (locals.any({ _.name == value.name })) {
                throw Exception("Duplicate declaration local '#{value.name}'")
            }
            let initialized = expression(value.value, receiver, fields, locals)
            var SemanticType localType = initialized.semanticType
            if (localType.kind() == "unknown") localType = SemanticTypes.intType()
            let identity = SymbolIdentity(
                DeclarationIdentity(
                    SyntaxIslandIdentity(
                        value.range.snapshot, "declaration-value", value.range.startTokenIndex
                    ),
                    "declaration-value", value.name
                ),
                "local"
            )
            let local = BoundReferenceExpression(
                value.range, localType, value.name, identity
            )
            locals.add(LocalBinding(value.name, identity, localType))
            let storage = initialized.semanticType.kind() == "unknown"
                ? TypeConversion(
                    initialized.semanticType, localType,
                    "deferred-declaration-value", true, false, true, 1000
                )
                : TypeConversions.classify(initialized.semanticType, localType)
            return BoundDeclarationValueExpression(
                value.range, localType, local, initialized, storage
            )
        }
        if (syntax.class.isOfType(PrimitiveArrayAccessSyntax.class)) {
            let value = (PrimitiveArrayAccessSyntax)syntax
            var BoundExpression indexedReceiver = expression(
                value.receiver, receiver, fields, locals
            )
            if (indexedReceiver.semanticType.kind() == "unknown" &&
                value.receiver.class.isOfType(PrimitiveReferenceSyntax.class)) {
                let receiverName = ((PrimitiveReferenceSyntax)value.receiver).name
                let local = locals.reverse().firstOrNull({ _.name == receiverName })
                let receiverCall = constructors.firstOrNull((candidate) =>
                    local && candidate.callableKind.value == "instance-method" &&
                    candidate.ownerType.value() == local.semanticType.value() &&
                    candidate.name == "getAt" && candidate.parameterTypes().count == 1
                )
                if (receiverCall) indexedReceiver = BoundReferenceExpression(
                    value.receiver.range, receiverCall.ownerType,
                    local.name, local.identity
                )
            }
            let index = expression(value.index, receiver, fields, locals)
            if (indexedReceiver.semanticType.kind() == "user-class" ||
                indexedReceiver.semanticType.kind() == "generic-instance") {
                let indexedType = indexedReceiver.semanticType
                let indexedOwner = indexedType.kind() == "generic-instance"
                    ? ((GenericInstanceSemanticType)indexedType).declarationType.value()
                    : indexedType.value()
                var CallableSignature getter
                if (arrayGetter && arrayGetter.ownerType.value() == indexedOwner) {
                    getter = arrayGetter
                } else getter = constructors.firstOrNull((candidate) =>
                    candidate.identity.symbolKind == "array-getter" &&
                    candidate.ownerType.value() == indexedOwner
                )
                if (getter) {
                    let selected = indexedType.kind() == "generic-instance" &&
                        getter.ownerGenericDeclaration ? getter.instantiateReceiver(
                            (GenericInstanceSemanticType)indexedType
                        ) : getter
                    let checked = CallTypeChecker.check(
                        selected, indexedType, [index.semanticType], value.range
                    )
                    if (!checked.valid) throw Exception(checked.diagnostic.message)
                    return BoundCallExpression(
                        value.range, checked.semanticType, selected, indexedReceiver,
                        [index], checked.argumentConversions()
                    )
                }
            }
            if (indexedReceiver.semanticType.kind() != "array") {
                throw Exception("Array access requires an array or indexed class receiver")
            }
            let typeObject = (Object)indexedReceiver.semanticType
            var ArraySemanticType arrayType
            arrayType = (ArraySemanticType)typeObject
            return BoundArrayAccessExpression(
                value.range, arrayType.elementType, indexedReceiver, index
            )
        }
        if (syntax.class.isOfType(PrimitiveArrayConstructionSyntax.class)) {
            let value = (PrimitiveArrayConstructionSyntax)syntax
            let size = expression(value.size, receiver, fields, locals)
            if (size.semanticType.value() != SemanticTypes.intType().value()) {
                throw Exception("Array construction size requires Int")
            }
            return BoundArrayExpression(
                value.range, ArraySemanticType(typeOf(value.elementTypeName)), size
            )
        }
        if (syntax.class.isOfType(PrimitiveEmptyArrayConstructionSyntax.class)) {
            let value = (PrimitiveEmptyArrayConstructionSyntax)syntax
            let type = declarationContext ? typeOf(value.elementTypeName + "[]") : ArraySemanticType(typeOf(value.elementTypeName))
            if (type.kind() == "generic-instance") {
                return expression(PrimitiveConstructionSyntax(value.range, "Array", PrimitiveExpressionSyntax[],
                    [value.elementTypeName]), receiver, fields, locals)
            }
            return BoundArrayExpression(value.range, (ArraySemanticType)type, BoundExpression[])
        }
        if (syntax.class.isOfType(PrimitiveMemberAssignmentValueSyntax.class)) {
            let value = (PrimitiveMemberAssignmentValueSyntax)syntax
            let targetObject = expression(value.target, receiver, fields, locals)
            if (!targetObject.class.isOfType(BoundMemberAccessExpression.class)) throw Exception("Member assignment value requires a stored field")
            let target = (BoundMemberAccessExpression)targetObject
            if (target.safeAccess) throw Exception("Safe member assignment is not supported")
            let operand = expression(value.value, receiver, fields, locals)
            let operator = compoundOperator(value.assignmentOperator)
            let typed = TypeOperations.binary(
                operator, target.semanticType, operand.semanticType, value.range
            )
            if (!typed.valid) throw Exception(typed.diagnostic.message)
            let conversion = TypeConversions.classify(
                typed.semanticType, target.semanticType
            )
            if (!conversion.applicable) throw Exception("Member assignment value type mismatch")
            return BoundMemberAssignmentValueExpression(
                value.range, typed.semanticType, target, operator, operand, conversion
            )
        }
        if (syntax.class.isOfType(PrimitiveCastSyntax.class)) {
            let value = (PrimitiveCastSyntax)syntax
            let operand = expression(value.value, receiver, fields, locals)
            var SemanticType target
            if (boundType && value.typeName == boundType.declarationIdentity.name) {
                target = boundType
            } else target = typeOf(value.typeName)
            let conversion = TypeConversions.classify(
                operand.semanticType, target, explicit: true, hierarchy: typeHierarchy
            )
            if (!conversion.applicable) {
                throw Exception(
                    "Invalid reduced cast '#{operand.semanticType.value()}' to '#{target.value()}'"
                )
            }
            return BoundConversionExpression(
                value.range, target, operand, conversion
            )
        }
        if (syntax.class.isOfType(PrimitiveClassNameSyntax.class)) {
            let value = (PrimitiveClassNameSyntax)syntax
            let reflected = expression(value.receiver, receiver, fields, locals)
            return BoundClassNameExpression(value.range, reflected)
        }
        if (syntax.class.isOfType(PrimitiveConditionalSyntax.class)) {
            let value = (PrimitiveConditionalSyntax)syntax
            let condition = PrimitiveControlStatementBinder().conditionValue(expression(
                value.condition, receiver, fields, locals
            ))
            var BoundExpression whenTrue = expression(
                value.whenTrue, receiver, fields, locals, requiredType
            )
            var BoundExpression whenFalse = expression(
                value.whenFalse, receiver, fields, locals, requiredType
            )
            if (requiredType) {
                var TypeConversion trueConversion = TypeConversions.classify(
                    whenTrue.semanticType, requiredType, explicit: true
                )
                var TypeConversion falseConversion = TypeConversions.classify(
                    whenFalse.semanticType, requiredType, explicit: true
                )
                if (!trueConversion.applicable || !falseConversion.applicable) {
                    throw Exception("Reduced conditional branches cannot convert to required type")
                }
                if (trueConversion.conversionKind != "identity") {
                    whenTrue = BoundConversionExpression(
                        value.whenTrue.range, requiredType, whenTrue, trueConversion
                    )
                }
                if (falseConversion.conversionKind != "identity") {
                    whenFalse = BoundConversionExpression(
                        value.whenFalse.range, requiredType, whenFalse, falseConversion
                    )
                }
            }
            if (!requiredType) {
                if (whenTrue.semanticType.kind() == "string" && whenFalse.semanticType.kind() == "user-class")
                    whenTrue = adaptText(whenTrue, whenFalse.semanticType)
                else if (whenFalse.semanticType.kind() == "string" && whenTrue.semanticType.kind() == "user-class")
                    whenFalse = adaptText(whenFalse, whenTrue.semanticType)
            }
            let joined = TypeOperations.conditional(condition.semanticType, whenTrue.semanticType, whenFalse.semanticType, value.range)
            if (!joined.valid) throw Exception(joined.diagnostic.message)
            let trueJoin = TypeConversions.classify(whenTrue.semanticType, joined.semanticType)
            let falseJoin = TypeConversions.classify(whenFalse.semanticType, joined.semanticType)
            if (trueJoin.conversionKind != "identity") whenTrue = BoundConversionExpression(
                value.whenTrue.range, joined.semanticType, whenTrue, trueJoin)
            if (falseJoin.conversionKind != "identity") whenFalse = BoundConversionExpression(
                value.whenFalse.range, joined.semanticType, whenFalse, falseJoin)
            return BoundConditionalExpression(
                value.range, joined.semanticType, condition, whenTrue, whenFalse
            )
        }
        if (syntax.class.isOfType(PrimitiveUnarySyntax.class)) {
            let value = (PrimitiveUnarySyntax)syntax
            let operand = expression(value.operand, receiver, fields, locals)
            if (value.operator == "++" || value.operator == "--") {
                return PrimitiveExpressionBinder.bindPrefixUpdate(value.range, value.operator, operand)
            }
            if (value.operator == "!") {
                if (receiver) {
                    let operandTypeValue = operand.semanticType.value()
                    let receiverTypeValue = receiver.semanticType.value()
                    if (operandTypeValue == receiverTypeValue) {
                        var BoundFieldUnit truthField
                        for (field in fields) {
                            if (field.name == "value") truthField = field
                        }
                        if (truthField && truthField.semanticType.value() ==
                            SemanticTypes.boolType().value()) {
                            let truthValue = BoundMemberAccessExpression(
                                value.range, truthField.semanticType, receiver,
                                truthField.name, truthField.identity
                            )
                            return BoundUnaryExpression(
                                value.range, SemanticTypes.boolType(), value.operator, truthValue
                            )
                        }
                        let truthValue = BoundConversionExpression(
                            value.range, SemanticTypes.boolType(), operand,
                            TypeConversion(
                                operand.semanticType, SemanticTypes.boolType(),
                                "object-truthiness", true, true, false, 10
                            )
                        )
                        return BoundUnaryExpression(
                            value.range, SemanticTypes.boolType(), value.operator, truthValue
                        )
                    }
                }
            }
            if (value.operator == "!") {
                let absence = PrimitiveExpressionBinder.bindReferenceNegation(value.range, operand)
                if (absence) return absence
            }
            let typed = TypeOperations.unary(value.operator, operand.semanticType, value.range)
            if (!typed.valid) throw Exception(typed.diagnostic.message)
            return BoundUnaryExpression(
                value.range, typed.semanticType, value.operator, operand
            )
        }
        if (syntax.class.isOfType(PrimitiveBinarySyntax.class)) {
            let value = (PrimitiveBinarySyntax)syntax
            var BoundExpression left = expression(value.left, receiver, fields, locals)
            var BoundExpression right = expression(value.right, receiver, fields, locals)
            if ((value.operator == "==" || value.operator == "!=") &&
                left.semanticType.value() == boundType.value() &&
                right.semanticType.kind() == "primitive") {
                let valueField = fields.firstOrNull({ _.name == "value" })
                if (!valueField || valueField.semanticType.value() != right.semanticType.value()) {
                    throw Exception("Reduced primitive wrapper comparison requires matching value field")
                }
                left = BoundMemberAccessExpression(
                    value.left.range, valueField.semanticType, left,
                    valueField.name, valueField.identity
                )
            }
            if ((value.operator == "==" || value.operator == "!=") &&
                left.semanticType.value() == SemanticTypes.boolType().value() &&
                right.semanticType.value() == boundType.value()) {
                let truthField = fields.firstOrNull({ _.name == "value" })
                if (!truthField) throw Exception("Reduced Bool comparison requires value field")
                right = BoundMemberAccessExpression(
                    value.right.range, truthField.semanticType, right,
                    truthField.name, truthField.identity
                )
            }
            if (value.operator == "||" || value.operator == "&&") {
                left = logicalOperand(left)
                right = logicalOperand(right)
            }
            if ((value.operator == "||" || value.operator == "&&") &&
                right.semanticType.kind() == "unknown") {
                right = BoundConversionExpression(
                    value.right.range, SemanticTypes.boolType(), right,
                    TypeConversion(
                        right.semanticType, SemanticTypes.boolType(),
                        "deferred-bool-result", true, false, true, 1000
                    )
                )
            }
            if ((value.operator == "==" || value.operator == "!=" ||
                 value.operator == ">=" || value.operator == ">" ||
                 value.operator == "<=" || value.operator == "<") &&
                left.semanticType.kind() == "unknown" &&
                right.semanticType.kind() != "unknown") {
                left = BoundConversionExpression(
                    value.left.range, right.semanticType, left,
                    TypeConversion(
                        left.semanticType, right.semanticType,
                        "deferred-comparison-operand", true, false, true, 1000
                    )
                )
            }
            if (value.operator == "+") {
                let resolved = PrimitiveStringAdapter.plus(left, right, declarationContext, constructors, typeHierarchy)
                if (resolved) return resolved
            }
            if (value.operator == "+" && boundType &&
                boundType.declarationIdentity.name == "String" &&
                left.semanticType.value() == boundType.value() &&
                right.semanticType.value() == boundType.value()) {
                left = BoundConversionExpression(
                    value.left.range, SemanticTypes.stringType(), left,
                    PrimitiveStringAdapter.unsupported(
                        left.semanticType, SemanticTypes.stringType(),
                        "declared-string-operator", true, false, true, 0
                    )
                )
                right = BoundConversionExpression(
                    value.right.range, SemanticTypes.stringType(), right,
                    PrimitiveStringAdapter.unsupported(
                        right.semanticType, SemanticTypes.stringType(),
                        "declared-string-operator", true, false, true, 0
                    )
                )
            }
            let typed = TypeOperations.binary(
                value.operator, left.semanticType, right.semanticType, value.range
            )
            if (!typed.valid) throw Exception(typed.diagnostic.message)
            return BoundBinaryExpression(
                value.range, typed.semanticType, value.operator, left, right
            )
        }
        if (syntax.class.isOfType(PrimitiveReferenceSyntax.class)) {
            let value = (PrimitiveReferenceSyntax)syntax
            if (callbackParameters.isNotEmpty && !locals.any({ _.name == value.name })) {
                var LocalBinding implicitValue
                if (value.name == "_") {
                    if (callbackParameterIndex >= callbackParameters.count) throw Exception("Too many implicit callback parameters")
                    implicitValue = callbackParameters[callbackParameterIndex]
                    callbackParameterIndex++
                } else if (value.name == "_x") {
                    implicitValue = callbackParameters.first
                } else if (value.name == "_i" && callbackParameters.count > 1) {
                    implicitValue = callbackParameters[1]
                }
                if (implicitValue) return BoundReferenceExpression(value.range, implicitValue.semanticType, implicitValue.name, implicitValue.identity)
            }
            let local = locals.reverse().firstOrNull({ _.name == value.name })
            if (local) {
                if (value.name == "this" && genericParameter && receiver &&
                    local.identity.value == receiver.symbolIdentity.value) {
                    return BoundReferenceExpression(value.range,
                        GenericInstanceSemanticType(boundType, [genericParameter]), local.name, local.identity)
                }
                return BoundReferenceExpression(
                    value.range, local.semanticType, local.name, local.identity
                )
            }
            if (value.name == "this") {
                if (!receiver) throw Exception("Static method cannot reference 'this'")
                if (genericParameter) {
                    return BoundReferenceExpression(value.range,
                        GenericInstanceSemanticType(boundType, [genericParameter]),
                        receiver.name, receiver.symbolIdentity)
                }
                return receiver
            }
            let field = fields.firstOrNull({ _.name == value.name })
            if (field) {
                if (!receiver) throw Exception("Static method cannot access instance field '#{field.name}'")
                return BoundMemberAccessExpression(
                    value.range, field.semanticType, receiver, field.name, field.identity
                )
            }
            let properties = constructors.filter((candidate) =>
                candidate.callableKind.value == "instance-method" && receiver &&
                candidate.ownerType.value() == receiver.semanticType.value() &&
                candidate.name == value.name && candidate.parameterTypes().isEmpty
            )
            if (properties.isNotEmpty) {
                let resolution = OverloadResolver.resolve(
                    value.name, properties, receiver.semanticType,
                    SemanticType[], value.range
                )
                if (!resolution.resolved) throw Exception(resolution.diagnostic.message)
                let target = resolution.selected
                let checked = CallTypeChecker.check(
                    target, receiver.semanticType, SemanticType[], value.range
                )
                if (!checked.valid) throw Exception(checked.diagnostic.message)
                return BoundCallExpression(
                    value.range, checked.semanticType, target, receiver,
                    BoundExpression[], checked.argumentConversions()
                )
            }
            throw Exception("Unknown constructor/method name '#{value.name}'")
        }
        if (syntax.class.isOfType(PrimitiveConstructionSyntax.class)) {
            let value = (PrimitiveConstructionSyntax)syntax
            let typeArguments = value.typeArgumentNames()
            let arguments = BoundExpression[]
            for (argument in value.argumentValues()) {
                if (argument.class.isOfType(PrimitiveMemberAccessSyntax.class)) {
                    let access = (PrimitiveMemberAccessSyntax)argument
                    if (access.receiver.class.isOfType(PrimitiveReferenceSyntax.class)) {
                        let receiverName = ((PrimitiveReferenceSyntax)access.receiver).name
                        let local = locals.reverse().firstOrNull({ _.name == receiverName })
                        if (local && local.semanticType.kind() == "array" &&
                            access.memberName == "count") {
                            arguments.add(BoundArrayLengthExpression(
                                access.range, BoundReferenceExpression(
                                    access.receiver.range, local.semanticType,
                                    local.name, local.identity
                                )
                            ))
                            continue
                        }
                    }
                }
                arguments.add(expression(argument, receiver, fields, locals))
            }
            let resolvedOwner = declarationContext ? declarationContext.resolve(value.typeName, value.range) : null
            // Resolve the complete generic spelling so constructor arguments use
            // the same identity contract as annotations (not scalar String).
            let constructedType = declarationContext && typeArguments.isNotEmpty ?
                (GenericInstanceSemanticType)typeOf(value.typeName + "<" + typeArguments.join(",") + ">") : null
            let candidates = constructors.filter((candidate) =>
                candidate.callableKind.value == "constructor" &&
                (resolvedOwner ? candidate.ownerType.declarationIdentity.value == resolvedOwner.value :
                    candidate.name == value.typeName)
            ).map((candidate) => typeArguments.isEmpty ? candidate :
                candidate.instantiateConstructor(constructedType ? constructedType.typeArguments() : typeArguments.map({ typeOf(_) })))
            if (candidates.isEmpty && value.typeName == "Array" &&
                typeArguments.count == 1 && arguments.count == 1) {
                if (arguments.first.semanticType.value() != SemanticTypes.intType().value()) {
                    throw Exception("Array construction size requires Int")
                }
                return BoundArrayExpression(value.range,
                    ArraySemanticType(typeOf(typeArguments.first)), arguments.first)
            }
            return PrimitiveStringAdapter.call(value.typeName, candidates, null, arguments,
                declarationContext, constructors, typeHierarchy, callRange: value.range)
        }
        if (syntax.class.isOfType(PrimitiveCallSyntax.class)) {
            let value = (PrimitiveCallSyntax)syntax
            if (declarationContext && !locals.any({ _.name == value.name }) &&
                !constructors.any((candidate) => candidate.name == value.name &&
                    candidate.ownerType && candidate.ownerType.value() == boundType.value() &&
                    (candidate.callableKind.value == "static-method" || candidate.callableKind.value == "instance-method"))) {
                let owners = declarationContext.staticDefaultOwners(value.name, value.range)
                if (owners.isNotEmpty) {
                    let candidates = constructors.filter((candidate) => candidate.name == value.name &&
                        candidate.callableKind.value == "static-method" &&
                        owners.any({ _.value == candidate.ownerType.declarationIdentity.value }))
                    let checks = CallCheckResult[]
                    let calls = BoundCallExpression[]
                    for (candidate in candidates) {
                        if (!callbackArgumentShape(candidate, value.argumentValues())) continue
                        try {
                            let arguments = BoundExpression[]
                            let formals = SemanticType[]
                            let actuals = SemanticType[]
                            var Int index
                            for (argument in value.argumentValues()) {
                                if (argument.class.isOfType(PrimitiveLambdaSyntax.class)) arguments.add(null)
                                else {
                                    let bound = expression(argument, receiver, fields, locals)
                                    arguments.add(bound)
                                    formals.add(candidate.parameterTypes()[index])
                                    actuals.add(bound.semanticType)
                                }
                                index++
                            }
                            var GenericSubstitution substitution = GenericSubstitution(GenericParameterSemanticType[], SemanticType[])
                            if (candidate.genericParameters().isNotEmpty) {
                                let partial = GenericInference.inferPartial(GenericDeclaration(
                                    candidate.identity.declaration, candidate.genericParameters(), candidate.returnType
                                ), formals, actuals, value.range)
                                if (!partial.inferred) throw Exception(partial.diagnostic.message)
                                substitution = partial.substitution
                            }
                            index = 0
                            for (argument in value.argumentValues()) {
                                if (arguments[index] == null) {
                                    let context = substitution.apply(candidate.parameterTypes()[index])
                                    if (context.kind() != "function") throw Exception("Callback requires a function contract")
                                    let scoped = LocalBinding[]:addAll(locals)
                                    if (receiver) scoped.add(LocalBinding("this", receiver.symbolIdentity, receiver.semanticType))
                                    let callback = bindCallback((PrimitiveLambdaSyntax)argument,
                                        (FunctionSemanticType)context, scoped, constructors, typeHierarchy)
                                    if (!callback.succeeded) throw Exception(callback.diagnostic.message)
                                    arguments[index] = callback.expression
                                }
                                index++
                            }
                            let checked = CallTypeChecker.check(candidate, null,
                                arguments.map({ _.semanticType }), value.range, typeHierarchy)
                            if (checked.valid) {
                                checks.add(checked)
                                calls.add(BoundCallExpression(value.range, checked.semanticType, checked.target,
                                    arguments, checked.argumentConversions()))
                            }
                        } catch (Exception error) {
                            // A failed contextual candidate does not admit unrelated owners.
                        }
                    }
                    let resolution = OverloadResolver.resolveChecked(value.name, candidates, checks, value.range)
                    if (resolution.diagnostic) throw Exception(resolution.diagnostic.message)
                    return calls.firstOrNull({ _.target.identity.value == resolution.selected.identity.value })
                }
            }
            if (receiver && constructors.any((candidate) => candidate.name == value.name && candidate.genericParameters().isNotEmpty) &&
                value.argumentValues().any({ _.class.isOfType(PrimitiveLambdaSyntax.class) }) &&
                !locals.any({ _.name == value.name })) {
                let scoped = LocalBinding[]:addAll(locals)
                scoped.add(LocalBinding("callReceiver", receiver.symbolIdentity, receiver.semanticType))
                return expression(PrimitiveMemberCallSyntax(value.range,
                    PrimitiveReferenceSyntax(value.range, "callReceiver"), value.name, value.argumentValues(),
                    value.namedArgumentValues()), receiver, fields, scoped, requiredType)
            }
            let localFunction = locals.reverse().firstOrNull((candidate) =>
                candidate.name == value.name &&
                candidate.semanticType.kind() == "function"
            )
            if (localFunction) {
                let typeObject = (Object)localFunction.semanticType
                var FunctionSemanticType functionType
                functionType = (FunctionSemanticType)typeObject
                let invocationArguments = BoundExpression[]
                for (argument in value.argumentValues()) {
                    invocationArguments.add(expression(
                        argument, receiver, fields, locals
                    ))
                }
                if (invocationArguments.count != functionType.parameterTypes().count)
                    throw Exception("Callback argument count mismatch")
                var Int argumentIndex
                while (argumentIndex < invocationArguments.count) {
                    let argument = invocationArguments[argumentIndex]
                    let target = functionType.parameterTypes()[argumentIndex]
                    let conversion = TypeConversions.classify(argument.semanticType, target, hierarchy: typeHierarchy)
                    if (!conversion.applicable) throw Exception("Callback argument #argumentIndex cannot convert '#{argument.semanticType.value()}' to '#{target.value()}'")
                    if (argument.semanticType.value() != target.value()) invocationArguments[argumentIndex] =
                        BoundConversionExpression(argument.range, target, argument, conversion)
                    argumentIndex++
                }
                return BoundFunctionInvocationExpression(
                    value.range,
                    BoundReferenceExpression(
                        value.range, localFunction.semanticType,
                        localFunction.name, localFunction.identity
                    ),
                    functionType,
                    invocationArguments
                )
            }
            if (value.namedArgumentValues().isNotEmpty) {
                if (!receiver) throw Exception(
                    "Mixed call '#{value.name}' requires an instance receiver"
                )
                let namedArguments = value.namedArgumentValues()
                let positionalArguments = BoundExpression[]
                for (argument in value.argumentValues()) {
                    positionalArguments.add(expression(argument, receiver, fields, locals))
                }
                let candidates = constructors.filter((candidate) =>
                    candidate.callableKind.value == "instance-method" &&
                    candidate.ownerType.value() == receiver.semanticType.value() &&
                    candidate.name == value.name &&
                    candidate.parameterNames().isNotEmpty &&
                    value.argumentValues().count + namedArguments.count <=
                        candidate.parameterTypes().count &&
                    namedArguments.all((argument) =>
                        candidate.parameterNames().contains(argument.name)
                    ) && positionalArgumentsApplicable(candidate, positionalArguments)
                )
                if (candidates.count != 1) throw Exception(
                    "Mixed call '#{value.name}' requires one named target"
                )
                let target = candidates.first
                let parameters = target.parameterTypes()
                let names = target.parameterNames()
                var Int positionalIndex
                while (positionalIndex < positionalArguments.count) {
                    let name = names[positionalIndex]
                    if (namedArguments.any({ _.name == name })) {
                        throw Exception("Parameter '#name' is supplied both positionally and by name")
                    }
                    positionalIndex++
                }
                let arguments = BoundExpression[]
                arguments.addAll(positionalArguments)
                var Int argumentIndex = value.argumentValues().count
                while (argumentIndex < parameters.count) {
                    let namedArgument = namedArguments.firstOrNull({
                        _.name == names[argumentIndex]
                    })
                    if (namedArgument) {
                        arguments.add(expression(
                            namedArgument.value, receiver, fields, locals,
                            parameters[argumentIndex]
                        ))
                    } else {
                        if (!namedArguments.any((argument) =>
                            names.skip(argumentIndex + 1).contains(argument.name)
                        )) break
                        arguments.add(defaultArgument(
                            target, argumentIndex, receiver, fields
                        ))
                    }
                    argumentIndex++
                }
                let checked = CallTypeChecker.check(
                    target, receiver.semanticType,
                    arguments.map({ _.semanticType }), value.range
                )
                if (!checked.valid) throw Exception(checked.diagnostic.message)
                return BoundCallExpression(
                    value.range, checked.semanticType, target, receiver,
                    arguments, checked.argumentConversions()
                )
            }
            let possibleInstanceCandidates = constructors.filter((candidate) =>
                candidate.name == value.name &&
                candidate.callableKind.value == "instance-method" && receiver &&
                candidate.ownerType.value() == receiver.semanticType.value()
            )
            let contextualInstanceCandidates = possibleInstanceCandidates.filter((candidate) =>
                callbackArgumentShape(candidate, value.argumentValues()))
            let arguments = BoundExpression[]
            let constructorCall = constructors.any((candidate) =>
                candidate.callableKind.value == "constructor" && candidate.name == value.name
            )
            var Int suppliedIndex
            for (argument in value.argumentValues()) {
                let requiredArgumentType = contextualInstanceCandidates.count == 1 &&
                    suppliedIndex < contextualInstanceCandidates.first.parameterTypes().count
                    ? contextualInstanceCandidates.first.parameterTypes()[suppliedIndex] : null
                if (argument.class.isOfType(PrimitiveReferenceSyntax.class) &&
                    ((PrimitiveReferenceSyntax)argument).name == "this" && receiver &&
                    genericParameter && constructorCall &&
                    (locals.reverse().firstOrNull({ _.name == "this" }) == null ||
                        locals.reverse().firstOrNull({ _.name == "this" }).identity == receiver.symbolIdentity)) {
                    arguments.add(BoundReferenceExpression(
                        argument.range, GenericInstanceSemanticType(boundType, [genericParameter]),
                        "this", receiver.symbolIdentity
                    ))
                } else arguments.add(expression(
                    argument, receiver, fields, locals, requiredArgumentType,
                    originalCallbackContract: scopedTypeResolver && contextualInstanceCandidates.count == 1 ?
                        scopedTypeResolver.defaultCallbackContract(contextualInstanceCandidates.first, suppliedIndex) : null
                ))
                suppliedIndex++
            }
            let resolvedConstructor = declarationContext && constructorCall ?
                declarationContext.resolve(value.name, value.range) : null
            let nonInstanceCandidates = constructors.filter((candidate) =>
                candidate.name == value.name &&
                candidate.callableKind.value != "instance-method" &&
                (!declarationContext || candidate.callableKind.value != "static-method" ||
                    candidate.ownerType.value() == boundType.value()) &&
                (!resolvedConstructor || candidate.callableKind.value != "constructor" ||
                    candidate.ownerType.declarationIdentity.value == resolvedConstructor.value)
            )
            let instanceCandidates = constructors.filter((candidate) =>
                candidate.name == value.name &&
                candidate.callableKind.value == "instance-method" && receiver &&
                candidate.ownerType.value() == receiver.semanticType.value()
            )
            var BoundExpression[] callArguments = arguments
            if (instanceCandidates.count == 1 &&
                instanceCandidates.first.parameterTypes().count == arguments.count) {
                let parameterTypes = instanceCandidates.first.parameterTypes()
                callArguments = BoundExpression[]
                var Int argumentIndex
                while (argumentIndex < arguments.count) {
                    let argument = arguments[argumentIndex]
                    if (argument.semanticType.value() == SemanticTypes.stringType().value() &&
                        parameterTypes[argumentIndex].value() == boundType.value()) {
                        callArguments.add(BoundConversionExpression(
                            argument.range, parameterTypes[argumentIndex], argument,
                            PrimitiveStringAdapter.unsupported(
                                argument.semanticType, parameterTypes[argumentIndex],
                                "declared-string-argument", true, false, true, 0
                            )
                        ))
                    } else callArguments.add(argument)
                    argumentIndex++
                }
            }
            let applicableInstanceCandidates = instanceCandidates.filter((candidate) =>
                CallTypeChecker.check(
                    candidate, receiver.semanticType,
                    callArguments.map({ _.semanticType }), value.range
                ).valid
            )
            let candidates = applicableInstanceCandidates.isNotEmpty
                ? applicableInstanceCandidates : nonInstanceCandidates
            if (candidates.isEmpty && value.name == "String" && arguments.count == 1 &&
                (arguments.first.semanticType.kind() == "array" ||
                 arguments.first.semanticType.kind() == "char" ||
                 arguments.first.semanticType.value() == SemanticTypes.charType().value())) {
                return BoundNativeCallExpression(
                    value.range, SemanticTypes.stringType(), "String", arguments
                )
            }
            if (candidates.isEmpty) throw Exception("Unknown function '#{value.name}'")
            let callReceiver = applicableInstanceCandidates.isNotEmpty ? receiver : null
            if (!callReceiver && candidates.all({ _.callableKind.value == "constructor" }))
                return PrimitiveStringAdapter.call(value.name, candidates, null, arguments,
                    declarationContext, constructors, typeHierarchy, callRange: value.range)
            let resolution = OverloadResolver.resolve(
                value.name, candidates, callReceiver ? callReceiver.semanticType : null,
                callArguments.map({ _.semanticType }), value.range
            )
            if (!resolution.resolved) throw Exception(resolution.diagnostic.message)
            let target = resolution.selected
            let checked = CallTypeChecker.check(
                target, callReceiver ? callReceiver.semanticType : null,
                callArguments.map({ _.semanticType }), value.range
            )
            if (!checked.valid) throw Exception(checked.diagnostic.message)
            return callReceiver ? BoundCallExpression(
                value.range, checked.semanticType, target, callReceiver,
                callArguments, checked.argumentConversions()
            ) : BoundCallExpression(
                value.range, checked.semanticType, target,
                callArguments, checked.argumentConversions()
            )
        }
        if (syntax.class.isOfType(PrimitiveMemberAccessSyntax.class)) {
            let access = (PrimitiveMemberAccessSyntax)syntax
            if (access.receiver.class.isOfType(PrimitiveReferenceSyntax.class)) {
                let ownerName = ((PrimitiveReferenceSyntax)access.receiver).name
                if (!locals.any({ _.name == ownerName })) {
                    let ownerIdentity = declarationContext && declarationContext.visibleCandidates(ownerName).isNotEmpty
                        ? declarationContext.resolve(ownerName, access.range) : null
                    let staticField = publishedFields.firstOrNull((candidate) =>
                        candidate.staticField && candidate.name == access.memberName &&
                        (ownerIdentity ? candidate.identity.declaration.value == ownerIdentity.value :
                            candidate.identity.declaration.name == ownerName))
                    if (staticField) {
                        if (!staticField.visibleField && staticField.identity.declaration.value != boundType.declarationIdentity.value)
                            throw Exception("Field '#{staticField.name}' is not visible at #{access.range.startTokenIndex}")
                        return BoundReferenceExpression(access.range, staticField.semanticType,
                            staticField.name, staticField.identity, staticOwner: staticField.identity.declaration)
                    }
                    let staticCandidates = constructors.filter((candidate) =>
                        candidate.callableKind.value == "static-method" &&
                        candidate.ownerType.declarationIdentity.name == ownerName &&
                        candidate.name == access.memberName
                    )
                    if (staticCandidates.count == 1) {
                        let target = staticCandidates.first
                        var FunctionSemanticType functionType = FunctionSemanticType(
                            target.parameterTypes(), target.returnType
                        )
                        if (requiredType && requiredType.kind() == "function") {
                            let requiredObject = (Object)requiredType
                            var FunctionSemanticType requiredFunction
                            requiredFunction = (FunctionSemanticType)requiredObject
                            let targetParameters = target.parameterTypes()
                            let requiredParameters = requiredFunction.parameterTypes()
                            var Bool compatible = targetParameters.count <= requiredParameters.count &&
                                TypeConversions.classify(
                                    target.returnType, requiredFunction.returnType
                                ).applicable
                            var Int index
                            while (compatible && index < targetParameters.count) {
                                compatible = TypeConversions.classify(
                                    requiredParameters[index], targetParameters[index]
                                ).applicable
                                index++
                            }
                            if (compatible) functionType = requiredFunction
                        }
                        return BoundFunctionValue(
                            access.range, functionType, target
                        )
                    }
                    if (staticCandidates.count > 1) throw Exception(
                        "Static method reference '#{ownerName}.#{access.memberName}' is ambiguous"
                    )
                }
            }
            if (access.receiver.class.isOfType(PrimitiveReferenceSyntax.class)) {
                let receiverName = ((PrimitiveReferenceSyntax)access.receiver).name
                let local = locals.reverse().firstOrNull({ _.name == receiverName })
                if (local && local.semanticType.kind() == "array") {
                    let localReceiver = BoundReferenceExpression(
                        access.receiver.range, local.semanticType, local.name, local.identity
                    )
                    if (access.memberName == "data") {
                        return BoundNativeArrayDataExpression(access.range, localReceiver)
                    }
                    if (access.memberName == "count") {
                        return BoundArrayLengthExpression(access.range, localReceiver)
                    }
                }
            }
            if (access.receiver.class.isOfType(PrimitiveReferenceSyntax.class)) {
                let receiverName = ((PrimitiveReferenceSyntax)access.receiver).name
                if (receiverName == "this") return member(access, receiver, fields)
                if (access.memberName == "class") {
                    let local = locals.reverse().firstOrNull({ _.name == receiverName })
                    if (!local) {
                        throw Exception("Unsupported static class metadata receiver '#receiverName'")
                    }
                    let localReceiver = BoundReferenceExpression(
                        access.receiver.range, local.semanticType, local.name, local.identity
                    )
                    let declaredField = publishedFields.firstOrNull((candidate) =>
                        candidate.name == access.memberName &&
                        local.semanticType.value() == "class:#{candidate.identity.declaration.value}"
                    )
                    if (declaredField) return BoundMemberAccessExpression(
                        access.range, declaredField.semanticType, localReceiver,
                        declaredField.name, declaredField.identity
                    )
                    let metadataConstructor = constructors.filter((candidate) =>
                        candidate.callableKind.value == "constructor" &&
                        candidate.ownerType.declarationIdentity.name == "Class"
                    )
                    // Constructor overloads publish one metadata owner, not competing types.
                    if (metadataConstructor.isNotEmpty && !metadataConstructor.any((candidate) =>
                        candidate.ownerType.value() != metadataConstructor.first.ownerType.value()
                    )) return BoundMemberAccessExpression(
                        access.range, metadataConstructor.first.ownerType, localReceiver,
                        "class", local.identity
                    )
                    return BoundMemberAccessExpression(
                        access.range, SemanticTypes.objectType(), localReceiver,
                        "class", local.identity
                    )
                }
            }
            let projectedReceiver = expression(
                access.receiver, receiver, fields, locals
            )
            if (projectedReceiver.semanticType.kind() == "array") {
                if (access.memberName == "data") {
                    return BoundNativeArrayDataExpression(access.range, projectedReceiver)
                }
                if (access.memberName == "count") {
                    return BoundArrayLengthExpression(access.range, projectedReceiver)
                }
            }
            if (receiver && projectedReceiver.semanticType.value() == receiver.semanticType.value()) {
                let field = fields.firstOrNull({ _.name == access.memberName })
                if (field) return BoundMemberAccessExpression(
                    access.range, field.semanticType, projectedReceiver,
                    field.name, field.identity
                )
            }
            if (projectedReceiver.semanticType.value() == SemanticTypes.stringType().value() &&
                boundType && boundType.declarationIdentity.name == "String") {
                let field = fields.firstOrNull({ _.name == access.memberName })
                if (field) return BoundMemberAccessExpression(
                    access.range, field.semanticType, projectedReceiver,
                    field.name, field.identity
                )
            }
            if (projectedReceiver.semanticType.value() == SemanticTypes.stringType().value()) {
                let declaredText = declarationContext && declarationContext.visibleCandidates("String").isNotEmpty
                    ? declarationContext.resolve("String", access.range) : null
                let field = publishedFields.firstOrNull((candidate) =>
                    candidate.name == access.memberName && !candidate.staticField && candidate.visibleField &&
                    (declaredText ? candidate.identity.declaration.value == declaredText.value :
                        candidate.identity.declaration.name == "String"))
                if (field) return BoundMemberAccessExpression(access.range, field.semanticType,
                    projectedReceiver, field.name, field.identity)
            }
            if (projectedReceiver.semanticType.kind() == "generic-instance") {
                let instanceObject = (Object)projectedReceiver.semanticType
                let instance = (GenericInstanceSemanticType)instanceObject
                let field = publishedFields.firstOrNull((candidate) =>
                    instance.declarationType.value() == "class:#{candidate.identity.declaration.value}" &&
                    candidate.name == access.memberName)
                let owner = constructors.firstOrNull((candidate) =>
                    candidate.ownerType && candidate.ownerType.value() == instance.declarationType.value() &&
                    candidate.ownerGenericDeclaration != null)
                if (field && owner) {
                    if (!field.visibleField) throw Exception("Field '#{field.name}' is not visible at #{access.range.startTokenIndex}")
                    let substitution = GenericSubstitution(
                        owner.ownerGenericDeclaration.genericParameters(), instance.typeArguments())
                    return BoundMemberAccessExpression(access.range,
                        substitution.apply(field.semanticType), projectedReceiver, field.name, field.identity)
                }
                let property = constructors.firstOrNull((candidate) =>
                    candidate.callableKind.value == "instance-method" &&
                    candidate.ownerType.value() == instance.declarationType.value() &&
                    candidate.name == access.memberName && candidate.parameterTypes().isEmpty)
                if (property) {
                    let target = property.instantiateReceiver(instance)
                    let checked = CallTypeChecker.check(target, instance, SemanticType[], access.range)
                    if (!checked.valid) throw Exception(checked.diagnostic.message)
                    return BoundCallExpression(access.range, checked.semanticType, target,
                        projectedReceiver, BoundExpression[], checked.argumentConversions())
                }
            }
            if (projectedReceiver.semanticType.kind() == "user-class") {
                let field = publishedFields.firstOrNull((candidate) =>
                    projectedReceiver.semanticType.value() ==
                        "class:#{candidate.identity.declaration.value}" &&
                    candidate.name == access.memberName
                )
                if (field && !field.visibleField) throw Exception("Field '#{field.name}' is not visible at #{access.range.startTokenIndex}")
                if (field) return BoundMemberAccessExpression(
                    access.range, field.semanticType, projectedReceiver,
                    field.name, field.identity
                )
                let properties = constructors.filter((candidate) =>
                    candidate.callableKind.value == "instance-method" &&
                    candidate.ownerType && candidate.parameterTypes().isEmpty &&
                    candidate.name == access.memberName &&
                    (candidate.ownerType.value() == projectedReceiver.semanticType.value() ||
                        (typeHierarchy && typeHierarchy.distance((UserClassSemanticType)projectedReceiver.semanticType,
                            candidate.ownerType) >= 0)))
                var CallableSignature property
                var Int propertyDistance = 1000000
                for (candidate in properties) {
                    let distance = candidate.ownerType.value() == projectedReceiver.semanticType.value() ? 0 :
                        typeHierarchy.distance((UserClassSemanticType)projectedReceiver.semanticType, candidate.ownerType)
                    if (distance < propertyDistance) {
                        property = candidate
                        propertyDistance = distance
                    }
                }
                if (property) {
                    if (property.ownerType.value() != projectedReceiver.semanticType.value()) {
                        property = CallableSignature(property.identity, property.name, property.callableKind,
                            property.parameterTypes(), property.returnType,
                            (UserClassSemanticType)projectedReceiver.semanticType,
                            property.optionalParameterCount, property.parameterNames(), property.genericParameters())
                    }
                    let checked = CallTypeChecker.check(
                        property, projectedReceiver.semanticType,
                        SemanticType[], access.range
                    )
                    if (!checked.valid) throw Exception(checked.diagnostic.message)
                    return BoundCallExpression(
                        access.range, checked.semanticType, property,
                        projectedReceiver, BoundExpression[],
                        checked.argumentConversions()
                    )
                }
            }
            let ownedField = fields.firstOrNull((field) =>
                field.name == access.memberName && projectedReceiver.semanticType.value() ==
                    "class:#{field.identity.declaration.value}")
            if (ownedField) return BoundMemberAccessExpression(access.range, ownedField.semanticType,
                projectedReceiver, ownedField.name, ownedField.identity)
            let inherited = locals.firstOrNull((field) =>
                field.identity.symbolKind == "field" && field.name == access.memberName
            )
            if (inherited) {
                return BoundMemberAccessExpression(
                    access.range, inherited.semanticType, receiver,
                    inherited.name, inherited.identity
                )
            }
            return member(access, receiver, fields)
        }
        let result = PrimitiveExpressionBinder().bind(
            syntax, locals: locals, callables: constructors,
            requiredType: syntax.class.isOfType(PrimitiveArraySyntax.class) ? requiredType : null,
            hierarchy: typeHierarchy
        )
        if (!result.succeeded) throw Exception(result.diagnostic.message)
        return result.expression
    }

    positionalArgumentsApplicable(
        CallableSignature candidate,
        BoundExpression[] arguments
    ) -> Bool {
        let parameterTypes = candidate.parameterTypes()
        if (arguments.count > parameterTypes.count) return false
        var Int index
        while (index < arguments.count) {
            if (!TypeConversions.classify(
                arguments[index].semanticType, parameterTypes[index]
            ).applicable) return false
            index++
        }
        return true
    }

    defaultArgument(
        CallableSignature target,
        Int parameterIndex,
        BoundReferenceExpression receiver,
        BoundFieldUnit[] fields
    ) -> BoundExpression {
        let method = boundSyntax.methodValues().firstOrNull((candidate) =>
            candidate.range.startTokenIndex ==
                target.identity.declaration.syntaxIdentity.ordinal
        )
        if (!method) throw Exception(
            "Named call target '#{target.name}' has no source defaults"
        )
        let parameter = method.parameterValues()[parameterIndex]
        if (!parameter.defaultValue) throw Exception(
            "Missing named argument '#{parameter.name}'"
        )
        let defaultLocals = LocalBinding[]
        let parameters = method.parameterValues()
        var Int index
        while (index < parameterIndex) {
            defaultLocals.add(LocalBinding(
                parameters[index].name,
                SymbolIdentity(target.identity.declaration, "parameter", index),
                target.parameterTypes()[index]
            ))
            index++
        }
        if (parameter.defaultValue.class.isOfType(PrimitiveLambdaSyntax.class)) {
            let bound = PrimitiveExpressionBinder().bind(
                parameter.defaultValue, requiredType: target.parameterTypes()[parameterIndex],
                locals: defaultLocals
            )
            if (!bound.succeeded) throw Exception(bound.diagnostic.message)
            return bound.expression
        }
        return expression(parameter.defaultValue, receiver, fields, defaultLocals)
    }

    compoundOperator(String assignmentOperator) -> String {
        if (assignmentOperator == "+=") return "+"
        if (assignmentOperator == "-=") return "-"
        if (assignmentOperator == "*=") return "*"
        if (assignmentOperator == "/=") return "/"
        if (assignmentOperator == "%=") return "%"
        throw Exception("Unsupported member assignment value operator '#assignmentOperator'")
    }

    /** Defaults belong to the selected declaration, never the caller's lexical receiver. */
    bindNamedDefault(CallableSignature target, PrimitiveExpressionSyntax syntax,
        BoundReferenceExpression retained, LocalBinding[] parameterLocals) -> BoundExpression {
        let owner = declarationContext.classFor(target.ownerType.declarationIdentity)
        let scope = declarationContext.scopeFor(target.ownerType.declarationIdentity)
        let ownerFields = publishedFields.filter((field) =>
            field.identity.declaration.value == target.ownerType.declarationIdentity.value)
        let scopedLocals = LocalBinding[]:addAll(parameterLocals)
        scopedLocals.add(LocalBinding("this", retained.symbolIdentity, retained.semanticType))
        let resolver = PrimitiveStructuralTypeResolver(callables: constructors,
            receiverType: target.ownerType, implementationOwner: owner,
            declarationContext: scope, lookupRange: syntax.range)
        return PrimitiveClassBinder().bindScopedExpression(syntax, retained, ownerFields,
            scopedLocals, constructors, typeResolver: resolver, availableFields: publishedFields,
            hierarchy: typeHierarchy)
    }

    namedDefaultSyntax(CallableSignature target, Int index) -> PrimitiveExpressionSyntax {
        let owner = declarationContext ? declarationContext.classFor(target.ownerType.declarationIdentity) : null
        if (!owner) return null
        let method = owner.methodValues().firstOrNull((candidate) => candidate.range.snapshot == target.identity.declaration.syntaxIdentity.snapshot &&
            candidate.range.startTokenIndex == target.identity.declaration.syntaxIdentity.ordinal)
        if (!method || index >= method.parameterValues().count) return null
        return method.parameterValues()[index].defaultValue
    }

    /** Shape narrows contextual typing only; the normal checker still selects the overload. */
    callbackArgumentShape(CallableSignature candidate, PrimitiveExpressionSyntax[] arguments) -> Bool {
        let types = candidate.parameterTypes()
        if (arguments.count > types.count || arguments.count < types.count - candidate.optionalParameterCount) return false
        var Int index
        for (argument in arguments) {
            if (argument.class.isOfType(PrimitiveLambdaSyntax.class) && types[index].kind() != "function") return false
            index++
        }
        return true
    }

    member(
        PrimitiveMemberAccessSyntax syntax,
        BoundReferenceExpression receiver,
        BoundFieldUnit[] fields
    ) -> BoundMemberAccessExpression {
        if (!syntax.receiver.class.isOfType(PrimitiveReferenceSyntax.class) ||
            ((PrimitiveReferenceSyntax)syntax.receiver).name != "this") {
            throw Exception("Reduced field access requires 'this'")
        }
        let field = fields.firstOrNull({ _.name == syntax.memberName })
        if (!field) throw Exception("Unknown field '#{syntax.memberName}'")
        return BoundMemberAccessExpression(
            syntax.range, field.semanticType, receiver, field.name, field.identity
        )
    }

    /** Logical context only: reference presence is not a general Bool conversion. */
    logicalOperand(BoundExpression expression) -> BoundExpression {
        let type = expression.semanticType
        if (type.value() == SemanticTypes.boolType().value()) return expression
        if (type.kind() == "user-class" || type.kind() == "generic-instance" ||
            type.kind() == "object" || type.kind() == "string" || type.kind() == "array" ||
            type.kind() == "function" || type.kind() == "generic-parameter" || type.kind() == "null") {
            let nullable = NullableSemanticType(type)
            let retained = BoundConversionExpression(expression.range, nullable, expression,
                TypeConversions.classify(type, nullable))
            return BoundBinaryExpression(expression.range, SemanticTypes.boolType(), "!=", retained,
                BoundLiteralExpression(expression.range, SemanticTypes.nullType(), "null"))
        }
        if (type.kind() == "nullable") {
            let nullable = (NullableSemanticType)type
            if (nullable.underlyingType.value() == SemanticTypes.boolType().value()) {
                let value = BoundLiteralExpression(expression.range, SemanticTypes.boolType(), "true")
                let expected = BoundConversionExpression(expression.range, type, value,
                    TypeConversions.classify(value.semanticType, type))
                return BoundBinaryExpression(expression.range, SemanticTypes.boolType(), "==", expression, expected)
            }
            if (nullable.underlyingType.kind() == "user-class" || nullable.underlyingType.kind() == "generic-instance" ||
                nullable.underlyingType.kind() == "object" || nullable.underlyingType.kind() == "string" ||
                nullable.underlyingType.kind() == "array" || nullable.underlyingType.kind() == "function") {
                return BoundBinaryExpression(expression.range, SemanticTypes.boolType(), "!=", expression,
                    BoundLiteralExpression(expression.range, SemanticTypes.nullType(), "null"))
            }
        }
        return expression
    }

    declaredClassType(String name) -> UserClassSemanticType {
        if (declarationContext) return UserClassSemanticType(declarationContext.resolve(name, declarationLookupRange))
        if (name == boundType.declarationIdentity.name) return boundType
        let callable = constructors.firstOrNull((candidate) =>
            candidate.ownerType.declarationIdentity.name == name
        )
        if (callable) return callable.ownerType
        throw Exception("Unknown reduced class metadata '#name'")
    }

    nullDefault(PrimitiveFunctionParameterSyntax parameter) -> Bool =>
        parameter.defaultValue &&
        parameter.defaultValue.class.isOfType(PrimitiveLiteralSyntax.class) &&
        ((PrimitiveLiteralSyntax)parameter.defaultValue).sourceValue == "null"

    referenceType(SemanticType type) -> Bool =>
        type.kind() == "string" || type.kind() == "object" || type.kind() == "array" ||
        type.kind() == "user-class" || type.kind() == "generic-instance" || type.kind() == "function"

    methodTypeOf(String name, PrimitiveFunctionSyntax method) -> SemanticType =>
        methodTypeResolver(method).resolve(name)

    methodTypeResolver(PrimitiveFunctionSyntax method) -> PrimitiveStructuralTypeResolver {
        let kind = method.staticMethod ? "static-method" : "instance-method"
        let identity = DeclarationIdentity(
            SyntaxIslandIdentity(method.range.snapshot, kind, method.range.startTokenIndex),
            kind, method.name
        )
        let generics = GenericParameterSemanticType[]
        for (genericName in method.genericParameterNames()) {
            generics.add(GenericParameterSemanticType(identity, genericName, generics.count))
        }
        return PrimitiveStructuralTypeResolver(
            callables: constructors, genericParameter: genericParameter,
            receiverType: boundType, methodGenericParameters: generics, interfaces: interfaces,
            implementationOwner: boundSyntax, implementationRange: method.range,
            declarationContext: declarationContext ? declarationContext.scopeForSnapshot(method.range.snapshot) : null,
            lookupRange: method.range
        )
    }

    typeOf(String name, Bool nativeArrayStorage = false, Bool nativeScalarStorage = false) -> SemanticType {
        if (nativeScalarStorage && name == "String") return SemanticTypes.stringType()
        let resolver = scopedTypeResolver ?: PrimitiveStructuralTypeResolver(
            callables: constructors, genericParameter: genericParameter,
            receiverType: boundType, interfaces: interfaces,
            declarationContext: declarationContext, lookupRange: declarationLookupRange)
        return nativeArrayStorage ? resolver.resolveNativeArrayStorage(name) : resolver.resolve(name)
    }
}
