package flat/semantic/binding/primitive

import flat/compiler/models
import flat/parser/flat
import flat/bound
import flat/semantic/types

/** Binds one reduced class with fields, constructor, and instance methods. */
class {
    var GenericParameterSemanticType genericParameter
    var CallableSignature[] constructors

    public bind(
        PrimitiveClassSyntax syntax,
        SourceSnapshotIdentity snapshot,
        CallableSignature parentConstructor = null,
        BoundFieldUnit[] inheritedFields = BoundFieldUnit[],
        CallableSignature[] availableConstructors = CallableSignature[]
    ) -> PrimitiveClassBindingResult {
        if (!syntax || !snapshot || !inheritedFields || inheritedFields.any({ !_ }) ||
            !availableConstructors || availableConstructors.any({ !_ })) {
            throw Exception("Primitive class binding requires syntax snapshot and inherited fields")
        }
        if ((syntax.parentName != null) != (parentConstructor != null) ||
            (!parentConstructor && inheritedFields.isNotEmpty) ||
            (parentConstructor && (parentConstructor.callableKind.value != "constructor" ||
                parentConstructor.ownerType.declarationIdentity.name != syntax.parentName))) {
            throw Exception("Primitive class parent requires its selected constructor signature")
        }
        let typeIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", syntax.range.startTokenIndex),
            "class", syntax.name
        )
        let type = UserClassSemanticType(typeIdentity)
        genericParameter = syntax.genericParameterName ? GenericParameterSemanticType(
            typeIdentity, syntax.genericParameterName, 0
        ) : null
        constructors = CallableSignature[]
        constructors.addAll(availableConstructors)
        let fields = BoundFieldUnit[]
        let fieldSyntaxValues = syntax.fieldValues()
        let visibleParameters = syntax.constructorValue.parameterValues().filter({ _.visibleParameter })
        for (parameter in visibleParameters) {
            if (fieldSyntaxValues.any({ _.name == parameter.name })) {
                throw Exception("Visible constructor parameter duplicates field '#{parameter.name}'")
            }
        }
        var Int fieldIndex
        while (fieldIndex < fieldSyntaxValues.count) {
            let field = fieldSyntaxValues[fieldIndex]
            let identity = SymbolIdentity(typeIdentity, "field", fieldIndex)
            var BoundExpression initializer
            if (field.initializer) {
                let bound = PrimitiveExpressionBinder().bind(
                    field.initializer, requiredType: typeOf(field.typeName),
                    callables: constructors
                )
                if (!bound.succeeded) throw Exception(bound.diagnostic.message)
                initializer = bound.expression
            }
            fields.add(BoundFieldUnit(
                field.name, identity, typeOf(field.typeName), field.range,
                field.visibleField, initializer
            ))
            fieldIndex++
        }
        for (parameter in visibleParameters) {
            fields.add(BoundFieldUnit(
                parameter.name, SymbolIdentity(typeIdentity, "field", fieldIndex),
                typeOf(parameter.typeName), parameter.range, true
            ))
            fieldIndex++
        }
        let functions = BoundFunctionUnit[]
        functions.add(bindConstructor(
            syntax, typeIdentity, type, fields, parentConstructor, inheritedFields
        ))
        var Int methodIndex
        while (methodIndex < syntax.methodValues().count) {
            functions.add(bindMethod(
                syntax.methodValues()[methodIndex], typeIdentity, type,
                fields, inheritedFields, methodIndex
            ))
            methodIndex++
        }
        let metadata = BoundMetadataUnit[]
        if (genericParameter) {
            metadata.add(BoundMetadataUnit("generic", genericParameter.name, genericParameter.value()))
            metadata.add(BoundMetadataUnit("reified", genericParameter.name, genericParameter.value()))
        }
        for (implementedType in syntax.implementedTypeNames()) {
            metadata.add(BoundMetadataUnit("implements", implementedType, implementedType))
        }
        return PrimitiveClassBindingResult(BoundTypeUnit(
            typeIdentity, type, functions, syntax.range,
            metadataValues: metadata, fieldValues: fields
        ))
    }

    bindConstructor(
        PrimitiveClassSyntax owner,
        DeclarationIdentity typeIdentity,
        UserClassSemanticType type,
        BoundFieldUnit[] fields,
        CallableSignature parentConstructor,
        BoundFieldUnit[] inheritedFields
    ) -> BoundFunctionUnit {
        let syntax = owner.constructorValue
        let identity = DeclarationIdentity(
            SyntaxIslandIdentity(syntax.range.snapshot, "constructor", syntax.range.startTokenIndex),
            "constructor", owner.name
        )
        let parameters = parameters(syntax.parameterValues(), identity)
        let locals = localBindings(parameters)
        locals.addAll(inheritedFieldBindings(inheritedFields))
        let receiver = receiver(syntax.range, typeIdentity, type)
        let statements = BoundStatement[]
        for (parameterSyntax in syntax.parameterValues().filter({ _.visibleParameter })) {
            let parameter = parameters.firstOrNull({ _.name == parameterSyntax.name })
            let field = fields.firstOrNull({ _.name == parameterSyntax.name })
            let target = BoundMemberAccessExpression(
                parameterSyntax.range,
                field.semanticType,
                receiver,
                field.name,
                field.identity
            )
            let value = BoundReferenceExpression(
                parameterSyntax.range,
                parameter.semanticType,
                parameter.name,
                parameter.identity
            )
            statements.add(BoundMemberAssignmentStatement(
                parameterSyntax.range,
                target,
                value,
                TypeConversions.classify(value.semanticType, field.semanticType)
            ))
        }
        for (field in fields) {
            if (field.initializer) {
                let target = BoundMemberAccessExpression(
                    field.range, field.semanticType, receiver, field.name, field.identity
                )
                statements.add(BoundMemberAssignmentStatement(
                    field.range, target, field.initializer,
                    TypeConversions.classify(field.initializer.semanticType, field.semanticType)
                ))
            }
        }
        for (statement in syntax.statements()) {
            if (statement.class.isOfType(PrimitiveExternalStatementSyntax.class)) {
                let opaqueStatement = (PrimitiveExternalStatementSyntax)statement
                let externalBinding = bindConstructorOpaqueCode(opaqueStatement, locals)
                statements.add(externalBinding)
                continue
            }
            if (statement.class.isOfType(PrimitiveExpressionStatementSyntax.class)) {
                let expressionSyntax = (PrimitiveExpressionStatementSyntax)statement
                if (!expressionSyntax.expression.class.isOfType(PrimitiveNativeSyntax.class)) {
                    throw Exception("Constructor expression statement requires target native syntax")
                }
                let external = PrimitiveNativeBinder().bind(
                    (PrimitiveNativeSyntax)expressionSyntax.expression, "es6", locals,
                    SemanticTypes.unitType()
                )
                statements.add(BoundExpressionStatement(
                    expressionSyntax.range, external.nativeCall
                ))
                continue
            }
            if (!statement.class.isOfType(PrimitiveMemberAssignmentSyntax.class)) {
                throw Exception("Constructor '#{owner.name}' supports only field assignments")
            }
            let assignment = (PrimitiveMemberAssignmentSyntax)statement
            let allFields = BoundFieldUnit[]
            allFields.addAll(fields)
            allFields.addAll(inheritedFields)
            let target = member(assignment.target, receiver, allFields)
            let value = expression(
                assignment.value, receiver, allFields, locals
            )
            let conversion = TypeConversions.classify(value.semanticType, target.semanticType)
            if (!conversion.applicable) throw Exception("Constructor field assignment type mismatch")
            statements.add(BoundMemberAssignmentStatement(
                assignment.range, target, value, conversion
            ))
        }
        var BoundParentConstructorCall parentCall
        if (parentConstructor) {
            let arguments = BoundExpression[]
            for (argumentSyntax in syntax.parentArgumentValues()) {
                arguments.add(expression(argumentSyntax, receiver, fields, locals))
            }
            let checked = CallTypeChecker.check(
                parentConstructor, null, arguments.map({ _.semanticType }), syntax.range
            )
            if (!checked.valid) throw Exception(checked.diagnostic.message)
            parentCall = BoundParentConstructorCall(
                parentConstructor, arguments, checked.argumentConversions(), syntax.range
            )
        } else if (syntax.parentArgumentValues().isNotEmpty) {
            throw Exception("Root constructor cannot delegate to a parent")
        }
        return BoundFunctionUnit(
            identity, owner.name, SemanticTypes.unitType(), statements,
            syntax.range, parameters, constructorFunction: true,
            parentConstructorCall: parentCall
        )
    }

    bindConstructorOpaqueCode(
        PrimitiveExternalStatementSyntax syntax,
        LocalBinding[] locals
    ) -> BoundExternalStatement {
        return PrimitiveOpaqueCodeBinder().bind(syntax, locals)
    }

    bindMethod(
        PrimitiveFunctionSyntax syntax,
        DeclarationIdentity typeIdentity,
        UserClassSemanticType type,
        BoundFieldUnit[] fields,
        BoundFieldUnit[] inheritedFields,
        Int ordinal
    ) -> BoundFunctionUnit {
        let identity = DeclarationIdentity(
            SyntaxIslandIdentity(syntax.range.snapshot, "instance-method", syntax.range.startTokenIndex),
            "instance-method", syntax.name
        )
        let parameters = parameters(syntax.parameterValues(), identity)
        let locals = localBindings(parameters)
        locals.addAll(inheritedFieldBindings(inheritedFields))
        let receiver = receiver(syntax.range, typeIdentity, type)
        let declaredReturnType = typeOf(syntax.returnTypeName)
        var SemanticType returnType = declaredReturnType
        let statements = BoundStatement[]
        for (statement in syntax.statements()) {
            if (!statement.class.isOfType(PrimitiveReturnSyntax.class)) {
                throw Exception("Reduced method '#{syntax.name}' supports return statements")
            }
            let returned = (PrimitiveReturnSyntax)statement
            if (!returned.value) throw Exception("Reduced method requires return value")
            let allFields = BoundFieldUnit[]
            allFields.addAll(fields)
            allFields.addAll(inheritedFields)
            let value = expression(returned.value, receiver, allFields, locals)
            if (syntax.inferredReturnType) returnType = value.semanticType
            let conversion = TypeConversions.classify(value.semanticType, returnType)
            if (!conversion.applicable) throw Exception("Method return type mismatch")
            statements.add(BoundReturnStatement(returned.range, returnType, value, conversion))
        }
        return BoundFunctionUnit(
            identity, syntax.name, returnType, statements, syntax.range, parameters,
            staticFunction: syntax.staticMethod
        )
    }

    inheritedFieldBindings(BoundFieldUnit[] fields) -> LocalBinding[] {
        let result = LocalBinding[]
        for (field in fields) {
            result.add(LocalBinding(field.name, field.identity, field.semanticType))
        }
        return result
    }

    localBindings(BoundFunctionParameter[] parameters) -> LocalBinding[] {
        let result = LocalBinding[]
        for (parameter in parameters) {
            result.add(LocalBinding(parameter.name, parameter.identity, parameter.semanticType))
        }
        return result
    }

    parameters(
        PrimitiveFunctionParameterSyntax[] values,
        DeclarationIdentity owner
    ) -> BoundFunctionParameter[] {
        let result = BoundFunctionParameter[]
        var Int index
        while (index < values.count) {
            let value = values[index]
            if (value.defaultValue && values.skip(index + 1).any({ _.defaultValue == null })) {
                throw Exception("Default constructor parameters must be trailing")
            }
            let type = typeOf(value.typeName)
            var BoundExpression defaultValue
            if (value.defaultValue) {
                let bound = PrimitiveExpressionBinder().bind(
                    value.defaultValue, requiredType: type
                )
                if (!bound.succeeded) throw Exception(bound.diagnostic.message)
                defaultValue = bound.expression
            }
            result.add(BoundFunctionParameter(
                value.name, SymbolIdentity(owner, "parameter", index), type, defaultValue
            ))
            index++
        }
        return result
    }

    receiver(
        SourceRange range,
        DeclarationIdentity typeIdentity,
        UserClassSemanticType type
    ) -> BoundReferenceExpression => BoundReferenceExpression(
        range, type, "this", SymbolIdentity(typeIdentity, "receiver")
    )

    expression(
        PrimitiveExpressionSyntax syntax,
        BoundReferenceExpression receiver,
        BoundFieldUnit[] fields,
        LocalBinding[] locals
    ) -> BoundExpression {
        if (syntax.class.isOfType(PrimitiveMemberCallSyntax.class)) {
            let value = (PrimitiveMemberCallSyntax)syntax
            let owner = expression(value.receiver, receiver, fields, locals)
            let arguments = BoundExpression[]
            for (argument in value.argumentValues()) {
                arguments.add(expression(argument, receiver, fields, locals))
            }
            let target = constructors.firstOrNull((candidate) =>
                candidate.callableKind.value == "instance-method" &&
                candidate.name == value.memberName
            )
            if (!target) throw Exception("Unknown member call '#{value.memberName}'")
            let checked = CallTypeChecker.check(
                target, owner.semanticType, arguments.map({ _.semanticType }), value.range
            )
            if (!checked.valid) throw Exception(checked.diagnostic.message)
            return BoundCallExpression(
                value.range, checked.semanticType, target, owner,
                arguments, checked.argumentConversions()
            )
        }
        if (syntax.class.isOfType(PrimitiveCastSyntax.class)) {
            let value = (PrimitiveCastSyntax)syntax
            let operand = expression(value.value, receiver, fields, locals)
            let target = typeOf(value.typeName)
            return BoundConversionExpression(
                value.range, target, operand,
                TypeConversions.classify(operand.semanticType, target)
            )
        }
        if (syntax.class.isOfType(PrimitiveClassNameSyntax.class)) {
            let value = (PrimitiveClassNameSyntax)syntax
            let reflected = expression(value.receiver, receiver, fields, locals)
            return BoundClassNameExpression(value.range, reflected)
        }
        if (syntax.class.isOfType(PrimitiveConditionalSyntax.class)) {
            let value = (PrimitiveConditionalSyntax)syntax
            var BoundExpression condition = expression(
                value.condition, receiver, fields, locals
            )
            if (condition.semanticType.value() == SemanticTypes.stringType().value()) {
                let empty = BoundLiteralExpression(
                    value.condition.range, SemanticTypes.stringType(), "\"\""
                )
                condition = BoundBinaryExpression(
                    value.condition.range, SemanticTypes.boolType(), "!=", condition, empty
                )
            }
            let whenTrue = expression(value.whenTrue, receiver, fields, locals)
            let whenFalse = expression(value.whenFalse, receiver, fields, locals)
            if (condition.semanticType.value() != SemanticTypes.boolType().value() ||
                whenTrue.semanticType.value() != whenFalse.semanticType.value()) {
                throw Exception("Reduced conditional requires Bool and common branch type")
            }
            return BoundConditionalExpression(
                value.range, whenTrue.semanticType, condition, whenTrue, whenFalse
            )
        }
        if (syntax.class.isOfType(PrimitiveBinarySyntax.class)) {
            let value = (PrimitiveBinarySyntax)syntax
            let left = expression(value.left, receiver, fields, locals)
            let right = expression(value.right, receiver, fields, locals)
            let typed = TypeOperations.binary(
                value.operator, left.semanticType, right.semanticType, value.range
            )
            if (!typed.valid) throw Exception(typed.diagnostic.message)
            return BoundBinaryExpression(
                value.range, typed.semanticType, value.operator, left, right
            )
        }
        if (syntax.class.isOfType(PrimitiveReferenceSyntax.class)) {
            let value = (PrimitiveReferenceSyntax)syntax
            if (value.name == "this") return receiver
            let local = locals.firstOrNull({ _.name == value.name })
            if (local) {
                return BoundReferenceExpression(
                    value.range, local.semanticType, local.name, local.identity
                )
            }
            let field = fields.firstOrNull({ _.name == value.name })
            if (field) {
                return BoundMemberAccessExpression(
                    value.range, field.semanticType, receiver, field.name, field.identity
                )
            }
            throw Exception("Unknown constructor/method name '#{value.name}'")
        }
        if (syntax.class.isOfType(PrimitiveMemberAccessSyntax.class)) {
            let access = (PrimitiveMemberAccessSyntax)syntax
            if (access.receiver.class.isOfType(PrimitiveReferenceSyntax.class) &&
                ((PrimitiveReferenceSyntax)access.receiver).name == "this") {
                return member(access, receiver, fields)
            }
            let inherited = locals.firstOrNull((field) =>
                field.identity.symbolKind == "field" && field.name == access.memberName
            )
            if (inherited) {
                return BoundMemberAccessExpression(
                    access.range, inherited.semanticType, receiver,
                    inherited.name, inherited.identity
                )
            }
            return member(access, receiver, fields)
        }
        let result = PrimitiveExpressionBinder().bind(
            syntax, locals: locals, callables: constructors
        )
        if (!result.succeeded) throw Exception(result.diagnostic.message)
        return result.expression
    }

    member(
        PrimitiveMemberAccessSyntax syntax,
        BoundReferenceExpression receiver,
        BoundFieldUnit[] fields
    ) -> BoundMemberAccessExpression {
        if (!syntax.receiver.class.isOfType(PrimitiveReferenceSyntax.class) ||
            ((PrimitiveReferenceSyntax)syntax.receiver).name != "this") {
            throw Exception("Reduced field access requires 'this'")
        }
        let field = fields.firstOrNull({ _.name == syntax.memberName })
        if (!field) throw Exception("Unknown field '#{syntax.memberName}'")
        return BoundMemberAccessExpression(
            syntax.range, field.semanticType, receiver, field.name, field.identity
        )
    }

    typeOf(String name) -> SemanticType {
        if (genericParameter && name == genericParameter.name) return genericParameter
        if (name == "Bool") return SemanticTypes.boolType()
        if (name == "Int") return SemanticTypes.intType()
        if (name == "Long") return SemanticTypes.longType()
        if (name == "String") return SemanticTypes.stringType()
        if (name == "Unit") return SemanticTypes.unitType()
        let constructed = constructors.firstOrNull((candidate) =>
            candidate.callableKind.value == "constructor" &&
            candidate.ownerType.declarationIdentity.name == name
        )
        if (constructed) return constructed.ownerType
        throw Exception("Unknown reduced class type '#name'")
    }
}
