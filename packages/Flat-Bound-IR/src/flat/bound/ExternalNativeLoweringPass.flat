package flat/bound

/** Removes external/native wrappers without hiding nested bound expressions. */
class extends BoundTreeLoweringPass {
    override public name() => "external-native-forms"
    override public inputInvariant() => "typed-external-native-forms"
    override public outputInvariant() => "canonical-native-calls"

    override public lowerExpression(BoundExpression expression) -> BoundExpression {
        if (expression && expression.class.isOfType(BoundExternalExpression.class)) {
            return lowerExpression(((BoundExternalExpression)expression).nativeCall)
        }
        return super.lowerExpression(expression)
    }
}
