package flat/bound

import flat/compiler/models
import flat/semantic/types

/** Reduced target-independent unary operation with an already-proven result type. */
data class extends BoundExpression {
    public construct(
        SourceRange range,
        SemanticType semanticType,
        visible String operator,
        visible BoundExpression operand
    ) {
        if (!range || !semanticType || !operator || !operand) {
            throw Exception("Bound unary operation requires operator, operand, and type")
        }
        let typed = TypeOperations.unary(operator, operand.semanticType, range)
        if (!typed.valid || typed.semanticType.value() != semanticType.value()) {
            throw Exception("Bound unary operation requires consistent type evidence")
        }
        super(range, semanticType)
    }
    override public expressionKind() => "unary"
}
