package flat/bound

import flat/compiler/models
import flat/semantic/types

/** Target-independent runtime type test with an explicit object and declared class. */
data class extends BoundExpression {
    public construct(
        SourceRange range,
        visible BoundExpression value,
        visible BoundTypeMetadataExpression typeMetadata
    ) {
        if (!range || !value || !typeMetadata ||
            value.semanticType.kind() == "primitive") {
            throw Exception("Bound type test requires reference value and class metadata")
        }
        super(range, SemanticTypes.boolType())
    }

    override public expressionKind() => "type-test"
}
