package flat/bound

import flat/compiler/models
import flat/semantic/types

/** Typed local declaration whose initialized value participates in an expression. */
data class extends BoundExpression {
    public construct(
        SourceRange range,
        SemanticType semanticType,
        visible BoundReferenceExpression local,
        visible BoundExpression value,
        visible TypeConversion storageConversion
    ) {
        if (!range || !semanticType || !local || !value || !storageConversion ||
            !storageConversion.applicable ||
            storageConversion.fromType.value() != value.semanticType.value() ||
            storageConversion.toType.value() != local.semanticType.value() ||
            semanticType.value() != local.semanticType.value()) {
            throw Exception("Bound declaration value requires consistent local storage evidence")
        }
        super(range, semanticType)
    }
    override public expressionKind() => "declaration-value"
}
