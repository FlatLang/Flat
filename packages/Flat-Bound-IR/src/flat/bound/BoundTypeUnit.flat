package flat/bound

import flat/compiler/models
import flat/semantic/types

data class {
    var BoundFunctionUnit[] functions
    var BoundFieldUnit[] fields
    var BoundMetadataUnit[] metadataUnits

    public construct(
        visible DeclarationIdentity identity,
        visible UserClassSemanticType semanticType,
        BoundFunctionUnit[] functionUnits,
        visible SourceRange range,
        BoundMetadataUnit[] metadataValues = BoundMetadataUnit[],
        BoundFieldUnit[] fieldValues = BoundFieldUnit[],
        visible UserClassSemanticType parentType = null
    ) {
        if (!identity || !semanticType || !functionUnits || functionUnits.any({ !_ }) || !range ||
            !metadataValues || metadataValues.any({ !_ }) ||
            !fieldValues || fieldValues.any({ !_ }) ||
            identity.syntaxIdentity.snapshot != range.snapshot) {
            throw Exception("Bound type requires identity, semantic type, functions, and range")
        }
        let constructors = functionUnits.filter({ _.constructorFunction })
        BoundConstructorPlanValidator.validate(identity, semanticType, parentType, functionUnits)
        let planned = constructors.any((value) => value.constructorPlan != null)
        if (!planned && parentType && (constructors.isEmpty ||
            constructors.first.parentConstructorCall == null)) {
            let constructorIdentity = constructors.isEmpty ? "missing" : constructors.first.identity.value
            let delegationIdentity = !constructors.isEmpty && constructors.first.constructorDelegation != null ?
                constructors.first.constructorDelegation.target.identity.declaration.value : "none"
            throw Exception("Bound derived type requires explicit parent constructor evidence: type=" +
                identity.value + "; parent=" + parentType.declarationIdentity.value +
                "; tokens=[" + range.startTokenIndex + "," + range.endTokenIndex + ")" +
                "; location=" + range.start.lineNumber + ":" + range.start.column +
                "-" + range.end.lineNumber + ":" + range.end.column +
                "; constructor=" + constructorIdentity + "; delegation=" + delegationIdentity)
        }
        functions = BoundFunctionUnit[]
        functions.addAll(functionUnits)
        fields = BoundFieldUnit[]
        fields.addAll(fieldValues)
        metadataUnits = BoundMetadataUnit[]
        metadataUnits.addAll(metadataValues)
    }

    public functionUnits() -> BoundFunctionUnit[] {
        let result = BoundFunctionUnit[]
        result.addAll(functions)
        return result
    }

    public fieldUnits() -> BoundFieldUnit[] {
        let result = BoundFieldUnit[]
        result.addAll(fields)
        return result
    }

    public metadata() -> BoundMetadataUnit[] {
        let result = BoundMetadataUnit[]
        result.addAll(metadataUnits)
        return result
    }
}
