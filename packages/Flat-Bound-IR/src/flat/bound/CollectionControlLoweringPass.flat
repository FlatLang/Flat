package flat/bound

import flat/compiler/models
import flat/semantic/types

/** Lowers arrays/ranges/foreach/safe access/match to canonical expressions and CFG primitives. */
class extends BoundTreeLoweringPass {
    override public name() => "collection-control-forms"
    override public inputInvariant() => "typed-rich-collection-control"
    override public outputInvariant() => "canonical-expressions-and-control-flow"

    override public lowerStatement(BoundStatement statement, BoundStatement[] output) {
        if (statement.class.isOfType(BoundIfStatement.class)) {
            let value = (BoundIfStatement)statement
            output.add(BoundIfStatement(value.range, lowerExpression(value.condition),
                lowerStatements(value.thenValues()), lowerStatements(value.elseValues())))
        } else if (statement.class.isOfType(BoundSwitchStatement.class)) {
            let value = (BoundSwitchStatement)statement
            let cases = BoundSwitchCase[]
            for (caseValue in value.caseValues()) {
                cases.add(BoundSwitchCase(
                    caseValue.range, lowerExpression(caseValue.label),
                    lowerStatements(caseValue.statementValues()),
                    caseValue.defaultCase, caseValue.fallsThrough
                ))
            }
            output.add(BoundSwitchStatement(value.range, lowerExpression(value.value), cases))
        } else if (statement.class.isOfType(BoundTryStatement.class)) {
            let value = (BoundTryStatement)statement
            let catches = BoundCatchClause[]
            for (caught in value.catchValues()) {
                catches.add(BoundCatchClause(
                    caught.range, caught.local, lowerStatements(caught.statements()),
                    caught.acceptsSoftExceptions
                ))
            }
            output.add(BoundTryStatement(
                value.range, lowerStatements(value.tryValues()), catches,
                lowerStatements(value.finallyValues())
            ))
        } else if (statement.class.isOfType(BoundWhileStatement.class)) {
            let value = (BoundWhileStatement)statement
            output.add(BoundWhileStatement(value.range, lowerExpression(value.condition),
                lowerStatements(value.bodyValues())))
        } else if (statement.class.isOfType(BoundLocalDeclarationStatement.class)) {
            let value = (BoundLocalDeclarationStatement)statement
            output.add(BoundLocalDeclarationStatement(value.range, value.local,
                lowerExpression(value.initializer), value.conversion))
        } else if (statement.class.isOfType(BoundForEachStatement.class)) {
            let loop = (BoundForEachStatement)statement
            for (initialization in loop.initialization()) lowerStatement(initialization, output)
            output.add(BoundLoopLatchStatement(loop.range, lowerExpression(loop.condition),
                lowerStatements(loop.body()), lowerStatements(loop.advance()),
                SyntaxIslandIdentity(loop.range.snapshot, "foreach-latch:#{loop.loopLabel}", loop.range.startTokenIndex)))
        } else if (statement.class.isOfType(BoundExpressionStatement.class)) {
            let value = (BoundExpressionStatement)statement
            output.add(BoundExpressionStatement(value.range, lowerExpression(value.expression)))
        } else if (statement.class.isOfType(BoundNativeArrayClearStatement.class)) {
            let value = (BoundNativeArrayClearStatement)statement
            output.add(BoundNativeArrayClearStatement(value.range,
                (BoundArrayAccessExpression)lowerExpression(value.target)))
        } else if (statement.class.isOfType(BoundArrayAssignmentStatement.class)) {
            let value = (BoundArrayAssignmentStatement)statement
            output.add(BoundArrayAssignmentStatement(
                value.range,
                (BoundArrayAccessExpression)lowerExpression(value.target),
                lowerExpression(value.value),
                value.conversion
            ))
        } else if (statement.class.isOfType(BoundMemberAssignmentStatement.class)) {
            let value = (BoundMemberAssignmentStatement)statement
            let targetObject = lowerExpression(value.target)
            let target = (BoundMemberAccessExpression)targetObject
            if (value.compoundOperator) {
                let owner = target.receiver
                let identity = SymbolIdentity(DeclarationIdentity(
                    SyntaxIslandIdentity(value.range.snapshot, "compound-receiver", value.range.startTokenIndex),
                    "lowered-statement", "receiver"), "local")
                let reference = BoundReferenceExpression(value.range, owner.semanticType, "receiver", identity)
                output.add(BoundLocalDeclarationStatement(value.range, reference, owner,
                    TypeConversions.classify(owner.semanticType, owner.semanticType)))
                let selected = BoundMemberAccessExpression(target.range, target.semanticType,
                    reference, target.memberName, target.memberIdentity)
                let operation = BoundBinaryExpression(value.range, value.conversion.fromType,
                    value.compoundOperator, selected, lowerExpression(value.value))
                output.add(BoundMemberAssignmentStatement(value.range, selected, operation, value.conversion))
            } else {
                output.add(BoundMemberAssignmentStatement(value.range, target, lowerExpression(value.value), value.conversion))
            }
        } else if (statement.class.isOfType(BoundAssignmentStatement.class)) {
            let value = (BoundAssignmentStatement)statement
            output.add(BoundAssignmentStatement(
                value.range, value.target, lowerExpression(value.value), value.conversion
            ))
        } else if (statement.class.isOfType(BoundReturnStatement.class)) {
            let value = (BoundReturnStatement)statement
            output.add(BoundReturnStatement(
                value.range, value.requiredType, lowerExpression(value.value), value.conversion
            ))
        } else {
            super.lowerStatement(statement, output)
        }
    }

    override public lowerExpression(BoundExpression expression) -> BoundExpression {
        if (!expression) return null
        if (expression.class.isOfType(BoundConditionalExpression.class)) {
            let value = (BoundConditionalExpression)expression
            return BoundConditionalExpression(value.range, value.semanticType,
                lowerExpression(value.condition), lowerExpression(value.whenTrue), lowerExpression(value.whenFalse))
        }
        if (expression.class.isOfType(BoundUnaryExpression.class)) {
            let value = (BoundUnaryExpression)expression
            return BoundUnaryExpression(value.range, value.semanticType, value.operator, lowerExpression(value.operand))
        }
        if (expression.class.isOfType(BoundBinaryExpression.class)) {
            let value = (BoundBinaryExpression)expression
            if (value.operator == "?:") {
                let left = lowerExpression(value.left)
                let right = lowerExpression(value.right)
                if (left.class.isOfType(BoundLiteralExpression.class) && left.semanticType.kind() == "null") return right
                let identity = SymbolIdentity(DeclarationIdentity(
                    SyntaxIslandIdentity(value.range.snapshot, "fallback-value", value.range.startTokenIndex),
                    "lowered-expression", "value"), "parameter")
                let reference = BoundReferenceExpression(value.range, left.semanticType, "value", identity)
                let nullValue = BoundLiteralExpression(value.range, SemanticTypes.nullType(), "null")
                if (left.semanticType.kind() == "null") {
                    return BoundEvaluationExpression(value.range, value.semanticType,
                        [BoundLocalDeclarationStatement(value.range, reference, left,
                            TypeConversions.classify(left.semanticType, left.semanticType))], right)
                }
                let nullableType = left.semanticType.kind() == "nullable" ? left.semanticType :
                    NullableSemanticType(left.semanticType)
                let checkedValue = BoundConversionExpression(value.range, nullableType, reference,
                    TypeConversions.classify(left.semanticType, nullableType))
                let condition = BoundBinaryExpression(value.range, SemanticTypes.boolType(), "==", checkedValue, nullValue)
                let body = BoundConditionalExpression(value.range, value.semanticType, condition,
                    BoundConversionExpression(value.range, value.semanticType, right,
                        TypeConversions.classify(right.semanticType, value.semanticType)),
                    BoundConversionExpression(value.range, value.semanticType, reference,
                        TypeConversions.classify(left.semanticType, value.semanticType, explicit: true)))
                return BoundEvaluationExpression(value.range, value.semanticType,
                    [BoundLocalDeclarationStatement(value.range, reference, left,
                        TypeConversions.classify(left.semanticType, left.semanticType))], body)
            }
            return BoundBinaryExpression(value.range, value.semanticType, value.operator,
                lowerExpression(value.left), lowerExpression(value.right))
        }
        if (expression.class.isOfType(BoundMemberAccessExpression.class)) {
            let value = (BoundMemberAccessExpression)expression
            let receiver = lowerExpression(value.receiver)
            if (!value.safeAccess) return BoundMemberAccessExpression(value.range, value.semanticType,
                receiver, value.memberName, value.memberIdentity)
            let identity = SymbolIdentity(DeclarationIdentity(
                SyntaxIslandIdentity(value.range.snapshot, "safe-field-receiver", value.range.startTokenIndex),
                "lowered-expression", "receiver"), "parameter")
            let reference = BoundReferenceExpression(value.range, receiver.semanticType, "receiver", identity)
            let nullValue = BoundLiteralExpression(value.range, SemanticTypes.nullType(), "null")
            let nullableReceiver = receiver.semanticType.kind() == "nullable" ? receiver.semanticType :
                NullableSemanticType(receiver.semanticType)
            let checkedReceiver = BoundConversionExpression(value.range, nullableReceiver, reference,
                TypeConversions.classify(receiver.semanticType, nullableReceiver))
            let condition = BoundBinaryExpression(value.range, SemanticTypes.boolType(), "==", checkedReceiver, nullValue)
            let result = BoundConditionalExpression(value.range, value.semanticType, condition,
                BoundConversionExpression(value.range, value.semanticType, nullValue,
                    TypeConversions.classify(nullValue.semanticType, value.semanticType)),
                BoundMemberAccessExpression(value.range, value.semanticType, reference,
                    value.memberName, value.memberIdentity))
            return BoundEvaluationExpression(value.range, value.semanticType,
                [BoundLocalDeclarationStatement(value.range, reference, receiver,
                    TypeConversions.classify(receiver.semanticType, receiver.semanticType))], result)
        }
        if (expression.class.isOfType(BoundFunctionInvocationExpression.class)) {
            let value = (BoundFunctionInvocationExpression)expression
            let callee = lowerExpression(value.functionValue)
            let typeObject = callee.semanticType
            let signature = (FunctionSemanticType)typeObject
            return BoundFunctionInvocationExpression(value.range, callee, signature,
                value.argumentValues().map({ lowerExpression(_) }), value.suppressAwait)
        }
        if (expression.class.isOfType(BoundLambdaExpression.class)) {
            let value = (BoundLambdaExpression)expression
            let typeObject = value.semanticType
            let signature = (FunctionSemanticType)typeObject
            return BoundLambdaExpression(value.range, signature, value.parameterValues(),
                value.captureValues(), lowerExpression(value.body), lowerStatements(value.statementValues()),
                value.declarationContract, value.resultBoxingConstructor)
        }
        if (expression.class.isOfType(BoundDeclarationValueExpression.class)) {
            let value = (BoundDeclarationValueExpression)expression
            return BoundDeclarationValueExpression(
                value.range, value.semanticType, value.local,
                lowerExpression(value.value), value.storageConversion
            )
        }
        if (expression.class.isOfType(BoundAssignmentValueExpression.class)) {
            let value = (BoundAssignmentValueExpression)expression
            return BoundAssignmentValueExpression(
                value.range, value.semanticType, value.target,
                lowerExpression(value.value), value.storageConversion
            )
        }
        if (expression.class.isOfType(BoundMemberAssignmentValueExpression.class)) {
            let value = (BoundMemberAssignmentValueExpression)expression
            let targetObject = lowerExpression(value.target)
            if (!targetObject.class.isOfType(BoundMemberAccessExpression.class)) {
                throw Exception("Member assignment requires an ordinary lowered member target")
            }
            let target = (BoundMemberAccessExpression)targetObject
            return BoundMemberAssignmentValueExpression(value.range, value.semanticType, target,
                value.operator, lowerExpression(value.value), value.storageConversion)
        }
        if (expression.class.isOfType(BoundNativeArrayDataExpression.class)) {
            let value = (BoundNativeArrayDataExpression)expression
            return BoundNativeArrayDataExpression(
                value.range, lowerExpression(value.receiver)
            )
        }
        if (expression.class.isOfType(BoundArrayLengthExpression.class)) {
            let value = (BoundArrayLengthExpression)expression
            return BoundArrayLengthExpression(
                value.range, lowerExpression(value.receiver)
            )
        }
        if (expression.class.isOfType(BoundArrayAccessExpression.class)) {
            let value = (BoundArrayAccessExpression)expression
            return BoundArrayAccessExpression(
                value.range, value.semanticType,
                lowerExpression(value.receiver), lowerExpression(value.index),
                nativeStorageDeclaration: value.nativeStorageDeclaration            )
        }
        if (expression.class.isOfType(BoundRichCollectionExpression.class)) {
            return lowerExpression(((BoundRichCollectionExpression)expression).canonicalExpression)
        }
        if (expression.class.isOfType(BoundCallExpression.class)) {
            let call = (BoundCallExpression)expression
            if (call.safeAccess) {
                let receiver = lowerExpression(call.receiver)
                let identity = SymbolIdentity(DeclarationIdentity(
                    SyntaxIslandIdentity(call.range.snapshot, "safe-call-receiver", call.range.startTokenIndex),
                    "lowered-expression", "receiver"), "parameter")
                    let reference = BoundReferenceExpression(call.range, receiver.semanticType, "receiver", identity)
                let nullableReceiver = receiver.semanticType.kind() == "nullable" ? receiver.semanticType : NullableSemanticType(receiver.semanticType)
                let checkedReceiver = BoundConversionExpression(call.range, nullableReceiver, reference,
                    TypeConversions.classify(receiver.semanticType, nullableReceiver))
                let nullValue = BoundLiteralExpression(call.range, SemanticTypes.nullType(), "null")
                let condition = BoundBinaryExpression(call.range, SemanticTypes.boolType(), "==", checkedReceiver, nullValue)
                let narrowed = BoundReferenceExpression(call.range, call.target.receiverType(), "receiver", identity)
                let invoked = BoundCallExpression(call.range, call.target.returnType, call.target, narrowed,
                    call.argumentValues().map({ lowerExpression(_) }), call.argumentConversions(),
                    suppressAwait: call.suppressAwait)
                let body = BoundConditionalExpression(call.range, call.semanticType, condition,
                    BoundConversionExpression(call.range, call.semanticType, nullValue,
                        TypeConversions.classify(nullValue.semanticType, call.semanticType)),
                    BoundConversionExpression(call.range, call.semanticType, invoked,
                        TypeConversions.classify(invoked.semanticType, call.semanticType)))
                return BoundEvaluationExpression(call.range, call.semanticType,
                    [BoundLocalDeclarationStatement(call.range, reference, receiver,
                        TypeConversions.classify(receiver.semanticType, receiver.semanticType))], body)
            }
            return BoundCallExpression(
                call.range,
                call.semanticType,
                call.target,
                lowerExpression(call.receiver),
                call.argumentValues().map({ lowerExpression(_) }),
                call.argumentConversions(), call.safeAccess, call.receiverConversion, call.suppressAwait
            )
        }
        if (expression.class.isOfType(BoundNumericUnboxExpression.class)) {
            let value = (BoundNumericUnboxExpression)expression
            return BoundNumericUnboxExpression(value.range, value.semanticType,
                lowerExpression(value.value), value.numberType, value.projection,
                value.conversion, value.projectionConversion)
        }
        if (expression.class.isOfType(BoundConversionExpression.class)) {
            let conversion = (BoundConversionExpression)expression
            return BoundConversionExpression(
                conversion.range,
                conversion.semanticType,
                lowerExpression(conversion.value),
                conversion.conversion
            )
        }
        return super.lowerExpression(expression)
    }
}
