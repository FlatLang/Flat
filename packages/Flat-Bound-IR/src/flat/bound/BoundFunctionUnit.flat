package flat/bound

import flat/compiler/models
import flat/semantic/types

data class {
    var BoundStatement[] body
    var BoundFunctionParameter[] parameters

    public construct(
        visible DeclarationIdentity identity,
        visible String name,
        visible SemanticType returnType,
        BoundStatement[] statements,
        visible SourceRange range,
        BoundFunctionParameter[] parameterValues = BoundFunctionParameter[],
        visible Bool staticFunction = false,
        visible Bool mainFunction = false,
        visible Bool constructorFunction = false,
        visible String dispatchIdentity = null,
        visible BoundParentConstructorCall parentConstructorCall = null,
        visible Bool asyncFunction = false,
        visible String externalName = null,
        visible Bool abstractFunction = false
    ) {
        if (!identity || !name || !returnType || !statements || statements.any({ !_ }) || !range ||
            !parameterValues || parameterValues.any({ !_ }) ||
            (externalName != null && externalName.trim().isEmpty) ||
            identity.syntaxIdentity.snapshot != range.snapshot) {
            throw Exception("Bound function requires identity, name, return type, statements, and range")
        }
        if (constructorFunction && (staticFunction || mainFunction || abstractFunction ||
            returnType.value() != "unit")) {
            throw Exception("Bound constructor must be an instance unit-returning function")
        }
        if (abstractFunction && (staticFunction || mainFunction || statements.isNotEmpty ||
            externalName != null || asyncFunction)) {
            throw Exception("Bound abstract function must be bodyless instance contract")
        }
        if (dispatchIdentity && (constructorFunction || staticFunction)) {
            throw Exception("Only instance methods can carry virtual dispatch identity")
        }
        if (parentConstructorCall && (!constructorFunction ||
            parentConstructorCall.range.snapshot != range.snapshot)) {
            throw Exception("Only a same-source constructor can invoke its direct parent")
        }
        body = BoundStatement[]
        body.addAll(statements)
        parameters = BoundFunctionParameter[]
        parameters.addAll(parameterValues)
    }

    public statements() -> BoundStatement[] {
        let result = BoundStatement[]
        result.addAll(body)
        return result
    }

    public parameterValues() -> BoundFunctionParameter[] {
        let result = BoundFunctionParameter[]
        result.addAll(parameters)
        return result
    }
}
