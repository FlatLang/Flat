package flat/bound

import flat/compiler/models
import flat/semantic/types

testable class {
    test `narrowing compound field lowers through one receiver local`() {
        let fixture = BoundIR_TestFixture()
        let owner = fixture.declaration("class", "Box", 1)
        let receiver = BoundReferenceExpression(fixture.range(), UserClassSemanticType(owner), "box", fixture.symbol("local", "box", 2))
        let target = BoundMemberAccessExpression(fixture.range(), SemanticTypes.intType(), receiver, "count", SymbolIdentity(owner, "field", 0))
        let operand = BoundLiteralExpression(fixture.range(), SemanticTypes.doubleType(), "2.5")
        let conversion = TypeConversions.classify(operand.semanticType, target.semanticType, explicit: true)
        let assignment = BoundMemberAssignmentStatement(fixture.range(), target, operand, conversion, "+")
        let function = BoundFunctionUnit(fixture.declaration("function", "run", 3), "run", SemanticTypes.unitType(), [assignment], fixture.range())
        let statements = CollectionControlLoweringPass().lower(function).statements()
        expect(statements.count).toBe(2)
        expect(statements.first.unitKind()).toBe("local-declaration")
        let statementObject = statements.last
        let lowered = (BoundMemberAssignmentStatement)statementObject
        expect(lowered.compoundOperator == null).toBe(true)
        expect(lowered.conversion.conversionKind).toBe("numeric-cast")
        expect(lowered.value.expressionKind()).toBe("binary")
    }
    test `lowers fallback inside member compound assignment`() {
        let fixture = BoundIR_TestFixture()
        let intType = SemanticTypes.intType()
        let owner = fixture.declaration("class", "Box", 1)
        let receiver = BoundReferenceExpression(fixture.range(), UserClassSemanticType(owner), "box", fixture.symbol("local", "box", 2))
        let target = BoundMemberAccessExpression(fixture.range(), intType, receiver, "count", SymbolIdentity(owner, "field", 0))
        let literal = BoundLiteralExpression(fixture.range(), intType, "1")
        let fallback = BoundBinaryExpression(fixture.range(), intType, "?:", literal, literal)
        let assignment = BoundMemberAssignmentValueExpression(fixture.range(), intType, target, "+", fallback,
            TypeConversions.classify(intType, intType))
        let function = BoundFunctionUnit(fixture.declaration("function", "run", 3), "run", intType,
            [BoundReturnStatement(fixture.range(), intType, assignment, TypeConversions.classify(intType, intType))], fixture.range())
        let statementObject = CollectionControlLoweringPass().lower(function).statements().first
        let returned = (BoundReturnStatement)statementObject
        let assignmentObject = returned.value
        let lowered = (BoundMemberAssignmentValueExpression)assignmentObject
        expect(lowered.value.expressionKind()).toBe("function-invocation")
        expect(lowered.target.memberIdentity.value).toBe(target.memberIdentity.value)
    }
    test `fallback array index retains captures and await scope`() {
        let fixture = BoundIR_TestFixture()
        let intType = SemanticTypes.intType()
        let left = BoundReferenceExpression(fixture.range(), NullableSemanticType(intType), "left", fixture.symbol("local", "left", 1))
        let array = BoundReferenceExpression(fixture.range(), ArraySemanticType(intType), "items", fixture.symbol("local", "items", 2))
        let signature = FunctionSemanticType(SemanticType[], intType, asyncFunction: true)
        let next = BoundReferenceExpression(fixture.range(), signature, "next", fixture.symbol("local", "next", 3))
        let index = BoundFunctionInvocationExpression(fixture.range(), next, signature, BoundExpression[])
        let access = BoundArrayAccessExpression(fixture.range(), intType, array, index)
        let fallback = BoundBinaryExpression(fixture.range(), intType, "?:", left, access)
        let function = BoundFunctionUnit(fixture.declaration("function", "run", 4), "run", intType,
            [BoundReturnStatement(fixture.range(), intType, fallback, TypeConversions.classify(intType, intType))], fixture.range())
        let statementObject = CollectionControlLoweringPass().lower(function).statements().first
        let returned = (BoundReturnStatement)statementObject
        let invocationObject = returned.value
        let invocation = (BoundFunctionInvocationExpression)invocationObject
        let lambdaObject = invocation.functionValue
        let lambda = (BoundLambdaExpression)lambdaObject
        let typeObject = lambda.semanticType
        let loweredSignature = (FunctionSemanticType)typeObject
        expect(loweredSignature.asyncFunction).toBe(true)
        expect(lambda.captureValues().count).toBe(2)
        expect(lambda.captureValues().first.symbolIdentity.value).toBe(array.symbolIdentity.value)
        expect(lambda.captureValues().last.symbolIdentity.value).toBe(next.symbolIdentity.value)
    }
    test `fallback lowers to captured conditional invocation`() {
        let fixture = BoundIR_TestFixture()
        let intType = SemanticTypes.intType()
        let nullable = NullableSemanticType(intType)
        let left = BoundReferenceExpression(fixture.range(), nullable, "left", fixture.symbol("local", "left", 1))
        let right = BoundReferenceExpression(fixture.range(), intType, "right", fixture.symbol("local", "right", 2))
        let assignment = BoundAssignmentValueExpression(fixture.range(), intType, right, right,
            TypeConversions.classify(intType, intType))
        let fallback = BoundBinaryExpression(fixture.range(), intType, "?:", left, assignment)
        let signature = FunctionSemanticType(SemanticType[], intType)
        let wrapper = BoundLambdaExpression(fixture.range(), signature, BoundFunctionParameter[], [left, right], fallback)
        let invoked = BoundFunctionInvocationExpression(fixture.range(), wrapper, signature, BoundExpression[])
        let function = BoundFunctionUnit(fixture.declaration("function", "run", 3), "run", intType,
            [BoundReturnStatement(fixture.range(), intType, invoked, TypeConversions.classify(intType, intType))], fixture.range())
        let statementObject = CollectionControlLoweringPass().lower(function).statements().first
        let returned = (BoundReturnStatement)statementObject
        let wrapperInvocationObject = returned.value
        let wrapperInvocation = (BoundFunctionInvocationExpression)wrapperInvocationObject
        let wrapperObject = wrapperInvocation.functionValue
        let loweredWrapper = (BoundLambdaExpression)wrapperObject
        expect(loweredWrapper.captureValues().count).toBe(2)
        let invocationObject = loweredWrapper.body
        let invocation = (BoundFunctionInvocationExpression)invocationObject
        let lambdaObject = invocation.functionValue
        let lambda = (BoundLambdaExpression)lambdaObject
        expect(invocation.argumentValues().count).toBe(1)
        expect(lambda.captureValues().count).toBe(1)
        expect(lambda.captureValues().first.symbolIdentity.value).toBe(right.symbolIdentity.value)
    }
    test `safe call lowering retains argument local capture`() {
        let fixture = BoundIR_TestFixture()
        let owner = fixture.declaration("class", "Box", 1)
        let ownerType = UserClassSemanticType(owner)
        let intType = SemanticTypes.intType()
        let resultType = NullableSemanticType(intType)
        let receiver = BoundReferenceExpression(fixture.range(), ownerType, "box", fixture.symbol("local", "box", 2))
        let argument = BoundReferenceExpression(fixture.range(), intType, "value", fixture.symbol("local", "value", 3))
        let target = CallableSignature(fixture.symbol("instance-method", "read", 4), "read",
            CallableKind("instance-method"), [intType], intType, ownerType)
        let call = BoundCallExpression(fixture.range(), resultType, target, receiver, [argument],
            [TypeConversions.classify(intType, intType)], safeAccess: true)
        let function = BoundFunctionUnit(fixture.declaration("function", "run", 5), "run", resultType,
            [BoundReturnStatement(fixture.range(), resultType, call, TypeConversions.classify(resultType, resultType))], fixture.range())
        let statementObject = CollectionControlLoweringPass().lower(function).statements().first
        let returned = (BoundReturnStatement)statementObject
        let invocationObject = returned.value
        let invocation = (BoundFunctionInvocationExpression)invocationObject
        let lambdaObject = invocation.functionValue
        let lambda = (BoundLambdaExpression)lambdaObject
        expect(lambda.captureValues().count).toBe(1)
        expect(lambda.captureValues().first.symbolIdentity.value).toBe(argument.symbolIdentity.value)
    }
    test `safe field lowers to ordinary single argument invocation`() {
        let fixture = BoundIR_TestFixture()
        let owner = fixture.declaration("class", "Box", 1)
        let receiver = BoundReferenceExpression(fixture.range(), UserClassSemanticType(owner),
            "box", fixture.symbol("local", "box", 2))
        let resultType = NullableSemanticType(SemanticTypes.intType())
        let access = BoundMemberAccessExpression(fixture.range(), resultType, receiver,
            "count", SymbolIdentity(owner, "field"), safeAccess: true)
        let function = BoundFunctionUnit(fixture.declaration("function", "read", 3), "read",
            resultType, [BoundReturnStatement(fixture.range(), resultType, access,
                TypeConversions.classify(resultType, resultType))], fixture.range())
        let lowered = CollectionControlLoweringPass().lower(function)
        let statementObject = lowered.statements().first
        let returned = (BoundReturnStatement)statementObject
        expect(returned.value.expressionKind()).toBe("function-invocation")
        expect(access.safeAccess).toBe(true)
        let local = BoundReferenceExpression(fixture.range(), resultType, "result", fixture.symbol("local", "result", 4))
        let declaration = BoundLocalDeclarationStatement(fixture.range(), local, access,
            TypeConversions.classify(resultType, resultType))
        let conditional = BoundIfStatement(fixture.range(),
            BoundLiteralExpression(fixture.range(), SemanticTypes.boolType(), "true"), [declaration])
        let nested = BoundFunctionUnit(function.identity, function.name, resultType, [conditional], fixture.range())
        let nestedObject = CollectionControlLoweringPass().lower(nested).statements().first
        let loweredIf = (BoundIfStatement)nestedObject
        let localObject = loweredIf.thenValues().first
        let loweredLocal = (BoundLocalDeclarationStatement)localObject
        expect(loweredLocal.initializer.expressionKind()).toBe("function-invocation")
    }
    test `lazy static lowering separates initialization from cached access`() {
        let fixture = BoundIR_TestFixture()
        let owner = fixture.declaration("class", "Cache", 1)
        let getter = fixture.declaration("static-method", "value", 2)
        let valueType = SemanticTypes.boolType()
        let method = BoundFunctionUnit(getter, "value", valueType, [
            BoundReturnStatement(fixture.range(), valueType,
                BoundLiteralExpression(fixture.range(), valueType, "false"),
                TypeConversions.classify(valueType, valueType))
        ], fixture.range(), staticFunction: true, lazyProperty: true)
        let input = BoundTypeUnit(owner, UserClassSemanticType(owner), [method], fixture.range())
        let lowered = TypeFeatureLowering.lowerLazyProperties(input)
        expect(method.lazyProperty).toBe(true)
        expect(lowered.functionUnits().first.lazyProperty).toBe(false)
        expect(TypeFeatureLowering.lowerLazyProperties(lowered).fieldUnits().count).toBe(2)
        expect(input.fieldUnits().count).toBe(0)
        expect(lowered.fieldUnits().count).toBe(2)
        expect(lowered.functionUnits().count).toBe(2)
        let wrapper = lowered.functionUnits().first
        expect(wrapper.identity.value).toBe(getter.value)
        let conditionalObject = wrapper.statements().first
        let conditional = (BoundIfStatement)conditionalObject
        expect(conditional.condition.semanticType.value()).toBe("primitive:Bool")
        let body = wrapper.statements()
        expect(body.count).toBe(4)
        let assignmentObject = body[1]
        let assignment = (BoundAssignmentStatement)assignmentObject
        expect(assignment.target.staticOwner.value).toBe(owner.value)
        let initializedObject = body[2]
        let initialized = (BoundAssignmentStatement)initializedObject
        let initializedValue = initialized.value
        let literal = (BoundLiteralExpression)initializedValue
        expect(literal.sourceValue).toBe("true")
    }
    test `static reference retains field ownership`() {
        let fixture = BoundIR_TestFixture()
        let owner = fixture.declaration("class", "Cache", 1)
        let field = SymbolIdentity(owner, "field", 0)
        let reference = BoundReferenceExpression(fixture.range(), SemanticTypes.intType(),
            "cached", field, staticOwner: owner)
        expect(reference.staticOwner.value).toBe(owner.value)
        var Bool rejected
        try {
            BoundReferenceExpression(fixture.range(), SemanticTypes.intType(), "cached",
                field, staticOwner: fixture.declaration("class", "Other", 2))
        } catch (Exception error) { rejected = true }
        expect(rejected).toBe(true)
    }
    test `program type function statement and expression units retain explicit semantic evidence`() {
        let fixture = BoundIR_TestFixture()
        let intType = SemanticTypes.intType()
        let longType = SemanticTypes.longType()
        let literal = BoundLiteralExpression(fixture.range(1, 2), intType, "1")
        let reference = BoundReferenceExpression(
            fixture.range(2, 3), longType, "value", fixture.symbol("local", "value", 2)
        )
        let asyncExternal = BoundFunctionUnit(
            fixture.declaration("instance-method", "chain", 4),
            "chain", SemanticTypes.objectType(), BoundStatement[], fixture.range(),
            asyncFunction: true, externalName: "chain"
        )
        expect(asyncExternal.asyncFunction).toBe(true)
        expect(asyncExternal.externalName).toBe("chain")

        let typeMetadata = BoundTypeMetadataExpression(
            fixture.range(), UserClassSemanticType(fixture.declaration("class", "Value", 5))
        )
        let typeTestValue = BoundReferenceExpression(
            fixture.range(), SemanticTypes.objectType(), "object",
            fixture.symbol("local", "object", 6)
        )
        let typeTest = BoundTypeTestExpression(fixture.range(), typeTestValue, typeMetadata)
        expect(typeMetadata.expressionKind()).toBe("type-metadata")
        expect(typeTest.semanticType.value()).toBe("primitive:Bool")

        let className = BoundClassNameExpression(fixture.range(), reference)
        let interpolation = BoundInterpolatedStringExpression(fixture.range(), [
            BoundInterpolatedStringSegment(fixture.range(1, 2), "\"Hello \"", null),
            BoundInterpolatedStringSegment(fixture.range(2, 3), null, className)
        ])
        expect(interpolation.semanticType.value()).toBe("builtin:String")
        expect(interpolation.expressionKind()).toBe("interpolated-string")
        let copiedInterpolation = interpolation.segmentValues()
        copiedInterpolation.clear()
        expect(interpolation.segmentValues().count).toBe(2)
        let conversion = TypeConversions.classify(intType, longType)
        let converted = BoundConversionExpression(
            fixture.range(1, 2), longType, literal, conversion
        )
        let assignment = BoundAssignmentStatement(
            fixture.range(1, 3), reference, literal, conversion
        )
        let returned = BoundReturnStatement(
            fixture.range(3, 4), longType, converted,
            TypeConversions.classify(longType, longType)
        )
        let statement = BoundExternalStatement(
            fixture.range(), "es6", [
                BoundExternalCodeSegment(fixture.range(), "code")
            ]
        )
        let copiedSegments = statement.segmentValues()
        copiedSegments.clear()
        expect(statement.segmentValues().count).toBe(1)
        expect(statement.segmentValues().first.text).toBe("code")
        let copiedNames = statement.nameBindingValues()
        copiedNames.clear()
        expect(statement.nameBindingValues().count).toBe(0)
        var Int rejected
        try { BoundExternalCodeSegment(fixture.range(), "", null, null) }
        catch (Exception error) { rejected++ }
        try {
            BoundExternalCodeSegment(
                fixture.range(), "literal", reference, "identity"
            )
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
        let functionIdentity = fixture.declaration("function", "run", 3)
        let function = BoundFunctionUnit(
            functionIdentity, "run", longType, [assignment, returned], fixture.range(1, 4)
        )
        let condition = BoundLiteralExpression(fixture.range(), SemanticTypes.boolType(), "true")
        let branch = BoundIfStatement(
            fixture.range(), condition, [assignment], [returned]
        )
        let loop = BoundWhileStatement(fixture.range(), condition, [assignment])
        let field = BoundFieldUnit(
            "value", fixture.symbol("field", "value", 5), intType, fixture.range(1, 2)
        )
        let memberTarget = BoundMemberAccessExpression(
            fixture.range(), intType,
            BoundReferenceExpression(
                fixture.range(), UserClassSemanticType(fixture.declaration("class", "Owner", 6)),
                "this", fixture.symbol("receiver", "this", 7)
            ),
            "value", field.identity
        )
        let memberAssignment = BoundMemberAssignmentStatement(
            fixture.range(), memberTarget, literal,
            TypeConversions.classify(intType, intType)
        )
        let ownerIdentity = fixture.declaration("class", "Record", 8)
        let typeUnit = BoundTypeUnit(
            ownerIdentity, UserClassSemanticType(ownerIdentity), [function], fixture.range(),
            fieldValues: [field]
        )
        expect(typeUnit.fieldUnits().count).toBe(1)
        expect(memberAssignment.unitKind()).toBe("member-assignment")
        expect(branch.thenValues().count).toBe(1)
        expect(branch.elseValues().count).toBe(1)
        expect(loop.bodyValues().count).toBe(1)
        let typeIdentity = fixture.declaration("class", "Example", 0)
        let type = BoundTypeUnit(
            typeIdentity,
            UserClassSemanticType(typeIdentity),
            [function],
            fixture.range(0, 5)
        )
        let program = BoundProgram([type], BoundFunctionUnit[])

        expect(literal.expressionKind()).toBe("literal")
        expect(converted.conversion).toBe(conversion)
        expect(assignment.unitKind()).toBe("assignment")
        expect(returned.unitKind()).toBe("return")
        expect(statement.unitKind()).toBe("external")
        expect(function.statements()).toBe([assignment, returned])
        expect(type.functionUnits()).toBe([function])
        expect(program.typeUnits()).toBe([type])
    }

    test `fixed size array allocation retains typed immutable size evidence`() {
        let fixture = BoundIR_TestFixture()
        let size = BoundLiteralExpression(fixture.range(), SemanticTypes.intType(), "3")
        let allocation = BoundArrayExpression(
            fixture.range(), ArraySemanticType(SemanticTypes.charType()), size
        )

        expect(allocation.expressionKind()).toBe("array-construction")
        expect(allocation.allocationSize).toBe(size)
        expect(allocation.elementValues()).toBe(BoundExpression[])
    }

    test `bound calls retain selected target arguments and conversions`() {
        let fixture = BoundIR_TestFixture()
        let parameter = SemanticTypes.longType()
        let target = CallableSignature(
            fixture.symbol("function", "convert", 1),
            "convert",
            CallableKind("function"),
            [parameter],
            SemanticTypes.stringType()
        )
        let argument = BoundLiteralExpression(fixture.range(), SemanticTypes.intType(), "1")
        let conversion = TypeConversions.classify(argument.semanticType, parameter)
        let call = BoundCallExpression(
            fixture.range(), SemanticTypes.stringType(), target, [argument], [conversion]
        )

        expect(call.expressionKind()).toBe("call")
        expect(call.target).toBe(target)
        expect(call.argumentValues()).toBe([argument])
        expect(call.argumentConversions()).toBe([conversion])
    }

    test `static method value retains selected callable contract`() {
        let fixture = BoundIR_TestFixture()
        let owner = UserClassSemanticType(fixture.declaration("class", "Char", 18))
        let target = CallableSignature(
            fixture.symbol("static-method", "toLowerCase", 19),
            "toLowerCase", CallableKind("static-method"),
            [SemanticTypes.charType()], SemanticTypes.charType(), owner
        )
        let type = FunctionSemanticType(
            target.parameterTypes(), target.returnType
        )
        let value = BoundFunctionValue(fixture.range(), type, target)

        expect(value.expressionKind()).toBe("function-reference")
        expect(value.target).toBe(target)
        expect(value.semanticType.value()).toBe(type.value())
    }

    test `published arrays are defensively copied`() {
        let fixture = BoundIR_TestFixture()
        let statement = BoundExpressionStatement(
            fixture.range(),
            BoundLiteralExpression(fixture.range(), SemanticTypes.intType(), "1")
        )
        let source = BoundStatement[]:add(statement)
        let function = BoundFunctionUnit(
            fixture.declaration("function", "run", 1),
            "run", SemanticTypes.unitType(), source, fixture.range()
        )
        source.add(BoundReturnStatement(fixture.range(), SemanticTypes.unitType()))
        let returned = function.statements()
        returned.add(statement)

        expect(function.statements()).toBe([statement])
    }

    test `parent constructor call retains selected target and immutable conversion evidence`() {
        let fixture = BoundIR_TestFixture()
        let parentIdentity = fixture.declaration("class", "Parent", 1)
        let parentType = UserClassSemanticType(parentIdentity)
        let constructorIdentity = fixture.declaration("constructor", "Parent", 2)
        let target = CallableSignature(
            SymbolIdentity(constructorIdentity, "constructor"),
            "Parent", CallableKind("constructor"), [SemanticTypes.stringType()],
            parentType, parentType
        )
        let argument = BoundLiteralExpression(
            fixture.range(), SemanticTypes.stringType(), "'message'"
        )
        let call = BoundParentConstructorCall(
            target, [argument],
            [TypeConversions.classify(SemanticTypes.stringType(), SemanticTypes.stringType())],
            fixture.range()
        )
        let childConstructor = BoundFunctionUnit(
            fixture.declaration("constructor", "Child", 3),
            "Child", SemanticTypes.unitType(), BoundStatement[], fixture.range(),
            constructorFunction: true, parentConstructorCall: call
        )

        expect(childConstructor.parentConstructorCall.target.ownerType.value()).toBe(parentType.value())
        let retainedArguments = childConstructor.parentConstructorCall.argumentValues()
        let argumentObject = (Object)retainedArguments.first
        let retainedArgument = (BoundLiteralExpression)argumentObject
        expect(retainedArgument.sourceValue).toBe("'message'")
        let copied = childConstructor.parentConstructorCall.argumentValues()
        copied.clear()
        expect(childConstructor.parentConstructorCall.argumentValues().count).toBe(1)
    }

    test `rejects invalid parent constructor evidence`() {
        let fixture = BoundIR_TestFixture()
        let parentIdentity = fixture.declaration("class", "Parent", 1)
        let parentType = UserClassSemanticType(parentIdentity)
        let target = CallableSignature(
            SymbolIdentity(fixture.declaration("constructor", "Parent", 2), "constructor"),
            "Parent", CallableKind("constructor"), [SemanticTypes.stringType()],
            parentType, parentType
        )
        let intArgument = BoundLiteralExpression(fixture.range(), SemanticTypes.intType(), "1")
        var Int rejected
        try {
            BoundParentConstructorCall(
                target, [intArgument],
                [TypeConversions.classify(SemanticTypes.intType(), SemanticTypes.longType())],
                fixture.range()
            )
        } catch (Exception error) { rejected++ }
        try {
            let call = BoundParentConstructorCall(
                target,
                [BoundLiteralExpression(fixture.range(), SemanticTypes.stringType(), "'ok'")],
                [TypeConversions.classify(SemanticTypes.stringType(), SemanticTypes.stringType())],
                fixture.range()
            )
            BoundFunctionUnit(
                fixture.declaration("function", "not-constructor", 3),
                "not-constructor", SemanticTypes.unitType(), BoundStatement[], fixture.range(),
                parentConstructorCall: call
            )
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
    }

    test `inconsistent conversion call return and snapshot evidence is rejected`() {
        let fixture = BoundIR_TestFixture()
        let literal = BoundLiteralExpression(fixture.range(), SemanticTypes.intType(), "1")
        let target = BoundReferenceExpression(
            fixture.range(), SemanticTypes.intType(), "value", fixture.symbol("local", "value", 2)
        )
        var Int rejected
        try {
            BoundAssignmentStatement(
                fixture.range(), target, literal,
                TypeConversions.classify(SemanticTypes.intType(), SemanticTypes.longType())
            )
        } catch (Exception error) { rejected++ }
        try {
            BoundReturnStatement(
                fixture.range(), SemanticTypes.longType(), literal,
                TypeConversions.classify(SemanticTypes.intType(), SemanticTypes.intType())
            )
        } catch (Exception error) { rejected++ }
        let otherSnapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:Other.flat"), "revision:other"
        )
        try {
            BoundFunctionUnit(
                fixture.declaration("function", "run", 1), "run", SemanticTypes.unitType(),
                BoundStatement[],
                SourceRange(
                    otherSnapshot, 0, 1,
                    Location(lineNumber: 1, column: 1),
                    Location(lineNumber: 1, column: 2)
                )
            )
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(3)
        let one = BoundLiteralExpression(fixture.range(), SemanticTypes.intType(), "1")
        expect(BoundUnaryExpression(
            fixture.range(), SemanticTypes.intType(), "-", one
        ).expressionKind()).toBe("unary")
        expect(BoundBinaryExpression(
            fixture.range(), SemanticTypes.intType(), "+", one, one
        ).expressionKind()).toBe("binary")
        let receiver = BoundReferenceExpression(
            fixture.range(), SemanticTypes.objectType(), "this",
            fixture.symbol("receiver", "this", 3)
        )
        expect(receiver.expressionKind()).toBe("reference")
    }
}
