package flat/bound

import flat/compiler/models
import flat/semantic/types

/** Immutable selected free-function or static-method value. */
data class extends BoundExpression {
    public construct(
        SourceRange range,
        SemanticType semanticType,
        visible CallableSignature target
    ) {
        if (!range || !semanticType || semanticType.kind() != "function" || !target ||
            (target.callableKind.value != "function" &&
             target.callableKind.value != "static-method")) {
            throw Exception("Bound function value requires selected function target")
        }
        super(range, semanticType)
    }
    override public expressionKind() => "function-reference"
}
