package flat/bound

import flat/compiler/models
import flat/semantic/types

/** Typed invocation of a first-class function value. */
data class extends BoundExpression {
    var BoundExpression[] arguments

    public construct(
        SourceRange range,
        visible BoundExpression functionValue,
        FunctionSemanticType functionType,
        BoundExpression[] argumentValues
    ) {
        if (!range || !functionValue || !functionType ||
            functionValue.semanticType.value() != functionType.value() ||
            !argumentValues || argumentValues.any({ !_ }) ||
            argumentValues.count != functionType.parameterTypes().count) {
            throw Exception("Bound function invocation requires typed callee and arguments")
        }
        var Int index
        while (index < argumentValues.count) {
            if (!TypeConversions.classify(
                argumentValues[index].semanticType,
                functionType.parameterTypes()[index]
            ).applicable) {
                throw Exception("Bound function invocation argument type mismatch")
            }
            index++
        }
        arguments = BoundExpression[]
        arguments.addAll(argumentValues)
        super(range, functionType.returnType)
    }

    public argumentValues() -> BoundExpression[] => BoundExpression[]:addAll(arguments)
    override public expressionKind() => "function-invocation"
}
