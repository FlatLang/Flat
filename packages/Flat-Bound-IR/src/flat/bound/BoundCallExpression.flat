package flat/bound

import flat/compiler/models
import flat/semantic/types

/** Explicit selected call with optional typed instance receiver.
 * Selected async calls await their result unless the producer marks a
 * promise-preserving context with suppressAwait. This is contextual evidence,
 * not a backend scheduling choice; copies and lowering must preserve it.
 * Arguments are already in selected parameter order. Their count must cover
 * required parameters and may omit only the optional suffix. Each published
 * conversion must be applicable and connect the operand type to its selected
 * parameter type. Preserve that evidence rather than resolving it in a writer.
 * Receiver conversion evidence belongs only to a present instance receiver.
 */
data class extends BoundExpression {
    var BoundExpression[] arguments
    var TypeConversion[] conversions

    public construct(
        SourceRange range,
        SemanticType semanticType,
        visible CallableSignature target,
        visible BoundExpression receiver,
        BoundExpression[] argumentValues,
        TypeConversion[] argumentConversions,
        visible Bool safeAccess = false,
        visible TypeConversion receiverConversion = null,
        visible Bool suppressAwait = false
    ) {
        if (!range || !semanticType || !target || !argumentValues || !argumentConversions ||
            argumentValues.count != argumentConversions.count ||
            (!safeAccess && target.returnType.value() != semanticType.value()) ||
            (safeAccess && (semanticType.kind() != "nullable" ||
                (target.returnType.value() != semanticType.value() &&
                    target.returnType.value() != ((NullableSemanticType)semanticType).underlyingType.value())))) {
            throw Exception("Bound call requires target, result type, and aligned arguments/conversions")
        }
        let parameterTypes = target.parameterTypes()
        if (argumentValues.count < parameterTypes.count - target.optionalParameterCount ||
            argumentValues.count > parameterTypes.count) {
            throw Exception("Bound call argument count does not match selected target")
        }
        let instanceCall = target.callableKind.value == "instance-method"
        if (instanceCall != (receiver != null) || (!receiver && receiverConversion)) {
            throw Exception("Bound instance calls require exactly one receiver and receiver evidence")
        }
        if (safeAccess && !instanceCall) throw Exception("Safe call requires an instance target")
        let receiverType = receiver && safeAccess && receiver.semanticType.kind() == "nullable" ?
            ((NullableSemanticType)receiver.semanticType).underlyingType : receiver ? receiver.semanticType : null
        if (receiver && (!target.ownerType ||
            !(receiverConversion ? receiverConversion.applicable &&
                receiverConversion.fromType.value() == receiverType.value() &&
                receiverConversion.toType.value() == target.receiverType().value() :
                TypeConversions.classify(receiverType, target.receiverType()).applicable))) {
            throw Exception("Bound call receiver is incompatible with selected target")
        }
        var Int index
        while (index < argumentValues.count) {
            if (!argumentValues[index] || !argumentConversions[index] ||
                !argumentConversions[index].applicable ||
                argumentConversions[index].fromType.value() != argumentValues[index].semanticType.value() ||
                argumentConversions[index].toType.value() != parameterTypes[index].value()) {
                throw Exception("Bound call argument conversion does not match its expression and selected parameter")
            }
            index++
        }
        super(range, semanticType)
        arguments = BoundExpression[]
        arguments.addAll(argumentValues)
        conversions = TypeConversion[]
        conversions.addAll(argumentConversions)
    }

    public construct(
        SourceRange range,
        SemanticType semanticType,
        CallableSignature target,
        BoundExpression[] argumentValues,
        TypeConversion[] argumentConversions,
        Bool suppressAwait = false
    ) => this(range, semanticType, target, null, argumentValues, argumentConversions,
        suppressAwait: suppressAwait)

    public argumentValues() -> BoundExpression[] {
        let result = BoundExpression[]
        result.addAll(arguments)
        return result
    }
    public argumentConversions() -> TypeConversion[] {
        let result = TypeConversion[]
        result.addAll(conversions)
        return result
    }
    override public expressionKind() => "call"
}
