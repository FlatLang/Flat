package flat/bound

import flat/compiler/models
import flat/semantic/types

/** Explicit selected call with optional typed instance receiver. */
data class extends BoundExpression {
    var BoundExpression[] arguments
    var TypeConversion[] conversions

    public construct(
        SourceRange range,
        SemanticType semanticType,
        visible CallableSignature target,
        visible BoundExpression receiver,
        BoundExpression[] argumentValues,
        TypeConversion[] argumentConversions
    ) {
        if (!range || !semanticType || !target || !argumentValues || !argumentConversions ||
            argumentValues.count != argumentConversions.count ||
            target.returnType.value() != semanticType.value()) {
            throw Exception("Bound call requires target, result type, and aligned arguments/conversions")
        }
        let instanceCall = target.callableKind.value == "instance-method"
        if (instanceCall != (receiver != null)) {
            throw Exception("Bound instance calls require exactly one receiver")
        }
        if (receiver && (!target.ownerType ||
            !TypeConversions.classify(receiver.semanticType, target.ownerType).applicable)) {
            throw Exception("Bound call receiver is incompatible with selected target")
        }
        var Int index
        while (index < argumentValues.count) {
            if (!argumentValues[index] || !argumentConversions[index] ||
                argumentConversions[index].fromType.value() != argumentValues[index].semanticType.value()) {
                throw Exception("Bound call argument conversion does not match its expression")
            }
            index++
        }
        super(range, semanticType)
        arguments = BoundExpression[]
        arguments.addAll(argumentValues)
        conversions = TypeConversion[]
        conversions.addAll(argumentConversions)
    }

    public construct(
        SourceRange range,
        SemanticType semanticType,
        CallableSignature target,
        BoundExpression[] argumentValues,
        TypeConversion[] argumentConversions
    ) => this(range, semanticType, target, null, argumentValues, argumentConversions)

    public argumentValues() -> BoundExpression[] {
        let result = BoundExpression[]
        result.addAll(arguments)
        return result
    }
    public argumentConversions() -> TypeConversion[] {
        let result = TypeConversion[]
        result.addAll(conversions)
        return result
    }
    override public expressionKind() => "call"
}
