package flat/bound

import flat/compiler/models
import flat/semantic/types

data class {
    public construct(
        visible String name,
        visible SymbolIdentity identity,
        visible SemanticType semanticType,
        visible BoundExpression defaultValue = null
    ) {
        if (!name || !identity || !semanticType ||
            (defaultValue && !TypeConversions.classify(
                defaultValue.semanticType, semanticType
            ).applicable)) {
            throw Exception("Bound function parameter requires name, identity, and type")
        }
    }
}
