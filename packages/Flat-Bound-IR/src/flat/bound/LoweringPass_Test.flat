        let rich = BoundRichCollectionExpression(fixture.range(), objectType, "match", source)
        let number = UserClassSemanticType(fixture.declaration("class", "Number", 85))
        let projection = CallableSignature(fixture.symbol("method", "realValue", 86),
            "realValue", CallableKind("instance-method"), SemanticType[], SemanticTypes.doubleType(), number)
        let conversion = TypeConversions.classify(objectType, SemanticTypes.longType(), explicit: true)
        let projected = TypeConversions.classify(SemanticTypes.doubleType(), SemanticTypes.longType(), explicit: true)
        let unbox = BoundNumericUnboxExpression(fixture.range(), SemanticTypes.longType(), rich,
            number, projection, conversion, projected)
        let input = BoundFunctionUnit(fixture.declaration("function", "read", 87), "read",
            SemanticTypes.unitType(), [BoundExpressionStatement(fixture.range(), unbox)], fixture.range())
