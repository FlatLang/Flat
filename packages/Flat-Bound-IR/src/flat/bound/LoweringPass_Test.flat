package flat/bound

import flat/semantic/types

testable class {
    test `lambda declaration contract remains separate from concrete return through every lowering pass`() {
        let fixture = BoundIR_TestFixture()
        let intType = SemanticTypes.intType()
        let declaredResult = GenericParameterSemanticType(fixture.declaration("function", "map", 200), "R", 0)
        let declaration = FunctionSemanticType(SemanticType[], declaredResult, asyncFunction: true)
        let concrete = FunctionSemanticType(SemanticType[], intType, asyncFunction: true)
        let literal = BoundLiteralExpression(fixture.range(), intType, "7")
        let conversion = TypeConversions.classify(intType, intType)
        let returned = BoundReturnStatement(fixture.range(), intType, literal, conversion)
        let boxedType = UserClassSemanticType(fixture.declaration("class", "Int", 202))
        let boxingConstructor = CallableSignature(fixture.symbol("constructor", "Int", 203), "Int",
            CallableKind("constructor"), [intType], boxedType, boxedType)
        let lambda = BoundLambdaExpression(fixture.range(), concrete, BoundFunctionParameter[],
            BoundReferenceExpression[], literal, [returned], declarationContract: declaration,
            resultBoxingConstructor: boxingConstructor)
        let input = BoundFunctionUnit(fixture.declaration("function", "run", 201), "run",
            SemanticTypes.unitType(), [BoundExpressionStatement(fixture.range(), lambda)], fixture.range())
        BoundFunctionLoweringPass[] passes = [CoreLanguageLoweringPass(), ExternalNativeLoweringPass(),
            DeferredExecutionLoweringPass(), CollectionControlLoweringPass()]
        for (pass in passes) {
            let output = pass.lower(input)
            let statements = output.statements()
            Object statementObject = statements.first
            BoundExpressionStatement statement = (BoundExpressionStatement)statementObject
            Object lambdaObject = statement.expression
            BoundLambdaExpression lowered = (BoundLambdaExpression)lambdaObject
            expect(lowered.semanticType).toBe(concrete)
            expect(lowered.declarationContract).toBe(declaration)
            expect(lowered.resultBoxingConstructor).toBe(boxingConstructor)
            expect(lowered.resultBoxingConstructor.identity).toBe(boxingConstructor.identity)
            expect(lowered.declarationContract.returnType).toBe(declaredResult)
            expect(lowered.body.semanticType).toBe(intType)
            let body = lowered.statementValues()
            Object returnedObject = body.first
            BoundReturnStatement loweredReturn = (BoundReturnStatement)returnedObject
            expect(loweredReturn.requiredType).toBe(intType)
            expect(loweredReturn.value).toBe(literal)
            expect(loweredReturn.conversion).toBe(conversion)
        }
        let ordinary = BoundLambdaExpression(fixture.range(), concrete, BoundFunctionParameter[],
            BoundReferenceExpression[], literal)
        expect(ordinary.declarationContract == null).toBe(true)
        expect(ordinary.resultBoxingConstructor == null).toBe(true)
        var Bool rejected
        try {
            BoundLambdaExpression(fixture.range(), concrete, BoundFunctionParameter[],
                BoundReferenceExpression[], literal, declarationContract:
                    FunctionSemanticType([intType], declaredResult, asyncFunction: true))
        } catch (Exception error) { rejected = true }
        expect(rejected).toBe(true)
    }
    test `foreach latch separates advance from all body cleanup and abrupt exit alternatives`() {
        let fixture = BoundIR_TestFixture()
        let intType = SemanticTypes.intType()
        let boolType = SemanticTypes.boolType()
        let value = BoundLiteralExpression(fixture.range(), intType, "1")
        let condition = BoundLiteralExpression(fixture.range(), boolType, "true")
        let continuation = BoundContinueStatement(fixture.range())
        let broken = BoundBreakStatement(fixture.range())
        let returned = BoundReturnStatement(fixture.range(), intType, value, TypeConversions.classify(intType, intType))
        let throwable = BoundLiteralExpression(fixture.range(), SemanticTypes.stringType(), "\"failure\"")
        let thrown = BoundThrowStatement(fixture.range(), throwable)
        let cleanup = BoundExpressionStatement(fixture.range(), value)
        let advance = BoundExpressionStatement(fixture.range(8, 9), value)
        let error = BoundReferenceExpression(fixture.range(), SemanticTypes.objectType(), "error",
            fixture.symbol("catch", "error", 170))
        // Each alternative remains under its original cleanup. No exit path may
        // receive an injected advance; only the loop-owned latch owns advance.
        BoundStatement[] exits = [continuation, broken, returned, thrown]
        BoundStatement[] replacements = [cleanup, continuation, broken, returned, thrown]
        for (exit in exits) {
            for (replacement in replacements) {
                let guarded = BoundTryStatement(fixture.range(), [exit],
                    [BoundCatchClause(fixture.range(), error, [continuation])], [replacement])
                let loop = BoundForEachStatement(fixture.range(), BoundStatement[], condition,
                    [guarded], [advance], "loop", "exit")
                let input = BoundFunctionUnit(fixture.declaration("function", "run", 171), "run",
                    intType, [loop], fixture.range())
                let output = CollectionControlLoweringPass().lower(input)
                BoundIRAssertions.assertNoRichCollectionForms(output)
                let statements = output.statements()
                expect(statements.count).toBe(1)
                Object castSource1 = statements.first
                BoundLoopLatchStatement latch = (BoundLoopLatchStatement)castSource1
                expect(latch.advanceValues()).toBe([advance])
                let body = latch.bodyValues()
                expect(body.count).toBe(1)
                Object castSource2 = body.first
                BoundTryStatement lowered = (BoundTryStatement)castSource2
                expect(lowered.tryValues().count).toBe(1)
                expect(lowered.tryValues().first.unitKind()).toBe(exit.unitKind())
                expect(lowered.finallyValues().count).toBe(1)
                expect(lowered.finallyValues().first.unitKind()).toBe(replacement.unitKind())
                let catches = lowered.catchValues()
                expect(catches.first.statements()).toBe([continuation])
                expect(guarded.tryValues()).toBe([exit])
                expect(loop.advance()).toBe([advance])
            }
        }
    }

    test `foreach latch retains evaluation setup continues and nested switch ownership`() {
        let fixture = BoundIR_TestFixture()
        let boolType = SemanticTypes.boolType()
        let condition = BoundLiteralExpression(fixture.range(), boolType, "true")
        let continuation = BoundContinueStatement(fixture.range())
        let cleanup = BoundExpressionStatement(fixture.range(), condition)
        let guarded = BoundTryStatement(fixture.range(), [continuation], BoundCatchClause[], [cleanup])
        let evaluation = BoundEvaluationExpression(fixture.range(), boolType, [guarded], condition)
        let switched = BoundSwitchStatement(fixture.range(), condition,
            [BoundSwitchCase(fixture.range(), null, [BoundExpressionStatement(fixture.range(), evaluation)], true)])
        let nested = BoundWhileStatement(fixture.range(), condition, [continuation])
        let advance = BoundExpressionStatement(fixture.range(9, 10), condition)
        let loop = BoundForEachStatement(fixture.range(), BoundStatement[], condition,
            [nested, switched], [advance], "outer", "outer-exit")
        let input = BoundFunctionUnit(fixture.declaration("function", "run", 180), "run",
            SemanticTypes.unitType(), [loop], fixture.range())
        let statements = CollectionControlLoweringPass().lower(input).statements()
        Object castSource3 = statements.first
        BoundLoopLatchStatement latch = (BoundLoopLatchStatement)castSource3
        let body = latch.bodyValues()
        Object castSource4 = body.first
        BoundWhileStatement inner = (BoundWhileStatement)castSource4
        expect(inner.bodyValues()).toBe([continuation])
        Object castSource5 = body.last
        BoundSwitchStatement loweredSwitch = (BoundSwitchStatement)castSource5
        let cases = loweredSwitch.caseValues()
        let caseBody = cases.first.statementValues()
        Object castSource6 = caseBody.first
        BoundExpressionStatement statement = (BoundExpressionStatement)castSource6
        Object castSource7 = statement.expression
        BoundEvaluationExpression selected = (BoundEvaluationExpression)castSource7
        let setup = selected.setup()
        Object castSource8 = setup.first
        BoundTryStatement loweredTry = (BoundTryStatement)castSource8
        expect(loweredTry.tryValues()).toBe([continuation])
        expect(loweredTry.finallyValues()).toBe([cleanup])
        expect(latch.advanceValues()).toBe([advance])
        expect(body.count).toBe(2)
    }

    test `loop latch snapshots and recursive passes preserve identity and lower all three evaluation sites`() {
        let fixture = BoundIR_TestFixture()
        let boolType = SemanticTypes.boolType()
        let nativeValue = BoundNativeCallExpression(fixture.range(), boolType, "foreign.ready", BoundExpression[])
        let foreignValue = BoundExternalExpression(fixture.range(), boolType, "external", nativeValue)
        let setup = BoundExpressionStatement(fixture.range(), nativeValue)
        let deferred = BoundDeferredExpression(fixture.range(), boolType, "closure", [setup], foreignValue)
        let body = BoundStatement[]
        body.add(BoundExpressionStatement(fixture.range(), deferred))
        let advance = BoundStatement[]
        advance.add(BoundExpressionStatement(fixture.range(), foreignValue))
        let loopIdentity = fixture.declaration("loop", "latch", 190).syntaxIdentity
        let latch = BoundLoopLatchStatement(fixture.range(), deferred, body, advance, loopIdentity)
        body.add(setup)
        advance.add(setup)
        let copy = latch.advanceValues()
        copy.add(setup)
        expect(latch.bodyValues().count).toBe(1)
        expect(latch.advanceValues().count).toBe(1)
        let input = BoundFunctionUnit(fixture.declaration("function", "run", 191), "run",
            SemanticTypes.unitType(), [latch], fixture.range())
        let lowered = ExternalNativeLoweringPass().lower(DeferredExecutionLoweringPass().lower(
            CoreLanguageLoweringPass().lower(CollectionControlLoweringPass().lower(input))))
        BoundIRAssertions.assertNoDeferredForms(lowered)
        BoundIRAssertions.assertNoExternalForms(lowered)
        let statements = lowered.statements()
        Object castSource9 = statements.first
        BoundLoopLatchStatement output = (BoundLoopLatchStatement)castSource9
        expect(output.loopIdentity).toBe(loopIdentity)
        Object castSource10 = output.condition
        BoundEvaluationExpression condition = (BoundEvaluationExpression)castSource10
        expect(condition.setup().count).toBe(1)
        expect(condition.value.expressionKind()).toBe("native-call")
        let advanced = output.advanceValues()
        Object castSource11 = advanced.first
        BoundExpressionStatement advancedStatement = (BoundExpressionStatement)castSource11
        expect(advancedStatement.expression.expressionKind()).toBe("native-call")
        var Bool rejected
        try { BoundLoopLatchStatement(fixture.range(),
            BoundLiteralExpression(fixture.range(), SemanticTypes.intType(), "1"),
            BoundStatement[], BoundStatement[], loopIdentity) }
        catch (Exception error) { rejected = true }
        expect(rejected).toBe(true)
    }
    test `recursive native lowering reaches array sizes interpolation and foreign value segments`() {
        let fixture = BoundIR_TestFixture()
        let intType = SemanticTypes.intType()
        let identity = TypeConversions.classify(intType, intType)
        let nativeValue = BoundNativeCallExpression(fixture.range(), intType, "foreign.read", BoundExpression[])
        let foreignValue = BoundExternalExpression(fixture.range(), intType, "external", nativeValue)
        let arrayType = ArraySemanticType(intType)
        let array = BoundArrayExpression(fixture.range(), arrayType, foreignValue)
        let access = BoundArrayAccessExpression(fixture.range(), intType, array, foreignValue)
        let interpolated = BoundInterpolatedStringExpression(fixture.range(),
            [BoundInterpolatedStringSegment(fixture.range(), null, access)])
        let opaque = BoundExternalStatement(fixture.range(), "es6",
            [BoundExternalCodeSegment(fixture.range(), "", foreignValue, "value")])
        let declaration = BoundReferenceExpression(fixture.range(), intType, "result",
            fixture.symbol("local", "result", 160))
        let stored = BoundDeclarationValueExpression(fixture.range(), intType, declaration, foreignValue, identity)
        let input = BoundFunctionUnit(fixture.declaration("function", "run", 161), "run",
            SemanticTypes.unitType(), [BoundExpressionStatement(fixture.range(), interpolated), opaque,
                BoundExpressionStatement(fixture.range(), stored)], fixture.range())
        let output = ExternalNativeLoweringPass().lower(input)
        BoundIRAssertions.assertNoExternalForms(output)
        let statements = output.statements()
        Object castSource12 = statements.first
        BoundExpressionStatement first = (BoundExpressionStatement)castSource12
        Object castSource13 = first.expression
        BoundInterpolatedStringExpression text = (BoundInterpolatedStringExpression)castSource13
        let segments = text.segmentValues()
        Object castSource14 = segments.first.expression
        BoundArrayAccessExpression loweredAccess = (BoundArrayAccessExpression)castSource14
        expect(loweredAccess.index.expressionKind()).toBe("native-call")
        Object castSource15 = loweredAccess.receiver
        BoundArrayExpression allocation = (BoundArrayExpression)castSource15
        expect(allocation.allocationSize.expressionKind()).toBe("native-call")
        Object castSource16 = statements[1]
        BoundExternalStatement second = (BoundExternalStatement)castSource16
        let values = second.segmentValues()
        expect(values.first.value.expressionKind()).toBe("native-call")
        expect(values.first.rendering).toBe("value")
        Object castSource17 = statements.last
        BoundExpressionStatement third = (BoundExpressionStatement)castSource17
        Object castSource18 = third.expression
        BoundDeclarationValueExpression loweredStored = (BoundDeclarationValueExpression)castSource18
        expect(loweredStored.local).toBe(declaration)
        expect(loweredStored.storageConversion).toBe(identity)
        expect(loweredStored.value.expressionKind()).toBe("native-call")
    }
    test `recursive invariant checks reject rich forms hidden beneath structured bodies`() {
        let fixture = BoundIR_TestFixture()
        let throwableType = SemanticTypes.stringType()
        let nativeValue = BoundNativeCallExpression(fixture.range(), throwableType, "foreign.read", BoundExpression[])
        let foreignValue = BoundExternalExpression(fixture.range(), throwableType, "external", nativeValue)
        let guarded = BoundIfStatement(fixture.range(),
            BoundLiteralExpression(fixture.range(), SemanticTypes.boolType(), "false"),
            [BoundThrowStatement(fixture.range(), foreignValue)])
        let input = BoundFunctionUnit(fixture.declaration("function", "run", 140), "run",
            SemanticTypes.unitType(), [guarded], fixture.range())
        var Bool rejected
        try { BoundIRAssertions.assertNoExternalForms(input) }
        catch (Exception error) { rejected = true }
        expect(rejected).toBe(true)
        BoundIRAssertions.assertNoExternalForms(ExternalNativeLoweringPass().lower(input))
    }

    test `recursive lowering visits defaults parent calls and constructor delegation`() {
        let fixture = BoundIR_TestFixture()
        let intType = SemanticTypes.intType()
        let unitType = SemanticTypes.unitType()
        let nativeValue = BoundNativeCallExpression(fixture.range(), intType, "foreign.read", BoundExpression[])
        let foreignValue = BoundExternalExpression(fixture.range(), intType, "external", nativeValue)
        let parentType = UserClassSemanticType(fixture.declaration("class", "Parent", 149))
        let target = CallableSignature(fixture.symbol("constructor", "Parent", 150), "Parent",
            CallableKind("constructor"), [intType], parentType, parentType)
        let identity = TypeConversions.classify(intType, intType)
        let parameter = BoundFunctionParameter("value", fixture.symbol("parameter", "value", 151), intType, foreignValue)
        let input = BoundFunctionUnit(fixture.declaration("constructor", "Child", 152), "Child", unitType,
            BoundStatement[], fixture.range(), [parameter], constructorFunction: true,
            parentConstructorCall: BoundParentConstructorCall(target, [foreignValue], [identity], fixture.range()))
        let childType = UserClassSemanticType(fixture.declaration("class", "Child", 153))
        let childTarget = CallableSignature(fixture.symbol("constructor", "Child", 154), "Child",
            CallableKind("constructor"), [intType], childType, childType)
        let delegated = BoundFunctionUnit(input.identity, input.name, unitType,
            BoundStatement[], fixture.range(), [parameter], constructorFunction: true,
            constructorDelegation: BoundConstructorDelegation(childTarget, [foreignValue], [identity], fixture.range()))
        let parentResult = ExternalNativeLoweringPass().lower(input)
        let delegationResult = ExternalNativeLoweringPass().lower(delegated)
        expect(parentResult.parameterValues().first.defaultValue.expressionKind()).toBe("native-call")
        expect(parentResult.parameterValues().first.identity).toBe(parameter.identity)
        expect(parentResult.parentConstructorCall.argumentValues().first.expressionKind()).toBe("native-call")
        expect(parentResult.parentConstructorCall.argumentConversions()).toBe([identity])
        expect(delegationResult.constructorDelegation.argumentValues().first.expressionKind()).toBe("native-call")
        expect(delegationResult.constructorDelegation.target).toBe(childTarget)
        expect(delegationResult.constructorDelegation.target.ownerType.declarationIdentity).toBe(childType.declarationIdentity)
        expect(parentResult.parentConstructorCall.target).toBe(target)
        expect(parameter.defaultValue).toBe(foreignValue)
    }
    test `core and native rewrites reach nested loops switch catch finally and lambda bodies`() {
        let fixture = BoundIR_TestFixture()
        let intType = SemanticTypes.intType()
        let boolType = SemanticTypes.boolType()
        let identity = TypeConversions.classify(intType, intType)
        let target = CallableSignature(fixture.symbol("function", "read", 100), "read",
            CallableKind("function"), SemanticType[], intType)
        let rich = BoundRichCallExpression(fixture.range(), intType, "property-get",
            BoundCallExpression(fixture.range(), intType, target, BoundExpression[], TypeConversion[]))
        let foreignValue = BoundExternalExpression(fixture.range(), intType, "external",
            BoundNativeCallExpression(fixture.range(), intType, "foreign.read", [rich]))
        let localReference = BoundReferenceExpression(fixture.range(), intType, "result",
            fixture.symbol("local", "result", 101))
        let declaration = BoundLocalDeclarationStatement(fixture.range(), localReference, foreignValue, identity)
        let condition = BoundLiteralExpression(fixture.range(), boolType, "true")
        let branch = BoundIfStatement(fixture.range(), condition, [declaration], [declaration])
        let loop = BoundWhileStatement(fixture.range(), condition, [branch, BoundContinueStatement(fixture.range())])
        let switched = BoundSwitchStatement(fixture.range(), localReference,
            [BoundSwitchCase(fixture.range(), null, [loop], true)])
        let error = BoundReferenceExpression(fixture.range(), SemanticTypes.objectType(), "error",
            fixture.symbol("catch", "error", 102))
        let guarded = BoundTryStatement(fixture.range(), [switched],
            [BoundCatchClause(fixture.range(), error, [branch], acceptsSoftExceptions: true)], [branch])
        let signature = FunctionSemanticType(SemanticType[], intType)
        let lambda = BoundLambdaExpression(fixture.range(), signature, BoundFunctionParameter[],
            [localReference], foreignValue, [guarded])
        let input = BoundFunctionUnit(fixture.declaration("function", "run", 103), "run",
            SemanticTypes.unitType(), [BoundExpressionStatement(fixture.range(), lambda)], fixture.range())
        let nativeFirst = CoreLanguageLoweringPass().lower(ExternalNativeLoweringPass().lower(input))
        let coreFirst = ExternalNativeLoweringPass().lower(CoreLanguageLoweringPass().lower(input))
        BoundFunctionUnit[] loweredOrders = [nativeFirst, coreFirst]
        for (output in loweredOrders) {
            BoundIRAssertions.assertNoRichCoreForms(output)
            BoundIRAssertions.assertNoExternalForms(output)
            let statements = output.statements()
            Object castSource19 = statements.first
            BoundExpressionStatement statement = (BoundExpressionStatement)castSource19
            Object castSource20 = statement.expression
            BoundLambdaExpression lowered = (BoundLambdaExpression)castSource20
            expect(lowered.captureValues()).toBe([localReference])
            Object castSource21 = lowered.body
            BoundNativeCallExpression loweredBody = (BoundNativeCallExpression)castSource21
            expect(loweredBody.argumentValues().first.expressionKind()).toBe("call")
            let lambdaStatements = lowered.statementValues()
            Object castSource22 = lambdaStatements.first
            BoundTryStatement loweredTry = (BoundTryStatement)castSource22
            let tryStatements = loweredTry.tryValues()
            Object castSource23 = tryStatements.first
            BoundSwitchStatement loweredSwitch = (BoundSwitchStatement)castSource23
            let cases = loweredSwitch.caseValues()
            let caseStatements = cases.first.statementValues()
            Object castSource24 = caseStatements.first
            BoundWhileStatement loweredLoop = (BoundWhileStatement)castSource24
            let loopStatements = loweredLoop.bodyValues()
            expect(loopStatements.last.unitKind()).toBe("continue")
            Object castSource25 = loopStatements.first
            BoundIfStatement nested = (BoundIfStatement)castSource25
            let catches = loweredTry.catchValues()
            expect(catches.first.acceptsSoftExceptions).toBe(true)
            expect(catches.first.local).toBe(error)
            let caughtStatements = catches.first.statements()
            Object castSource26 = caughtStatements.first
            BoundIfStatement caughtBranch = (BoundIfStatement)castSource26
            let finallyStatements = loweredTry.finallyValues()
            Object castSource27 = finallyStatements.first
            BoundIfStatement finallyBranch = (BoundIfStatement)castSource27
            let branchBodies = BoundStatement[][]
            branchBodies.add(nested.thenValues())
            branchBodies.add(nested.elseValues())
            branchBodies.add(caughtBranch.thenValues())
            branchBodies.add(finallyBranch.thenValues())
            for (body in branchBodies) {
                Object castSource28 = body.first
                BoundLocalDeclarationStatement loweredDeclaration = (BoundLocalDeclarationStatement)castSource28
                Object castSource29 = loweredDeclaration.initializer
                BoundNativeCallExpression nativeValue = (BoundNativeCallExpression)castSource29
                expect(nativeValue.argumentValues().first.expressionKind()).toBe("call")
                expect(loweredDeclaration.local).toBe(localReference)
                expect(loweredDeclaration.conversion).toBe(identity)
            }
        }
        expect(lambda.body).toBe(foreignValue)
        expect(declaration.initializer).toBe(foreignValue)
    }

    test `deferred setup remains under lazy operands ternary branches and repeated loop conditions`() {
        let fixture = BoundIR_TestFixture()
        let boolType = SemanticTypes.boolType()
        let yes = BoundLiteralExpression(fixture.range(), boolType, "true")
        let no = BoundLiteralExpression(fixture.range(), boolType, "false")
        let marker = BoundExpressionStatement(fixture.range(),
            BoundLiteralExpression(fixture.range(), SemanticTypes.unitType(), "setup"))
        let deferred = BoundDeferredExpression(fixture.range(), boolType, "closure", [marker], yes)
        let selected = BoundConditionalExpression(fixture.range(), boolType, no, deferred, deferred)
        let andValue = BoundBinaryExpression(fixture.range(), boolType, "&&", no, selected)
        let orValue = BoundBinaryExpression(fixture.range(), boolType, "||", yes, deferred)
        let loop = BoundWhileStatement(fixture.range(), deferred,
            [BoundExpressionStatement(fixture.range(), andValue), BoundExpressionStatement(fixture.range(), orValue),
                BoundContinueStatement(fixture.range())])
        let input = BoundFunctionUnit(fixture.declaration("function", "run", 110), "run",
            SemanticTypes.unitType(), [loop], fixture.range())
        let statements = DeferredExecutionLoweringPass().lower(input).statements()
        expect(statements.count).toBe(1)
        Object castSource30 = statements.first
        BoundWhileStatement lowered = (BoundWhileStatement)castSource30
        Object castSource31 = lowered.condition
        BoundEvaluationExpression condition = (BoundEvaluationExpression)castSource31
        expect(condition.setup()).toBe([marker])
        expect(condition.value).toBe(yes)
        let body = lowered.bodyValues()
        expect(body.count).toBe(3)
        expect(body.last.unitKind()).toBe("continue")
        Object castSource32 = body[0]
        BoundExpressionStatement first = (BoundExpressionStatement)castSource32
        Object castSource33 = first.expression
        BoundBinaryExpression andExpression = (BoundBinaryExpression)castSource33
        expect(andExpression.left).toBe(no)
        Object castSource34 = andExpression.right
        BoundConditionalExpression ternary = (BoundConditionalExpression)castSource34
        expect(ternary.condition).toBe(no)
        Object castSource35 = ternary.whenTrue
        BoundEvaluationExpression whenTrue = (BoundEvaluationExpression)castSource35
        Object castSource36 = ternary.whenFalse
        BoundEvaluationExpression whenFalse = (BoundEvaluationExpression)castSource36
        expect(whenTrue.setup()).toBe([marker])
        expect(whenFalse.setup()).toBe([marker])
        Object castSource37 = body[1]
        BoundExpressionStatement second = (BoundExpressionStatement)castSource37
        Object castSource38 = second.expression
        BoundBinaryExpression orExpression = (BoundBinaryExpression)castSource38
        expect(orExpression.left).toBe(yes)
        Object selectedValue1Object = orExpression.right
        BoundEvaluationExpression selectedValue1 = (BoundEvaluationExpression)selectedValue1Object
        expect(selectedValue1.setup()).toBe([marker])
        expect(loop.condition).toBe(deferred)
    }

    test `deferred setup retains abrupt control and cleanup owners without introducing a lambda`() {
        let fixture = BoundIR_TestFixture()
        let intType = SemanticTypes.intType()
        let literal = BoundLiteralExpression(fixture.range(), intType, "7")
        let identity = TypeConversions.classify(intType, intType)
        let returned = BoundReturnStatement(fixture.range(), intType, literal, identity)
        let continued = BoundContinueStatement(fixture.range())
        let broken = BoundBreakStatement(fixture.range())
        let cleanup = BoundExpressionStatement(fixture.range(), literal)
        let guarded = BoundTryStatement(fixture.range(), [returned], BoundCatchClause[], [cleanup])
        let deferred = BoundDeferredExpression(fixture.range(), intType, "async",
            [guarded, continued, broken], literal)
        let returnedValue = BoundReturnStatement(fixture.range(), intType, deferred, identity)
        let loop = BoundWhileStatement(fixture.range(),
            BoundLiteralExpression(fixture.range(), SemanticTypes.boolType(), "true"), [returnedValue])
        let input = BoundFunctionUnit(fixture.declaration("function", "run", 120), "run",
            intType, [loop], fixture.range(), asyncFunction: true)
        let statements = DeferredExecutionLoweringPass().lower(input).statements()
        expect(statements.count).toBe(1)
        Object castSource39 = statements.first
        BoundWhileStatement loweredLoop = (BoundWhileStatement)castSource39
        let body = loweredLoop.bodyValues()
        Object castSource40 = body.first
        BoundReturnStatement lowered = (BoundReturnStatement)castSource40
        Object castSource41 = lowered.value
        BoundEvaluationExpression evaluation = (BoundEvaluationExpression)castSource41
        let setup = evaluation.setup()
        expect(setup.count).toBe(3)
        Object castSource42 = setup[0]
        BoundTryStatement loweredTry = (BoundTryStatement)castSource42
        expect(loweredTry.tryValues().first.unitKind()).toBe("return")
        expect(loweredTry.finallyValues().first.unitKind()).toBe("expression")
        expect(setup[1]).toBe(continued)
        expect(setup[2]).toBe(broken)
        expect(evaluation.value).toBe(literal)
        expect(lowered.conversion).toBe(identity)
        let copied = evaluation.setup()
        copied.add(cleanup)
        expect(evaluation.setup().count).toBe(3)
    }

    test `deferred operands remain inside safe call selection with single receiver evaluation`() {
        let fixture = BoundIR_TestFixture()
        let owner = UserClassSemanticType(fixture.declaration("class", "Box", 130))
        let intType = SemanticTypes.intType()
        let resultType = NullableSemanticType(intType)
        let marker = BoundExpressionStatement(fixture.range(), BoundLiteralExpression(fixture.range(), intType, "0"))
        let source = BoundLiteralExpression(fixture.range(), owner, "box")
        let receiver = BoundDeferredExpression(fixture.range(), owner, "closure", [marker], source)
        let argument = BoundDeferredExpression(fixture.range(), intType, "closure", [marker],
            BoundLiteralExpression(fixture.range(), intType, "1"))
        let target = CallableSignature(fixture.symbol("method", "read", 131), "read",
            CallableKind("instance-method"), [intType], intType, owner, asyncFunction: true)
        let call = BoundCallExpression(fixture.range(), resultType, target, receiver, [argument],
            [TypeConversions.classify(intType, intType)], safeAccess: true, suppressAwait: true)
        let input = BoundFunctionUnit(fixture.declaration("function", "run", 132), "run",
            SemanticTypes.unitType(), [BoundExpressionStatement(fixture.range(), call)], fixture.range())
        let deferredFirst = CollectionControlLoweringPass().lower(DeferredExecutionLoweringPass().lower(input))
        let collectionFirst = DeferredExecutionLoweringPass().lower(CollectionControlLoweringPass().lower(input))
        BoundFunctionUnit[] loweredOrders = [deferredFirst, collectionFirst]
        for (output in loweredOrders) {
            let statements = output.statements()
            // Deferred lowering may inline a whole-statement evaluation prelude;
            // either shape retains exactly one receiver declaration, before selection.
            var BoundConditionalExpression conditional
            if (statements.count == 1) {
                Object castSource43 = statements.first
                BoundExpressionStatement statement = (BoundExpressionStatement)castSource43
                Object castSource44 = statement.expression
                BoundEvaluationExpression evaluation = (BoundEvaluationExpression)castSource44
                let setup = evaluation.setup()
                Object castSource45 = setup.first
                BoundLocalDeclarationStatement declaration = (BoundLocalDeclarationStatement)castSource45
                Object selectedValue2Object = declaration.initializer
                BoundEvaluationExpression selectedValue2 = (BoundEvaluationExpression)selectedValue2Object
                expect(selectedValue2.setup()).toBe([marker])
                conditional = (BoundConditionalExpression)evaluation.value
            } else {
                expect(statements.count).toBe(2)
                Object castSource46 = statements.first
                BoundLocalDeclarationStatement declaration = (BoundLocalDeclarationStatement)castSource46
                Object selectedValue3Object = declaration.initializer
                BoundEvaluationExpression selectedValue3 = (BoundEvaluationExpression)selectedValue3Object
                expect(selectedValue3.setup()).toBe([marker])
                Object castSource47 = statements.last
                BoundExpressionStatement statement = (BoundExpressionStatement)castSource47
                conditional = (BoundConditionalExpression)statement.expression
            }
            Object castSource48 = conditional.whenFalse
            BoundConversionExpression converted = (BoundConversionExpression)castSource48
            Object castSource49 = converted.value
            BoundCallExpression selected = (BoundCallExpression)castSource49
            expect(selected.suppressAwait).toBe(true)
            expect(selected.target).toBe(target)
            let arguments = selected.argumentValues()
            Object selectedValue4Object = arguments.first
            BoundEvaluationExpression selectedValue4 = (BoundEvaluationExpression)selectedValue4Object
            expect(selectedValue4.setup()).toBe([marker])
        }
    }
    test `collection lowering descends through numeric projection preserving selected evidence`() {
        let fixture = BoundIR_TestFixture()
