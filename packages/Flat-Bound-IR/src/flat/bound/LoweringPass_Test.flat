            fixture.range(),
            BoundLiteralExpression(fixture.range(), unitType, "initialize")
        )
        let body = BoundExpressionStatement(fixture.range(), matchValue)
        let advance = BoundExpressionStatement(
            fixture.range(),
            BoundLiteralExpression(fixture.range(), unitType, "advance")
        )
        let condition = BoundLiteralExpression(fixture.range(), boolType, "true")
        let foreach = BoundForEachStatement(
            fixture.range(),
            [initialize],
            condition,
            [body],
            [advance],
            "loop:#{fixture.snapshot.value}:1",
            "exit:#{fixture.snapshot.value}:1"
