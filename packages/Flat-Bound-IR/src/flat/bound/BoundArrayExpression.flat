package flat/bound

import flat/compiler/models
import flat/semantic/types

/** Typed immutable array literal or fixed-size allocation. */
data class extends BoundExpression {
    var BoundExpression[] elements
    visible BoundExpression allocationSize
    public construct(
        SourceRange range,
        ArraySemanticType semanticType,
        BoundExpression[] values
    ) {
        if (!range || !semanticType || !values || values.any({ !_ })) {
            throw Exception("Bound array requires type and elements")
        }
        super(range, semanticType)
        elements = BoundExpression[]
        elements.addAll(values)
    }
    public construct(
        SourceRange range,
        ArraySemanticType semanticType,
        BoundExpression size
    ) {
        if (!range || !semanticType || !size ||
            size.semanticType.value() != SemanticTypes.intType().value()) {
            throw Exception("Bound array allocation requires array type and Int size")
        }
        super(range, semanticType)
        elements = BoundExpression[]
        allocationSize = size
    }
    public elementValues() -> BoundExpression[] => BoundExpression[]:addAll(elements)
    override public expressionKind() => allocationSize ? "array-construction" : "array"
}
