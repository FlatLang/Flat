package flat/bound

import flat/compiler/models
import flat/semantic/types

data class extends BoundStatement {
    public construct(
        SourceRange range,
        visible SemanticType requiredType,
        visible BoundExpression value = null,
        visible TypeConversion conversion = null
    ) {
        if (!range || !requiredType) throw Exception("Bound return requires range and required type")
        if (value && (!conversion || !conversion.applicable ||
            conversion.fromType.value() != value.semanticType.value() ||
            conversion.toType.value() != requiredType.value())) {
            throw Exception("Bound return value requires consistent conversion")
        }
        if (!value && conversion) throw Exception("Value-less return cannot carry a conversion")
        super(range)
    }
    override public unitKind() => "return"
}
