package flat/bound

/** Lowers setup without moving it across an operand's evaluation boundary. */
class extends BoundTreeLoweringPass {
    override public name() => "deferred-execution-forms"
    override public inputInvariant() => "typed-deferred-and-static-forms"
    override public outputInvariant() => "explicit-setup-and-canonical-values"

    override public lowerStatement(BoundStatement statement, BoundStatement[] output) {
        if (statement.class.isOfType(BoundStaticInitializationStatement.class)) {
            let value = (BoundStaticInitializationStatement)statement
            output.addAll(lowerStatements(value.initialization()))
        } else if (statement.class.isOfType(BoundExpressionStatement.class)) {
            let value = (BoundExpressionStatement)statement
            let lowered = lowerExpression(value.expression)
            // Only the entire statement operand has no earlier sibling or lazy
            // selection boundary. Its prelude can remain ordinary statements.
            if (lowered.class.isOfType(BoundEvaluationExpression.class)) {
                let evaluation = (BoundEvaluationExpression)lowered
                output.addAll(evaluation.setup())
                output.add(BoundExpressionStatement(value.range, evaluation.value))
            } else output.add(BoundExpressionStatement(value.range, lowered))
        } else super.lowerStatement(statement, output)
    }

    override public lowerExpression(BoundExpression expression) -> BoundExpression {
        if (expression && expression.class.isOfType(BoundDeferredExpression.class)) {
            let value = (BoundDeferredExpression)expression
            let setup = lowerStatements(value.setup())
            let canonical = lowerExpression(value.canonicalExpression)
            if (setup.isEmpty) return canonical
            return BoundEvaluationExpression(value.range, value.semanticType, setup, canonical)
        }
        return super.lowerExpression(expression)
    }
}
