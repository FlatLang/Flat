package flat/bound

import flat/compiler/models
import flat/semantic/types

/** Target-independent projection from an array value to its native backing representation. */
data class extends BoundExpression {
    public construct(
        SourceRange range,
        visible BoundExpression receiver
    ) {
        if (!range || !receiver || receiver.semanticType.kind() != "array") {
            throw Exception("Bound native array data requires an array receiver")
        }
        super(range, receiver.semanticType)
    }
    override public expressionKind() => "native-array-data"
}
