package flat/future

import flat/thread
import flat/time

testable class {
    async test `Future.from: can delay the execution of the future`() {
        let start = Time.currentTimeMillis

        let future = Future.from(async {
            Thread.sleep(100)
            return "hey"
        })

        let end = Time.currentTimeMillis
        let response = await future.get()

        expect(end - start < 90).toBe(true)
        expect(response).toBe("hey")
    }

    async test `Future.from: can wait for the execution of the future`() {
        let start = Time.currentTimeMillis

        let future = Future.from(async {
            Thread.sleep(100)
            return "hey"
        })

        let response = await future.get()
        let end = Time.currentTimeMillis

        expect(end - start >= 90).toBe(true)
        expect(response).toBe("hey")
    }

    async test `Future.fromResolve: can delay the execution of the future`() {
        let start = Time.currentTimeMillis

        let future = Future.fromResolve(async {
            Thread.sleep(100)
            _resolve("hey")
        })

        let end = Time.currentTimeMillis
        let response = await future.get()

        expect(end - start < 90).toBe(true)
        expect(response).toBe("hey")
    }

    async test `Future.fromResolve: can wait for the execution of the future`() {
        let start = Time.currentTimeMillis

        let future = Future.fromResolve(async {
            Thread.sleep(100)
            _resolve("hey")
        })

        let response = await future.get()
        let end = Time.currentTimeMillis

        expect(end - start >= 90).toBe(true)
        expect(response).toBe("hey")
    }

    async test `Future.cancel: does not throw CancellationException when get is not called`() {
        let future = Future.fromResolve(async {
            Thread.sleep(100)
            _resolve("hey")
        })

        expect({ future.cancel() }).toNotThrow(CancellationException.class)
    }

    async test `Future.cancel: does throw CancellationException when get is called after a future is cancelled`() {
        let future = Future.fromResolve(async {
            Thread.sleep(100)
            _resolve("hey")
        })

        future.cancel()

        expectAsync(async { future.get() }).toThrow(CancellationException.class)
    }

    async test `Future.cancel: does not throw CancellationException when get is not called when future is already completed`() {
        let future = Future.create()
        future.complete("hey")

        expect({ future.cancel() }).toNotThrow(CancellationException.class)
    }

    async test `can automatically unwrap the response`() {
        expect(futureThing()).toBe("hey")
        expect(futureThing().count).toBe(3)
    }

    test `cancel notifies registered listeners exactly once`() {
        let future = Future.create<String>()
        var count = 0

        future.onCancel({ count++ })
        future.cancel()
        future.cancel()

        expect(count).toBe(1)
    }

    test `listener registered after cancellation is notified immediately`() {
        let future = Future.create<String>()
        var count = 0

        future.cancel()
        future.onCancel({ count++ })

        expect(count).toBe(1)
    }

    async test `Future.from: preserves Int arithmetic through generic results without replay`() {
        var calls = 0
        let future = Future.from<Int>(async {
            calls++
            return 6 * 7
        })

        Int first = await future.get()
        Int second = await future.get()

        expect(first + 1).toBe(43)
        expect(second + 1).toBe(43)
        expect(calls).toBe(1)
        expect(future.completed).toBe(true)

        let zero = Future.from<Int>(async { return 0 })
        let negative = Future.from<Int>(async { return -42 })
        Int zeroResult = await zero.get()
        Int negativeResult = await negative.get()

        expect(zeroResult + 1).toBe(1)
        expect(negativeResult + 1).toBe(-41)
    }

    async test `Future.from: inferred numeric callback results remain usable as Int`() {
        Int input = 7
        let future = Future.from(async { return input * 6 })
        Int response = await future.get()

        expect(response + 1).toBe(43)
    }

    async test `Future.from: preserves both Bool values through generic results`() {
        let yes = Future.from<Bool>(async { return true })
        let no = Future.from<Bool>(async { return false })

        Bool yesResult = await yes.get()
        Bool noResult = await no.get()

        expect(yesResult).toBe(true)
        expect(noResult).toBe(false)
        expect(!yesResult).toBe(false)
        expect(!noResult).toBe(true)
    }

    async test `Future.from: preserves String contents and identity`() {
        let original = "future payload"
        let future = Future.from<String>(async { return original })
        String response = await future.get()

        expect(response).toBe("future payload")
        expect(response.count).toBe(14)
        expect(Object.referenceEquals(response, original)).toBe(true)
    }

    async test `Future.from: preserves reference identity across repeated reads`() {
        let original = Object()
        let future = Future.from<Object>(async { return original })
        Object first = await future.get()
        Object second = await future.get()

        expect(Object.referenceEquals(first, original)).toBe(true)
        expect(Object.referenceEquals(second, original)).toBe(true)
    }

    async test `Future.from: does not rebox an already boxed payload`() {
        Object original = 42
        let future = Future.from<Object>(async { return original })
        Object response = await future.get()

        expect(Object.referenceEquals(response, original)).toBe(true)
    }

    async test `Future.from: preserves null as a generic payload`() {
        let future = Future.from<Object>(async { return null })
        Object response = await future.get()

        expect(Object.referenceEquals(response, null)).toBe(true)
        expect(future.completed).toBe(true)
        expect(future.cancelled).toBe(false)
        expect(future.exception).toBe(null)
    }

    async test `Future.from: cancellation remains terminal after the callback returns`() {
        let started = Future.create<Bool>()
        let release = Future.create<Bool>()
        let finished = Future.create<Bool>()
        var cancellations = 0
        let future = Future.from<Int>(async {
            started.complete(true)
            release.get()
            finished.complete(true)
            return 42
        })
        future.onCancel({ cancellations++ })
        started.get()

        future.cancel()
        future.cancel()

        expectAsync(async { future.get() }).toThrow(CancellationException.class)
        expect(cancellations).toBe(1)
        expect(future.completed).toBe(true)
        expect(future.cancelled).toBe(true)

        release.complete(true)
        finished.get()

        expectAsync(async { future.get() }).toThrow(CancellationException.class)
        expect(cancellations).toBe(1)
        expect(future.exception).toBe(null)
    }

    async test `Future.from: propagates exceptions`() {
        let error = Exception("broken")
        let future = Future.from<String>(async {
            throw error
        })
        let independent = Future.from<String>(async { return "unaffected" })

        expectAsync(async { future.get() }).toThrowWithMessage(Exception.class, "broken")
        expect(future.completed).toBe(true)
        expect(future.exception.message).toBe("broken")
        expect(Object.referenceEquals(future.exception, error)).toBe(true)
        expect(independent.get()).toBe("unaffected")
        expect(independent.exception).toBe(null)
    }

    futureThing() -> Future<String> {
        return Future.from({
            return "hey"
        })
    }
}
