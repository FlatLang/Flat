package flat/future

class<TType> {
    native var Object promiseValue
    native var Object resolveFunc
    native var Object rejectFunc

    construct() {
        external {
            #{promiseValue} = new Promise((resolve, reject) => {
                #{resolveFunc} = resolve;
                #{rejectFunc} = reject;
            }).catch((e) => {
                #{exception} = e;
                #{exceptionOccurred()};
            });
        }
    }

    exceptionOccurred() {
        exceptionListeners.forEach({
          _(exception)
        })
    }

    public async get() -> TType {
        if (exception) {
            throw exception
        }
        external {
            try {
                let data = await #{promiseValue};
                #{completed = true};

                if (#{cancelled}) {
                    #{throw CancellationException()};
                }

                return data;
            } catch (err) {
                #{completed = true};

                if (#{cancelled}) {
                    #{throw CancellationException()};
                }

                return err;
            }
        }
    }

    public cancel() {
        if (cancelled) return

        completed = true
        cancelled = true
        cancelOccurred()

        external {
            #{resolveFunc}();
        }
    }

    public static from<TType>(async func() -> TType) -> Future<TType> {
        let future = Future()

        external {
            (async () => {
                try {
                    #{future.resolveFunc}(await func());
                } catch (e) {
                    #{future.rejectFunc}(e);
                }
            })();
        }

        return future
    }

    public static fromResolve<TType>(async func(resolve(TType value), reject(Exception exception))) -> Future<TType> {
        let future = Future()

        let res(TType value) = future.resolveFunc
        let rej(Exception exception) = future.rejectFunc

        func(res, rej)$

        return future
    }

    public static class CompletableFuture<TType> extends Future<TType> {
        public complete(TType value) => value {
            completed = true

            external {
                #{resolveFunc}(#{value});
            }
        }

        public error(Exception value) => value {
            completed = true
            exception = value

            external {
                #{rejectFunc}(#{value});
            }
        }
    }
}
