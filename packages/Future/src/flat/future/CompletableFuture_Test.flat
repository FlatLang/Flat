package flat/future

import flat/thread
import flat/time

testable class {
    async test `can delay the execution of the future`() {
        let start = Time.currentTimeMillis

        let future = Future.create<String>()

        doStuff({
            Thread.sleep(100)
            future.complete("hey")
        })$

        let end = Time.currentTimeMillis
        let response = await future.get()

        expect(end - start < 90).toBe(true)
        expect(response).toBe("hey")
    }

    async test `can wait for the execution of the future`() {
        let start = Time.currentTimeMillis

        let future = Future.create<String>()

        doStuff({
            Thread.sleep(100)
            future.complete("hey")
        })$

        let response = await future.get()
        let end = Time.currentTimeMillis

        expect(end - start >= 90).toBe(true)
        expect(response).toBe("hey")
    }

    async test `completing marks the future completed immediately`() {
        let future = Future.create<String>()

        future.complete("hey")

        expect(future.completed).toBe(true)
        expect(future.get()).toBe("hey")
    }

    async test `erroring marks the future completed immediately`() {
        let future = Future.create<String>()
        let error = Exception("broken")

        future.error(error)

        expect(future.completed).toBe(true)
        expect(future.exception).toBe(error)
        expectAsync(async { future.get() }).toThrowWithMessage(Exception.class, "broken")
    }

    async doStuff(async func()) {
        func()
    }
}
