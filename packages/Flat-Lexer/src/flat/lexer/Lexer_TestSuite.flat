package flat/lexer

import flat/test/TestResult

import flat/time/Timer
import flat/io/FancyOutputStream
import flat/lexer/Lexer

[TestSuite [
    Tokenizer_Test,
    Lexer_Test,
    BoundedLexerPipelineChecks_Test,
    IncrementalStringSplit_Test,
    IncrementalCommentSplit_Test,
    IncrementalExternalSplit_Test,
    IncrementalSymbolSplit_Test,
    IncrementalMultibyteSplit_Test,
    IncrementalEof_Test,
    IncrementalRetainedBound_Test,
    IncrementalEdgeSplit_Test,
    IncrementalLocation_Test,
    IncrementalBackpressure_Test,
    IncrementalCancellation_Test
]]
class {
    public static async main(String[] args) {
        let test = Lexer_TestSuite()
        test.keepTestRuntimeAlive()

        Timer timer = Timer().start()

        let results = TestResult[]

        test.runTests({
            results.add(_)
        })

        let fancy = FancyOutputStream(headerPattern: "/\\")

        let unsuccessful = results.filter({ !_.success })

        if (unsuccessful.count > 0) {
            fancy.writeHeader(
                "#unsuccessful.count Failure#{unsuccessful.count == 1 ? "" : "s"} out of #results.count test#{results.count == 1 ? "" : "s"}",
                pattern: ":'( ",
                symmetrical: true
            )

            unsuccessful.forEach({
                Console.log("#_")
            })
        } else {
            fancy.writeHeader(
                "All #results.count Successful",
                pattern: ":) ",
                symmetrical: true
            )
        }

        timer.stop()

        Console.writeLine("Took #{timer.duration}ms")

        test.releaseTestRuntime()

        if (unsuccessful.count > 0) {
                System.exit(1)
        }
    }

    keepTestRuntimeAlive() {
        throw Exception("Not implemented for target language or runtime")
    }

    releaseTestRuntime() {
        throw Exception("Not implemented for target language or runtime")
    }
}
