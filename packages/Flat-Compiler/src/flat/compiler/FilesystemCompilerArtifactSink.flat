package flat/compiler

import flat/io
import flat/writer/es6/bound
import flat/writer/es6/bound/Es6ArtifactCommitter.ArtifactCommitReceipt

/**
 * Atomic artifact publication with lexical root-relative identities, not a
 * symlink sandbox. Root and its tree remain caller-trusted.
 * Pending cleanup is per artifact and count-bounded. A failure for A never
 * causes cleanup of A before B can publish while reservation capacity remains.
 * Exhaustion is explicit admission backpressure before rename, not an ordering
 * barrier. Owners finalize retryCleanup; committed outputs are never removed.
 */
class extends CompilerArtifactSink {
    class PendingArtifactCleanup {
        visible String identity
        visible ArtifactCommitReceipt receipt
        public construct(String identity, ArtifactCommitReceipt receipt) {
            this.identity = identity
            this.receipt = receipt
        }
    }
    var CompilerArtifact[] values = CompilerArtifact[]
    var PendingArtifactCleanup[] pendingCleanup = PendingArtifactCleanup[]
    visible Int pendingCleanupCount => pendingCleanup.count

    public construct(visible File root, visible Int cleanupCapacity = 64) {
        if (!root || cleanupCapacity <= 0) throw Exception("Filesystem artifact sink requires root and positive cleanup capacity")
        Es6ArtifactFiles.ensureDirectory(root)
    }
    override public write(CompilerArtifact artifact) {
        if (!artifact || values.any({ _.identity == artifact.identity })) {
            throw Exception("Filesystem artifact sink requires unique artifact")
        }
        validateIdentity(artifact.identity)
        // Single-owner synchronous publication reserves a potential receipt slot
        // before any rename; no unrelated receipt is retried on this path.
        if (pendingCleanup.count >= cleanupCapacity) throw Exception("Filesystem artifact cleanup capacity exceeded")
        let identity = artifact.identity.concat("")
        let receipt = Es6ArtifactCommitter().publish(File(root, identity), artifact.code)
        if (receipt.cleanupPending) pendingCleanup.add(PendingArtifactCleanup(identity, receipt))
        values.add(artifact)
        values = values.sort({ _a.identity.compareTo(_b.identity) })
    }

    public cleanupError(String identity) -> Exception => null {
        for (pending in pendingCleanup) {
            if (pending.identity == identity) return pending.receipt.cleanupError
        }
    }

    /** Artifact-local retry; failed entries remain owned, successful ones retire. */
    public retryCleanup(String identity) {
        for (pending in pendingCleanup.copy()) {
            if (pending.identity == identity) {
                pending.receipt.retryCleanup()
                pendingCleanup.remove(pending)
            }
        }
    }

    /** Finalization attempts every bounded entry, then reports the first failure. */
    public retryCleanup() {
        var Exception failure
        for (pending in pendingCleanup.copy()) {
            try {
                pending.receipt.retryCleanup()
                pendingCleanup.remove(pending)
            } catch (Exception error) {
                if (!failure) failure = error
            }
        }
        if (failure) throw failure
    }

    /** Shared filesystem/spool identity policy; valid directories are preserved. */
    public static validateIdentity(String identity) {
        if (!identity || identity.count == 0 || identity.startsWith("/") ||
            identity.endsWith("/") || identity.contains("\\") || identity.contains(":") ||
            identity.contains("\0") || identity.contains("//")) {
            throw Exception("Artifact requires normalized root-relative identity")
        }
        let components = identity.split("/")
        for (component in components) {
            if (component.count == 0 || component == "." || component == "..") {
                throw Exception("Artifact requires normalized root-relative identity components")
            }
        }
    }
    override public artifacts() -> CompilerArtifact[] => CompilerArtifact[]:addAll(values)
}
