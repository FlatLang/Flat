package flat/compiler

import flat/io
import flat/time/Time
import flat/writer/es6/bound

/** Lexical artifact identities; roots and directory trees are caller-trusted. */
testable class {
    test `rename failure preserves previous destination and cleanup permits exact retry`() {
        let root = File(".flat-artifact-rename-retry-#{Time.currentTimeMillis}")
        let output = File(root, "a.js")
        let observer = LifecycleRecorder(output.normalizedLocation)
        let files = FilesystemCompilerArtifactSink(root, 1, "revision-1", observer)
        native var Object originalRename
        try {
            Es6ArtifactFiles.write(output, "previous")
            external {
                #{originalRename} = #{File.FileGlobal.fs}.renameSync;
                #{File.FileGlobal.fs}.renameSync = () => { throw new Error('controlled rename failure'); };
            }
            try {
                var String failure = ""
                try { files.write(CompilerArtifact("a.js", "replacement")) }
                catch (Exception error) { failure = error.message }
                expect(failure).toBe("controlled rename failure")
                expect(files.artifacts().count).toBe(0)
                expect(files.pendingCleanupCount).toBe(0)
                expect(observer.publications).toBe(0)
                expect(observer.created).toBe(2)
                expect(observer.removed).toBe(2)
                expect(observer.invalidObservation).toBe(false)
                expect(Es6ArtifactFiles.read(output)).toBe("previous")
                expect(root.getChildFiles(includeDirectories: true).count).toBe(1)
            } finally { external { #{File.FileGlobal.fs}.renameSync = #{originalRename}; } }
            files.write(CompilerArtifact("a.js", "replacement"))
            expect(files.artifacts().count).toBe(1)
            expect(files.pendingCleanupCount).toBe(0)
            expect(observer.publications).toBe(1)
            expect(observer.created).toBe(4)
            expect(observer.removed).toBe(4)
            expect(observer.invalidObservation).toBe(false)
            expect(Es6ArtifactFiles.read(output)).toBe("replacement")
            expect(root.getChildFiles(includeDirectories: true).count).toBe(1)
        } finally { files.retryCleanup(); Es6ArtifactFiles.remove(root) }
    }

    test `memory sink owns bounded detached snapshots and rejects admission atomically`() {
        let memory = MemoryCompilerArtifactSink(2, 40)
        let identity = "b.js".concat("")
        let code = "B".concat("")
        memory.write(CompilerArtifact(identity, code))
        identity.chars[0] = 'z'
        code.chars[0] = 'Z'
        expect(memory.artifacts().first.identity).toBe("b.js")
        expect(memory.artifacts().first.code).toBe("B")
        let snapshot = memory.artifacts().first
        snapshot.identity.chars[0] = 'x'
        snapshot.code.chars[0] = 'X'
        expect(memory.artifacts().first.identity).toBe("b.js")
        expect(memory.artifacts().first.code).toBe("B")
        var Int rejected
        try { memory.write(CompilerArtifact("a.js", "AA")) } catch (Exception error) { rejected++ }
        expect(memory.artifacts().count).toBe(1)
        memory.write(CompilerArtifact("a.js", "A"))
        try { memory.write(CompilerArtifact("c.js", "C")) } catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
        expect(memory.artifacts().count).toBe(2)
        expect(memory.artifacts().first.identity).toBe("a.js")
        expect(memory.artifacts().last.identity).toBe("b.js")
        rejected = 0
        try { MemoryCompilerArtifactSink(0) } catch (Exception error) { rejected++ }
        try { MemoryCompilerArtifactSink(1, 0) } catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
    }

    class ReentrantLifecycleObserver extends CompilerArtifactLifecycleObserver {
        visible var FilesystemCompilerArtifactSink files
        visible var Int rejected
        visible var Int publications

        override public temporaryCreated(CompilerArtifactLifecycleBinding binding, String path) {
            try { files.write(CompilerArtifact("intruder.js", "intruder")) }
            catch (Exception error) { rejected++ }
            try { files.retryCleanup() } catch (Exception error) { rejected++ }
        }
        override public published(CompilerArtifactLifecycleBinding binding) { publications++ }
    }

    test `filesystem observer reentry cannot steal reservation or publish another artifact`() {
        let root = File(".flat-artifact-reentry-#{Time.currentTimeMillis}")
        let observer = ReentrantLifecycleObserver()
        let files = FilesystemCompilerArtifactSink(root, 1, "revision-1", observer)
        observer.files = files
        try {
            files.write(CompilerArtifact("a.js", "A"))
            expect(observer.rejected).toBe(4)
            expect(observer.publications).toBe(1)
            expect(files.artifacts().count).toBe(1)
            expect(files.pendingCleanupCount).toBe(0)
            expect(File(root, "intruder.js").exists).toBe(false)
            expect(Es6ArtifactFiles.read(File(root, "a.js"))).toBe("A")
        } finally { files.retryCleanup(); Es6ArtifactFiles.remove(root) }
    }

    class SpoolReentrantLifecycleObserver extends CompilerArtifactLifecycleObserver {
        visible var SpooledCompilerArtifactSink spool
        visible var Int rejected
        override public temporaryCreated(CompilerArtifactLifecycleBinding binding, String path) {
            try { spool.dispose() } catch (Exception error) { rejected++ }
            try { spool.write(CompilerArtifact("intruder.js", "intruder")) }
            catch (Exception error) { rejected++ }
        }
    }

    test `spool observer cannot dispose storage during admission`() {
        let root = File(".flat-spool-reentry-#{Time.currentTimeMillis}")
        let output = File(root, "output")
        let observer = SpoolReentrantLifecycleObserver()
        let spool = SpooledCompilerArtifactSink(File(root, "spool"), 1, 1024,
            "revision-1", output, observer)
        let files = FilesystemCompilerArtifactSink(output)
        observer.spool = spool
        try {
            spool.write(CompilerArtifact("a.js", "A"))
            expect(observer.rejected).toBe(4)
            expect(spool.stagedFile().exists).toBe(true)
            spool.commitTo(files)
            expect(Es6ArtifactFiles.read(File(output, "a.js"))).toBe("A")
            expect(spool.artifacts().count).toBe(0)
            expect(File(root, "spool").getChildFiles(includeDirectories: true).count).toBe(0)
        } finally { spool.dispose(); files.retryCleanup(); Es6ArtifactFiles.remove(root) }
    }

    test `filesystem metadata snapshot cannot be changed by caller strings`() {
        let root = File(".flat-files-snapshot-#{Time.currentTimeMillis}")
        let files = FilesystemCompilerArtifactSink(root)
        let identity = "a.js".concat("")
        let code = "A".concat("")
        try {
            files.write(CompilerArtifact(identity, code))
            identity.chars[0] = 'z'
            code.chars[0] = 'Z'
            let snapshot = files.artifacts().first
            snapshot.identity.chars[0] = 'x'
            snapshot.code.chars[0] = 'X'
            expect(files.artifacts().first.identity).toBe("a.js")
            expect(files.artifacts().first.code).toBe("A")
            expect(Es6ArtifactFiles.read(File(root, "a.js"))).toBe("A")
            var Bool rejected
            try { files.write(CompilerArtifact("a.js", "replacement")) }
            catch (Exception error) { rejected = true }
            expect(rejected).toBe(true)
            expect(Es6ArtifactFiles.read(File(root, "a.js"))).toBe("A")
        } finally { files.retryCleanup(); Es6ArtifactFiles.remove(root) }
    }

    test `cleanup inspection failure retains receipt and cannot authorize republishing`() {
        let root = File(".flat-artifact-inspection-#{Time.currentTimeMillis}")
        let observer = LifecycleRecorder(File(root, "a.js").normalizedLocation)
        let files = FilesystemCompilerArtifactSink(root, 1, "revision-1", observer)
        native var Object originalStat
        try {
            external {
                #{originalStat} = #{File.FileGlobal.fs}.lstatSync;
                #{File.FileGlobal.fs}.lstatSync = () => {
                    const error = new Error('controlled inaccessible artifact storage');
                    error.code = 'EACCES';
                    throw error;
                };
            }
            try {
                files.write(CompilerArtifact("a.js", "A"))
                expect(files.pendingCleanupCount).toBe(1)
                expect(files.cleanupError("a.js").message).toBe("controlled inaccessible artifact storage")
                expect(observer.publications).toBe(1)
                expect(observer.failedFinalizers).toBe(1)
                var Bool rejected
                try { files.write(CompilerArtifact("a.js", "replacement")) }
                catch (Exception error) { rejected = true }
                expect(rejected).toBe(true)
                expect(Es6ArtifactFiles.read(File(root, "a.js"))).toBe("A")
            } finally { external { #{File.FileGlobal.fs}.lstatSync = #{originalStat}; } }
            files.retryCleanup()
            expect(files.pendingCleanupCount).toBe(0)
            expect(observer.publications).toBe(1)
            expect(Es6ArtifactFiles.read(File(root, "a.js"))).toBe("A")
        } finally { files.retryCleanup(); Es6ArtifactFiles.remove(root) }
    }

    test `dangling temporary link is present storage until checked removal`() {
        let root = File(".flat-artifact-dangling-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let link = File(root, "dangling")
        let receipt = CompilerArtifactLifecycleStorage(link, null, null)
        native var Object originalRemove
        try {
            external {
                #{File.FileGlobal.fs}.symlinkSync('missing-target', #{link.normalizedLocation.chars.data});
                #{originalRemove} = #{File.FileGlobal.fs}.rmSync;
                #{File.FileGlobal.fs}.rmSync = () => {};
            }
            try {
                expect(CompilerArtifactLifecycleStorage.pathPresent(link)).toBe(true)
                var Bool rejected
                try { receipt.remove() } catch (Exception error) { rejected = true }
                expect(rejected).toBe(true)
                expect(receipt.failure != null).toBe(true)
            } finally { external { #{File.FileGlobal.fs}.rmSync = #{originalRemove}; } }
            receipt.remove()
            expect(CompilerArtifactLifecycleStorage.pathPresent(link)).toBe(false)
            expect(receipt.failure == null).toBe(true)
        } finally { Es6ArtifactFiles.remove(root) }
    }

    test `filesystem and spool reject unsafe paths before admission or publication`() {
        let root = File(".flat-artifact-path-test-#{Time.currentTimeMillis}")
        let output = File(root, "output")
        let storage = File(root, "spool")
        let files = FilesystemCompilerArtifactSink(output)
        let spool = SpooledCompilerArtifactSink(storage, 1)
        let sentinel = File(root, "outside.js")
        let spoolSentinel = File(root, "outside.js.spool")
        try {
            Es6ArtifactFiles.write(sentinel, "preserve")
            Es6ArtifactFiles.write(spoolSentinel, "preserve-spool")
            let absolute = sentinel.getParent().normalizedLocation + "/" + sentinel.name
            String[] invalid = ["../outside.js", "nested/../../outside.js", absolute,
                "/outside.js", "C:/outside.js", "C:outside.js", "\\outside.js",
                "nested\\outside.js", "", "nested//outside.js", "nested/",
                "./outside.js", "nested/./outside.js", "nested/../outside.js"]
            for (identity in invalid) {
                var Bool fileRejected = false
                var Bool spoolRejected = false
                try { files.write(CompilerArtifact(identity, "replace")) }
                catch (Exception error) { fileRejected = true }
                try { spool.write(CompilerArtifact(identity, "replace")) }
                catch (Exception error) { spoolRejected = true }
                expect(fileRejected).toBe(true)
                expect(spoolRejected).toBe(true)
                expect(files.artifacts().count).toBe(0)
                expect(spool.artifacts().count).toBe(0)
                expect(output.getChildFiles(includeDirectories: true).count).toBe(0)
                expect(storage.getChildFiles(includeDirectories: true).count).toBe(0)
                expect(Es6ArtifactFiles.read(sentinel)).toBe("preserve")
                expect(Es6ArtifactFiles.read(spoolSentinel)).toBe("preserve-spool")
            }
            // Invalid writes must not consume the spool's single admission slot.
            spool.write(CompilerArtifact("safe.js", "safe"))
            spool.commitTo(files)
            expect(Es6ArtifactFiles.read(File(output, "safe.js"))).toBe("safe")
        } finally {
            spool.dispose()
            Es6ArtifactFiles.remove(root)
        }
    }

    test `failed spool write is not admitted or published and retry retains capacity`() {
        let root = File(".flat-artifact-write-failure-test-#{Time.currentTimeMillis}")
        let output = File(root, "output")
        let storage = File(root, "spool")
        let files = FilesystemCompilerArtifactSink(output)
        let spool = SpooledCompilerArtifactSink(storage, 1)
        try {
            Es6ArtifactFiles.ensureDirectory(File(output, "sources"))
            let destination = File(output, "sources/Main.js")
            Es6ArtifactFiles.write(destination, "previous")
            var Bool rejected = false
            native var Object originalWrite
            external {
                #{originalWrite} = #{File.FileGlobal.fs}.writeFileSync;
                #{File.FileGlobal.fs}.writeFileSync = () => { throw new Error('controlled stage write'); };
            }
            try {
                try { spool.write(CompilerArtifact("sources/Main.js", "replacement")) }
                catch (Exception error) { rejected = true }
            } finally {
                external { #{File.FileGlobal.fs}.writeFileSync = #{originalWrite}; }
            }
            expect(rejected).toBe(true)
            expect(spool.artifacts().count).toBe(0)
            spool.commitTo(files)
            expect(files.artifacts().count).toBe(0)
            expect(Es6ArtifactFiles.read(destination)).toBe("previous")
            expect(storage.getChildFiles(includeDirectories: true).count).toBe(0)

            Es6ArtifactFiles.ensureDirectory(File(storage, "sources"))
            spool.write(CompilerArtifact("sources/Main.js", "replacement"))
            expect(spool.artifacts().count).toBe(1)
            spool.commitTo(files)
            expect(Es6ArtifactFiles.read(destination)).toBe("replacement")
            expect(spool.artifacts().count).toBe(0)
            expect(File(storage, "sources/Main.js.spool").exists).toBe(false)
        } finally {
            spool.dispose()
            Es6ArtifactFiles.remove(root)
        }
    }

    class FailingPromotionSink extends FilesystemCompilerArtifactSink {
        visible var Bool rejectSecond = true
        visible var Int writes

        public construct(File root) => super(root)

        override public write(CompilerArtifact artifact) {
            if (rejectSecond && artifact.identity == "b.js") {
                throw Exception("controlled second promotion failure")
            }
            super.write(artifact)
            writes++
        }
    }

    test `filesystem cleanup failure does not block unrelated artifact publication`() {
        let root = File(".flat-filesystem-receipt-test-#{Time.currentTimeMillis}")
        let files = FilesystemCompilerArtifactSink(File(root, "output"))
        let destination = File(root, "output/a.js")
        let prefix = destination.normalizedLocation + ".flat-tmp-"
        native var Object originalRemove
        try {
            external {
                #{originalRemove} = #{File.FileGlobal.fs}.rmSync;
                const remove = #{originalRemove};
                #{File.FileGlobal.fs}.rmSync = (path, options) => {
                    if (path.startsWith(#{prefix.chars.data})) throw new Error('destination cleanup');
                    return remove(path, options);
                };
            }
            try {
                files.write(CompilerArtifact("a.js", "A"))
                expect(files.artifacts().count).toBe(1)
                expect(files.pendingCleanupCount).toBe(1)
                expect(Es6ArtifactFiles.read(destination)).toBe("A")
                files.write(CompilerArtifact("b.js", "B"))
                expect(files.artifacts().count).toBe(2)
                expect(files.pendingCleanupCount).toBe(1)
                expect(Es6ArtifactFiles.read(File(root, "output/b.js"))).toBe("B")
            } finally {
                external { #{File.FileGlobal.fs}.rmSync = #{originalRemove}; }
            }
            files.retryCleanup()
            files.retryCleanup()
            expect(files.pendingCleanupCount).toBe(0)
            expect(files.artifacts().count).toBe(2)
        } finally {
            files.retryCleanup()
            Es6ArtifactFiles.remove(root)
        }
    }

    test `filesystem rejects invalid cleanup capacities before creating root`() {
        let root = File(".flat-cleanup-capacity-test-#{Time.currentTimeMillis}")
        try {
            var Int rejected
            try { FilesystemCompilerArtifactSink(root, -1) } catch (Exception error) { rejected++ }
            try { FilesystemCompilerArtifactSink(root, 0) } catch (Exception error) { rejected++ }
            expect(rejected).toBe(2)
            expect(root.exists).toBe(false)
        } finally { Es6ArtifactFiles.remove(root) }
    }

    test `cleanup capacity reserves before publication and retry isolates every entry`() {
        let root = File(".flat-cleanup-reservation-test-#{Time.currentTimeMillis}")
        let files = FilesystemCompilerArtifactSink(File(root, "output"), 2)
        let prefix = File(root, "output").normalizedLocation + "/"
        native var Object originalRemove
        var Bool failAll = true
        var Int cleanupAttempts
        try {
            external {
                #{originalRemove} = #{File.FileGlobal.fs}.rmSync;
                const remove = #{originalRemove};
                #{File.FileGlobal.fs}.rmSync = (path, options) => {
                    if (path.startsWith(#{prefix.chars.data}) && path.includes('.flat-tmp-')) {
                        #{cleanupAttempts}++;
                        if (#{failAll} || path.includes('/a.js.flat-tmp-')) throw new Error('controlled cleanup');
                    }
                    return remove(path, options);
                };
            }
            try {
                files.write(CompilerArtifact("a.js", "A"))
                files.write(CompilerArtifact("b.js", "B"))
                expect(files.artifacts().count).toBe(2)
                expect(files.pendingCleanupCount).toBe(2)
                var Bool rejected = false
                try { files.write(CompilerArtifact("c.js", "C")) }
                catch (Exception error) { rejected = true }
                expect(rejected).toBe(true)
                expect(File(root, "output/c.js").exists).toBe(false)
                expect(files.artifacts().count).toBe(2)
                failAll = false
                cleanupAttempts = 0
                rejected = false
                try { files.retryCleanup() } catch (Exception error) { rejected = true }
                expect(rejected).toBe(true)
                expect(cleanupAttempts).toBe(2)
                expect(files.pendingCleanupCount).toBe(1)
                expect(files.cleanupError("a.js").message).toBe("controlled cleanup")
                expect(files.cleanupError("b.js")).toBe(null)
                files.write(CompilerArtifact("c.js", "C"))
                expect(files.artifacts().count).toBe(3)
                expect(Es6ArtifactFiles.read(File(root, "output/c.js"))).toBe("C")
            } finally {
                external { #{File.FileGlobal.fs}.rmSync = #{originalRemove}; }
            }
        } finally {
            files.retryCleanup()
            Es6ArtifactFiles.remove(root)
        }
    }

    test `destination cleanup failure permits unrelated spool promotion and retry never republishes`() {
        let root = File(".flat-artifact-destination-cleanup-test-#{Time.currentTimeMillis}")
        let files = FailingPromotionSink(File(root, "output"))
        files.rejectSecond = false
        let spool = SpooledCompilerArtifactSink(File(root, "spool"), 2)
        native var Object originalRemove
        native var Object originalRename
        var Int renames
        try {
            spool.write(CompilerArtifact("a.js", "A"))
            spool.write(CompilerArtifact("b.js", "B"))
            let destination = File(root, "output/a.js")
            let prefix = destination.normalizedLocation + ".flat-tmp-"
            external {
                #{originalRemove} = #{File.FileGlobal.fs}.rmSync;
                #{originalRename} = #{File.FileGlobal.fs}.renameSync;
                const remove = #{originalRemove};
                const rename = #{originalRename};
                #{File.FileGlobal.fs}.rmSync = (path, options) => {
                    if (path.startsWith(#{prefix.chars.data})) throw new Error('destination cleanup');
                    return remove(path, options);
                };
                #{File.FileGlobal.fs}.renameSync = (from, to) => {
                    #{renames}++;
                    return rename(from, to);
                };
            }
            try {
                var Bool rejected = false
                try { spool.commitTo(files) } catch (Exception error) { rejected = true }
                expect(rejected).toBe(true)
                expect(Es6ArtifactFiles.read(destination)).toBe("A")
                expect(Es6ArtifactFiles.read(File(root, "output/b.js"))).toBe("B")
                expect(files.artifacts().count).toBe(2)
                expect(files.pendingCleanupCount).toBe(1)
                expect(files.cleanupError("a.js").message).toBe("destination cleanup")
                expect(spool.artifacts().count).toBe(0)
                expect(files.writes).toBe(2)
                expect(renames).toBe(2)
                // Cleanup-only retry must not enter destination.write or rename.
                try { spool.commitTo(files) } catch (Exception error) {}
                expect(files.writes).toBe(2)
                expect(renames).toBe(2)
            } finally {
                external {
                    #{File.FileGlobal.fs}.rmSync = #{originalRemove};
                    #{File.FileGlobal.fs}.renameSync = #{originalRename};
                }
            }
            spool.commitTo(files)
            expect(files.pendingCleanupCount).toBe(0)
            expect(files.cleanupError("a.js")).toBe(null)
            expect(files.writes).toBe(2)
            expect(renames).toBe(2)
            expect(spool.artifacts().count).toBe(0)
        } finally {
            files.retryCleanup()
            spool.dispose()
            Es6ArtifactFiles.remove(root)
        }
    }

    test `partial spool promotion retries only unpublished artifacts`() {
        let root = File(".flat-artifact-partial-test-#{Time.currentTimeMillis}")
        let files = FailingPromotionSink(File(root, "output"))
        let spool = SpooledCompilerArtifactSink(File(root, "spool"), 2)
        try {
            spool.write(CompilerArtifact("b.js", "B"))
            spool.write(CompilerArtifact("a.js", "A"))
            var Bool rejected = false
            try { spool.commitTo(files) } catch (Exception error) { rejected = true }
            expect(rejected).toBe(true)
            expect(files.writes).toBe(1)
            expect(spool.artifacts().count).toBe(1)
            expect(spool.artifacts().first.identity).toBe("b.js")
            files.rejectSecond = false
            spool.commitTo(files)
            expect(files.writes).toBe(2)
            expect(spool.artifacts().count).toBe(0)
            expect(Es6ArtifactFiles.read(File(root, "output/a.js"))).toBe("A")
            expect(Es6ArtifactFiles.read(File(root, "output/b.js"))).toBe("B")
        } finally {
            spool.dispose()
            Es6ArtifactFiles.remove(root)
        }
    }

    test `spool instances own private staging and disposal preserves unrelated files`() {
        let root = File(".flat-artifact-private-test-#{Time.currentTimeMillis}")
        let storage = File(root, "spool")
        let first = SpooledCompilerArtifactSink(storage, 1)
        let second = SpooledCompilerArtifactSink(storage, 1)
        let files = FilesystemCompilerArtifactSink(File(root, "output"))
        let sentinel = File(storage, "a.js.spool")
        try {
            Es6ArtifactFiles.write(sentinel, "unrelated")
            first.write(CompilerArtifact("a.js", "first"))
            second.write(CompilerArtifact("a.js", "second"))
            expect(storage.getChildFiles(includeDirectories: true).count).toBe(3)
            first.dispose()
            first.dispose()
            expect(Es6ArtifactFiles.read(sentinel)).toBe("unrelated")
            second.commitTo(files)
            expect(Es6ArtifactFiles.read(File(root, "output/a.js"))).toBe("second")
            second.dispose()
            expect(storage.getChildFiles(includeDirectories: true).count).toBe(1)
            var Int rejected
            try { first.write(CompilerArtifact("b.js", "B")) } catch (Exception error) { rejected++ }
            try { first.commitTo(files) } catch (Exception error) { rejected++ }
            expect(rejected).toBe(2)
        } finally {
            first.dispose()
            second.dispose()
            Es6ArtifactFiles.remove(root)
        }
    }

    test `spool admission detaches caller and returned identity and payload storage`() {
        let root = File(".flat-artifact-snapshot-test-#{Time.currentTimeMillis}")
        let spool = SpooledCompilerArtifactSink(File(root, "spool"), 1)
        let files = FilesystemCompilerArtifactSink(File(root, "output"))
        try {
            let identity = "a.js".concat("")
            let code = "A".concat("")
            spool.write(CompilerArtifact(identity, code))
            identity.chars[0] = 'z'
            code.chars[0] = 'Z'
            let observed = spool.artifacts().first
            observed.identity.chars[0] = 'q'
            observed.code.chars[0] = 'Q'
            expect(spool.artifacts().first.identity).toBe("a.js")
            expect(spool.artifacts().first.code).toBe("A")
            spool.commitTo(files)
            expect(Es6ArtifactFiles.read(File(root, "output/a.js"))).toBe("A")
        } finally {
            spool.dispose()
            Es6ArtifactFiles.remove(root)
        }
    }

    test `spool byte capacity includes identity payload and releases after cleanup`() {
        let root = File(".flat-artifact-byte-test-#{Time.currentTimeMillis}")
        let storage = File(root, "spool")
        let spool = SpooledCompilerArtifactSink(storage, 2, maxBytes: 20)
        let files = FilesystemCompilerArtifactSink(File(root, "output"))
        try {
            var Bool rejected = false
            try { spool.write(CompilerArtifact("a.js", "AA")) } catch (Exception error) { rejected = true }
            expect(rejected).toBe(true)
            expect(storage.getChildFiles(includeDirectories: true).count).toBe(0)
            spool.write(CompilerArtifact("a.js", "A"))
            rejected = false
            try { spool.write(CompilerArtifact("b.js", "B")) } catch (Exception error) { rejected = true }
            expect(rejected).toBe(true)
            spool.commitTo(files)
            spool.write(CompilerArtifact("b.js", "B"))
            spool.dispose()
            expect(File(root, "output/b.js").exists).toBe(false)
            expect(storage.getChildFiles(includeDirectories: true).count).toBe(0)
        } finally {
            spool.dispose()
            Es6ArtifactFiles.remove(root)
        }
    }

    test `published artifact cleanup failure retries cleanup without republication`() {
        let root = File(".flat-artifact-cleanup-test-#{Time.currentTimeMillis}")
        let spool = SpooledCompilerArtifactSink(File(root, "spool"), 1)
        let files = FailingPromotionSink(File(root, "output"))
        native var Object originalRemove
        try {
            spool.write(CompilerArtifact("a.js", "A"))
            external {
                #{originalRemove} = #{File.FileGlobal.fs}.rmSync;
                const original = #{originalRemove};
                #{File.FileGlobal.fs}.rmSync = (path, options) => {
                    if (path.endsWith('.spool')) throw new Error('controlled spool cleanup failure');
                    return original(path, options);
                };
            }
            var Bool rejected = false
            try {
                try { spool.commitTo(files) } catch (Exception error) { rejected = true }
            } finally {
                external { #{File.FileGlobal.fs}.rmSync = #{originalRemove}; }
            }
            expect(rejected).toBe(true)
            expect(files.writes).toBe(1)
            expect(spool.artifacts().count).toBe(0)
            spool.commitTo(files)
            expect(files.writes).toBe(1)
            spool.write(CompilerArtifact("c.js", "C"))
        } finally {
            spool.dispose()
            Es6ArtifactFiles.remove(root)
        }
    }

    test `spool disposal failure remains terminal and cleanup can be retried`() {
        let root = File(".flat-artifact-dispose-test-#{Time.currentTimeMillis}")
        let storage = File(root, "spool")
        let spool = SpooledCompilerArtifactSink(storage, 1)
        let files = FilesystemCompilerArtifactSink(File(root, "output"))
        native var Object originalRemove
        try {
            spool.write(CompilerArtifact("a.js", "A"))
            external {
                #{originalRemove} = #{File.FileGlobal.fs}.rmSync;
                #{File.FileGlobal.fs}.rmSync = () => { throw new Error('controlled dispose failure'); };
            }
            var Bool rejected = false
            try {
                try { spool.dispose() } catch (Exception error) { rejected = true }
            } finally {
                external { #{File.FileGlobal.fs}.rmSync = #{originalRemove}; }
            }
            expect(rejected).toBe(true)
            rejected = false
            try { spool.commitTo(files) } catch (Exception error) { rejected = true }
            expect(rejected).toBe(true)
            expect(files.artifacts().count).toBe(0)
            spool.dispose()
            spool.dispose()
            expect(storage.getChildFiles(includeDirectories: true).count).toBe(0)
        } finally {
            spool.dispose()
            Es6ArtifactFiles.remove(root)
        }
    }

    test `partial native write and cleanup failure cannot become publishable`() {
        let root = File(".flat-artifact-partial-write-test-#{Time.currentTimeMillis}")
        let spool = SpooledCompilerArtifactSink(File(root, "spool"), 1)
        let files = FilesystemCompilerArtifactSink(File(root, "output"))
        native var Object originalWrite
        native var Object originalRemove
        try {
            external {
                #{originalWrite} = #{File.FileGlobal.fs}.writeFileSync;
                #{originalRemove} = #{File.FileGlobal.fs}.rmSync;
                const original = #{originalWrite};
                #{File.FileGlobal.fs}.writeFileSync = (path, data) => {
                    original(path, 'partial');
                    throw new Error('controlled partial write');
                };
                #{File.FileGlobal.fs}.rmSync = () => { throw new Error('controlled failed cleanup'); };
            }
            var String failure = ""
            try {
                try { spool.write(CompilerArtifact("a.js", "A")) }
                catch (Exception error) { failure = error.message }
            } finally {
                external {
                    #{File.FileGlobal.fs}.writeFileSync = #{originalWrite};
                    #{File.FileGlobal.fs}.rmSync = #{originalRemove};
                }
            }
            expect(failure).toBe("controlled partial write")
            expect(spool.artifacts().count).toBe(0)
            spool.commitTo(files)
            expect(files.artifacts().count).toBe(0)
            expect(File(root, "output/a.js").exists).toBe(false)
            spool.write(CompilerArtifact("a.js", "A"))
            spool.commitTo(files)
            expect(Es6ArtifactFiles.read(File(root, "output/a.js"))).toBe("A")
        } finally {
            spool.dispose()
            Es6ArtifactFiles.remove(root)
        }
    }

    test `repeated failed writes retain bounded cleanup charges until drained`() {
        let root = File(".flat-artifact-failed-cap-test-#{Time.currentTimeMillis}")
        let storage = File(root, "spool")
        let spool = SpooledCompilerArtifactSink(storage, 2, maxBytes: 40)
        let files = FilesystemCompilerArtifactSink(File(root, "output"))
        native var Object originalWrite
        native var Object originalRemove
        var Int nativeWrites
        try {
            external {
                #{originalWrite} = #{File.FileGlobal.fs}.writeFileSync;
                #{originalRemove} = #{File.FileGlobal.fs}.rmSync;
                const original = #{originalWrite};
                #{File.FileGlobal.fs}.writeFileSync = (path, data) => {
                    #{nativeWrites}++;
                    original(path, 'partial');
                    throw new Error('controlled partial write');
                };
                #{File.FileGlobal.fs}.rmSync = () => { throw new Error('controlled cleanup'); };
            }
            try {
                var Int rejected
                String[] identities = ["a.js", "b.js", "c.js"]
                for (identity in identities) {
                    try { spool.write(CompilerArtifact(identity, "A")) }
                    catch (Exception error) { rejected++ }
                }
                expect(rejected).toBe(3)
                expect(nativeWrites).toBe(2)
                expect(spool.artifacts().count).toBe(0)
            } finally {
                external {
                    #{File.FileGlobal.fs}.writeFileSync = #{originalWrite};
                    #{File.FileGlobal.fs}.rmSync = #{originalRemove};
                }
            }
            spool.commitTo(files)
            expect(files.artifacts().count).toBe(0)
            spool.write(CompilerArtifact("c.js", "C"))
            spool.commitTo(files)
            expect(Es6ArtifactFiles.read(File(root, "output/c.js"))).toBe("C")
        } finally {
            spool.dispose()
            Es6ArtifactFiles.remove(root)
        }
    }

    class LifecycleRecorder extends CompilerArtifactLifecycleObserver {
        visible var Int created
        visible var Int removed
        visible var Int publications
        visible var Int finalizers
        visible var Int failedFinalizers
        visible var Bool invalidObservation
        visible var Bool throwOnDelivery
        visible var String expectedDestination

        public construct(String expectedDestination) { this.expectedDestination = expectedDestination }

        check(CompilerArtifactLifecycleBinding binding) {
            if (!binding || binding.revision != "revision-1" || binding.identity != "a.js" ||
                binding.destination != expectedDestination) invalidObservation = true
        }
        override public temporaryCreated(CompilerArtifactLifecycleBinding binding, String path) {
            check(binding)
            if (!File(path).exists) invalidObservation = true
            created++
            if (throwOnDelivery) throw Exception("observer delivery failure")
        }
        override public temporaryRemoved(CompilerArtifactLifecycleBinding binding, String path) {
            check(binding)
            if (File(path).exists) invalidObservation = true
            removed++
            if (throwOnDelivery) throw Exception("observer delivery failure")
        }
        override public published(CompilerArtifactLifecycleBinding binding) {
            check(binding)
            if (!File(binding.destination).exists) invalidObservation = true
            publications++
            if (throwOnDelivery) throw Exception("observer delivery failure")
        }
        override public finalized(CompilerArtifactLifecycleBinding binding, String path, Bool removed, Exception failure) {
            check(binding)
            if (removed == File(path).exists) invalidObservation = true
            finalizers++
            if (failure) failedFinalizers++
            if (throwOnDelivery) throw Exception("observer delivery failure")
        }
    }

    test `lifecycle observations bind staged and published files and disposal is idempotent`() {
        let root = File(".flat-artifact-lifecycle-test-#{Time.currentTimeMillis}")
        let output = File(root, "output")
        let observer = LifecycleRecorder(File(output, "a.js").normalizedLocation)
        let files = FilesystemCompilerArtifactSink(output, 1, "revision-1", observer)
        let spool = SpooledCompilerArtifactSink(File(root, "spool"), 1, 1024,
            "revision-1", output, observer)
        try {
            spool.write(CompilerArtifact("a.js", "A"))
            expect(spool.stagedFile().exists).toBe(true)
            expect(observer.created).toBe(2)
            expect(observer.removed).toBe(0)
            spool.commitTo(files)
            expect(observer.publications).toBe(1)
            expect(observer.created).toBe(4)
            expect(observer.removed).toBe(4)
            expect(observer.finalizers).toBe(3)
            expect(observer.failedFinalizers).toBe(0)
            expect(observer.invalidObservation).toBe(false)
            spool.dispose()
            spool.dispose()
            files.retryCleanup()
            expect(observer.finalizers).toBe(3)
            expect(Es6ArtifactFiles.read(File(output, "a.js"))).toBe("A")
        } finally {
            spool.dispose()
            files.retryCleanup()
            Es6ArtifactFiles.remove(root)
        }
    }

    test `cancellation disposal observes removal without claiming publication`() {
        let root = File(".flat-artifact-abort-observation-test-#{Time.currentTimeMillis}")
        let output = File(root, "output")
        let observer = LifecycleRecorder(File(output, "a.js").normalizedLocation)
        let spool = SpooledCompilerArtifactSink(root, 1, 1024, "revision-1", output, observer)
        try {
            spool.write(CompilerArtifact("a.js", "A"))
            let staged = spool.stagedFile()
            spool.dispose()
            expect(staged.exists).toBe(false)
            expect(observer.created).toBe(2)
            expect(observer.removed).toBe(2)
            expect(observer.finalizers).toBe(2)
            expect(observer.publications).toBe(0)
            expect(observer.invalidObservation).toBe(false)
        } finally { spool.dispose(); Es6ArtifactFiles.remove(root) }
    }

    test `failed publication retains bounded cleanup ownership and original failure`() {
        let root = File(".flat-artifact-failed-publication-test-#{Time.currentTimeMillis}")
        let output = File(root, "output")
        let destination = File(output, "a.js")
        let observer = LifecycleRecorder(destination.normalizedLocation)
        let files = FilesystemCompilerArtifactSink(output, 1, "revision-1", observer)
        native var Object originalRename
        native var Object originalRemove
        try {
            Es6ArtifactFiles.write(destination, "old")
            external {
                #{originalRename} = #{File.FileGlobal.fs}.renameSync;
                #{originalRemove} = #{File.FileGlobal.fs}.rmSync;
                #{File.FileGlobal.fs}.renameSync = () => { throw new Error('controlled rename'); };
                #{File.FileGlobal.fs}.rmSync = () => { throw new Error('controlled cleanup'); };
            }
            try {
                var String failure
                try { files.write(CompilerArtifact("a.js", "new")) }
                catch (Exception error) { failure = error.message }
                expect(failure).toBe("controlled rename")
                expect(files.pendingCleanupCount).toBe(1)
                expect(files.cleanupError("a.js").message).toBe("controlled cleanup")
                expect(files.artifacts().count).toBe(0)
                expect(observer.created).toBe(2)
                expect(observer.removed).toBe(0)
                expect(observer.failedFinalizers).toBe(1)
                expect(observer.publications).toBe(0)
                var Bool rejected = false
                try { files.write(CompilerArtifact("b.js", "B")) }
                catch (Exception error) { rejected = true }
                expect(rejected).toBe(true)
                expect(observer.created).toBe(2)
            } finally {
                external {
                    #{File.FileGlobal.fs}.renameSync = #{originalRename};
                    #{File.FileGlobal.fs}.rmSync = #{originalRemove};
                }
            }
            files.retryCleanup()
            expect(files.pendingCleanupCount).toBe(0)
            expect(observer.removed).toBe(2)
            expect(observer.finalizers).toBe(2)
            expect(observer.invalidObservation).toBe(false)
            expect(Es6ArtifactFiles.read(destination)).toBe("old")
        } finally { files.retryCleanup(); Es6ArtifactFiles.remove(root) }
    }

    test `spool disposal owns cleanup from a failed destination publication`() {
        let root = File(".flat-artifact-abort-failed-publication-test-#{Time.currentTimeMillis}")
        let files = FilesystemCompilerArtifactSink(File(root, "output"), 1)
        let spool = SpooledCompilerArtifactSink(File(root, "spool"), 1)
        native var Object originalRename
        native var Object originalRemove
        try {
            spool.write(CompilerArtifact("a.js", "A"))
            external {
                #{originalRename} = #{File.FileGlobal.fs}.renameSync;
                #{originalRemove} = #{File.FileGlobal.fs}.rmSync;
                #{File.FileGlobal.fs}.renameSync = () => { throw new Error('controlled rename'); };
                #{File.FileGlobal.fs}.rmSync = () => { throw new Error('controlled cleanup'); };
            }
            try {
                var Bool rejected = false
                try { spool.commitTo(files) } catch (Exception error) { rejected = true }
                expect(rejected).toBe(true)
                expect(files.pendingCleanupCount).toBe(1)
                expect(files.artifacts().count).toBe(0)
                expect(spool.artifacts().count).toBe(1)
            } finally {
                external {
                    #{File.FileGlobal.fs}.renameSync = #{originalRename};
                    #{File.FileGlobal.fs}.rmSync = #{originalRemove};
                }
            }
            spool.dispose()
            spool.dispose()
            expect(files.pendingCleanupCount).toBe(0)
            expect(spool.artifacts().count).toBe(0)
            expect(File(root, "output/a.js").exists).toBe(false)
            expect(File(root, "spool").getChildFiles(includeDirectories: true).count).toBe(0)
        } finally { spool.dispose(); files.retryCleanup(); Es6ArtifactFiles.remove(root) }
    }

    test `successful remove call with surviving temporary cannot claim cleanup`() {
        let root = File(".flat-artifact-noop-cleanup-test-#{Time.currentTimeMillis}")
        let output = File(root, "output")
        let observer = LifecycleRecorder(File(output, "a.js").normalizedLocation)
        let files = FilesystemCompilerArtifactSink(output, 1, "revision-1", observer)
        let spool = SpooledCompilerArtifactSink(File(root, "spool"), 1, 1024,
            "revision-1", output, observer)
        native var Object originalRemove
        try {
            spool.write(CompilerArtifact("a.js", "A"))
            external {
                #{originalRemove} = #{File.FileGlobal.fs}.rmSync;
                #{File.FileGlobal.fs}.rmSync = () => {};
            }
            try {
                var Bool failed = false
                try { spool.commitTo(files) } catch (Exception error) { failed = true }
                expect(failed).toBe(true)
                expect(files.pendingCleanupCount).toBe(1)
                // Only the rename consumed its temporary payload. Neither directory
                // nor the retained spool file has actually been removed.
                expect(observer.removed).toBe(1)
                expect(observer.publications).toBe(1)
                try { spool.dispose() } catch (Exception error) {}
                expect(observer.removed).toBe(1)
                expect(observer.invalidObservation).toBe(false)
            } finally {
                external { #{File.FileGlobal.fs}.rmSync = #{originalRemove}; }
            }
            // dispose must retry the transferred destination receipt as well as
            // spool storage; it must never publish the already committed output.
            spool.dispose()
            expect(files.pendingCleanupCount).toBe(0)
            expect(observer.removed).toBe(4)
            expect(observer.publications).toBe(1)
            expect(observer.invalidObservation).toBe(false)
            expect(Es6ArtifactFiles.read(File(output, "a.js"))).toBe("A")
        } finally { spool.dispose(); files.retryCleanup(); Es6ArtifactFiles.remove(root) }
    }

    test `observer failure cannot lose cleanup ownership or cause republishing`() {
        let root = File(".flat-artifact-observer-failure-test-#{Time.currentTimeMillis}")
        let output = File(root, "output")
        let observer = LifecycleRecorder(File(output, "a.js").normalizedLocation)
        observer.throwOnDelivery = true
        let files = FilesystemCompilerArtifactSink(output, 1, "revision-1", observer)
        try {
            files.write(CompilerArtifact("a.js", "A"))
            files.retryCleanup()
            expect(files.pendingCleanupCount).toBe(0)
            expect(observer.publications).toBe(1)
            expect(observer.created).toBe(2)
            expect(observer.removed).toBe(2)
            expect(observer.invalidObservation).toBe(false)
            expect(Es6ArtifactFiles.read(File(output, "a.js"))).toBe("A")
        } finally { files.retryCleanup(); Es6ArtifactFiles.remove(root) }
    }

    test `mismatched publication binding is rejected before destination writes`() {
        let root = File(".flat-artifact-binding-test-#{Time.currentTimeMillis}")
        let output = File(root, "output")
        let observer = LifecycleRecorder(File(output, "a.js").normalizedLocation)
        let spool = SpooledCompilerArtifactSink(File(root, "spool"), 1, 1024,
            "revision-1", output, observer)
        let wrongRoot = FilesystemCompilerArtifactSink(File(root, "other"))
        let wrongRevision = FilesystemCompilerArtifactSink(output, 1, "revision-2", observer)
        try {
            spool.write(CompilerArtifact("a.js", "A"))
            var Int rejected
            try { spool.commitTo(wrongRoot) } catch (Exception error) { rejected++ }
            try { spool.commitTo(wrongRevision) } catch (Exception error) { rejected++ }
            expect(rejected).toBe(2)
            expect(wrongRoot.artifacts().count).toBe(0)
            expect(wrongRevision.artifacts().count).toBe(0)
            expect(spool.stagedFile().exists).toBe(true)
            expect(observer.publications).toBe(0)
        } finally { spool.dispose(); Es6ArtifactFiles.remove(root) }
    }

    test `normalized directory identities remain valid for source compiler artifacts`() {
        let root = File(".flat-artifact-nested-test-#{Time.currentTimeMillis}")
        let output = File(root, "output")
        let storage = File(root, "spool")
        let files = FilesystemCompilerArtifactSink(output)
        let spool = SpooledCompilerArtifactSink(storage, 1)
        try {
            Es6ArtifactFiles.ensureDirectory(File(output, "sources"))
            Es6ArtifactFiles.ensureDirectory(File(storage, "sources"))
            spool.write(CompilerArtifact("sources/Main.flat.js", "nested"))
            spool.commitTo(files)
            expect(Es6ArtifactFiles.read(File(output, "sources/Main.flat.js"))).toBe("nested")
            expect(File(storage, "sources/Main.flat.js.spool").exists).toBe(false)
            expect(files.artifacts().first.identity).toBe("sources/Main.flat.js")
        } finally {
            spool.dispose()
            Es6ArtifactFiles.remove(root)
        }
    }
}
