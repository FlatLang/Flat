package flat/compiler

import flat/test/TestResult

import flat/time/Timer
import flat/io/FancyOutputStream
import flat/compiler/Compiler

[TestSuite [
    Compiler_Test,
    CompilerPackage_Test,
    CompilerDogfoodLifecycle_Test,
    CompilerIncrementalState_Test,
    CompilerPackageReuse_Test,
    CompilerArtifactSink_Test,
    CompilerCli_Test,
    CompilerEvidence_Test,
    CompilerInvocationAdmission_Test,
    CompilerSourceReadSchedule_Test,
    FlatEs6SourceCompiler_Test
]]
class {
    /** Explicit diagnostic subset; never substitutes for default full acceptance. */
    public static async runInfrastructure(onResult(TestResult)) {
        CompilerInvocationAdmission_Test().runTests(onResult)
        CompilerEvidence_Test().runTests(onResult)
        CompilerSourceReadSchedule_Test().runTests(onResult)
        CompilerIncrementalState_Test().runTests(onResult)
    }

    public static infrastructureRequested(String[] args) -> Bool {
        return args.contains("--infrastructure")
    }

    public static workloadExecutionRequested(String[] args) -> Bool {
        return args.contains("--workload-execution")
    }

    public static evidenceRequested(String[] args) -> Bool {
        return args.contains("--evidence")
    }

    public static failureCount(TestResult[] results) -> Int {
        var Int failures
        for (result in results) {
            if (!result || !result.success) failures++
        }
        return failures
    }

    public static executionFailed(TestResult[] results, Bool runnerFailed = false) -> Bool {
        return runnerFailed || results.count == 0 || failureCount(results) > 0
    }

    public static async main(String[] args) {
        native var Object completionGuard
        external js {
            #{completionGuard} = () => {
                console.error('Compiler test execution incomplete: no terminal result accounting');
                process.exitCode = 1;
            };
            process.once('beforeExit', #{completionGuard});
        }
        let test = Compiler_TestSuite()

        Timer timer = Timer().start()

        let results = TestResult[]

        var Bool runnerFailed
        try {
            if ((args.count == 1 || (args.count == 2 &&
                (args.first == "test.js" || args.first.endsWith("/test.js")))) && args.last == "--type-sections") {
                Console.writeLine("Type sections consumer diagnostic; full suite remains required")
                CompilerPackage_Test().assertDeclarationRuntime()
                Console.writeLine("Type sections: assertDeclarationRuntime passed")
                CompilerPackage_Test().assertDeclarationCapacity()
                Console.writeLine("Type sections: assertDeclarationCapacity passed")
                FlatEs6SourceCompiler_Test().assertSourceDeclarationRuntime()
                Console.writeLine("Type sections: assertSourceDeclarationRuntime passed")
                CompilerPackageReuse_Test().assertDeclarationReuseCapacity()
                Console.writeLine("Type sections: assertDeclarationReuseCapacity passed")
                CompilerSourceReadSchedule_Test().assertDeclarationSchedules()
                Console.writeLine("Type sections: assertDeclarationSchedules passed")
                CompilerSourceReadSchedule_Test().assertDeclarationCheckpointIdentity()
                Console.writeLine("Type sections: assertDeclarationCheckpointIdentity passed")
                CompilerSourceReadSchedule_Test().assertDeclarationCheckpointCleanup()
                Console.writeLine("Type sections: assertDeclarationCheckpointCleanup passed")
                CompilerSourceReadSchedule_Test().assertDeclarationOverflowCleanup()
                Console.writeLine("Type sections: assertDeclarationOverflowCleanup passed")
                external js { process.removeListener('beforeExit', #{completionGuard}); }
                Console.writeLine("Type sections consumer: successful (eight regressions)")
                return
            } else if (args.contains("--workload-syntax")) {
                Console.writeLine("Compiler workload syntax diagnostic; no semantic or product acceptance")
                CompilerPackage_Test.assertProductionWorkloadSyntax()
                external js { process.removeListener('beforeExit', #{completionGuard}); }
                Console.writeLine("Production Core workload syntax: successful")
                return
            } else if (args.contains("--runtime-class-name")) {
                Console.writeLine("Compiler runtime class name diagnostic; full suite remains required")
                CompilerPackage_Test.assertRuntimeClassNameExecution()
                external js { process.removeListener('beforeExit', #{completionGuard}); }
                Console.writeLine("Runtime class name execution: successful (1 true, receiver once, canonical String consumer, empty stderr)")
                return
            } else if (args.contains("--captured-native-backing")) {
                Console.writeLine("Compiler captured native backing execution diagnostic; full suite remains required")
                CompilerPackage_Test.assertCapturedNativeBackingExecution()
                external js { process.removeListener('beforeExit', #{completionGuard}); }
                Console.writeLine("Captured native backing execution: successful (seven results, exit zero, empty stderr)")
                return
            } else if (workloadExecutionRequested(args)) {
                Console.writeLine("Compiler workload execution diagnostic; full suite acceptance remains required")
                CompilerSourceReadSchedule_Test.assertProductionWorkloadExecution()
                external js { process.removeListener('beforeExit', #{completionGuard}); }
                Console.writeLine("Production Core workload execution: successful (capacity 1/3, forward/reverse)")
                return
            } else if (evidenceRequested(args)) {
                Console.writeLine("Compiler evidence subset; full suite acceptance remains required")
                CompilerEvidence_Test().runTests((result) => { results.add(result) })
            } else if (infrastructureRequested(args)) {
                Console.writeLine("Compiler infrastructure subset; full suite acceptance remains required")
                runInfrastructure((result) => { results.add(result) })
            } else {
                test.runTests((result) => { results.add(result) })
            }
        } catch (Exception error) {
            runnerFailed = true
            Console.writeLine("Compiler test runner failed: #error")
        }
        if (results.count == 0) Console.writeLine("Compiler test runner produced no results")

        let fancy = FancyOutputStream(headerPattern: "/\\")

        let unsuccessful = results.filter((result) => !result || !result.success)
        let failed = executionFailed(results, runnerFailed)

        if (failed) {
            fancy.writeHeader(
                "#{failureCount(results)} test failures out of #results.count results; runnerFailed=#runnerFailed",
                pattern: ":'( ",
                symmetrical: true
            )

            unsuccessful.forEach((result) => {
                Console.log("#result")
            })
        } else {
            fancy.writeHeader(
                "All #results.count Successful",
                pattern: ":) ",
                symmetrical: true
            )
        }

        timer.stop()

        Console.writeLine("Took #{timer.duration}ms")

        external js { process.removeListener('beforeExit', #{completionGuard}); }
        if (failed) System.exit(1)
    }
}
