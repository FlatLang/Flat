package flat/compiler

import flat/test/TestResult

import flat/time/Timer
import flat/io/FancyOutputStream
import flat/compiler/Compiler

[TestSuite [
    Compiler_Test,
    CompilerPackage_Test,
    CompilerDogfoodLifecycle_Test,
    CompilerIncrementalState_Test,
    CompilerPackageReuse_Test,
    CompilerArtifactSink_Test,
    CompilerCli_Test,
    CompilerEvidence_Test,
    CompilerInvocationAdmission_Test,
    CompilerSourceReadSchedule_Test,
    FlatEs6SourceCompiler_Test
]]
class {
    /** Explicit diagnostic subset; never substitutes for default full acceptance. */
    public static async runInfrastructure(onResult(TestResult)) {
        CompilerInvocationAdmission_Test().runTests(onResult)
        CompilerEvidence_Test().runTests(onResult)
        CompilerSourceReadSchedule_Test().runTests(onResult)
        CompilerIncrementalState_Test().runTests(onResult)
    }

    public static infrastructureRequested(String[] args) -> Bool {
        return args.contains("--infrastructure")
    }

    public static failureCount(TestResult[] results) -> Int {
        var Int failures
        for (result in results) {
            if (!result || !result.success) failures++
        }
        return failures
    }

    public static executionFailed(TestResult[] results, Bool runnerFailed = false) -> Bool {
        return runnerFailed || results.count == 0 || failureCount(results) > 0
    }

    public static async main(String[] args) {
        native var Object completionGuard
        external js {
            #{completionGuard} = () => {
                console.error('Compiler test execution incomplete: no terminal result accounting');
                process.exitCode = 1;
            };
            process.once('beforeExit', #{completionGuard});
        }
        let test = Compiler_TestSuite()

        Timer timer = Timer().start()

        let results = TestResult[]

        var Bool runnerFailed
        try {
            if (args.contains("--workload-syntax")) {
                Console.writeLine("Compiler workload syntax diagnostic; no semantic or product acceptance")
                CompilerPackage_Test.assertProductionWorkloadSyntax()
                external js { process.removeListener('beforeExit', #{completionGuard}); }
                Console.writeLine("Production Core workload syntax: successful")
                return
            } else if (infrastructureRequested(args)) {
                Console.writeLine("Compiler infrastructure subset; full suite acceptance remains required")
                runInfrastructure((result) => { results.add(result) })
            } else {
                test.runTests((result) => { results.add(result) })
            }
        } catch (Exception error) {
            runnerFailed = true
            Console.writeLine("Compiler test runner failed: #error")
        }
        if (results.count == 0) Console.writeLine("Compiler test runner produced no results")

        let fancy = FancyOutputStream(headerPattern: "/\\")

        let unsuccessful = results.filter((result) => !result || !result.success)
        let failed = executionFailed(results, runnerFailed)

        if (failed) {
            fancy.writeHeader(
                "#{failureCount(results)} test failures out of #results.count results; runnerFailed=#runnerFailed",
                pattern: ":'( ",
                symmetrical: true
            )

            unsuccessful.forEach((result) => {
                Console.log("#result")
            })
        } else {
            fancy.writeHeader(
                "All #results.count Successful",
                pattern: ":) ",
                symmetrical: true
            )
        }

        timer.stop()

        Console.writeLine("Took #{timer.duration}ms")

        external js { process.removeListener('beforeExit', #{completionGuard}); }
        if (failed) System.exit(1)
    }
}
