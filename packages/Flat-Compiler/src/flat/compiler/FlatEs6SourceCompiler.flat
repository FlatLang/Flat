package flat/compiler

import flat/lexer
import flat/bound
import flat/compiler/models
import flat/parser/flat
import flat/semantic/binding/primitive
import flat/writer/es6/bound

/**
 * Source-scoped composition of package-owned Flat frontend, binding, and ES6 APIs.
 * Finite token/type/fragment materializations are explicit bounded source and
 * artifact partition barriers.
 */
class {
    public construct(
        visible Int maxSourceCharacters = 65536,
        visible Int maxTokens = 8192,
        visible Int maxFragments = 1024,
        visible Int maxTypes = 256,
        visible Int maxArtifactCharacters = 33554432
    ) {
        if (maxSourceCharacters <= 0 || maxTokens <= 0 ||
            maxFragments <= 0 || maxTypes <= 0 || maxArtifactCharacters <= 0) {
            throw Exception("Flat ES6 source compiler capacities must be positive")
        }
    }

    public async compile(CompilerSource source) -> String {
        if (!source) throw Exception("Flat ES6 source compilation requires source")
        if (source.text.count > maxSourceCharacters) {
            throw Exception("Flat source exceeds configured character capacity")
        }

        let tokenStream = Lexer().lexInterpolated(source.text)
        tokenStream.emit("start")
        let tokens = tokenStream.consumeAll<Token>("data")
        if (tokens.count > maxTokens) {
            throw Exception("Flat source exceeds configured token capacity")
        }
        let significant = tokens.filter((token) => {
            let type = token.type
            return type != Token.Type.WHITESPACE && type != Token.Type.COMMENT
        })
        if (significant.count == 0) throw Exception("Flat source contains no declarations")

        let snapshot = SourceSnapshotIdentity(SourceIdentity(source.identity), "compiler-input")
        if (significant.first.value == "package" || significant.first.value == "import" ||
            hasTypeDeclarations(significant)) {
            return compileTypeSource(tokens, snapshot)
        }
        return assemble(compileFunctions(tokens, snapshot))
    }

    hasTypeDeclarations(Token[] tokens) -> Bool {
        var Int depth
        var Int count
        for (token in tokens) {
            if (token.value == "{") depth++
            else if (token.value == "}") depth--
            else if (depth == 0 && token.value == "class") count++
        }
        return count > 0
    }

    compileTypeSource(
        Token[] tokens,
        SourceSnapshotIdentity snapshot
    ) -> String {
        let partitions = FlatSourceTypePartitioner(
            maxTypeTokens: maxTokens,
            maxTypes: maxTypes
        ).partition(tokens, snapshot, "js")
        let syntaxes = PrimitiveClassSyntax[]
        for (partition in partitions) {
            if (partition.declarationKind != "class") {
                throw Exception("Reduced ES6 source compilation supports class type partitions")
            }
            syntaxes.add(PrimitiveClassParser().parse(
                partition.tokenValues(), snapshot, partition.startTokenIndex
            ))
        }
        let types = PrimitiveClassPartitionBinder().bind(
            syntaxes, snapshot, maxTypes
        ).typeUnits()
        requireFragmentCapacity(types.count)
        // Existing finite artifact runtime-declarations-ready boundary:
        // bounded count plus aggregate text, not a project-wide barrier.
        let sections = Es6TypeSections[]
        var Int retainedCharacters
        var Int index
        while (index < types.count) {
            let emitted = Es6UnitOrchestrator().emitTypeSections(TypeFeatureLowering.lowerLazyProperties(types[index]), index)
            if (!emitted.emitted) {
                throw Exception("#{emitted.diagnostic.code}: #{emitted.diagnostic.message}")
            }
            let section = emitted.sections
            retainedCharacters = chargeCharacters(retainedCharacters, section.declarations.count)
            retainedCharacters = chargeCharacters(retainedCharacters, section.metadata.count)
            retainedCharacters = chargeCharacters(retainedCharacters, section.eagerInitializers.count)
            sections.add(section)
            index++
        }
        // Direct immutable source compilation has no provider/session checkpoint.
        // Use the assembler's no-op default; package linking forwards its scoped
        // provider checkpoint without retaining it beyond this assembly call.
        let assembly = Es6FragmentAssembler(maxFragments, maxArtifactCharacters).assembleTypeSections(sections)
        if (!assembly.assembled) throw Exception("#{assembly.diagnostic.code}: #{assembly.diagnostic.message}")
        return assembly.code
    }

    compileFunctions(Token[] tokens, SourceSnapshotIdentity snapshot) -> Es6ArtifactFragment[] {
        let functions = PrimitiveFunctionBinder().bind(
            PrimitiveFunctionParser().parse(tokens, snapshot), snapshot
        ).functionValues()
        requireFragmentCapacity(functions.count)
        let fragments = Es6ArtifactFragment[]
        var Int index
        while (index < functions.count) {
            fragments.add(requireEmission(Es6UnitOrchestrator().emitFunction(functions[index], index)))
            index++
        }
        return fragments
    }

    compileClass(
        Token[] tokens,
        SourceSnapshotIdentity snapshot,
        Int sourceTokenIndexOffset,
        Int ordinal
    ) -> Es6ArtifactFragment[] {
        let syntax = PrimitiveClassParser().parse(tokens, snapshot, sourceTokenIndexOffset)
        let type = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        return [requireEmission(Es6UnitOrchestrator().emitType(TypeFeatureLowering.lowerLazyProperties(type), ordinal))]
    }

    chargeCharacters(Int retained, Int additional) -> Int {
        if (additional > maxArtifactCharacters - retained) {
            throw Exception("es6.assembly-capacity: ES6 artifact exceeds configured character capacity")
        }
        return retained + additional
    }

    requireEmission(Es6EmissionResult emitted) -> Es6ArtifactFragment {
        if (!emitted.emitted) {
            throw Exception("#{emitted.diagnostic.code}: #{emitted.diagnostic.message}")
        }
        return emitted.fragment
    }

    requireFragmentCapacity(Int count) {
        if (count > maxFragments) {
            throw Exception("Flat source exceeds configured ES6 fragment capacity")
        }
    }

    assemble(Es6ArtifactFragment[] fragments) -> String {
        var Int retainedCharacters
        for (fragment in fragments) {
            retainedCharacters = chargeCharacters(retainedCharacters, fragment.code.count)
        }
        let assembly = Es6FragmentAssembler(maxFragments, maxArtifactCharacters).assemble(fragments)
        if (!assembly.assembled) {
            throw Exception("#{assembly.diagnostic.code}: #{assembly.diagnostic.message}")
        }
        return assembly.code
    }
}
