package flat/compiler

import flat/lexer
import flat/compiler/models
import flat/parser/flat
import flat/semantic/binding/primitive
import flat/writer/es6/bound

/**
 * Source-scoped composition of package-owned Flat frontend, binding, and ES6 APIs.
 *
 * The finite token and fragment materializations are explicit source/artifact
 * barriers. Their configured limits keep this bootstrap path bounded while the
 * owning packages retain all grammar, semantic, and target decisions.
 */
class {
    public construct(
        visible Int maxSourceCharacters = 65536,
        visible Int maxTokens = 8192,
        visible Int maxFragments = 1024
    ) {
        if (maxSourceCharacters <= 0 || maxTokens <= 0 || maxFragments <= 0) {
            throw Exception("Flat ES6 source compiler capacities must be positive")
        }
    }

    public async compile(CompilerSource source) -> String {
        if (!source) throw Exception("Flat ES6 source compilation requires source")
        if (source.text.count > maxSourceCharacters) {
            throw Exception("Flat source exceeds configured character capacity")
        }

        let tokenStream = Lexer().lex(source.text)
        tokenStream.emit("start")
        let tokens = tokenStream.consumeAll<Token>("data")
        if (tokens.count > maxTokens) {
            throw Exception("Flat source exceeds configured token capacity")
        }
        let significant = tokens.filter({
            let type = _.type
            return type != Token.Type.WHITESPACE && type != Token.Type.COMMENT
        })
        if (significant.count == 0) throw Exception("Flat source contains no declarations")

        let snapshot = SourceSnapshotIdentity(
            SourceIdentity(source.identity),
            "compiler-input"
        )
        let fragments = significant.first.value == "class"
            ? compileClass(significant, snapshot)
            : compileFunctions(significant, snapshot)
        return assemble(fragments)
    }

    compileFunctions(
        Token[] tokens,
        SourceSnapshotIdentity snapshot
    ) -> Es6ArtifactFragment[] {
        let functions = PrimitiveFunctionBinder().bind(
            PrimitiveFunctionParser().parse(tokens, snapshot), snapshot
        ).functionValues()
        requireFragmentCapacity(functions.count)
        let fragments = Es6ArtifactFragment[]
        var Int index
        while (index < functions.count) {
            let emitted = Es6UnitOrchestrator().emitFunction(functions[index], index)
            fragments.add(requireEmission(emitted))
            index++
        }
        return fragments
    }

    compileClass(
        Token[] tokens,
        SourceSnapshotIdentity snapshot
    ) -> Es6ArtifactFragment[] {
        let syntax = PrimitiveClassParser().parse(tokens, snapshot)
        let type = PrimitiveClassBinder().bind(syntax, snapshot).typeUnit
        requireFragmentCapacity(1)
        return [requireEmission(Es6UnitOrchestrator().emitType(type, 0))]
    }

    requireEmission(Es6EmissionResult emitted) -> Es6ArtifactFragment {
        if (!emitted.emitted) {
            throw Exception("#{emitted.diagnostic.code}: #{emitted.diagnostic.message}")
        }
        return emitted.fragment
    }

    requireFragmentCapacity(Int count) {
        if (count > maxFragments) {
            throw Exception("Flat source exceeds configured ES6 fragment capacity")
        }
    }

    assemble(Es6ArtifactFragment[] fragments) -> String {
        let assembly = Es6FragmentAssembler(maxFragments).assemble(fragments)
        if (!assembly.assembled) {
            throw Exception("#{assembly.diagnostic.code}: #{assembly.diagnostic.message}")
        }
        return assembly.code
    }
}
