package flat/compiler

/** Immutable completion counts with at most one retained package failure.
 * Package compilation completes before callers can observe topics; this terminal
 * diagnostic is owned by the result, not an event replay queue. Other compilation
 * paths retain their existing count-only contract.
 */
data class {
    public construct(
        visible Int sourceCount,
        visible Int artifactCount,
        visible Int diagnosticCount,
        visible Bool cancelled,
        visible String packageDiagnostic = null
    ) {
        if (sourceCount < 0 || artifactCount < 0 || diagnosticCount < 0) {
            throw Exception("Compilation summary counts cannot be negative")
        }
    }
}
