package flat/compiler

import flat/semantic/binding/BindingDiagnostic
import flat/parser/ParserDiagnostic

/** Immutable terminal counts. sourceCount counts admitted identities, artifactCount
 * counts successful writes to the supplied sink (staging for a spool, not final
 * destination publication), and diagnosticCount counts recorded failures.
 * Completion follows session-owned action cleanup; it does not prove that caller-
 * owned sinks were finalized, subprocesses reaped, or temporary outputs removed.
 * Those require observations by the owning lifecycle harness.
 * packageDiagnostic retains at most the last failure, including executor rejection;
 * it is not an event replay queue. Compatibility adapters consume notifications
 * while artifacts remain owned by the supplied sink.
 */
data class {
    /** Clean terminal outcome, independent of whether this invocation emits artifacts. */
    visible Bool succeeded => !cancelled && cleanupSettled && diagnosticCount == 0 &&
        packageDiagnostic == null && bindingDiagnostic == null && parserDiagnostic == null

    public construct(
        visible Int sourceCount,
        visible Int artifactCount,
        visible Int diagnosticCount,
        visible Bool cancelled,
        visible String packageDiagnostic = null,
        visible CompilerReuseEvidence reuse = CompilerReuseEvidence(),
        visible Int peakActiveSources = 0,
        visible Int peakRetainedSources = 0,
        visible Bool cleanupSettled = true,
        visible Int peakActiveSourceReads = 0,
        visible Int peakRetainedSourceReads = 0,
        visible BindingDiagnostic bindingDiagnostic = null,
        visible ParserDiagnostic parserDiagnostic = null
    ) {
        if (sourceCount < 0 || artifactCount < 0 || diagnosticCount < 0 ||
            peakActiveSources < 0 || peakRetainedSources < 0 ||
            peakActiveSourceReads < 0 || peakRetainedSourceReads < 0) {
            throw Exception("Compilation summary counts and peaks cannot be negative")
        }
    }
}
