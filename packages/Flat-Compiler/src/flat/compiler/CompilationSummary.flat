package flat/compiler

import flat/semantic/binding/BindingDiagnostic

/** Immutable terminal counts. sourceCount counts admitted identities, artifactCount
 * counts successful sink commits (including commits preceding cancellation), and
 * diagnosticCount counts recorded failures. Completion follows action cleanup.
 * packageDiagnostic retains at most the last failure, including executor rejection;
 * it is not an event replay queue. Compatibility adapters consume notifications
 * while artifacts remain owned by the supplied sink.
 */
data class {
    public construct(
        visible Int sourceCount,
        visible Int artifactCount,
        visible Int diagnosticCount,
        visible Bool cancelled,
        visible String packageDiagnostic = null,
        visible CompilerReuseEvidence reuse = CompilerReuseEvidence(),
        visible Int peakActiveSources = 0,
        visible Int peakRetainedSources = 0,
        visible Bool cleanupSettled = true,
        visible Int peakActiveSourceReads = 0,
        visible Int peakRetainedSourceReads = 0,
        visible BindingDiagnostic bindingDiagnostic = null
    ) {
        if (sourceCount < 0 || artifactCount < 0 || diagnosticCount < 0) {
            throw Exception("Compilation summary counts cannot be negative")
        }
    }
}
