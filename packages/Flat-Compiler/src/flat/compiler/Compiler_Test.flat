                CompilerSource(
                    "flat/datastruct/list/NoSuchElementException.flat",
                    Es6ArtifactFiles.read(File(
                        "../Flat-Core/src/flat/datastruct/list/NoSuchElementException.flat"
                    ))
                ),
                CompilerSource(
                    "flat/exception/Exception.flat",
                    Es6ArtifactFiles.read(File(
                        "../Flat-Core/src/flat/exception/Exception.flat"
                    ))
                ),
                CompilerSource(
                    "flat/exception/StackTrace.flat",
                    Es6ArtifactFiles.read(File(
                        "../Flat-Core/src/flat/exception/StackTrace.flat"
                    ))
                ),
                CompilerSource(
                    "flat/datastruct/list/IntRange.flat",
                    Es6ArtifactFiles.read(File(
                        "../Flat-Core/src/flat/datastruct/list/IntRange.flat"
                    ))
                ),
                CompilerSource(
                    "flat/datastruct/list/IntRangeIterator.flat",
                    Es6ArtifactFiles.read(File(
                        "../Flat-Core/src/flat/datastruct/list/IntRangeIterator.flat"
                    ))
                ),
                CompilerSource(
                    "flat/datastruct/list/Iterable.flat",
                    Es6ArtifactFiles.read(File(
                        "../Flat-Core/src/flat/datastruct/list/Iterable.flat"
                    ))
                ),
                CompilerSource(
                    "flat/datastruct/list/Iterator.flat",
                    Es6ArtifactFiles.read(File(
                        "../Flat-Core/src/flat/datastruct/list/Iterator.flat"
                    ))
                ),
                CompilerSource(
                    "flat/datastruct/list/List.flat",
                    Es6ArtifactFiles.read(File(
                        "../Flat-Core/src/flat/datastruct/list/List.flat"
                    ))
                )
            ])
        let rangeIdentity = "flat/datastruct/list/IntRange.flat"
        let iteratorIdentity = "flat/datastruct/list/IntRangeIterator.flat"
        let rangeSnapshot = SourceSnapshotIdentity(
            SourceIdentity(rangeIdentity), "compiler-input"
        )
        let iteratorSnapshot = SourceSnapshotIdentity(
            SourceIdentity(iteratorIdentity), "compiler-input"
        )
        let rangeSource = Es6ArtifactFiles.read(File(
            "../Flat-Core/src/flat/datastruct/list/IntRange.flat"
        ))
        let rangeStream = Lexer().lexInterpolated(rangeSource)
        rangeStream.emit("start")
        let rangePartition = FlatSourceTypePartitioner().partition(
            rangeStream.consumeAll<Token>("data"), rangeSnapshot
        ).first
        let rangeSyntax = PrimitiveClassParser().parse(
            rangePartition.tokenValues(), rangeSnapshot,
            rangePartition.startTokenIndex, "IntRange"
        )
        let iteratorSource = Es6ArtifactFiles.read(File(
            "../Flat-Core/src/flat/datastruct/list/IntRangeIterator.flat"
        ))
        let iteratorStream = Lexer().lexInterpolated(iteratorSource)
        iteratorStream.emit("start")
        let iteratorPartition = FlatSourceTypePartitioner().partition(
            iteratorStream.consumeAll<Token>("data"), iteratorSnapshot
        ).first
        let iteratorSyntax = PrimitiveClassParser().parse(
            iteratorPartition.tokenValues(), iteratorSnapshot,
            iteratorPartition.startTokenIndex, "IntRangeIterator"
        )
        let rangeType = DeclarationIdentity(
            SyntaxIslandIdentity(rangeSnapshot, "class", rangeSyntax.range.startTokenIndex),
            "class", "IntRange"
        )
        let iteratorType = DeclarationIdentity(
            SyntaxIslandIdentity(iteratorSnapshot, "class", iteratorSyntax.range.startTokenIndex),
            "class", "IntRangeIterator"
        )
        let hasNext = iteratorSyntax.methodValues().firstOrNull({ _.name == "hasNext" })
        let stepNext = iteratorSyntax.methodValues().firstOrNull({ _.name == "stepNext" })
        let hasNextIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(iteratorSnapshot, "instance-method", hasNext.range.startTokenIndex),
            "instance-method", "hasNext"
        )
        let stepNextIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(iteratorSnapshot, "instance-method", stepNext.range.startTokenIndex),
            "instance-method", "stepNext"
        )
        let rangeName = Es6NameMangler.mangle(rangeType.value)
        let iteratorName = Es6NameMangler.mangle(iteratorType.value)
        let startName = Es6NameMangler.mangle(SymbolIdentity(rangeType, "field", 0).value)
        let endName = Es6NameMangler.mangle(SymbolIdentity(rangeType, "field", 1).value)
        let root = File(".flat-compiler-range-iterator-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(
            destination,
            code + "let range = new " + rangeName + "();\n" +
                "range." + startName + " = 2; range." + endName + " = 4;\n" +
                "let iterator = new " + iteratorName + "(range);\n" +
                "console.log(iterator." + Es6NameMangler.mangle(hasNextIdentity.value) +
                "(), iterator." + Es6NameMangler.mangle(stepNextIdentity.value) +
                "(), iterator." + Es6NameMangler.mangle(stepNextIdentity.value) + "());\n"
        )
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("true 2 3\n")
        Es6ArtifactFiles.remove(root)
    }

    async test `partitions unchanged String source to its first reduced parser frontier`() {
        let source = Es6ArtifactFiles.read(File("../Flat-Core/src/flat/String.flat"))
        let stream = Lexer().lexInterpolated(source)
        stream.emit("start")
        let tokens = stream.consumeAll<Token>("data")
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("flat/String.flat"), "compiler-input"
        )
        var String message
        try {
            FlatSourceTypePartitioner().partition(tokens, snapshot)
        } catch (Exception error) { message = error.message }
        expect(message).toBe(null)
    }

    async test `package linker compiles and executes unchanged String overlay`() {
        let identity = "flat/String.flat"
        let source = Es6ArtifactFiles.read(File("../Flat-Core/src/flat/String.flat"))
        let stringStream = Lexer().lexInterpolated(source)
        stringStream.emit("start")
        let stringSnapshot = SourceSnapshotIdentity(SourceIdentity(identity), "compiler-input")
        let stringPartition = FlatSourceTypePartitioner().partition(
            stringStream.consumeAll<Token>("data"), stringSnapshot, "js"
        ).first
        let stringSyntax = PrimitiveClassParser().parse(
            stringPartition.tokenValues(), stringSnapshot, stringPartition.startTokenIndex, "String"
        )
        expect(stringSyntax.methodValues().filter({ _.name == "indexOf" }).count).toBe(3)
        let indexMethods = stringSyntax.methodValues().filter({ _.name == "indexOf" })
        expect(indexMethods[0].parameterValues().count).toBe(6)
        expect(indexMethods[1].parameterValues().count).toBe(6)
        expect(indexMethods[1].parameterValues().first.typeName).toBe("Char[]")
        let trimmed = stringSyntax.methodValues().filter({ _.name == "trimStart" })
        expect(trimmed.count).toBe(3)
        expect(trimmed[1].statements().first.statementKind()).toBe("while")
        expect(trimmed[1].statements().first.range.startTokenIndex).toBe(1080)
        expect(trimmed[1].parameterValues().last.typeName).toBe("Char[]")
        let body = trimmed[1].statements()
        let loopObject = (Object)body.first
        let loop = (PrimitiveWhileSyntax)loopObject
        let conditionObject = (Object)loop.condition
        let condition = (PrimitiveBinarySyntax)conditionObject
        expect(condition.right.expressionKind()).toBe("member-call")
        let callObject = (Object)condition.right
        let call = (PrimitiveMemberCallSyntax)callObject
        expect(call.argumentValues().first.expressionKind()).toBe("array-access")
        expect(stringSyntax.fieldValues().firstOrNull({ _.name == "chars" }).typeName)
            .toBe("StringCharArray")
        let arrayIdentity = "flat/datastruct/list/Array.flat"
        let arraySource = Es6ArtifactFiles.read(File("../Flat-Core/src/flat/datastruct/list/Array.flat"))
        let arrayStream = Lexer().lexInterpolated(arraySource)
        arrayStream.emit("start")
        let arraySnapshot = SourceSnapshotIdentity(SourceIdentity(arrayIdentity), "compiler-input")
        let arrayPartition = FlatSourceTypePartitioner().partition(
            arrayStream.consumeAll<Token>("data"), arraySnapshot, "js"
        ).first
        let arraySyntax = PrimitiveClassParser().parse(
            arrayPartition.tokenValues(), arraySnapshot, arrayPartition.startTokenIndex, "Array"
        )
        let addMethod = arraySyntax.methodValues().firstOrNull({ _.name == "add" })
        expect(addMethod != null).toBe(true)
        let code = FlatEs6PackageLinker().link([
                CompilerSource(
                    "flat/Object.flat",
                    "package flat class Object { Long hashCodeLong => 0 }"
                ),
                CompilerSource(
                    "flat/exception/Exception.flat",
                    "package flat/exception class Exception { " +
                        "construct(String message = \"\") {} }"
                ),
                CompilerSource(
                    "flat/Math.flat",
                    Es6ArtifactFiles.read(File("../Flat-Core/src/flat/Math.flat"))
                ),
                CompilerSource(
                    "flat/primitive/number/Char.flat",
                    Es6ArtifactFiles.read(File(
                        "../Flat-Core/src/flat/primitive/number/Char.flat"
                    ))
                ),
                CompilerSource(
                    "flat/primitive/number/Number.flat",
                    Es6ArtifactFiles.read(File(
                        "../Flat-Core/src/flat/primitive/number/Number.flat"
                    ))
                ),
                CompilerSource(
                    "flat/primitive/Primitive.flat",
                    Es6ArtifactFiles.read(File(
                        "../Flat-Core/src/flat/primitive/Primitive.flat"
                    ))
                ),
                CompilerSource(
                    identity,
                    source
                ),
                CompilerSource(
                    "flat/String.js.flat",
                    Es6ArtifactFiles.read(File("../Flat-Core/src/flat/String.js.flat"))
                ),
                CompilerSource(
                    "flat/datastruct/list/List.flat",
                    Es6ArtifactFiles.read(File("../Flat-Core/src/flat/datastruct/list/List.flat"))
                ),
                CompilerSource(
                    "flat/datastruct/list/OrderedList.flat",
                    Es6ArtifactFiles.read(File("../Flat-Core/src/flat/datastruct/list/OrderedList.flat"))
                ),
                CompilerSource(
                    "flat/datastruct/list/Iterable.flat",
                    Es6ArtifactFiles.read(File("../Flat-Core/src/flat/datastruct/list/Iterable.flat"))
                ),
                CompilerSource(
                    "flat/datastruct/list/Iterator.flat",
                    Es6ArtifactFiles.read(File("../Flat-Core/src/flat/datastruct/list/Iterator.flat"))
                ),
                CompilerSource(
                    "flat/datastruct/list/Array.flat",
                    Es6ArtifactFiles.read(File("../Flat-Core/src/flat/datastruct/list/Array.flat"))
                ),
                CompilerSource(
                    "flat/datastruct/list/Array.js.flat",
                    Es6ArtifactFiles.read(File("../Flat-Core/src/flat/datastruct/list/Array.js.flat"))
                ),
                CompilerSource(
                    "flat/datastruct/list/ArrayIterator.flat",
