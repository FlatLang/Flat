        expect(code.indexOf("extends") >= 0).toBe(true)
    }

    async test `package linker forwards parent constructor message in dependency slice`() {
        let identity = "flat/exception/Exceptions.flat"
        let code = FlatEs6PackageLinker().link([
            CompilerSource(
                identity,
                Es6ArtifactFiles.read(File("test-fixtures/reduced-flat-core-exception.flat"))
            )
        ])
        expect(code.indexOf("super") >= 0).toBe(true)
        expect(code.indexOf("extends ") >= 0).toBe(true)
        let childNameStart = code.lastIndexOf("class ") + 6
        let childNameEnd = code.indexOf(" ", start: childNameStart)
        let childName = code.substring(childNameStart, childNameEnd)
        let root = File(".flat-compiler-exception-slice-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(
            destination,
            code + "let value = new " + childName + "('forwarded');\n" +
                "console.log(value[Object.keys(value)[0]]);\n"
        )
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("forwarded\n")
        Es6ArtifactFiles.remove(root)
    }

    async test `package linker uses default parent message when child omits delegated argument`() {
        let identity = "flat/exception/DefaultExceptions.flat"
        let code = FlatEs6PackageLinker().link([
            CompilerSource(identity,
                "package flat/exception " +
                "class ParentException { visible String message = \"\"; " +
                "constructor(String message = \"\") { this.message = message; } } " +
                "class ChildException extends ParentException { constructor() => super() }")
        ])
        let childNameStart = code.lastIndexOf("class ") + 6
        let childNameEnd = code.indexOf(" ", start: childNameStart)
        let childName = code.substring(childNameStart, childNameEnd)
        let root = File(".flat-compiler-default-exception-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(
            destination,
            code + "let value = new " + childName + "();\n" +
                "console.log(value[Object.keys(value)[0]] === '');\n"
        )
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("true\n")
        Es6ArtifactFiles.remove(root)
    }

    async test `package linker executes mutable expression property storage`() {
        let identity = "flat/test/Counter.flat"
        let source = "package flat/test class Counter { visible var Int count <=> count " +
            "construct(Int initial) { this.count = initial; } " +
            "public read() -> Int { return count; } }"
        let code = FlatEs6PackageLinker().link([CompilerSource(identity, source)])
        let snapshot = SourceSnapshotIdentity(SourceIdentity(identity), "compiler-input")
        let stream = Lexer().lex(source)
        stream.emit("start")
        let syntax = FlatSourceTypePartitioner().partition(
            stream.consumeAll<Token>("data"), snapshot
        ).first
        let type = PrimitiveClassParser().parse(
            syntax.tokenValues(), snapshot, syntax.startTokenIndex, "Counter"
        )
        let typeIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", type.range.startTokenIndex), "class", "Counter"
        )
        let name = Es6NameMangler.mangle(typeIdentity.value)
        let getter = Es6NameMangler.mangle(DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "instance-method", type.methodValues().first.range.startTokenIndex),
            "instance-method", "count"
        ).value)
        let root = File(".flat-compiler-property-storage-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(destination,
            code + "console.log(new " + name + "(7)." + getter + "());\n")
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("7\n")
        Es6ArtifactFiles.remove(root)
    }

