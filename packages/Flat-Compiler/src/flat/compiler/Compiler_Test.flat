        expect(response.stdout.join("")).toBe("No such element\ncustom\ntrue\ntrue\ntrue\n")
        Es6ArtifactFiles.remove(root)
    }

    async test `package linker compiles and executes real Bool inheritance slice`() {
        let identity = "flat/primitive/Bool.flat"
        let code = FlatEs6PackageLinker().link([
            CompilerSource(
                identity,
                Es6ArtifactFiles.read(File("../Flat-Core/src/flat/primitive/Bool.flat"))
            ),
            CompilerSource(
                "flat/primitive/Primitive.flat",
                Es6ArtifactFiles.read(File("../Flat-Core/src/flat/primitive/Primitive.flat"))
            ),
            CompilerSource(
                "flat/primitive/Object.flat",
                Es6ArtifactFiles.read(File("../Flat-Core/src/flat/Object.flat"))
            ),
            CompilerSource(
                "flat/datastruct/Comparable.flat",
                Es6ArtifactFiles.read(File("../Flat-Core/src/flat/datastruct/Comparable.flat"))
            ),
            CompilerSource(
                "flat/primitive/Object.js.flat",
                "package flat class { " +
                "public String hashCode => \"No hashcode available\" " +
                "public static referenceEquals(Object one, Object two) -> Bool { " +
                "return true; } }"
            )
        ])
        let snapshot = SourceSnapshotIdentity(SourceIdentity(identity), "compiler-input")
        let boolType = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", 8), "class", "Bool"
        )
        let boolName = Es6NameMangler.mangle(boolType.value)
        let valueField = Es6NameMangler.mangle(SymbolIdentity(boolType, "field", 0).value)
        let compareToIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "instance-method", 26),
            "instance-method", "compareTo"
        )
        let objectSnapshot = SourceSnapshotIdentity(
            SourceIdentity("flat/primitive/Object.flat"), "compiler-input"
        )
        let toStringIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(objectSnapshot, "instance-method", 17),
            "instance-method", "toString"
        )
        let fromStringIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "static-method", 120),
            "static-method", "fromString"
        )
        let compareToName = Es6NameMangler.mangle(compareToIdentity.value)
        let toStringName = Es6NameMangler.mangle(toStringIdentity.value)
        let fromStringName = Es6NameMangler.mangle(fromStringIdentity.value)
        let root = File(".flat-compiler-bool-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(
            destination,
            code + "let yes = new " + boolName + "(true);\n" +
                "let no = new " + boolName + "(false);\n" +
                "console.log(yes." + valueField + ", no." + valueField + ");\n" +
                "console.log(yes." + compareToName + "(true), yes." +
                    compareToName + "(false));\n" +
                "console.log(yes." + toStringName + "(), no." + toStringName + "());\n" +
                "console.log(" + boolName + "." + fromStringName + "('true'), " +
                    boolName + "." + fromStringName + "('false'));\n" +
                "console.log(yes instanceof " + boolName + ");\n" +
                "console.log(" + boolName + ".__flatType.interfaces[0]);\n"
        )
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe(
            "true false\n0 -1\ntrue false\ntrue false\ntrue\nComparable<Bool>\n"
        )
        Es6ArtifactFiles.remove(root)
    }

    async test `package linker compiles and executes unchanged real Math target source`() {
        let identity = "flat/Math.js.flat"
        let baseIdentity = "flat/Math.flat"
        let source = Es6ArtifactFiles.read(File("../Flat-Core/src/flat/Math.js.flat"))
        let baseSource = Es6ArtifactFiles.read(File("../Flat-Core/src/flat/Math.flat"))
        let code = FlatEs6PackageLinker().link([
            CompilerSource(baseIdentity, baseSource),
            CompilerSource(identity, source)
        ])
        let stream = Lexer().lexInterpolated(source)
        stream.emit("start")
        let tokens = stream.consumeAll<Token>("data")
        let snapshot = SourceSnapshotIdentity(SourceIdentity(identity), "compiler-input")
        let partition = FlatSourceTypePartitioner().partition(tokens, snapshot, "js").first
        let syntax = PrimitiveClassParser().parse(
            partition.tokenValues(), snapshot, partition.startTokenIndex, "Math"
        )
        let typeIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", syntax.range.startTokenIndex),
            "class", "Math"
        )
        let baseStream = Lexer().lexInterpolated(baseSource)
        baseStream.emit("start")
        let baseTokens = baseStream.consumeAll<Token>("data")
        let baseSnapshot = SourceSnapshotIdentity(SourceIdentity(baseIdentity), "compiler-input")
        let basePartition = FlatSourceTypePartitioner().partition(baseTokens, baseSnapshot).first
        let baseSyntax = PrimitiveClassParser().parse(
            basePartition.tokenValues(), baseSnapshot, basePartition.startTokenIndex, "Math"
        )
        let baseTypeIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(baseSnapshot, "class", baseSyntax.range.startTokenIndex),
            "class", "Math"
        )
        let piName = Es6NameMangler.mangle(SymbolIdentity(baseTypeIdentity, "field", 0).value)
        let gcdMethod = baseSyntax.methodValues().firstOrNull({ _.name == "gcd" })
        let gcdName = methodName(baseSnapshot, gcdMethod)
        let className = Es6NameMangler.mangle(baseTypeIdentity.value)
        let sqrtMethod = syntax.methodValues().firstOrNull({ _.name == "sqrt" })
        let roundMethod = syntax.methodValues().firstOrNull({ _.name == "round" })
        let floorMethod = syntax.methodValues().firstOrNull({ _.name == "floor" })
        let sqrtName = methodName(snapshot, sqrtMethod)
        let roundName = methodName(snapshot, roundMethod)
        let floorName = methodName(snapshot, floorMethod)
        let root = File(".flat-compiler-math-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(
            destination,
            code + "console.log(" + className + "." + sqrtName + "(81));\n" +
                "console.log(" + className + "." + roundName + "(2.6));\n" +
                "console.log(" + className + "." + floorName + "(2.9));\n" +
                "console.log(" + className + "." + piName + ");\n" +
                "console.log(" + className + "." + gcdName + "(84, 30));\n"
        )
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("9\n3\n2\n3.141592653\n6\n")
        Es6ArtifactFiles.remove(root)
    }

