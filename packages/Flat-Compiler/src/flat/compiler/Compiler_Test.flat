            SyntaxIslandIdentity(snapshot, "instance-method", method.range.startTokenIndex),
            "instance-method", "identity"
        )
        let run = syntax.methodValues().firstOrNull({ _.name == "run" })
        let runIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "instance-method", run.range.startTokenIndex),
            "instance-method", "run"
        )
        let code = FlatEs6PackageLinker().link([CompilerSource(identity, source)])
        let root = File(".flat-compiler-generic-identity-test-#{Time.currentTimeMillis}")
