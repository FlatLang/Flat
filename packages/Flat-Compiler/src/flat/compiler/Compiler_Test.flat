    async test `package linker incrementally executes selected real Flat Core roots`() {
        let primitiveIdentity = "flat/primitive/Primitive.flat"
        let stackIdentity = "flat/exception/StackTrace.flat"
        let linker = FlatEs6PackageLinker()
        let primitiveCode = linker.link([
            CompilerSource(
                primitiveIdentity,
                Es6ArtifactFiles.read(File("../Flat-Core/src/flat/primitive/Primitive.flat"))
            )
        ])
        let stackCode = linker.link([
            CompilerSource(
                stackIdentity,
                Es6ArtifactFiles.read(File("../Flat-Core/src/flat/exception/StackTrace.flat"))
            )
        ])
        let primitiveSnapshot = SourceSnapshotIdentity(
            SourceIdentity(primitiveIdentity), "compiler-input"
        )
        let stackSnapshot = SourceSnapshotIdentity(SourceIdentity(stackIdentity), "compiler-input")
        let primitiveType = DeclarationIdentity(
            SyntaxIslandIdentity(primitiveSnapshot, "class", 4), "class", "Primitive"
        )
        let stackType = DeclarationIdentity(
            SyntaxIslandIdentity(stackSnapshot, "class", 4), "class", "StackTrace"
        )
        let root = File(".flat-compiler-real-core-roots-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(
            destination,
            primitiveCode + stackCode + "console.log(typeof new " +
                Es6NameMangler.mangle(primitiveType.value) + "(), typeof new " +
                Es6NameMangler.mangle(stackType.value) + "());\n"
        )
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("object object\n")
        Es6ArtifactFiles.remove(root)
    }

    async test `source scoped compilation failure is diagnostic and unrelated source completes`() {
        let result = CompilerTest().compile([
            CompilerSource("bad", "not valid Flat"),
            CompilerSource("good", "value() -> Int { return 3; }")
        ])
        expect(result.artifacts().count).toBe(1)
        expect(result.artifacts().first.identity).toBe("good.js")
        let summary = result.session.completion.get()
        expect(summary.artifactCount).toBe(1)
        expect(summary.diagnosticCount).toBe(1)
    }

    test `session cancellation closes resources and is idempotent`() {
        let session = CompilerSession()
        session.cancel()
        session.cancel()
        expect(session.cancelled).toBe(true)
        expect(session.completion.completed).toBe(true)
        expect(session.artifacts.closed).toBe(true)
    }

    test `filesystem source and atomic spooled artifact sinks preserve deterministic content`() {
        let root = File(".flat-compiler-provider-test-#{Time.currentTimeMillis}")
        let sourceRoot = File(root, "sources")
        let outputRoot = File(root, "output")
        let spoolRoot = File(root, "spool")
        Es6ArtifactFiles.ensureDirectory(sourceRoot)
        let first = File(sourceRoot, "b.flat")
        let second = File(sourceRoot, "a.flat")
        Es6ArtifactFiles.write(first, "B")
        Es6ArtifactFiles.write(second, "A")
        let provider = FilesystemCompilerSourceProvider([first, second])
        expect(provider.identities().first).toBe(second.normalizedLocation)
        expect(provider.load(first.normalizedLocation).text).toBe("B")
        let destination = FilesystemCompilerArtifactSink(outputRoot)
        let spool = SpooledCompilerArtifactSink(spoolRoot, 2)
        spool.write(CompilerArtifact("b.js", "B"))
        spool.write(CompilerArtifact("a.js", "A"))
        spool.commitTo(destination)
        expect(Es6ArtifactFiles.read(File(outputRoot, "a.js"))).toBe("A")
        expect(File(spoolRoot, "a.js.spool").exists).toBe(false)
        expect(destination.artifacts().first.identity).toBe("a.js")
        Es6ArtifactFiles.remove(root)
    }

    test `filesystem and spool sinks reject invalid capacity and duplicate artifacts`() {
        let root = File(".flat-compiler-provider-invalid-#{Time.currentTimeMillis}")
        let spool = SpooledCompilerArtifactSink(root, 1)
        spool.write(CompilerArtifact("a.js", "A"))
        var Int rejected
        try { spool.write(CompilerArtifact("b.js", "B")) } catch (Exception error) { rejected++ }
        try { FilesystemCompilerSourceProvider([File(root, "missing.flat")]) } catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
        Es6ArtifactFiles.remove(root)
    }

    test `can create`() {
        let value = Compiler()

        expect(value).toNotBe(null)
    }
}
