    async test `package linker compiles and executes unchanged Char switch and repeat`() {
        let identity = "flat/primitive/number/Char.flat"
        let source = Es6ArtifactFiles.read(File("../Flat-Core/src/flat/primitive/number/Char.flat"))
        let code = FlatEs6PackageLinker().link([
                CompilerSource(identity, source),
                CompilerSource(
                    "flat/primitive/number/Number.flat",
                    Es6ArtifactFiles.read(File("../Flat-Core/src/flat/primitive/number/Number.flat"))
                ),
                CompilerSource(
                    "flat/primitive/number/Integer.flat",
                    Es6ArtifactFiles.read(File("../Flat-Core/src/flat/primitive/number/Integer.flat"))
                ),
                CompilerSource(
                    "flat/primitive/Primitive.flat",
                    Es6ArtifactFiles.read(File("../Flat-Core/src/flat/primitive/Primitive.flat"))
                )
            ])
        let stream = Lexer().lexInterpolated(source)
        stream.emit("start")
        let tokens = stream.consumeAll<Token>("data")
        let snapshot = SourceSnapshotIdentity(SourceIdentity(identity), "compiler-input")
        let partition = FlatSourceTypePartitioner().partition(tokens, snapshot).first
        let syntax = PrimitiveClassParser().parse(
            partition.tokenValues(), snapshot, partition.startTokenIndex, "Char"
        )
        let typeIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", syntax.range.startTokenIndex),
            "class", "Char"
        )
        var PrimitiveFunctionSyntax whitespace
        var PrimitiveFunctionSyntax repeat
        for (method in syntax.methodValues()) {
            if (method.name == "isWhitespace" && method.staticMethod) whitespace = method
            if (method.name == "repeat" && method.staticMethod) repeat = method
        }
        let className = Es6NameMangler.mangle(typeIdentity.value)
        let whitespaceName = methodName(snapshot, whitespace)
        let repeatName = methodName(snapshot, repeat)
        let root = File(".flat-compiler-char-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(
            destination,
            code + "console.log(" + className + "." + whitespaceName + "(32));\n" +
                "console.log(" + className + "." + whitespaceName + "(120));\n" +
                "console.log(" + className + "." + repeatName + "('a', 3));\n"
        )
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("false\nfalse\naaa\n")
        Es6ArtifactFiles.remove(root)
    }

