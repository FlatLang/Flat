    async test `package linker executes while continue through try catch and finally`() {
        let identity = "memory:while-guarded-continue-execution"
        let source = "class GuardedContinue { public static run(Int mode) -> Int {\n" +
            "var Int i = 0; var Int result = 0;\n" +
            "while (i < 3) {\n" +
            "i++;\ntry {\n" +
            "result = result * 10 + i;\n" +
            "if (mode == 0) { continue; }\n" +
            "if (mode == 1) { throw \"stop\"; }\n" +
            "} catch (String error) {\n" +
            "result = result * 10 + 4; continue;\n" +
            "} finally {\n" +
            "result = result * 10 + 5;\n" +
            "if (mode == 2) { continue; }\n" +
            "}\nresult = result * 10 + 6;\n" +
            "}\nreturn result;\n} }"
        let snapshot = SourceSnapshotIdentity(SourceIdentity(identity), "compiler-input")
        let stream = Lexer().lex(source)
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let owner = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", syntax.range.startTokenIndex), "class", "GuardedContinue")
        let method = syntax.methodValues().firstOrNull({ _.name == "run" })
        let methodIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "static-method", method.range.startTokenIndex), "static-method", "run")
        let code = FlatEs6PackageLinker().link([CompilerSource(identity, source)])
        let call = Es6NameMangler.mangle(owner.value) + "." + Es6NameMangler.mangle(methodIdentity.value)
        let root = File(".flat-compiler-while-guarded-continue-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(destination, code +
            "console.log(" + call + "(0));\n" +
            "console.log(" + call + "(1));\n" +
            "console.log(" + call + "(2));\n" +
            "console.log(" + call + "(3));\n")
        let response = System.execute(["node", destination.normalizedLocation], silent: true, shell: false)
        Es6ArtifactFiles.remove(root)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        // Finally executes on every path; continue skips the post-try digit only.
        expect(response.stdout.join("")).toBe("152535\n145245345\n152535\n156256356\n")
    }

    async test `package linker executes foreach inside switch and exception containers once in order`() {
        let identity = "memory:container-foreach-execution"
        let source = "class ContainerLoops {\n" +
            "public static switched(Int mode) -> Int {\n" +
            "var Int result = 0;\n" +
            "switch mode {\n" +
            "0 => for (i in 0..3) result = result * 10 + i + 1;\n" +
            "default => for (i in 3..5) result = result * 10 + i + 1;\n" +
            "}\nreturn result;\n}\n" +
            "public static guarded(Bool fail) -> Int {\n" +
            "var Int result = 0;\n" +
            "try {\n" +
            "for (i in 0..3) { result = result * 10 + i + 1; " +
            "if (fail && i == 1) { throw \"stop\"; } }\n" +
            "} catch (String error) {\n" +
            "for (i in 2..4) { result = result * 10 + i + 1; }\n" +
            "} finally {\n" +
            "for (i in 4..6) { result = result * 10 + i + 1; }\n" +
            "}\nreturn result;\n}\n}"
        let snapshot = SourceSnapshotIdentity(SourceIdentity(identity), "compiler-input")
        let stream = Lexer().lex(source)
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let owner = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", syntax.range.startTokenIndex), "class", "ContainerLoops")
        let switched = syntax.methodValues().firstOrNull({ _.name == "switched" })
        let guarded = syntax.methodValues().firstOrNull({ _.name == "guarded" })
        let switchedIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "static-method", switched.range.startTokenIndex), "static-method", "switched")
        let guardedIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "static-method", guarded.range.startTokenIndex), "static-method", "guarded")
        let code = FlatEs6PackageLinker().link([CompilerSource(identity, source)])
        let ownerName = Es6NameMangler.mangle(owner.value)
        let switchedCall = ownerName + "." + Es6NameMangler.mangle(switchedIdentity.value)
        let guardedCall = ownerName + "." + Es6NameMangler.mangle(guardedIdentity.value)
        let root = File(".flat-compiler-container-foreach-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(destination, code +
            "console.log(" + switchedCall + "(0));\n" +
            "console.log(" + switchedCall + "(1));\n" +
            "console.log(" + guardedCall + "(false));\n" +
            "console.log(" + guardedCall + "(true));\n")
        let response = System.execute(["node", destination.normalizedLocation], silent: true, shell: false)
        Es6ArtifactFiles.remove(root)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        // Digits expose skipped, duplicated, reordered, or incorrectly resumed iterations.
        expect(response.stdout.join("")).toBe("123\n45\n12356\n123456\n")
    }

