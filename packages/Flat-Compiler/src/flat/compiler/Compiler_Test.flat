        let arrayPartition = FlatSourceTypePartitioner().partition(
            arrayStream.consumeAll<Token>("data"), arraySnapshot, "js"
        ).first
        let arraySyntax = PrimitiveClassParser().parse(
            arrayPartition.tokenValues(), arraySnapshot, arrayPartition.startTokenIndex, "Array"
        )
        let addMethod = arraySyntax.methodValues().firstOrNull({ _.name == "add" })
        expect(addMethod != null).toBe(true)
        let code = FlatEs6PackageLinker().link(realCoreExecutionSources([
                CompilerSource(
                    "flat/Object.flat",
                    Es6ArtifactFiles.read(File("../Flat-Core/src/flat/Object.flat"))
                ),
                CompilerSource(
                    "flat/exception/Exception.flat",
                    Es6ArtifactFiles.read(File("../Flat-Core/src/flat/exception/Exception.flat"))
                ),
                CompilerSource(
                    "flat/Math.flat",
                    Es6ArtifactFiles.read(File("../Flat-Core/src/flat/Math.flat"))
                ),
                CompilerSource(
                    "flat/primitive/number/Char.flat",
                    Es6ArtifactFiles.read(File(
                        "../Flat-Core/src/flat/primitive/number/Char.flat"
                    ))
                ),
                CompilerSource(
                    "flat/primitive/number/Number.flat",
                    Es6ArtifactFiles.read(File(
                        "../Flat-Core/src/flat/primitive/number/Number.flat"
                    ))
                ),
                CompilerSource(
                    "flat/primitive/Primitive.flat",
                    Es6ArtifactFiles.read(File(
                        "../Flat-Core/src/flat/primitive/Primitive.flat"
                    ))
                ),
                CompilerSource(
                    identity,
                    source
                ),
                CompilerSource(
                    "flat/String.js.flat",
                    Es6ArtifactFiles.read(File("../Flat-Core/src/flat/String.js.flat"))
                ),
                CompilerSource(
                    "flat/datastruct/list/List.flat",
                    Es6ArtifactFiles.read(File("../Flat-Core/src/flat/datastruct/list/List.flat"))
                ),
                CompilerSource(
                    "flat/datastruct/list/OrderedList.flat",
                    Es6ArtifactFiles.read(File("../Flat-Core/src/flat/datastruct/list/OrderedList.flat"))
                ),
                CompilerSource(
