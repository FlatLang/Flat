            Es6NameMangler.mangle(methodIdentity.value)
        Es6ArtifactCommitter().commit(destination, code +
            "let calls = 0; const next = x => { calls++; return x + 1; };\n" +
            "console.log(" + callable + "(), " + callable + "(9), " + callable +
            "(9, next), " + callable + "(9, next, 7), calls);\n" +
            "let failures = 0; const failure = new Error('callback failure');\n" +
            "try { " + callable + "(1, () => { failures++; throw failure; }); } " +
            "catch (error) { if (error !== failure) throw error; }\n" +
            "console.log(failures, " + callable + "());\n")
