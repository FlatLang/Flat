package flat/compiler

import flat/compiler/Compiler
import flat/io
import flat/system
import flat/time/Time
import flat/compiler/models
import flat/lexer
import flat/parser/flat
import flat/writer/es6/bound
import flat/eventstream
import flat/future
import flat/semantic/binding/primitive/PrimitiveDefaultImport

testable class {
    test `terminal evidence serializes real reuse fields with bounded JSON escaping`() {
        let summary = CompilationSummary(3, 1, 0, false, reuse:
            CompilerReuseEvidence(true, "exact-hit", 3, 0, 0, 0, "tool\"\\\n"),
            peakActiveSourceReads: 2, peakRetainedSourceReads: 2)
        let receipt = CompilerEvidence.render(summary)
        expect(receipt.contains("\"schema\":\"flat.compiler.session.v1\"")).toBe(true)
        expect(receipt.contains("\"peakActiveSourceReads\":2")).toBe(true)
        expect(receipt.contains("\"scope\":\"exact-in-process-package\"")).toBe(true)
        let batch = CompilerEvidence.renderDiagnostics(summary, "sha256:test-input")
        expect(batch.contains("\"schema\":\"flat.compiler.diagnostics.v1\"")).toBe(true)
        expect(batch.contains("\"revision\":\"sha256:test-input\"")).toBe(true)
        expect(batch.contains("\"complete\":true,\"records\":[]")).toBe(true)
        let cancelledBatch = CompilerEvidence.renderDiagnostics(CompilationSummary(1, 0, 0, true), "cancelled-input")
        expect(cancelledBatch.contains("\"complete\":false")).toBe(true)
        let unknown = CompilerEvidence.renderDiagnostics(CompilationSummary(1, 0, 1, false, "untyped failure"), "failed-input")
        expect(unknown.contains("\"complete\":false")).toBe(true)
        expect(receipt.contains("\"reused\":true")).toBe(true)
        expect(receipt.contains("\"diagnostics\":{\"complete\":true,\"records\":[]}")).toBe(true)
        expect(receipt.contains("\"toolFingerprint\":\"tool\\\"\\\\\\u000a\"")).toBe(true)
    }

    async test `default package closure compiles more than 64 sources without truncation`() {
        let values = CompilerSource[]
        for (index in 0..70) values.add(CompilerSource("Value#{index}.flat", "class Value#index {}"))
        let sink = MemoryCompilerArtifactSink()
        let summary = CompilerEngine(maxActiveSources: 2).compilePackage(
            MemoryCompilerSourceProvider(values), sink, "closure.js").completion.get()
        expect(summary.sourceCount).toBe(70)
        expect(summary.artifactCount).toBe(1)
        expect(summary.diagnosticCount).toBe(0)
        expect(summary.peakRetainedSourceReads).toBe(2)
        expect(sink.artifacts().count).toBe(1)
    }

    async test `ES6 target overlay wins after shared JS overlay independent of provider order`() {
        let values = [
            CompilerSource("app/Main.es6.flat", "package app\nclass Main { public static main() { external js { console.log('es6'); } } }"),
            CompilerSource("app/Main.js.flat", "package app\nclass Main { public static main() { external js { console.log('js'); } } }"),
            CompilerSource("app/Main.flat", "package app\nclass Main { public static main() { external js { console.log('base'); } } }")
        ]
        let sink = MemoryCompilerArtifactSink()
        let summary = CompilerEngine(maxActiveSources: 2).compilePackage(
            MemoryCompilerSourceProvider(values), sink, "program.js", "app/Main").completion.get()
        expect(summary.diagnosticCount).toBe(0)
        expect(summary.artifactCount).toBe(1)
        let root = File(".flat-es6-overlay-execution-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        try {
            let output = File(root, "program.js")
            Es6ArtifactFiles.write(output, sink.artifacts().first.code)
            let response = System.execute(["node", output.normalizedLocation], silent: true, shell: false)
            expect(response.exitCode).toBe(0)
            expect(response.stdout.join("")).toBe("es6\n")
        } finally { Es6ArtifactFiles.remove(root) }
    }

    class FailingPackageProvider extends CompilerSourceProvider {
        visible Future.CompletableFuture<Bool> gate = Future.create<Bool>()
        visible var Int reads
        visible var Bool secondSettled
        override public identities() -> String[] {
            String[] values = ["A.flat", "B.flat", "C.flat"]
            return values
        }
        override public async load(String identity) -> CompilerSource {
            reads++
            if (identity == "A.flat") throw Exception("controlled source read failure")
            if (identity == "B.flat") {
                try { gate.get() } finally { secondSettled = true }
            }
            return CompilerSource(identity, "class B {}")
        }
    }

    async test `package failure settles all admitted reads without publishing or admitting later sources`() {
        let provider = FailingPackageProvider()
        let sink = MemoryCompilerArtifactSink()
        let pending = Future.from<CompilerSession>(async {
            return CompilerEngine(maxActiveSources: 2).compilePackage(provider, sink, "failed.js")
        })$
        expect(provider.reads).toBe(2)
        expect(provider.secondSettled).toBe(false)
        provider.gate.complete(true)
        let summary = pending.get().completion.get()
        expect(summary.diagnosticCount).toBe(1)
        expect(summary.artifactCount).toBe(0)
        expect(summary.cleanupSettled).toBe(true)
        expect(provider.secondSettled).toBe(true)
        expect(provider.reads).toBe(2)
        expect(sink.artifacts().count).toBe(0)
    }

    class GatedPackageProvider extends CompilerSourceProvider {
        visible Future.CompletableFuture<Bool> firstGate = Future.create<Bool>()
        visible Future.CompletableFuture<Bool> secondGate = Future.create<Bool>()
        visible var Int reads
        visible var Int settled
        override public identities() -> String[] {
            String[] values = ["A.flat", "B.flat", "C.flat"]
            return values
        }
        override public async load(String identity) -> CompilerSource {
            reads++
            try {
                if (identity == "A.flat") firstGate.get()
                if (identity == "B.flat") secondGate.get()
                return CompilerSource(identity, "class #{identity.substring(0, 1)} {}")
            } finally { settled++ }
        }
    }

    async test `package read overlap is bounded and cancellation completion awaits admitted reads`() {
        let Int[] capacities = [1, 2]
        for (capacity in capacities) {
            let provider = GatedPackageProvider()
            let session = CompilerSession()
            let sink = MemoryCompilerArtifactSink()
            let engine = CompilerEngine(maxActiveSources: capacity)
            engine.startPackage(provider, sink, "cancelled.js", session)
            expect(provider.reads).toBe(capacity)
            session.cancel()
            expect(session.completion.completed).toBe(false)
            provider.firstGate.complete(true)
            if (capacity == 2) expect(session.completion.completed).toBe(false)
            provider.secondGate.complete(true)
            let summary = session.completion.get()
            Console.log(CompilerEvidence.render(summary, "package-read-cancel-capacity-#capacity"))
            expect(summary.cancelled).toBe(true)
            expect(summary.cleanupSettled).toBe(true)
            expect(provider.settled).toBe(capacity)
            expect(provider.reads).toBe(capacity)
            expect(sink.artifacts().count).toBe(0)
            expect(summary.peakActiveSourceReads).toBe(capacity)
            expect(summary.peakRetainedSourceReads).toBe(capacity)
        }
    }

    async test `reverse read completion preserves package artifact across capacities`() {
        var String expected
        let Int[] capacities = [1, 2]
        for (capacity in capacities) {
            let provider = GatedPackageProvider()
            let sink = MemoryCompilerArtifactSink()
            let engine = CompilerEngine(maxActiveSources: capacity)
            let pending = Future.from<CompilerSession>(async {
                return engine.compilePackage(provider, sink, "ordered.js")
            })$
            expect(provider.reads).toBe(capacity)
            provider.secondGate.complete(true)
            provider.firstGate.complete(true)
            let summary = pending.get().completion.get()
            Console.log(CompilerEvidence.render(summary, "package-read-reverse-capacity-#capacity"))
            expect(summary.diagnosticCount).toBe(0)
            expect(summary.artifactCount).toBe(1)
            expect(summary.cleanupSettled).toBe(true)
            expect(summary.peakActiveSourceReads).toBe(capacity)
            let code = sink.artifacts().first.code
            if (expected == null) expected = code
            else expect(code).toBe(expected)
        }
    }

    class DefaultImportLinker extends FlatEs6PackageLinker {
        visible var String observedLocation
        visible var Bool observedStatic
        visible var Int observedCount
        public construct() => super(maxSources: 64, maxSourceCharacters: 65536,
            maxTokensPerSource: 8192, maxTypes: 256, maxFragments: 256)

        override public async linkSources(
            CompilerSourceProvider provider, String[] identities,
            DeclarationIdentity arrayDeclaration = null, String mainClass = null,
            PrimitiveDefaultImport[] defaultImports = PrimitiveDefaultImport[]
        ) -> String {
            observedCount = defaultImports.count
            if (observedCount > 0) {
                observedLocation = defaultImports.first.location
                observedStatic = defaultImports.first.staticImport
            }
            return "// default import forwarding\n"
        }
    }

    async test `package facade snapshots default import configuration before executor admission`() {
        let executor = ControlledExecutor(1)
        let linker = DefaultImportLinker()
        let compiler = Compiler(CompilerEngine(executor: executor, packageLinker: linker))
        let location = "flat/Math".concat("")
        let defaults = [PrimitiveDefaultImport(location, true)]
        let sink = MemoryCompilerArtifactSink()
        let provider = MemoryCompilerSourceProvider([CompilerSource("Main.flat", "class Main {}")])
        let pending = Future.from<CompilerSession>(async {
            return compiler.compilePackage(provider, sink, "main.js", defaultImports: defaults)
        })$
        expect(executor.queuedCount).toBe(1)
        location.chars[0] = 'x'
        defaults[0] = PrimitiveDefaultImport("other/Type")
        executor.runNext()
        expect(pending.get().completion.get().artifactCount).toBe(1)
        expect(linker.observedCount).toBe(1)
        expect(linker.observedLocation).toBe("flat/Math")
        expect(linker.observedStatic).toBe(true)
    }

    class CapturedMainLinker extends FlatEs6PackageLinker {
        visible var Int calls
        visible var String observedMain
        public construct() => super(maxSources: 64, maxSourceCharacters: 65536,
            maxTokensPerSource: 8192, maxTypes: 256, maxFragments: 256)

        override public async linkSources(
            CompilerSourceProvider provider, String[] identities,
            DeclarationIdentity arrayDeclaration = null, String mainClass = null,
            PrimitiveDefaultImport[] defaultImports = PrimitiveDefaultImport[]
        ) -> String {
            calls++
            observedMain = mainClass.concat("")
            return "// captured main #mainClass\n"
        }
    }

    async test `queued regular package owns entrypoint and artifact identity storage`() {
        let executor = ControlledExecutor(1)
        let linker = CapturedMainLinker()
        let engine = CompilerEngine(executor: executor, packageLinker: linker)
        let main = "app/Main".concat("")
        let destination = "main.js".concat("")
        let sink = MemoryCompilerArtifactSink()
        let session = CompilerSession()
        engine.startPackage(MemoryCompilerSourceProvider([
            CompilerSource("app/Main.flat", "class Main {}")
        ]), sink, destination, session, main)
        expect(executor.queuedCount).toBe(1)
        main.chars[0] = 'x'
        destination.chars[0] = 'x'
        executor.runNext()
        expect(session.completion.get().diagnosticCount).toBe(0)
        expect(linker.observedMain).toBe("app/Main")
        expect(sink.artifacts().first.identity).toBe("main.js")
        expect(session.artifacts.receive().value.identity).toBe("main.js")
        expect(session.artifacts.receive().completed).toBe(true)
    }

    class MismatchedSourceProvider extends CompilerSourceProvider {
        override public identities() -> String[] {
            let values = String[]
            values.add("a")
            values.add("b")
            return values
        }
        override public async load(String identity) -> CompilerSource {
            return CompilerSource(identity == "a" ? "wrong" : "b",
                "value() -> Int { return 1; }")
        }
    }

    async test `mismatched loaded source identity fails locally at one and two active sources`() {
        for (parallel in 1..3) {
            let sink = MemoryCompilerArtifactSink()
            let session = CompilerEngine(maxActiveSources: parallel).compile(MismatchedSourceProvider(), sink)
            let summary = session.completion.get()
            expect(summary.artifactCount).toBe(1)
            expect(summary.diagnosticCount).toBe(1)
            expect(summary.cancelled).toBe(false)
            expect(summary.packageDiagnostic).toBe(
                "Failed to compile 'a': Loaded source identity does not match 'a'")
            expect(sink.artifacts().count).toBe(1)
            expect(sink.artifacts().first.identity).toBe("b.js")
            expect(session.activeSourceCount).toBe(0)
            expect(session.inFlightSourceCount).toBe(0)
            expect(session.retainedSourceCount).toBe(0)
        }
    }

    async test `queued snapshot linking retains entrypoint after caller storage mutation`() {
        let executor = ControlledExecutor(1)
        let linker = CapturedMainLinker()
        let engine = CompilerEngine(executor: executor, packageLinker: linker,
            packageReuse: CompilerPackageReuse())
        let main = "app/Main".concat("")
        let sources = [CompilerSource("app/Main.flat", "class Main {}")]
        let sink = MemoryCompilerArtifactSink()
        let pending = Future.from<CompilerSession>(async {
            return engine.compilePackageSnapshots(sources, sink, "first.js", main)
        })$
        expect(executor.queuedCount).toBe(1)
        main.chars[0] = 'x'
        executor.runNext()
        expect(pending.get().completion.get().diagnosticCount).toBe(0)
        expect(linker.observedMain).toBe("app/Main")
        expect(linker.calls).toBe(1)
        let hitSink = MemoryCompilerArtifactSink()
        let hit = Future.from<CompilerSession>(async {
            return engine.compilePackageSnapshots(sources, hitSink, "hit.js", "app/Main")
        })$
        executor.runNext()
        expect(hit.get().completion.get().artifactCount).toBe(1)
        expect(linker.calls).toBe(1)
        expect(hitSink.artifacts().first.code).toBe(sink.artifacts().first.code)
    }

    class GatedSourceCompiler extends FlatEs6SourceCompiler {
        visible Future<Bool>[] gates = Future<Bool>[]
        visible Future<Bool>[] readiness = Future<Bool>[]
        visible var Int entered
        visible var Int cleaned
        public construct() {
            gates.add(Future.create<Bool>())
            gates.add(Future.create<Bool>())
            readiness.add(Future.create<Bool>())
            readiness.add(Future.create<Bool>())
        }
        override public async compile(CompilerSource source) -> String {
            entered++
            try {
                let index = source.identity == "a" ? 0 : 1
                Future.CompletableFuture<Bool> ready = (Future.CompletableFuture<Bool>)readiness[index]
                if (!ready.completed) ready.complete(true)
                gates[index].get()
                if (source.text == "bad") throw Exception("controlled source failure")
                return "// #{source.identity}\n"
            } finally { cleaned++ }
        }
        public release(Int index) {
            Future.CompletableFuture<Bool> gate = (Future.CompletableFuture<Bool>)gates[index]
            if (!gate.completed) gate.complete(true)
        }
        public async awaitEntered(Int index) { readiness[index].get() }
        public async finish(CompilerSession session) {
            session.cancel()
            release(0)
            release(1)
            session.completion.get()
        }
    }

    async test `bounded source scheduler emits unrelated B while A is gated`() {
        let compiler = GatedSourceCompiler()
        let session = CompilerSession()
        let sink = MemoryCompilerArtifactSink()
        CompilerEngine(sourceCompiler: compiler, maxActiveSources: 2, maxQueuedSources: 1).start(
            MemoryCompilerSourceProvider([CompilerSource("a", "ok"), CompilerSource("b", "ok")]),
            sink, session
        )
        try {
            compiler.awaitEntered(0)
            compiler.awaitEntered(1)
            compiler.release(1)
        expect(session.artifacts.receive().value.identity).toBe("b.js")
        expect(sink.artifacts().first.identity).toBe("b.js")
        expect(session.retainedSourceCodeCharacters).toBe(0)
        expect(session.completion.completed).toBe(false)
        expect(compiler.cleaned).toBe(1)
        compiler.release(0)
        expect(session.artifacts.receive().value.identity).toBe("a.js")
        expect(session.completion.get().artifactCount).toBe(2)
        expect(session.peakActiveSourceCount <= 2).toBe(true)
        expect(session.peakRetainedSourceCount <= 3).toBe(true)
        expect(session.retainedSourceCount).toBe(0)
        } finally { compiler.finish(session) }
    }

    async test `source cancellation releases pending payloads before running cleanup finishes`() {
        let executor = ControlledExecutor(8)
        let compiler = GatedSourceCompiler()
        let session = CompilerSession()
        let sink = MemoryCompilerArtifactSink()
        let sources = CompilerSource[]
        sources.add(CompilerSource("a", "ok"))
        for (index in 0..7) sources.add(CompilerSource("b#index", "ok"))
        CompilerEngine(executor: executor, sourceCompiler: compiler,
            maxActiveSources: 8, maxQueuedSources: 1).start(
            MemoryCompilerSourceProvider(sources), sink, session)
        let runningA = Future.from<ExecutorTaskResult>(async { return executor.runNext() })$
        try {
            compiler.awaitEntered(0)
            compiler.release(1)
        for (index in 0..7) executor.runNext()
        session.artifactBackpressure.get()
        expect(session.retainedSourceCodeCharacters > 0).toBe(true)
        session.cancel()
        expect(session.retainedSourceCodeCharacters).toBe(0)
        expect(session.completion.completed).toBe(false)
        expect(compiler.cleaned).toBe(7)
        compiler.release(0)
        runningA.get()
        let summary = session.completion.get()
        expect(summary.cancelled).toBe(true)
        expect(summary.artifactCount).toBe(5)
        expect(compiler.cleaned).toBe(8)
        expect(session.retainedSourceCount).toBe(0)
        expect(session.inFlightSourceCount).toBe(0)
        expect(session.retainedSourceCodeCharacters).toBe(0)
        for (index in 0..4) {
            let received = session.artifacts.receive()
            expect(received.value.identity).toBe("b#{index}.js")
            expect(received.value.code).toBe("// b#{index}\n")
        }
        expect(session.artifacts.receive().completed).toBe(true)
        } finally {
            compiler.finish(session)
            runningA.get()
        }
    }

    class ThrowAfterEntryExecutor extends Executor {
        override public submit(async action()) -> Future<ExecutorTaskResult> {
            action()$
            throw Exception("controlled submission failure after entry")
        }
    }

    class SubmissionSourceProvider extends CompilerSourceProvider {
        visible var Int entered
        visible var Int cleaned
        visible Future.CompletableFuture<Bool> enteredRead = Future.create<Bool>()
        visible Future.CompletableFuture<Bool> releaseRead = Future.create<Bool>()
        public construct(visible CompilerSession session, visible Bool cancelOnRead = false) {}
        override public identities() -> String[] {
            String[] values = ["a", "b"]
            return values
        }
        override public async load(String identity) -> CompilerSource {
            entered++
            try {
                if (cancelOnRead) session.cancel()
                enteredRead.complete(true)
                releaseRead.get()
                return CompilerSource(identity, "ok")
            } finally { cleaned++ }
        }
        public async finish() {
            session.cancel()
            if (!releaseRead.completed) releaseRead.complete(true)
            session.completion.get()
        }
    }

    async test `source submission failure after entry waits for cleanup at one and two reservations`() {
        for (capacity in 1..3) {
            let compiler = GatedSourceCompiler()
            let session = CompilerSession()
            let provider = SubmissionSourceProvider(session)
            let sink = MemoryCompilerArtifactSink()
            try {
                CompilerEngine(executor: ThrowAfterEntryExecutor(), sourceCompiler: compiler,
                    maxActiveSources: capacity).start(provider, sink, session)
                provider.enteredRead.get()
                expect(provider.entered).toBe(1)
                expect(provider.cleaned).toBe(0)
                expect(session.completion.completed).toBe(false)
                provider.releaseRead.complete(true)
                let summary = session.completion.get()
                expect(provider.cleaned).toBe(1)
                // Submission failure cancels during the admitted read, before compile.
                expect(compiler.entered).toBe(0)
                expect(compiler.cleaned).toBe(0)
                expect(summary.cancelled).toBe(true)
                expect(summary.packageDiagnostic).toBe("controlled submission failure after entry")
                expect(summary.artifactCount).toBe(0)
                expect(session.inFlightSourceCount).toBe(0)
            } finally {
                compiler.release(0)
                compiler.release(1)
                provider.finish()
            }
        }
    }

    class SubmissionGateLinker extends FlatEs6PackageLinker {
        visible var Bool entered
        visible var Bool cleaned
        visible var Bool cleanupEntered
        visible Future.CompletableFuture<Bool> cleanupStarted = Future.create<Bool>()
        public construct(visible Future<Bool> gate, visible Bool fail = false,
            visible Future<Bool> cleanupGate = null) =>
            super(maxSources: 64, maxSourceCharacters: 65536, maxTokensPerSource: 8192,
                maxTypes: 256, maxFragments: 256)
        override public async linkSources(CompilerSourceProvider provider, String[] identities,
            DeclarationIdentity arrayDeclaration = null, String mainClass = null,
            PrimitiveDefaultImport[] defaultImports = PrimitiveDefaultImport[]) -> String {
            entered = true
            try {
                gate.get()
                if (fail) throw Exception("controlled callback failure")
                return "// linked\n"
            } finally {
                cleanupEntered = true
                cleanupStarted.complete(true)
                if (cleanupGate) cleanupGate.get()
                cleaned = true
            }
        }
    }

    async test `package adapter submission throw waits for callback settlement and preserves submission failure`() {
        for (failureMode in 0..2) {
            Future.CompletableFuture<Bool> gate = Future.create<Bool>()
            Future.CompletableFuture<Bool> cleanupGate = Future.create<Bool>()
            let linker = SubmissionGateLinker(gate, failureMode == 1, cleanupGate)
            let engine = CompilerEngine(executor: ThrowAfterEntryExecutor(), packageLinker: linker)
            let sources = CompilerSource[]
            sources.add(CompilerSource("Value.flat", "class Value {}"))
            let pending = Future.from<CompilerSession>(async {
                return engine.compilePackage(MemoryCompilerSourceProvider(sources),
                    MemoryCompilerArtifactSink(), "library.js")
            })$
            try {
                expect(linker.entered).toBe(true)
                expect(pending.completed).toBe(false)
                gate.complete(true)
                linker.cleanupStarted.get()
                expect(pending.completed).toBe(false)
                expect(linker.cleaned).toBe(false)
            } finally {
                if (!gate.completed) gate.complete(true)
                if (!cleanupGate.completed) cleanupGate.complete(true)
            }
            let summary = pending.get().completion.get()
            expect(linker.cleanupEntered).toBe(true)
            expect(linker.cleaned).toBe(true)
            expect(summary.cancelled).toBe(true)
            expect(summary.packageDiagnostic).toBe("controlled submission failure after entry")
            expect(summary.artifactCount).toBe(0)
            let terminalAgain = pending.get().completion.get()
            expect(terminalAgain.diagnosticCount).toBe(summary.diagnosticCount)
            expect(terminalAgain.packageDiagnostic).toBe(summary.packageDiagnostic)
        }
    }

    async test `source scheduler queued cancellation waits for active cleanup`() {
        let compiler = GatedSourceCompiler()
        let session = CompilerSession()
        let sink = MemoryCompilerArtifactSink()
        CompilerEngine(sourceCompiler: compiler, maxActiveSources: 1, maxQueuedSources: 1).start(
            MemoryCompilerSourceProvider([CompilerSource("a", "ok"), CompilerSource("b", "ok")]),
            sink, session
        )
        try {
            compiler.awaitEntered(0)
            expect(session.queuedSourceCount).toBe(1)
            expect(session.retainedSourceCount).toBe(2)
            session.cancel()
            expect(session.completion.completed).toBe(false)
            compiler.release(0)
            expect(session.completion.get().cancelled).toBe(true)
            expect(compiler.entered).toBe(1)
            expect(compiler.cleaned).toBe(1)
            expect(sink.artifacts().count).toBe(0)
            expect(session.activeSourceCount).toBe(0)
            expect(session.queuedSourceCount).toBe(0)
        } finally { compiler.finish(session) }
    }

    async test `source scheduler isolates failure and orders diagnostics across reversed schedules`() {
        for (parallel in 1..3) {
            let compiler = GatedSourceCompiler()
            let session = CompilerSession()
            let diagnostics = session.diagnostics.subscribe(2)
            let sink = MemoryCompilerArtifactSink()
            CompilerEngine(sourceCompiler: compiler, maxActiveSources: parallel).start(
                MemoryCompilerSourceProvider([CompilerSource("b", "bad"), CompilerSource("a", "bad")]),
                sink, session
            )
            try {
                compiler.release(1)
                compiler.release(0)
            expect(diagnostics.receive().value).toBe("Failed to compile 'a': controlled source failure")
            expect(diagnostics.receive().value).toBe("Failed to compile 'b': controlled source failure")
            let summary = session.completion.get()
            expect(summary.diagnosticCount).toBe(2)
            expect(summary.packageDiagnostic).toBe("Failed to compile 'b': controlled source failure")
            expect(compiler.cleaned).toBe(2)
            } finally {
                session.diagnostics.unsubscribe(diagnostics)
                compiler.finish(session)
            }
        }
    }

    async test `source failure does not prevent unrelated artifact and engine reuse`() {
        let compiler = GatedSourceCompiler()
        let engine = CompilerEngine(sourceCompiler: compiler, maxActiveSources: 2)
        let session = CompilerSession()
        let sink = MemoryCompilerArtifactSink()
        engine.start(MemoryCompilerSourceProvider([
            CompilerSource("a", "bad"), CompilerSource("b", "ok")
        ]), sink, session)
        try {
            compiler.release(1)
            expect(session.artifacts.receive().value.identity).toBe("b.js")
            compiler.release(0)
            expect(session.completion.get().diagnosticCount).toBe(1)
        } finally { compiler.finish(session) }
        let secondSink = MemoryCompilerArtifactSink()
        let second = engine.compile(MemoryCompilerSourceProvider([CompilerSource("b", "ok")]), secondSink)
        expect(second.completion.get().artifactCount).toBe(1)
        expect(second.completion.get().diagnosticCount).toBe(0)
        expect(secondSink.artifacts().first.code).toBe(sink.artifacts().first.code)
    }

    async test `source artifact content is deterministic at one and two active sources`() {
        var String expected = null
        for (parallel in 1..3) {
            let compiler = GatedSourceCompiler()
            let session = CompilerSession()
            let sink = MemoryCompilerArtifactSink()
            CompilerEngine(sourceCompiler: compiler, maxActiveSources: parallel, maxQueuedSources: 1).start(
                MemoryCompilerSourceProvider([CompilerSource("b", "ok"), CompilerSource("a", "ok")]),
                sink, session
            )
            try {
                compiler.release(1)
            if (parallel > 1) {
                expect(session.artifacts.receive().value.identity).toBe("b.js")
                expect(session.completion.completed).toBe(false)
            }
            compiler.release(0)
            expect(session.artifacts.receive().value.identity).toBe("a.js")
            if (parallel == 1) expect(session.artifacts.receive().value.identity).toBe("b.js")
            expect(session.completion.get().artifactCount).toBe(2)
            let artifacts = sink.artifacts()
            let actual = artifacts.map((artifact) => artifact.identity + ":" + artifact.code).join("|")
            if (expected != null) expect(actual).toBe(expected)
            expected = actual
            expect(session.peakActiveSourceCount <= parallel).toBe(true)
            expect(session.peakRetainedSourceCount <= parallel + 1).toBe(true)
            expect(session.inFlightSourceCount).toBe(0)
            } finally { compiler.finish(session) }
        }
    }

    async test `concurrent source backpressure bounds retained outcomes and pending publication`() {
        let sources = CompilerSource[]
        for (index in 0..9) {
            sources.add(CompilerSource("source#index", "value() -> Int { return 1; }"))
        }
        let session = CompilerSession()
        let sink = MemoryCompilerArtifactSink()
        CompilerEngine(maxActiveSources: 2, maxQueuedSources: 1).start(
            MemoryCompilerSourceProvider(sources), sink, session
        )
        session.artifactBackpressure.get()
        expect(session.artifacts.bufferedCount).toBe(4)
        expect(session.artifacts.pendingSendCount).toBe(1)
        expect(session.retainedSourceCount <= 3).toBe(true)
        expect(session.peakRetainedSourceCount <= 3).toBe(true)
        expect(session.peakActiveSourceCount <= 2).toBe(true)
        expect(sink.artifacts().count).toBe(5)
        for (index in 0..9) expect(session.artifacts.receive().received).toBe(true)
        expect(session.completion.get().artifactCount).toBe(9)
        expect(session.retainedSourceCount).toBe(0)
        expect(session.inFlightSourceCount).toBe(0)
        expect(session.artifacts.pendingSendCount).toBe(0)
    }

    async test `source scheduler cancels executor queued actions without cancelling running cleanup`() {
        let executor = ControlledExecutor(2)
        let compiler = GatedSourceCompiler()
        let session = CompilerSession()
        CompilerEngine(executor: executor, sourceCompiler: compiler,
            maxActiveSources: 2, maxQueuedSources: 1).start(
            MemoryCompilerSourceProvider([CompilerSource("a", "ok"), CompilerSource("b", "ok")]),
            MemoryCompilerArtifactSink(), session
        )
        expect(executor.queuedCount).toBe(2)
        let executing = Future.from<ExecutorTaskResult>(async { return executor.runNext() })$
        try {
            compiler.awaitEntered(0)
            expect(compiler.entered).toBe(1)
            session.cancel()
            expect(executor.queuedCount).toBe(0)
            expect(session.completion.completed).toBe(false)
            compiler.release(0)
            executing.get()
            expect(session.completion.get().cancelled).toBe(true)
            expect(compiler.cleaned).toBe(1)
            expect(compiler.entered).toBe(1)
            expect(session.activeSourceCount).toBe(0)
            expect(session.inFlightSourceCount).toBe(0)
        } finally {
            compiler.finish(session)
            executing.get()
        }
    }

    test `source concurrency capacities reject invalid configuration`() {
        var Int rejected
        try { CompilerEngine(maxActiveSources: 0) } catch (Exception error) { rejected++ }
        try { CompilerEngine(maxQueuedSources: -1) } catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
    }

    class CancellingSourceCompiler extends FlatEs6SourceCompiler {
        visible var Bool completedInsideCompile
        visible var Bool cleaned
        visible Future.CompletableFuture<Bool> enteredCompile = Future.create<Bool>()
        public construct(visible CompilerSession session, visible Future<Bool> cleanupGate) {}

        override public async compile(CompilerSource source) -> String {
            session.cancel()
            // InlineExecutor has entered before submit returns/attach assigns task.
            completedInsideCompile = session.completion.completed
            enteredCompile.complete(true)
            try {
                cleanupGate.get()
                return "unused cancelled code"
            } finally {
                cleaned = true
            }
        }
    }

    async test `inline reentrant cancellation before task attachment waits for cleanup`() {
        let session = CompilerSession()
        let gate = Future.create<Bool>()
        let compiler = CancellingSourceCompiler(session, gate)
        let sink = MemoryCompilerArtifactSink()
        CompilerEngine(sourceCompiler: compiler).start(MemoryCompilerSourceProvider([
            CompilerSource("one", "value() -> Int { return 1; }")
        ]), sink, session)
        try {
            compiler.enteredCompile.get()
            expect(session.cancelled).toBe(true)
            expect(compiler.completedInsideCompile).toBe(false)
            expect(compiler.cleaned).toBe(false)
            expect(session.completion.completed).toBe(false)
            let cleanupCompletion = (Future.CompletableFuture<Bool>)gate
            cleanupCompletion.complete(true)
            let summary = session.completion.get()
            expect(compiler.cleaned).toBe(true)
            expect(summary.cancelled).toBe(true)
            expect(summary.sourceCount).toBe(1)
            expect(summary.artifactCount).toBe(0)
            expect(sink.artifacts().count).toBe(0)
        } finally {
            session.cancel()
            Future.CompletableFuture<Bool> cleanupRelease = (Future.CompletableFuture<Bool>)gate
            if (!cleanupRelease.completed) cleanupRelease.complete(true)
            session.completion.get()
        }
    }

    async test `inline read cancellation before task attachment waits for admitted load cleanup`() {
        for (capacity in 1..3) {
            let session = CompilerSession()
            let provider = SubmissionSourceProvider(session, cancelOnRead: true)
            let compiler = GatedSourceCompiler()
            let sink = MemoryCompilerArtifactSink()
            try {
                CompilerEngine(sourceCompiler: compiler, maxActiveSources: capacity).start(provider, sink, session)
                provider.enteredRead.get()
                expect(session.cancelled).toBe(true)
                expect(session.completion.completed).toBe(false)
                expect(provider.entered).toBe(1)
                expect(provider.cleaned).toBe(0)
                provider.releaseRead.complete(true)
                let summary = session.completion.get()
                expect(provider.cleaned).toBe(1)
                expect(compiler.entered).toBe(0)
                expect(summary.cancelled).toBe(true)
                expect(summary.artifactCount).toBe(0)
                expect(session.inFlightSourceCount).toBe(0)
            } finally {
                compiler.release(0)
                compiler.release(1)
                provider.finish()
            }
        }
    }

    async test `session first start waits for controlled executor and preserves attached consumers`() {
        let executor = ControlledExecutor(1)
        let engine = CompilerEngine(executor: executor)
        let session = CompilerSession()
        let progress = session.progress.subscribe(1)
        let sink = MemoryCompilerArtifactSink()
        let started = engine.start(MemoryCompilerSourceProvider([
            CompilerSource("one", "value() -> Int { return 1; }")
        ]), sink, session)
        let running = Future.from<ExecutorTaskResult>(async { return executor.runNext() })$
        try {
            expect(Object.referenceEquals(started, session)).toBe(true)
            expect(session.completion.completed).toBe(false)
            expect(sink.artifacts().count).toBe(0)
            // runNext settles a worker, not coordinator publications.
            // Receive both independent channels while that worker is in flight.
            expect(progress.receive().value).toBe("Compiled one")
            expect(session.artifacts.receive().value.identity).toBe("one.js")
            running.get()
            expect(session.completion.get().artifactCount).toBe(1)
        } finally {
            session.cancel()
            session.progress.unsubscribe(progress)
            running.get()
            session.completion.get()
        }
    }

