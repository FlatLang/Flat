package flat/compiler

import flat/compiler/Compiler
import flat/io
import flat/system
import flat/time/Time
import flat/compiler/models
import flat/lexer
import flat/parser/flat
import flat/writer/es6/bound

testable class {
    async test `package linker emits real data declaration with source owned identity`() {
        let identity = "flat/meta/Field.flat"
        let source = Es6ArtifactFiles.read(File("../Flat-Core/src/flat/meta/Field.flat"))
        let code = FlatEs6PackageLinker().link([CompilerSource(identity, source)])
        let stream = Lexer().lexInterpolated(source)
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(SourceIdentity(identity), "compiler-input")
        let partition = FlatSourceTypePartitioner().partition(
            stream.consumeAll<Token>("data"), snapshot, "js"
        ).first
        let syntax = PrimitiveClassParser().parse(
            partition.tokenValues(), snapshot, partition.startTokenIndex, "Field"
        )
        let owner = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", syntax.range.startTokenIndex), "class", "Field"
        )
        let root = File(".flat-compiler-data-declaration-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(destination, code + "console.log(new " +
            Es6NameMangler.mangle(owner.value) + "('seen') !== null);\n")
        let response = System.execute(["node", destination.normalizedLocation], silent: true, shell: false)
        Es6ArtifactFiles.remove(root)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("true\n")
    }

    async test `compound call receiver executes once`() {
        let identity = "memory:compound-call-receiver"
        let source = "class Box { visible Int count; static run(func()->Box next) -> Int { next().count += 2.5; var Int result = -7; result -= 2.5; return result; } }"
        let snapshot = SourceSnapshotIdentity(SourceIdentity(identity), "compiler-input")
        let stream = Lexer().lex(source)
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let owner = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "class", syntax.range.startTokenIndex), "class", "Box")
        let method = syntax.methodValues().last
        let target = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "static-method", method.range.startTokenIndex), "static-method", "run")
        let code = FlatEs6SourceCompiler().compile(CompilerSource(identity, source))
        let call = Es6NameMangler.mangle(owner.value) + "." + Es6NameMangler.mangle(target.value)
        let field = Es6NameMangler.mangle(SymbolIdentity(owner, "field", 0).value)
        let root = File(".flat-compiler-compound-receiver-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(destination, code + "let calls=0;const box={" + field + ":7};const result=" + call +
            "(()=>{calls++;return box;});console.log(calls,box." + field + ",result);\n")
        let response = System.execute(["node", destination.normalizedLocation], silent: true, shell: false)
        Es6ArtifactFiles.remove(root)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("1 9 -9\n")
    }
    async test `parsed safe call skips captured callback argument for null receiver`() {
        let identity = "memory:safe-field-execution"
        let source = "class Box { visible Int count; read(Int argument) -> Int { return argument; } static async read(Box value, async func(Int)->Int next) -> Int { " +
            "if (true) { let storage = Box(); storage.count = 7; storage.count += 2; let result = true ? (value?.read(next(0 ?: 9)) ?: (storage.count += next(0 ?: 9))) : 7; return result + storage.count; } return 7; } }"
        let snapshot = SourceSnapshotIdentity(SourceIdentity(identity), "compiler-input")
        let stream = Lexer().lex(source)
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let owner = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "class", syntax.range.startTokenIndex), "class", "Box")
        let method = syntax.methodValues().last
        let target = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "static-method", method.range.startTokenIndex), "static-method", "read")
        let code = FlatEs6SourceCompiler().compile(CompilerSource(identity, source))
        let call = Es6NameMangler.mangle(owner.value) + "." + Es6NameMangler.mangle(target.value)
        let field = Es6NameMangler.mangle(SymbolIdentity(owner, "field", 0).value)
        let root = File(".flat-compiler-safe-field-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(destination, code + "(async()=>{let calls=0; const next=async(value)=>{calls++;return value+3;}; console.log(await " + call + "(null,next),calls); console.log(await " + call + "(new " + Es6NameMangler.mangle(owner.value) + "(),next),calls);})();\n")
        let response = System.execute(["node", destination.normalizedLocation], silent: true, shell: false)
        Es6ArtifactFiles.remove(root)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("24 1\n12 2\n")
    }
    async test `executes null fallback without treating false as null`() {
        let identity = "memory:fallback-execution"
        let source = "class Value { static run() -> Bool { return false ?: true; } " +
            "static missing() -> Bool { return null ?: true; } }"
        let snapshot = SourceSnapshotIdentity(SourceIdentity(identity), "compiler-input")
        let stream = Lexer().lex(source)
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let code = FlatEs6SourceCompiler().compile(CompilerSource(identity, source))
        let owner = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "class", syntax.range.startTokenIndex), "class", "Value")
        var String calls = ""
        for (method in syntax.methodValues()) {
            let target = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "static-method", method.range.startTokenIndex), "static-method", method.name)
            calls += "console.log(" + Es6NameMangler.mangle(owner.value) + "." + Es6NameMangler.mangle(target.value) + "());\n"
        }
        let root = File(".flat-compiler-fallback-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(destination, code + calls)
        let response = System.execute(["node", destination.normalizedLocation], silent: true, shell: false)
        Es6ArtifactFiles.remove(root)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("false\ntrue\n")
    }
    async test `executes method generic declared array construction`() {
        let identity = "memory:declared-array-execution"
        let source = "class Array<E> { visible Int count; construct(Int count, Int capacity = count) { this.count = count; } } " +
            "class Box { static make<Out>(Int size) -> Out[] { return Array<Out>(size); } " +
            "static run() -> Int { return Box.make<Int>(3).count; } }"
        let code = FlatEs6PackageLinker().link([CompilerSource(identity, source)])
        let snapshot = SourceSnapshotIdentity(SourceIdentity(identity), "compiler-input")
        let stream = Lexer().lex(source)
        stream.emit("start")
        let partitions = FlatSourceTypePartitioner().partition(stream.consumeAll<Token>("data"), snapshot)
        let boxPartition = partitions.last
        let box = PrimitiveClassParser().parse(boxPartition.tokenValues(), snapshot, boxPartition.startTokenIndex)
        let typeIdentity = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "class", box.range.startTokenIndex), "class", "Box")
        let run = box.methodValues().firstOrNull({ _.name == "run" })
        let methodIdentity = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "static-method", run.range.startTokenIndex), "static-method", "run")
        let root = File(".flat-compiler-declared-array-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(destination, code + "console.log(" + Es6NameMangler.mangle(typeIdentity.value) + "." + Es6NameMangler.mangle(methodIdentity.value) + "());\n")
        let response = System.execute(["node", destination.normalizedLocation], silent: true, shell: false)
        Es6ArtifactFiles.remove(root)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("3\n")
    }
    async test `compiler lowers parsed lazy static properties`() {
        let identity = "memory:lazy-source"
        let source = "class Cache { visible static lazy Int value => 7 }"
        let snapshot = SourceSnapshotIdentity(SourceIdentity(identity), "compiler-input")
        let stream = Lexer().lex(source)
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let typeIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", syntax.range.startTokenIndex), "class", "Cache")
        let getter = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "static-method",
            syntax.methodValues().first.range.startTokenIndex), "static-method", "value")
        let input = CompilerSource(identity, source)
        let codes = [FlatEs6SourceCompiler().compile(input), FlatEs6PackageLinker().link([input])]
        for (code in codes) {
            let root = File(".flat-compiler-lazy-test-#{Time.currentTimeMillis}")
            Es6ArtifactFiles.ensureDirectory(root)
            let destination = File(root, "program.js")
            let call = Es6NameMangler.mangle(typeIdentity.value) + "." + Es6NameMangler.mangle(getter.value) + "()"
            Es6ArtifactCommitter().commit(destination, code + "console.log(" + call + "); console.log(" + call + ");\n")
            let response = System.execute(["node", destination.normalizedLocation], silent: true, shell: false)
            Es6ArtifactFiles.remove(root)
            if (response.exitCode != 0) throw Exception(response.stderr.join(""))
            expect(response.stdout.join("")).toBe("7\n7\n")
        }
    }
    async test `compiler CLI matches glob source exclusions`() {
        let excluded = File("#{System.workingDirectory}/packages/Flat-Parser/src/flat/example_Test.flat")
        let included = File("#{System.workingDirectory}/packages/Flat-Parser/src/flat/example.flat")
        let pattern = "#{System.workingDirectory}/packages/Flat-Parser/src/**/*_Test*.flat"

        expect(CompilerCli.matchesExclusion(pattern, excluded)).toBe(true)
        expect(CompilerCli.matchesExclusion(pattern, included)).toBe(false)
    }

    async test `in process session composes Flat source through binding into runnable ES6`() {
        let result = CompilerTest().compile([
            CompilerSource("z", "value() -> Int { return 2; }"),
            CompilerSource("a", "value() -> Int { return 1; }")
        ])
        expect(result.artifacts().count).toBe(2)
        expect(result.artifacts().first.identity).toBe("a.js")
        expect(result.session.completion.completed).toBe(true)
        let summary = result.session.completion.get()
        expect(summary.artifactCount).toBe(2)
        expect(summary.diagnosticCount).toBe(0)
        expect(result.session.artifacts.closed).toBe(true)
        expect(result.session.diagnostics.closed).toBe(true)
        expect(result.session.progress.closed).toBe(true)

        let identity = DeclarationIdentity(
            SyntaxIslandIdentity(
                SourceSnapshotIdentity(SourceIdentity("a"), "compiler-input"),
                "function", 0
            ),
            "function", "value"
        )
        let root = File(".flat-compiler-execution-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(
            destination,
            result.artifacts().first.code +
                "console.log(" + Es6NameMangler.mangle(identity.value) + "());\n"
        )
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        expect(response.exitCode).toBe(0)
        expect(response.stdout.join("")).toBe("1\n")
        Es6ArtifactFiles.remove(root)
    }

    async test `in process compiler emits and executes a reduced Flat Core type fixture`() {
        let fixture = File("test-fixtures/reduced-flat-core-class.flat")
        let source = CompilerSource("flat-core/Box.flat", Es6ArtifactFiles.read(fixture))
        let result = CompilerTest().compile([source])
        expect(result.artifacts().count).toBe(1)
        let summary = result.session.completion.get()
        expect(summary.artifactCount).toBe(1)
        expect(summary.diagnosticCount).toBe(0)

        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("flat-core/Box.flat"), "compiler-input"
        )
        let classIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", 0), "class", "Box"
        )
        let className = Es6NameMangler.mangle(classIdentity.value)
        let root = File(".flat-compiler-core-class-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(
            destination,
            result.artifacts().first.code +
                "console.log(typeof new " + className + "());\n"
        )
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("object\n")
        Es6ArtifactFiles.remove(root)
    }

    async test `in process compiler partitions package imports and multiple reduced types`() {
        let fixture = File("test-fixtures/reduced-flat-core-types.flat")
        let result = CompilerTest().compile([
            CompilerSource("flat-core/types.flat", Es6ArtifactFiles.read(fixture))
        ])
        expect(result.artifacts().count).toBe(1)
        let summary = result.session.completion.get()
        expect(summary.artifactCount).toBe(1)
        expect(summary.diagnosticCount).toBe(0)
        let code = result.artifacts().first.code
        expect(code.indexOf("class ") >= 0).toBe(true)
        expect(code.indexOf("class ", code.indexOf("class ") + 1) >= 0).toBe(true)
    }

