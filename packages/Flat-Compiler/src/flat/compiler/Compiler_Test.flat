    async test `package linker executes generic identity method`() {
        let identity = "memory:generic-identity"
        let source = "class Box { Int observed = 0; " +
            "identity<Out>(Out value, Int count = 1) -> Out { " +
            "this.observed += count; return value; } " +
            "forward<Type>(Type value) -> Type { return identity(value); } " +
            "run() -> Int { let result = forward(40) + identity(2, 3); return result + this.observed; } }"
