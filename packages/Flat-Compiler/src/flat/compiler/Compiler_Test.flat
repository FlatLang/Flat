    async test `package linker rejects duplicate positional named parameter`() {
        var String failure
        try {
            FlatEs6PackageLinker().link([CompilerSource(
                "memory:duplicate-parameter",
                "class Value { read(Int count, Int end = 0) -> Int { return count; } run() -> Int { return read(7, count: 9); } }"
            )])
        } catch (Exception error) { failure = error.message }
        expect(failure.contains("Parameter 'count' is supplied both positionally and by name")).toBe(true)
    }

