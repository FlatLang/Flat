    async test `cancel after artifact delivery closes attached progress observer`() {
        let executor = ControlledExecutor(1)
        let session = CompilerSession()
        let progress = session.progress.subscribe(0)
        let sink = MemoryCompilerArtifactSink()
        CompilerEngine(executor: executor).start(MemoryCompilerSourceProvider([
            CompilerSource("one", "value() -> Int { return 1; }")
        ]), sink, session)
        let running = Future.from<ExecutorTaskResult>(async { return executor.runNext() })$
        // Artifact delivery precedes progress. Receiving it is a controlled gate;
        // cancellation must also be safe if the progress send has not yet begun.
        expect(session.artifacts.receive().value.identity).toBe("one.js")
        session.cancel()
        running.get()
        expect(session.completion.get().artifactCount).toBe(1)
        expect(session.completion.get().cancelled).toBe(true)
        expect(progress.pendingSendCount).toBe(0)
        expect(progress.closed).toBe(true)
    }

