    async test `package linker resolves dependency ordered inheritance across sources`() {
        let code = FlatEs6PackageLinker().link([
            CompilerSource(
                "flat/core/Child.flat",
                Es6ArtifactFiles.read(File("test-fixtures/reduced-flat-core-child.flat"))
            ),
            CompilerSource(
