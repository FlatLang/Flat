            "class", "NoSuchElementException"
        )
        let exceptionSnapshot = SourceSnapshotIdentity(
            SourceIdentity(exceptionIdentity), "compiler-input"
        )
        let exceptionType = DeclarationIdentity(
            SyntaxIslandIdentity(exceptionSnapshot, "class", 4), "class", "Exception"
        )
        let messageField = SymbolIdentity(exceptionType, "field", 1)
        let stackField = SymbolIdentity(exceptionType, "field", 0)
        let stackType = DeclarationIdentity(
            SyntaxIslandIdentity(
                SourceSnapshotIdentity(SourceIdentity(stackIdentity), "compiler-input"), "class", 4
            ), "class", "StackTrace"
        )
