            destination,
            code + "let value = new " + Es6NameMangler.mangle(typeIdentity.value) +
                "();\nconsole.log(value." + Es6NameMangler.mangle(messageField.value) + ");\n" +
                "let explicitValue = new " + Es6NameMangler.mangle(typeIdentity.value) +
                "('custom');\nconsole.log(explicitValue." +
                Es6NameMangler.mangle(messageField.value) + ");\n" +
                "console.log(value instanceof " + Es6NameMangler.mangle(exceptionType.value) + ");\n" +
                "console.log(value." + Es6NameMangler.mangle(stackField.value) +
                " instanceof " + Es6NameMangler.mangle(stackType.value) + ");\n" +
                "console.log(value." + Es6NameMangler.mangle(stackField.value) +
                " !== explicitValue." + Es6NameMangler.mangle(stackField.value) + ");\n"
        )
