    async test `package linker advances unchanged Number source`() {
        var String message
        try {
            FlatEs6PackageLinker().link([
                CompilerSource(
                    "flat/primitive/number/Number.flat",
                    Es6ArtifactFiles.read(File("../Flat-Core/src/flat/primitive/number/Number.flat"))
