package flat/compiler

import flat/compiler/Compiler
import flat/io
import flat/system
import flat/time/Time
import flat/compiler/models
import flat/writer/es6/bound

testable class {
    async test `compiler CLI matches glob source exclusions`() {
        let excluded = File("#{System.workingDirectory}/packages/Flat-Parser/src/flat/example_Test.flat")
        let included = File("#{System.workingDirectory}/packages/Flat-Parser/src/flat/example.flat")
        let pattern = "#{System.workingDirectory}/packages/Flat-Parser/src/**/*_Test*.flat"

        expect(CompilerCli.matchesExclusion(pattern, excluded)).toBe(true)
        expect(CompilerCli.matchesExclusion(pattern, included)).toBe(false)
    }

    async test `in process session composes Flat source through binding into runnable ES6`() {
        let result = CompilerTest().compile([
            CompilerSource("z", "value() -> Int { return 2; }"),
            CompilerSource("a", "value() -> Int { return 1; }")
        ])
        expect(result.artifacts().count).toBe(2)
        expect(result.artifacts().first.identity).toBe("a.js")
        expect(result.session.completion.completed).toBe(true)
        let summary = result.session.completion.get()
        expect(summary.artifactCount).toBe(2)
        expect(summary.diagnosticCount).toBe(0)
        expect(result.session.artifacts.closed).toBe(true)
        expect(result.session.diagnostics.closed).toBe(true)
        expect(result.session.progress.closed).toBe(true)

        let identity = DeclarationIdentity(
            SyntaxIslandIdentity(
                SourceSnapshotIdentity(SourceIdentity("a"), "compiler-input"),
                "function", 0
            ),
            "function", "value"
        )
        let root = File(".flat-compiler-execution-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(
            destination,
            result.artifacts().first.code +
                "console.log(" + Es6NameMangler.mangle(identity.value) + "());\n"
        )
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        expect(response.exitCode).toBe(0)
        expect(response.stdout.join("")).toBe("1\n")
        Es6ArtifactFiles.remove(root)
    }

    async test `in process compiler emits and executes a reduced Flat Core type fixture`() {
        let fixture = File("test-fixtures/reduced-flat-core-class.flat")
        let source = CompilerSource("flat-core/Box.flat", Es6ArtifactFiles.read(fixture))
        let result = CompilerTest().compile([source])
        expect(result.artifacts().count).toBe(1)
        let summary = result.session.completion.get()
        expect(summary.artifactCount).toBe(1)
        expect(summary.diagnosticCount).toBe(0)

        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("flat-core/Box.flat"), "compiler-input"
        )
        let classIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", 0), "class", "Box"
        )
        let className = Es6NameMangler.mangle(classIdentity.value)
        let root = File(".flat-compiler-core-class-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(
            destination,
            result.artifacts().first.code +
                "console.log(typeof new " + className + "());\n"
        )
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("object\n")
        Es6ArtifactFiles.remove(root)
    }

    async test `in process compiler partitions package imports and multiple reduced types`() {
        let fixture = File("test-fixtures/reduced-flat-core-types.flat")
        let result = CompilerTest().compile([
            CompilerSource("flat-core/types.flat", Es6ArtifactFiles.read(fixture))
        ])
        expect(result.artifacts().count).toBe(1)
        let summary = result.session.completion.get()
        expect(summary.artifactCount).toBe(1)
        expect(summary.diagnosticCount).toBe(0)
        let code = result.artifacts().first.code
        expect(code.indexOf("class ") >= 0).toBe(true)
        expect(code.indexOf("class ", code.indexOf("class ") + 1) >= 0).toBe(true)
    }

    async test `in process compiler links dependency ordered inheritance partitions`() {
        let fixture = File("test-fixtures/reduced-flat-core-inheritance.flat")
        let code = FlatEs6SourceCompiler().compile(
            CompilerSource("flat-core/inheritance.flat", Es6ArtifactFiles.read(fixture))
        )
        expect(code.indexOf("extends") >= 0).toBe(true)
    }

    async test `package linker resolves dependency ordered inheritance across sources`() {
        let code = FlatEs6PackageLinker().link([
            CompilerSource(
                "flat/core/Child.flat",
                Es6ArtifactFiles.read(File("test-fixtures/reduced-flat-core-child.flat"))
            ),
            CompilerSource(
                "flat/core/Parent.flat",
                Es6ArtifactFiles.read(File("test-fixtures/reduced-flat-core-parent.flat"))
            )
        ])
        expect(code.indexOf("extends") >= 0).toBe(true)
    }

    async test `package linker forwards parent constructor message in dependency slice`() {
        let identity = "flat/exception/Exceptions.flat"
        let code = FlatEs6PackageLinker().link([
            CompilerSource(
                identity,
                Es6ArtifactFiles.read(File("test-fixtures/reduced-flat-core-exception.flat"))
            )
        ])
        expect(code.indexOf("super") >= 0).toBe(true)
        expect(code.indexOf("extends ") >= 0).toBe(true)
        let childNameStart = code.lastIndexOf("class ") + 6
        let childNameEnd = code.indexOf(" ", start: childNameStart)
        let childName = code.substring(childNameStart, childNameEnd)
        let root = File(".flat-compiler-exception-slice-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(
            destination,
            code + "let value = new " + childName + "('forwarded');\n" +
                "console.log(value[Object.keys(value)[0]]);\n"
        )
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("forwarded\n")
        Es6ArtifactFiles.remove(root)
    }

    async test `package linker uses default parent message when child omits delegated argument`() {
        let identity = "flat/exception/DefaultExceptions.flat"
        let code = FlatEs6PackageLinker().link([
            CompilerSource(identity,
                "package flat/exception " +
                "class ParentException { visible String message = \"\"; " +
                "constructor(String message = \"\") { this.message = message; } } " +
                "class ChildException extends ParentException { constructor() => super() }")
        ])
        let childNameStart = code.lastIndexOf("class ") + 6
        let childNameEnd = code.indexOf(" ", start: childNameStart)
        let childName = code.substring(childNameStart, childNameEnd)
        let root = File(".flat-compiler-default-exception-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(
            destination,
            code + "let value = new " + childName + "();\n" +
                "console.log(value[Object.keys(value)[0]] === '');\n"
        )
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("true\n")
        Es6ArtifactFiles.remove(root)
    }

    async test `package linker executes visible constructor parameter field synthesis`() {
        let identity = "flat/exception/VisibleException.flat"
        let code = FlatEs6PackageLinker().link([
            CompilerSource(identity,
                "package flat/exception class VisibleException { " +
                "construct(visible String message = \"\") {} }")
        ])
        let snapshot = SourceSnapshotIdentity(SourceIdentity(identity), "compiler-input")
        let typeIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", 4), "class", "VisibleException"
        )
        let fieldIdentity = SymbolIdentity(typeIdentity, "field", 0)
        let className = Es6NameMangler.mangle(typeIdentity.value)
        let fieldName = Es6NameMangler.mangle(fieldIdentity.value)
        let root = File(".flat-compiler-visible-exception-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(
            destination,
            code + "console.log(new " + className + "('forwarded')." + fieldName + ");\n"
        )
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("forwarded\n")
        Es6ArtifactFiles.remove(root)
    }

    async test `package linker executes package local construction field initializer`() {
        let identity = "flat/exception/Construction.flat"
        let code = FlatEs6PackageLinker().link([
            CompilerSource(identity,
                "package flat/exception " +
                "class StackTrace {} " +
                "class Exception { StackTrace stackTrace = StackTrace(); }")
        ])
        let snapshot = SourceSnapshotIdentity(SourceIdentity(identity), "compiler-input")
        let exceptionIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", 8), "class", "Exception"
        )
        let stackIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", 4), "class", "StackTrace"
        )
        let fieldIdentity = SymbolIdentity(exceptionIdentity, "field", 0)
        let exceptionName = Es6NameMangler.mangle(exceptionIdentity.value)
        let stackName = Es6NameMangler.mangle(stackIdentity.value)
        let fieldName = Es6NameMangler.mangle(fieldIdentity.value)
        let root = File(".flat-compiler-construction-field-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(
            destination,
            code + "let value = new " + exceptionName + "()." + fieldName + ";\n" +
                "console.log(value instanceof " + stackName + ");\n"
        )
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("true\n")
        Es6ArtifactFiles.remove(root)
    }

    async test `package linker executes real StackTrace in reduced Exception field`() {
        let stackIdentity = "flat/exception/StackTrace.flat"
        let exceptionIdentity = "flat/exception/ReducedException.flat"
        let code = FlatEs6PackageLinker().link([
            CompilerSource(
                stackIdentity,
                Es6ArtifactFiles.read(File("../Flat-Core/src/flat/exception/StackTrace.flat"))
            ),
            CompilerSource(
                exceptionIdentity,
                "package flat/exception class Exception { " +
                "StackTrace stackTrace = StackTrace(); " +
                "construct(visible String message = \"\") {} }"
            )
        ])
        let stackType = DeclarationIdentity(
            SyntaxIslandIdentity(
                SourceSnapshotIdentity(SourceIdentity(stackIdentity), "compiler-input"),
                "class", 4
            ),
            "class", "StackTrace"
        )
        let exceptionType = DeclarationIdentity(
            SyntaxIslandIdentity(
                SourceSnapshotIdentity(SourceIdentity(exceptionIdentity), "compiler-input"),
                "class", 4
            ),
            "class", "Exception"
        )
        let stackField = SymbolIdentity(exceptionType, "field", 0)
        let messageField = SymbolIdentity(exceptionType, "field", 1)
        let root = File(".flat-compiler-real-stack-field-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(
            destination,
            code + "let value = new " + Es6NameMangler.mangle(exceptionType.value) +
                "('forwarded');\n" +
                "console.log(value." + Es6NameMangler.mangle(stackField.value) +
                " instanceof " + Es6NameMangler.mangle(stackType.value) + ");\n" +
                "console.log(value." + Es6NameMangler.mangle(messageField.value) + ");\n"
        )
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("true\nforwarded\n")
        Es6ArtifactFiles.remove(root)
    }

    async test `package linker rejects unknown construction and constructor arity`() {
        var Int rejected
        try {
            FlatEs6PackageLinker().link([
                CompilerSource("flat/test/Unknown.flat",
                    "package flat/test class Owner { Missing value = Missing(); }")
            ])
        } catch (Exception error) { rejected++ }
        try {
            FlatEs6PackageLinker().link([
                CompilerSource("flat/test/Arity.flat",
                    "package flat/test " +
                    "class Target { construct(Int value) {} } " +
                    "class Owner { Target value = Target(); }")
            ])
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
    }

    async test `package linker reports next real Exception unsupported construct`() {
        let identity = "flat/exception/Exception.flat"
        var String message
        try {
            FlatEs6PackageLinker().link([
                CompilerSource(
                    identity,
                    Es6ArtifactFiles.read(File("../Flat-Core/src/flat/exception/Exception.flat"))
                ),
                CompilerSource(
                    "flat/exception/StackTrace.flat",
                    Es6ArtifactFiles.read(File("../Flat-Core/src/flat/exception/StackTrace.flat"))
                )
            ])
        } catch (Exception error) { message = error.message }
        expect(message).toNotBe(null)
        expect(message.count > 0).toBe(true)
    }

