                CompilerSource("flat/datastruct/list/ArrayIterator.flat", Es6ArtifactFiles.read(File(
                    "../Flat-Core/src/flat/datastruct/list/ArrayIterator.flat"))),
                CompilerSource("flat/datastruct/list/Array.flat", Es6ArtifactFiles.read(File(
                    "../Flat-Core/src/flat/datastruct/list/Array.flat"))),
                CompilerSource("flat/async/Async.flat", Es6ArtifactFiles.read(File(
