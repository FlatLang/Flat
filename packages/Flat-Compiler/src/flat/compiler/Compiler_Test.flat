    async test `package linker compiles and executes unchanged real App static metadata`() {
        let identity = "flat/App.flat"
        let source = Es6ArtifactFiles.read(File("../Flat-Core/src/flat/App.flat"))
        let code = FlatEs6PackageLinker().link([CompilerSource(identity, source)])
        let stream = Lexer().lexInterpolated(source)
        stream.emit("start")
        let tokens = stream.consumeAll<Token>("data")
        let snapshot = SourceSnapshotIdentity(SourceIdentity(identity), "compiler-input")
        let partition = FlatSourceTypePartitioner().partition(tokens, snapshot).first
        let syntax = PrimitiveClassParser().parse(
            partition.tokenValues(), snapshot, partition.startTokenIndex, "App"
        )
        let typeIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", syntax.range.startTokenIndex),
            "class", "App"
        )
        let className = Es6NameMangler.mangle(typeIdentity.value)
        let fields = syntax.fieldValues()
        let names = String[]
        var Int index
        while (index < fields.count) {
            names.add(Es6NameMangler.mangle(SymbolIdentity(typeIdentity, "field", index).value))
            index++
        }
        let root = File(".flat-compiler-app-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(
            destination,
            code + "console.log([" + names.map({ className + "." + _ }).join(",") +
                "].every(value => value === null));\n"
        )
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("true\n")
        Es6ArtifactFiles.remove(root)
    }

    methodName(
        SourceSnapshotIdentity snapshot,
        PrimitiveFunctionSyntax method
    ) -> String => Es6NameMangler.mangle(DeclarationIdentity(
        SyntaxIslandIdentity(
            snapshot,
            method.staticMethod ? "static-method" : "instance-method",
            method.range.startTokenIndex
        ),
        method.staticMethod ? "static-method" : "instance-method",
        method.name
    ).value)

