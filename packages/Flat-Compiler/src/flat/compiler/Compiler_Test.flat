    async test `executes contextual async callback with captured default`() {
        let identity = "memory:contextual-async-default"
        let source = "class Value { static async apply<Out, In>(In value, async callback(In value, Int index) -> Out) -> Out { return callback(value, 2); } static async apply(Int value, async callback(Bool value, Int index) -> Int) -> Int { return 0; } static async read(Int offset = 2, async next(Int value) -> Int = lambda(Int value) => value + offset) -> Int { return Value.apply(40, { next(_) + _ }); } }"
        let snapshot = SourceSnapshotIdentity(SourceIdentity(identity), "compiler-input")
        let stream = Lexer().lex(source)
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let method = syntax.methodValues().firstOrNull({ _.name == "read" })
        let typeIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", syntax.range.startTokenIndex), "class", "Value"
        )
        let methodIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "static-method", method.range.startTokenIndex),
            "static-method", "read"
        )
        // Generic callback results require canonical Int boxing declarations.
        // Retain the actual bounded Core closure, including its storage constructor.
        let callbackSources = realCoreExecutionSources([CompilerSource(identity, source)])
        expect(callbackSources.count <= 64).toBe(true)
        expect(callbackSources.filter((value) => value.identity == "flat/primitive/number/Int.flat").count).toBe(1)
        let code = FlatEs6PackageLinker().link(callbackSources)
        let root = File(".flat-compiler-contextual-async-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        try {
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(destination, code + "(async () => { console.log(await " +
            Es6NameMangler.mangle(typeIdentity.value) + "." +
            Es6NameMangler.mangle(methodIdentity.value) + "()); })().catch(error => { console.error(error); process.exitCode = 1; });\n")
        let response = System.execute(["node", destination.normalizedLocation], silent: true, shell: false)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("44\n")
        } finally { Es6ArtifactFiles.remove(root) }
    }

