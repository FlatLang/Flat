    async test `compiler CLI matches glob source exclusions`() {
        let root = File(".flat-compiler-glob-exclusion-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        try {
            let excluded = File(root, "example_Test.flat")
            let included = File(root, "example.flat")
            Es6ArtifactFiles.write(excluded, "class Excluded {}")
            Es6ArtifactFiles.write(included, "class Included {}")
            let pattern = "#{root.normalizedLocation}/**/*_Test*.flat"
            expect(CompilerCli.matchesExclusion(pattern, excluded)).toBe(true)
            expect(CompilerCli.matchesExclusion(pattern, included)).toBe(false)
        } finally { Es6ArtifactFiles.remove(root) }
    }

