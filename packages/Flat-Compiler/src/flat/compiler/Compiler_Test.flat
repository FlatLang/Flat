    async test `executes default method`() {
        let identity = "memory:default-factory"
        let source = "class Factory { static read() -> Int { return Factory.echo<Int>(Value().run()); } static echo<T>(T value) -> T { return value; } static arrayRead() -> Int { let empty = Answer<Int>[]; Int[] values = [42]; if (let found = true) { if (found) { var Int total = 0; for (item in Values()) { total += item; } return Factory.echo<Int>(total); } } return 0; } }"
        let snapshot = SourceSnapshotIdentity(SourceIdentity(identity), "compiler-input")
        let stream = Lexer().lex(source)
        stream.emit("start")
        let syntax = PrimitiveClassParser().parse(stream.consumeAll<Token>("data"), snapshot)
        let method = syntax.methodValues().first
        let typeIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", syntax.range.startTokenIndex), "class", "Factory")
        let methodIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "static-method", method.range.startTokenIndex), "static-method", "read")
        let code = FlatEs6PackageLinker().link([
            CompilerSource(identity, source),
            CompilerSource("memory:protocol-cursor", "class Cursor { visible var Int position = 0 visible Bool hasNext => position < 2 visible Int stepNext { get { position += 1; return 21; } } }"),
            CompilerSource("memory:protocol-values", "class Values { visible Cursor iterator => Cursor() }"),
            CompilerSource("memory:default-value", "class Value implements Answer<Int> { run() -> Int { return read(42); } }"),
            CompilerSource("memory:default-answer", "trait Answer<T> { read(T value) -> T { T local = value; return local; } }")
        ])
        let arrayMethod = syntax.methodValues().last
        let arrayIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "static-method", arrayMethod.range.startTokenIndex),
            "static-method", "arrayRead")
        let root = File(".flat-compiler-default-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(destination, code + "console.log(" +
            Es6NameMangler.mangle(typeIdentity.value) + "." +
            Es6NameMangler.mangle(methodIdentity.value) + "());\n" +
            "console.log(" + Es6NameMangler.mangle(typeIdentity.value) + "." +
            Es6NameMangler.mangle(arrayIdentity.value) + "());\n")
        let response = System.execute(["node", destination.normalizedLocation], silent: true, shell: false)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("42\n42\n")
        Es6ArtifactFiles.remove(root)
    }

