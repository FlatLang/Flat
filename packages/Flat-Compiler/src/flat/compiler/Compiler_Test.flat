        let identity = "flat/primitive/number/Double.flat"
        let overlayIdentity = "flat/primitive/number/Double.js.flat"
        let source = Es6ArtifactFiles.read(File("../Flat-Core/src/flat/primitive/number/Double.flat"))
        let overlay = Es6ArtifactFiles.read(File("../Flat-Core/src/flat/primitive/number/Double.js.flat"))
        let code = FlatEs6PackageLinker().link(realCoreExecutionSources([
            CompilerSource(identity, source),
            CompilerSource(overlayIdentity, overlay),
            CompilerSource(
                "flat/primitive/number/Number.flat",
                Es6ArtifactFiles.read(File("../Flat-Core/src/flat/primitive/number/Number.flat"))
            ),
            CompilerSource(
                "flat/primitive/number/RealNumber.flat",
                Es6ArtifactFiles.read(File("../Flat-Core/src/flat/primitive/number/RealNumber.flat"))
            ),
            CompilerSource(
                "flat/primitive/Primitive.flat",
                Es6ArtifactFiles.read(File("../Flat-Core/src/flat/primitive/Primitive.flat"))
            )
        ]))
        let sourceStream = Lexer().lex(source)
        sourceStream.emit("start")
        let sourceSnapshot = SourceSnapshotIdentity(
            SourceIdentity(identity), "compiler-input"
        )
        let sourcePartition = FlatSourceTypePartitioner().partition(
            sourceStream.consumeAll<Token>("data"), sourceSnapshot
        ).first
        let sourceSyntax = PrimitiveClassParser().parse(
            sourcePartition.tokenValues(), sourceSnapshot,
            sourcePartition.startTokenIndex, "Double"
        )
        let typeIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(
                sourceSnapshot, "class", sourceSyntax.range.startTokenIndex
            ),
            "class", "Double"
        )
        let overlayStream = Lexer().lexInterpolated(overlay)
        overlayStream.emit("start")
        let overlaySnapshot = SourceSnapshotIdentity(
            SourceIdentity(overlayIdentity), "compiler-input"
        )
        let overlayPartition = FlatSourceTypePartitioner().partition(
            overlayStream.consumeAll<Token>("data"), overlaySnapshot, "js"
        ).first
        let overlaySyntax = PrimitiveClassParser().parse(
            overlayPartition.tokenValues(), overlaySnapshot,
            overlayPartition.startTokenIndex, "Double"
        )
        let parseMethod = overlaySyntax.methodValues().firstOrNull({ _.name == "parseDouble" })
        var PrimitiveFunctionSyntax fixedMethod
        for (method in overlaySyntax.methodValues()) {
            if (method.name == "toFixed" && !method.staticMethod) fixedMethod = method
        }
        let className = Es6NameMangler.mangle(typeIdentity.value)
        let parseName = methodName(overlaySnapshot, parseMethod)
        let fixedName = methodName(overlaySnapshot, fixedMethod)
        let root = File(".flat-compiler-double-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(
            destination,
            code + "let parsed = " + className + "." + parseName +
                "('12.5');\n" +
                "let value = new " + className + "(parsed);\n" +
                "console.log(parsed);\n" +
                "console.log(value." + fixedName + "(2));\n"
        )
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("12.5\n12.50\n")
        Es6ArtifactFiles.remove(root)
    }

