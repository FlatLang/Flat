    async test `package linker rejects unknown construction and constructor arity`() {
        var Int rejected
        try {
            FlatEs6PackageLinker().link([
                CompilerSource("flat/test/Unknown.flat",
                    "package flat/test class Owner { Missing value = Missing(); }")
            ])
        } catch (Exception error) { rejected++ }
        try {
            FlatEs6PackageLinker().link([
                CompilerSource("flat/test/Arity.flat",
                    "package flat/test " +
                    "class Target { construct(Int value) {} } " +
                    "class Owner { Target value = Target(); }")
            ])
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
    }

    // This is a bounded fixture dependency closure, not whole-project discovery.
    // Class metadata uses String.lastIndexOf; String in turn needs its real JS
    // overlay, character storage, collections, numeric and operator contracts.
    /** Explicit test-only real dependencies; no production discovery or source rewriting. */
    public static coreDependencyIdentities() -> String[] {
        String[] identities = [
        "flat/datastruct/Comparable.flat",
        "flat/primitive/Primitive.flat",
        "flat/primitive/number/Integer.flat",
        "flat/operators/PlusOperator.flat",
        "flat/operators/PlusEqualsOperator.flat",
        "flat/operators/MinusOperator.flat",
        "flat/operators/MinusEqualsOperator.flat",
        "flat/operators/MultiplyOperator.flat",
        "flat/operators/MultiplyEqualsOperator.flat"
        ]
        return identities
    }

    public static admitCoreDependencies(CompilerSource[] supplied) -> CompilerSource[] {
        let sources = CompilerSource[]:addAll(supplied)
        let identities = coreDependencyIdentities()
        if (supplied.any((source) => source.identity.startsWith("flat/datastruct/list/") ||
            source.identity == "flat/String.flat" || source.identity == "flat/String.js.flat")) {
            identities.addAll([
                "flat/datastruct/list/Iterable.flat", "flat/datastruct/list/Iterator.flat",
                "flat/datastruct/list/List.flat", "flat/datastruct/list/OrderedList.flat",
                "flat/async/Async.flat", "flat/async/Async.js.flat"
            ])
        }
        for (identity in identities) {
            if (sources.none({ _.identity == identity })) {
                File parent = File("../Flat-Core/src")
                File file = File(parent, identity)
                String text = Es6ArtifactFiles.read(file)
                sources.add(CompilerSource(identity, text))
            }
        }
        return sources
    }

    /** Finite real-source closure shared by exception, range, and String execution fixtures.
     * Numeric wrappers are declarations, not intrinsic scalar aliases: List.min/max
     * require Long's fields, and wrapper bodies reference the other numeric classes.
     * Their ES6 overlays and the declared String/Array storage graph remain intact.
     */
    public static realCoreExecutionSources(CompilerSource[] supplied = CompilerSource[]) -> CompilerSource[] {
        let identities = [
            "flat/Object.flat",
            "flat/Object.js.flat",
            "flat/Math.flat",
            "flat/meta/Function.flat",
            "flat/meta/Class.flat",
            "flat/meta/Field.flat",
            "flat/exception/Exception.flat",
            "flat/exception/NullAccessException.flat",
            "flat/exception/StackTrace.flat",
            "flat/datastruct/list/NoSuchElementException.flat",
            "flat/String.flat",
            "flat/String.js.flat",
            "flat/primitive/Primitive.flat",
            "flat/primitive/number/Number.flat",
            "flat/primitive/number/Integer.flat",
            "flat/primitive/number/Char.flat",
            "flat/primitive/number/Long.flat",
            "flat/primitive/number/Long.js.flat",
            "flat/primitive/number/Int.flat",
            "flat/primitive/number/Int.js.flat",
            "flat/primitive/number/Double.flat",
            "flat/primitive/number/Double.js.flat",
            "flat/primitive/number/Float.flat",
            "flat/primitive/number/Float.js.flat",
            "flat/primitive/number/Byte.flat",
            "flat/primitive/number/Short.flat",
            "flat/primitive/number/RealNumber.flat",
            "flat/primitive/Bool.flat",
            "flat/Math.js.flat",
            "flat/datastruct/Comparable.flat",
            "flat/operators/PlusOperator.flat",
            "flat/operators/PlusEqualsOperator.flat",
            "flat/operators/MinusOperator.flat",
            "flat/operators/MinusEqualsOperator.flat",
            "flat/operators/MultiplyOperator.flat",
            "flat/operators/MultiplyEqualsOperator.flat",
            "flat/datastruct/list/Iterable.flat",
            "flat/datastruct/list/Iterator.flat",
            "flat/datastruct/list/List.flat",
            "flat/datastruct/list/OrderedList.flat",
            "flat/datastruct/list/Array.flat",
            "flat/datastruct/list/Array.js.flat",
            "flat/datastruct/list/ArrayIterator.flat",
            "flat/datastruct/list/StringCharArray.flat",
            "flat/datastruct/list/StringCharArray.js.flat",
            "flat/datastruct/list/IntRange.flat",
            "flat/datastruct/list/IntRangeIterator.flat",
            "flat/async/Async.flat",
            "flat/async/Async.js.flat"
        ]
        // This explicit fixture boundary stays within the linker's existing 64-source limit.
        expect(identities.count <= 64).toBe(true)
        let sources = CompilerSource[]
        File parent = File("../Flat-Core/src")
        for (identity in identities) {
            expect(sources.none({ _.identity == identity })).toBe(true)
            File file = File(parent, identity)
            String text = Es6ArtifactFiles.read(file)
            CompilerSource source = CompilerSource(identity, text)
            sources.add(source)
        }
        for (source in supplied) {
            let existing = sources.firstOrNull({ _.identity == source.identity })
            if (existing) {
                expect(source.text).toBe(existing.text)
            } else {
                expect(sources.count < 64).toBe(true)
                sources.add(source)
            }
        }
        return sources
    }

    async test `package linker executes real Exception constructor and StackTrace under Node`() {
        let identity = "flat/exception/Exception.flat"
        let stackIdentity = "flat/exception/StackTrace.flat"
        let code = FlatEs6PackageLinker().link(realCoreExecutionSources())
        let snapshot = SourceSnapshotIdentity(SourceIdentity(identity), "compiler-input")
        let exceptionType = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", 4), "class", "Exception"
        )
        let stackType = DeclarationIdentity(
            SyntaxIslandIdentity(
                SourceSnapshotIdentity(SourceIdentity(stackIdentity), "compiler-input"),
                "class", 4
            ),
            "class", "StackTrace"
        )
        let stackField = SymbolIdentity(exceptionType, "field", 0)
        let messageField = SymbolIdentity(exceptionType, "field", 1)
        let root = File(".flat-compiler-real-exception-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(
            destination,
            code + "let value = new " + Es6NameMangler.mangle(exceptionType.value) +
                "('forwarded');\nconsole.log(value." +
                Es6NameMangler.mangle(stackField.value) + " instanceof " +
                Es6NameMangler.mangle(stackType.value) + ");\nconsole.log(value." +
                Es6NameMangler.mangle(messageField.value) + ");\n" +
                "let defaultValue = new " + Es6NameMangler.mangle(exceptionType.value) + "();\n" +
                "console.log(defaultValue." + Es6NameMangler.mangle(messageField.value) + ");\n" +
                "console.log(defaultValue." + Es6NameMangler.mangle(stackField.value) +
                " instanceof " + Es6NameMangler.mangle(stackType.value) + ");\n" +
                "console.log(defaultValue." + Es6NameMangler.mangle(stackField.value) +
                " !== value." + Es6NameMangler.mangle(stackField.value) + ");\n"
        )
        let response = System.execute(
            ["node", destination.normalizedLocation], silent: true, shell: false
        )
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("true\nforwarded\n\ntrue\ntrue\n")
        Es6ArtifactFiles.remove(root)
    }

    async test `executes reverse counted loop with decrement`() {
        let identity = "memory:reverse-counted-loop"
        let source = "class Counter { public static sum() -> Int { var Int total = 0; for (var Int i = 3; i >= 0; i--) { total = total + i; } return total; } }"
        let snapshot = SourceSnapshotIdentity(SourceIdentity(identity), "compiler-input")
        let stream = Lexer().lex(source)
        stream.emit("start")
