package flat/compiler

import flat/parser/ParserDiagnostic
import flat/semantic/binding/BindingDiagnostic
import flat/eventstream
import flat/future

/**
 * Attach observers before CompilerEngine.start/startPackage. Artifacts are a
 * single-consumer FIFO work channel, not replay; topics broadcast only to current
 * subscribers. The engine awaits every publication. Close/unsubscribe an optional
 * observer to detach it. A slow attached observer intentionally applies backpressure.
 * Cancellation stops admission/publication; completion waits for owned work cleanup.
 */
class {
    visible BoundedTopic<String> diagnostics = BoundedTopic<String>(4)
    visible BoundedTopic<String> progress = BoundedTopic<String>(4)
    visible BoundedChannel<CompilerArtifact> artifacts = BoundedChannel<CompilerArtifact>(4)
    visible Future<CompilationSummary> completion = Future.create<CompilationSummary>()
    /**
     * Bounded, non-replaying saturation telemetry: true on the first artifact send
     * that waits for capacity, false if the session terminates without blocking.
     * One scalar/future per session; observation never delays work or accumulates
     * samples. Cancellation settles it too. Not a delivery acknowledgement.
     */
    visible Future<Bool> artifactBackpressure = Future.create<Bool>()
    visible Bool cancelled => cancellationRequested

    // Only this class casts read-only futures back to completion capabilities.
    var Bool cancellationRequested
    var Bool started
    var Bool running
    var Int sourceCount
    var Int artifactCount
    var Int diagnosticCount
    var ParserDiagnostic parserDiagnostic
    protected recordParserDiagnostic(ParserDiagnostic diagnostic) { parserDiagnostic = diagnostic }
    var BindingDiagnostic bindingDiagnostic
    protected recordBindingDiagnostic(BindingDiagnostic diagnostic) { bindingDiagnostic = diagnostic }
    var String terminalDiagnostic
    var Int packagePeakActiveReads
    var Int packagePeakRetainedReads
    protected recordPackageReadPeaks(Int active, Int retained) {
        packagePeakActiveReads = active
        packagePeakRetainedReads = retained
    }
    var CompilerReuseEvidence reuseEvidence = CompilerReuseEvidence()
    protected recordReuse(CompilerReuseEvidence evidence) { reuseEvidence = evidence }

    var Future<ExecutorTaskResult> task
    var Future.CompletableFuture<ExecutorTaskResult> packageCallbackSettlement = Future.create<ExecutorTaskResult>()
    var Bool packageCallbackEntered

    // Source scheduling owns a bounded window, never the package binder/linker.
    visible Int activeSourceCount => activeSources
    /** Unsubmitted identities in the scheduler queue, excluding executor reservations. */
    visible Int queuedSourceCount => sourceWindow.count - submittedSources - completedSources
    /** Submitted reservations include executor-queued actions until settlement. */
    visible Int inFlightSourceCount => submittedSources
    /** Scheduler-owned generated characters only; excludes sinks and artifact delivery buffers. */
    visible Long retainedSourceCodeCharacters => countRetainedSourceCodeCharacters()
    visible Int retainedSourceCount => sourceWindow.count
    visible Int peakActiveSourceCount => peakActiveSources
    visible Int peakRetainedSourceCount => peakRetainedSources

    var Bool sourceScheduling
    var Int activeSources
    var Int submittedSources
    var Int completedSources
    var Int peakActiveSources
    var Int peakRetainedSources
    var SourceWork[] sourceWindow = SourceWork[]
    var Future.CompletableFuture<Bool> sourceChanged = Future.create<Bool>()

    countRetainedSourceCodeCharacters() -> Long {
        var Long characters
        for (work in sourceWindow) {
            if (work.code != null) characters += work.code.count
        }
        return characters
    }

    class SourceWork {
        visible String identity
        visible var Future<ExecutorTaskResult> handle
        visible Future.CompletableFuture<ExecutorTaskResult> callbackSettlement = Future.create<ExecutorTaskResult>()
        visible var Bool submitted
        visible var Bool entered
        visible var Bool settled
        visible var Bool published
        visible var String code
        visible var String diagnostic
        public construct(String identity) {
            this.identity = identity
        }
    }

    protected startSources(
        CompilerEngine engine,
        Executor executor,
        FlatEs6SourceCompiler compiler,
        CompilerSourceProvider provider,
        String[] identities,
        CompilerArtifactSink sink,
        Int maxActive,
        Int maxQueued
    ) {
        sourceScheduling = true
        enter()
        let coordinator = Future.from<ExecutorTaskResult>(async {
            try {
                scheduleSources(engine, executor, compiler, provider, identities, sink, maxActive, maxQueued)
                return ExecutorTaskResult(completed: true)
            } catch (Exception error) {
                // Infrastructure failure stops admission; source failures are values.
                recordFailure(error.message)
                cancel()
                drainSourceWorkers()
                return ExecutorTaskResult(completed: true)
            } finally {
                sourceWindow.clear()
                activeSources = 0
                submittedSources = 0
                completedSources = 0
                sourceScheduling = false
                if (!sourceChanged.completed) sourceChanged.complete(false)
            }
        })$
        attach(coordinator)
    }

    async scheduleSources(
        CompilerEngine engine,
        Executor executor,
        FlatEs6SourceCompiler compiler,
        CompilerSourceProvider provider,
        String[] identities,
        CompilerArtifactSink sink,
        Int maxActive,
        Int maxQueued
    ) {
        var Int next
        while (!cancelled && (next < identities.count || sourceWindow.isNotEmpty)) {
            // Only bounded identities/outcomes are admitted. The existing provider
            // finite identity array is not copied into an additional task backlog.
            while (!cancelled && next < identities.count && sourceWindow.count < maxActive + maxQueued) {
                let queued = sourceWindow.count - submittedSources - completedSources
                if (queued >= maxActive - submittedSources + maxQueued) break
                sourceWindow.add(SourceWork(identities[next]))
                next++
                peakRetainedSources = Math.max(peakRetainedSources, sourceWindow.count)
            }
            for (work in sourceWindow) {
                if (cancelled || submittedSources >= maxActive) break
                if (!work.submitted && !work.settled) {
                    work.submitted = true
                    submittedSources++
                    try {
                        work.handle = executor.submit({ compileSource(work, compiler, provider) })$
                        if (cancelled && !work.entered) work.handle.cancel()
                        observeSource(work)$
                    } catch (Exception error) {
                        // A submit implementation may enter the callback before throwing.
                        // Preserve its reservation until callback-local cleanup settles.
                        if (work.entered) {
                            work.handle = work.callbackSettlement
                            observeSource(work)$
                        } else {
                            work.settled = true
                            submittedSources--
                            completedSources++
                        }
                        throw error
                    }
                }
            }
            // Emit every ready artifact, not only the earliest source. No ordered
            // artifact commit barrier. One pump owns the sink and awaited sends.
            for (work in sourceWindow) {
                if (cancelled) break
                if (work.settled && !work.published) {
                    work.published = true
                    if (work.code != null) {
                        let artifact = CompilerArtifact(work.identity + ".js", work.code)
                        try {
                            sink.write(artifact)
                            recordArtifact()
                        } catch (Exception error) {
                            work.diagnostic = "Failed to compile '#{work.identity}': #{error.message}"
                        }
                        work.code = null
                        if (work.diagnostic == null) {
                            engine.publishArtifact(this, artifact)
                            if (!cancelled) engine.publishProgress(this, "Compiled #{work.identity}")
                        }
                    }
                }
            }
            // Named diagnostic-ordering window: retire only a sealed source prefix.
            // Already ready B artifacts above are never held behind gated A.
            while (!cancelled && sourceWindow.isNotEmpty && sourceWindow.first.settled &&
                sourceWindow.first.published) {
                let work = sourceWindow.first
                if (work.diagnostic != null) engine.publishDiagnostic(this, work.diagnostic)
                sourceWindow.remove(0)
                completedSources--
            }
            if (cancelled) break
            if (sourceWindow.isEmpty) continue
            if (next < identities.count && sourceWindow.count < maxActive + maxQueued) continue
            if (sourceWindow.any((work) => !work.submitted && !work.settled) && submittedSources < maxActive) continue
            let changed = sourceChanged
            changed.get()
            sourceChanged = Future.create<Bool>()
        }
        if (cancelled) drainSourceWorkers()
    }

    async compileSource(SourceWork work, FlatEs6SourceCompiler compiler, CompilerSourceProvider provider) {
        if (cancelled) return
        work.entered = true
        activeSources++
        peakActiveSources = Math.max(peakActiveSources, activeSources)
        try {
            let source = provider.load(work.identity)
            if (cancelled) return
            if (!source) throw Exception("Missing source '#{work.identity}'")
            if (source.identity != work.identity) {
                throw Exception("Loaded source identity does not match '#{work.identity}'")
            }
            let code = compiler.compile(source)
            if (!cancelled) work.code = code
        } catch (Exception error) {
            if (!cancelled) work.diagnostic = "Failed to compile '#{work.identity}': #{error.message}"
        } finally {
            activeSources--
            work.callbackSettlement.complete(ExecutorTaskResult(completed: true))
        }
    }

    async observeSource(SourceWork work) {
        try {
            let result = work.handle.get()
            if (!cancelled && (result.capacityExceeded || result.failed)) {
                throw Exception(result.failed ? result.error.message : "Compiler executor capacity exceeded")
            }
        } catch (Exception error) {
            if (!cancelled) {
                recordFailure(error.message)
                cancel()
            }
        } finally {
            work.settled = true
            submittedSources--
            completedSources++
            signalSourceChange()
        }
    }

    signalSourceChange() {
        if (!sourceChanged.completed) sourceChanged.complete(true)
    }

    async drainSourceWorkers() {
        for (work in sourceWindow) {
            if (work.handle && !work.entered && !work.settled) work.handle.cancel()
        }
        while (submittedSources > 0) {
            let changed = sourceChanged
            changed.get()
            sourceChanged = Future.create<Bool>()
        }
    }

    protected enterPackageCallback() {
        packageCallbackEntered = true
        enter()
    }

    protected settlePackageCallback() {
        packageCallbackSettlement.complete(ExecutorTaskResult(completed: true))
    }

    protected failPackageSubmission(Exception error) {
        recordFailure(error.message)
        if (packageCallbackEntered) {
            cancel()
            attach(packageCallbackSettlement)
        } else {
            finish()
        }
    }

    protected begin(Int sources) {
        if (started || completion.completed) throw Exception("Compiler session can only be started once")
        if (cancelled) return
        started = true
        sourceCount = sources
    }

    protected enter() { running = true }
    protected recordArtifact() { artifactCount++ }
    protected recordFailure(String message) {
        diagnosticCount++
        terminalDiagnostic = message
    }

    protected attach(Future<ExecutorTaskResult> submitted) {
        task = submitted
        // A custom executor may invoke cancellation reentrantly during submit,
        // before returning its queued handle. Do not leave that admission behind.
        // A source scheduler owns multiple handles and a coordinator. Do not
        // cancel that coordinator future: settlement is cleanup evidence.
        if (cancelled && !running && !sourceScheduling) task.cancel()
        observeTask()$
    }

    async observeTask() {
        try {
            let result = task.get()
            running = false
            if (!completion.completed) {
                if (result.capacityExceeded || result.failed) {
                    diagnosticCount++
                    terminalDiagnostic = result.failed ? result.error.message : "Compiler executor capacity exceeded"
                }
                finish()
            }
        } catch (Exception error) {
            running = false
            if (!completion.completed) {
                if (!cancelled) {
                    diagnosticCount++
                    terminalDiagnostic = error.message
                }
                finish()
            }
        }
    }

    public cancel() {
        if (cancelled || completion.completed) return
        cancellationRequested = true
        // Drop unpublished outcomes immediately; running workers still own cleanup.
        for (work in sourceWindow) work.code = null
        closeChannels()
        if (sourceScheduling) {
            for (work in sourceWindow) {
                if (work.handle && !work.entered && !work.settled) work.handle.cancel()
            }
            signalSourceChange()
            return
        }
        // Executor future cancellation only removes queued work. It does not
        // interrupt an already running action, so never use it as cleanup proof.
        // running is set before the first engine load/compile call, and remains
        // true until the submitted task settles, even if cancellation occurs
        // reentrantly before submit returns and attach receives the task handle.
        if (!running) {
            if (task) task.cancel()
            finish()
        }
    }

    protected finish() {
        if (completion.completed) return
        running = false
        // Normal completion has no pending sends: the engine awaited acceptance.
        // close drains accepted buffered values; it does not discard them. Cancel
        // deliberately rejects a still-pending notification, never a sink commit.
        closeChannels()
        if (!artifactBackpressure.completed) {
            let completionSignal = (Future.CompletableFuture<Bool>)artifactBackpressure
            completionSignal.complete(false)
        }
        let terminal = (Future.CompletableFuture<CompilationSummary>)completion
        terminal.complete(CompilationSummary(
            sourceCount, artifactCount, diagnosticCount, cancelled, terminalDiagnostic,
            reuseEvidence, peakActiveSources, peakRetainedSources, true,
            packagePeakActiveReads, packagePeakRetainedReads, bindingDiagnostic, parserDiagnostic
        ))
    }

    protected recordArtifactBackpressure() {
        if (!artifactBackpressure.completed) {
            let completionSignal = (Future.CompletableFuture<Bool>)artifactBackpressure
            completionSignal.complete(true)
        }
    }

    closeChannels() {
        diagnostics.close()
        progress.close()
        artifacts.close()
    }
}
