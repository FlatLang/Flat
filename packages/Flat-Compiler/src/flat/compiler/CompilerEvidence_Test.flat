package flat/compiler

import flat/lexer
import flat/parser/flat
import flat/parser/ParserDiagnostic
import flat/compiler/models
import flat/io
import flat/time/Time
import flat/writer/es6/bound
import flat/future

/** Evidence is a report of observations, never a substitute for acceptance. */
testable class {
    test `infrastructure selection is explicit and default remains full`() {
        expect(Compiler_TestSuite.infrastructureRequested(String[])).toBe(false)
        expect(Compiler_TestSuite.infrastructureRequested(["test.js"])).toBe(false)
        expect(Compiler_TestSuite.infrastructureRequested(["test.js", "--infrastructure"])).toBe(true)
        expect(Compiler_TestSuite.infrastructureRequested(["test.js", "infrastructure"])).toBe(false)
    }

    test `control characters retain both hexadecimal digits in diagnostic JSON`() {
        expect(CompilerEvidence.quote("\n")).toBe("\"\\u000a\"")
        expect(CompilerEvidence.quote("\t\r")).toBe("\"\\u0009\\u000d\"")
        let escaped = CompilerEvidence.quote("quote\" slash\\ newline\n")
        expect(escaped).toBe("\"quote\\\" slash\\\\ newline\\u000a\"")
    }

    class SuspendedSourceProvider extends CompilerSourceProvider {
        visible var Bool entered
        visible var Bool settled
        visible Future.CompletableFuture<Bool> release = Future.create<Bool>()
        override public async load(String identity) -> CompilerSource {
            entered = true
            release.get()
            settled = true
            return CompilerSource(identity, "class Main {}")
        }
    }

    async test `base source provider awaits a suspended override before reading identity`() {
        let controlled = SuspendedSourceProvider()
        CompilerSourceProvider provider = controlled
        let pending = Future.from<CompilerSource>(async { return provider.load("Main.flat") })$
        expect(controlled.entered).toBe(true)
        expect(controlled.settled).toBe(false)
        expect(pending.completed).toBe(false)
        controlled.release.complete(true)
        let loaded = pending.get()
        expect(controlled.settled).toBe(true)
        expect(loaded.identity).toBe("Main.flat")
        expect(loaded.text).toBe("class Main {}")
    }
    async test `package scanner failure retains actual parser range in terminal evidence`() {
        let text = "class DogfoodInvalidSyntax {\n"
        let identity = "Invalid.flat"
        let snapshot = SourceSnapshotIdentity(SourceIdentity(identity), "compiler-input")
        let lexer = Lexer().lexInterpolated(text)
        lexer.emit("start")
        let tokens = lexer.consumeAll<Token>("data")
        var ParseFailure expected
        try { FlatSourceTypePartitioner().partition(tokens, snapshot, "js") }
        catch (Exception error) {
            if (error.class.isOfType(ParseFailure.class)) expected = (ParseFailure)error
            else throw error
        }
        expect(expected != null).toBe(true)
        let sink = MemoryCompilerArtifactSink()
        let session = CompilerEngine().compilePackage(
            MemoryCompilerSourceProvider([CompilerSource(identity, text)]), sink, "invalid.js")
        let summary = session.completion.get()
        expect(summary.diagnosticCount).toBe(1)
        expect(summary.bindingDiagnostic == null).toBe(true)
        expect(summary.parserDiagnostic.code).toBe("incomplete-type-body")
        let range = summary.parserDiagnostic.range
        let expectedRange = expected.diagnostic.range
        expect(range.snapshot.source.value).toBe(identity)
        expect(range.startTokenIndex).toBe(expectedRange.startTokenIndex)
        expect(range.endTokenIndex).toBe(expectedRange.endTokenIndex)
        expect(range.start.lineNumber).toBe(expectedRange.start.lineNumber)
        expect(range.start.column).toBe(expectedRange.start.column)
        expect(range.end.lineNumber).toBe(expectedRange.end.lineNumber)
        expect(range.end.column).toBe(expectedRange.end.column)
        expect(sink.artifacts().count).toBe(0)
        let batch = CompilerEvidence.renderDiagnostics(summary, "sha256:admitted-input")
        expect(batch.contains("\"complete\":true")).toBe(true)
        expect(batch.contains("\"code\":\"incomplete-type-body\"")).toBe(true)
    }

    async test `primitive parser failure is not replaced by linker presentation text`() {
        let text = "class Main { public broken( }"
        let sink = MemoryCompilerArtifactSink()
        let session = CompilerEngine().compilePackage(
            MemoryCompilerSourceProvider([CompilerSource("Broken.flat", text)]), sink, "invalid.js")
        let summary = session.completion.get()
        expect(summary.diagnosticCount).toBe(1)
        expect(summary.parserDiagnostic != null).toBe(true)
        expect(summary.bindingDiagnostic == null).toBe(true)
        expect(summary.parserDiagnostic.range != null).toBe(true)
        expect(sink.artifacts().count).toBe(0)
        let batch = CompilerEvidence.renderDiagnostics(summary, "sha256:input")
        expect(batch.contains("\"complete\":true")).toBe(true)
    }

    test `unranged and multiple parser failures remain incomplete`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("Invalid.flat"), "input")
        let diagnostic = ParserDiagnostic("syntax-error", "invalid syntax", snapshot)
        let summary = CompilationSummary(1, 0, 1, false, parserDiagnostic: diagnostic)
        let batch = CompilerEvidence.renderDiagnostics(summary, "sha256:input")
        expect(batch.contains("\"complete\":false,\"records\":[]")).toBe(true)
        let multiple = CompilationSummary(1, 0, 2, false, parserDiagnostic: diagnostic)
        let multipleBatch = CompilerEvidence.renderDiagnostics(multiple, "sha256:input")
        expect(multipleBatch.contains("\"complete\":false,\"records\":[]")).toBe(true)
    }
    test `terminal failure is distinct from source diagnostics`() {
        let summary = CompilationSummary(1, 1, 0, false)
        let batch = CompilerEvidence.renderDiagnostics(summary, "sha256:input", "Output published; cleanup failed: controlled\nerror")
        expect(batch.contains("\"complete\":false,\"records\":[]")).toBe(true)
        expect(batch.contains("\"diagnosticCount\":0")).toBe(true)
        expect(batch.contains("\"terminalFailure\":\"Output published; cleanup failed: controlled\\u000aerror\"")).toBe(true)
        expect(batch.contains("\"source\":")).toBe(false)
        expect(batch.contains("children_reaped")).toBe(false)
        expect(batch.contains("temporary_outputs_removed")).toBe(false)
    }

    test `untyped failure remains incomplete and retains bounded failure text`() {
        let batch = CompilerEvidence.renderDiagnostics(
            CompilationSummary(1, 0, 1, false, "source read failed"), "sha256:input")
        expect(batch.contains("\"complete\":false,\"records\":[]")).toBe(true)
        expect(batch.contains("\"terminalFailure\":\"source read failed\"")).toBe(true)
        expect(batch.contains("\"diagnosticCount\":1")).toBe(true)
    }

    test `unsettled cleanup cannot advertise complete diagnostics`() {
        let summary = CompilationSummary(1, 0, 0, false, cleanupSettled: false)
        let batch = CompilerEvidence.renderDiagnostics(summary, "sha256:input")
        let receipt = CompilerEvidence.render(summary)
        expect(batch.contains("\"complete\":false")).toBe(true)
        expect(receipt.contains("\"diagnostics\":{\"complete\":false")).toBe(true)
    }

    test `successful terminal batch has no invented cleanup observations`() {
        let batch = CompilerEvidence.renderDiagnostics(CompilationSummary(1, 1, 0, false), "sha256:input")
        expect(batch.contains("\"complete\":true,\"records\":[]")).toBe(true)
        expect(batch.contains("\"terminalFailure\":null")).toBe(true)
        expect(batch.contains("children_reaped")).toBe(false)
        expect(batch.contains("temporary_outputs_removed")).toBe(false)
    }
}
