package flat/compiler

import flat/io
import flat/system
import flat/time/Time
import flat/compiler/models
import flat/lexer
import flat/parser/flat
import flat/writer/es6/bound

/** Public package API acceptance, separate from direct linker feature tests. */
testable class {
    /** Requires separately bootstrapped flatc and Airship artifacts; never builds this suite recursively. */
    async test `Airship Flat runtime builds a real package executable and Node runs its production dependency`() {
        let airship = File("../Airship/dist/airship.js")
        let compiler = File("dist/es6/index.js")
        if (!airship.isFile || !compiler.isFile) {
            throw Exception("Package executable acceptance requires explicit Airship and flatc bootstrap artifacts")
        }
        let root = File(".flat-compiler-airship-package-test-#{Time.currentTimeMillis}")
        let sources = File(root, "src")
        Es6ArtifactFiles.ensureDirectory(sources)
        try {
            // A normal package retains Airship's implicit real Flat-Core dependency.
            // Do not trim dependency sources or replace production implementations.
            Es6ArtifactCommitter().commit(File(root, "flat.json"),
                "{\"name\":\"Compiler executable acceptance\",\"version\":\"0.1.0\",\"defaultTarget\":\"es6\",\"sources\":{\"main\":{\"source\":\"src\",\"mainClass\":\"app/Main\",\"dependencies\":{}}}}")
            var String reference = ""
            reference += '#'
            reference += "{Char.repeat('a', 3)}"
            Es6ArtifactCommitter().commit(File(sources, "Main.flat"),
                "package app\nimport flat/primitive/number/Char\nclass Main { public static main() { external js { console.log(" + reference + "); } } }")
            // Explicit finite acceptance budgets include the real core partition;
            // production CLI defaults are neither bypassed nor raised globally.
            let installed = System.execute([
                "node", airship.normalizedLocation, "--use-links", "-f", root.normalizedLocation,
                "--flatc-runtime", "flat", "install", "-t", "es6", "--",
                "--max-sources", "128", "--max-types", "512"
            ], silent: true, shell: false)
            if (installed.exitCode != 0) {
                throw Exception("Airship Flat runtime package install failed: " + installed.stdout.join("") + installed.stderr.join(""))
            }
            let output = File(root, "dist/es6/index.js")
            expect(output.isFile).toBe(true)
            let executed = System.execute(["node", output.normalizedLocation], silent: true, shell: false)
            if (executed.exitCode != 0) throw Exception(executed.stderr.join(""))
            expect(executed.stdout.join("")).toBe("aaa\n")
        } finally {
            Es6ArtifactFiles.remove(root)
        }
    }

    realSources() -> CompilerSource[] {
        CompilerSource[] values = [
        CompilerSource("flat/primitive/number/Char.flat", Es6ArtifactFiles.read(
            File("../Flat-Core/src/flat/primitive/number/Char.flat"))),
        CompilerSource("flat/primitive/number/Number.flat", Es6ArtifactFiles.read(
            File("../Flat-Core/src/flat/primitive/number/Number.flat"))),
        CompilerSource("flat/primitive/number/Integer.flat", Es6ArtifactFiles.read(
            File("../Flat-Core/src/flat/primitive/number/Integer.flat"))),
        CompilerSource("flat/primitive/Primitive.flat", Es6ArtifactFiles.read(
            File("../Flat-Core/src/flat/primitive/Primitive.flat")))
        ]
        return Compiler_Test.admitCoreDependencies(values)
    }

    async test `public package API executes unchanged production Char behavior`() {
        let sources = realSources()
        let sink = MemoryCompilerArtifactSink()
        let session = Compiler().compilePackage(
            MemoryCompilerSourceProvider(sources), sink, "core/characters.js"
        )
        let summary = session.completion.get()
        expect(summary.sourceCount).toBe(sources.count)
        expect(summary.artifactCount).toBe(1)
        expect(summary.diagnosticCount).toBe(0)
        expect(summary.cancelled).toBe(false)
        expect(summary.packageDiagnostic == null).toBe(true)
        expect(session.artifacts.closed).toBe(true)
        expect(session.diagnostics.closed).toBe(true)
        expect(session.progress.closed).toBe(true)
        expect(sink.artifacts().count).toBe(1)
        expect(sink.artifacts().first.identity).toBe("core/characters.js")

        // Derive invocation names from unchanged source identities, not generated text.
        let source = sources.first
        let stream = Lexer().lexInterpolated(source.text)
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(SourceIdentity(source.identity), "compiler-input")
        let partition = FlatSourceTypePartitioner().partition(
            stream.consumeAll<Token>("data"), snapshot, "js"
        ).first
        let syntax = PrimitiveClassParser().parse(
            partition.tokenValues(), snapshot, partition.startTokenIndex, "Char"
        )
        let owner = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", syntax.range.startTokenIndex), "class", "Char"
        )
        var PrimitiveFunctionSyntax whitespace
        var PrimitiveFunctionSyntax repeat
        for (method in syntax.methodValues()) {
            if (method.name == "isWhitespace" && method.staticMethod) whitespace = method
            if (method.name == "repeat" && method.staticMethod) repeat = method
        }
        let whitespaceIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "static-method", whitespace.range.startTokenIndex),
            "static-method", "isWhitespace"
        )
        let repeatIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "static-method", repeat.range.startTokenIndex),
            "static-method", "repeat"
        )
        let className = Es6NameMangler.mangle(owner.value)
        let whitespaceName = Es6NameMangler.mangle(whitespaceIdentity.value)
        let repeatName = Es6NameMangler.mangle(repeatIdentity.value)
        let root = File(".flat-compiler-package-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(destination, sink.artifacts().first.code +
            "console.log(" + className + "." + whitespaceName + "(' '));\n" +
            "console.log(" + className + "." + whitespaceName + "('\\t'));\n" +
            "console.log(" + className + "." + whitespaceName + "('x'));\n" +
            "console.log(" + className + "." + repeatName + "('a', 3));\n")
        let response = System.execute(["node", destination.normalizedLocation], silent: true, shell: false)
        Es6ArtifactFiles.remove(root)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("true\ntrue\nfalse\naaa\n")
    }

    async test `package artifact is independent of provider order`() {
        let sources = realSources()
        let forward = MemoryCompilerArtifactSink()
        let backward = MemoryCompilerArtifactSink()
        let compiler = Compiler()
        let first = compiler.compilePackage(MemoryCompilerSourceProvider(sources), forward, "core.js")
        let reversed = CompilerSource[]
        var Int index = sources.count
        while (index > 0) {
            index--
            reversed.add(sources[index])
        }
        let second = compiler.compilePackage(MemoryCompilerSourceProvider(reversed), backward, "core.js")
        expect(first.completion.get().diagnosticCount).toBe(0)
        expect(second.completion.get().diagnosticCount).toBe(0)
        expect(forward.artifacts().first.identity).toBe(backward.artifacts().first.identity)
        expect(forward.artifacts().first.code).toBe(backward.artifacts().first.code)
    }

    namespaceSources(String imports) -> CompilerSource[] {
        CompilerSource[] sources = [
            CompilerSource("alpha/Widget.flat", "package alpha\nclass Widget { public value() -> Int { return 11; } }"),
            CompilerSource("beta/Widget.flat", "package beta\nclass Widget { public value() -> Int { return 22; } }"),
            CompilerSource("app/Consumer.flat", "package app\n" + imports +
                "\nclass Consumer { public static run() -> Int { let value = Widget(); return value.value(); } }")
        ]
        return sources
    }

    async test `package namespaces execute explicitly imported same name declaration deterministically`() {
        let sources = namespaceSources("import beta/Widget")
        let compiler = Compiler()
        let forward = MemoryCompilerArtifactSink()
        let backward = MemoryCompilerArtifactSink()
        let first = compiler.compilePackage(MemoryCompilerSourceProvider(sources), forward, "namespace.js")
        CompilerSource[] reversed = [sources[2], sources[1], sources[0]]
        let second = compiler.compilePackage(MemoryCompilerSourceProvider(reversed), backward, "namespace.js")
        expect(first.completion.get().diagnosticCount).toBe(0)
        expect(second.completion.get().diagnosticCount).toBe(0)
        expect(forward.artifacts().count).toBe(1)
        expect(forward.artifacts().first.code).toBe(backward.artifacts().first.code)

        let source = sources[2]
        let snapshot = SourceSnapshotIdentity(SourceIdentity(source.identity), "compiler-input")
        let stream = Lexer().lex(source.text)
        stream.emit("start")
        let partition = FlatSourceTypePartitioner().partition(
            stream.consumeAll<Token>("data"), snapshot, "js"
        ).first
        expect(partition.packageName).toBe("app")
        expect(partition.importNames()).toBe(["beta/Widget"])
        let syntax = PrimitiveClassParser().parse(
            partition.tokenValues(), snapshot, partition.startTokenIndex, "Consumer"
        )
        let owner = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "class", syntax.range.startTokenIndex),
            "class", "Consumer")
        let method = syntax.methodValues().first
        let entry = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "static-method", method.range.startTokenIndex),
            "static-method", "run")
        let root = File(".flat-compiler-namespace-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let output = File(root, "program.js")
        Es6ArtifactCommitter().commit(output, forward.artifacts().first.code +
            "console.log(" + Es6NameMangler.mangle(owner.value) + "." + Es6NameMangler.mangle(entry.value) + "());\n")
        let response = System.execute(["node", output.normalizedLocation], silent: true, shell: false)
        Es6ArtifactFiles.remove(root)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("22\n")
    }

    async test `missing explicit import does not select an unrelated same name declaration`() {
        let sources = namespaceSources("import missing/Widget")
        let sink = MemoryCompilerArtifactSink()
        let session = Compiler().compilePackage(MemoryCompilerSourceProvider(sources), sink, "namespace.js")
        let summary = session.completion.get()
        expect(summary.diagnosticCount).toBe(1)
        expect(summary.artifactCount).toBe(0)
        expect(sink.artifacts().count).toBe(0)
        expect(summary.packageDiagnostic.contains("missing/Widget")).toBe(true)
        expect(summary.packageDiagnostic.contains("app/Consumer.flat")).toBe(true)
    }

    async test `conflicting explicit imports diagnose canonical ambiguity independent of source order`() {
        let sources = namespaceSources("import alpha/Widget\nimport beta/Widget")
        let forward = MemoryCompilerArtifactSink()
        let backward = MemoryCompilerArtifactSink()
        let compiler = Compiler()
        let first = compiler.compilePackage(MemoryCompilerSourceProvider(sources), forward, "namespace.js")
        CompilerSource[] reversed = [sources[2], sources[1], sources[0]]
        let second = compiler.compilePackage(MemoryCompilerSourceProvider(reversed), backward, "namespace.js")
        let diagnostic = first.completion.get().packageDiagnostic
        expect(first.completion.get().diagnosticCount).toBe(1)
        expect(second.completion.get().packageDiagnostic).toBe(diagnostic)
        expect(forward.artifacts().count).toBe(0)
        expect(backward.artifacts().count).toBe(0)
        expect(diagnostic.toLowerCase().contains("ambiguous")).toBe(true)
        expect(diagnostic.contains("app/Consumer.flat")).toBe(true)
        let alpha = diagnostic.indexOf("alpha/Widget", defaultReturnValue: -1)
        let beta = diagnostic.indexOf("beta/Widget", defaultReturnValue: -1)
        expect(alpha >= 0).toBe(true)
        expect(beta > alpha).toBe(true)
    }

    async test `source import forms retain typed diagnostics and actual consumer location`() {
        String[] importForms = ["import static beta/Widget", "import beta/Widget as Chosen"]
        for (importText in importForms) {
            let sources = namespaceSources(importText)
            let sink = MemoryCompilerArtifactSink()
            let session = Compiler().compilePackage(MemoryCompilerSourceProvider(sources), sink, "namespace.js")
            let summary = session.completion.get()
            expect(summary.diagnosticCount).toBe(1)
            expect(summary.artifactCount).toBe(0)
            expect(sink.artifacts().count).toBe(0)
            let code = importText.contains("static")
                ? "binding.import-static-unsupported" : "binding.import-alias-unsupported"
            expect(summary.packageDiagnostic.contains(code)).toBe(true)
            expect(summary.packageDiagnostic.contains("beta/Widget")).toBe(true)
            expect(summary.packageDiagnostic.contains("app/Consumer.flat:2:1")).toBe(true)
        }
    }

    async test `package parsing failure stops loading unrelated later source text`() {
        let provider = TrackingPackageSourceProvider()
        let sink = MemoryCompilerArtifactSink()
        let session = Compiler().compilePackage(provider, sink, "core.js")
        let summary = session.completion.get()
        expect(summary.sourceCount).toBe(2)
        expect(summary.diagnosticCount).toBe(1)
        expect(summary.artifactCount).toBe(0)
        expect(provider.loaded.count).toBe(1)
        expect(provider.loaded.first).toBe("a-broken.flat")
        expect(sink.artifacts().count).toBe(0)
    }

    async test `configured package capacity accepts more than sixty four sources deterministically`() {
        let sources = CompilerSource[]
        var Int index
        while (index < 65) {
            sources.add(CompilerSource("source-#{index}.flat", "class Type#{index} {}"))
            index++
        }
        let compiler = Compiler(CompilerEngine(packageLinker: FlatEs6PackageLinker(maxSources: 65)))
        let forward = MemoryCompilerArtifactSink()
        let backward = MemoryCompilerArtifactSink()
        let first = compiler.compilePackage(MemoryCompilerSourceProvider(sources), forward, "types.js")
        let reversed = sources.sort({ _b.identity.compareTo(_a.identity) })
        let second = compiler.compilePackage(MemoryCompilerSourceProvider(reversed), backward, "types.js")
        expect(first.completion.get().sourceCount).toBe(65)
        expect(first.completion.get().diagnosticCount).toBe(0)
        expect(second.completion.get().diagnosticCount).toBe(0)
        expect(forward.artifacts().first.code).toBe(backward.artifacts().first.code)
    }

    async test `package source capacity and duplicate identities reject without artifacts`() {
        let sources = realSources()
        let bounded = Compiler(CompilerEngine(packageLinker: FlatEs6PackageLinker(maxSources: 3)))
        let sink = MemoryCompilerArtifactSink()
        var Bool capacityRejected
        try {
            bounded.compilePackage(MemoryCompilerSourceProvider(sources), sink, "core.js")
        } catch (Exception error) { capacityRejected = true }
        expect(capacityRejected).toBe(true)
        expect(sink.artifacts().count).toBe(0)
        var Bool duplicateRejected
        try {
            CompilerSource[] duplicates = [sources.first, sources.first]
            Compiler().compilePackage(MemoryCompilerSourceProvider(duplicates), sink, "core.js")
        } catch (Exception error) { duplicateRejected = true }
        expect(duplicateRejected).toBe(true)
        expect(sink.artifacts().count).toBe(0)
        var Bool emptyRejected
        try {
            Compiler().compilePackage(MemoryCompilerSourceProvider(CompilerSource[]), sink, "core.js")
        } catch (Exception error) { emptyRejected = true }
        expect(emptyRejected).toBe(true)
    }

    async test `package artifact identity cannot escape sink root`() {
        let sources = MemoryCompilerSourceProvider(realSources())
        String[] unsafeIdentities = ["", "/core.js", "../core.js", "core/../out.js", "./core.js",
            "core//out.js", "core/", "C:/core.js", "core\\out.js"]
        for (identity in unsafeIdentities) {
            let sink = MemoryCompilerArtifactSink()
            var Bool rejected
            try {
                Compiler().compilePackage(sources, sink, identity)
            } catch (Exception error) { rejected = true }
            expect(rejected).toBe(true)
            expect(sink.artifacts().count).toBe(0)
        }
    }

    test `legacy summary constructor has no retained package diagnostic`() {
        let summary = CompilationSummary(2, 2, 0, false)
        expect(summary.packageDiagnostic == null).toBe(true)
    }

    async test `missing package source returns diagnostic without partial artifact`() {
        let sink = MemoryCompilerArtifactSink()
        let session = Compiler().compilePackage(MissingPackageSourceProvider(), sink, "core.js")
        let summary = session.completion.get()
        expect(summary.sourceCount).toBe(1)
        expect(summary.packageDiagnostic).toBe("Failed to compile package 'core.js': Missing source 'missing.flat'")
        expect(summary.artifactCount).toBe(0)
        expect(summary.diagnosticCount).toBe(1)
        expect(sink.artifacts().count).toBe(0)
        expect(session.diagnostics.closed).toBe(true)
        expect(session.artifacts.closed).toBe(true)
        expect(session.progress.closed).toBe(true)
    }

    async test `cleanup crossing foreach continue returns source diagnostic without artifacts`() {
        let identity = "app/Cleanup.flat"
        let source = "class Cleanup { static run() -> Int {\n" +
            "for (i in 0..2) { try { continue; } finally { let done = 1; } }\n" +
            "return 0; } }"
        let sink = MemoryCompilerArtifactSink()
        let session = Compiler().compilePackage(
            MemoryCompilerSourceProvider([CompilerSource(identity, source)]), sink, "cleanup.js"
        )
        let summary = session.completion.get()
        expect(summary.diagnosticCount).toBe(1)
        expect(summary.artifactCount).toBe(0)
        expect(sink.artifacts().count).toBe(0)
        expect(session.diagnostics.closed).toBe(true)
        expect(session.artifacts.closed).toBe(true)
        expect(summary.packageDiagnostic.contains("semantic.cleanup-crossing-continue")).toBe(true)
        expect(summary.packageDiagnostic.contains("app/Cleanup.flat:2:25")).toBe(true)
        expect(summary.packageDiagnostic.contains("Foreach continue through try/catch/finally")).toBe(true)
    }

    async test `package link failure returns diagnostic without partial artifact`() {
        let sources = realSources()
        sources.add(CompilerSource("broken.flat", "class Broken {"))
        var String expectedDiagnostic
        try {
            FlatEs6PackageLinker().link(sources)
        } catch (Exception error) {
            expectedDiagnostic = "Failed to compile package 'core.js': #{error.message}"
        }
        expect(expectedDiagnostic != null).toBe(true)
        let sink = MemoryCompilerArtifactSink()
        let session = Compiler().compilePackage(MemoryCompilerSourceProvider(sources), sink, "core.js")
        let summary = session.completion.get()
        expect(summary.sourceCount).toBe(sources.count)
        expect(summary.packageDiagnostic).toBe(expectedDiagnostic)
        expect(summary.artifactCount).toBe(0)
        expect(summary.diagnosticCount).toBe(1)
        expect(sink.artifacts().count).toBe(0)
        expect(session.completion.completed).toBe(true)
    }
}

/** Test-only provider proving that parse failure does not preload the partition. */
class TrackingPackageSourceProvider extends CompilerSourceProvider {
    visible String[] loaded = String[]
    override public identities() -> String[] {
        String[] values = ["a-broken.flat", "z-later.flat"]
        return values
    }
    override public load(String identity) -> CompilerSource {
        loaded.add(identity)
        return CompilerSource(identity, identity == "a-broken.flat" ? "class Broken {" : "class Later {}")
    }
}

/** Test-only provider exercising an identity whose source cannot be loaded. */
class MissingPackageSourceProvider extends CompilerSourceProvider {
    override public identities() -> String[] {
        String[] values = ["missing.flat"]
        return values
    }
}
