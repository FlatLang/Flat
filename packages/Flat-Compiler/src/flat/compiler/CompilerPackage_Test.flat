    public static async assertRuntimeClassNameExecution() {
        var String interpolation = ""
        interpolation += '#'
        interpolation += '{'
        let textSource = "package flat\nclass String { visible native String raw; public construct(native String raw) { this.raw = raw; } }"
        let source = "package app\nimport flat/String\n" +
            "class Value { public construct() {} } " +
            "class Counter { visible Int calls = 0; public next() -> Value { calls += 1; return Value(); } } " +
            "class Main { public static consume(String value) -> Bool { external js { return " +
            interpolation + "value.raw} === 'Value'; } } " +
            "public static main() { let counter = Counter(); let accepted = consume(counter.next().class.name); " +
            "external js { console.log(" + interpolation + "counter.calls}, " + interpolation + "accepted}); } } }"
        let sink = MemoryCompilerArtifactSink()
        let summary = Compiler().compilePackage(MemoryCompilerSourceProvider([
