package flat/compiler

import flat/io
import flat/system
import flat/time/Time
import flat/compiler/models
import flat/lexer
import flat/parser/flat
import flat/writer/es6/bound
import flat/semantic/binding/primitive/PrimitiveDefaultImport

/** Public package API acceptance, separate from direct linker feature tests. */
testable class {
    /** Requires separately bootstrapped flatc and Airship artifacts; never builds this suite recursively. */
    async test `Airship Flat runtime builds a real package executable and Node runs its production dependency`() {
        let airship = File("../Airship/dist/airship.js")
        let compiler = File("dist/es6/index.js")
        if (!airship.isFile || !compiler.isFile) {
            throw Exception("Package executable acceptance requires explicit Airship and flatc bootstrap artifacts")
        }
        let root = File(".flat-compiler-airship-package-test-#{Time.currentTimeMillis}")
        let sources = File(root, "src")
        Es6ArtifactFiles.ensureDirectory(sources)
        try {
            // A normal package retains Airship's implicit real Flat-Core dependency.
            // Do not trim dependency sources or replace production implementations.
            Es6ArtifactCommitter().commit(File(root, "flat.json"),
                "{\"name\":\"Compiler executable acceptance\",\"version\":\"0.1.0\",\"defaultTarget\":\"es6\",\"sources\":{\"main\":{\"source\":\"src\",\"mainClass\":\"app/Main\",\"dependencies\":{}}}}")
            var String reference = ""
            reference += '#'
            reference += "{Char.repeat('a', 3)}"
            // Exercise the real public metadata API, including the checked null guard.
            // Setup mirrors Flat-Core's Class tests; no replacement Core types are supplied.
            var String interpolation = ""
            interpolation += '#'
            interpolation += '{'
            let metadata = "let localField = Field(\"value\"); let parentField = Field(\"value\"); " +
                "let interfaceField = Field(\"value\"); " +
                "let parent = Class(\"test/Parent\", false, Object.class, Class[], [parentField]); " +
                "let contract = Class(\"test/Contract\", true, Object.class, Class[], [interfaceField]); " +
                "let local = Class(\"test/Local\", false, parent, [contract], [localField]); " +
                "let inherited = Class(\"test/Inherited\", false, parent, [contract], Field[]); " +
                "let emptyParent = Class(\"test/EmptyParent\", false, Object.class, Class[], Field[]); " +
                "let implemented = Class(\"test/Implemented\", false, emptyParent, [contract], Field[]); " +
                "let localMatch = Object.referenceEquals(local.getField(\"value\", true), localField); " +
                "let parentMatch = Object.referenceEquals(inherited.getField(\"value\", true), parentField); " +
                "let interfaceMatch = Object.referenceEquals(implemented.getField(\"value\", true), interfaceField); " +
                "let localOnly = inherited.getField(\"value\") == null; " +
                "let missingLocal = local.getField(\"missing\") == null; " +
                "let missingAncestor = implemented.getField(\"missing\", true) == null; " +
                "let missingMetadata = Class(\"test/MissingMetadata\", false, Object.class, Class[]); " +
                "var Bool rejected = false; try { missingMetadata.getField(\"missing\", true); } " +
                "catch (NullAccessException error) { rejected = true; } " +
                "external js { console.log(" + interpolation + "localMatch}, " + interpolation + "parentMatch}, " +
                interpolation + "interfaceMatch}, " + interpolation + "localOnly}, " + interpolation + "missingLocal}, " +
                interpolation + "missingAncestor}, " + interpolation + "rejected}); } "
            Es6ArtifactCommitter().commit(File(sources, "Main.flat"),
                "package app\nimport flat/primitive/number/Char\nimport flat/meta/Class\nimport flat/meta/Field\n" +
                "import flat/exception/NullAccessException\nclass Main { public static main() { " + metadata +
                "external js { console.log(" + reference + "); } } }")
            // Explicit immutable compiler selection exercises Airship's generated-tool
            // path without implicit dependency lookup or a legacy fallback.
            let installed = System.execute([
                "node", airship.normalizedLocation, "--use-links", "-f", root.normalizedLocation,
                "--flatc-runtime", "flat", "--flatc-script", compiler.normalizedLocation,
                "install", "-t", "es6"
            ], silent: true, shell: false)
            if (installed.exitCode != 0) {
                throw Exception("Airship Flat runtime package install failed: " + installed.stdout.join("") + installed.stderr.join(""))
            }
            let output = File(root, "dist/es6/index.js")
            expect(output.isFile).toBe(true)
            let executed = System.execute(["node", output.normalizedLocation], silent: true, shell: false)
            if (executed.exitCode != 0) throw Exception(executed.stderr.join(""))
            expect(executed.stdout.join("")).toBe("true true true true true true true\naaa\n")
        } finally {
            Es6ArtifactFiles.remove(root)
        }
    }

    async test `safe nullable callback skips null receiver arguments and evaluates live receiver once`() {
        var String interpolation = ""
        interpolation += '#'
        interpolation += '{'
        let source = "package app\nclass Item { construct(visible Int code) {} " +
            "apply(Int marker, func(Item)->Bool predicate) -> Bool { external js { process.stdout.write('P'); } return predicate(this); } } " +
            "class Owner { construct(visible Item value = null) {} " +
            "get() => value { external js { process.stdout.write('R'); } } " +
            "effect() -> Int { external js { process.stdout.write('A'); } return 1; } " +
            "run(Int wanted) { let result = get()?.apply(effect(), { _.code == wanted }); " +
            "external js { console.log(" + interpolation + "result} === null ? 'null' : " + interpolation + "result}); } } } " +
            "class Main { public static main() { let empty = Owner(); empty.run(7); " +
            "let live = Owner(Item(7)); live.run(7); live.run(8); } }"
        let sink = MemoryCompilerArtifactSink()
        let session = Compiler().compilePackage(MemoryCompilerSourceProvider([
            CompilerSource("app/Main.flat", source)]), sink, "safe-callback.js", mainClass: "app/Main")
        let summary = session.completion.get()
        if (summary.packageDiagnostic) throw Exception(summary.packageDiagnostic)
        expect(summary.diagnosticCount).toBe(0)
        expect(sink.artifacts().count).toBe(1)
        let root = File(".flat-compiler-safe-callback-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        try {
            let output = File(root, "index.js")
            Es6ArtifactCommitter().commit(output, sink.artifacts().first.code)
            let response = System.executeExact(["node", output.normalizedLocation], silent: true, shell: false)
            if (response.exitCode != 0) throw Exception(response.stderr.join(""))
            expect(response.stdout.join("")).toBe("Rnull\nRAPtrue\nRAPfalse\n")
        } finally { Es6ArtifactFiles.remove(root) }
    }

    async test `conditional reference returns evaluate each condition and selected branch once`() {
        var String interpolation = ""
        interpolation += '#'
        interpolation += '{'
        let source = "package app\nclass Value { construct() {} } class Main { " +
            "static condition(Bool value) -> Bool { external js { process.stdout.write('C'); } return value; } " +
            "static selected(Value value) -> Value { external js { process.stdout.write('V'); } return value; } " +
            "static choose(Bool flag, Value value) -> Value { return condition(flag) ? null : selected(value); } " +
            "static reversed(Bool flag, Value value) -> Value { return condition(flag) ? selected(value) : null; } " +
            "static nested(Bool flag, Value value) -> Value { return condition(flag) ? (condition(false) ? null : selected(value)) : null; } " +
            "public static main() { let value = Value(); let a = choose(true, value); let b = choose(false, value); " +
            "let c = reversed(true, value); let d = reversed(false, value); let e = nested(true, value); " +
            "external js { console.log(); console.log(" + interpolation + "a} === null, " + interpolation + "b} === " + interpolation + "value}, " +
            interpolation + "c} === " + interpolation + "value}, " + interpolation + "d} === null, " + interpolation + "e} === " + interpolation + "value}); } } }"
        let sink = MemoryCompilerArtifactSink()
        let session = Compiler().compilePackage(MemoryCompilerSourceProvider([
            CompilerSource("app/Main.flat", source)]), sink, "conditional-returns.js", mainClass: "app/Main")
        let summary = session.completion.get()
        if (summary.packageDiagnostic) throw Exception(summary.packageDiagnostic)
        expect(summary.diagnosticCount).toBe(0)
        expect(sink.artifacts().count).toBe(1)
        let root = File(".flat-compiler-conditional-return-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        try {
            let output = File(root, "index.js")
            Es6ArtifactCommitter().commit(output, sink.artifacts().first.code)
            let response = System.executeExact(["node", output.normalizedLocation], silent: true, shell: false)
            if (response.exitCode != 0) throw Exception(response.stderr.join(""))
            expect(response.stdout.join("")).toBe("CCVCVCCCV\ntrue true true true true\n")
        } finally { Es6ArtifactFiles.remove(root) }
    }

    realSources() -> CompilerSource[] {
        return Compiler_Test.realCoreExecutionSources()
    }

    async test `public package API executes unchanged production Char behavior`() {
        let sources = realSources()
        let sink = MemoryCompilerArtifactSink()
        let session = Compiler().compilePackage(
            MemoryCompilerSourceProvider(sources), sink, "core/characters.js"
        )
        let summary = session.completion.get()
        expect(summary.sourceCount).toBe(sources.count)
        expect(summary.artifactCount).toBe(1)
        expect(summary.diagnosticCount).toBe(0)
        expect(summary.cancelled).toBe(false)
        expect(summary.packageDiagnostic == null).toBe(true)
        expect(session.artifacts.closed).toBe(true)
        expect(session.diagnostics.closed).toBe(true)
        expect(session.progress.closed).toBe(true)
        expect(sink.artifacts().count).toBe(1)
        expect(sink.artifacts().first.identity).toBe("core/characters.js")

        // Derive invocation names from unchanged source identities, not generated text.
        let source = sources.first
        let stream = Lexer().lexInterpolated(source.text)
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(SourceIdentity(source.identity), "compiler-input")
        let partition = FlatSourceTypePartitioner().partition(
            stream.consumeAll<Token>("data"), snapshot, "js"
        ).first
        let syntax = PrimitiveClassParser().parse(
            partition.tokenValues(), snapshot, partition.startTokenIndex, "Char"
        )
        let owner = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", syntax.range.startTokenIndex), "class", "Char"
        )
        var PrimitiveFunctionSyntax whitespace
        var PrimitiveFunctionSyntax repeat
        for (method in syntax.methodValues()) {
            if (method.name == "isWhitespace" && method.staticMethod) whitespace = method
            if (method.name == "repeat" && method.staticMethod) repeat = method
        }
        let whitespaceIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "static-method", whitespace.range.startTokenIndex),
            "static-method", "isWhitespace"
        )
        let repeatIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "static-method", repeat.range.startTokenIndex),
            "static-method", "repeat"
        )
        let className = Es6NameMangler.mangle(owner.value)
        let whitespaceName = Es6NameMangler.mangle(whitespaceIdentity.value)
        let repeatName = Es6NameMangler.mangle(repeatIdentity.value)
        let root = File(".flat-compiler-package-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let destination = File(root, "program.js")
        Es6ArtifactCommitter().commit(destination, sink.artifacts().first.code +
            "console.log(" + className + "." + whitespaceName + "(' '));\n" +
            "console.log(" + className + "." + whitespaceName + "('\\t'));\n" +
            "console.log(" + className + "." + whitespaceName + "('x'));\n" +
            "console.log(" + className + "." + repeatName + "('a', 3));\n")
        let response = System.execute(["node", destination.normalizedLocation], silent: true, shell: false)
        Es6ArtifactFiles.remove(root)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("true\ntrue\nfalse\naaa\n")
    }

    async test `public package API executes production String concatenation once left to right`() {
        // Finite fixture closure matching the existing real-Core execution tests.
        // Keep declarations and ES6 overlays unchanged, including String storage.
        let identities = [
            "flat/Object.flat", "flat/Object.js.flat", "flat/Math.flat", "flat/Math.js.flat",
            "flat/meta/Function.flat", "flat/meta/Class.flat", "flat/meta/Field.flat",
            "flat/exception/Exception.flat", "flat/exception/StackTrace.flat",
            "flat/exception/NullAccessException.flat",
            "flat/datastruct/list/NoSuchElementException.flat",
            "flat/String.flat", "flat/String.js.flat", "flat/primitive/Primitive.flat",
            "flat/primitive/number/Number.flat", "flat/primitive/number/Integer.flat",
            "flat/primitive/number/Char.flat", "flat/primitive/number/Long.flat",
            "flat/primitive/number/Long.js.flat", "flat/primitive/number/Int.flat",
            "flat/primitive/number/Int.js.flat", "flat/primitive/number/Double.flat",
            "flat/primitive/number/Double.js.flat", "flat/primitive/number/Float.flat",
            "flat/primitive/number/Float.js.flat", "flat/primitive/number/Byte.flat",
            "flat/primitive/number/Short.flat", "flat/primitive/number/RealNumber.flat",
            "flat/primitive/Bool.flat", "flat/datastruct/Comparable.flat",
            "flat/operators/PlusOperator.flat", "flat/operators/PlusEqualsOperator.flat",
            "flat/operators/MinusOperator.flat", "flat/operators/MinusEqualsOperator.flat",
            "flat/operators/MultiplyOperator.flat", "flat/operators/MultiplyEqualsOperator.flat",
            "flat/datastruct/list/Iterable.flat", "flat/datastruct/list/Iterator.flat",
            "flat/datastruct/list/List.flat", "flat/datastruct/list/OrderedList.flat",
            "flat/datastruct/list/Array.flat", "flat/datastruct/list/Array.js.flat",
            "flat/datastruct/list/ArrayIterator.flat", "flat/datastruct/list/StringCharArray.flat",
            "flat/datastruct/list/StringCharArray.js.flat", "flat/datastruct/list/IntRange.flat",
            "flat/datastruct/list/IntRangeIterator.flat", "flat/async/Async.flat", "flat/async/Async.js.flat"
        ]
        expect(identities.count + 1 <= 64).toBe(true)
        let sources = CompilerSource[]
        File parent = File("../Flat-Core/src")
        for (identity in identities) {
            File file = File(parent, identity)
            String text = Es6ArtifactFiles.read(file)
            CompilerSource source = CompilerSource(identity, text)
            sources.add(source)
        }
        // Build external references without interpolating them in the test host.
        // Expression-body native producers infer their native parameter's type;
        // declared producers explicitly construct the unchanged production String.
        var String reference = ""
        reference += '#'
        let program = "package app\nclass Main {\n" +
            "public static leftDeclared(native String text) -> String { " +
                "external js { process.stdout.write('L'); } return String(text); }\n" +
            "public static rightDeclared(native String text) -> String { " +
                "external js { process.stdout.write('R'); } return String(text); }\n" +
            "public static leftNative(native String text) => text { " +
                "external js { process.stdout.write('L'); } }\n" +
            "public static rightNative(native String text) => text { " +
                "external js { process.stdout.write('R'); } }\n" +
            "public static main() {\n" +
                "let declaredDeclared = leftDeclared(\"declared-left|\") + rightDeclared(\"declared-right\");\n" +
                "external js { console.log(); console.log(" + reference + "{declaredDeclared.chars.data}); }\n" +
                "let nativeDeclared = leftNative(\"native-left|\") + rightDeclared(\"declared-right\");\n" +
                "external js { console.log(); console.log(" + reference + "{nativeDeclared.chars.data}); }\n" +
                "let declaredNative = leftDeclared(\"declared-left|\") + rightNative(\"native-right\");\n" +
                "external js { console.log(); console.log(" + reference + "{declaredNative.chars.data}); }\n" +
            "} }"
        sources.add(CompilerSource("app/Main.flat", program))
        let sink = MemoryCompilerArtifactSink()
        let session = Compiler().compilePackage(
            MemoryCompilerSourceProvider(sources), sink, "string-concatenation.js", "app/Main"
        )
        let summary = session.completion.get()
        if (summary.packageDiagnostic) throw Exception(summary.packageDiagnostic)
        expect(summary.sourceCount).toBe(sources.count)
        expect(summary.diagnosticCount).toBe(0)
        expect(summary.artifactCount).toBe(1)
        expect(summary.cancelled).toBe(false)
        expect(sink.artifacts().count).toBe(1)
        expect(sink.artifacts().first.identity).toBe("string-concatenation.js")
        let root = File(".flat-compiler-string-concatenation-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        try {
            let destination = File(root, "program.js")
            // Execute only the compiler artifact: external JS above observes/logs,
            // but every producer call, conversion and '+' is compiled Flat source.
            Es6ArtifactCommitter().commit(destination, sink.artifacts().first.code)
            let response = System.execute(["node", destination.normalizedLocation], silent: true, shell: false)
            if (response.exitCode != 0) throw Exception(response.stderr.join(""))
            // Extra or reordered evaluations alter LR; wrong conversions alter contents.
            expect(response.stdout.join("")).toBe(
                "LR\ndeclared-left|declared-right\n" +
                "LR\nnative-left|declared-right\n" +
                "LR\ndeclared-left|native-right\n"
            )
            expect(response.stderr.join("")).toBe("")
        } finally {
            Es6ArtifactFiles.remove(root)
        }
    }

    async test `package artifact is independent of provider order`() {
        let sources = realSources()
        let forward = MemoryCompilerArtifactSink()
        let backward = MemoryCompilerArtifactSink()
        let compiler = Compiler()
        let first = compiler.compilePackage(MemoryCompilerSourceProvider(sources), forward, "core.js")
        let reversed = CompilerSource[]
        var Int index = sources.count
        while (index > 0) {
            index--
            reversed.add(sources[index])
        }
        let second = compiler.compilePackage(MemoryCompilerSourceProvider(reversed), backward, "core.js")
        expect(first.completion.get().diagnosticCount).toBe(0)
        expect(second.completion.get().diagnosticCount).toBe(0)
        expect(forward.artifacts().first.identity).toBe(backward.artifacts().first.identity)
        expect(forward.artifacts().first.code).toBe(backward.artifacts().first.code)
    }

    namespaceSources(String imports) -> CompilerSource[] {
        CompilerSource[] sources = [
            CompilerSource("alpha/Widget.flat", "package alpha\nclass Widget { public value() -> Int { return 11; } }"),
            CompilerSource("beta/Widget.flat", "package beta\nclass Widget { public value() -> Int { return 22; } }"),
            CompilerSource("app/Consumer.flat", "package app\n" + imports +
                "\nclass Consumer { public static run() -> Int { let value = Widget(); return value.value(); } }")
        ]
        return sources
    }

    async test `linker bounds explicit and configured imports together for both entrypoints`() {
        CompilerSource[] sources = [
            CompilerSource("defs/Owner.flat", "package defs\nclass Owner {}"),
            CompilerSource("app/Consumer.flat", "package app\nimport defs/Owner\nclass Consumer {}")
        ]
        let linker = FlatEs6PackageLinker(maxTokensPerSource: 64)
        let defaults = PrimitiveDefaultImport[]
        var Int index
        while (index++ < 63) defaults.add(PrimitiveDefaultImport("defs/Owner"))
        let provider = MemoryCompilerSourceProvider(sources)
        let code = linker.link(sources, defaultImports: defaults)
        expect(code.count > 0).toBe(true)
        expect(linker.linkSources(provider, provider.identities(), defaultImports: defaults)).toBe(code)
        defaults.add(PrimitiveDefaultImport("defs/Owner"))
        var Bool snapshotsRejected
        try { linker.link(sources, defaultImports: defaults) }
        catch (Exception error) { snapshotsRejected = error.message.contains("import capacity") }
        expect(snapshotsRejected).toBe(true)
        var Bool providerRejected
        try { linker.linkSources(provider, provider.identities(), defaultImports: defaults) }
        catch (Exception error) { providerRejected = error.message.contains("import capacity") }
        expect(providerRejected).toBe(true)
    }

    async test `linker rejects invalid or excessive configured imports before loading sources`() {
        let provider = TrackingPackageSourceProvider()
        let linker = FlatEs6PackageLinker(maxTokensPerSource: 1)
        let defaults = [PrimitiveDefaultImport("defs/Owner"), PrimitiveDefaultImport("defs/Other", true)]
        var Bool rejected
        try { linker.linkSources(provider, provider.identities(), defaultImports: defaults) }
        catch (Exception error) { rejected = error.message.contains("import capacity") }
        expect(rejected).toBe(true)
        expect(provider.loaded.count).toBe(0)
        PrimitiveDefaultImport[] invalid = [null]
        var Bool entryRejected
        try { linker.linkSources(provider, provider.identities(), defaultImports: invalid) }
        catch (Exception error) { entryRejected = true }
        expect(entryRejected).toBe(true)
        expect(provider.loaded.count).toBe(0)
    }

    async test `configured normal defaults resolve types while explicit imports take precedence`() {
        let root = File(".flat-compiler-package-default-types-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        try {
            String[] imports = ["", "import alpha/Widget"]
            var Int index
            for (importText in imports) {
                let sources = namespaceSources(importText)
                var String reference = ""
                reference += '#'
                reference += "{result}"
                sources.add(CompilerSource("app/Main.flat",
                    "package app\nclass Main { public static main() { let result = Consumer.run(); " +
                    "external js { console.log(" + reference + "); } } }"))
                let defaults = [PrimitiveDefaultImport("beta/Widget"), PrimitiveDefaultImport("beta/Widget")]
                let compiler = Compiler()
                let forward = MemoryCompilerArtifactSink()
                let backward = MemoryCompilerArtifactSink()
                let first = compiler.compilePackage(MemoryCompilerSourceProvider(sources), forward,
                    "defaults.js", "app/Main", defaultImports: defaults)
                let second = compiler.compilePackage(MemoryCompilerSourceProvider(sources.reverse()), backward,
                    "defaults.js", "app/Main", defaultImports: defaults)
                expect(first.completion.get().diagnosticCount).toBe(0)
                expect(second.completion.get().diagnosticCount).toBe(0)
                expect(forward.artifacts().count).toBe(1)
                expect(backward.artifacts().count).toBe(1)
                expect(forward.artifacts().first.code).toBe(backward.artifacts().first.code)
                let output = File(root, "defaults.js")
                Es6ArtifactCommitter().commit(output, forward.artifacts().first.code)
                let response = System.executeExact(["node", output.normalizedLocation], silent: true, shell: false)
                if (response.exitCode != 0) throw Exception(response.stderr.join(""))
                expect(response.stdout.join("")).toBe(index == 0 ? "22\n" : "11\n")
                index++
            }
        } finally {
            Es6ArtifactFiles.remove(root)
        }
    }

    async test `configured static defaults restrict callable owners and preserve overload selection`() {
        var String reference = ""
        reference += '#'
        reference += "{result}"
        CompilerSource[] sources = [
            CompilerSource("helpers/Selected.flat", "package helpers\nclass Selected { " +
                "public static pick(Int value) -> Int { return value + 1; } " +
                "public static pick(Bool value) -> Int { return 99; } }"),
            CompilerSource("other/Unselected.flat", "package other\nclass Unselected { " +
                "public static pick(Int value) -> Int { return 100; } }"),
            CompilerSource("app/Main.flat", "package app\nclass Main { public static main() { " +
                "let result = pick(22); external js { console.log(" + reference + "); } } }")
        ]
        let defaults = [PrimitiveDefaultImport("helpers/Selected", true)]
        let sink = MemoryCompilerArtifactSink()
        let session = Compiler().compilePackage(MemoryCompilerSourceProvider(sources), sink,
            "defaults.js", "app/Main", defaultImports: defaults)
        expect(session.completion.get().diagnosticCount).toBe(0)
        expect(sink.artifacts().count).toBe(1)
        let root = File(".flat-compiler-package-default-static-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        try {
            let output = File(root, "defaults.js")
            Es6ArtifactCommitter().commit(output, sink.artifacts().first.code)
            let response = System.executeExact(["node", output.normalizedLocation], silent: true, shell: false)
            if (response.exitCode != 0) throw Exception(response.stderr.join(""))
            expect(response.stdout.join("")).toBe("23\n")
        } finally {
            Es6ArtifactFiles.remove(root)
        }
    }

    async test `configured static named arguments execute once in lexical order and retain parameter order`() {
        var String reference = ""
        reference += '#'
        reference += "{result}"
        CompilerSource[] sources = [
            CompilerSource("library/Tools.flat", "package library\nclass Tools { " +
                "public static combine(Int left, Int right) -> Int { return left * 10 + right; } }"),
            CompilerSource("app/Main.flat", "package app\nclass Main { " +
                "public static left() -> Int { external js { process.stdout.write('L'); } return 1; } " +
                "public static right() -> Int { external js { process.stdout.write('R'); } return 2; } " +
                "public static main() { let result = combine(right: right(), left: left()); " +
                "external js { console.log(); console.log(" + reference + "); } } }")
        ]
        let sink = MemoryCompilerArtifactSink()
        let session = Compiler().compilePackage(MemoryCompilerSourceProvider(sources), sink,
            "named.js", "app/Main", defaultImports: [PrimitiveDefaultImport("library/Tools", true)])
        expect(session.completion.get().diagnosticCount).toBe(0)
        expect(sink.artifacts().count).toBe(1)
        let root = File(".flat-compiler-static-named-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        try {
            let output = File(root, "named.js")
            Es6ArtifactCommitter().commit(output, sink.artifacts().first.code)
            let response = System.executeExact(["node", output.normalizedLocation], silent: true, shell: false)
            if (response.exitCode != 0) throw Exception(response.stderr.join(""))
            expect(response.stdout.join("")).toBe("RL\n12\n")
        } finally { Es6ArtifactFiles.remove(root) }
    }

    async test `configured static overload diagnostics retain consumer location without artifact publication`() {
        String[] arguments = ["true", "1"]
        var Int index
        for (argument in arguments) {
            CompilerSource[] sources = [
                CompilerSource("library/First.flat", "package library\nclass First { public static choose(Int value) -> Int { return value; } }"),
                CompilerSource("library/Second.flat", "package library\nclass Second { public static choose(Int value) -> Int { return value; } }"),
                CompilerSource("app/Consumer.flat", "package app\nclass Consumer { static run() -> Int { return choose(" + argument + "); } }")
            ]
            let defaults = [PrimitiveDefaultImport("library/First", true), PrimitiveDefaultImport("library/Second", true)]
            let forward = MemoryCompilerArtifactSink()
            let backward = MemoryCompilerArtifactSink()
            let first = Compiler().compilePackage(MemoryCompilerSourceProvider(sources), forward,
                "defaults.js", defaultImports: defaults)
            let second = Compiler().compilePackage(MemoryCompilerSourceProvider(sources.reverse()), backward,
                "defaults.js", defaultImports: defaults.reverse())
            let summary = first.completion.get()
            expect(summary.diagnosticCount).toBe(1)
            expect(summary.artifactCount).toBe(0)
            expect(summary.packageDiagnostic.contains(index == 0 ? "type.call-no-match" : "type.call-ambiguous")).toBe(true)
            expect(summary.packageDiagnostic.contains("app/Consumer.flat:2:")).toBe(true)
            expect(second.completion.get().packageDiagnostic).toBe(summary.packageDiagnostic)
            expect(forward.artifacts().count).toBe(0)
            expect(backward.artifacts().count).toBe(0)
            index++
        }
    }

    async test `configured type ambiguity reports actual consumer range independent of default order`() {
        let sources = namespaceSources("")
        let forward = MemoryCompilerArtifactSink()
        let backward = MemoryCompilerArtifactSink()
        let defaults = [PrimitiveDefaultImport("alpha/Widget"), PrimitiveDefaultImport("beta/Widget")]
        let first = Compiler().compilePackage(MemoryCompilerSourceProvider(sources), forward,
            "defaults.js", defaultImports: defaults)
        let second = Compiler().compilePackage(MemoryCompilerSourceProvider(sources.reverse()), backward,
            "defaults.js", defaultImports: defaults.reverse())
        let summary = first.completion.get()
        expect(summary.diagnosticCount).toBe(1)
        expect(summary.packageDiagnostic.contains("binding.import-ambiguous")).toBe(true)
        // No import statement exists on line 2: the diagnostic belongs to Widget().
        expect(summary.packageDiagnostic.contains("app/Consumer.flat:3:")).toBe(true)
        expect(second.completion.get().packageDiagnostic).toBe(summary.packageDiagnostic)
        expect(forward.artifacts().count).toBe(0)
        expect(backward.artifacts().count).toBe(0)
    }

    async test `package namespaces execute explicitly imported same name declaration deterministically`() {
        let sources = namespaceSources("import beta/Widget")
        let compiler = Compiler()
        let forward = MemoryCompilerArtifactSink()
        let backward = MemoryCompilerArtifactSink()
        let first = compiler.compilePackage(MemoryCompilerSourceProvider(sources), forward, "namespace.js")
        CompilerSource[] reversed = [sources[2], sources[1], sources[0]]
        let second = compiler.compilePackage(MemoryCompilerSourceProvider(reversed), backward, "namespace.js")
        expect(first.completion.get().diagnosticCount).toBe(0)
        expect(second.completion.get().diagnosticCount).toBe(0)
        expect(forward.artifacts().count).toBe(1)
        expect(forward.artifacts().first.code).toBe(backward.artifacts().first.code)

        let source = sources[2]
        let snapshot = SourceSnapshotIdentity(SourceIdentity(source.identity), "compiler-input")
        let stream = Lexer().lex(source.text)
        stream.emit("start")
        let partition = FlatSourceTypePartitioner().partition(
            stream.consumeAll<Token>("data"), snapshot, "js"
        ).first
        expect(partition.packageName).toBe("app")
        expect(partition.importNames()).toBe(["beta/Widget"])
        let syntax = PrimitiveClassParser().parse(
            partition.tokenValues(), snapshot, partition.startTokenIndex, "Consumer"
        )
        let owner = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "class", syntax.range.startTokenIndex),
            "class", "Consumer")
        let method = syntax.methodValues().first
        let entry = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "static-method", method.range.startTokenIndex),
            "static-method", "run")
        let root = File(".flat-compiler-namespace-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let output = File(root, "program.js")
        Es6ArtifactCommitter().commit(output, forward.artifacts().first.code +
            "console.log(" + Es6NameMangler.mangle(owner.value) + "." + Es6NameMangler.mangle(entry.value) + "());\n")
        let response = System.execute(["node", output.normalizedLocation], silent: true, shell: false)
        Es6ArtifactFiles.remove(root)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("22\n")
    }

    async test `missing explicit import does not select an unrelated same name declaration`() {
        let sources = namespaceSources("import missing/Widget")
        let sink = MemoryCompilerArtifactSink()
        let session = Compiler().compilePackage(MemoryCompilerSourceProvider(sources), sink, "namespace.js")
        let summary = session.completion.get()
        expect(summary.diagnosticCount).toBe(1)
        expect(summary.artifactCount).toBe(0)
        expect(sink.artifacts().count).toBe(0)
        expect(summary.packageDiagnostic.contains("missing/Widget")).toBe(true)
        expect(summary.packageDiagnostic.contains("app/Consumer.flat")).toBe(true)
    }

    async test `conflicting explicit imports diagnose canonical ambiguity independent of source order`() {
        let sources = namespaceSources("import alpha/Widget\nimport beta/Widget")
        let forward = MemoryCompilerArtifactSink()
        let backward = MemoryCompilerArtifactSink()
        let compiler = Compiler()
        let first = compiler.compilePackage(MemoryCompilerSourceProvider(sources), forward, "namespace.js")
        CompilerSource[] reversed = [sources[2], sources[1], sources[0]]
        let second = compiler.compilePackage(MemoryCompilerSourceProvider(reversed), backward, "namespace.js")
        let diagnostic = first.completion.get().packageDiagnostic
        expect(first.completion.get().diagnosticCount).toBe(1)
        expect(second.completion.get().packageDiagnostic).toBe(diagnostic)
        expect(forward.artifacts().count).toBe(0)
        expect(backward.artifacts().count).toBe(0)
        expect(diagnostic.toLowerCase().contains("ambiguous")).toBe(true)
        expect(diagnostic.contains("app/Consumer.flat")).toBe(true)
        let alpha = diagnostic.indexOf("alpha/Widget", defaultReturnValue: -1)
        let beta = diagnostic.indexOf("beta/Widget", defaultReturnValue: -1)
        expect(alpha >= 0).toBe(true)
        expect(beta > alpha).toBe(true)
    }

    async test `source import forms retain typed diagnostics and actual consumer location`() {
        String[] importForms = ["import static beta/Widget", "import beta/Widget as Chosen"]
        for (importText in importForms) {
            let sources = namespaceSources(importText)
            let sink = MemoryCompilerArtifactSink()
            let session = Compiler().compilePackage(MemoryCompilerSourceProvider(sources), sink, "namespace.js")
            let summary = session.completion.get()
            expect(summary.diagnosticCount).toBe(1)
            expect(summary.artifactCount).toBe(0)
            expect(sink.artifacts().count).toBe(0)
            let code = importText.contains("static")
                ? "binding.import-static-unsupported" : "binding.import-alias-unsupported"
            expect(summary.packageDiagnostic.contains(code)).toBe(true)
            expect(summary.packageDiagnostic.contains("beta/Widget")).toBe(true)
            expect(summary.packageDiagnostic.contains("app/Consumer.flat:2:1")).toBe(true)
        }
    }

    async test `package parsing failure stops loading unrelated later source text`() {
        let provider = TrackingPackageSourceProvider()
        let sink = MemoryCompilerArtifactSink()
        let session = Compiler().compilePackage(provider, sink, "core.js")
        let summary = session.completion.get()
        expect(summary.sourceCount).toBe(2)
        expect(summary.diagnosticCount).toBe(1)
        expect(summary.artifactCount).toBe(0)
        expect(provider.loaded.count).toBe(1)
        expect(provider.loaded.first).toBe("a-broken.flat")
        expect(sink.artifacts().count).toBe(0)
    }

    async test `configured package capacity accepts more than sixty four sources deterministically`() {
        let sources = CompilerSource[]
        var Int index
        while (index < 65) {
            sources.add(CompilerSource("source-#{index}.flat", "class Type#{index} {}"))
            index++
        }
        let compiler = Compiler(CompilerEngine(packageLinker: FlatEs6PackageLinker(maxSources: 65)))
        let forward = MemoryCompilerArtifactSink()
        let backward = MemoryCompilerArtifactSink()
        let first = compiler.compilePackage(MemoryCompilerSourceProvider(sources), forward, "types.js")
        let reversed = sources.sort({ _b.identity.compareTo(_a.identity) })
        let second = compiler.compilePackage(MemoryCompilerSourceProvider(reversed), backward, "types.js")
        expect(first.completion.get().sourceCount).toBe(65)
        expect(first.completion.get().diagnosticCount).toBe(0)
        expect(second.completion.get().diagnosticCount).toBe(0)
        expect(forward.artifacts().first.code).toBe(backward.artifacts().first.code)
    }

    async test `package source capacity and duplicate identities reject without artifacts`() {
        let sources = realSources()
        let bounded = Compiler(CompilerEngine(packageLinker: FlatEs6PackageLinker(maxSources: 3)))
        let sink = MemoryCompilerArtifactSink()
        var Bool capacityRejected
        try {
            bounded.compilePackage(MemoryCompilerSourceProvider(sources), sink, "core.js")
        } catch (Exception error) { capacityRejected = true }
        expect(capacityRejected).toBe(true)
        expect(sink.artifacts().count).toBe(0)
        var Bool duplicateRejected
        try {
            CompilerSource[] duplicates = [sources.first, sources.first]
            Compiler().compilePackage(MemoryCompilerSourceProvider(duplicates), sink, "core.js")
        } catch (Exception error) { duplicateRejected = true }
        expect(duplicateRejected).toBe(true)
        expect(sink.artifacts().count).toBe(0)
        var Bool emptyRejected
        try {
            Compiler().compilePackage(MemoryCompilerSourceProvider(CompilerSource[]), sink, "core.js")
        } catch (Exception error) { emptyRejected = true }
        expect(emptyRejected).toBe(true)
    }

    async test `package artifact identity cannot escape sink root`() {
        let sources = MemoryCompilerSourceProvider(realSources())
        String[] unsafeIdentities = ["", "/core.js", "../core.js", "core/../out.js", "./core.js",
            "core//out.js", "core/", "C:/core.js", "core\\out.js"]
        for (identity in unsafeIdentities) {
            let sink = MemoryCompilerArtifactSink()
            var Bool rejected
            try {
                Compiler().compilePackage(sources, sink, identity)
            } catch (Exception error) { rejected = true }
            expect(rejected).toBe(true)
            expect(sink.artifacts().count).toBe(0)
        }
    }

    test `legacy summary constructor has no retained package diagnostic`() {
        let summary = CompilationSummary(2, 2, 0, false)
        expect(summary.packageDiagnostic == null).toBe(true)
    }

    async test `missing package source returns diagnostic without partial artifact`() {
        let sink = MemoryCompilerArtifactSink()
        let session = Compiler().compilePackage(MissingPackageSourceProvider(), sink, "core.js")
        let summary = session.completion.get()
        expect(summary.sourceCount).toBe(1)
        expect(summary.packageDiagnostic).toBe("Failed to compile package 'core.js': Missing source 'missing.flat'")
        expect(summary.artifactCount).toBe(0)
        expect(summary.diagnosticCount).toBe(1)
        expect(sink.artifacts().count).toBe(0)
        expect(session.diagnostics.closed).toBe(true)
        expect(session.artifacts.closed).toBe(true)
        expect(session.progress.closed).toBe(true)
    }

    async test `cleanup crossing foreach continue returns source diagnostic without artifacts`() {
        let identity = "app/Cleanup.flat"
        let source = "class Cleanup { static run() -> Int {\n" +
            "for (i in 0..2) { try { continue; } finally { let done = 1; } }\n" +
            "return 0; } }"
        let sink = MemoryCompilerArtifactSink()
        let session = Compiler().compilePackage(
            MemoryCompilerSourceProvider([CompilerSource(identity, source)]), sink, "cleanup.js"
        )
        let summary = session.completion.get()
        expect(summary.diagnosticCount).toBe(1)
        expect(summary.artifactCount).toBe(0)
        expect(sink.artifacts().count).toBe(0)
        expect(session.diagnostics.closed).toBe(true)
        expect(session.artifacts.closed).toBe(true)
        expect(summary.packageDiagnostic.contains("semantic.cleanup-crossing-continue")).toBe(true)
        expect(summary.packageDiagnostic.contains("app/Cleanup.flat:2:25")).toBe(true)
        expect(summary.packageDiagnostic.contains("Foreach continue through try/catch/finally")).toBe(true)
    }

    async test `package link failure returns diagnostic without partial artifact`() {
        let sources = realSources()
        sources.add(CompilerSource("broken.flat", "class Broken {"))
        var String expectedDiagnostic
        try {
            FlatEs6PackageLinker().link(sources)
        } catch (Exception error) {
            expectedDiagnostic = "Failed to compile package 'core.js': #{error.message}"
        }
        expect(expectedDiagnostic != null).toBe(true)
        let sink = MemoryCompilerArtifactSink()
        let session = Compiler().compilePackage(MemoryCompilerSourceProvider(sources), sink, "core.js")
        let summary = session.completion.get()
        expect(summary.sourceCount).toBe(sources.count)
        expect(summary.packageDiagnostic).toBe(expectedDiagnostic)
        expect(summary.artifactCount).toBe(0)
        expect(summary.diagnosticCount).toBe(1)
        expect(sink.artifacts().count).toBe(0)
        expect(session.completion.completed).toBe(true)
    }
}

/** Test-only provider proving that parse failure does not preload the partition. */
class TrackingPackageSourceProvider extends CompilerSourceProvider {
    visible String[] loaded = String[]
    override public identities() -> String[] {
        String[] values = ["a-broken.flat", "z-later.flat"]
        return values
    }
    override public async load(String identity) -> CompilerSource {
        loaded.add(identity)
        return CompilerSource(identity, identity == "a-broken.flat" ? "class Broken {" : "class Later {}")
    }
}

/** Test-only provider exercising an identity whose source cannot be loaded. */
class MissingPackageSourceProvider extends CompilerSourceProvider {
    override public identities() -> String[] {
        String[] values = ["missing.flat"]
        return values
    }
}
