package flat/compiler

import flat/io
import flat/system
import flat/time/Time
import flat/compiler/models
import flat/project
import flat/lexer
import flat/parser/flat
import flat/writer/es6/bound
import flat/semantic/binding/primitive/PrimitiveDefaultImport

/** Public package API acceptance, separate from direct linker feature tests. */
testable class {
    async test `production Core workload syntax retains typed mixed array declaration`() {
        assertProductionWorkloadSyntax()
    }

    public static async assertProductionWorkloadSyntax() {
        let file = File("../Flat-Core/workloads/ProductionCoreWorkload.flat")
        let text = Es6ArtifactFiles.read(file)
        let snapshot = SourceSnapshotIdentity(SourceIdentity(file.normalizedLocation), "workload-syntax")
        let stream = Lexer().lexInterpolated(text)
        stream.emit("start")
        // This one fixture file is the explicit bounded syntax regression unit.
        let partitions = FlatSourceTypePartitioner().partition(stream.consumeAll<Token>("data"), snapshot, "js")
        var Int methods
        var Bool foundMixed
        for (partition in partitions) {
            let syntax = PrimitiveClassParser().parse(partition.tokenValues(), snapshot,
                partition.startTokenIndex)
            for (method in syntax.methodValues()) {
                methods++
                if (method.name == "collectionsAndNumbers") {
                    for (statement in method.statements()) {
                        if (!statement.class.isOfType(PrimitiveLocalDeclarationSyntax.class)) continue
                        let local = (PrimitiveLocalDeclarationSyntax)statement
                        if (local.name == "mixed") {
                            expect(local.declaredTypeName).toBe("Object[]")
                            expect(local.initializer != null).toBe(true)
                            foundMixed = true
                        }
                    }
                }
            }
        }
        expect(partitions.count).toBe(2)
        expect(methods).toBe(13)
        expect(foundMixed).toBe(true)
    }

    async test `public package API selects main without turning library loading into execution`() {
        let sources = [CompilerSource("app/Main.flat",
            "package app class Main { public static main() { external js { console.log('package-main'); } } }")]
        let compiler = Compiler(CompilerEngine(packageReuse: CompilerPackageReuse()))
        let library = MemoryCompilerArtifactSink()
        let executable = MemoryCompilerArtifactSink()
        let librarySummary = compiler.compilePackageSnapshots(sources, library, "library.js").completion.get()
        let mainSummary = compiler.compilePackageSnapshots(sources, executable, "main.js", "app/Main").completion.get()
        expect(librarySummary.diagnosticCount).toBe(0)
        expect(mainSummary.diagnosticCount).toBe(0)
        expect(librarySummary.artifactCount).toBe(1)
        expect(mainSummary.artifactCount).toBe(1)
        let root = File(".flat-package-main-policy-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        try {
            let libraryFile = File(root, "library.js")
            let mainFile = File(root, "main.js")
            Es6ArtifactFiles.write(libraryFile, library.artifacts().first.code)
            Es6ArtifactFiles.write(mainFile, executable.artifacts().first.code)
            let loaded = System.execute(["node", libraryFile.normalizedLocation], silent: true, shell: false)
            expect(loaded.exitCode).toBe(0)
            expect(loaded.stdout.join("")).toBe("")
            let executed = System.execute(["node", mainFile.normalizedLocation], silent: true, shell: false)
            expect(executed.exitCode).toBe(0)
            expect(executed.stdout.join("")).toBe("package-main\n")
        } finally { Es6ArtifactFiles.remove(root) }
    }

    /** Requires separately bootstrapped flatc and Airship artifacts; never builds this suite recursively. */
    async test `Airship Flat runtime builds a real package executable and Node runs its production dependency`() {
        let airship = File("../Airship/dist/airship.js")
        let compiler = File("dist/es6/index.js")
        if (!airship.isFile || !compiler.isFile) {
            throw Exception("Package executable acceptance requires explicit Airship and flatc bootstrap artifacts")
        }
        let root = File(".flat-compiler-airship-package-test-#{Time.currentTimeMillis}")
        let sources = File(root, "src")
        Es6ArtifactFiles.ensureDirectory(sources)
        try {
            // A normal package retains Airship's implicit real Flat-Core dependency.
            // Do not trim dependency sources or replace production implementations.
            Es6ArtifactCommitter().commit(File(root, "flat.json"),
                "{\"name\":\"Compiler executable acceptance\",\"version\":\"0.1.0\",\"defaultTarget\":\"es6\",\"sources\":{\"main\":{\"source\":\"src\",\"mainClass\":\"app/Main\",\"dependencies\":{}}}}")
            var String reference = ""
            reference += '#'
            reference += "{Char.repeat('a', 3)}"
            // Exercise the real public metadata API, including the checked null guard.
            // Setup mirrors Flat-Core's Class tests; no replacement Core types are supplied.
            var String interpolation = ""
            interpolation += '#'
            interpolation += '{'
            let metadata = "let localField = Field(\"value\"); let parentField = Field(\"value\"); " +
                "let interfaceField = Field(\"value\"); " +
                "let parent = Class(\"test/Parent\", false, Object.class, Class[], [parentField]); " +
                "let contract = Class(\"test/Contract\", true, Object.class, Class[], [interfaceField]); " +
                "let local = Class(\"test/Local\", false, parent, [contract], [localField]); " +
                "let inherited = Class(\"test/Inherited\", false, parent, [contract], Field[]); " +
                "let emptyParent = Class(\"test/EmptyParent\", false, Object.class, Class[], Field[]); " +
                "let implemented = Class(\"test/Implemented\", false, emptyParent, [contract], Field[]); " +
                "let localMatch = Object.referenceEquals(local.getField(\"value\", true), localField); " +
                "let parentMatch = Object.referenceEquals(inherited.getField(\"value\", true), parentField); " +
                "let interfaceMatch = Object.referenceEquals(implemented.getField(\"value\", true), interfaceField); " +
                "let localOnly = inherited.getField(\"value\") == null; " +
                "let missingLocal = local.getField(\"missing\") == null; " +
                "let missingAncestor = implemented.getField(\"missing\", true) == null; " +
                "let missingMetadata = Class(\"test/MissingMetadata\", false, Object.class, Class[]); " +
                "var Bool rejected = false; try { missingMetadata.getField(\"missing\", true); } " +
                "catch (NullAccessException error) { rejected = true; } " +
                "external js { console.log(" + interpolation + "localMatch}, " + interpolation + "parentMatch}, " +
                interpolation + "interfaceMatch}, " + interpolation + "localOnly}, " + interpolation + "missingLocal}, " +
                interpolation + "missingAncestor}, " + interpolation + "rejected}); } "
            Es6ArtifactCommitter().commit(File(sources, "Main.flat"),
                "package app\nimport flat/primitive/number/Char\nimport flat/meta/Class\nimport flat/meta/Field\n" +
                "import flat/exception/NullAccessException\nclass Main { public static main() { " + metadata +
                "external js { console.log(" + reference + "); } } }")
            // Explicit immutable compiler selection exercises Airship's generated-tool
            // path without implicit dependency lookup or a legacy fallback.
            let installed = System.execute([
                "node", airship.normalizedLocation, "--use-links", "-f", root.normalizedLocation,
                "--flatc-runtime", "flat", "--flatc-script", compiler.normalizedLocation,
                "install", "-t", "es6"
            ], silent: true, shell: false)
            if (installed.exitCode != 0) {
                throw Exception("Airship Flat runtime package install failed: " + installed.stdout.join("") + installed.stderr.join(""))
            }
            let output = File(root, "dist/es6/index.js")
            expect(output.isFile).toBe(true)
            let executed = System.execute(["node", output.normalizedLocation], silent: true, shell: false)
            if (executed.exitCode != 0) throw Exception(executed.stderr.join(""))
            expect(executed.stdout.join("")).toBe("true true true true true true true\naaa\n")
        } finally {
            Es6ArtifactFiles.remove(root)
        }
    }

    // Earlier eager construction must wait for every declaration and metadata record.
    public static declarationReadySources() -> CompilerSource[] {
        return [
            CompilerSource("app/AStatics.flat", "package app\nclass AStatics {\n" +
                "public static Array first = Array(4);\npublic static Int second = mark();\n" +
                "public static mark() -> Int { external js { console.log('A'); return 1; } }\n}"),
            CompilerSource("app/Array.flat", "package app\nclass Array {\nvisible Int count;\npublic construct(Int count) {\nthis.count = count;\n" +
                "external js { console.log('B', this.constructor.__flatType.name === 'Array'); }\n}\n}"),
            CompilerSource("app/Main.flat", "package app\nclass Main {\npublic static main() {\n" +
                "external js { console.log('C'); }\n}\n}"),
            // Reverse lexical declaration order exercises superclass readiness,
            // independently of the preserved eager-initializer ordinal order.
            CompilerSource("app/BChild.flat", "package app\nclass BChild extends ZParent {}"),
            CompilerSource("app/ZParent.flat", "package app\nclass ZParent {}")
        ]
    }

    async test `package eager constructors wait for declarations and metadata before ordered effects`() {
        assertDeclarationRuntime()
    }

    public async assertDeclarationRuntime() {
        let sink = MemoryCompilerArtifactSink()
        let summary = Compiler().compilePackage(MemoryCompilerSourceProvider(declarationReadySources()),
            sink, "ready.js", mainClass: "app/Main").completion.get()
        if (summary.packageDiagnostic) throw Exception(summary.packageDiagnostic)
        expect(summary.succeeded).toBe(true)
        expect(summary.diagnosticCount).toBe(0)
        expect(summary.artifactCount).toBe(1)
        let root = File(".flat-compiler-declarations-ready-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        try {
            let output = File(root, "index.js")
            Es6ArtifactCommitter().commit(output, sink.artifacts().first.code)
            let response = System.executeExact(["node", output.normalizedLocation], silent: true, shell: false)
            expect(response.exitCode).toBe(0)
            expect(response.stdout.join("")).toBe("B true\nA\nC\n")
            expect(response.stderr.join("")).toBe("")
        } finally { Es6ArtifactFiles.remove(root) }
    }

    async test `package character ceiling includes entry before publication with exact fit allowed`() {
        assertDeclarationCapacity()
    }

    public async assertDeclarationCapacity() {
        let sources = declarationReadySources()
        let provider = MemoryCompilerSourceProvider(sources)
        let expected = FlatEs6PackageLinker().linkSources(provider, provider.identities(), mainClass: "app/Main")
        let exact = FlatEs6PackageLinker(maxArtifactCharacters: expected.count)
        expect(exact.linkSources(provider, provider.identities(), mainClass: "app/Main")).toBe(expected)
        let sink = MemoryCompilerArtifactSink()
        let limited = Compiler(CompilerEngine(packageLinker:
            FlatEs6PackageLinker(maxArtifactCharacters: expected.count - 1)))
        let summary = limited.compilePackage(provider, sink, "overflow.js", mainClass: "app/Main").completion.get()
        expect(summary.succeeded).toBe(false)
        expect(summary.artifactCount).toBe(0)
        expect(summary.packageDiagnostic.contains("es6.assembly-capacity")).toBe(true)
        expect(sink.artifacts().count).toBe(0)
    }

    async test `full Core character bridges preserve String boxed and native storage`() {
