import flat/future
import flat/semantic/binding/primitive/PrimitiveDefaultImport
import flat/compiler/models
import flat/lexer
import flat/parser/flat
import flat/writer/es6/bound

/** Public CLI library and executable acceptance; production sources are never rewritten. */
testable class {
    async test `cold and warm CLI diagnostic batches follow actual lock cleanup`() {
        let root = File(".flat-cli-diagnostic-finalization-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let source = File(root, "Main.flat")
        let output = File(root, "program.js")
        let lock = output.normalizedLocation + ".flat-incremental.json.lock"
        Es6ArtifactFiles.write(source, "class Main {}")
        native var Object observer
        native var Object originalLog
        external {
            #{observer} = {batches:0, complete:true, lockAbsent:true, failures:0};
            #{originalLog} = console.log;
            console.log = (...args) => {
                for (const text of args) {
                    if (typeof text !== 'string' || !text.startsWith('{')) continue;
                    let value;
                    try { value = JSON.parse(text); } catch (_) { continue; }
                    if (value.schema !== 'flat.compiler.diagnostics.v1') continue;
                    #{observer}.batches++;
                    #{observer}.complete = #{observer}.complete && value.complete === true && value.records.length === 0;
                    #{observer}.lockAbsent = #{observer}.lockAbsent && !#{File.FileGlobal.fs}.existsSync(#{lock});
                    if (value.terminalFailure) #{observer}.failures++;
                }
            };
        }
        try {
            let arguments = ["flatc", source.normalizedLocation, "-target", "es6", "-library", "-o", output.normalizedLocation]
            expect(CompilerCli.run(arguments)).toBe(0)
            expect(CompilerCli.run(arguments)).toBe(0)
            Int batches
            Bool complete
            Bool lockAbsent
            Int failures
            external {
                #{batches} = #{observer}.batches;
                #{complete} = #{observer}.complete;
                #{lockAbsent} = #{observer}.lockAbsent;
                #{failures} = #{observer}.failures;
            }
            expect(batches).toBe(2)
            expect(complete).toBe(true)
            expect(lockAbsent).toBe(true)
            expect(failures).toBe(0)
            let previous = Es6ArtifactFiles.read(output)
            Es6ArtifactFiles.write(source, "class Main { broken")
            expect(CompilerCli.run(arguments)).toBe(1)
            external {
                #{batches} = #{observer}.batches;
                #{complete} = #{observer}.complete;
                #{lockAbsent} = #{observer}.lockAbsent;
                #{failures} = #{observer}.failures;
            }
            expect(batches).toBe(3)
            expect(complete).toBe(false)
            expect(lockAbsent).toBe(true)
            expect(failures).toBe(1)
            expect(Es6ArtifactFiles.read(output)).toBe(previous)
        } finally {
            external { console.log = #{originalLog}; }
            Es6ArtifactFiles.remove(root)
        }
    }

    async test `filesystem provider bounds bytes before returning a source`() {
        let root = File(".flat-compiler-bounded-read-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let file = File(root, "Main.flat")
        try {
            Es6ArtifactFiles.write(file, "é")
            let identity = file.normalizedLocation
            let exactProvider = FilesystemCompilerSourceProvider([file], maxSourceBytes: 2)
            CompilerSource exactSource = exactProvider.load(identity)
            expect(exactSource.text).toBe("é")
            var Bool rejected
            try { FilesystemCompilerSourceProvider([file], maxSourceBytes: 1).load(identity) }
            catch (Exception error) { rejected = true }
            expect(rejected).toBe(true)
            Es6ArtifactFiles.write(file, "")
            let emptyProvider = FilesystemCompilerSourceProvider([file], maxSourceBytes: 0)
            CompilerSource emptySource = emptyProvider.load(identity)
            expect(emptySource.text).toBe("")
        } finally { Es6ArtifactFiles.remove(root) }
    }

    async test `compiler directory limit counts ignored and hidden entries before filtering`() {
        let root = File(".flat-compiler-bounded-directory-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        try {
            Es6ArtifactFiles.write(File(root, "Main.flat"), "class Main {}")
            Es6ArtifactFiles.write(File(root, ".hidden"), "ignored")
            Es6ArtifactFiles.write(File(root, "notes.txt"), "ignored")
            let package = ProjectPackage("bounded", [SourceRoot(root.normalizedLocation)])
            var Bool rejected
            try { CompilerSourceDiscovery(maxDirectoryEntries: 2).discover(package) }
            catch (Exception error) { rejected = true }
            expect(rejected).toBe(true)
            let selected = CompilerSourceDiscovery(maxDirectoryEntries: 3).discover(package)
            expect(selected.count).toBe(1)
            expect(selected.first.name).toBe("Main.flat")
        } finally { Es6ArtifactFiles.remove(root) }
    }

    realArguments(File output) -> String[] {
        String[] values = [
            "flatc", "../Flat-Core/src/flat/primitive/number/Char.flat",
            "-target", "es6", "-library", "-o", output.normalizedLocation
        ]
        // Reuse the finite, unchanged real-Core execution closure, not all Core tests.
        let sources = Compiler_Test.realCoreExecutionSources()
        for (source in sources) {
            File parent = File("../Flat-Core/src")
            File file = File(parent, source.identity)
            String path = file.normalizedLocation
            if (!values.contains(path)) {
                values.add("-l")
                values.add(path)
            }
        }
        return values
    }

    async test `CLI persistent incremental output agrees with clean after changed and removed input`() {
        let root = File(".flat-cli-incremental-#{Time.currentTimeMillis}")
        let sources = File(root, "src")
        Es6ArtifactFiles.ensureDirectory(sources)
        let source = File(sources, "Main.flat")
        let unused = File(sources, "Unused.flat")
        let output = File(root, "program.js")
        let clean = File(root, "clean.js")
        let manifest = File(output.normalizedLocation + ".flat-incremental.json")
        Es6ArtifactFiles.write(source, "package app\nclass Main { public static main() { external js { console.log('one'); } } }")
        Es6ArtifactFiles.write(unused, "class Unused {}")
        let arguments = ["flatc", sources.normalizedLocation, "-target", "es6", "-main", "app/Main", "-o", output.normalizedLocation]
        try {
            expect(CompilerCli.run(arguments)).toBe(0)
            let first = Es6ArtifactFiles.read(manifest)
            expect(CompilerCli.run(arguments)).toBe(0)
            expect(Es6ArtifactFiles.read(manifest)).toBe(first)
            Es6ArtifactFiles.write(source, "package app\nclass Main { public static main() { external js { console.log('two'); } } }")
            expect(CompilerCli.run(arguments)).toBe(0)
            Es6ArtifactFiles.remove(unused)
            expect(CompilerCli.run(arguments)).toBe(0)
            expect(CompilerCli.run(["flatc", sources.normalizedLocation, "-target", "es6", "-main", "app/Main",
                "-o", clean.normalizedLocation])).toBe(0)
            expect(Es6ArtifactFiles.read(output)).toBe(Es6ArtifactFiles.read(clean))
            let execution = System.execute(["node", output.normalizedLocation], silent: true, shell: false)
            expect(execution.exitCode).toBe(0)
            expect(execution.stdout.join("")).toBe("two\n")
            let previous = Es6ArtifactFiles.read(output)
            let previousManifest = Es6ArtifactFiles.read(manifest)
            Es6ArtifactFiles.write(source, "class Main { broken")
            expect(CompilerCli.run(arguments)).toBe(1)
            expect(Es6ArtifactFiles.read(output)).toBe(previous)
            expect(Es6ArtifactFiles.read(manifest)).toBe(previousManifest)
        } finally { Es6ArtifactFiles.remove(root) }
    }

    async test `production String wrapper argv uses its selected native-string constructor`() {
        let root = File(".flat-cli-wrapper-argv-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        try {
            let source = File(root, "Main.flat")
            let output = File(root, "program.js")
            var String reference = ""
            reference += '#'
            reference += "{args[0].count}"
            Es6ArtifactFiles.write(source, "package app\nclass Main { public static main(String[] args) { external js { console.log(" + reference + "); } } }")
            let arguments = String[]
            for (argument in realArguments(output)) {
                if (argument != "-library") arguments.add(argument)
            }
            arguments.addAll([source.normalizedLocation, "-main", "app/Main"])
            expect(CompilerCli.run(arguments)).toBe(0)
            let response = System.execute(["node", output.normalizedLocation, "dogfood"], silent: true, shell: false)
            expect(response.exitCode).toBe(0)
            expect(response.stdout.join("")).toBe("7\n")
        } finally { Es6ArtifactFiles.remove(root) }
    }

    async test `source discovery selects glob closure beyond 64 files with explicit bounds`() {
        let root = File(".flat-discovery-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        try {
            for (index in 0..70) Es6ArtifactFiles.write(File(root, "Value#index.flat"), "class Value#index {}")
            Es6ArtifactFiles.write(File(root, "Foreign.java.flat"), "invalid")
            Es6ArtifactFiles.write(File(root, "Ignored_Test.flat"), "invalid")
            Es6ArtifactFiles.write(File(root, "Value0.js.flat"), "class Value0 {}")
            Es6ArtifactFiles.write(File(root, "Value0.es6.flat"), "class Value0 {}")
            let package = ProjectPackage("discovery", [SourceRoot(root.normalizedLocation + "/*.flat")],
                dependencies: [ProjectDependency("duplicate", root.normalizedLocation)],
                exclusions: [SourceExclusion(root.normalizedLocation + "/*_Test.flat")])
            let files = CompilerSourceDiscovery().discover(package)
            expect(files.count).toBe(72)
            expect(files[0].name).toBe("Value0.flat")
            expect(files[1].name).toBe("Value0.js.flat")
            expect(files[2].name).toBe("Value0.es6.flat")
            var Bool rejected
            try { CompilerSourceDiscovery(maxSources: 64).discover(package) }
            catch (Exception error) { rejected = true }
            expect(rejected).toBe(true)
        } finally { Es6ArtifactFiles.remove(root) }
    }

    async test `source discovery prunes excluded directories before enumeration and enforces depth`() {
        let root = File(".flat-discovery-depth-#{Time.currentTimeMillis}")
        let nested = File(root, "nested/deep")
        Es6ArtifactFiles.ensureDirectory(nested)
        Es6ArtifactFiles.write(File(root, "Main.flat"), "class Main {}")
        Es6ArtifactFiles.write(File(nested, "Hidden.flat"), "class Hidden {}")
        try {
            let package = ProjectPackage("pruned", [SourceRoot(root.normalizedLocation)],
                exclusions: [SourceExclusion(File(root, "nested").normalizedLocation)])
            let selected = CompilerSourceDiscovery(maxDirectories: 1, maxDepth: 1).discover(package)
            expect(selected.count).toBe(1)
            expect(selected.first.name).toBe("Main.flat")
            var Bool rejected
            try {
                CompilerSourceDiscovery(maxDepth: 1).discover(ProjectPackage("deep", [SourceRoot(root.normalizedLocation)]))
            } catch (Exception error) { rejected = true }
            expect(rejected).toBe(true)
        } finally { Es6ArtifactFiles.remove(root) }
    }

    async test `CLI executes identical generated package with selectable read concurrency`() {
        let root = File(".flat-cli-parallel-execution-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let input = File(root, "Main.flat")
        let second = File(root, "Other.flat")
        Es6ArtifactFiles.write(input, "package app\nclass Main { public static main() { external js { console.log('bounded'); } } }")
        Es6ArtifactFiles.write(second, "package app\nclass Other {}")
        var String previous
        try {
            for (capacity in [1, 2]) {
                let output = File(root, "program#capacity.js")
                expect(CompilerCli.run(["flatc", input.normalizedLocation, second.normalizedLocation,
                    "-target", "es6", "-main", "app/Main", "--threads", "#capacity",
                    "-o", output.normalizedLocation])).toBe(0)
                let code = Es6ArtifactFiles.read(output)
                if (previous == null) previous = code
                else expect(code).toBe(previous)
                let execution = System.execute(["node", output.normalizedLocation], silent: true, shell: false)
                expect(execution.exitCode).toBe(0)
                expect(execution.stdout.join("")).toBe("bounded\n")
            }
        } finally { Es6ArtifactFiles.remove(root) }
    }

    async test `CLI accepts bounded source read concurrency and preserves output on invalid input`() {
        let root = File(".flat-cli-concurrency-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let input = File(root, "Broken.flat")
        let output = File(root, "library.js")
        Es6ArtifactFiles.write(input, "class Broken { static read() -> Int { return missing; } }")
        Es6ArtifactFiles.write(output, "previous")
        try {
            expect(CompilerCli.run(["flatc", input.normalizedLocation, "-target", "es6", "-library",
                "--threads", "2", "-o", output.normalizedLocation])).toBe(1)
            expect(Es6ArtifactFiles.read(output)).toBe("previous")
        } finally { Es6ArtifactFiles.remove(root) }
    }

    test `CLI artifact byte capacity rejects malformed and overflow values`() {
        String[] invalid = ["", "0", "-1", "+1", "1x", "1.5", " 1", "2147483648", "99999999999999999999"]
        var Int rejected
        for (value in invalid) {
            try { CompilerCli.parseArtifactByteCapacity(value) }
            catch (Exception error) { rejected++ }
        }
        expect(rejected).toBe(invalid.count)
        expect(CompilerCli.parseArtifactByteCapacity("67108864")).toBe(67108864)
        expect(CompilerCli.parseArtifactByteCapacity("2147483647")).toBe(2147483647)
    }

    async test `CLI byte cap rejection preserves existing output and removes staging`() {
        let root = File(".flat-cli-byte-cap-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let input = File(root, "Value.flat")
        let output = File(root, "library.js")
        Es6ArtifactFiles.write(input, "class Value {}")
        Es6ArtifactFiles.write(output, "previous output")
        String[] arguments = ["flatc", input.normalizedLocation, "-target", "es6", "-library",
            "-o", output.normalizedLocation, "--max-artifact-bytes", "1"]
        try {
            expect(CompilerCli.run(arguments)).toBe(1)
            expect(Es6ArtifactFiles.read(output)).toBe("previous output")
            expect(root.getChildFiles(includeHidden: true, includeDirectories: true).count).toBe(2)
        } finally { Es6ArtifactFiles.remove(root) }
    }

