package flat/compiler

import flat/io
import flat/system
import flat/time/Time
import flat/compiler/models
import flat/lexer
import flat/parser/flat
import flat/writer/es6/bound

/** Public CLI library and executable acceptance; production sources are never rewritten. */
testable class {
    realArguments(File output) -> String[] {
        String[] values = [
            "flatc", "../Flat-Core/src/flat/primitive/number/Char.flat",
            "-l", "../Flat-Core/src/flat/primitive/number/Number.flat",
            "-l", "../Flat-Core/src/flat/primitive/number/Integer.flat",
            "-l", "../Flat-Core/src/flat/primitive/Primitive.flat",
            "-target", "es6", "-library", "-o", output.normalizedLocation
        ]
        let dependencies = Compiler_Test.coreDependencyIdentities()
        for (identity in dependencies) {
            File parent = File("../Flat-Core/src")
            File file = File(parent, identity)
            String path = file.normalizedLocation
            if (!values.contains(path)) {
                values.add("-l")
                values.add(path)
            }
        }
        return values
    }

    async test `CLI compiles unchanged production sources into an executable inspected library`() {
        let root = File(".flat-compiler-cli-library-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let output = File(root, "characters.js")
        expect(CompilerCli.run(realArguments(output))).toBe(0)
        expect(output.isFile).toBe(true)
        let code = Es6ArtifactFiles.read(output)
        expect(code.count > 0).toBe(true)
        expect(code.indexOf("require.main === module")).toBe(-1)

        let file = File("../Flat-Core/src/flat/primitive/number/Char.flat")
        let identity = file.normalizedLocation
        let source = Es6ArtifactFiles.read(file)
        let stream = Lexer().lexInterpolated(source)
        stream.emit("start")
        let snapshot = SourceSnapshotIdentity(SourceIdentity(identity), "compiler-input")
        let partition = FlatSourceTypePartitioner().partition(
            stream.consumeAll<Token>("data"), snapshot, "js"
        ).first
        let syntax = PrimitiveClassParser().parse(
            partition.tokenValues(), snapshot, partition.startTokenIndex, "Char"
        )
        let owner = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "class", syntax.range.startTokenIndex), "class", "Char"
        )
        let whitespace = syntax.methodValues().firstOrNull((method) => method.staticMethod && method.name == "isWhitespace")
        let repeat = syntax.methodValues().firstOrNull((method) => method.staticMethod && method.name == "repeat")
        let whitespaceIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "static-method", whitespace.range.startTokenIndex),
            "static-method", "isWhitespace"
        )
        let repeatIdentity = DeclarationIdentity(
            SyntaxIslandIdentity(snapshot, "static-method", repeat.range.startTokenIndex),
            "static-method", "repeat"
        )
        let className = Es6NameMangler.mangle(owner.value)
        let runner = File(root, "inspect.js")
        Es6ArtifactCommitter().commit(runner, code +
            "console.log(" + className + "." + Es6NameMangler.mangle(whitespaceIdentity.value) + "(' '));\n" +
            "console.log(" + className + "." + Es6NameMangler.mangle(whitespaceIdentity.value) + "('x'));\n" +
            "console.log(" + className + "." + Es6NameMangler.mangle(repeatIdentity.value) + "('a', 3));\n")
        let response = System.execute(["node", runner.normalizedLocation], silent: true, shell: false)
        Es6ArtifactFiles.remove(root)
        if (response.exitCode != 0) throw Exception(response.stderr.join(""))
        expect(response.stdout.join("")).toBe("true\nfalse\naaa\n")
    }

    async test `CLI preserves previous artifact on package failure and publishes no partial output`() {
        let root = File(".flat-compiler-cli-failure-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        let bad = File(root, "Broken.flat")
        Es6ArtifactCommitter().commit(bad, "not valid Flat syntax")
        let output = File(root, "library.js")
        Es6ArtifactCommitter().commit(output, "previous artifact\n")
        let arguments = realArguments(output)
        arguments.add(bad.normalizedLocation)
        expect(CompilerCli.run(arguments)).toBe(1)
        expect(Es6ArtifactFiles.read(output)).toBe("previous artifact\n")
        let absent = File(root, "absent.js")
        let failedArguments = realArguments(absent)
        failedArguments.add(bad.normalizedLocation)
        expect(CompilerCli.run(failedArguments)).toBe(1)
        expect(absent.exists).toBe(false)
        expect(root.getChildFiles(true).count).toBe(2)
        Es6ArtifactFiles.remove(root)
    }

    async test `CLI directory exclusion aliases retain library output policy`() {
        let root = File(".flat-compiler-cli-exclusion-test-#{Time.currentTimeMillis}")
        let sources = File(root, "src")
        let destination = File(root, "dist")
        Es6ArtifactFiles.ensureDirectory(sources)
        let bad = File(sources, "Broken.flat")
        Es6ArtifactCommitter().commit(bad, "not valid Flat syntax")
        Es6ArtifactCommitter().commit(File(sources, "StackTrace.flat"), Es6ArtifactFiles.read(
            File("../Flat-Core/src/flat/exception/StackTrace.flat")
        ))
        expect(CompilerCli.matchesExclusion(bad.normalizedLocation, bad)).toBe(true)
        expect(CompilerCli.matchesExclusion(bad.normalizedLocation, File(sources, "StackTrace.flat"))).toBe(false)
        expect(CompilerCli.run([
            "flatc", sources.normalizedLocation, "--exclude", bad.normalizedLocation,
            "--target", "es6", "-library", "-d", destination.normalizedLocation
        ])).toBe(0)
        expect(File(destination, "library.js").isFile).toBe(true)
        Es6ArtifactFiles.remove(root)
    }

    async test `CLI rejects missing main unsupported target runtime and ambiguous short target`() {
        let root = File(".flat-compiler-cli-options-test-#{Time.currentTimeMillis}")
        let output = File(root, "program.js")
        let source = "../Flat-Core/src/flat/exception/StackTrace.flat"
        expect(CompilerCli.run(["flatc", source, "-target", "es6", "-main", "flat/exception/StackTrace", "-o", output.normalizedLocation])).toBe(1)
        expect(CompilerCli.run(["flatc", source, "-target", "java", "-library", "-o", output.normalizedLocation])).toBe(1)
        expect(CompilerCli.run(["flatc", source, "-target", "es6", "-library", "-target-runtime", "browser", "-o", output.normalizedLocation])).toBe(1)
        expect(CompilerCli.run(["flatc", source, "-t", "es6", "-library", "-o", output.normalizedLocation])).toBe(1)
        expect(CompilerCli.run(["flatc", source, "-target", "es6", "-library", "-default-import", "flat/Object", "-o", output.normalizedLocation])).toBe(1)
        expect(CompilerCli.run(["flatc", source, "-target", "es6", "-library", "-threads", "2", "-o", output.normalizedLocation])).toBe(1)
        expect(CompilerCli.run(["flatc", source, "-target", "es6", "-library"])).toBe(1)
        expect(output.exists).toBe(false)
        if (root.exists) Es6ArtifactFiles.remove(root)
    }

    async test `CLI executable invokes unchanged production Char through the normal artifact`() {
        let root = File(".flat-compiler-cli-real-main-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        try {
            let source = File(root, "Main.flat")
            var String reference = ""
            reference += '#'
            reference += "{Char.repeat('a', 3)}"
            Es6ArtifactCommitter().commit(source,
                "package app\nimport flat/primitive/number/Char\nclass Main { public static main() { external js { console.log(" + reference + "); } } }")
            let output = File(root, "dist/es6/index.js")
            let arguments = String[]
            for (argument in realArguments(output)) {
                if (argument != "-library") arguments.add(argument)
            }
            arguments.addAll([source.normalizedLocation, "-main", "app/Main"])
            expect(CompilerCli.run(arguments)).toBe(0)
            let response = System.execute(["node", output.normalizedLocation], silent: true, shell: false)
            if (response.exitCode != 0) throw Exception(response.stderr.join(""))
            expect(response.stdout.join("")).toBe("aaa\n")
        } finally {
            Es6ArtifactFiles.remove(root)
        }
    }

    async test `CLI invalid main does not replace a previous artifact`() {
        let root = File(".flat-compiler-cli-invalid-main-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        try {
            let source = File(root, "Main.flat")
            let output = File(root, "index.js")
            String[] methods = ["public main() {}", "public static main(Int value) {}", "public static main() -> Int { return 1; }"]
            for (method in methods) {
                Es6ArtifactCommitter().commit(source, "package app\nclass Main { " + method + " }")
                Es6ArtifactCommitter().commit(output, "previous artifact\n")
                expect(CompilerCli.run(["flatc", source.normalizedLocation, "-target", "es6", "-main", "app/Main", "-o", output.normalizedLocation])).toBe(1)
                expect(Es6ArtifactFiles.read(output)).toBe("previous artifact\n")
            }
        } finally {
            Es6ArtifactFiles.remove(root)
        }
    }

    async test `CLI executes no argument argument and async entrypoints without invoking imports`() {
        let root = File(".flat-compiler-cli-entrypoint-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        try {
            String[] signatures = ["public static main()", "public static main(String[] args)", "public static async main(String[] args)"]
            var String argumentReference = ""
            argumentReference += '#'
            argumentReference += "{args}"
            String[] bodies = ["console.log('no-args');", "console.log(JSON.stringify(" + argumentReference + "));", "await Promise.resolve(); console.log(JSON.stringify(" + argumentReference + "));"]
            var Int index
            while (index < signatures.count) {
                let source = File(root, "Main.flat")
                Es6ArtifactCommitter().commit(source, "package app\nclass Main { " + signatures[index] + " { external js { " + bodies[index] + " } } }")
                let output = File(root, "dist/es6/index.js")
                expect(CompilerCli.run(["flatc", source.normalizedLocation, "-target", "es6",
                    "-main", "app/Main", "-d", File(root, "dist/es6").normalizedLocation, "-o", "index.js"])).toBe(0)
                let response = System.executeExact(["node", output.normalizedLocation, "hello", "two words"], silent: true, shell: false)
                if (response.exitCode != 0) throw Exception(response.stderr.join(""))
                expect(response.stdout.join("")).toBe(index == 0 ? "no-args\n" : "[\"hello\",\"two words\"]\n")
                let importer = File(root, "import.js")
                Es6ArtifactCommitter().commit(importer, "require('./dist/es6/index.js');\n")
                let imported = System.execute(["node", importer.normalizedLocation], silent: true, shell: false)
                expect(imported.exitCode).toBe(0)
                expect(imported.stdout.join("")).toBe("")
                index++
            }
        } finally {
            Es6ArtifactFiles.remove(root)
        }
    }

    async test `CLI admits explicitly bounded packages beyond 64 sources and preserves normal Airship artifact placement`() {
        let root = File(".flat-compiler-cli-package-test-#{Time.currentTimeMillis}")
        let sources = File(root, "src")
        Es6ArtifactFiles.ensureDirectory(sources)
        try {
            var Int index
            while (index < 65) {
                Es6ArtifactCommitter().commit(File(sources, "Unit#{index}.flat"),
                    "package admission\nclass Unit#{index} { public static value() -> Int { return #{index}; } }")
                index++
            }
            let outputDirectory = File(root, "dist/es6")
            let output = File(outputDirectory, "index.js")
            Es6ArtifactFiles.ensureDirectory(outputDirectory)
            Es6ArtifactCommitter().commit(output, "previous artifact\n")
            expect(CompilerCli.run([
                "flatc", sources.normalizedLocation, "-target", "es6", "-library",
                "-d", outputDirectory.normalizedLocation, "-o", "index.js"
            ])).toBe(1)
            expect(Es6ArtifactFiles.read(output)).toBe("previous artifact\n")
            expect(CompilerCli.run([
                "flatc", sources.normalizedLocation, "-target", "es6", "-library",
                "-d", outputDirectory.normalizedLocation, "-o", "index.js", "--max-sources", "65"
            ])).toBe(0)
            expect(output.isFile).toBe(true)
            expect(File(outputDirectory, "library.js").exists).toBe(false)
            let code = Es6ArtifactFiles.read(output)
            expect(code.count > 0).toBe(true)
            let response = System.execute(["node", output.normalizedLocation], silent: true, shell: false)
            expect(response.exitCode).toBe(0)
        } finally {
            Es6ArtifactFiles.remove(root)
        }
    }

    async test `CLI exclusion glob resolves absolute dependency paths outside working directory`() {
        let file = File("../Flat-Core/src/flat/datastruct/list/Array_Test.flat").getCanonicalFileSync()
        let sourceRoot = File("../Flat-Core/src").getCanonicalFileSync()
        expect(CompilerCli.matchesExclusion(sourceRoot.normalizedLocation + "/**/*_Test*.flat", sourceRoot)).toBe(false)
        expect(CompilerCli.matchesExclusion(sourceRoot.normalizedLocation + "/**/*_Test*.flat",
            File("src").getCanonicalFileSync())).toBe(false)
        expect(CompilerCli.matchesExclusion(sourceRoot.normalizedLocation + "/**/*_Test*.flat", file)).toBe(true)
        expect(CompilerCli.matchesExclusion(sourceRoot.normalizedLocation + "/**/*_Test*.flat",
            File("../Flat-Core/src/flat/primitive/number/Char.flat").getCanonicalFileSync())).toBe(false)
    }

    async test `CLI selects only base and ES6 compatible target overlays`() {
        let root = File(".flat-compiler-cli-overlay-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        try {
            Es6ArtifactCommitter().commit(File(root, "Base.flat"), "class Base {}")
            Es6ArtifactCommitter().commit(File(root, "Javascript.js.flat"), "class Javascript {}")
            Es6ArtifactCommitter().commit(File(root, "Ecma.es6.flat"), "class Ecma {}")
            Es6ArtifactCommitter().commit(File(root, "Wrong.java.flat"), "not valid Flat syntax")
            Es6ArtifactCommitter().commit(File(root, "Wrong.c.flat"), "not valid Flat syntax")
            Es6ArtifactCommitter().commit(File(root, "Wrong.unknown.flat"), "not valid Flat syntax")
            let output = File(root, "library.js")
            expect(CompilerCli.run(["flatc", root.normalizedLocation, "-target", "es6", "-library",
                "--max-sources", "3", "-o", output.normalizedLocation])).toBe(0)
            expect(output.isFile).toBe(true)
            expect(System.executeExact(["node", output.normalizedLocation], silent: true, shell: false).exitCode).toBe(0)
        } finally {
            Es6ArtifactFiles.remove(root)
        }
    }

    async test `CLI help remains successful without source or output`() {
        expect(CompilerCli.run(["flatc", "help"])).toBe(0)
        expect(CompilerCli.run(["flatc", "help", "--all"])).toBe(0)
    }
}
