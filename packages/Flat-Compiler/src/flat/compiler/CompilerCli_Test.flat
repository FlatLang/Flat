    class CleanupSpool extends SpooledCompilerArtifactSink {
        visible var Bool attempted
        public construct(File root) => super(root, 1, 67108864)
        override public dispose() {
            attempted = true
            super.dispose()
            throw Exception("controlled spool cleanup failure")
        }
    }

    class CleanupDestination extends FilesystemCompilerArtifactSink {
        visible var Bool attempted
        public construct(File root) => super(root, 1)
        override public retryCleanup() { attempted = true }
    }

    class CleanupGateLinker extends FlatEs6PackageLinker {
        visible var Bool entered
        visible var Bool cleaned
        public construct(visible Future<Bool> gate) => super(maxSources: 64,
            maxSourceCharacters: 65536, maxTokensPerSource: 8192, maxTypes: 256, maxFragments: 256)
        override public async linkSources(CompilerSourceProvider provider, String[] identities,
            DeclarationIdentity arrayDeclaration = null, String mainClass = null,
            PrimitiveDefaultImport[] defaultImports = PrimitiveDefaultImport[]) -> String {
            entered = true
            try {
                gate.get()
                return "cancelled code"
            } finally { cleaned = true }
        }
    }

    async test `CLI owner waits for cancelled package worker before disposing staging`() {
        let root = File(".flat-cli-cancel-cleanup-#{Time.currentTimeMillis}")
        let spool = CleanupSpool(root)
        let destination = CleanupDestination(root)
        Future.CompletableFuture<Bool> gate = Future.create<Bool>()
        let linker = CleanupGateLinker(gate)
        let session = CompilerSession()
        let sources = CompilerSource[]
        sources.add(CompilerSource("Value.flat", "class Value {}"))
        try {
            CompilerEngine(packageLinker: linker).startPackage(
                MemoryCompilerSourceProvider(sources), spool, "library.js", session)
            expect(linker.entered).toBe(true)
            session.cancel()
            let finalized = Future.from<Bool>(async {
                let summary = session.completion.get()
                expect(summary.cancelled).toBe(true)
                expect(summary.artifactCount).toBe(0)
                try { CompilerCli.publishArtifacts(spool, destination, Exception("cancelled")) }
                catch (Exception error) { expect(error.message).toBe("cancelled") }
                return true
            })$
            expect(session.completion.completed).toBe(false)
            expect(spool.attempted).toBe(false)
            gate.complete(true)
            expect(finalized.get()).toBe(true)
            expect(linker.cleaned).toBe(true)
            expect(spool.attempted).toBe(true)
            expect(destination.attempted).toBe(true)
            expect(File(root, "library.js").isFile).toBe(false)
        } finally { Es6ArtifactFiles.remove(root) }
    }

    test `CLI publication attempts both cleanups after successful publication`() {
        let root = File(".flat-cli-cleanup-#{Time.currentTimeMillis}")
        let spool = CleanupSpool(root)
        let destination = CleanupDestination(root)
        var String message
        try {
            spool.write(CompilerArtifact("library.js", "published"))
            try { CompilerCli.publishArtifacts(spool, destination) }
            catch (Exception error) { message = error.message }
            expect(message).toBe("Output published; cleanup failed: controlled spool cleanup failure")
            expect(spool.attempted).toBe(true)
            expect(destination.attempted).toBe(true)
            expect(Es6ArtifactFiles.read(File(root, "library.js"))).toBe("published")
        } finally { Es6ArtifactFiles.remove(root) }
    }

    class PublishedCleanupSpool extends SpooledCompilerArtifactSink {
        public construct(File root) => super(root, 1, 67108864)
        override public commitTo(FilesystemCompilerArtifactSink destination) {
            super.commitTo(destination)
            throw Exception("controlled post-publication cleanup failure")
        }
    }

    test `CLI reports published output when commitTo fails after publication`() {
        let root = File(".flat-cli-published-cleanup-#{Time.currentTimeMillis}")
        let spool = PublishedCleanupSpool(root)
        let destination = CleanupDestination(root)
        var String message
        try {
            Es6ArtifactFiles.write(File(root, "library.js"), "previous")
            spool.write(CompilerArtifact("library.js", "published"))
            try { CompilerCli.publishArtifacts(spool, destination) }
            catch (Exception error) { message = error.message }
            expect(message).toBe("Output published; cleanup failed: controlled post-publication cleanup failure")
            expect(Es6ArtifactFiles.read(File(root, "library.js"))).toBe("published")
            expect(destination.attempted).toBe(true)
            expect(root.getChildFiles(includeHidden: true, includeDirectories: true).count).toBe(1)
        } finally { Es6ArtifactFiles.remove(root) }
    }

    test `CLI preserves primary failure while both cleanup operations are attempted`() {
        let root = File(".flat-cli-primary-#{Time.currentTimeMillis}")
        let spool = CleanupSpool(root)
        let destination = CleanupDestination(root)
        var String message
        try {
            Es6ArtifactFiles.write(File(root, "library.js"), "previous")
            spool.write(CompilerArtifact("library.js", "unpublished"))
            try { CompilerCli.publishArtifacts(spool, destination, Exception("primary compilation failure")) }
            catch (Exception error) { message = error.message }
            expect(message).toBe("primary compilation failure")
            expect(spool.attempted).toBe(true)
            expect(destination.attempted).toBe(true)
            expect(Es6ArtifactFiles.read(File(root, "library.js"))).toBe("previous")
        } finally { Es6ArtifactFiles.remove(root) }
    }

    class RejectingDestination extends FilesystemCompilerArtifactSink {
        visible var Bool attempted
        public construct(File root) => super(root, 1)
        override public write(CompilerArtifact artifact) { throw Exception("controlled publication failure") }
        override public retryCleanup() { attempted = true }
    }

    test `CLI publication failure preserves output and finalizes both owners`() {
