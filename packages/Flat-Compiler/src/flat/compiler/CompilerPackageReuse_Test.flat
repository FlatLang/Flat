package flat/compiler

import flat/compiler/models
import flat/semantic/binding/primitive/PrimitiveDefaultImport
import flat/lexer
import flat/parser/flat
import flat/io
import flat/system
import flat/time/Time
import flat/writer/es6/bound

testable class {
    async test `reuse receipts distinguish actual hits closure changes removals and tool changes`() {
        let linker = CountingLinker()
        let engine = CompilerEngine(packageLinker: linker, packageReuse: CompilerPackageReuse())
        let first = engine.compilePackageSnapshots(sources(), MemoryCompilerArtifactSink(), "first.js",
            toolFingerprint: "sha256:tool-one").completion.get()
        expect(first.reuse.reason).toBe("cold")
        expect(first.reuse.addedSources).toBe(2)
        expect(first.reuse.reused).toBe(false)
        let warm = engine.compilePackageSnapshots(sources(), MemoryCompilerArtifactSink(), "warm.js",
            toolFingerprint: "sha256:tool-one").completion.get()
        expect(warm.reuse.reused).toBe(true)
        expect(warm.reuse.unchangedSources).toBe(2)
        expect(linker.calls).toBe(1)
        let changed = sources()
        changed[0] = CompilerSource(changed[0].identity, changed[0].text + "\n")
        let edit = engine.compilePackageSnapshots(changed, MemoryCompilerArtifactSink(), "edit.js",
            toolFingerprint: "sha256:tool-one").completion.get()
        expect(edit.reuse.reason).toBe("closure-changed")
        expect(edit.reuse.changedSources).toBe(1)
        expect(edit.reuse.unchangedSources).toBe(1)
        expect(linker.calls).toBe(2)
        let removed = engine.compilePackageSnapshots([CompilerSource("Only.flat", "class Only {}")],
            MemoryCompilerArtifactSink(), "removed.js", toolFingerprint: "sha256:tool-one").completion.get()
        expect(removed.reuse.removedSources).toBe(2)
        expect(removed.reuse.addedSources).toBe(1)
        let tool = engine.compilePackageSnapshots([CompilerSource("Only.flat", "class Only {}")],
            MemoryCompilerArtifactSink(), "tool.js", toolFingerprint: "sha256:tool-two").completion.get()
        expect(tool.reuse.reason).toBe("configuration-changed")
        expect(tool.reuse.reused).toBe(false)
        expect(tool.reuse.toolFingerprint).toBe("sha256:tool-two")
        expect(linker.calls).toBe(4)
    }

    async test `configured import changes invalidate exact package reuse`() {
        let linker = CountingLinker()
        let engine = CompilerEngine(packageLinker: linker, packageReuse: CompilerPackageReuse())
        let values = [CompilerSource("Only.flat", "class Only {}")]
        let defaults = [PrimitiveDefaultImport("app/First")]
        let first = engine.compilePackageSnapshots(values, MemoryCompilerArtifactSink(), "one.js",
            defaultImports: defaults).completion.get()
        expect(first.diagnosticCount).toBe(0)
        let warm = engine.compilePackageSnapshots(values, MemoryCompilerArtifactSink(), "two.js",
            defaultImports: defaults).completion.get()
        expect(warm.reuse.reused).toBe(true)
        let next = engine.compilePackageSnapshots(values, MemoryCompilerArtifactSink(), "three.js",
            defaultImports: [PrimitiveDefaultImport("app/Second")]).completion.get()
        expect(next.reuse.reason).toBe("configuration-changed")
        expect(next.reuse.reused).toBe(false)
        expect(linker.calls).toBe(2)
    }

    class CountingLinker extends FlatEs6PackageLinker {
        visible var Int calls
        visible var Bool fail

        public construct() => super(maxSources: 64, maxSourceCharacters: 65536,
            maxTokensPerSource: 8192, maxTypes: 256, maxFragments: 256)

        override public async linkSources(
            CompilerSourceProvider provider, String[] identities,
            DeclarationIdentity arrayDeclaration = null, String mainClass = null,
            PrimitiveDefaultImport[] defaultImports = PrimitiveDefaultImport[]
        ) -> String {
            calls++
            if (fail) throw Exception("controlled link failure")
            let delegate = FlatEs6PackageLinker(maxSources: maxSources,
                maxSourceCharacters: maxSourceCharacters, maxTokensPerSource: maxTokensPerSource,
                maxTypes: maxTypes, maxFragments: maxFragments)
            return delegate.linkSources(provider, identities, arrayDeclaration, mainClass, defaultImports)
        }
    }

    class MutatingSink extends CompilerArtifactSink {
        var CompilerArtifact[] values = CompilerArtifact[]
        visible var String pristineCode

        public construct(visible Bool failAfterMutation = false) {}

        override public write(CompilerArtifact artifact) {
            // Mutation occurs inside publication, not after compile returns.
            pristineCode = artifact.code.concat("")
            artifact.code.chars[0] = '#'
            if (failAfterMutation) throw Exception("controlled mutation then sink failure")
            values.add(artifact)
        }

        override public artifacts() -> CompilerArtifact[] => values.copy()
    }

    class RejectingSink extends CompilerArtifactSink {
        override public write(CompilerArtifact artifact) { throw Exception("controlled sink failure") }
        override public artifacts() -> CompilerArtifact[] => CompilerArtifact[]
    }

    sources(Int value = 11) -> CompilerSource[] {
        CompilerSource[] values = [
            CompilerSource("dep/Value.flat", "package dep\nclass Value { public static value() -> Int { return #value; } }"),
            CompilerSource("app/Main.flat", "package app\nimport dep/Value\nclass Main { public static run() -> Int { return Value.value(); } }")
        ]
        return values
    }

    async test `exact snapshots hit with fresh sessions sinks and executable artifacts`() {
        let linker = CountingLinker()
        let reuse = CompilerPackageReuse()
        let engine = CompilerEngine(packageLinker: linker, packageReuse: reuse)
        let original = sources()
        let firstSink = MemoryCompilerArtifactSink()
        let first = engine.compilePackageSnapshots(original, firstSink, "first.js")
        // The supplied array is not retained; provider order is not semantic.
        original[0] = CompilerSource("unused.flat", "class Unused {}")
        let reordered = sources()
        let reversed = [reordered[1], reordered[0]]
        let secondSink = MemoryCompilerArtifactSink()
        let second = engine.compilePackageSnapshots(reversed, secondSink, "second.js")
        expect(linker.calls).toBe(1)
        expect(first == second).toBe(false)
        expect(first.completion.get().diagnosticCount).toBe(0)
        expect(second.completion.get().artifactCount).toBe(1)
        expect(second.completion.get().sourceCount).toBe(2)
        expect(second.artifacts.receive().completed).toBe(true)
        expect(firstSink.artifacts().first.identity).toBe("first.js")
        expect(secondSink.artifacts().first.identity).toBe("second.js")
        expect(firstSink.artifacts().first.code).toBe(secondSink.artifacts().first.code)
        let source = sources()[1]
        let snapshot = SourceSnapshotIdentity(SourceIdentity(source.identity), "compiler-input")
        let stream = Lexer().lex(source.text)
        stream.emit("start")
        // One tiny supplied source: derive the observable declaration identities
        // by the same source/token identities as normal generated execution tests.
        let partition = FlatSourceTypePartitioner().partition(
            stream.consumeAll<Token>("data"), snapshot, "js").first
        let syntax = PrimitiveClassParser().parse(
            partition.tokenValues(), snapshot, partition.startTokenIndex, "Main")
        let owner = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "class", syntax.range.startTokenIndex),
            "class", "Main")
        let method = syntax.methodValues().first
        let entry = DeclarationIdentity(SyntaxIslandIdentity(snapshot, "static-method", method.range.startTokenIndex),
            "static-method", "run")
        let root = File(".flat-compiler-reuse-test-#{Time.currentTimeMillis}")
        Es6ArtifactFiles.ensureDirectory(root)
        try {
            let artifacts = [firstSink.artifacts().first, secondSink.artifacts().first]
            for (artifact in artifacts) {
                let file = File(root, artifact.identity)
                Es6ArtifactCommitter().commit(file, artifact.code + "\nconsole.log(" +
                    Es6NameMangler.mangle(owner.value) + "." +
                    Es6NameMangler.mangle(entry.value) + "());\n")
                let result = System.execute(["node", file.normalizedLocation], silent: true, shell: false)
                expect(result.exitCode).toBe(0)
                expect(result.stdout.join("")).toBe("11\n")
            }
        } finally { Es6ArtifactFiles.remove(root) }
    }

    async test `sink mutation during publication cannot become cached compiler output`() {
        let linker = CountingLinker()
        let reuse = CompilerPackageReuse()
        let engine = CompilerEngine(packageLinker: linker, packageReuse: reuse)
        let coldSink = MutatingSink()
        let cold = engine.compilePackageSnapshots(sources(), coldSink, "cold.js")
        expect(cold.completion.get().diagnosticCount).toBe(0)
        expect(cold.completion.get().artifactCount).toBe(1)
        expect(coldSink.artifacts().first.code == coldSink.pristineCode).toBe(false)
        let hitSink = MemoryCompilerArtifactSink()
        let hit = engine.compilePackageSnapshots(sources(), hitSink, "hit.js")
        expect(hit.completion.get().diagnosticCount).toBe(0)
        expect(hit.completion.get().artifactCount).toBe(1)
        expect(linker.calls).toBe(1)
        expect(hitSink.artifacts().first.code).toBe(coldSink.pristineCode)
        // A later hit is also untrusted publication, not a new compiler result.
        let mutatingHit = MutatingSink()
        engine.compilePackageSnapshots(sources(), mutatingHit, "mutated-hit.js")
        let again = MemoryCompilerArtifactSink()
        engine.compilePackageSnapshots(sources(), again, "again.js")
        expect(linker.calls).toBe(1)
        expect(again.artifacts().first.code).toBe(coldSink.pristineCode)
    }

    async test `sink mutation followed by failure never admits captured code`() {
        let linker = CountingLinker()
        let engine = CompilerEngine(packageLinker: linker, packageReuse: CompilerPackageReuse())
        let failing = MutatingSink(failAfterMutation: true)
        let failed = engine.compilePackageSnapshots(sources(), failing, "failed.js")
        let summary = failed.completion.get()
        expect(summary.diagnosticCount).toBe(1)
        expect(summary.artifactCount).toBe(0)
        expect(failing.artifacts().count).toBe(0)
        let repairedSink = MemoryCompilerArtifactSink()
        let repaired = engine.compilePackageSnapshots(sources(), repairedSink, "repaired.js")
        expect(repaired.completion.get().diagnosticCount).toBe(0)
        expect(linker.calls).toBe(2)
        expect(repairedSink.artifacts().first.code).toBe(failing.pristineCode)
        let hitSink = MemoryCompilerArtifactSink()
        engine.compilePackageSnapshots(sources(), hitSink, "hit.js")
        expect(linker.calls).toBe(2)
        expect(hitSink.artifacts().first.code).toBe(failing.pristineCode)
    }

    async test `same length source text mutation misses and emitted code cannot poison hits`() {
        let linker = CountingLinker()
        let engine = CompilerEngine(packageLinker: linker, packageReuse: CompilerPackageReuse())
        let inputs = sources()
        let cold = MemoryCompilerArtifactSink()
        engine.compilePackageSnapshots(inputs, cold, "cold.js")
        let coldCode = cold.artifacts().first.code.concat("")
        let dependency = inputs.first.text
        let offset = dependency.indexOf("11")
        dependency.chars[offset] = '2'
        dependency.chars[offset + 1] = '2'
        expect(dependency.count).toBe(sources().first.text.count)
        let dirty = MemoryCompilerArtifactSink()
        engine.compilePackageSnapshots(inputs, dirty, "dirty.js")
        expect(linker.calls).toBe(2)
        expect(dirty.artifacts().first.code == coldCode).toBe(false)
        let dirtyCode = dirty.artifacts().first.code.concat("")
        dirty.artifacts().first.code.chars[0] = '#'
        let hit = MemoryCompilerArtifactSink()
        engine.compilePackageSnapshots(inputs, hit, "hit.js")
        expect(linker.calls).toBe(2)
        expect(hit.artifacts().first.code).toBe(dirtyCode)
        hit.artifacts().first.code.chars[0] = '#'
        let again = MemoryCompilerArtifactSink()
        engine.compilePackageSnapshots(inputs, again, "again.js")
        expect(linker.calls).toBe(2)
        expect(again.artifacts().first.code).toBe(dirtyCode)
    }

    async test `snapshot owns strings across input provider and result boundaries`() {
        let reuse = CompilerPackageReuse()
        let linker = CountingLinker()
        let values = sources()
        let main = "app/Main".concat("")
        let snapshot = reuse.capture(values, main, linker)
        let original = reuse.capture(sources(), "app/Main", linker)
        main.chars[0] = 'x'
        values.first.identity.chars[0] = 'x'
        values.first.text.chars[0] = 'x'
        expect(snapshot.matches(original)).toBe(true)
        snapshot.identities().first.chars[0] = 'x'
        let loaded = snapshot.load("dep/Value.flat")
        loaded.identity.chars[0] = 'x'
        loaded.text.chars[0] = 'x'
        snapshot.mainClass.chars[0] = 'x'
        snapshot.options.chars[0] = 'x'
        expect(snapshot.matches(original)).toBe(true)
        let code = "safe".concat("")
        original.recordCode(code)
        reuse.remember(original, CompilationSummary(2, 1, 0, false))
        code.chars[0] = 'x'
        original.code.chars[0] = 'x'
        expect(reuse.find(snapshot)).toBe("safe")
        original.recordCode("evil")
        expect(reuse.find(snapshot)).toBe("safe")
        let hit = reuse.find(snapshot)
        hit.chars[0] = 'x'
        expect(reuse.find(snapshot)).toBe("safe")
    }

    async test `dependency edits main selection linker identity and reset invalidate one entry`() {
        let linker = CountingLinker()
        let reuse = CompilerPackageReuse()
        let engine = CompilerEngine(packageLinker: linker, packageReuse: reuse)
        engine.compilePackageSnapshots(sources(), MemoryCompilerArtifactSink(), "a.js")
        engine.compilePackageSnapshots(sources(22), MemoryCompilerArtifactSink(), "a.js")
        expect(linker.calls).toBe(2)
        // Main selection is part of the key even when it diagnoses a missing main.
        engine.compilePackageSnapshots(sources(22), MemoryCompilerArtifactSink(), "a.js", "app/Main")
        expect(linker.calls).toBe(3)
        engine.compilePackageSnapshots(sources(), MemoryCompilerArtifactSink(), "a.js")
        expect(linker.calls).toBe(4)
        reuse.reset()
        engine.compilePackageSnapshots(sources(), MemoryCompilerArtifactSink(), "a.js")
        expect(linker.calls).toBe(5)
        let other = CountingLinker()
        CompilerEngine(packageLinker: other, packageReuse: reuse).compilePackageSnapshots(
            sources(), MemoryCompilerArtifactSink(), "a.js")
        expect(other.calls).toBe(1)
    }

    async test `failed compilation is never retained`() {
        let linker = CountingLinker()
        let engine = CompilerEngine(packageLinker: linker, packageReuse: CompilerPackageReuse())
        linker.fail = true
        let failed = engine.compilePackageSnapshots(sources(), MemoryCompilerArtifactSink(), "a.js")
        expect(failed.completion.get().diagnosticCount).toBe(1)
        linker.fail = false
        let repaired = engine.compilePackageSnapshots(sources(), MemoryCompilerArtifactSink(), "a.js")
        expect(repaired.completion.get().diagnosticCount).toBe(0)
        engine.compilePackageSnapshots(sources(), MemoryCompilerArtifactSink(), "a.js")
        expect(linker.calls).toBe(2)
    }

    test `selected source set identities and exact bytes all invalidate`() {
        let reuse = CompilerPackageReuse()
        let linker = CountingLinker()
        let original = reuse.capture(sources(), null, linker)
        original.recordCode("code")
        reuse.remember(original, CompilationSummary(2, 1, 0, false))
        let changed = sources(22)
        expect(reuse.find(reuse.capture(changed, null, linker))).toBe(null)
        expect(reuse.find(reuse.capture([sources().first], null, linker))).toBe(null)
        let renamed = sources()
        renamed[0] = CompilerSource("dep/Renamed.flat", renamed[0].text)
        expect(reuse.find(reuse.capture(renamed, null, linker))).toBe(null)
        let added = sources()
        added.add(CompilerSource("dep/Other.flat", "class Other {}"))
        expect(reuse.find(reuse.capture(added, null, linker))).toBe(null)
        expect(reuse.find(reuse.capture(sources(), null, linker))).toBe("code")
    }

    async test `sink failure does not admit success and configured default path still streams`() {
        let linker = CountingLinker()
        let engine = CompilerEngine(packageLinker: linker, packageReuse: CompilerPackageReuse())
        let failed = engine.compilePackageSnapshots(sources(), RejectingSink(), "a.js")
        expect(failed.completion.get().diagnosticCount).toBe(1)
        engine.compilePackageSnapshots(sources(), MemoryCompilerArtifactSink(), "a.js")
        expect(linker.calls).toBe(2)
        // Configuring reuse alone must not capture/materialize a provider path.
        engine.compilePackage(MemoryCompilerSourceProvider(sources()), MemoryCompilerArtifactSink(), "a.js")
        engine.compilePackage(MemoryCompilerSourceProvider(sources()), MemoryCompilerArtifactSink(), "a.js")
        expect(linker.calls).toBe(4)
    }

    test `cancelled failed and superseded publication tickets cannot populate reuse`() {
        let reuse = CompilerPackageReuse()
        let linker = CountingLinker()
        let cancelled = reuse.capture(sources(), null, linker)
        cancelled.recordCode("code")
        reuse.remember(cancelled, CompilationSummary(2, 1, 0, true))
        expect(reuse.find(cancelled)).toBe(null)
        reuse.remember(cancelled, CompilationSummary(2, 1, 1, false))
        expect(reuse.find(cancelled)).toBe(null)
        reuse.remember(cancelled, CompilationSummary(2, 1, 0, false, cleanupSettled: false))
        expect(reuse.find(cancelled)).toBe(null)
        reuse.remember(cancelled, CompilationSummary(1, 1, 0, false))
        expect(reuse.find(cancelled)).toBe(null)
        reuse.remember(cancelled, CompilationSummary(2, 1, 0, false, "unreported failure"))
        expect(reuse.find(cancelled)).toBe(null)
        let newer = reuse.capture(sources(22), null, linker)
        reuse.remember(cancelled, CompilationSummary(2, 1, 0, false))
        expect(reuse.find(cancelled)).toBe(null)
        newer.recordCode("new code")
        reuse.reset()
        reuse.remember(newer, CompilationSummary(2, 1, 0, false))
        expect(reuse.find(newer)).toBe(null)
    }

    test `oversized successful output is not retained and main selection keys exactly`() {
        let reuse = CompilerPackageReuse(maxBytes: 4096)
        let linker = CountingLinker()
        let library = reuse.capture(sources(), null, linker)
        library.recordCode("code")
        reuse.remember(library, CompilationSummary(2, 1, 0, false))
        expect(reuse.find(library)).toBe("code")
        let executable = reuse.capture(sources(), "app/Main", linker)
        expect(reuse.find(executable)).toBe(null)
        executable.recordCode("x".repeat(4096))
        reuse.remember(executable, CompilationSummary(2, 1, 0, false))
        expect(reuse.find(executable)).toBe(null)
        expect(reuse.find(library)).toBe(null)
    }

    async test `explicit opt in and source byte bounds reject before linking`() {
        var Bool rejected
        try {
            CompilerEngine().compilePackageSnapshots(sources(), MemoryCompilerArtifactSink(), "a.js")
        } catch (Exception error) { rejected = true }
        expect(rejected).toBe(true)
        let linker = CountingLinker()
        let engine = CompilerEngine(packageLinker: linker,
            packageReuse: CompilerPackageReuse(maxSources: 1, maxBytes: 64))
        rejected = false
        try { engine.compilePackageSnapshots(sources(), MemoryCompilerArtifactSink(), "a.js") }
        catch (Exception error) { rejected = true }
        expect(rejected).toBe(true)
        rejected = false
        try { engine.compilePackageSnapshots([sources().first], MemoryCompilerArtifactSink(), "a.js") }
        catch (Exception error) { rejected = true }
        expect(rejected).toBe(true)
        expect(linker.calls).toBe(0)
    }
}
