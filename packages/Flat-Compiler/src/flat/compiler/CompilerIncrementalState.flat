package flat/compiler

import flat/io

/**
 * ES6/Node persistent package fingerprint manifest. One lock is held from admission
 * through output/manifest publication, scoped to a destination, never the project.
 * Only SHA-256 source metadata is retained; reads/hash buffers are bounded. A hit
 * requires the current closure, exact CLI options, actual executing compiler bytes,
 * and destination bytes to match. No cached generated payload or mtime shortcut.
 *
 * The manifest is published after the artifact. A crash between them leaves a safe
 * miss (output digest disagreement), never authority to accept stale output. A
 * failed/cancelled compilation never replaces the prior manifest. Lock acquisition
 * fails visibly rather than waiting unboundedly or stealing another process's lock.
 * Optional manifestObserver uses artifact lifecycle callbacks, bound to revision
 * and the absolute manifest destination (identity is the manifest basename).
 * Only observed paths emit create/remove; finalization failure retains the exact
 * temporary tree and destination lock for dispose retry. No event queue is held.
 */
class extends CompilerSourceProvider {
    native var Object state
    private var Bool admissionEmissionStarted
    private CompilerSourceProvider provider
    private CompilerArtifactLifecycleObserver manifestObserver
    private var CompilerArtifactLifecycleStorage manifestTemporary
    private var CompilerArtifactLifecycleBinding manifestBinding
    visible Bool reused

    public construct(CompilerSourceProvider provider, File[] files, String[] arguments,
        File destination, Long maxArtifactBytes, Int maxSourceCharacters = 1048576,
        String toolLocation = null, CompilerArtifactLifecycleObserver manifestObserver = null) {
        if (!provider || !files || !arguments || !destination || maxArtifactBytes <= 0 ||
            maxSourceCharacters <= 0) throw Exception("Persistent compiler state requires bounded inputs")
        this.provider = provider
        this.manifestObserver = manifestObserver
        native_array native var Char[] errorMessage
        var Bool hit
        external js {
            const fs = #{File.FileGlobal.fs};
            // Flat runtime types can share builtin names in the generated module.
            const Error = globalThis.Error;
            const Date = globalThis.Date;
            const Buffer = globalThis.Buffer;
            const JSON = globalThis.JSON;
            const crypto = require('crypto');
            const path = require('path');
            const destinationPath = path.resolve(#{destination.location.chars.data});
            const manifest = destinationPath + '.flat-incremental.json';
            const lock = manifest + '.lock';
            let owned = false;
            try {
                fs.mkdirSync(path.dirname(destinationPath), {recursive:true});
                try { fs.mkdirSync(lock); }
                catch (error) {
                    if (error.code === 'EEXIST') {
                        throw new Error('Incremental destination is locked: ' + lock +
                            '. Inspect owner.json; wait for the owner, or stop all writers and quarantine this exact lock directory before retrying. No lock is deleted automatically.');
                    }
                    throw error;
                }
                owned = true;
                const lockIdentity = fs.lstatSync(lock);
                fs.writeFileSync(path.join(lock,'owner.json'), JSON.stringify({pid:process.pid,
                    host:require('os').hostname(), startedAt:new Date().toISOString(),
                    compiler:process.argv[1], destination:destinationPath}), {flag:'wx'});
                const ownerIdentity = fs.lstatSync(path.join(lock,'owner.json'));
                const digestFile = (location, limit) => {
                    const fd = fs.openSync(location, 'r');
                    try {
                        const stat = fs.fstatSync(fd);
                        if (!stat.isFile() || stat.size > limit) throw new Error('Fingerprint input exceeds configured capacity: ' + location);
                        const hash = crypto.createHash('sha256');
                        const buffer = Buffer.alloc(65536);
                        let total = 0, size;
                        while ((size = fs.readSync(fd, buffer, 0, buffer.length, null)) > 0) {
                            total += size;
                            if (total > limit) throw new Error('Fingerprint input grew past capacity');
                            hash.update(buffer.subarray(0,size));
                        }
                        return hash.digest('hex');
                    } finally { fs.closeSync(fd); }
                };
                const maxSourceBytes = #{maxSourceCharacters} * 4;
                const maxOutputBytes = globalThis.Number(#{maxArtifactBytes});
                if (#{files.count} > 16384 || #{arguments.count} > 65536) throw new Error('Incremental metadata exceeds entry capacity');
                const options = #{arguments.map({ _.chars.data }).data};
                if (options.some(value => value.length > 1048576) ||
                    options.reduce((size,value) => size + Buffer.byteLength(value),0) > 4194304) {
                    throw new Error('Incremental options exceed metadata capacity');
                }
                const tool = #{toolLocation != null} ? #{toolLocation ? toolLocation.chars.data : "".chars.data} : process.argv[1];
                if (!tool) throw new Error('Persistent state requires the executing compiler file');
                // A compiler executable is a separately bounded tool input, not a source unit.
                const toolDigest = digestFile(path.resolve(tool), 268435456);
                const entries = [];
                let metadataBytes = 0;
                const expected = new globalThis.Map();
                const physicalSources = new globalThis.Set();
                for (const identity of #{files.map({ _.normalizedLocation.chars.data }).data}) {
                    const location = fs.realpathSync(identity);
                    const sourceIdentity = path.resolve(identity);
                    const digest = digestFile(location, maxSourceBytes);
                    metadataBytes += Buffer.byteLength(sourceIdentity) + 128;
                    if (Buffer.byteLength(sourceIdentity) > 16384 || metadataBytes > 4000000) {
                        throw new Error('Incremental source metadata exceeds capacity');
                    }
                    if (physicalSources.has(location)) throw new Error('Incremental closure requires unique physical sources');
                    physicalSources.add(location);
                    // Preserve the compiler-visible identity. Hashing only the real path
                    // loses alias identity and can miss a retargeted source symlink.
                    entries.push({identity:sourceIdentity, digest});
                    expected.set(identity, digest);
                }
                entries.sort((a,b) => a.identity < b.identity ? -1 : a.identity > b.identity ? 1 : 0);
                const configuration = crypto.createHash('sha256').update(JSON.stringify({
                    schema:'flat.compiler.incremental.v1', publication:'staged-sha256-v1', options, tool:toolDigest,
                    node:process.versions.node, maxSourceBytes, maxOutputBytes
                })).digest('hex');
                const key = crypto.createHash('sha256').update(JSON.stringify({configuration,entries})).digest('hex');
                let previous = null;
                if (fs.existsSync(manifest)) {
                    try {
                        const fd = fs.openSync(manifest,'r');
                        try {
                            const manifestStat = fs.fstatSync(fd);
                            if (manifestStat.isFile() && manifestStat.size <= 4194304) {
                                const buffer = Buffer.alloc(4194305);
                                let total = 0, size;
                                while (total < buffer.length && (size = fs.readSync(fd,buffer,total,buffer.length-total,null)) > 0) total += size;
                                if (total <= 4194304) previous = JSON.parse(buffer.subarray(0,total).toString('utf8'));
                            }
                        } finally { fs.closeSync(fd); }
                        if (!previous || previous.schema !== 'flat.compiler.incremental.v1' ||
                            !globalThis.Array.isArray(previous.entries) || previous.entries.length > 16384 ||
                            !previous.diagnostics || previous.diagnostics.complete !== true ||
                            !globalThis.Array.isArray(previous.diagnostics.records) || previous.diagnostics.records.length !== 0 ||
                            typeof previous.output !== 'string' || typeof previous.key !== 'string' ||
                            typeof previous.configuration !== 'string' ||
                            !/^[0-9a-f]{64}$/.test(previous.output) || !/^[0-9a-f]{64}$/.test(previous.key) ||
                            !/^[0-9a-f]{64}$/.test(previous.configuration) ||
                            previous.entries.some((value,index) => !value || typeof value.identity !== 'string' ||
                                Buffer.byteLength(value.identity) > 16384 || !path.isAbsolute(value.identity) ||
                                path.normalize(value.identity) !== value.identity || typeof value.digest !== 'string' ||
                                (index > 0 && previous.entries[index-1].identity >= value.identity) ||
                                !/^[0-9a-f]{64}$/.test(value.digest))) previous = null;
                        if (previous && crypto.createHash('sha256').update(JSON.stringify({
                            configuration:previous.configuration, entries:previous.entries
                        })).digest('hex') !== previous.key) previous = null;
                    } catch (_) { previous = null; }
                }
                let unchanged = 0, changed = 0, added = 0, removed = 0;
                const old = new globalThis.Map(previous ? previous.entries.map(value => [value.identity,value.digest]) : []);
                for (const value of entries) {
                    if (!old.has(value.identity)) added++;
                    else if (old.get(value.identity) === value.digest) unchanged++;
                    else changed++;
                    old.delete(value.identity);
                }
                removed = old.size;
                let nativeReuseHit = false;
                if (previous && previous.key === key && fs.existsSync(destinationPath)) {
                    try { nativeReuseHit = digestFile(destinationPath,maxOutputBytes) === previous.output; }
                    catch (_) { nativeReuseHit = false; }
                }
                const reason = nativeReuseHit ? 'exact-hit' : !previous ? 'cold' :
                    previous.configuration !== configuration ? 'configuration-changed' :
                    previous.key !== key ? 'closure-changed' : 'output-changed';
                #{state} = {fs, crypto, digestFile, manifest, lock, lockIdentity, ownerIdentity, ownerRemoved:false, destinationPath, entries,
                    expected, configuration, key, toolDigest,
                    optionsFingerprint:crypto.createHash('sha256').update(JSON.stringify(options)).digest('hex'),
                    sourceInventoryFingerprint:crypto.createHash('sha256').update(JSON.stringify(entries)).digest('hex'),
                    maxSourceBytes, maxOutputBytes,
                    tool:path.resolve(tool), owned:true, hit:nativeReuseHit, previousOutput:previous ? previous.output : null,
                    evidence:{schema:'flat.compiler.incremental.v1', scope:'persistent-cli-package',
                        reused:nativeReuseHit, reason, unchangedSources:unchanged, changedSources:changed,
                        addedSources:added, removedSources:removed, toolFingerprint:'sha256:'+toolDigest,
                        inputFingerprint:'sha256:'+key, manifestPublished:false,
                        diagnostics:{complete:nativeReuseHit, records:nativeReuseHit ? [] : null}}};
                #{hit} = nativeReuseHit;
            } catch (error) {
                let message = error.message;
                if (owned) {
                    try { fs.unlinkSync(path.join(lock,'owner.json')); }
                    catch (cleanup) { if (cleanup.code !== 'ENOENT') message += '; owner cleanup failed: ' + cleanup.message; }
                    try { fs.rmdirSync(lock); }
                    catch (cleanup) { message += '; incremental lock cleanup failed: ' + cleanup.message; }
                }
                #{errorMessage} = message;
            }
        }
        if (errorMessage) throw Exception(String(errorMessage))
        reused = hit
    }

    override public identities() -> String[] {
        let values = provider.identities()
        native_array native var Char[] errorMessage
        external js {
            const expected = #{state}.expected;
            const admittedIdentityStrings = #{values.map({ _.chars.data }).data};
            if (admittedIdentityStrings.length !== expected.size || new globalThis.Set(admittedIdentityStrings).size !== admittedIdentityStrings.length ||
                admittedIdentityStrings.some(identity => !expected.has(identity))) {
                #{errorMessage} = 'Provider closure differs from incremental admission';
            }
        }
        if (errorMessage) throw Exception(String(errorMessage))
        return values
    }
    override public checkpoint() { provider.checkpoint() }
    override public async load(String identity) -> CompilerSource {
        let value = provider.load(identity)
        if (!value) return null
        native_array native var Char[] errorMessage
        external js {
            const expected = #{state}.expected.get(#{identity.chars.data});
            const actual = #{state}.crypto.createHash('sha256').update(#{value.text.chars.data}, 'utf8').digest('hex');
            if (!expected || expected !== actual) #{errorMessage} = 'Source changed after incremental admission';
        }
        if (errorMessage) throw Exception(String(errorMessage))
        return value
    }

    /** Revalidate before publication; cancellation never writes persistent state. */
    public validate() {
        identities()
        native_array native var Char[] errorMessage
        external js {
            try {
                const s = #{state};
                const Error = globalThis.Error;
                if (!s.owned || s.ownerRemoved) throw new Error('Incremental transaction is closed');
                const currentLock = s.fs.lstatSync(s.lock);
                const currentOwner = s.fs.lstatSync(s.lock+'/owner.json');
                if (!currentLock.isDirectory() || currentLock.dev !== s.lockIdentity.dev ||
                    currentLock.ino !== s.lockIdentity.ino || !currentOwner.isFile() ||
                    currentOwner.dev !== s.ownerIdentity.dev || currentOwner.ino !== s.ownerIdentity.ino) {
                    throw new Error('Incremental lock ownership changed');
                }
                if (s.digestFile(s.tool,268435456) !== s.toolDigest) throw new Error('Compiler changed during compilation');
                if (s.published && s.digestFile(s.destinationPath,s.maxOutputBytes) !== s.preparedOutput && !s.hit) {
                    throw new Error('Published output changed after incremental commit');
                }
                const expectedOutput = s.hit ? s.previousOutput : null;
                if (expectedOutput && s.digestFile(s.destinationPath,s.maxOutputBytes) !== expectedOutput) {
                    throw new Error('Output changed during incremental admission');
                }
                for (const value of s.entries) {
                    if (s.digestFile(value.identity,s.maxSourceBytes) !== value.digest) throw new Error('Source changed during compilation');
                }
            } catch (error) { #{errorMessage} = error.message; }
        }
        if (errorMessage) throw Exception(String(errorMessage))
    }

    /** Bind the exact staged artifact before the caller atomically publishes it.
     * A summary alone cannot prove that the destination belongs to this compilation.
     * Keep the staging file private until publication; commit verifies its digest.
     */
    public preparePublication(File artifact, CompilationSummary summary) {
        requireSuccessfulSummary(summary)
        if (!artifact) throw Exception("Persistent publication requires a staged artifact")
        validate()
        native_array native var Char[] errorMessage
        external js {
            try {
                const s = #{state};
                if (s.hit || s.published || s.preparedOutput) throw new globalThis.Error('Incremental publication already admitted');
                s.preparedOutput = s.digestFile(#{artifact.normalizedLocation.chars.data},s.maxOutputBytes);
            } catch (error) { #{errorMessage} = error.message; }
        }
        if (errorMessage) throw Exception(String(errorMessage))
    }

    private requireSuccessfulSummary(CompilationSummary summary) {
        identities()
        if (!summary || !summary.succeeded ||
            summary.artifactCount != 1) throw Exception("Persistent publication requires successful settled compilation")
        var Int sourceCount
        external js { #{sourceCount} = #{state}.entries.length; }
        if (summary.sourceCount != sourceCount) throw Exception("Persistent publication requires the complete admitted closure")
    }

    /** Call only after successful atomic destination publication or a validated hit.
     * At most one manifest temporary is owned; failed cleanup survives for dispose retry.
     */
    public commit(CompilationSummary summary) {
        requireSuccessfulSummary(summary)
        validate()
        if (manifestTemporary) throw Exception("Incremental manifest cleanup remains pending")
        native_array native var Char[] errorMessage
        native_array native var Char[] temporaryPath
        native_array native var Char[] manifestPath
        external js {
            const s = #{state};
            const Error = globalThis.Error;
            try {
                const output = s.digestFile(s.destinationPath,s.maxOutputBytes);
                if (s.published) throw new Error('Incremental transaction already published');
                const expectedOutput = s.hit ? s.previousOutput : s.preparedOutput;
                if (!expectedOutput || output !== expectedOutput) {
                    throw new Error('Destination does not match the admitted publication artifact');
                }
                const contents = globalThis.JSON.stringify({schema:'flat.compiler.incremental.v1',
                    key:s.key, configuration:s.configuration, entries:s.entries, output,
                    diagnostics:{complete:true, records:[]}});
                if (globalThis.Buffer.byteLength(contents) > 4194304) throw new Error('Incremental manifest exceeds capacity');
                s.manifestContents = contents;
                #{manifestPath} = s.manifest;
            } catch (error) { #{errorMessage} = error.message; }
        }
        if (errorMessage) throw Exception(String(errorMessage))
        let destination = File(String(manifestPath))
        manifestBinding = CompilerArtifactLifecycleBinding(revision(), destination.name, destination.normalizedLocation)
        external js {
            const manifestCreationState = #{state};
            try { #{temporaryPath} = manifestCreationState.fs.mkdtempSync(manifestCreationState.manifest+'.tmp-'); }
            catch (error) {
                delete manifestCreationState.manifestContents;
                #{errorMessage} = error.message;
            }
        }
        if (errorMessage) throw Exception(String(errorMessage))
        let temporary = File(String(temporaryPath))
        let staged = File(temporary, "manifest")
        manifestTemporary = CompilerArtifactLifecycleStorage(temporary, manifestBinding, manifestObserver, staged)
        manifestTemporary.observeCreated()
        var Exception failure
        try {
            external js {
                const manifestWriteState = #{state};
                try {
                    const fd = manifestWriteState.fs.openSync(#{staged.normalizedLocation.chars.data},'wx');
                    try { manifestWriteState.fs.writeFileSync(fd,manifestWriteState.manifestContents); manifestWriteState.fs.fsyncSync(fd); }
                    finally { manifestWriteState.fs.closeSync(fd); }
                } catch (error) { #{errorMessage} = error.message; }
                finally { delete manifestWriteState.manifestContents; }
            }
            // Observe even a partially written payload before any removal attempt.
            manifestTemporary.observeCreated()
            if (errorMessage) throw Exception(String(errorMessage))
            external js {
                const manifestPublicationState = #{state};
                try {
                    manifestPublicationState.fs.renameSync(#{staged.normalizedLocation.chars.data},manifestPublicationState.manifest);
                    manifestPublicationState.published = true;
                    manifestPublicationState.evidence.manifestPublished = true;
                    manifestPublicationState.evidence.diagnostics = {complete:true, records:[]};
                } catch (error) { #{errorMessage} = error.message; }
            }
            if (errorMessage) throw Exception(String(errorMessage))
            manifestTemporary.observeRemoved()
            manifestTemporary.publicationObserved()
        } catch (Exception error) { failure = error }
        try { cleanupManifestTemporary() }
        catch (Exception cleanup) {
            if (!failure) failure = cleanup
        }
        if (failure) throw failure
    }

    /** Cleanup remains owned, with its failure receipt, until verified removal. */
    private cleanupManifestTemporary() {
        if (manifestTemporary) {
            manifestTemporary.remove()
            manifestTemporary = null
        }
    }

    // Emit the already admitted immutable bounded metadata, one source at a time.
    // Set the one-shot latch before callbacks: interrupted streams cannot be retried
    // into an apparently complete admission or used to start compiler work.
    public emitAdmission(CompilerInvocationAdmissionStream stream) {
        if (!stream || admissionEmissionStarted) throw Exception("Invocation admission requires a fresh stream")
        admissionEmissionStarted = true
        validate()
        let admittedRevision = revision()
        var Int count
        native_array native var Char[] destination
        native_array native var Char[] tool
        native_array native var Char[] options
        native_array native var Char[] configuration
        native_array native var Char[] inventory
        external js {
            const s = #{state};
            #{count} = s.entries.length;
            #{destination} = s.destinationPath;
            #{tool} = 'sha256:' + s.toolDigest;
            #{options} = 'sha256:' + s.optionsFingerprint;
            #{configuration} = 'sha256:' + s.configuration;
            #{inventory} = 'sha256:' + s.sourceInventoryFingerprint;
        }
        var Int index
        while (index < count) {
            native_array native var Char[] identity
            native_array native var Char[] content
            external js {
                const entry = #{state}.entries[#{index}];
                #{identity} = entry.identity;
                #{content} = 'sha256:' + entry.digest;
            }
            stream.source(admittedRevision, index + 1, String(identity), String(content))
            index++
        }
        // Delivery callbacks can be user code; never seal bytes changed during it.
        validate()
        stream.seal(admittedRevision, String(destination), String(tool), String(options),
            String(configuration), String(inventory), count)
    }

    public revision() -> String {
        native_array native var Char[] value
        external js { #{value} = 'sha256:' + #{state}.key; }
        return String(value)
    }

    /** A warm diagnostic batch exists only after revalidation of successful cached output. */
    public cachedDiagnostics() -> String {
        validate()
        if (!reused) throw Exception("Cached diagnostic batch requires a validated hit")
        native_array native var Char[] value
        external js {
            #{value} = globalThis.JSON.stringify({schema:'flat.compiler.diagnostics.v1',
                revision:'sha256:'+#{state}.key, complete:true, records:[]}) + '\n';
        }
        return String(value)
    }

    public evidence() -> String {
        // Never report a complete successful batch after the admitted bytes changed.
        validate()
        native_array native var Char[] json
        external js { #{json} = globalThis.JSON.stringify(#{state}.evidence) + '\n'; }
        return String(json)
    }

    public dispose() {
        // Do not release the destination lock while an observed temporary is owned.
        // A failed finalization is retryable and keeps the same binding/path.
        cleanupManifestTemporary()
        native_array native var Char[] errorMessage
        external js {
            const s = #{state};
            const Error = globalThis.Error;
            if (s && s.owned) {
                try {
                    const currentLock = s.fs.lstatSync(s.lock);
                    if (!currentLock.isDirectory() || currentLock.dev !== s.lockIdentity.dev ||
                        currentLock.ino !== s.lockIdentity.ino) throw new Error('Incremental lock ownership changed');
                    const owner = s.lock+'/owner.json';
                    if (!s.ownerRemoved) {
                        const currentOwner = s.fs.lstatSync(owner);
                        if (!currentOwner.isFile() || currentOwner.dev !== s.ownerIdentity.dev ||
                            currentOwner.ino !== s.ownerIdentity.ino) throw new Error('Incremental owner identity changed');
                        s.fs.unlinkSync(owner);
                        // A successful syscall wrapper is not proof of removal.
                        try {
                            s.fs.lstatSync(owner);
                            throw new Error('Incremental owner remains after unlink');
                        } catch (error) { if (error.code !== 'ENOENT') throw error; }
                        // Persist this transition before rmdir: a failed rmdir must
                        // not make retry unlink a missing (or replacement) owner.
                        s.ownerRemoved = true;
                    } else {
                        try {
                            s.fs.lstatSync(owner);
                            throw new Error('Incremental owner reappeared during lock release');
                        } catch (error) { if (error.code !== 'ENOENT') throw error; }
                    }
                    s.fs.rmdirSync(s.lock);
                    try {
                        s.fs.lstatSync(s.lock);
                        throw new Error('Incremental lock remains after rmdir');
                    } catch (error) { if (error.code !== 'ENOENT') throw error; }
                    s.owned = false;
                }
                catch (error) { #{errorMessage}=error.message; }
            }
        }
        if (errorMessage) throw Exception(String(errorMessage))
    }
}
