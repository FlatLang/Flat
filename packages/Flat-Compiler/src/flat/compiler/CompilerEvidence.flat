package flat/compiler

import flat/compiler/models/SourceRange

/**
 * Machine-readable terminal evidence for an in-process lifecycle harness. This is
 * a producer, not an acceptance verdict. The caller owns workload selection, tool
 * digest verification, source revision, artifact hashes and atomic receipt storage.
 * Never infer persistent incremental behavior from these exact in-process counts.
 */
class CompilerEvidence {
    /** Session and diagnostics are separate native frames, not buffered presentation. */
    public static emitSession(CompilationSummary summary, String scenario = null) {
        let record = render(summary, scenario)
        external js { console.log(#{record.chars.data}); }
    }

    /** A failed in-process product test has no persistent revision admission.
     * Retain actual typed ranges if available; never derive ranges from message text.
     */
    public static emitProductFailure(CompilationSummary summary, String scenario) {
        if (summary.succeeded && summary.artifactCount == 1) return
        emitSession(summary, scenario)
        emitDiagnostics(summary, "unavailable-in-process-source-set")
    }

    /** Emit one native JSON frame without flushing unrelated presentation bytes. */
    public static emitDiagnostics(CompilationSummary summary, String revision,
        String terminalFailure = null) {
        let batch = renderDiagnostics(summary, revision, terminalFailure)
        emitDiagnosticFrame(batch)
    }

    /** Emit a previously rendered frame, including validated persistent cache evidence. */
    public static emitDiagnosticFrame(String batch) {
        external js { console.log(#{batch.chars.data}); }
    }

    public static renderPersistent(CompilerIncrementalState state) -> String {
        if (!state) throw Exception("Persistent compiler evidence requires admitted state")
        return state.evidence()
    }

    /**
     * One terminal invocation batch. A finalization failure is not a source
     * diagnostic: retain any ranged compiler records, mark the batch incomplete,
     * and report the failure separately instead of inventing a source/range.
     */
    public static renderDiagnostics(CompilationSummary summary, String revision,
        String terminalFailure = null) -> String {
        if (!summary || !revision) throw Exception("Diagnostic batch requires terminal summary and input revision")
        let failure = terminalFailure ?: summary.packageDiagnostic
        let encodedFailure = failure != null ? quote(failure) : "null"
        return "{\"schema\":\"flat.compiler.diagnostics.v1\",\"revision\":#{quote(revision)}," +
            "\"complete\":#{terminalFailure == null && diagnosticsComplete(summary)},\"records\":#{diagnosticRecords(summary)}," +
            "\"diagnosticCount\":#{summary.diagnosticCount},\"cancelled\":#{summary.cancelled}," +
            "\"cleanupSettled\":#{summary.cleanupSettled},\"terminalFailure\":#{encodedFailure}}\n"
    }

    static diagnosticsComplete(CompilationSummary summary) -> Bool {
        if (!summary.cleanupSettled || summary.cancelled) return false
        if (summary.diagnosticCount == 0) return !summary.packageDiagnostic && !summary.bindingDiagnostic && !summary.parserDiagnostic
        if (summary.diagnosticCount != 1) return false
        if (summary.bindingDiagnostic && !summary.parserDiagnostic) return summary.bindingDiagnostic.range != null
        return summary.parserDiagnostic != null && summary.parserDiagnostic.range != null && !summary.bindingDiagnostic
    }

    static diagnosticRecords(CompilationSummary summary) -> String {
        // The summary retains at most one record per typed diagnostic channel.
        // Preserve those observations even when the complete stream is unavailable.
        var String records = ""
        if (summary.parserDiagnostic && summary.parserDiagnostic.range) {
            let diagnostic = summary.parserDiagnostic
            records = diagnosticRecord(diagnostic.code, diagnostic.message, diagnostic.range)
        }
        if (summary.bindingDiagnostic && summary.bindingDiagnostic.range) {
            let diagnostic = summary.bindingDiagnostic
            if (records.count > 0) records += ","
            records += diagnosticRecord(diagnostic.code, diagnostic.name, diagnostic.range)
        }
        return "[#{records}]"
    }

    static diagnosticRecord(String code, String message, SourceRange range) -> String {
        return "{\"code\":#{quote(code)},\"message\":#{quote(message)}," +
            "\"source\":#{quote(range.snapshot.source.value)},\"range\":{" +
            "\"startLine\":#{range.start.lineNumber},\"startColumn\":#{range.start.column}," +
            "\"endLine\":#{range.end.lineNumber},\"endColumn\":#{range.end.column}," +
            "\"startTokenIndex\":#{range.startTokenIndex},\"endTokenIndex\":#{range.endTokenIndex}}}"
    }

    public static render(CompilationSummary summary, String scenario = null) -> String {
        if (!summary) throw Exception("Compiler evidence requires a terminal summary")
        let reuse = summary.reuse
        let complete = diagnosticsComplete(summary)
        let records = diagnosticRecords(summary)
        let label = scenario != null ? quote(scenario) : "null"
        return "{\"schema\":\"flat.compiler.session.v1\",\"scenario\":#label," +
            "\"diagnostics\":{\"complete\":#complete,\"records\":#records}," +
            "\"sourceCount\":#{summary.sourceCount},\"artifactCount\":#{summary.artifactCount}," +
            "\"diagnosticCount\":#{summary.diagnosticCount},\"cancelled\":#{summary.cancelled}," +
            "\"cleanupSettled\":#{summary.cleanupSettled}," +
            "\"peakActiveSources\":#{summary.peakActiveSources}," +
            "\"peakRetainedSources\":#{summary.peakRetainedSources}," +
            "\"peakActiveSourceReads\":#{summary.peakActiveSourceReads}," +
            "\"peakRetainedSourceReads\":#{summary.peakRetainedSourceReads}," +
            "\"reuse\":{\"scope\":\"exact-in-process-package\",\"reused\":#{reuse.reused}," +
            "\"reason\":#{quote(reuse.reason)},\"unchangedSources\":#{reuse.unchangedSources}," +
            "\"changedSources\":#{reuse.changedSources},\"addedSources\":#{reuse.addedSources}," +
            "\"removedSources\":#{reuse.removedSources},\"toolFingerprint\":#{quote(reuse.toolFingerprint)}}}\n"
    }

    public static quote(String value) -> String {
        if (value.count > 4096) throw Exception("Compiler evidence string exceeds receipt capacity")
        var String encoded = "\""
        let hex = "0123456789abcdef"
        for (index in 0..value.count) {
            let character = value[index]
            if (character == '"') encoded += "\\\""
            else if (character == '\\') encoded += "\\\\"
            else if (character < ' ') {
                Int code = character
                encoded += "\\u00"
                encoded += hex[code / 16]
                encoded += hex[code % 16]
            } else encoded += character
        }
        return encoded + "\""
    }
}
