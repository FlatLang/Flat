package flat/compiler

/** Non-presentational compiler API. CLI behavior is isolated in CompilerCli. */
class {
    public construct(visible CompilerEngine engine = CompilerEngine()) {
        if (!engine) throw Exception("Compiler requires engine")
    }

    public async compile(
        CompilerSourceProvider sources,
        CompilerArtifactSink artifacts
    ) -> CompilerSession {
        return engine.compile(sources, artifacts)
    }
}
