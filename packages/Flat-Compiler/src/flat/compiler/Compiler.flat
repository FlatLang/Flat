package flat/compiler

import flat/semantic/binding/primitive/PrimitiveDefaultImport

/** Non-presentational compiler API. CLI behavior is isolated in CompilerCli. */
class {
    public construct(visible CompilerEngine engine = CompilerEngine()) {
        if (!engine) throw Exception("Compiler requires engine")
    }

    public async compile(
        CompilerSourceProvider sources,
        CompilerArtifactSink artifacts
    ) -> CompilerSession {
        return engine.compile(sources, artifacts)
    }

    public startPackage(CompilerSourceProvider sources, CompilerArtifactSink artifacts,
        String artifactIdentity, CompilerSession session, String mainClass = null,
        PrimitiveDefaultImport[] defaultImports = PrimitiveDefaultImport[]) -> CompilerSession {
        return engine.startPackage(sources, artifacts, artifactIdentity, session, mainClass, defaultImports)
    }

    public async compilePackageSnapshots(CompilerSource[] sources, CompilerArtifactSink artifacts,
        String artifactIdentity, String mainClass = null,
        PrimitiveDefaultImport[] defaultImports = PrimitiveDefaultImport[],
        String toolFingerprint = "unspecified") -> CompilerSession {
        return engine.compilePackageSnapshots(sources, artifacts, artifactIdentity, mainClass,
            defaultImports, toolFingerprint)
    }

    /** Compile one bounded package into a relative library or selected-main executable artifact. */
    public async compilePackage(
        CompilerSourceProvider sources,
        CompilerArtifactSink artifacts,
        String artifactIdentity,
        String mainClass = null,
        PrimitiveDefaultImport[] defaultImports = PrimitiveDefaultImport[]
    ) -> CompilerSession {
        return engine.compilePackage(sources, artifacts, artifactIdentity, mainClass, defaultImports)
    }
}
