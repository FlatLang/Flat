package flat/compiler

import flat/io
import flat/system
import flat/project
import flat/writer/es6/bound
import flat/semantic/binding/primitive/PrimitiveDefaultImport

/** CLI presentation and filesystem composition; semantic work belongs to Compiler. */
class CompilerCli {
    public static async main(String[] args) {
        // Generated Node entrypoints supply user argv only, unlike the run harness API.
        let invocation = ["flatc"]
        invocation.addAll(args)
        System.exit(run(invocation))
    }

    public static async run(String[] args, CompilerInvocationObserver observer = null,
        CompilerSourceReadSchedule sourceReadSchedule = null,
        CompilerInvocationAdmissionStream admissionStream = null) -> Int {
        var Bool diagnosticBatchEmitted
        var CompilationSummary terminalSummary
        var String diagnosticRevision = "unavailable-before-terminal-session"
        try {
            let tokens = args.skip(1)
            if (tokens.count > 0 && (tokens.first == "help" || tokens.first == "--help")) {
                Console.log("flatc <sources...> [-l dependency] [-x exclusion] -target es6 (-library | -main qualified/Class) (-o file | -d directory)\n" +
                    "Node executable and library compilation.\n" +
                    "Aliases: --target, --target-runtime, --exclude, --threads. Runtime: -target-runtime node (optional; Node is the only ES6 runtime). -threads N bounds overlapping source reads, not semantic workers. -t is ambiguous and unsupported.\n" +
                    "Configured defaults: -default-import owner, -default-static-import owner.\n" +
                    "Sources may be files, directories or globs; .flat, .js.flat and .es6.flat are selected in overlay order.\n" +
                    "Artifact staging: --max-artifact-bytes N (default 67108864, maximum 2147483647).\n" +
                    "Persistent state: <output>.flat-incremental.json verifies source/options/tool/output SHA-256; destination lock conflicts fail visibly.\n" +
                    "Budget charges four bytes per UTF-16 identity/payload code unit; linker still materializes one complete artifact.\n" +
                    "Package bounds: --max-sources N (default 4096), --max-types N (default 4096). Unsupported options fail without publishing output.")
                return 0
            }
            let arguments = String[]
            var Bool quiet
            var Int maxSources = 4096
            var Int maxTypes = 4096
            var Long maxArtifactBytes = 67108864
            var String capacityOption
            for (token in tokens) {
                if (capacityOption) {
                    if (capacityOption == "--max-artifact-bytes") {
                        maxArtifactBytes = parseArtifactByteCapacity(token)
                    } else {
                        let capacity = AirshipCompilerArguments.parsePositiveCapacity(token)
                        if (capacity <= 0) throw Exception("Package capacities must be positive")
                        if (capacityOption == "--max-sources") maxSources = capacity
                        else maxTypes = capacity
                    }
                    capacityOption = null
                } else if (token == "--max-sources" || token == "--max-types" ||
                    token == "--max-artifact-bytes") capacityOption = token
                else if (token == "--quiet" || token == "-q") quiet = true
                else if (token == "--no-log-progress") {}
                else if (token == "--target") arguments.add("-target")
                else if (token == "--target-runtime") arguments.add("-target-runtime")
                else if (token == "--exclude") arguments.add("-x")
                else if (token == "--threads") arguments.add("-threads")
                else if (token == "-t") throw Exception("Ambiguous -t is unsupported; use -target or -threads")
                else arguments.add(token)
            }
            if (capacityOption) throw Exception("Compiler argument requires a capacity value")
            let project = AirshipCompilerArguments().fromArguments(arguments)
            let options = project.options
            if (options.target.toLowerCase() != "es6") {
                throw Exception("Compilation supports only -target es6")
            }
            if (options.runtime && options.runtime.toLowerCase() != "node") {
                throw Exception("ES6 compilation supports only -target-runtime node")
            }
            let compilerConcurrency = options.maxConcurrency
            if (options.applicationProperties.count > 0) throw Exception("Application properties are unsupported for ES6 compilation")
            let package = project.packages.first
            let linker = FlatEs6PackageLinker(maxSources: maxSources, maxTypes: maxTypes, maxFragments: maxTypes)
            if (package.defaultImports.count > linker.maxTokensPerSource) {
                throw Exception("Flat ES6 package exceeds configured import capacity")
            }
            let defaultImports = PrimitiveDefaultImport[]
            for (value in package.defaultImports) {
                defaultImports.add(PrimitiveDefaultImport(value.location, value.staticImport))
            }
            let output = Es6ArtifactOutput.from(options)
            let files = CompilerSourceDiscovery(maxSources).discover(package)
            if (files.count == 0) throw Exception("Compilation requires at least one source")
            let location = output.destination.normalizedLocation
            let slash = location.lastIndexOf("/")
            let parent = slash >= 0 ? location.substring(0, slash) : "."
            let root = File(parent.count > 0 ? parent : "/")
            let incremental = CompilerIncrementalState(FilesystemCompilerSourceProvider(files,
                maxSourceBytes: linker.maxSourceCharacters * 4), files,
                tokens, output.destination, maxArtifactBytes, linker.maxSourceCharacters,
                manifestObserver: observer ? observer.manifestLifecycleObserver() : null)
            var String terminalBatch
            var String publicationMessage
            var String persistentEvidence
            var Bool outputPublished
            var Exception transactionFailure
            try {
                diagnosticRevision = incremental.revision()
                let stream = admissionStream ?: CompilerInvocationAdmissionStream()
                incremental.emitAdmission(stream)
                if (observer) observer.invocationAdmitted(diagnosticRevision,
                    output.destination.normalizedLocation, CompilerEvidence.renderPersistent(incremental))
                if (incremental.reused) {
                    validateClosure(package, files, maxSources)
                    incremental.validate()
                    terminalBatch = incremental.cachedDiagnostics()
                    persistentEvidence = CompilerEvidence.renderPersistent(incremental)
                    publicationMessage = "Unchanged #{output.destination.normalizedLocation}"
                } else {
                    let lifecycle = observer ? observer.artifactLifecycleObserver() : null
                    let destination = FilesystemCompilerArtifactSink(root, 1,
                        revision: diagnosticRevision, observer: lifecycle)
                    let spool = SpooledCompilerArtifactSink(root, 1, maxArtifactBytes,
                        revision: diagnosticRevision, destination: root, observer: lifecycle)
                    var Exception failure
                    var CompilationSummary summary
                    try {
                        let compiler = Compiler(CompilerEngine(packageLinker: linker, maxActiveSources: compilerConcurrency,
                            sourceReadSchedule: sourceReadSchedule, sourceReadObserver: observer, invocationObserver: observer))
                        let session = compiler.compilePackage(incremental, spool, output.destination.name,
                            options.mainClass, defaultImports: defaultImports)
                        summary = session.completion.get()
                        terminalSummary = summary
                        CompilerEvidence.emitSession(summary, "cli-package")
                        if (!summary.succeeded || summary.artifactCount != 1) {
                            throw Exception(summary.packageDiagnostic ?: "Package compilation failed; output unchanged")
                        }
                        validateClosure(package, files, maxSources)
                        incremental.preparePublication(spool.stagedFile(), summary)
                    } catch (Exception error) { failure = error }
                    publishArtifacts(spool, destination, failure)
                    outputPublished = true
                    try { incremental.commit(summary) }
                    catch (Exception error) {
                        throw Exception("Output published; incremental finalization failed: #{error.message}")
                    }
                    persistentEvidence = CompilerEvidence.renderPersistent(incremental)
                    terminalBatch = CompilerEvidence.renderDiagnostics(summary, diagnosticRevision)
                    publicationMessage = "Compiled #{options.library ? "library" : "executable"} #{output.destination.normalizedLocation}"
                }
            } catch (Exception error) { transactionFailure = error }
            finally {
                try { incremental.dispose() }
                catch (Exception cleanup) {
                    if (!transactionFailure) transactionFailure = outputPublished
                        ? Exception("Output published; cleanup failed: #{cleanup.message}") : cleanup
                    else Console.log("flatc cleanup: #{cleanup.message}")
                    // One bounded retry retains transaction ownership and the original
                    // failure. A successful retry is cleanup, not successful compilation.
                    try { incremental.dispose() }
                    catch (Exception retry) { Console.log("flatc cleanup retry: #{retry.message}") }
                }
            }
            if (transactionFailure) throw transactionFailure
            // Success is observable only after artifact, manifest and owned lock
            // cleanup settle. A failed finalizer instead reaches the failure batch.
            Console.log(persistentEvidence)
            if (terminalSummary) CompilerEvidence.emitDiagnostics(terminalSummary, diagnosticRevision)
            else CompilerEvidence.emitDiagnosticFrame(terminalBatch)
            diagnosticBatchEmitted = true
            if (!quiet) Console.log(publicationMessage)
            return 0
        } catch (Exception error) {
            if (!diagnosticBatchEmitted) {
                CompilerEvidence.emitDiagnostics(
                    terminalSummary ?: CompilationSummary(0, 0, 1, false), diagnosticRevision,
                    terminalSummary && terminalSummary.packageDiagnostic == error.message ? null : error.message)
            }
            Console.log("flatc: #{error.message}")
            return 1
        }
    }

    static async validateClosure(ProjectPackage package, File[] admitted, Int maxSources) {
        let current = CompilerSourceDiscovery(maxSources).discover(package)
        if (current.count != admitted.count) throw Exception("Source closure changed during compilation")
        var Int index
        while (index < admitted.count) {
            if (current[index].normalizedLocation != admitted[index].normalizedLocation) {
                throw Exception("Source closure changed during compilation")
            }
            index++
        }
    }

    /** Decimal byte budget capped below signed Int overflow on every supported runtime. */
    public static parseArtifactByteCapacity(String text) -> Long {
        if (!text || text.count == 0) throw Exception("Artifact byte capacity requires a positive decimal integer")
        var Long value
        let digits = "0123456789"
        for (index in 0..text.count) {
            let digit = digits.indexOf(text[index])
            if (digit < 0 || value > 214748364) {
                throw Exception("Artifact byte capacity requires a decimal integer from 1 to 2147483647")
            }
            if (value == 214748364 && digit > 7) throw Exception("Artifact byte capacity overflow")
            value = value * 10 + digit
        }
        if (value == 0) throw Exception("Artifact byte capacity must be positive")
        return value
    }

    /**
     * CLI-owned finalization boundary, invoked once after compilePackage has settled
     * and drained. Requires an exclusively owned capacity-one spool and a fresh,
     * empty destination; never pass shared or prepopulated sinks. Public for the
     * in-process CLI lifecycle harness, not an Engine sink ownership contract.
     * Session artifact acceptance means staging, not destination publication.
     */
    public static publishArtifacts(SpooledCompilerArtifactSink spool,
        FilesystemCompilerArtifactSink destination, Exception primaryFailure = null) {
        var Exception failure = primaryFailure
        var Exception cleanupFailure
        var Bool published
        try {
            if (!failure) {
                try {
                    spool.commitTo(destination)
                    published = destination.artifacts().isNotEmpty
                    if (!published) throw Exception("Package publication requires one staged artifact")
                } catch (Exception error) {
                    failure = error
                    // Bounded artifact-reference array copy, not payload copying or metadata-only storage.
                    published = destination.artifacts().isNotEmpty
                }
            }
        } finally {
            try { spool.dispose() }
            catch (Exception error) {
                cleanupFailure = error
                try { spool.dispose() }
                catch (Exception retry) { Console.log("flatc cleanup retry: #{retry.message}") }
            }
            try { destination.retryCleanup() }
            catch (Exception error) {
                if (!cleanupFailure) cleanupFailure = error
                else Console.log("flatc cleanup: #{error.message}")
                try { destination.retryCleanup() }
                catch (Exception retry) { Console.log("flatc cleanup retry: #{retry.message}") }
            }
        }
        if (failure) {
            if (cleanupFailure) Console.log("flatc cleanup: #{cleanupFailure.message}")
            if (published) throw Exception("Output published; cleanup failed: #{failure.message}")
            throw failure
        }
        if (cleanupFailure) {
            throw Exception("Output published; cleanup failed: #{cleanupFailure.message}")
        }
    }

    public static async matchesExclusion(String exclusion, File file) -> Bool {
        return CompilerSourceDiscovery.matchesExclusion(exclusion, file)
    }
}
