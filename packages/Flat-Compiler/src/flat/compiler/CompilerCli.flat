package flat/compiler

import flat/io
import flat/system
import flat/project
import flat/glob/Glob
import flat/regex
import flat/writer/es6/bound

/** CLI presentation and filesystem composition; semantic work belongs to Compiler. */
class CompilerCli {
    public static async main(String[] args) {
        System.exit(run(args))
    }

    public static async run(String[] args) -> Int {
        try {
            let tokens = args.skip(1)
            if (tokens.count > 0 && (tokens.first == "help" || tokens.first == "--help")) {
                Console.log("flatc <sources...> [-l dependency] [-x exclusion] -target es6 -library (-o file | -d directory)\n" +
                    "Library compilation only; -main executable output is not supported.\n" +
                    "Aliases: --target, --exclude, --threads. -t is ambiguous and unsupported.\n" +
                    "Sources may be files or directories; directory enumeration includes .flat and .js.flat.\n" +
                    "Package capacity: 64 sources. Unsupported options fail without publishing output.")
                return 0
            }
            let arguments = String[]
            var Bool quiet
            for (token in tokens) {
                if (token == "--quiet" || token == "-q") quiet = true
                else if (token == "--no-log-progress") {}
                else if (token == "--target") arguments.add("-target")
                else if (token == "--exclude") arguments.add("-x")
                else if (token == "--threads") arguments.add("-threads")
                else if (token == "-t") throw Exception("Ambiguous -t is unsupported; use -target or -threads")
                else arguments.add(token)
            }
            let project = AirshipCompilerArguments().fromArguments(arguments)
            let options = project.options
            if (!options.library || options.mainClass) {
                throw Exception("Executable compilation (-main) is unsupported; use -library")
            }
            if (options.target.toLowerCase() != "es6") {
                throw Exception("Library compilation supports only -target es6")
            }
            if (options.runtime) throw Exception("Library target runtime selection is unsupported")
            if (options.maxConcurrency != 1) throw Exception("CLI package concurrency selection is unsupported")
            if (options.applicationProperties.count > 0) throw Exception("Application properties are unsupported for library compilation")
            let package = project.packages.first
            if (package.defaultImports.count > 0) throw Exception("Default imports are unsupported for library compilation")
            let output = Es6ArtifactOutput.from(options)
            let files = File[]
            for (root in package.sourceRoots) {
                collectFiles(root.location, package.exclusions, files)
            }
            for (dependency in package.dependencies) {
                collectFiles(dependency.sourceLocation, package.exclusions, files)
            }
            if (files.count == 0) throw Exception("Library compilation requires at least one source")
            // One bounded package is the linker readiness scope. Buffer its single
            // artifact until success so failure cannot replace a previous output.
            let sink = MemoryCompilerArtifactSink()
            let session = Compiler().compilePackage(
                FilesystemCompilerSourceProvider(files), sink, output.destination.name
            )
            let summary = session.completion.get()
            if (summary.cancelled || summary.diagnosticCount > 0 || summary.artifactCount != 1) {
                if (summary.packageDiagnostic) Console.log(summary.packageDiagnostic)
                else Console.log("Package compilation failed: #{summary.diagnosticCount} diagnostic(s); output unchanged")
                return 1
            }
            let location = output.destination.normalizedLocation
            let slash = location.lastIndexOf("/")
            let parent = slash >= 0 ? location.substring(0, slash) : "."
            Es6ArtifactFiles.ensureDirectory(File(parent.count > 0 ? parent : "/"))
            Es6ArtifactCommitter().commit(output.destination, sink.artifacts().first.code)
            if (!quiet) Console.log("Compiled library #{output.destination.normalizedLocation}")
            return 0
        } catch (Exception error) {
            Console.log("flatc: #{error.message}")
            return 1
        }
    }

    static async collectFiles(String location, SourceExclusion[] exclusions, File[] files) {
        let root = File(location)
        if (!root.isFile && !root.isDirectory) throw Exception("Source does not exist: #location")
        for (exclusion in exclusions) {
            if (matchesExclusion(exclusion.location, root)) return
        }
        if (root.isFile) {
            addFile(root, exclusions, files)
        } else {
            // Enumeration is scoped to one explicitly supplied root. The selected
            // package is capped before loading source text; no project text barrier.
            for (file in root.getChildFiles(true)) {
                if (file.isFile && file.extensionName == "flat") addFile(file, exclusions, files)
            }
        }
    }

    static async addFile(File file, SourceExclusion[] exclusions, File[] files) {
        for (exclusion in exclusions) {
            if (matchesExclusion(exclusion.location, file)) return
        }
        String canonicalPath = file.getCanonicalPath()
        for (existing in files) {
            String existingPath = existing.getCanonicalPath()
            if (existingPath == canonicalPath) return
        }
        if (files.count >= 64) throw Exception("CLI package exceeds 64 source capacity")
        files.add(file)
    }

    public static async matchesExclusion(String exclusion, File file) -> Bool {
        if (exclusion.contains("*")) {
            return Glob.matchesGlobPattern(
                exclusion.startsWith("#{System.workingDirectory}/")
                    ? exclusion.substring(System.workingDirectory.count + 1)
                    : exclusion,
                File(System.workingDirectory),
                file
            )
        }
        // A named file/directory is an exclusion identity, not merely a regex
        // against its canonical path. Resolve both paths before regex fallback.
        File excluded = File(exclusion)
        String canonicalPath = file.getCanonicalPath()
        String excludedPath = excluded.getCanonicalPath()
        if (canonicalPath == excludedPath) return true
        return canonicalPath.matches(Pattern(exclusion))
    }
}
