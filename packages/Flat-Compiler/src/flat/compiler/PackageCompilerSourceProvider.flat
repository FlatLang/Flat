package flat/compiler

import flat/future

/**
 * Deterministic bounded lookahead for one package's source reads. At most capacity
 * reads (active or completed) are retained; parser/binder work remains serial.
 * Each Future owns one immutable loaded source. Ordering is supplied by the linker.
 * dispose awaits every started read, including after cancellation/failure: cancelling
 * a promise alone is not evidence that an underlying filesystem read has settled.
 * One sequential consumer owns consumption. Invalid or overlapping loads never
 * admit work. Concurrent disposal callers share the same cleanup settlement.
 */
class extends CompilerSourceProvider {
    var PendingRead[] pending = PendingRead[]
    var Int next
    var Int active
    var Int peakActive
    var Int peakRetained
    var Bool disposed
    var Bool consuming
    var Future.CompletableFuture<Bool> disposal
    var Int admittedCount
    var Int settledCount

    public construct(private CompilerSourceProvider source, private CompilerSession session,
        private String[] ordered, visible Int capacity, visible Int maxCharacters,
        private CompilerSourceReadSchedule schedule = null,
        private CompilerSourceReadObserver observer = null,
        private CompilerInvocationObserver invocationObserver = null) {
        if (!source || !session || !ordered || capacity <= 0 || maxCharacters <= 0) {
            throw Exception("Package source reads require source, session and positive bounds")
        }
        if (schedule && schedule.capacity != capacity) throw Exception("Controlled read schedule must match package capacity")
        if (schedule) schedule.claim()
        this.ordered = ordered.copy()
    }

    class PendingRead {
        visible String identity
        visible var Future<CompilerSource> result
        visible var CompilerSourceReadObserver.Failure observerFailure
        visible var Bool failureReported
        public construct(String identity) { this.identity = identity }
    }

    override public identities() -> String[] => ordered.copy()
    override public checkpoint() {
        if (disposed || session.cancelled) throw Exception("Compilation cancelled")
        source.checkpoint()
    }

    override public async load(String identity) -> CompilerSource {
        checkpoint()
        if (consuming) throw Exception("Package source reads require one sequential consumer")
        let expected = pending.isEmpty ? (next < ordered.count ? ordered[next] : null) : pending.first.identity
        if (expected == null || expected != identity) {
            throw Exception("Package source reads require stable sequential consumption")
        }
        consuming = true
        try {
            return consume(identity)
        } finally { consuming = false }
    }

    private async consume(String identity) -> CompilerSource {
        let admitWindow = !schedule || pending.isEmpty
        while (admitWindow && next < ordered.count && pending.count < capacity) {
            checkpoint()
            let work = PendingRead(ordered[next])
            if (observer) {
                try { observer.admitted(work.identity, admittedCount + 1, pending.count + 1,
                    Math.max(peakRetained, pending.count + 1)) }
                catch (Exception error) { throw CompilerSourceReadObserver.Failure(error.message) }
            }
            if (pending.count + 1 > peakRetained) peakRetained = pending.count + 1
            next++
            admittedCount++
            pending.add(work)
            var Future<Bool> gate
            if (schedule) gate = schedule.admit()$
            work.result = Future.from<CompilerSource>(async {
                active++
                if (active > peakActive) peakActive = active
                try {
                    if (observer) {
                        try { observer.started(work.identity, active, peakActive) }
                        catch (Exception error) { throw readObserverFailure(work, error) }
                    }
                    checkpoint()
                    let value = source.load(work.identity)
                    if (value && invocationObserver) {
                        try { invocationObserver.sourceReadCompleted(session, work.identity) }
                        catch (Exception error) { throw readObserverFailure(work, error) }
                    }
                    checkpoint()
                    if (value && value.identity != work.identity) {
                        throw Exception("Loaded source identity does not match '#{work.identity}'")
                    }
                    if (value && value.text.count > maxCharacters) {
                        throw Exception("Flat package source exceeds configured character capacity")
                    }
                    if (!value) return null
                    return CompilerSource(value.identity.concat(""), value.text.concat(""))
                } finally {
                    // Controlled completion releases are explicit test-driver
                    // ownership, not cancellation of native filesystem work.
                    if (gate) gate.get()
                    active--
                    settledCount++
                    try {
                        if (observer) {
                            try { observer.settled(work.identity, settledCount, active) }
                            catch (Exception error) { throw readObserverFailure(work, error) }
                        }
                    } finally { if (schedule) schedule.settle() }
                }
            })$
        }
        if (schedule) {
            schedule.seal()
            schedule.awaitSettlement()
        }
        if (pending.isEmpty || pending.first.identity != identity) {
            throw Exception("Package source reads require stable sequential consumption")
        }
        let work = pending.first
        var CompilerSource value
        try { value = work.result.get() }
        catch (Exception error) {
            if (work.observerFailure) work.failureReported = true
            throw error
        }
        checkpoint()
        pending.remove(0)
        if (observer) {
            try { observer.consumed(identity, pending.count) }
            catch (Exception error) { throw CompilerSourceReadObserver.Failure(error.message) }
        }
        checkpoint()
        return value
    }

    readObserverFailure(PendingRead work, Exception error) -> CompilerSourceReadObserver.Failure {
        if (!work.observerFailure) work.observerFailure = CompilerSourceReadObserver.Failure(error.message)
        return work.observerFailure
    }

    public async dispose() {
        if (disposal) {
            disposal.get()
            return
        }
        disposal = Future.create<Bool>()
        disposed = true
        try {
            if (schedule) schedule.seal()
            // No admission is possible after disposed. The bounded pending window
            // remains owned here until every native read and controlled gate settles.
            var Exception observerFailure
            for (work in pending) {
                try { work.result.get() } catch (Exception error) {}
                if (!observerFailure && work.observerFailure && !work.failureReported) {
                    observerFailure = work.observerFailure
                }
            }
            pending.clear()
            session.recordPackageReadPeaks(peakActive, peakRetained)
            try { if (observer) observer.drained(admittedCount, settledCount, peakActive, peakRetained) }
            catch (Exception error) {
                if (!observerFailure) observerFailure = CompilerSourceReadObserver.Failure(error.message)
            }
            if (observerFailure) throw observerFailure
            disposal.complete(true)
        } catch (Exception error) {
            disposal.error(error)
            throw error
        }
    }
}
