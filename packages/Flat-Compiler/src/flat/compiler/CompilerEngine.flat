package flat/compiler

import flat/parser/flat/ParseFailure
import flat/project/Es6SourceSelection
import flat/eventstream
import flat/future
import flat/compiler/CompilerPackageReuse.CompilerPackageSnapshot
import flat/semantic/binding/primitive/PrimitiveContextBindingException
import flat/semantic/binding/primitive/PrimitiveDefaultImport

/** In-process compiler orchestration with bounded independent-source scheduling. */
class {
    // Only independent source compilation uses these capacities. Active means
    // submitted executor reservations (running or executor-queued); the executor
    // may provide less overlap. maxQueued bounds additional unsubmitted identities.
    // Completed outcomes still occupy the combined window until stable retirement.
    public construct(
        visible Executor executor = InlineExecutor(),
        visible FlatEs6SourceCompiler sourceCompiler = FlatEs6SourceCompiler(),
        visible FlatEs6PackageLinker packageLinker = FlatEs6PackageLinker(),
        private CompilerPackageReuse packageReuse = null,
        visible Int maxActiveSources = 1,
        visible Int maxQueuedSources = 0,
        private CompilerSourceReadSchedule sourceReadSchedule = null,
        private CompilerSourceReadObserver sourceReadObserver = null,
        private CompilerInvocationObserver invocationObserver = null
    ) {
        if (maxActiveSources <= 0 || maxQueuedSources < 0 ||
            maxActiveSources > 2147483647 - maxQueuedSources) {
            throw Exception("Compiler source capacities require positive active and nonnegative bounded queue")
        }
        if (!executor || !sourceCompiler || !packageLinker) {
            throw Exception("Compiler engine requires executor, source compiler and package linker")
        }
    }

    /**
     * Consumers must be attached to session before this call. InlineExecutor may
     * enter work immediately; a controlled executor may leave it queued. Sources
     * overlap only within maxActiveSources; no CPU-thread parallelism is promised.
     * Live artifacts/progress are explicitly unordered; identities and bytes are
     * schedule-independent, diagnostics use stable source order. The coordinator
     * never consumes a worker executor slot. Package entrypoints remain serial.
     */
    public start(
        CompilerSourceProvider sources,
        CompilerArtifactSink sink,
        CompilerSession session
    ) -> CompilerSession {
        if (!sources || !sink || !session) throw Exception("Compiler start requires provider, sink and session")
        if (session.cancelled) return session
        let identities = sources.identities()
        if (!identities || identities.any({ !_ })) throw Exception("Compiler start requires source identities")
        let ordered = identities.sort({ _a.compareTo(_b) })
        var Int index
        while (index < ordered.count) {
            if (!ordered[index] || ordered[index].trim().count == 0 ||
                (index > 0 && ordered[index - 1] == ordered[index])) {
                throw Exception("Compiler source identities must be nonempty and unique")
            }
            index++
        }
        session.begin(ordered.count)
        session.startSources(this, executor, sourceCompiler, sources, ordered, sink,
            maxActiveSources, maxQueuedSources)
        return session
    }

    /**
     * Same lifecycle as start. Source reads overlap up to maxActiveSources;
     * parsing/binding/emission remain serial within the finite signature boundary.
     * Cancellation checkpoints stop later reads and emission. Already admitted reads
     * settle before completion; the semantic binder itself is not preemptible.
     */
    public startPackage(
        CompilerSourceProvider sources,
        CompilerArtifactSink sink,
        String artifactIdentity,
        CompilerSession session,
        String mainClass = null,
        PrimitiveDefaultImport[] defaultImports = PrimitiveDefaultImport[]
    ) -> CompilerSession {
        return startSelectedPackage(sources, sink, artifactIdentity, session, mainClass,
            defaultImports: defaultImports)
    }

    startSelectedPackage(
        CompilerSourceProvider sources,
        CompilerArtifactSink sink,
        String artifactIdentity,
        CompilerSession session,
        String mainClass,
        CompilerPackageSnapshot snapshot = null,
        PrimitiveDefaultImport[] defaultImports = PrimitiveDefaultImport[]
    ) -> CompilerSession {
        if (!sources || !sink || !session) throw Exception("Package start requires provider, sink and session")
        if (session.cancelled) return session
        if (!defaultImports || defaultImports.count > packageLinker.maxTokensPerSource ||
            defaultImports.any({ !_ })) {
            throw Exception("Package default imports require a bounded non-null configuration")
        }
        // Configuration ownership is established before executor admission. The
        // range-free value constructor owns copied string storage; no source range
        // is synthesized here. Copies are bounded by the linker import capacity.
        let selectedDefaults = PrimitiveDefaultImport[]
        for (value in defaultImports) {
            selectedDefaults.add(PrimitiveDefaultImport(value.location, value.staticImport))
        }
        validatePackageArtifactIdentity(artifactIdentity)
        // Executor admission must not retain caller-owned mutable String storage.
        let selectedArtifactIdentity = copySubmissionString(artifactIdentity)
        let selectedMainClass = mainClass != null ? copySubmissionString(mainClass) : null
        let identities = sources.identities()
        if (!identities || identities.count == 0 || identities.count > packageLinker.maxSources ||
            identities.any((identity) => !identity || identity.trim().count == 0)) {
            throw Exception("Package compilation requires nonempty bounded source identities")
        }
        let ordered = identities.sort((first, second) => Es6SourceSelection.compare(first, second))
        var Int index = 1
        while (index < ordered.count) {
            if (ordered[index - 1] == ordered[index]) {
                throw Exception("Package compilation requires unique source identities")
            }
            index++
        }
        session.begin(ordered.count)
        try {
            let submitted = executor.submit({
                session.enterPackageCallback()
                try {
                    runPackage(sources, ordered, sink, selectedArtifactIdentity, selectedMainClass,
                        session, snapshot, selectedDefaults)
                } finally {
                    session.settlePackageCallback()
                }
            })$
            session.attach(submitted)
        } catch (Exception error) {
            session.failPackageSubmission(error)
        }
        return session
    }

    /**
     * Compatibility adapter: consumes ALL single-consumer artifact notifications,
     * including the formerly observable buffered notifications on the returned
     * completed session. That returned channel is closed and drained, not replay.
     * Artifact identities/code remain available from the supplied sink; this
     * adapter retains no second artifact array. Consumers that previously read
     * session.artifacts after compile must use the sink, or migrate to start with
     * a preattached live consumer. Method signature and summary behavior remain.
     */
    public async compile(CompilerSourceProvider sources, CompilerArtifactSink sink) -> CompilerSession {
        let session = CompilerSession()
        // A detached async call alone is a native promise, not Future<T>.
        // Wrap explicitly so the adapter owns and awaits its drain cleanup.
        let Future<Bool> drained = Future.from<Bool>(async { return drainArtifacts(session) })$
        try {
            start(sources, sink, session)
            session.completion.get()
        } finally {
            if (!session.completion.completed) session.cancel()
            drained.get()
        }
        return session
    }

    /** Same closed-and-drained notification compatibility as compile(). */
    public async compilePackage(
        CompilerSourceProvider sources,
        CompilerArtifactSink artifacts,
        String artifactIdentity,
        String mainClass = null,
        PrimitiveDefaultImport[] defaultImports = PrimitiveDefaultImport[]
    ) -> CompilerSession {
        let session = CompilerSession()
        let Future<Bool> drained = Future.from<Bool>(async { return drainArtifacts(session) })$
        try {
            startPackage(sources, artifacts, artifactIdentity, session, mainClass, defaultImports)
            session.completion.get()
        } finally {
            if (!session.completion.completed) session.cancel()
            drained.get()
        }
        return session
    }

    /**
     * Opt-in supplied-snapshot adapter. Never reopens a provider or captures the
     * default streaming path. The complete bounded partition is already supplied
     * by the caller; capture and linking use exactly the same immutable strings.
     * Like compilePackage, returns a fresh closed/drained compatibility session.
     * Configured imports, entrypoint, linker limits and explicit tool identity are
     * exact key inputs. Evidence describes bounded in-process package reuse only.
     */
    public async compilePackageSnapshots(
        CompilerSource[] sources,
        CompilerArtifactSink sink,
        String artifactIdentity,
        String mainClass = null,
        PrimitiveDefaultImport[] defaultImports = PrimitiveDefaultImport[],
        String toolFingerprint = "unspecified"
    ) -> CompilerSession {
        if (!packageReuse) throw Exception("Package snapshot reuse requires explicit engine configuration")
        let snapshot = packageReuse.capture(sources, mainClass, packageLinker, defaultImports, toolFingerprint)
        let session = CompilerSession()
        let Future<Bool> drained = Future.from<Bool>(async { return drainArtifacts(session) })$
        try {
            startSelectedPackage(snapshot, sink, artifactIdentity, session, snapshot.mainClass, snapshot,
                snapshot.defaultImportValues())
            let summary = session.completion.get()
            packageReuse.remember(snapshot, summary)
        } finally {
            if (!session.completion.completed) session.cancel()
            drained.get()
        }
        return session
    }

    async drainArtifacts(CompilerSession session) -> Bool {
        while (true) {
            let received = session.artifacts.receive()
            if (received.completed) return true
            if (!received.received) throw Exception("Compatibility artifact drain failed")
        }
        return true
    }

    async runPackage(
        CompilerSourceProvider sources,
        String[] ordered,
        CompilerArtifactSink sink,
        String artifactIdentity,
        String mainClass,
        CompilerSession session,
        CompilerPackageSnapshot snapshot = null,
        PrimitiveDefaultImport[] defaultImports = PrimitiveDefaultImport[]
    ) {
        if (session.cancelled) return
        session.enter()
        let reads = PackageCompilerSourceProvider(SessionCompilerSourceProvider(sources, session), session, ordered,
            maxActiveSources, packageLinker.maxSourceCharacters, sourceReadSchedule, sourceReadObserver, invocationObserver)
        try {
            let cached = snapshot ? packageReuse.find(snapshot) : null
            if (snapshot) session.recordReuse(packageReuse.evidence(snapshot, cached != null))
            let code = cached != null ? cached : packageLinker.linkSources(reads, ordered,
                mainClass: mainClass, defaultImports: defaultImports)
            if (!session.cancelled) {
                // Capture private cache bytes before exposing mutable code to the sink or stream.
                if (snapshot) snapshot.recordCode(code)
                let artifact = CompilerArtifact(artifactIdentity, code)
                sink.write(artifact)
                session.recordArtifact()
                if (invocationObserver) invocationObserver.artifactAccepted(session, artifactIdentity)
                publishArtifact(session, artifact)
                if (!session.cancelled) publishProgress(session, "Compiled package artifact #artifactIdentity")
            }
        } catch (Exception error) {
            if (!session.cancelled) {
                var String message = error.message
                if (error.class.isOfType(ParseFailure.class)) {
                    let failure = (ParseFailure)error
                    session.recordParserDiagnostic(failure.diagnostic)
                }
                if (error.class.isOfType(PrimitiveContextBindingException.class)) {
                    let diagnostic = ((PrimitiveContextBindingException)error).diagnostic
                    session.recordBindingDiagnostic(diagnostic)
                    message = "#{diagnostic.code}: #{diagnostic.name} at " +
                        "#{diagnostic.range.snapshot.source.value}:#{diagnostic.range.start.lineNumber}:" +
                        "#{diagnostic.range.start.column}"
                    if (diagnostic.candidateValues.count > 0) {
                        message += " [#{diagnostic.candidateValues.join(", ")}]"
                    }
                }
                publishDiagnostic(session, "Failed to compile package '#artifactIdentity': #message")
            }
        } finally { reads.dispose() }
    }

    protected async publishArtifact(CompilerSession session, CompilerArtifact artifact) {
        let pending = session.artifacts.send(artifact)$
        if (session.artifacts.pendingSendCount > 0) {
            session.recordArtifactBackpressure()
        }
        let result = pending.get()
        if (!session.cancelled && !result.accepted) {
            throw Exception("Compiler artifact consumer closed, failed or exceeded capacity")
        }
    }

    protected async publishProgress(CompilerSession session, String message) {
        let result = session.progress.publish(message)
        if (!session.cancelled && (result.failed || result.capacityExceeded)) {
            throw Exception("Compiler progress publication failed")
        }
    }

    protected async publishDiagnostic(CompilerSession session, String message) {
        session.recordFailure(message)
        let result = session.diagnostics.publish(message)
        if (!session.cancelled && (result.failed || result.capacityExceeded)) {
            throw Exception("Compiler diagnostic publication failed")
        }
    }

    copySubmissionString(String value) -> String => value.concat("")

    validatePackageArtifactIdentity(String identity) {
        if (!identity || identity.startsWith("/") || identity.endsWith("/") ||
            identity.contains("\\") || identity.contains(":") || identity.contains("//")) {
            throw Exception("Package artifact requires safe relative path")
        }
        let components = identity.split("/")
        if (components.any((component) => component.count == 0 || component == "." || component == "..")) {
            throw Exception("Package artifact requires safe relative path components")
        }
    }
}
