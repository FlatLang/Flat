package flat/compiler

import flat/semantic/types
import flat/project/Es6SourceSelection
import flat/lexer
import flat/bound
import flat/compiler/models
import flat/parser/flat
import flat/semantic/binding/BindingDiagnostic
import flat/semantic/binding/primitive
import flat/writer/es6/bound

/** Bounded package-scoped reduced class linker preserving source identities. */
class {
    public construct(
        visible Int maxSources = 4096,
        visible Int maxSourceCharacters = 1048576,
        visible Int maxTokensPerSource = 131072,
        visible Int maxTypes = 4096,
        visible Int maxFragments = 4096
    ) {
        if (maxSources <= 0 || maxSourceCharacters <= 0 || maxTokensPerSource <= 0 ||
            maxTypes <= 0 || maxFragments <= 0) {
            throw Exception("Flat ES6 package linker capacities must be positive")
        }
    }

    implicitName(String identity, String partitionName) -> String {
        if (partitionName) return partitionName
        let slash = identity.lastIndexOf("/", defaultReturnValue: -1)
        let dot = identity.indexOf(".", start: slash + 1, defaultReturnValue: identity.count)
        return identity.substring(slash + 1, dot)
    }

    public async link(
        CompilerSource[] sourceValues,
        DeclarationIdentity arrayDeclaration = null,
        PrimitiveDefaultImport[] defaultImports = PrimitiveDefaultImport[]
    ) -> String {
        if (!sourceValues || sourceValues.any({ !_ }) || sourceValues.count > maxSources) {
            throw Exception("Flat ES6 package linking requires bounded sources")
        }
        let ordered = sourceValues.sort((first, second) => Es6SourceSelection.compare(first.identity, second.identity))
        return linkSelected(MemoryCompilerSourceProvider(ordered),
            ordered.map({ _.identity }), arrayDeclaration, ordered, defaultImports: defaultImports)
    }

    /**
     * The finite declaration partition remains the binder's signature boundary.
     * Only one source text/token stream is loaded at a time; later source text
     * is not requested after an earlier parse failure. Published syntax retains
     * stable source identities, not a whole-partition array of source texts.
     */
    public async linkSources(
        CompilerSourceProvider provider,
        String[] identities,
        DeclarationIdentity arrayDeclaration = null,
        String mainClass = null,
        PrimitiveDefaultImport[] defaultImports = PrimitiveDefaultImport[]
    ) -> String {
        if (!provider || !identities || identities.count > maxSources ||
            identities.any((identity) => !identity || identity.trim().count == 0)) {
            throw Exception("Flat ES6 package linking requires bounded source identities")
        }
        let ordered = identities.sort((first, second) => Es6SourceSelection.compare(first, second))
        var Int identityIndex = 1
        while (identityIndex < ordered.count) {
            if (ordered[identityIndex - 1] == ordered[identityIndex]) {
                throw Exception("Flat ES6 package linking requires unique source identities")
            }
            identityIndex++
        }
        return linkSelected(provider, ordered, arrayDeclaration, mainClass: mainClass, defaultImports: defaultImports)
    }

    /** Direct array callers retain their supplied snapshots, even with shared identities. */
    async linkSelected(
        CompilerSourceProvider provider,
        String[] ordered,
        DeclarationIdentity arrayDeclaration,
        CompilerSource[] suppliedSources = null,
        String mainClass = null,
        PrimitiveDefaultImport[] defaultImports = PrimitiveDefaultImport[]
    ) -> String {
        if (!defaultImports) throw Exception("Flat ES6 package requires configured imports")
        if (defaultImports.count > maxTokensPerSource) {
            throw Exception("Flat ES6 package exceeds configured import capacity")
        }
        if (defaultImports.any({ !_ })) throw Exception("Flat ES6 package requires valid configured imports")
        // Snapshot the bounded configuration before the first asynchronous source load.
        // Each value owns its location storage; no source text/range is manufactured.
        let defaults = defaultImports.copy()
        let contexts = PrimitiveSourceBindingContext[]
        var Int typeCount
        var Int sourceIndex
        for (identity in ordered) {
            provider.checkpoint()
            let source = suppliedSources ? suppliedSources[sourceIndex++] : provider.load(identity)
            if (!source) throw Exception("Missing source '#identity'")
            if (source.identity != identity) {
                throw Exception("Loaded source identity does not match '#identity'")
            }
            if (source.text.count > maxSourceCharacters) {
                throw Exception("Flat package source exceeds configured character capacity")
            }
            let stream = Lexer().lexInterpolated(source.text)
            stream.emit("start")
            let tokens = stream.consumeAll<Token>("data")
            if (tokens.count > maxTokensPerSource) {
                throw Exception("Flat package source exceeds configured token capacity")
            }
            let snapshot = SourceSnapshotIdentity(SourceIdentity(source.identity), "compiler-input")
            let overlay = Es6SourceSelection.overlay(source.identity)
            let scanner = FlatSourceMilestoneScanner(snapshot, maxTokensPerSource, maxTokensPerSource)
            let imports = PrimitiveBindingImport[]
            var String namespaceName = ""
            var Int tokenIndex
            while (tokenIndex <= tokens.count) {
                provider.checkpoint()
                let islands = tokenIndex < tokens.count
                    ? scanner.accept(tokens[tokenIndex], tokenIndex) : scanner.end()
                for (island in islands) {
                    if (island.class.isOfType(PackageSyntaxIsland.class)) {
                        namespaceName = ((PackageSyntaxIsland)island).packageName
                    } else if (island.class.isOfType(ImportSyntaxIsland.class)) {
                        let value = (ImportSyntaxIsland)island
                        if (imports.count >= maxTokensPerSource - defaults.count) {
                            throw Exception("Flat ES6 package exceeds configured import capacity")
                        }
                        imports.add(PrimitiveBindingImport(
                            value.importedName, value.range, value.staticImport, value.alias
                        ))
                    } else if (island.class.isOfType(TopLevelTypeHeaderSyntaxIsland.class)) {
                        // Front matter is complete. The reduced partition parser owns bodies;
                        // the milestone member grammar is a different supported subset.
                        scanner.cancel()
                    }
                }
                if (scanner.finished) break
                tokenIndex++
            }
            scanner.end()
            let classes = PrimitiveClassSyntax[]
            let interfaces = PrimitiveInterfaceSyntax[]
            let partitions = FlatSourceTypePartitioner(
                maxTypeTokens: maxTokensPerSource, maxTypes: maxTypes
            ).partition(tokens, snapshot, "js")
            for (partition in partitions) {
                provider.checkpoint()
                if (partition.declarationKind != "class" &&
                    partition.declarationKind != "trait" &&
                    partition.declarationKind != "interface") {
                    throw Exception("Reduced Flat ES6 package linking supports classes and interfaces")
                }
                if (typeCount >= maxTypes) {
                    throw Exception("Flat ES6 package exceeds configured type capacity")
                }
                typeCount++
                if (partition.declarationKind != "class") {
                    try {
                        interfaces.add(PrimitiveInterfaceParser().parseImplicit(
                            partition.tokenValues(), snapshot, partition.startTokenIndex,
                            implicitName(source.identity, partition.name)
                        ))
                    } catch (Exception error) {
                        if (error.class.isOfType(ParseFailure.class)) throw error
                        throw Exception(
                            "Flat package interface '#{source.identity}' failed: #{error.message}"
                        )
                    }
                    continue
                }
                var PrimitiveClassSyntax parsed
                try {
                    parsed = PrimitiveClassParser().parse(
                        partition.tokenValues(), snapshot, partition.startTokenIndex,
                        implicitName(source.identity, partition.name)
                    )
                } catch (Exception error) {
                    if (error.class.isOfType(ParseFailure.class)) throw error
                    throw Exception(
                        "Flat package source '#{source.identity}' failed: #{error.message}"
                    )
                }
                var Bool merged
                if (overlay) {
                    var Int contextIndex
                    while (contextIndex < contexts.count && !merged) {
                        let owner = contexts[contextIndex]
                        if (owner.namespaceName == namespaceName) {
                            let owned = owner.classValues()
                            var Int classIndex
                            while (classIndex < owned.count && !merged) {
                                if (owned[classIndex].name == parsed.name &&
                                    Es6SourceSelection.baseLocation(owned[classIndex].range.snapshot.source.value) ==
                                        Es6SourceSelection.baseLocation(source.identity)) {
                                    owned[classIndex] = owned[classIndex].mergedWith(parsed)
                                    contexts[contextIndex] = PrimitiveSourceBindingContext(
                                        owner.namespaceName, owner.snapshot, owned,
                                        owner.interfaceValues(), owner.importValues(), owner.defaultImportValues()
                                    )
                                    merged = true
                                    typeCount--
                                }
                                classIndex++
                            }
                        }
                        contextIndex++
                    }
                }
                if (!merged) classes.add(parsed)
            }
            contexts.add(PrimitiveSourceBindingContext(namespaceName, snapshot, classes, interfaces, imports, defaults))
        }
        // Preserve the owning binder's source-ranged control diagnostic before
        // partition binding can flatten it into an untyped method exception.
        for (context in contexts) {
            provider.checkpoint()
            for (syntax in context.classValues()) {
                for (method in syntax.methodValues()) {
                    let diagnostic = PrimitiveControlStatementBinder().controlDiagnostic(method.statements())
                    if (diagnostic) {
                        throw PrimitiveContextBindingException(BindingDiagnostic(
                            diagnostic.code, diagnostic.message,
                            SyntaxIslandIdentity(diagnostic.range.snapshot, "control", diagnostic.range.startTokenIndex),
                            diagnostic.range
                        ))
                    }
                }
            }
        }
        provider.checkpoint()
        let types = PrimitiveClassPartitionBinder().bindContexts(
            contexts, maxTypes: maxTypes, arrayDeclaration: arrayDeclaration,
            maxContexts: maxSources, maxImportsPerContext: maxTokensPerSource
        ).typeUnits()
        if (types.count > maxFragments) {
            throw Exception("Flat ES6 package exceeds configured fragment capacity")
        }
        let fragments = Es6ArtifactFragment[]
        var Int index
        while (index < types.count) {
            provider.checkpoint()
            let emitted = Es6UnitOrchestrator().emitType(TypeFeatureLowering.lowerLazyProperties(types[index]), index)
            if (!emitted.emitted) {
                throw Exception("#{emitted.diagnostic.code}: #{emitted.diagnostic.message}")
            }
            fragments.add(emitted.fragment)
            index++
        }
        provider.checkpoint()
        let assembly = Es6FragmentAssembler(maxFragments).assemble(fragments)
        if (!assembly.assembled) {
            throw Exception("#{assembly.diagnostic.code}: #{assembly.diagnostic.message}")
        }
        var String entrypointCode = ""
        if (mainClass) {
            // Resolve a qualified declaration through the same immutable source
            // contexts as binding; emitted names and source filenames are not APIs.
            let declarations = PrimitiveResolvedDeclarationContext(contexts.first, contexts)
            let candidates = declarations.candidates(mainClass)
            if (candidates.count != 1) {
                throw Exception("Executable main class '#mainClass' must resolve to exactly one declaration")
            }
            let owner = types.firstOrNull({ _.identity.value == candidates.first.value })
            if (!owner) throw Exception("Executable main class '#mainClass' has no bound type")
            let methods = owner.functionUnits().filter((method) => method.name == "main" && method.staticFunction)
            if (methods.count != 1) {
                throw Exception("Executable main class '#mainClass' requires exactly one static main method")
            }
            var CallableSignature nativeStringConstructor
            let parameters = methods.first.parameterValues()
            if (parameters.count == 1 && parameters.first.semanticType.kind() == "array") {
                let array = (ArraySemanticType)parameters.first.semanticType
                if (array.elementType.kind() == "user-class") {
                    let element = (UserClassSemanticType)array.elementType
                    // Only the canonical production String declaration is an argv wrapper.
                    let strings = declarations.candidates("flat/String")
                    if (strings.count != 1 || strings.first.value != element.declarationIdentity.value) {
                        throw Exception("Executable String[] arguments require canonical flat/String")
                    }
                    let wrapper = types.firstOrNull({ _.identity.value == element.declarationIdentity.value })
                    if (!wrapper) throw Exception("Executable String[] wrapper has no bound declaration")
                    let constructors = wrapper.functionUnits().filter((method) => method.constructorFunction &&
                        method.parameterValues().count == 1 &&
                        method.parameterValues().first.semanticType.value() == SemanticTypes.stringType().value())
                    if (constructors.count != 1) {
                        throw Exception("Executable String[] requires exactly one native-string constructor")
                    }
                    let selected = constructors.first
                    nativeStringConstructor = CallableSignature(SymbolIdentity(selected.identity, "constructor"),
                        wrapper.identity.name, CallableKind("constructor"), [SemanticTypes.stringType()],
                        element, element, names: selected.parameterValues().map({ _.name }))
                }
            }
            let entrypoint = Es6EntrypointEmitter().emit(owner, methods.first, nativeStringConstructor)
            if (!entrypoint.emitted) {
                throw Exception("#{entrypoint.diagnostic.code}: #{entrypoint.diagnostic.message}")
            }
            entrypointCode = entrypoint.code
        }
        return assembly.code + entrypointCode
    }
}
