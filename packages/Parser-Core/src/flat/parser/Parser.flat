package flat/parser

import flat/compiler/models
import flat/log/Logger
import flat/eventstream

class {
    static Logger log = Logger(Parser.class)

    public operation(
        ParserBase rootParser,
        ParseContext parseContext,
        SourceSnapshotIdentity snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:parser-operation"),
            "unspecified"
        ),
        ParseRecoveryPolicy recoveryPolicy = null,
        Int inputCapacity = 1,
        Int maxPendingInputSends = 1,
        Int outputCapacity = 1,
        Int diagnosticCapacity = 1
    ) -> ParseOperation {
        return ParseOperation(
            rootParser,
            parseContext,
            snapshot,
            recoveryPolicy,
            inputCapacity,
            maxPendingInputSends,
            outputCapacity,
            diagnosticCapacity
        )
    }

    /**
     * Compatibility adapter for legacy EventStream callers.
     *
     * Subscriptions are installed before this method returns. The returned stream
     * backlogs output, so callers may attach listeners without a separate startup
     * ordering requirement. Emitting the legacy "start" event remains harmless.
     */
    public parse(
        ParserBase rootParser,
        ParseContext parseContext,
        EventStream tokenStream
    ) -> EventStream {
        let stream = EventStream(true)
        let engine = ParseEngine(rootParser, parseContext)
        var Bool terminal

        tokenStream.on<Token>("data", (token) => {
            if (stream.closed || terminal) return

            log.trace("Received data from Token EventStream: #{token}")
            engine.consume(token)
            stream.emit("parsed_token", token)

            if (engine.invalid) {
                terminal = true
                engine.release()
                stream.emit("quit")
                stream.emit("close")
            }
        })

        tokenStream.on<String>("error", (error) => {
            if (stream.closed || terminal) return

            terminal = true
            engine.release()

            log.trace("Received error from Token EventStream: #{error}")
            stream.emit("error", error)
            stream.emit("close")
        })

        tokenStream.on("close", {
            if (stream.closed || terminal) return

            terminal = true

            log.trace("Token EventStream closed")
            for (result in engine.end()) stream.emit("data", result)
            stream.emit("close")
        })

        return stream
    }
}
