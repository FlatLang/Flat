package flat/semantic/types

testable class {
    test `numeric unboxing from declared root requires explicit canonical hierarchy evidence`() {
        let fixture = TypeSystem_TestFixture()
        let root = fixture.userType("Universal", 201)
        let namedObject = fixture.userType("Object", 202)
        let hierarchy = TypeHierarchyComponent()
        hierarchy.add(TypeHierarchyDeclaration(root, "class", UserClassSemanticType[]))
        hierarchy.add(TypeHierarchyDeclaration(namedObject, "class", [root]))
        hierarchy.registerRootDeclaration(root)
        hierarchy.seal()
        let conversion = TypeConversions.classify(root, SemanticTypes.doubleType(), explicit: true, hierarchy: hierarchy)
        expect(conversion.conversionKind).toBe("numeric-unboxing")
        expect(conversion.implicit).toBe(false)
        expect(TypeConversions.classify(root, SemanticTypes.doubleType(), hierarchy: hierarchy).applicable).toBe(false)
        expect(TypeConversions.classify(root, SemanticTypes.doubleType(), explicit: true).applicable).toBe(false)
        expect(TypeConversions.classify(namedObject, SemanticTypes.doubleType(), explicit: true, hierarchy: hierarchy).applicable).toBe(false)
        expect(TypeConversions.classify(root, SemanticTypes.boolType(), explicit: true, hierarchy: hierarchy).applicable).toBe(false)
        expect(TypeConversions.classify(root, SemanticTypes.byteType(), explicit: true, hierarchy: hierarchy).conversionKind).toBe("numeric-unboxing")
    }
    test `generic instances project only to proven positive declared ancestors`() {
        let fixture = TypeSystem_TestFixture()
        let root = fixture.userType("Root", 101)
        let base = fixture.userType("Base", 102)
        let child = fixture.userType("Child", 103)
        let other = fixture.userType("Other", 104)
        let baseT = GenericParameterSemanticType(base.declarationIdentity, "T", 0)
        let childT = GenericParameterSemanticType(child.declarationIdentity, "T", 0)
        let hierarchy = TypeHierarchyComponent()
        hierarchy.add(TypeHierarchyDeclaration(root, "class", UserClassSemanticType[]))
        hierarchy.add(TypeHierarchyDeclaration(base, "class", [root], genericParameters: [baseT]))
        hierarchy.add(TypeHierarchyDeclaration(child, "class", [base], genericParameters: [childT],
            genericParents: [GenericInstanceSemanticType(base, [ArraySemanticType(childT)])]))
        hierarchy.add(TypeHierarchyDeclaration(other, "class", UserClassSemanticType[]))
        hierarchy.registerRootDeclaration(root)
        hierarchy.seal()
        let instance = GenericInstanceSemanticType(child, [SemanticTypes.intType()])
        let parent = GenericInstanceSemanticType(base, [ArraySemanticType(SemanticTypes.intType())])
        expect(hierarchy.distance(child, root)).toBe(2)
        expect(hierarchy.genericDistance(instance, parent)).toBe(1)
        let conversion = TypeConversions.classify(instance, root, hierarchy: hierarchy)
        expect(conversion.applicable).toBe(true)
        expect(conversion.implicit).toBe(true)
        expect(conversion.conversionKind).toBe("reference-upcast")
        expect(conversion.cost).toBe(12)
        expect(conversion.fromType.value()).toBe(instance.value())
        expect(conversion.toType.value()).toBe(root.value())
        expect(TypeConversions.classify(instance, base, hierarchy: hierarchy).cost).toBe(11)
        expect(TypeConversions.classify(instance, parent, hierarchy: hierarchy).applicable).toBe(true)
        expect(TypeConversions.classify(instance,
            GenericInstanceSemanticType(base, [ArraySemanticType(SemanticTypes.boolType())]),
            hierarchy: hierarchy).applicable).toBe(false)
        expect(TypeConversions.classify(instance,
            GenericInstanceSemanticType(child, [SemanticTypes.boolType()]), hierarchy: hierarchy).applicable).toBe(false)
        expect(TypeConversions.classify(instance, child, hierarchy: hierarchy).applicable).toBe(false)
        expect(TypeConversions.classify(instance, other, hierarchy: hierarchy).applicable).toBe(false)
        expect(TypeConversions.classify(instance, fixture.userType("Root", 105), hierarchy: hierarchy).applicable).toBe(false)
        expect(TypeConversions.classify(instance, root).applicable).toBe(false)
        expect(TypeConversions.classify(root, instance, hierarchy: hierarchy).applicable).toBe(false)
        expect(TypeConversions.classify(child, instance, hierarchy: hierarchy).applicable).toBe(false)
        expect(TypeConversions.classify(NullableSemanticType(instance), root, hierarchy: hierarchy).applicable).toBe(false)
        expect(TypeConversions.classify(SemanticTypes.intType(), root, hierarchy: hierarchy).applicable).toBe(false)
        let near = CallableSignature(fixture.symbolIdentity("choose", "static-method", 110), "choose",
            CallableKind("static-method"), [base], SemanticTypes.boolType(), root)
        let far = CallableSignature(fixture.symbolIdentity("choose", "static-method", 111), "choose",
            CallableKind("static-method"), [root], SemanticTypes.boolType(), root)
        for (order in 0..2) {
            let candidates = [near, far]
            let result = OverloadResolver.resolve("choose", order == 0 ? candidates : candidates.reverse(),
                null, [instance], fixture.range(), hierarchy: hierarchy)
            expect(result.resolved).toBe(true)
            expect(result.selected.identity.value).toBe(near.identity.value)
        }
    }
    test `null inhabits unconstrained generic parameters without permitting primitive null`() {
        let fixture = TypeSystem_TestFixture()
        let owner = fixture.userType("List", 31)
        let element = GenericParameterSemanticType(owner.declarationIdentity, "E", 0)
        let primitiveElement = GenericParameterSemanticType(owner.declarationIdentity, "N", 1, SemanticTypes.intType())
        expect(TypeConversions.classify(SemanticTypes.nullType(), element).applicable).toBe(true)
        expect(TypeConversions.classify(SemanticTypes.nullType(), primitiveElement).applicable).toBe(false)
        expect(TypeConversions.classify(SemanticTypes.nullType(), SemanticTypes.intType()).applicable).toBe(false)
        expect(TypeConversions.classify(SemanticTypes.nullType(), NullableSemanticType(SemanticTypes.intType())).applicable).toBe(true)
    }

    test `declared and literal types retain exact immutable source typing`() {
        let fixture = TypeSystem_TestFixture()
        let declared = DeclaredType("Int?", NullableSemanticType(SemanticTypes.intType()), fixture.range())
        let integer = LiteralType("integer", "42", SemanticTypes.intType(), fixture.range(1, 2))
        let floating = LiteralType("float", "1.5", SemanticTypes.doubleType(), fixture.range(2, 3))
        let string = LiteralType("string", "\"text\"", SemanticTypes.stringType(), fixture.range(3, 4))
        let character = LiteralType("char", "'x'", SemanticTypes.charType(), fixture.range(4, 5))
        let bool = LiteralType("bool", "true", SemanticTypes.boolType(), fixture.range(5, 6))
        let nullValue = LiteralType("null", "null", SemanticTypes.nullType(), fixture.range(6, 7))

        expect(declared.sourceName).toBe("Int?")
        expect(declared.semanticType.value()).toBe("nullable:primitive:Int")
        expect(integer.semanticType.value()).toBe("primitive:Int")
        expect(floating.semanticType.value()).toBe("primitive:Double")
        expect(string.semanticType.kind()).toBe("string")
        expect(character.semanticType.value()).toBe("primitive:Char")
        expect(bool.semanticType.value()).toBe("primitive:Bool")
        expect(nullValue.semanticType.kind()).toBe("null")
    }

    test `checks declared root cast contract`() {
        let fixture = TypeSystem_TestFixture()
        let root = fixture.userType("Object", 10)
        let contract = fixture.userType("List", 20)
        let hierarchy = TypeHierarchyComponent()
        hierarchy.add(TypeHierarchyDeclaration(root, "class", UserClassSemanticType[]))
        hierarchy.add(TypeHierarchyDeclaration(contract, "interface", UserClassSemanticType[]))
        hierarchy.registerRootDeclaration(root)
        hierarchy.seal()
        expect(TypeConversions.classify(root, contract, hierarchy: hierarchy).applicable).toBe(false)
        expect(TypeConversions.classify(root, contract, explicit: true, hierarchy: hierarchy).conversionKind).toBe("checked-reference-cast")
    }

    test `identity numeric and explicit primitive conversions are classified`() {
        let identity = TypeConversions.classify(SemanticTypes.intType(), SemanticTypes.intType())
        let widening = TypeConversions.classify(SemanticTypes.shortType(), SemanticTypes.longType())
        let floating = TypeConversions.classify(SemanticTypes.intType(), SemanticTypes.doubleType())
        let narrowing = TypeConversions.classify(
            SemanticTypes.longType(), SemanticTypes.byteType(), explicit: true
        )
        let implicitNarrowing = TypeConversions.classify(
            SemanticTypes.longType(), SemanticTypes.byteType()
        )
        let boolNumeric = TypeConversions.classify(
            SemanticTypes.boolType(), SemanticTypes.intType(), explicit: true
        )
        let signedUnsigned = TypeConversions.classify(
            SemanticTypes.intType(), SemanticTypes.unsignedLongType()
        )

        expect(identity.conversionKind).toBe("identity")
        expect(identity.cost).toBe(0)
        expect(widening.conversionKind).toBe("numeric-widening")
        expect(widening.implicit).toBe(true)
        expect(floating.applicable).toBe(true)
        expect(narrowing.conversionKind).toBe("numeric-cast")
        expect(narrowing.implicit).toBe(false)
        expect(implicitNarrowing.applicable).toBe(false)
        expect(boolNumeric.applicable).toBe(false)
        expect(signedUnsigned.applicable).toBe(false)
    }

    test `reference null and nullable conversions preserve safety`() {
        let fixture = TypeSystem_TestFixture()
        let userType = fixture.userType("Example")
        let nullableUser = NullableSemanticType(userType)
        let toObject = TypeConversions.classify(userType, SemanticTypes.objectType())
        let nullToUser = TypeConversions.classify(SemanticTypes.nullType(), userType)
        let nullToNullable = TypeConversions.classify(SemanticTypes.nullType(), nullableUser)
        let lift = TypeConversions.classify(userType, nullableUser)
        let unsafeUnwrap = TypeConversions.classify(nullableUser, userType)
        let explicitUnwrap = TypeConversions.classify(nullableUser, userType, explicit: true)
        let objectCast = TypeConversions.classify(
            SemanticTypes.objectType(), userType, explicit: true
        )
        let numericUnboxing = TypeConversions.classify(
            SemanticTypes.objectType(), SemanticTypes.byteType(), explicit: true
        )
        let implicitNumericUnboxing = TypeConversions.classify(
            SemanticTypes.objectType(), SemanticTypes.byteType()
        )
        let boolUnboxing = TypeConversions.classify(
            SemanticTypes.objectType(), SemanticTypes.boolType(), explicit: true
        )

        expect(toObject.conversionKind).toBe("reference-upcast")
        expect(nullToUser.applicable).toBe(false)
        expect(nullToNullable.conversionKind).toBe("null")
        expect(lift.conversionKind).toBe("nullable-lift")
        expect(unsafeUnwrap.applicable).toBe(false)
        expect(explicitUnwrap.conversionKind).toBe("nullable-unwrap")
        expect(objectCast.conversionKind).toBe("reference-cast")
        expect(numericUnboxing.conversionKind).toBe("numeric-unboxing")
        expect(numericUnboxing.implicit).toBe(false)
        expect(implicitNumericUnboxing.applicable).toBe(false)
        expect(boolUnboxing.applicable).toBe(false)
    }

    test `unknown and error conversions distinguish pending and diagnosed state`() {
        let unknown = TypeConversions.classify(SemanticTypes.unknownType(), SemanticTypes.intType())
        let error = TypeConversions.classify(SemanticTypes.errorType(), SemanticTypes.intType())

        expect(unknown.applicable).toBe(false)
        expect(unknown.conversionKind).toBe("unknown")
        expect(unknown.suppressesCascade).toBe(true)
        expect(error.applicable).toBe(true)
        expect(error.conversionKind).toBe("error-recovery")
        expect(error.suppressesCascade).toBe(true)
    }

    test `invalid nullable literal and declared type shapes are rejected`() {
        let fixture = TypeSystem_TestFixture()
        var Int rejected
        try { NullableSemanticType(SemanticTypes.nullType()) } catch (Exception error) { rejected++ }
        try { NullableSemanticType(NullableSemanticType(SemanticTypes.intType())) } catch (Exception error) { rejected++ }
        try { LiteralType("integer", "1", SemanticTypes.stringType(), fixture.range()) } catch (Exception error) { rejected++ }
        try { LiteralType("other", "x", SemanticTypes.intType(), fixture.range()) } catch (Exception error) { rejected++ }
        try { DeclaredType("", SemanticTypes.intType(), fixture.range()) } catch (Exception error) { rejected++ }
        expect(rejected).toBe(5)
    }
}
