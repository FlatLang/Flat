package flat/semantic/types

testable class {
    test `generic root receiver call requires registered hierarchy`() {
        let fixture = TypeSystem_TestFixture()
        let root = fixture.userType("Root", 1)
        let child = fixture.userType("Child", 2)
        let generic = GenericParameterSemanticType(fixture.functionIdentity("run"), "E", 0)
        let rootMethod = CallableSignature(fixture.symbolIdentity("root-match", "instance-method", 10),
            "match", CallableKind("instance-method"), [SemanticTypes.objectType()],
            SemanticTypes.boolType(), root)
        let childMethod = CallableSignature(fixture.symbolIdentity("child-match", "instance-method", 11),
            "match", CallableKind("instance-method"), [SemanticTypes.objectType()],
            SemanticTypes.boolType(), child)
        let hierarchy = TypeHierarchyComponent()
        hierarchy.add(TypeHierarchyDeclaration(root, "class", UserClassSemanticType[]))
        hierarchy.add(TypeHierarchyDeclaration(child, "class", [root]))
        hierarchy.registerRootDeclaration(root)
        hierarchy.seal()
        let selected = OverloadResolver.resolve("match", [rootMethod, childMethod], generic,
            [generic], fixture.range(), hierarchy)
        expect(selected.resolved).toBe(true)
        expect(selected.selected.identity.value).toBe(rootMethod.identity.value)
        let unregistered = OverloadResolver.resolve("match", [rootMethod, childMethod], generic,
            [generic], fixture.range())
        expect(unregistered.resolved).toBe(false)
    }

    test `ranks contextual call checks independent of candidate order`() {
        let fixture = TypeSystem_TestFixture()
        let exact = CallableSignature(fixture.symbolIdentity("exact", "function"), "pick",
            CallableKind("function"), [SemanticTypes.intType()], SemanticTypes.intType())
        let wide = CallableSignature(fixture.symbolIdentity("wide", "function"), "pick",
            CallableKind("function"), [SemanticTypes.longType()], SemanticTypes.intType())
        let checks = [CallTypeChecker.check(exact, null, [SemanticTypes.intType()], fixture.range()),
            CallTypeChecker.check(wide, null, [SemanticTypes.intType()], fixture.range())]
        let result = OverloadResolver.resolveChecked("pick", [wide, exact], checks, fixture.range())
        expect(result.resolved).toBe(true)
        expect(result.selected.identity.value).toBe(exact.identity.value)
        let reversed = OverloadResolver.resolveChecked("pick", [exact, wide], checks.reverse(), fixture.range())
        expect(reversed.selected.identity.value).toBe(exact.identity.value)
    }

    test `generic calls reject conflicting arguments without mutating declaration`() {
        let fixture = TypeSystem_TestFixture()
        let identity = fixture.symbolIdentity("choose", "function")
        let parameter = GenericParameterSemanticType(identity.declaration, "Type", 0)
        let target = CallableSignature(
            identity, "choose", CallableKind("function"), [parameter, parameter], parameter,
            genericParameterValues: [parameter]
        )
        let range = fixture.range()
        let invalid = CallTypeChecker.check(
            target, null, [SemanticTypes.intType(), SemanticTypes.stringType()], range
        )
        expect(invalid.valid).toBe(false)
        expect(invalid.diagnostic.code).toBe("type.generic-inference")
        let valid = CallTypeChecker.check(
            target, null, [SemanticTypes.stringType(), SemanticTypes.stringType()], range
        )
        expect(valid.valid).toBe(true)
        expect(valid.semanticType.value()).toBe(SemanticTypes.stringType().value())
        expect(target.returnType.value()).toBe(parameter.value())
    }

    test `infers generic call result and rejects missing evidence`() {
        let fixture = TypeSystem_TestFixture()
        let identity = fixture.symbolIdentity("identity", "function")
        let parameter = GenericParameterSemanticType(identity.declaration, "Out", 0)
        let target = CallableSignature(
            identity, "identity", CallableKind("function"), [parameter], parameter,
            genericParameterValues: [parameter]
        )
        let result = CallTypeChecker.check(target, null, [SemanticTypes.intType()], fixture.range())
        expect(result.valid).toBe(true)
        expect(result.semanticType.value()).toBe(SemanticTypes.intType().value())
        expect(result.target.parameterTypes().first.value()).toBe(SemanticTypes.intType().value())
        expect(target.parameterTypes().first.value()).toBe(parameter.value())
        let unresolved = CallableSignature(
            identity, "identity", CallableKind("function"), SemanticType[], parameter,
            genericParameterValues: [parameter]
        )
        let failure = CallTypeChecker.check(unresolved, null, SemanticType[], fixture.range())
        expect(failure.valid).toBe(false)
        expect(failure.diagnostic.code).toBe("type.generic-unresolved")
    }

    test `callable signatures preserve owned generic declarations`() {
        let fixture = TypeSystem_TestFixture()
        let identity = fixture.symbolIdentity("identity", "function")
        let parameter = GenericParameterSemanticType(identity.declaration, "Out", 0)
        let parameters = [parameter]
        let signature = CallableSignature(
            identity, "identity", CallableKind("function"), [parameter], parameter,
            genericParameterValues: parameters
        )
        parameters.clear()
        let returned = signature.genericParameters()
        returned.clear()
        expect(signature.genericParameters().count).toBe(1)
        expect(signature.genericParameters().first.value()).toBe(parameter.value())
        var Bool rejected
        try {
            CallableSignature(
                fixture.symbolIdentity("other", "function"), "other", CallableKind("function"),
                [parameter], parameter, genericParameterValues: [parameter]
            )
        } catch (Exception error) { rejected = true }
        expect(rejected).toBe(true)
    }

    test `callable signatures preserve immutable parameter names`() {
        let fixture = TypeSystem_TestFixture()
        let signature = CallableSignature(
            fixture.symbolIdentity("sum", "function"), "sum", CallableKind("function"),
            [SemanticTypes.intType(), SemanticTypes.intType()], SemanticTypes.intType(),
            null, 1, ["left", "right"]
        )
        let names = signature.parameterNames()
        names.clear()

        expect(signature.parameterNames()).toBe(["left", "right"])
    }

    test `non-overloaded function calls retain argument conversions and result type`() {
        let fixture = TypeSystem_TestFixture()
        let target = fixture.signature(
            "convert",
            "function",
            [SemanticTypes.longType(), SemanticTypes.stringType()],
            SemanticTypes.boolType()
        )
        let result = CallTypeChecker.check(
            target,
            null,
            [SemanticTypes.intType(), SemanticTypes.stringType()],
            fixture.range()
        )

        expect(result.valid).toBe(true)
        expect(result.target).toBe(target)
        expect(result.semanticType.value()).toBe("primitive:Bool")
        expect(result.argumentConversions().count).toBe(2)
        expect(result.argumentConversions().first.conversionKind).toBe("numeric-widening")
        expect(result.argumentConversions().last.conversionKind).toBe("identity")
    }

    test `instance and static method calls enforce receiver semantics`() {
        let fixture = TypeSystem_TestFixture()
        let owner = fixture.userType("Example")
        let instance = fixture.signature(
            "read", "instance-method", SemanticType[], SemanticTypes.stringType(), owner
        )
        let staticMethod = fixture.signature(
            "create", "static-method", SemanticType[], owner, owner, ordinal: 2
        )
        let validInstance = CallTypeChecker.check(
            instance, owner, SemanticType[], fixture.range()
        )
        let missingReceiver = CallTypeChecker.check(
            instance, null, SemanticType[], fixture.range()
        )
        let staticWithReceiver = CallTypeChecker.check(
            staticMethod, owner, SemanticType[], fixture.range()
        )
        let validStatic = CallTypeChecker.check(
            staticMethod, null, SemanticType[], fixture.range()
        )

        expect(validInstance.valid).toBe(true)
        expect(missingReceiver.diagnostic.code).toBe("type.call-receiver-missing")
        expect(staticWithReceiver.diagnostic.code).toBe("type.call-receiver-unexpected")
        expect(validStatic.valid).toBe(true)
    }

    test `constructors return their owner and validate arguments`() {
        let fixture = TypeSystem_TestFixture()
        let owner = fixture.userType("Example")
        let constructor = fixture.signature(
            "Example", "constructor", [SemanticTypes.longType()], owner, owner
        )
        let valid = CallTypeChecker.check(
            constructor, null, [SemanticTypes.intType()], fixture.range()
        )
        let invalidArgument = CallTypeChecker.check(
            constructor, null, [SemanticTypes.stringType()], fixture.range()
        )
        let invalidArity = CallTypeChecker.check(
            constructor, null, SemanticType[], fixture.range()
        )

        expect(valid.valid).toBe(true)
        expect(valid.semanticType).toBe(owner)
        expect(invalidArgument.diagnostic.code).toBe("type.call-argument")
        expect(invalidArity.diagnostic.code).toBe("type.call-arity")
    }

    test `optional trailing parameters permit bounded omitted arguments`() {
        let fixture = TypeSystem_TestFixture()
        let owner = fixture.userType("Example")
        let base = fixture.signature(
            "Example", "constructor", [SemanticTypes.stringType()], owner, owner
        )
        let target = CallableSignature(
            base.identity, base.name, base.callableKind, base.parameterTypes(),
            base.returnType, base.ownerType, 1
        )
        let omitted = CallTypeChecker.check(target, null, SemanticType[], fixture.range())
        let supplied = CallTypeChecker.check(
            target, null, [SemanticTypes.stringType()], fixture.range()
        )

        expect(omitted.valid).toBe(true)
        expect(omitted.argumentConversions().count).toBe(0)
        expect(supplied.valid).toBe(true)
        var rejected = false
        try {
            CallableSignature(
                base.identity, base.name, base.callableKind, base.parameterTypes(),
                base.returnType, base.ownerType, 2
            )
        } catch (Exception error) { rejected = true }
        expect(rejected).toBe(true)
    }

    test `call signatures defensively copy parameters and reject invalid ownership`() {
        let fixture = TypeSystem_TestFixture()
        let owner = fixture.userType("Example")
        let source = SemanticType[]:add(SemanticTypes.intType())
        let target = fixture.signature(
            "run", "instance-method", source, SemanticTypes.unitType(), owner
        )
        source.add(SemanticTypes.stringType())
        let returned = target.parameterTypes()
        returned.add(SemanticTypes.objectType())
        var Int rejected
        try {
            fixture.signature("bad", "function", SemanticType[], SemanticTypes.unitType(), owner)
        } catch (Exception error) { rejected++ }
        try {
            fixture.signature("bad", "instance-method", SemanticType[], SemanticTypes.unitType())
        } catch (Exception error) { rejected++ }
        try {
            fixture.signature("bad", "constructor", SemanticType[], SemanticTypes.unitType(), owner)
        } catch (Exception error) { rejected++ }

        expect(target.parameterTypes().count).toBe(1)
        expect(rejected).toBe(3)
    }
}
