package flat/semantic/types

testable class {
    test `callable evidence defaults`() {
        let fixture = TypeSystem_TestFixture()
        let signature = fixture.signature("read", "function", SemanticType[], SemanticTypes.intType())
        expect(signature.asyncFunction).toBe(false)
        expect(signature.externalName).toBe(null)
        expect(signature.dispatchIdentity).toBe(null)
    }

    test `receiver evidence substitution`() {
        let fixture = TypeSystem_TestFixture()
        let owner = fixture.userType("Buffer", 31)
        let parameter = GenericParameterSemanticType(owner.declarationIdentity, "E", 0)
        let signature = CallableSignature(fixture.symbolIdentity("read", "instance-method", 32),
            "read", CallableKind("instance-method"), [parameter], parameter, owner,
            ownerGenericDeclaration: GenericDeclaration(owner.declarationIdentity, [parameter], owner),
            asyncFunction: true, externalName: "readExternal", dispatchIdentity: "parent:read:slot")
        let receiver = GenericInstanceSemanticType(owner, [SemanticTypes.intType()])
        let selected = signature.instantiateReceiver(receiver)
        expect(selected.identity.value).toBe(signature.identity.value)
        expect(selected.dispatchIdentity).toBe("parent:read:slot")
        expect(selected.externalName).toBe("readExternal")
        expect(selected.asyncFunction).toBe(true)
        expect(selected.parameterTypes().first.value()).toBe(SemanticTypes.intType().value())
        let checked = CallTypeChecker.check(signature, receiver, [SemanticTypes.intType()], fixture.range())
        expect(checked.valid).toBe(true)
        expect(checked.target.dispatchIdentity).toBe(selected.dispatchIdentity)
        expect(checked.target.externalName).toBe(selected.externalName)
        expect(checked.target.asyncFunction).toBe(true)
        expect(signature.parameterTypes().first.value()).toBe(parameter.value())
    }

    test `generic evidence selection`() {
        let fixture = TypeSystem_TestFixture()
        let identity = fixture.symbolIdentity("convert", "instance-method", 42)
        let owner = fixture.userType("Converter", 41)
        let parameter = GenericParameterSemanticType(identity.declaration, "Value", 0)
        let signature = CallableSignature(identity, "convert", CallableKind("instance-method"),
            [parameter], parameter, owner, genericParameterValues: [parameter],
            asyncFunction: true, externalName: "convertExternal", dispatchIdentity: "base:convert")
        let checked = CallTypeChecker.check(signature, owner, [SemanticTypes.intType()], fixture.range())
        expect(checked.valid).toBe(true)
        expect(checked.target.genericParameters().count).toBe(0)
        expect(checked.target.asyncFunction).toBe(true)
        expect(checked.target.externalName).toBe("convertExternal")
        expect(checked.target.dispatchIdentity).toBe("base:convert")
        expect(checked.target.identity.value).toBe(identity.value)
        let resolved = OverloadResolver.resolve("convert", [signature], owner,
            [SemanticTypes.intType()], fixture.range())
        expect(resolved.resolved).toBe(true)
        expect(resolved.selected.asyncFunction).toBe(true)
        expect(resolved.selected.externalName).toBe("convertExternal")
        expect(resolved.selected.dispatchIdentity).toBe("base:convert")
    }

    test `composed evidence substitution`() {
        let fixture = TypeSystem_TestFixture()
        let owner = fixture.userType("Mapper", 50)
        let identity = fixture.symbolIdentity("map", "instance-method", 51)
        let element = GenericParameterSemanticType(owner.declarationIdentity, "Element", 0)
        let output = GenericParameterSemanticType(identity.declaration, "Output", 0)
        let signature = CallableSignature(identity, "map", CallableKind("instance-method"),
            [element, output], output, owner, genericParameterValues: [output],
            ownerGenericDeclaration: GenericDeclaration(owner.declarationIdentity, [element], owner),
            asyncFunction: true, externalName: "mapExternal", dispatchIdentity: "ancestor:map")
        let receiver = GenericInstanceSemanticType(owner, [SemanticTypes.intType()])
        let checked = CallTypeChecker.check(signature, receiver,
            [SemanticTypes.intType(), SemanticTypes.stringType()], fixture.range())
        expect(checked.valid).toBe(true)
        expect(checked.target.ownerInstance.value()).toBe(receiver.value())
        expect(checked.target.parameterTypes()[0].value()).toBe(SemanticTypes.intType().value())
        expect(checked.target.parameterTypes()[1].value()).toBe(SemanticTypes.stringType().value())
        expect(checked.target.asyncFunction).toBe(true)
        expect(checked.target.externalName).toBe("mapExternal")
        expect(checked.target.dispatchIdentity).toBe("ancestor:map")
        expect(checked.target.identity.value).toBe(identity.value)
    }

    test `owner evidence retention`() {
        let fixture = TypeSystem_TestFixture()
        let owner = fixture.userType("Buffer", 31)
        let parameter = GenericParameterSemanticType(owner.declarationIdentity, "E", 0)
        let signature = CallableSignature(fixture.symbolIdentity("Buffer", "constructor", 32),
            "Buffer", CallableKind("constructor"), [ArraySemanticType(parameter)], owner, owner,
            ownerGenericDeclaration: GenericDeclaration(owner.declarationIdentity, [parameter], owner),
            externalName: "ExternalBuffer")
        let selected = signature.instantiateConstructor([SemanticTypes.intType()])
        expect(selected.externalName).toBe("ExternalBuffer")
        expect(selected.asyncFunction).toBe(false)
        expect(selected.dispatchIdentity).toBe(null)
        let inferred = CallTypeChecker.check(signature, null,
            [ArraySemanticType(SemanticTypes.intType())], fixture.range())
        expect(inferred.valid).toBe(true)
        expect(inferred.target.externalName).toBe("ExternalBuffer")
    }

    test `invalid callable evidence`() {
        let fixture = TypeSystem_TestFixture()
        let owner = fixture.userType("Example", 31)
        var Int rejected
        let blankNames = String[]
        blankNames.add("")
        blankNames.add("   ")
        for (blank in blankNames) {
            try {
                let invalidExternal = CallableSignature(fixture.symbolIdentity("read", "function"), "read", CallableKind("function"),
                    SemanticType[], SemanticTypes.intType(), externalName: blank)
            } catch (Exception error) { rejected++ }
            try {
                let invalidSlot = CallableSignature(fixture.symbolIdentity("read", "instance-method"), "read",
                    CallableKind("instance-method"), SemanticType[], SemanticTypes.intType(), owner,
                    dispatchIdentity: blank)
            } catch (Exception error) { rejected++ }
        }
        let nonvirtualKinds = ["function", "static-method", "constructor"]
        for (kind in nonvirtualKinds) {
            try {
                let invalidKind = CallableSignature(fixture.symbolIdentity("Example", kind), "Example", CallableKind(kind),
                    SemanticType[], kind == "constructor" ? owner : SemanticTypes.intType(),
                    kind == "function" ? null : owner, dispatchIdentity: "base:slot")
            } catch (Exception error) { rejected++ }
        }
        try {
            let invalidAsync = CallableSignature(fixture.symbolIdentity("Example", "constructor"), "Example", CallableKind("constructor"),
                SemanticType[], owner, owner, asyncFunction: true)
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(8)
    }

    test `checks instantiated receiver arguments`() {
        let fixture = TypeSystem_TestFixture()
        let owner = fixture.userType("Buffer", 31)
        let parameter = GenericParameterSemanticType(owner.declarationIdentity, "E", 0)
        let signature = CallableSignature(fixture.symbolIdentity("add", "instance-method", 32),
            "add", CallableKind("instance-method"), [parameter], parameter, owner,
            ownerGenericDeclaration: GenericDeclaration(owner.declarationIdentity, [parameter], owner))
        let receiver = GenericInstanceSemanticType(owner, [SemanticTypes.intType()])
        let checked = CallTypeChecker.check(signature, receiver, [SemanticTypes.intType()], fixture.range())
        expect(checked.valid).toBe(true)
        expect(checked.semanticType.value()).toBe(SemanticTypes.intType().value())
        expect(CallTypeChecker.check(signature, receiver, [SemanticTypes.boolType()], fixture.range()).valid).toBe(false)
    }
    test `instantiates owner parameters`() {
        let fixture = TypeSystem_TestFixture()
        let owner = fixture.userType("Buffer", 31)
        let parameter = GenericParameterSemanticType(owner.declarationIdentity, "E", 0)
        let signature = CallableSignature(fixture.symbolIdentity("Buffer", "constructor", 32),
            "Buffer", CallableKind("constructor"), [ArraySemanticType(parameter)], owner, owner,
            ownerGenericDeclaration: GenericDeclaration(owner.declarationIdentity, [parameter], owner))
        let selected = signature.instantiateConstructor([SemanticTypes.intType()])
        expect(selected.parameterTypes()[0].value()).toBe("array:1:primitive:Int")
        expect(selected.returnType.value()).toBe(GenericInstanceSemanticType(owner, [SemanticTypes.intType()]).value())
        expect(selected.ownerType.value()).toBe(owner.value())
        expect(selected.genericParameters().count).toBe(0)
        expect(signature.parameterTypes()[0].value()).toBe(ArraySemanticType(parameter).value())
    }
    test `partial inference preserves unresolved callback result`() {
        let fixture = TypeSystem_TestFixture()
        let identity = fixture.functionIdentity("map", 30)
        let output = GenericParameterSemanticType(identity, "Out", 0)
        let input = GenericParameterSemanticType(identity, "In", 1)
        let declaration = GenericDeclaration(identity, [output, input], output)
        let partial = GenericInference.inferPartial(declaration,
            [ArraySemanticType(input)], [ArraySemanticType(SemanticTypes.intType())], fixture.range())
        expect(partial.inferred).toBe(true)
        expect(partial.substitution.apply(input).value()).toBe(SemanticTypes.intType().value())
        expect(partial.substitution.apply(output).value()).toBe(output.value())
        expect(GenericInference.infer(declaration,
            [ArraySemanticType(input)], [ArraySemanticType(SemanticTypes.intType())], fixture.range()).inferred).toBe(false)
        expect(GenericInference.inferPartial(declaration, [input, input],
            [SemanticTypes.intType(), SemanticTypes.boolType()], fixture.range()).inferred).toBe(false)
    }

    test `async function identity survives inference and substitution`() {
        let fixture = TypeSystem_TestFixture()
        let identity = fixture.functionIdentity("map", 30)
        let output = GenericParameterSemanticType(identity, "Out", 0)
        let declaration = GenericDeclaration(identity, [output], output)
        let template = FunctionSemanticType(SemanticType[], output, asyncFunction: true)
        let actual = FunctionSemanticType(SemanticType[], SemanticTypes.intType(), asyncFunction: true)
        let sync = FunctionSemanticType(SemanticType[], SemanticTypes.intType())
        expect(actual.value() == sync.value()).toBe(false)
        expect(TypeConversions.classify(actual, sync).applicable).toBe(false)
        let result = GenericInference.infer(declaration, [template], [actual], fixture.range())
        expect(result.inferred).toBe(true)
        expect(result.substitution.apply(template).value()).toBe(actual.value())
        expect(GenericInference.infer(declaration, [template], [sync], fixture.range()).inferred).toBe(false)
    }

    test `inference preserves matching outer generic identity`() {
        let fixture = TypeSystem_TestFixture()
        let identity = fixture.functionIdentity("map", 30)
        let enclosing = fixture.functionIdentity("caller", 10)
        let input = GenericParameterSemanticType(enclosing, "Type", 0)
        let output = GenericParameterSemanticType(identity, "Out", 0)
        let declaration = GenericDeclaration(identity, [output], output)
        let result = GenericInference.infer(
            declaration,
            [FunctionSemanticType([input], output)],
            [FunctionSemanticType([input], SemanticTypes.intType())],
            fixture.range()
        )
        expect(result.inferred).toBe(true)
        expect(result.substitution.argumentFor(output).value()).toBe("primitive:Int")
        let different = GenericParameterSemanticType(fixture.functionIdentity("other", 20), "Type", 0)
        let rejected = GenericInference.infer(
            declaration,
            [FunctionSemanticType([input], output)],
            [FunctionSemanticType([different], SemanticTypes.intType())],
            fixture.range()
        )
        expect(rejected.inferred).toBe(false)
    }

    test `generic declarations and substitutions preserve nested structure`() {
        let fixture = TypeSystem_TestFixture()
        let identity = fixture.functionIdentity("map", 30)
        let input = GenericParameterSemanticType(identity, "In", 0)
        let output = GenericParameterSemanticType(identity, "Out", 1)
        let template = FunctionSemanticType(
            [ArraySemanticType(input), NullableSemanticType(output)],
            ArraySemanticType(output)
        )
        let declaration = GenericDeclaration(identity, [input, output], template)
        let substitution = GenericSubstitution(
            declaration.genericParameters(),
            [SemanticTypes.intType(), SemanticTypes.stringType()]
        )
        let applied = (FunctionSemanticType)substitution.apply(template)

        expect(applied.value()).toBe(
            "function:(array:1:primitive:Int,nullable:builtin:String)->array:1:builtin:String"
        )
        expect(substitution.argumentFor(input).value()).toBe("primitive:Int")
        expect(declaration.genericParameters().count).toBe(2)
    }

    test `structural inference resolves repeated array function and generic instance parameters`() {
        let fixture = TypeSystem_TestFixture()
        let identity = fixture.functionIdentity("select", 30)
        let parameter = GenericParameterSemanticType(identity, "T", 0)
        let declaration = GenericDeclaration(identity, [parameter], parameter)
        let box = fixture.userType("Box", 31)
        let result = GenericInference.infer(
            declaration,
            [
                ArraySemanticType(parameter),
                FunctionSemanticType([parameter], parameter),
                GenericInstanceSemanticType(box, [parameter])
            ],
            [
                ArraySemanticType(SemanticTypes.stringType()),
                FunctionSemanticType([SemanticTypes.stringType()], SemanticTypes.stringType()),
                GenericInstanceSemanticType(box, [SemanticTypes.stringType()])
            ],
            fixture.range()
        )

        expect(result.inferred).toBe(true)
        expect(result.substitution.argumentFor(parameter).value()).toBe("builtin:String")
    }

    test `inference diagnoses conflicting unresolved and constrained parameters`() {
        let fixture = TypeSystem_TestFixture()
        let identity = fixture.functionIdentity("use", 30)
        let object = fixture.userType("Object", 31)
        let base = fixture.userType("Base", 32)
        let child = fixture.userType("Child", 33)
        let unrelated = fixture.userType("Unrelated", 34)
        let component = TypeHierarchyComponent()
        component.add(fixture.hierarchyDeclaration(object))
        component.add(fixture.hierarchyDeclaration(base, parents: [object]))
        component.add(fixture.hierarchyDeclaration(child, parents: [base]))
        component.add(fixture.hierarchyDeclaration(unrelated, parents: [object]))
        component.seal()
        let constrained = GenericParameterSemanticType(identity, "T", 0, base)
        let unresolved = GenericParameterSemanticType(identity, "U", 1)
        let declaration = GenericDeclaration(identity, [constrained, unresolved], constrained)

        let conflict = GenericInference.infer(
            GenericDeclaration(identity, [constrained], constrained),
            [constrained, constrained],
            [child, base],
            fixture.range(),
            component
        )
        let missing = GenericInference.infer(
            declaration,
            [constrained],
            [child],
            fixture.range(),
            component
        )
        let invalidConstraint = GenericInference.infer(
            GenericDeclaration(identity, [constrained], constrained),
            [constrained],
            [unrelated],
            fixture.range(),
            component
        )

        expect(conflict.diagnostic.code).toBe("type.generic-inference")
        expect(missing.diagnostic.code).toBe("type.generic-unresolved")
        expect(invalidConstraint.diagnostic.code).toBe("type.generic-constraint")
    }

    test `bounded memo coalesces duplicate instantiation and uses stable key order`() {
        let fixture = TypeSystem_TestFixture()
        let identity = fixture.functionIdentity("identity", 30)
        let parameter = GenericParameterSemanticType(identity, "T", 0)
        let declaration = GenericDeclaration(
            identity,
            [parameter],
            FunctionSemanticType([parameter], parameter)
        )
        let memo = GenericInstantiationMemo(2)
        let stringWork = memo.instantiate(declaration, [SemanticTypes.stringType()])
        let duplicate = memo.instantiate(declaration, [SemanticTypes.stringType()])
        let intWork = memo.instantiate(declaration, [SemanticTypes.intType()])
        var Bool capacityRejected
        try { memo.instantiate(declaration, [SemanticTypes.longType()]) } catch (Exception error) {
            capacityRejected = true
        }

        expect(duplicate).toBe(stringWork)
        expect(stringWork.instantiatedType.value())
            .toBe("function:(builtin:String)->builtin:String")
        expect(intWork.instantiatedType.value()).toBe("function:(primitive:Int)->primitive:Int")
        expect(memo.count).toBe(2)
        expect(memo.work().first.key.compareTo(memo.work().last.key) < 0).toBe(true)
        expect(capacityRejected).toBe(true)
    }

    test `generic instance types defensively copy arguments and declaration ownership is validated`() {
        let fixture = TypeSystem_TestFixture()
        let identity = fixture.functionIdentity("value", 30)
        let parameter = GenericParameterSemanticType(identity, "T", 0)
        let box = fixture.userType("Box", 31)
        let source = SemanticType[]:add(SemanticTypes.intType())
        let instance = GenericInstanceSemanticType(box, source)
        source.add(SemanticTypes.stringType())
        let returned = instance.typeArguments()
        returned.add(SemanticTypes.longType())
        var Int rejected
        try {
            GenericDeclaration(
                identity,
                [GenericParameterSemanticType(fixture.functionIdentity("other", 32), "T", 0)],
                parameter
            )
        } catch (Exception error) { rejected++ }
        try { GenericInstantiationMemo(0) } catch (Exception error) { rejected++ }

        expect(instance.typeArguments().count).toBe(1)
        expect(rejected).toBe(2)
    }
}
