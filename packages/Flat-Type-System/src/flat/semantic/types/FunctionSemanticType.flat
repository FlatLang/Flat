package flat/semantic/types

data class extends SemanticType {
    var SemanticType[] parameters

    var String[] names
    public construct(SemanticType[] parameterTypes, visible SemanticType returnType,
        visible Bool asyncFunction = false, String[] parameterNames = String[]) {
        if (!parameterTypes || parameterTypes.any({ !_ }) || !returnType) {
            throw Exception("Function type requires parameter and return types")
        }
        parameters = SemanticType[]
        parameters.addAll(parameterTypes)
        if (!parameterNames || (parameterNames.isNotEmpty && parameterNames.count != parameterTypes.count)) throw Exception("Function parameter names must align with types")
        names = String[]:addAll(parameterNames)
    }

    public parameterNames() -> String[] => String[]:addAll(names)

    public parameterTypes() -> SemanticType[] {
        let result = SemanticType[]
        result.addAll(parameters)
        return result
    }

    override public value() -> String {
        var String result = asyncFunction ? "async-function:(" : "function:("
        var Int index
        while (index < parameters.count) {
            if (index > 0) result += ","
            result += parameters[index].value()
            index++
        }
        return "#result)->#{returnType.value()}"
    }

    override public kind() => "function"
}
