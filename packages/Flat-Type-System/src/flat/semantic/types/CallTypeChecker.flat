package flat/semantic/types

import flat/compiler/models

/** Checks exactly one already-selected function/method/constructor target. */
class {
    public static check(
        CallableSignature target,
        SemanticType receiverType,
        SemanticType[] argumentTypes,
        SourceRange range
    ) -> CallCheckResult {
        if (!target || !argumentTypes || argumentTypes.any({ !_ }) || !range) {
            throw Exception("Call checking requires target, arguments, and source range")
        }
        if ((receiverType && receiverType.kind() == "error") ||
            argumentTypes.any({ _.kind() == "error" })) {
            return CallCheckResult(target, TypeConversion[], SemanticTypes.errorType())
        }
        let kind = target.callableKind.value
        if (kind == "instance-method") {
            if (!receiverType) return invalid(target, "type.call-receiver-missing", "Instance call requires a receiver", range)
            if (target.ownerGenericDeclaration && !target.ownerInstance && receiverType.kind() == "generic-instance") {
                let instance = (GenericInstanceSemanticType)receiverType
                if (instance.declarationType.value() == target.ownerType.value() &&
                    instance.typeArguments().count == target.ownerGenericDeclaration.genericParameters().count) {
                    return check(target.instantiateReceiver(instance), receiverType, argumentTypes, range)
                }
            }
            let receiverConversion = TypeConversions.classify(receiverType, target.receiverType())
            if (!receiverConversion.applicable) {
                return invalid(target, "type.call-receiver", "Receiver '#{receiverType.value()}' is incompatible with '#{target.ownerType.value()}'", range)
            }
        } else if (receiverType) {
            return invalid(target, "type.call-receiver-unexpected", "Callable '#{target.name}' does not accept a value receiver", range)
        }
        let parameterTypes = target.parameterTypes()
        let minimumArity = parameterTypes.count - target.optionalParameterCount
        if (argumentTypes.count < minimumArity || argumentTypes.count > parameterTypes.count) {
            return invalid(
                target,
                "type.call-arity",
                "Callable '#{target.name}' expects between #minimumArity and #parameterTypes.count arguments but received #argumentTypes.count",
                range
            )
        }
        let generics = target.genericParameters()
        if (generics.isNotEmpty) {
            let inference = GenericInference.infer(
                GenericDeclaration(target.identity.declaration, generics, target.returnType),
                parameterTypes.take(argumentTypes.count), argumentTypes, range
            )
            if (!inference.inferred) {
                return CallCheckResult(
                    target, TypeConversion[], SemanticTypes.errorType(), inference.diagnostic
                )
            }
            let substitution = inference.substitution
            let instantiated = CallableSignature(
                target.identity, target.name, target.callableKind,
                parameterTypes.map({ substitution.apply(_) }),
                substitution.apply(target.returnType), target.ownerType,
                target.optionalParameterCount, target.parameterNames(),
                ownerGenericDeclaration: target.ownerGenericDeclaration, ownerInstance: target.ownerInstance
            )
            return check(instantiated, receiverType, argumentTypes, range)
        }
        let conversions = TypeConversion[]
        var Int index
        while (index < argumentTypes.count) {
            let conversion = TypeConversions.classify(argumentTypes[index], parameterTypes[index])
            if (!conversion.applicable) {
                return invalid(
                    target,
                    "type.call-argument",
                    "Argument #index of '#{argumentTypes[index].value()}' is incompatible with '#{parameterTypes[index].value()}'",
                    range
                )
            }
            conversions.add(conversion)
            index++
        }
        return CallCheckResult(target, conversions, target.returnType)
    }

    static invalid(
        CallableSignature target,
        String code,
        String message,
        SourceRange range
    ) -> CallCheckResult {
        return CallCheckResult(
            target,
            TypeConversion[],
            SemanticTypes.errorType(),
            TypeDiagnostic(code, message, range)
        )
    }
}
