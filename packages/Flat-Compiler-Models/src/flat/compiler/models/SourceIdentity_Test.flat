package flat/compiler/models

testable class {
    test `source identities and ranges are stable values`() {
        let source = SourceIdentity("workspace:packages/Test.flat")
        let snapshot = SourceSnapshotIdentity(source, "sha256:abc")
        let identity = SyntaxIslandIdentity(snapshot, "package", 0)
        let range = SourceRange(
            snapshot,
            2,
            4,
            Location(lineNumber: 3, column: 5),
            Location(lineNumber: 3, column: 17)
        )

        expect(source).toBe(SourceIdentity("workspace:packages/Test.flat"))
        expect(snapshot.value).toBe("workspace:packages/Test.flat@sha256:abc")
        expect(identity.value).toBe("workspace:packages/Test.flat@sha256:abc:package:0")
        expect(range.startTokenIndex).toBe(2)
        expect(range.endTokenIndex).toBe(4)
    }

    test `source identity contracts reject invalid values`() {
        var Int rejected

        try { SourceIdentity("") } catch (Exception error) { rejected++ }
        try { SourceSnapshotIdentity(SourceIdentity("source"), "") } catch (Exception error) { rejected++ }
        try { SyntaxIslandIdentity(SourceSnapshotIdentity(SourceIdentity("source"), "revision"), "", 0) } catch (Exception error) { rejected++ }
        try {
            SourceRange(
                SourceSnapshotIdentity(SourceIdentity("source"), "revision"),
                2,
                1,
                Location(lineNumber: 1, column: 1),
                Location(lineNumber: 1, column: 2)
            )
        } catch (Exception error) { rejected++ }

        expect(rejected).toBe(4)
    }
}
