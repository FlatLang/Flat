package flat/primitive/number

testable class {
    test `numeric overlays preserve fractions and signed decimal input`() {
        expect(Double.toString(1.25)).toBe("1.25")
        expect(Double.toString(-1.25)).toBe("-1.25")
        expect(Double.parseDouble("1.25")).toBe(1.25)
        expect(Double.parseDouble("-0.125")).toBe(-0.125)
        expect(Double.withinTolerance(Double.parseDouble("12.345"), 12.345)).toBe(true)
        expect(Double.withinTolerance(1.25, 1.5)).toBe(false)
    }

    test `Object equality preserves zero and negative fractional values`() {
        let Object zero = Double(0.0)
        let Object integerZero = Long(0)
        let Object negative = Double(-1.25)
        let Object equal = Double(-1.25)
        let Object unequal = Double(-1.5)
        let Object absent = null
        expect(zero.equals(integerZero)).toBe(true)
        expect(zero.equals(absent)).toBe(false)
        expect(negative.equals(equal)).toBe(true)
        expect(negative.equals(unequal)).toBe(false)
    }

    test `Object equality preserves finite Double fractions`() {
        let Object value = Double(1.25)
        let Object equal = Double(1.25)
        let Object unequal = Double(1.5)
        let Object integral = Int(1)
        expect(value.equals(equal)).toBe(true)
        expect(value.equals(unequal)).toBe(false)
        expect(value.equals(integral)).toBe(false)
    }

    test `Object equality accepts equal numeric wrappers`() {
        let Object value = Double(7.0)
        let Object byteValue = Byte(7)
        let Object intValue = Int(7)
        let Object longValue = Long(7)
        let Object unequal = Long(8)
        expect(value.equals(byteValue)).toBe(true)
        expect(value.equals(intValue)).toBe(true)
        expect(value.equals(longValue)).toBe(true)
        expect(value.equals(unequal)).toBe(false)
    }

    test `Object equality rejects nonnumeric and null values`() {
        let Object value = Double(1.25)
        let Object text = "1.25"
        let Object absent = null
        expect(value.equals(text)).toBe(false)
        expect(value.equals(absent)).toBe(false)
    }
}
