package flat/parser/flat

import flat/compiler/models

/** Immutable syntax-only reduced class declaration. */
data class {
    var PrimitiveFieldSyntax[] fields
    var PrimitiveFunctionSyntax[] methods
    var String[] implementedTypes
    var PrimitiveArrayOverrideSyntax[] arrayOverrides
    var PrimitiveConstructorSyntax[] constructors

    public construct(
        visible SourceRange range,
        visible String name,
        visible String genericParameterName,
        visible String parentName,
        PrimitiveFieldSyntax[] fieldValues,
        visible PrimitiveConstructorSyntax constructorValue,
        PrimitiveFunctionSyntax[] methodValues,
        String[] implementedTypeNames = String[],
        visible Bool abstractClass = false,
        PrimitiveArrayOverrideSyntax[] arrayOverrideValues = PrimitiveArrayOverrideSyntax[],
        PrimitiveConstructorSyntax[] constructorValues = PrimitiveConstructorSyntax[]
    ) {
        if (!range || !name || name.trim().count == 0 ||
            (genericParameterName && genericParameterName.trim().count == 0) ||
            (parentName && parentName.trim().count == 0) || !fieldValues ||
            fieldValues.any({ !_ }) || !constructorValue || !methodValues ||
            methodValues.any({ !_ }) || !implementedTypeNames ||
            implementedTypeNames.any((implementedType) =>
                !implementedType || implementedType.trim().count == 0
            ) || !arrayOverrideValues || arrayOverrideValues.any({ !_ }) ||
            !constructorValues || constructorValues.any({ !_ })) {
            throw Exception("Primitive class syntax requires range name fields constructor and methods")
        }
        fields = PrimitiveFieldSyntax[]
        fields.addAll(fieldValues)
        methods = PrimitiveFunctionSyntax[]
        methods.addAll(methodValues)
        implementedTypes = String[]
        implementedTypes.addAll(implementedTypeNames)
        arrayOverrides = PrimitiveArrayOverrideSyntax[]
        arrayOverrides.addAll(arrayOverrideValues)
        constructors = PrimitiveConstructorSyntax[]
        if (constructorValues.isEmpty) constructors.add(constructorValue)
        else constructors.addAll(constructorValues)
    }

    public mergedWith(PrimitiveClassSyntax overlay) -> PrimitiveClassSyntax {
        if (!overlay || overlay.name != name || overlay.parentName != null ||
            overlay.implementedTypeNames().isNotEmpty) {
            throw Exception("Class overlay merge requires same-name syntax")
        }
        let fields = fieldValues()
        for (field in overlay.fieldValues()) {
            var Int existingFieldIndex = -1
            var Int fieldIndex
            while (fieldIndex < fields.count && existingFieldIndex < 0) {
                if (fields[fieldIndex].name == field.name) existingFieldIndex = fieldIndex
                fieldIndex++
            }
            if (existingFieldIndex >= 0) {
                let canonicalField = fields[existingFieldIndex]
                if (canonicalField.typeName != field.typeName ||
                    canonicalField.visibleField != field.visibleField ||
                    canonicalField.staticField != field.staticField) {
                    throw Exception("Class overlay field must preserve canonical declaration shape")
                }
                fields[existingFieldIndex] = PrimitiveFieldSyntax(
                    canonicalField.range, canonicalField.typeName, canonicalField.name,
                    canonicalField.visibleField, canonicalField.initializer,
                    canonicalField.staticField, canonicalField.mutableField,
                    canonicalField.nativeArrayStorage || field.nativeArrayStorage
                )
            } else fields.add(field)
        }
        let methods = methodValues()
        var PrimitiveFunctionSyntax duplicate
        var Int overlayIndex
        while (overlayIndex < overlay.methodValues().count && !duplicate) {
            let method = overlay.methodValues()[overlayIndex]
            var Int candidateIndex = overlayIndex + 1
            while (candidateIndex < overlay.methodValues().count && !duplicate) {
                let candidate = overlay.methodValues()[candidateIndex]
                if (candidate.name == method.name &&
                    candidate.staticMethod == method.staticMethod &&
                    candidate.parameterValues().map({ _.typeName }) ==
                        method.parameterValues().map({ _.typeName })) duplicate = method
                candidateIndex++
            }
            overlayIndex++
        }
        if (duplicate) throw Exception("Class overlay duplicates method '#{duplicate.name}'")

        for (method in overlay.methodValues()) {
            var Int existingIndex = -1
            var Int methodIndex
            while (methodIndex < methods.count && existingIndex < 0) {
                let existing = methods[methodIndex]
                if (existing.name == method.name &&
                    existing.staticMethod == method.staticMethod &&
                    existing.parameterValues().map({ _.typeName }) ==
                        method.parameterValues().map({ _.typeName })) existingIndex = methodIndex
                methodIndex++
            }
            if (existingIndex >= 0) methods[existingIndex] = method
            else methods.add(method)
        }
        let mergedConstructors = constructorValues()
        for (overlayConstructor in overlay.constructorValues()) {
            var Int existingConstructorIndex = -1
            var Int constructorIndex
            while (constructorIndex < mergedConstructors.count &&
                existingConstructorIndex < 0) {
                if (mergedConstructors[constructorIndex].parameterValues().map({ _.typeName }) ==
                    overlayConstructor.parameterValues().map({ _.typeName })) {
                    existingConstructorIndex = constructorIndex
                }
                constructorIndex++
            }
            if (existingConstructorIndex >= 0) {
                mergedConstructors[existingConstructorIndex] = overlayConstructor
            } else mergedConstructors.add(overlayConstructor)
        }
        return PrimitiveClassSyntax(
            range, name, genericParameterName, parentName,
            fields, mergedConstructors.first, methods, implementedTypeNames(), abstractClass,
            overlay.arrayOverrideValues().isNotEmpty ?
                overlay.arrayOverrideValues() : arrayOverrideValues(),
            mergedConstructors
        )
    }

    public fieldValues() -> PrimitiveFieldSyntax[] => PrimitiveFieldSyntax[]:addAll(fields)
    public methodValues() -> PrimitiveFunctionSyntax[] => PrimitiveFunctionSyntax[]:addAll(methods)
    public implementedTypeNames() -> String[] => String[]:addAll(implementedTypes)
    public arrayOverrideValues() -> PrimitiveArrayOverrideSyntax[] =>
        PrimitiveArrayOverrideSyntax[]:addAll(arrayOverrides)
    public constructorValues() -> PrimitiveConstructorSyntax[] =>
        PrimitiveConstructorSyntax[]:addAll(constructors)
}
