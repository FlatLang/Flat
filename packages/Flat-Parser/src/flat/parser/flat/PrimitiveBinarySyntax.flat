package flat/parser/flat

import flat/compiler/models

data class extends PrimitiveExpressionSyntax {
    public construct(
        SourceRange range,
        visible String operator,
        visible PrimitiveExpressionSyntax left,
        visible PrimitiveExpressionSyntax right
    ) {
        if (!range || !operator || !left || !right) {
            throw Exception("Primitive binary syntax requires operator and operands")
        }
        super(range)
    }
    override public expressionKind() => "binary"
}
