package flat/parser/flat

import flat/compiler/models

testable class {
    test `parses reduced type slice`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:class"), "revision:one"
        )
        let parsed = PrimitiveClassParser().parse(tokens(), snapshot, 4)
        let methods = parsed.methodValues()
        let method = methods.first
        let statements = method.statements()
        let returnedObject = (Object)statements.first
        let returned = (PrimitiveReturnSyntax)returnedObject
        let accessObject = (Object)returned.value
        let access = (PrimitiveMemberAccessSyntax)accessObject

        expect(parsed.name).toBe("Box")
        expect(parsed.parentName).toBe(null)
        expect(parsed.genericParameterName).toBe(null)
        expect(parsed.fieldValues().first.name).toBe("value")
        expect(parsed.constructorValue.parameterValues().first.name).toBe("value")
        expect(parsed.range.startTokenIndex).toBe(4)
        expect(access.memberName).toBe("value")
    }

    test `parses visible constructor parameter as field synthesis syntax`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:visible-constructor-parameter"), "revision:one"
        )
        let parsed = PrimitiveClassParser().parse([
            token("class", false, 1), token("Exception", false, 7), token("{", true, 17),
            token("construct", false, 19), token("(", true, 28), token("visible", false, 29),
            token("String", false, 37), token("message", false, 44), token("=", true, 52),
            token("''", false, 54), token(")", true, 56), token("{", true, 58),
            token("}", true, 59), token("}", true, 61)
        ], snapshot)
        let parameter = parsed.constructorValue.parameterValues().first

        expect(parameter.visibleParameter).toBe(true)
        expect(parameter.name).toBe("message")
        expect(parameter.defaultValue.expressionKind()).toBe("literal")
        expect(parameter.range.startTokenIndex).toBe(5)
    }

    test `parses public constructor parameter as field synthesis syntax`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:public-constructor-parameter"), "revision:one"
        )
        let parsed = PrimitiveClassParser().parse([
            token("class", false, 1), token("Bool", false, 7), token("{", true, 12),
            token("construct", false, 14), token("(", true, 23),
            token("public", false, 24), token("Bool", false, 31),
            token("value", false, 36), token(")", true, 41),
            token("{", true, 43), token("}", true, 44), token("}", true, 46)
        ], snapshot)

        expect(parsed.constructorValue.parameterValues().first.visibleParameter).toBe(true)
    }

    test `rejects incomplete visible constructor parameter`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:visible-constructor-parameter-invalid"), "revision:one"
        )
        var rejected = false
        try {
            PrimitiveClassParser().parse([
                token("class", false, 1), token("Exception", false, 7), token("{", true, 17),
                token("construct", false, 19), token("(", true, 28), token("visible", false, 29),
                token(")", true, 36), token("{", true, 38), token("}", true, 39),
                token("}", true, 41)
            ], snapshot)
        } catch (Exception error) { rejected = true }
        expect(rejected).toBe(true)
    }

    test `parses delegated legacy constructor arguments`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:delegated-construct"), "one")
        let parsed = PrimitiveClassParser().parse([
            token("class", false, 1), token("Child", false, 7), token("extends", false, 13),
            token("Parent", false, 21), token("{", true, 28), token("construct", false, 30),
            token("(", true, 39), token("String", false, 40), token("message", false, 47),
            token(")", true, 54), token("=>", true, 56), token("super", false, 59),
            token("(", true, 64), token("message", false, 65), token(")", true, 72),
            token("}", true, 74)
        ], snapshot)
        expect(parsed.constructorValue.statements().count).toBe(0)
        expect(parsed.constructorValue.parentArgumentValues().count).toBe(1)
        expect(parsed.constructorValue.parentArgumentValues().first.expressionKind()).toBe("reference")
    }

    test `rejects malformed delegated constructor arguments`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:delegated-invalid"), "one")
        var Int rejected
        try {
            PrimitiveClassParser().parse([
                token("class", false, 1), token("Child", false, 7), token("extends", false, 13),
                token("Parent", false, 21), token("{", true, 28), token("construct", false, 30),
                token("(", true, 39), token(")", true, 40), token("=>", true, 42),
                token("super", false, 45), token("(", true, 50), token("1", false, 51),
                token(",", true, 52), token(")", true, 53), token("}", true, 55)
            ], snapshot)
        } catch (Exception error) { rejected++ }
        try {
            PrimitiveClassParser().parse([
                token("class", false, 1), token("Child", false, 7), token("extends", false, 13),
                token("Parent", false, 21), token("{", true, 28), token("construct", false, 30),
                token("(", true, 39), token(")", true, 40), token("=>", true, 42),
                token("super", false, 45), token("(", true, 50)
            ], snapshot)
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
    }

    test `parses visible initialized field and default constructor parameter`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:exception-subset"), "one")
        let parsed = PrimitiveClassParser().parse([
            token("class", false, 1), token("Exception", false, 7), token("{", true, 17),
            token("visible", false, 19), token("String", false, 27),
            token("message", false, 34), token("=", true, 42), token("''", false, 44),
            token(";", true, 46), token("construct", false, 48), token("(", true, 57),
            token("String", false, 58), token("message", false, 65), token("=", true, 73),
            token("''", false, 75), token(")", true, 77), token("{", true, 79),
            token("}", true, 80), token("}", true, 82)
        ], snapshot)
        let field = parsed.fieldValues().first
        let parameter = parsed.constructorValue.parameterValues().first

        expect(field.visibleField).toBe(true)
        expect(field.initializer.expressionKind()).toBe("literal")
        expect(parameter.defaultValue.expressionKind()).toBe("literal")
    }

    test `rejects incomplete field initializer and parameter default`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:exception-invalid"), "one")
        var Int rejected
        try {
            PrimitiveClassParser().parse([
                token("class", false, 1), token("Exception", false, 7), token("{", true, 17),
                token("String", false, 19), token("message", false, 26), token("=", true, 34),
                token(";", true, 35), token("}", true, 37)
            ], snapshot)
        } catch (Exception error) { rejected++ }
        try {
            PrimitiveClassParser().parse([
                token("class", false, 1), token("Exception", false, 7), token("{", true, 17),
                token("construct", false, 19), token("(", true, 28), token("String", false, 29),
                token("message", false, 36), token("=", true, 44), token(")", true, 45),
                token("{", true, 47), token("}", true, 48), token("}", true, 50)
            ], snapshot)
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
    }

    test `accepts implemented type list as validated reduced metadata`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:implements"), "one")
        let parsed = PrimitiveClassParser().parse([
            token("class", false, 1), token("Value", false, 7),
            token("implements", false, 13), token("Comparable", false, 24),
            token("<", true, 34), token("Value", false, 35), token(">", true, 40),
            token("{", true, 42), token("}", true, 43)
        ], snapshot)
        expect(parsed.name).toBe("Value")
        expect(parsed.implementedTypeNames()).toBe(["Comparable<Value>"])
    }

    test `parses legacy construct spelling`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:construct"), "one")
        let parsed = PrimitiveClassParser().parse([
            token("class", false, 1), token("Value", false, 7), token("{", true, 13),
            token("construct", false, 15), token("(", true, 24), token(")", true, 25),
            token("{", true, 27), token("}", true, 28), token("}", true, 30)
        ], snapshot)
        expect(parsed.constructorValue).toNotBe(null)
    }

    test `synthesizes an empty constructor when omitted`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:implicit-constructor"), "one")
        let parsed = PrimitiveClassParser().parse([
            token("class", false, 1), token("Empty", false, 7),
            token("{", true, 13), token("}", true, 14)
        ], snapshot)
        expect(parsed.constructorValue).toNotBe(null)
        expect(parsed.constructorValue.parameterValues().count).toBe(0)
        expect(parsed.constructorValue.statements().count).toBe(0)
    }

    test `parses parent declaration and rejects missing parent name`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:inheritance"), "revision:one"
        )
        let parsed = PrimitiveClassParser().parse([
            token("class", false, 1), token("Child", false, 7),
            token("extends", false, 13), token("Parent", false, 21),
            token("{", true, 28), token("constructor", false, 30),
            token("(", true, 41), token(")", true, 42), token("{", true, 44),
            token("}", true, 45), token("}", true, 47)
        ], snapshot)
        expect(parsed.parentName).toBe("Parent")
        var rejected = false
        try {
            PrimitiveClassParser().parse([
                token("class", false, 1), token("Child", false, 7),
                token("extends", false, 13), token("{", true, 21)
            ], snapshot)
        } catch (Exception error) { rejected = true }
        expect(rejected).toBe(true)
    }

    test `parses generic parameter and rejects incomplete generic declaration`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:generic-class"), "revision:one"
        )
        let parsed = PrimitiveClassParser().parse([
            token("class", false, 1), token("Box", false, 7), token("<", true, 10),
            token("T", false, 11), token(">", true, 12), token("{", true, 14),
            token("constructor", false, 16), token("(", true, 27), token(")", true, 28),
            token("{", true, 30), token("}", true, 31), token("}", true, 33)
        ], snapshot)
        expect(parsed.genericParameterName).toBe("T")
        var rejected = false
        try {
            PrimitiveClassParser().parse([
                token("class", false, 1), token("Box", false, 7), token("<", true, 10),
                token(">", true, 11)
            ], snapshot)
        } catch (Exception error) { rejected = true }
        expect(rejected).toBe(true)
    }

    test `parses semicolonless initialized field before visible constructor`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:semicolonless-field"), "revision:one"
        )
        let parsed = PrimitiveClassParser().parse([
            token("class", false, 1), token("Exception", false, 7), token("{", true, 17),
            token("visible", false, 19), token("StackTrace", false, 27),
            token("stackTrace", false, 38), token("=", true, 49),
            token("StackTrace", false, 51), token("(", true, 61), token(")", true, 62),
            token("public", false, 64), token("construct", false, 71),
            token("(", true, 80), token(")", true, 81), token("{", true, 83),
            token("}", true, 84), token("}", true, 86)
        ], snapshot)

        expect(parsed.fieldValues().first.name).toBe("stackTrace")
        expect(parsed.fieldValues().first.initializer.expressionKind()).toBe("call")
    }

    test `parses bodyless method with inferred return syntax`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:bodyless-class-method"), "revision:one"
        )
        let parsed = PrimitiveClassParser().parse([
            token("class", false, 1), token("Exception", false, 7), token("{", true, 17),
            token("public", false, 19), token("toString", false, 26),
            token("(", true, 34), token(")", true, 35), token("=>", true, 37),
            token("message", false, 40), token("}", true, 47)
        ], snapshot)
        let method = parsed.methodValues().first

        expect(method.name).toBe("toString")
        expect(method.returnTypeName).toBe("String")
        expect(method.statements().count).toBe(1)
    }

    test `parses expression bodied property as parameterless method syntax`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:bodyless-property"), "revision:one"
        )
        let parsed = PrimitiveClassParser().parse([
            token("class", false, 1), token("Bool", false, 7), token("{", true, 12),
            token("Long", false, 14), token("hashCodeLong", false, 19),
            token("=>", true, 32), token("0", false, 35), token("}", true, 37)
        ], snapshot)
        let property = parsed.methodValues().first

        expect(property.name).toBe("hashCodeLong")
        expect(property.returnTypeName).toBe("Long")
        expect(property.parameterValues().count).toBe(0)
    }

    test `parses visible expression bodied property`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:visible-bodyless-property"), "revision:one"
        )
        let parsed = PrimitiveClassParser().parse([
            token("class", false, 1), token("Object", false, 7), token("{", true, 14),
            token("visible", false, 16), token("Long", false, 24),
            token("hashCodeLong", false, 29), token("=>", true, 42),
            token("0", false, 45), token("}", true, 47)
        ], snapshot)

        expect(parsed.methodValues().first.name).toBe("hashCodeLong")
        expect(parsed.methodValues().first.returnTypeName).toBe("Long")
    }

    test `merges same name method only overlay immutably`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:class-overlay"), "revision:one"
        )
        let canonical = PrimitiveClassParser().parse([
            token("class", false, 1), token("Object", false, 7), token("{", true, 14),
            token("equals", false, 16), token("(", true, 22), token(")", true, 23),
            token("=>", true, 25), token("true", false, 28), token("}", true, 33)
        ], snapshot)
        let overlay = PrimitiveClassParser().parse([
            token("class", false, 1), token("Object", false, 7), token("{", true, 14),
            token("public", false, 16), token("static", false, 23),
            token("referenceEquals", false, 30), token("(", true, 45),
            token(")", true, 46), token("=>", true, 48),
            token("true", false, 51), token("}", true, 56)
        ], snapshot)
        let merged = canonical.mergedWith(overlay)

        expect(canonical.methodValues().count).toBe(1)
        expect(merged.methodValues().map({ _.name })).toBe(["equals", "referenceEquals"])
    }

    test `rejects invalid reduced types`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:class-invalid"), "revision:one"
        )
        var Int rejected
        try {
            PrimitiveClassParser().parse([
                token("class", false, 1), token("Box", false, 7), token("{", true, 11),
                token("Int", false, 13), token("value", false, 17), token(";", true, 22)
            ], snapshot)
        } catch (Exception error) { rejected++ }
        try {
            PrimitiveClassParser().parse([
                token("class", false, 1), token("Box", false, 7), token("{", true, 11),
                token("Int", false, 13), token("value", false, 17), token(";", true, 22),
                token("Int", false, 24), token("value", false, 28), token(";", true, 33),
                token("constructor", false, 35), token("(", true, 46), token(")", true, 47),
                token("{", true, 49), token("}", true, 50), token("}", true, 52)
            ], snapshot)
        } catch (Exception error) { rejected++ }
        try {
            let values = tokens()
            PrimitiveClassParser().parse(values.take(values.count - 1), snapshot)
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(3)
    }

    tokens() -> Token[] {
        return [
        token("class", false, 1), token("Box", false, 7), token("{", true, 11),
        token("Int", false, 13), token("value", false, 17), token(";", true, 22),
        token("constructor", false, 24), token("(", true, 35), token("Int", false, 36), token("value", false, 40),
        token(")", true, 45), token("{", true, 47), token("this", false, 49), token(".", true, 53),
        token("value", false, 54), token("=", true, 60), token("value", false, 62), token(";", true, 67),
        token("}", true, 69), token("get", false, 71), token("(", true, 74), token(")", true, 75),
        token("->", true, 77), token("Int", false, 80), token("{", true, 84), token("return", false, 86),
        token("this", false, 93), token(".", true, 97), token("value", false, 98), token(";", true, 103),
        token("}", true, 105), token("}", true, 107)
        ]
    }

    token(
        String value,
        Bool symbol,
        Int column
    ) -> Token {
        let type = symbol ? Token.Type.SYMBOL :
            value == "''" ? Token.Type.STRING : Token.Type.IDENTIFIER
        return Token(value: value, type: type,
            location: Location(lineNumber: 1, column: column))
    }
}
