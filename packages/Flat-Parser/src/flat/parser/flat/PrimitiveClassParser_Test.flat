        expect(property.range.snapshot).toBe(snapshot)
    }

    test `parses declaration flags`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:abstract-class"), "revision:one"
        )
        let parsed = PrimitiveClassParser().parse([
            token("abstract", false, 1), token("class", false, 10),
            token("Number", false, 16), token("{", true, 23),
            token("public", false, 25), token("abstract", false, 32),
            token("plus", false, 41), token("(", true, 45), token("Long", false, 46),
            token("other", false, 51), token(")", true, 56), token("->", true, 58),
            token("Long", false, 61), token("}", true, 66)
        ], snapshot)
        let method = parsed.methodValues().first

        expect(parsed.abstractClass).toBe(true)
        expect(method.name).toBe("plus")
        expect(method.returnTypeName).toBe("Long")
        expect(method.abstractMethod).toBe(true)
        expect(method.statements().count).toBe(0)
    }

    test `parses static field`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:static-field"), "revision:one"
        )
        let parsed = PrimitiveClassParser().parse([
            token("class", false, 1), token("Math", false, 7), token("{", true, 12),
            token("visible", false, 14), token("static", false, 22),
            token("Int", false, 29), token("PI", false, 36), token("=", true, 39),
            token("3", false, 41, Token.Type.INTEGER), token("}", true, 46)
        ], snapshot)
        let field = parsed.fieldValues().first

        expect(field.name).toBe("PI")
        expect(field.visibleField).toBe(true)
        expect(field.staticField).toBe(true)
        expect(field.initializer.expressionKind()).toBe("literal")
    }

    test `parses visible constructor parameter as field synthesis syntax`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:visible-constructor-parameter"), "revision:one"
        )
        let parsed = PrimitiveClassParser().parse([
            token("class", false, 1), token("Exception", false, 7), token("{", true, 17),
            token("construct", false, 19), token("(", true, 28), token("visible", false, 29),
            token("String", false, 37), token("message", false, 44), token("=", true, 52),
            token("''", false, 54), token(")", true, 56), token("{", true, 58),
            token("}", true, 59), token("}", true, 61)
