    test `merges target overlay by replacing exact method implementation`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:class-overlay-replacement"), "revision:one"
        )
        let canonical = PrimitiveClassParser().parse([
            token("class", false, 1), token("Float", false, 7), token("{", true, 13),
            token("public", false, 15), token("static", false, 22),
            token("toString", false, 29), token("(", true, 37),
            token("Float", false, 38), token("value", false, 44), token(")", true, 49),
            token("=>", true, 51), token("value", false, 54), token("}", true, 60)
        ], snapshot)
        let overlay = PrimitiveClassParser().parse([
            token("class", false, 1), token("Float", false, 7), token("{", true, 13),
            token("public", false, 15), token("static", false, 22),
            token("toString", false, 29), token("(", true, 37),
            token("Float", false, 38), token("value", false, 44), token(")", true, 49),
            token("=>", true, 51), token("other", false, 54), token("}", true, 60)
        ], snapshot)
        let merged = canonical.mergedWith(overlay)

        expect(merged.methodValues().count).toBe(1)
        let mergedMethod = merged.methodValues().first
        let mergedStatements = mergedMethod.statements()
        let returnedObject = (Object)mergedStatements.first
        let returned = (PrimitiveReturnSyntax)returnedObject
        let valueObject = (Object)returned.value
        let value = (PrimitiveReferenceSyntax)valueObject
        expect(value.name).toBe("other")
    }

