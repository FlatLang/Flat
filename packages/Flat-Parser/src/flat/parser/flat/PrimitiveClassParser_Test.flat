    test `parses bare constructor after expression property`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:bare-constructor-boundary"), "revision:one"
        )
        let parsed = PrimitiveClassParser().parse([
            token("class", false, 1), token("Float", false, 7), token("{", true, 13),
            token("public", false, 15), token("Long", false, 22),
            token("integerValue", false, 27), token("=>", true, 40),
            token("(", true, 43), token("Long", false, 44), token(")", true, 48),
            token("value", false, 49), token("construct", false, 55),
            token("(", true, 64), token("public", false, 65), token("Float", false, 72),
            token("value", false, 78), token(")", true, 83),
            token("{", true, 85), token("}", true, 86), token("}", true, 88)
        ], snapshot)

        expect(parsed.methodValues().first.name).toBe("integerValue")
        expect(parsed.constructorValue.parameterValues().first.name).toBe("value")
    }

    test `parses bodyless native primitive constructor contract`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:bodyless-constructor"), "revision:one"
        )
        let parsed = PrimitiveClassParser().parse([
            token("class", false, 1), token("Byte", false, 7), token("{", true, 12),
            token("public", false, 14), token("construct", false, 21),
            token("(", true, 30), token("public", false, 31),
