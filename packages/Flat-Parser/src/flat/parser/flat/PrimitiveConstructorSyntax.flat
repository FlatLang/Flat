package flat/parser/flat

import flat/compiler/models

/** Immutable syntax-only constructor declaration. */
data class {
    var PrimitiveFunctionParameterSyntax[] parameters
    var PrimitiveStatementSyntax[] body
    var PrimitiveExpressionSyntax[] parentArguments

    public construct(
        visible SourceRange range,
        PrimitiveFunctionParameterSyntax[] parameterValues,
        PrimitiveStatementSyntax[] statements,
        PrimitiveExpressionSyntax[] parentArgumentValues = PrimitiveExpressionSyntax[]
    ) {
        if (!range || !parameterValues || parameterValues.any({ !_ }) ||
            !statements || statements.any({ !_ }) || !parentArgumentValues ||
            parentArgumentValues.any({ !_ })) {
            throw Exception("Primitive constructor syntax requires range signature and body")
        }
        parameters = PrimitiveFunctionParameterSyntax[]
        parameters.addAll(parameterValues)
        body = PrimitiveStatementSyntax[]
        body.addAll(statements)
        parentArguments = PrimitiveExpressionSyntax[]
        parentArguments.addAll(parentArgumentValues)
    }

    public parameterValues() -> PrimitiveFunctionParameterSyntax[] =>
        PrimitiveFunctionParameterSyntax[]:addAll(parameters)
    public statements() -> PrimitiveStatementSyntax[] =>
        PrimitiveStatementSyntax[]:addAll(body)
    public parentArgumentValues() -> PrimitiveExpressionSyntax[] =>
        PrimitiveExpressionSyntax[]:addAll(parentArguments)
}
