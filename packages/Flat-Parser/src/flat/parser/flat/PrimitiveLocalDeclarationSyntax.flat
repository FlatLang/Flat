package flat/parser/flat

import flat/compiler/models

data class extends PrimitiveStatementSyntax {
    public construct(
        SourceRange range,
        visible Bool mutable,
        visible String name,
        visible PrimitiveExpressionSyntax initializer = null,
        visible String declaredTypeName = null
    ) {
        if (!range || !name || (!initializer && !declaredTypeName) || declaredTypeName == "") {
            throw Exception("Primitive local syntax requires name and initializer or explicit type")
        }
        super(range)
    }
    override public statementKind() => "local-declaration"
}
