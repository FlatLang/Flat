package flat/parser/flat

import flat/compiler/models

/** Syntax-only assignment to a selected receiver member. */
data class extends PrimitiveStatementSyntax {
    public construct(
        SourceRange range,
        visible PrimitiveMemberAccessSyntax target,
        visible PrimitiveExpressionSyntax value,
        visible String assignmentOperator = "="
    ) {
        var Bool compound = assignmentOperator == "+=" || assignmentOperator == "-=" ||
            assignmentOperator == "*=" || assignmentOperator == "/=" || assignmentOperator == "%="
        if (!range || !target || !value || (assignmentOperator != "=" && !compound)) {
            throw Exception("Primitive member assignment requires target, supported operator, and value")
        }
        super(range)
    }
    override public statementKind() => "member-assignment"
}
