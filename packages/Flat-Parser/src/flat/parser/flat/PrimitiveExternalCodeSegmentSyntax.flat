package flat/parser/flat

import flat/compiler/models

/** One immutable literal or interpolated path segment inside opaque external code. */
data class {
    var String[] path

    public construct(
        visible SourceRange range,
        visible String text,
        String[] pathValues
    ) {
        if (!range || text == null || !pathValues) {
            throw Exception("External code segment requires literal text or a path")
        }
        for (part in pathValues) {
            if (!part || part.count == 0) {
                throw Exception("External code path parts cannot be empty")
            }
        }
        if (text.count > 0 && pathValues.isNotEmpty) {
            throw Exception("External code segment cannot mix literal text and a path")
        }
        if (text.count == 0 && pathValues.isEmpty) {
            throw Exception("External code segment requires either literal text or a path")
        }
        path = String[]
        path.addAll(pathValues)
    }

    public interpolated() => path.isNotEmpty
    public pathValues() -> String[] => String[]:addAll(path)
}
