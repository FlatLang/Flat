package flat/parser/flat

import flat/compiler/models

/** Immutable syntax-only identifier reference. */
data class extends PrimitiveExpressionSyntax {
    public construct(SourceRange range, visible String name) {
        if (!range || !name || name.trim().count == 0) {
            throw Exception("Primitive reference syntax requires range and name")
        }
        super(range)
    }
    override public expressionKind() => "reference"
}
