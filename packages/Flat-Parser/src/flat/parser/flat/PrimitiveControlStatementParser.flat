package flat/parser/flat

import flat/compiler/models

/** Balanced recursive syntax parser for primitive statements, if/else, and while. */
class {
    var Token[] tokens
    var Int index
    var Int tokenIndexOffset
    var SourceSnapshotIdentity snapshot

    public parse(
        Token[] tokenValues,
        SourceSnapshotIdentity sourceSnapshot,
        Int sourceTokenIndexOffset = 0
    ) -> PrimitiveStatementSyntaxResult {
        if (!tokenValues || !sourceSnapshot) {
            throw Exception("Primitive control parsing requires tokens and snapshot")
        }
        tokens = tokenValues.filter({
            let type = _.type
            return type != Token.Type.WHITESPACE && type != Token.Type.COMMENT
        })
        snapshot = sourceSnapshot
        tokenIndexOffset = sourceTokenIndexOffset
        index = 0
        let statements = parseStatements(false)
        if (index != tokens.count) syntax("Unexpected trailing token", index)
        return PrimitiveStatementSyntaxResult(statements)
    }

    parseStatements(Bool insideBody) -> PrimitiveStatementSyntax[] {
        let statements = PrimitiveStatementSyntax[]
        while (index < tokens.count && (!insideBody || tokens[index].value != "}")) {
            if (tokens[index].value == "if") statements.add(parseIf())
            else if (tokens[index].value == "switch") statements.add(parseSwitch())
            else if (tokens[index].value == "while") statements.add(parseWhile())
            else if (tokens[index].value == "for") statements.add(parseFor())
            else if (tokens[index].value == "try") statements.add(parseTry())
            else if (tokens[index].value == "external") statements.add(parseExternal())
            else statements.add(parseSimple())
        }
        if (insideBody) {
            if (index >= tokens.count || tokens[index].value != "}") {
                syntax("Expected closing brace", index)
            }
            index++
        }
        return statements
    }

    parseIf() -> PrimitiveStatementSyntax {
        let start = index++
        let condition = parseCondition()
        let thenValues = parseBody()
        let elseValues = PrimitiveStatementSyntax[]
        if (index < tokens.count && tokens[index].value == "else") {
            index++
            if (index < tokens.count && tokens[index].value == "if") {
                elseValues.add(parseIf())
            } else elseValues.addAll(parseBody())
        }
        return PrimitiveIfSyntax(range(start, index), condition, thenValues, elseValues)
    }

    parseSwitch() -> PrimitiveStatementSyntax {
        let start = index++
        let valueStart = index
        while (index < tokens.count && tokens[index].value != "{") index++
        if (index == valueStart || index >= tokens.count) {
            syntax("Switch requires value and opening brace", start)
        }
        let value = PrimitiveExpressionParser().parse(
            tokens.skip(valueStart).take(index - valueStart),
            snapshot, valueStart + tokenIndexOffset
        )
        index++
        let cases = PrimitiveSwitchCaseSyntax[]
        var Bool defaultSeen
        while (index < tokens.count && tokens[index].value != "}") {
            let caseStart = index
            var PrimitiveExpressionSyntax label
            var Bool defaultCase
            if (tokens[index].value == "default") {
                if (defaultSeen) syntax("Switch cannot contain duplicate default", index)
                defaultSeen = true
                defaultCase = true
                index++
            } else {
                let labelStart = index
                while (index < tokens.count && tokens[index].value != "=>") index++
                if (index == labelStart || index >= tokens.count) {
                    syntax("Switch case requires label and arrow", caseStart)
                }
                label = PrimitiveExpressionParser().parse(
                    tokens.skip(labelStart).take(index - labelStart),
                    snapshot, labelStart + tokenIndexOffset
                )
            }
            if (index >= tokens.count || tokens[index].value != "=>") {
                syntax("Switch case requires arrow", index)
            }
            index++
            let bodyStart = index
            while (index < tokens.count && tokens[index].value != "}" &&
                !(index + 1 < tokens.count && tokens[index + 1].value == "=>")) index++
            let bodyTokens = tokens.skip(bodyStart).take(index - bodyStart)
            let fallsThrough = bodyTokens.count == 1 &&
                bodyTokens.first.value == "fallthrough"
            let statements = fallsThrough ? PrimitiveStatementSyntax[] :
                PrimitiveControlStatementParser().parse(
                    bodyTokens, snapshot, bodyStart + tokenIndexOffset
                ).statements()
            cases.add(PrimitiveSwitchCaseSyntax(
                range(caseStart, index), label, statements,
                defaultCase, fallsThrough
            ))
        }
        if (index >= tokens.count) syntax("Expected closing switch brace", start)
        index++
        return PrimitiveSwitchSyntax(range(start, index), value, cases)
    }

    parseFor() -> PrimitiveStatementSyntax {
        var Int cursor = index + 1
        if (cursor >= tokens.count || tokens[cursor].value != "(") {
            syntax("Expected for opening parenthesis", cursor)
        }
        cursor++
        var Int depth
        while (cursor < tokens.count && (tokens[cursor].value != ")" || depth > 0)) {
            if (tokens[cursor].value == "(") depth++
            else if (tokens[cursor].value == ")" && depth > 0) depth--
            else if (depth == 0 && tokens[cursor].value == ";") return parseCStyleFor()
            cursor++
        }
        return parseForEach()
    }

    parseCStyleFor() -> PrimitiveStatementSyntax {
        let start = index++
        if (index >= tokens.count || tokens[index].value != "(") {
            syntax("Expected for opening parenthesis", index)
        }
        index++
        let clauses = Int[]
        var Int depth
        var Int cursor = index
        while (cursor < tokens.count && (tokens[cursor].value != ")" || depth > 0)) {
            if (tokens[cursor].value == "(") depth++
            else if (tokens[cursor].value == ")" && depth > 0) depth--
            else if (depth == 0 && tokens[cursor].value == ";") clauses.add(cursor)
            cursor++
        }
        if (clauses.count != 2 || cursor >= tokens.count) {
            syntax("C-style for requires initializer, condition, and advance", index)
        }
        let initializerValues = PrimitiveStatementParser().parse(
            tokens.skip(index).take(clauses[0] - index), snapshot, index + tokenIndexOffset
        ).statements()
        if (initializerValues.count != 1 ||
            !initializerValues.first.class.isOfType(PrimitiveLocalDeclarationSyntax.class)) {
            syntax("C-style for requires one local initializer", index)
        }
        let condition = PrimitiveExpressionParser().parse(
            tokens.skip(clauses[0] + 1).take(clauses[1] - clauses[0] - 1),
            snapshot, clauses[0] + 1 + tokenIndexOffset
        )
        let advanceValues = PrimitiveStatementParser().parse(
            tokens.skip(clauses[1] + 1).take(cursor - clauses[1] - 1),
            snapshot, clauses[1] + 1 + tokenIndexOffset
        ).statements()
        if (advanceValues.count != 1 ||
            !advanceValues.first.class.isOfType(PrimitiveAssignmentSyntax.class)) {
            syntax("C-style for requires one assignment advance", clauses[1] + 1)
        }
        index = cursor + 1
        let body = parseBody()
        return PrimitiveForSyntax(
            range(start, index),
            (PrimitiveLocalDeclarationSyntax)initializerValues.first,
            condition,
            (PrimitiveAssignmentSyntax)advanceValues.first,
            body
        )
    }

    parseForEach() -> PrimitiveStatementSyntax {
        let start = index++
        if (index >= tokens.count || tokens[index].value != "(") {
            syntax("Expected foreach opening parenthesis", index)
        }
        index++
        if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) {
            syntax("Expected foreach index name", index)
        }
        let indexName = tokens[index++].value
        if (index >= tokens.count || tokens[index].value != "in") {
            syntax("Expected 'in' in foreach range", index)
        }
        index++
        let rangeStart = index
        var Int rangeOperator = -1
        var Int rangeOperatorWidth = 1
        var Int depth
        while (index < tokens.count && (tokens[index].value != ")" || depth > 0)) {
            if (tokens[index].value == "(") depth++
            else if (tokens[index].value == ")" && depth > 0) depth--
            else if (depth == 0 && tokens[index].value == "..") rangeOperator = index
            else if (depth == 0 && tokens[index].value == "." &&
                index + 1 < tokens.count && tokens[index + 1].value == ".") {
                rangeOperator = index
                rangeOperatorWidth = 2
                index++
            }
            index++
        }
        if (rangeOperator < rangeStart) {
            let collection = PrimitiveExpressionParser().parse(
                tokens.skip(rangeStart).take(index - rangeStart),
                snapshot, rangeStart + tokenIndexOffset
            )
            if (index >= tokens.count || tokens[index].value != ")") {
                syntax("Expected foreach closing parenthesis", index)
            }
            index++
            let body = parseBody()
            return PrimitiveForEachSyntax(
                range(start, index), indexName, null, null, body, collection
            )
        }
        if (rangeOperator + rangeOperatorWidth >= index) {
            syntax("Foreach requires a complete exclusive range", rangeStart)
        }
        let startValue = PrimitiveExpressionParser().parse(
            tokens.skip(rangeStart).take(rangeOperator - rangeStart),
            snapshot, rangeStart + tokenIndexOffset
        )
        let endStart = rangeOperator + rangeOperatorWidth
        let endValue = PrimitiveExpressionParser().parse(
            tokens.skip(endStart).take(index - endStart),
            snapshot, endStart + tokenIndexOffset
        )
        if (index >= tokens.count || tokens[index].value != ")") {
            syntax("Expected foreach closing parenthesis", index)
        }
        index++
        let body = parseBody()
        return PrimitiveForEachSyntax(
            range(start, index), indexName, startValue, endValue, body
        )
    }

    parseWhile() -> PrimitiveStatementSyntax {
        let start = index++
        let condition = parseCondition()
        let body = parseBody()
        return PrimitiveWhileSyntax(range(start, index), condition, body)
    }

    parseTry() -> PrimitiveStatementSyntax {
        let start = index++
        let tryValues = parseBody()
        let catches = PrimitiveCatchSyntax[]
        while (index < tokens.count && tokens[index].value == "catch") {
            let catchStart = index++
            let acceptsSoftExceptions = index < tokens.count && tokens[index].value == "all"
            if (acceptsSoftExceptions) index++
            if (index >= tokens.count || tokens[index].value != "(") syntax("Expected catch parameter", index)
            index++
            if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) syntax("Expected catch type", index)
            let typeName = tokens[index++].value
            if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) syntax("Expected catch name", index)
            let name = tokens[index++].value
            if (index >= tokens.count || tokens[index].value != ")") syntax("Expected closing catch parenthesis", index)
            index++
            let body = parseBody()
            catches.add(PrimitiveCatchSyntax(range(catchStart, index), typeName, name, body, acceptsSoftExceptions))
        }
        let finallyValues = PrimitiveStatementSyntax[]
        if (index < tokens.count && tokens[index].value == "finally") {
            index++
            finallyValues.addAll(parseBody())
        }
        if (catches.isEmpty && finallyValues.isEmpty) syntax("Try requires catch or finally", start)
        return PrimitiveTrySyntax(range(start, index), tryValues, catches, finallyValues)
    }

    parseExternal() -> PrimitiveExternalStatementSyntax {
        let start = index++
        var String target = "js"
        if (index < tokens.count && tokens[index].type == Token.Type.IDENTIFIER &&
            tokens[index].value != "{") {
            target = tokens[index++].value
        }
        if (index >= tokens.count || tokens[index].value != "{") {
            syntax("External block requires an opening brace", index)
        }
        index++
        if (index >= tokens.count || tokens[index].type != Token.Type.CODE) {
            syntax("External block requires opaque code", index)
        }
        let codeIndex = index
        let codeToken = tokens[index++]
        if (index >= tokens.count || tokens[index].value != "}") {
            syntax("External block requires a closing brace", index)
        }
        index++
        let statementRange = range(start, index)
        return PrimitiveExternalStatementSyntax(
            statementRange, target, codeToken.value,
            PrimitiveExternalCodeSegmentParser().parse(
                codeToken, statementRange, codeIndex + tokenIndexOffset
            )
        )
    }

    parseCondition() -> PrimitiveExpressionSyntax {
        if (index >= tokens.count || tokens[index].value != "(") {
            syntax("Expected opening parenthesis", index)
        }
        let open = index++
        let start = index
        var Int depth = 1
        while (index < tokens.count && depth > 0) {
            if (tokens[index].value == "(") depth++
            else if (tokens[index].value == ")") depth--
            if (depth > 0) index++
        }
        if (index >= tokens.count || depth != 0 || index == start) {
            syntax("Expected complete non-empty condition", open)
        }
        let end = index++
        // Declaration expressions require their parentheses for name/initializer ownership.
        if (tokens[start].value == "let" || tokens[start].value == "var") {
            return PrimitiveExpressionParser().parse(
                tokens.skip(open).take(index - open), snapshot, open + tokenIndexOffset)
        }
        return PrimitiveExpressionParser().parse(
            tokens.skip(start).take(end - start),
            snapshot,
            start + tokenIndexOffset
        )
    }

    parseBody() -> PrimitiveStatementSyntax[] {
        if (index >= tokens.count || tokens[index].value != "{") {
            let statementStart = index
            let line = tokens[index].location.lineNumber
            var Int braceDepth
            while (index < tokens.count && tokens[index].location.lineNumber == line) {
                let value = tokens[index].value
                if (value == "}" && braceDepth == 0) break
                if (value == "{") braceDepth++
                else if (value == "}") braceDepth--
                index++
            }
            let parsed = PrimitiveStatementParser().parse(
                tokens.skip(statementStart).take(index - statementStart), snapshot,
                statementStart + tokenIndexOffset
            ).statements()
            if (parsed.count != 1) syntax("Expected one inline control statement", statementStart)
            return [parsed.first]
        }
        index++
        return parseStatements(true)
    }

    controlStart(Int tokenIndex) -> Bool {
        if (tokenIndex >= tokens.count) return false
        let value = tokens[tokenIndex].value
        return value == "if" || value == "switch" || value == "while" || value == "for" ||
            value == "try" || value == "external"
    }

    statementStart(Int tokenIndex) -> Bool {
        if (tokenIndex >= tokens.count) return false
        let value = tokens[tokenIndex].value
        if (value == "let" || value == "var" || value == "return" ||
            value == "continue" || value == "throw" || value == "native") return true
        if (tokens[tokenIndex].type != Token.Type.IDENTIFIER ||
            tokenIndex + 1 >= tokens.count) return false
        if (value == "native_array") return true
        let next = tokens[tokenIndex + 1].value
        if (next == "[" && tokenIndex + 2 < tokens.count) {
            var Int close = tokenIndex + 2
            while (close < tokens.count && tokens[close].value != "]") close++
            return close + 1 < tokens.count && assignmentOperator(tokens[close + 1].value)
        }
        if (next == "(") return true
        if (next == "." && tokenIndex + 3 < tokens.count) {
            let memberOperator = tokens[tokenIndex + 3].value
            return memberOperator == "(" || memberOperator == "=" || memberOperator == "+=" || memberOperator == "-=" ||
                memberOperator == "*=" || memberOperator == "/=" || memberOperator == "%="
        }
        return next == "=" || next == "+=" || next == "-=" || next == "*=" ||
            next == "/=" || next == "%=" || next == "++" || next == "--"
    }

    assignmentOperator(String value) -> Bool =>
        value == "=" || value == "+=" || value == "-=" || value == "*=" ||
            value == "/=" || value == "%="

    expressionContinuation(String value) -> Bool =>
        value == "=" || value == "." || value == "," || value == "return" ||
        value == "+" || value == "-" || value == "*" || value == "/" ||
        value == "%" || value == "&&" || value == "||" || value == "?" ||
        value == ":" || value == "==" || value == "!=" || value == "<" ||
        value == ">" || value == "<=" || value == ">=" || assignmentOperator(value)

    parseSimple() -> PrimitiveStatementSyntax {
        let start = index
        let line = tokens[start].location.lineNumber
        var Int braceDepth
        var Int parenthesisDepth
        var Int bracketDepth
        while (index < tokens.count) {
            let value = tokens[index].value
            if (braceDepth == 0 && parenthesisDepth == 0 && bracketDepth == 0 && (value == ";" || value == "}" ||
                (tokens[index].location.lineNumber > line && index > start &&
                    !expressionContinuation(tokens[index - 1].value) &&
                    (controlStart(index) || statementStart(index))))) break
            if (value == "{") braceDepth++
            else if (value == "}") braceDepth--
            else if (value == "(") parenthesisDepth++
            else if (value == ")") parenthesisDepth--
            else if (value == "[") bracketDepth++
            else if (value == "]") bracketDepth--
            index++
        }
        if (index == start) {
            syntax("Expected statement", start)
        }
        let terminated = index < tokens.count && tokens[index].value == ";"
        let boundary = index >= tokens.count || tokens[index].value == "}" ||
            (tokens[index].location.lineNumber > line &&
                (controlStart(index) || statementStart(index)))
        if (!terminated && !boundary) {
            syntax("Expected terminated statement", start)
        }
        let result = PrimitiveStatementParser().parse(
            tokens.skip(start).take(index - start),
            snapshot,
            start + tokenIndexOffset
        )
        if (terminated) index++
        return result.statements().first
    }

    range(Int start, Int end) -> SourceRange {
        let first = tokens[start]
        let last = tokens[end - 1]
        return SourceRange(
            snapshot,
            start + tokenIndexOffset,
            end + tokenIndexOffset,
            first.location,
            Location(lineNumber: last.endLineNumber, column: last.endColumn)
        )
    }

    syntax(String message, Int tokenIndex) {
        throw Exception("Primitive control syntax error at token #tokenIndex: #message")
    }
}
