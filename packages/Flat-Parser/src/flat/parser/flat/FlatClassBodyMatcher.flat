package flat/parser/flat

import flat/parser
import flat/parser/matchers
import flat/compiler/models/Token
import flat/datastruct/list/Stack

/** Internal grammar probe used to locate proven class-body member boundaries. */
class {
    public inspect(Token[] tokens) -> FlatClassBodyMatch {
        if (tokens.isEmpty) return FlatClassBodyMatch()

        let group = grammarMatch(tokens)
        if (!group) return FlatClassBodyMatch()

        let counts = Int[]
        var Int pendingMetadataTokenCount
        for (span in group.directSpans) {
            pendingMetadataTokenCount += span.tokenCount
            if (span.parserName != AnnotationParser.class.name) {
                counts.add(pendingMetadataTokenCount)
                pendingMetadataTokenCount = 0
            }
        }

        return FlatClassBodyMatch(
            group.tokens.count,
            counts,
            group.tokens.count == tokens.count
        )
    }

    /**
     * Classifies only a pending header that the existing class-body grammar
     * accepts once supplied with the opening brace and a minimal valid body.
     * No token-shape heuristic is used by the mixed-member coordinator.
     */
    public classifyPendingBraced(Token[] headerTokens) -> PendingBracedMemberClassification {
        if (headerTokens.isEmpty) return null

        let normalizedHeader = Token[]
        var Int index
        while (index < headerTokens.count) {
            let token = headerTokens[index]
            if (token.value != "native_array" && token.value != "native") {
                normalizedHeader.add(token)
            }
            index++
        }
        let candidates = [
            pendingTokens(normalizedHeader, ["{", "}"]),
            pendingTokens(normalizedHeader, ["Bool", "{", "}"])
        ]
        for (candidate in candidates) {
            let group = grammarMatch(candidate)
            if (!group || group.tokens.count != candidate.count) continue

            let spans = group.directSpans.filter({
                _.parserName != AnnotationParser.class.name
            })
            if (spans.count != 1) continue

            let parserName = spans.first.parserName
            if (parserName == FunctionParser.class.name) {
                return PendingBracedMemberClassification(
                    PendingBracedMemberClassification.FUNCTION,
                    parserName
                )
            }
            if (parserName == StaticBlockParser.class.name) {
                return PendingBracedMemberClassification(
                    PendingBracedMemberClassification.STATIC_BLOCK,
                    parserName
                )
            }
        }
        return null
    }

    pendingTokens(Token[] headerTokens, String[] suffix) -> Token[] {
        let values = Token[]
        values.addAll(headerTokens)
        let location = headerTokens.last.location
        for (value in suffix) {
            let type = value == "Bool" ? Token.Type.IDENTIFIER : Token.Type.SYMBOL
            values.add(Token(value: value, type: type, location: location))
        }
        return values
    }

    grammarMatch(Token[] tokens) -> NodeGroupTokenMatch {
        let pattern = NodeGroupTokenPattern(ClassParser().classBodyParsers)
        let matcher = pattern.getMatcher()
        let classParser = ClassParser()
        let result = matcher.matchAll(
            tokens,
            ParseContext(
                parserStack: Stack():push(classParser),
                currentBaseParser: classParser
            )
        ).lastWhere({ _ != null })
        if (!result) return null
        return (NodeGroupTokenMatch)result
    }
}
