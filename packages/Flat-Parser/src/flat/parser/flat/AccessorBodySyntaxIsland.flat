package flat/parser/flat

import flat/parser/SyntaxIsland
import flat/compiler/models

/** Immutable end-exclusive accessor body range linked to its accessor signature. */
data class extends SyntaxIsland {
    visible SyntaxIslandIdentity containingTypeIdentity
    visible SyntaxIslandIdentity memberHeaderIdentity
    visible SyntaxIslandIdentity accessorHeaderIdentity
    visible String accessorKind
}
