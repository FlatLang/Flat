package flat/parser/flat

import flat/compiler/models

/** Source-ranged syntax-only parser for the first primitive expression slice. */
class {
    var Token[] tokens
    var Int index
    var Int tokenIndexOffset
    var SourceRange containingRange
    var SourceSnapshotIdentity snapshot

    public parse(
        Token[] tokenValues,
        SourceSnapshotIdentity sourceSnapshot,
        Int sourceTokenIndexOffset = 0,
        SourceRange expressionContainingRange = null
    ) -> PrimitiveExpressionSyntax {
        if (!tokenValues || tokenValues.isEmpty || !sourceSnapshot) {
            throw Exception("Primitive expression parsing requires tokens and snapshot")
        }
        tokens = tokenValues.filter({
            let type = _.type
            return type != Token.Type.WHITESPACE && type != Token.Type.COMMENT
        })
        snapshot = sourceSnapshot
        tokenIndexOffset = sourceTokenIndexOffset
        containingRange = expressionContainingRange
        index = 0
        let expression = parseConditional()
        if (index != tokens.count) syntax("Unexpected token '#{tokens[index].value}'", index)
        return expression
    }

    parseConditional() -> PrimitiveExpressionSyntax {
        let start = index
        let condition = parseLevel(0)
        if (index >= tokens.count || tokens[index].value != "?") return condition
        index++
        let whenTrue = parseLevel(0)
        if (index >= tokens.count || tokens[index].value != ":") {
            syntax("Expected ':' in conditional expression", index)
        }
        index++
        let whenFalse = parseLevel(0)
        return PrimitiveConditionalSyntax(
            range(start, index),
            condition, whenTrue, whenFalse
        )
    }

    parseLevel(Int level) -> PrimitiveExpressionSyntax {
        if (level >= 6) return parseUnary()
        var PrimitiveExpressionSyntax left = parseLevel(level + 1)
        let operators = operatorsFor(level)
        while (index < tokens.count && operators.contains(tokens[index].value)) {
            let operator = tokens[index++].value
            let right = parseLevel(level + 1)
            let expressionRange = range(left.range.startTokenIndex - tokenIndexOffset,
                index)
            left = PrimitiveBinarySyntax(expressionRange, operator, left, right)
        }
        return left
    }

    operatorsFor(Int level) -> String[] {
        match level {
            0 => return ["||"]
            1 => return ["&&"]
            2 => return ["==", "!="]
            3 => return ["<", "<=", ">", ">="]
            4 => return ["+", "-"]
            5 => return ["*", "/", "%"]
        }
        return String[]
    }

    parseUnary() -> PrimitiveExpressionSyntax {
        if (index < tokens.count) {
            let unaryOperators = ["!", "+", "-", "~"]
            if (unaryOperators.contains(tokens[index].value)) {
                let start = index
                let operator = tokens[index++].value
                let operand = parseUnary()
                return PrimitiveUnarySyntax(
                    range(start, index),
                    operator,
                    operand
                )
            }
        }
        return parsePrimary()
    }

    assignmentOperator(String value) -> Bool =>
        value == "+=" || value == "-=" || value == "*=" || value == "/=" || value == "%="

    parsePrimary() -> PrimitiveExpressionSyntax {
        if (index >= tokens.count) syntax("Expected primitive expression", index)
        if (tokens[index].value == "(") {
            let start = index++
            if (index + 2 < tokens.count && tokens[index].value == "let" &&
                tokens[index + 1].type == Token.Type.IDENTIFIER &&
                tokens[index + 2].value == "=") {
                index++
                let name = tokens[index++].value
                index++
                let value = parseConditional()
                if (index >= tokens.count || tokens[index].value != ")") {
                    syntax("Expected closing declaration expression parenthesis", index)
                }
                index++
                return PrimitiveDeclarationValueSyntax(range(start, index), name, value)
            }
            if (index + 1 < tokens.count && tokens[index].type == Token.Type.IDENTIFIER &&
                tokens[index + 1].value == ")") {
                let typeName = tokens[index++].value
                index++
                let value = parseUnary()
                return PrimitiveCastSyntax(
                    range(start, index), typeName, value
                )
            }
            var PrimitiveExpressionSyntax expression = parseConditional()
            if (index < tokens.count && tokens[index].value == "=" &&
                expression.class.isOfType(PrimitiveReferenceSyntax.class)) {
                index++
                let value = parseConditional()
                expression = (PrimitiveExpressionSyntax)PrimitiveAssignmentValueSyntax(
                    range(start + 1, index),
                    ((PrimitiveReferenceSyntax)expression).name, value
                )
            } else if (index < tokens.count && assignmentOperator(tokens[index].value) &&
                expression.class.isOfType(PrimitiveMemberAccessSyntax.class)) {
                let operator = tokens[index++].value
                let value = parseConditional()
                let assignment = PrimitiveMemberAssignmentValueSyntax(
                    range(start + 1, index),
                    (PrimitiveMemberAccessSyntax)expression,
                    operator,
                    value
                )
                expression = (PrimitiveExpressionSyntax)assignment
            }
            if (index >= tokens.count || tokens[index].value != ")") {
                syntax("Expected closing expression parenthesis", index)
            }
            index++
            if (expression.class.isOfType(PrimitiveConditionalSyntax.class)) {
                let conditional = (PrimitiveConditionalSyntax)expression
                return PrimitiveConditionalSyntax(
                    range(start, index), conditional.condition,
                    conditional.whenTrue, conditional.whenFalse
                )
            }
            return expression
        }
        if (tokens[index].value == "[") return parseArray()
        if (tokens[index].value == "{") {
            let start = index++
            let body = parseConditional()
            if (index >= tokens.count || tokens[index].value != "}") {
                syntax("Expected closing implicit lambda brace", index)
            }
            index++
            return PrimitiveLambdaSyntax(
                range(start, index), PrimitiveFunctionParameterSyntax[], body
            )
        }
        let tokenIndex = index
        let token = tokens[index++]
        if (token.value == "native") return parseNative(tokenIndex)
        if (token.value == "async") {
            if (index >= tokens.count || tokens[index].value != "(") syntax("Expected async expression", index)
            index++
            let canonical = parseLevel(0)
            if (index >= tokens.count || tokens[index].value != ")") syntax("Expected closing async parenthesis", index)
            index++
            return PrimitiveRichCollectionSyntax(range(tokenIndex, index), "async", canonical)
        }
        if (token.value == "range" || token.value == "safe" || token.value == "match") {
            let kind = token.value == "safe" ? "safe-access" : token.value
            if (index >= tokens.count || tokens[index].value != "(") syntax("Expected rich form expression", index)
            index++
            let canonical = parseLevel(0)
            if (index >= tokens.count || tokens[index].value != ")") syntax("Expected closing rich form parenthesis", index)
            index++
            return PrimitiveRichCollectionSyntax(range(tokenIndex, index), kind, canonical)
        }
        if (token.value == "named") return parseNamedCall(tokenIndex)
        if (token.value == "lambda") return parseLambda(tokenIndex)
        if (token.value == "ref") return parseFunctionReference(tokenIndex)
        if (token.value == "new") {
            if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) {
                syntax("Expected constructed type name", index)
            }
            let typeName = tokens[index++].value
            if (index < tokens.count && tokens[index].value == "[") {
                index++
                let size = parseConditional()
                if (index >= tokens.count || tokens[index].value != "]") {
                    syntax("Expected closing array construction bracket", index)
                }
                index++
                return PrimitiveArrayConstructionSyntax(
                    range(tokenIndex, index), typeName, size
                )
            }
            if (index >= tokens.count || tokens[index].value != "(") {
                syntax("Expected constructor arguments", index)
            }
            let call = (PrimitiveCallSyntax)parseCall(start: tokenIndex, name: typeName)
            return PrimitiveConstructionSyntax(call.range, typeName, call.argumentValues())
        }
        if (token.type == Token.Type.IDENTIFIER) {
            if (index + 1 < tokens.count && tokens[index].value == "[" &&
                tokens[index + 1].value == "]") {
                index += 2
                return parsePostfix(tokenIndex, PrimitiveEmptyArrayConstructionSyntax(
                    range(tokenIndex, index), token.value
                ), true)
            }
            if (token.value == "Array" && index < tokens.count &&
                tokens[index].value == "<") {
                index++
                if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) {
                    syntax("Expected array element type", index)
                }
                let elementTypeName = tokens[index++].value
                if (index >= tokens.count || tokens[index].value != ">") {
                    syntax("Expected closing array element type", index)
                }
                index++
                if (index >= tokens.count || tokens[index].value != "(") {
                    syntax("Expected array allocation size", index)
                }
                index++
                if (index < tokens.count && tokens[index].value == ")") {
                    index++
                    return parsePostfix(tokenIndex, PrimitiveEmptyArrayConstructionSyntax(
                        range(tokenIndex, index), elementTypeName
                    ), true)
                }
                let size = parseConditional()
                if (index >= tokens.count || tokens[index].value != ")") {
                    syntax("Expected closing array allocation parenthesis", index)
                }
                index++
                return parsePostfix(tokenIndex, PrimitiveArrayConstructionSyntax(
                    range(tokenIndex, index), elementTypeName, size
                ))
            }
            var PrimitiveExpressionSyntax expression
            if (index < tokens.count && tokens[index].value == "(") {
                expression = parseCall(tokenIndex, token.value)
            } else expression = PrimitiveReferenceSyntax(
                range(tokenIndex, tokenIndex + 1), token.value
            )
            while (index < tokens.count && (tokens[index].value == "." || tokens[index].value == "[")) {
                if (tokens[index].value == "[") {
                    index++
                    let accessIndex = parseLevel(0)
                    if (index >= tokens.count || tokens[index].value != "]") {
                        syntax("Expected closing array bracket", index)
                    }
                    index++
                    expression = PrimitiveArrayAccessSyntax(
                        range(tokenIndex, index), expression, accessIndex
                    )
                    continue
                }
                index++
                if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) {
                    syntax("Expected member name after '.'", index)
                }
                let member = tokens[index++].value
                if (index < tokens.count && tokens[index].value == "(") {
                    index++
                    let arguments = PrimitiveExpressionSyntax[]
                    let namedArguments = PrimitiveMixedNamedArgumentSyntax[]
                    if (index < tokens.count && tokens[index].value != ")") {
                        while (true) {
                            if (tokens[index].type == Token.Type.IDENTIFIER &&
                                index + 1 < tokens.count && tokens[index + 1].value == ":") {
                                let argumentStart = index
                                let argumentName = tokens[index++].value
                                index++
                                let argumentValue = parseConditional()
                                namedArguments.add(PrimitiveMixedNamedArgumentSyntax(
                                    range(argumentStart, index),
                                    argumentName, argumentValue
                                ))
                            } else {
                                if (namedArguments.isNotEmpty) {
                                    syntax("Positional member argument cannot follow a named argument", index)
                                }
                                arguments.add(parseConditional())
                            }
                            if (index >= tokens.count || tokens[index].value == ")") break
                            if (tokens[index].value != ",") {
                                syntax("Expected member call argument boundary", index)
                            }
                            index++
                        }
                    }
                    if (index >= tokens.count || tokens[index].value != ")") {
                        syntax("Expected closing member call parenthesis", index)
                    }
                    index++
                    expression = PrimitiveMemberCallSyntax(
                        range(tokenIndex, index), expression, member, arguments,
                        namedArguments
                    )
                } else expression = PrimitiveMemberAccessSyntax(
                    range(tokenIndex, index), expression, member
                )
            }
            if (expression.class.isOfType(PrimitiveMemberAccessSyntax.class)) {
                let nameAccess = (PrimitiveMemberAccessSyntax)expression
                if (nameAccess.memberName == "name" &&
                    nameAccess.receiver.class.isOfType(PrimitiveMemberAccessSyntax.class)) {
                    let classAccess = (PrimitiveMemberAccessSyntax)nameAccess.receiver
                    if (classAccess.memberName == "class") {
                        return PrimitiveClassNameSyntax(expression.range, classAccess.receiver)
                    }
                }
            }
            return expression
        }
        if (token.type == Token.Type.STRING) {
            var PrimitiveExpressionSyntax expression
            if (!hasInterpolationMarker(token.value)) {
                expression = PrimitiveLiteralSyntax(
                    range(tokenIndex, tokenIndex + 1), token.type, token.value
                )
            } else expression = PrimitiveInterpolatedStringParser().parse(
                token, snapshot, tokenIndex + tokenIndexOffset
            ).expression
            return parsePostfix(tokenIndex, expression)
        }
        if (token.type != Token.Type.INTEGER && token.type != Token.Type.FLOAT &&
            token.type != Token.Type.BOOL &&
            token.type != Token.Type.STRING && token.type != Token.Type.CHAR &&
            token.type != Token.Type.NULL) {
            syntax("Expected primitive literal or identifier but received '#{token.value}'", tokenIndex)
        }
        return PrimitiveLiteralSyntax(
            range(tokenIndex, tokenIndex + 1), token.type, token.value
        )
    }

    parsePostfix(
        Int tokenIndex,
        PrimitiveExpressionSyntax initial,
        Bool colonCall = false
    ) -> PrimitiveExpressionSyntax {
        var PrimitiveExpressionSyntax expression = initial
        while (index < tokens.count && (tokens[index].value == "." ||
            (colonCall && tokens[index].value == ":") || tokens[index].value == "[")) {
            if (tokens[index].value == "[") {
                index++
                let accessIndex = parseLevel(0)
                if (index >= tokens.count || tokens[index].value != "]") {
                    syntax("Expected closing array bracket", index)
                }
                index++
                expression = PrimitiveArrayAccessSyntax(
                    range(tokenIndex, index), expression, accessIndex
                )
                continue
            }
            if (tokens[index].value == ":") index++
            else index++
            if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) {
                syntax("Expected member name after '.'", index)
            }
            let member = tokens[index++].value
            if (index < tokens.count && tokens[index].value == "(") {
                index++
                if (index < tokens.count && tokens[index].value == ")") {
                    index++
                    expression = PrimitiveMemberCallSyntax(
                        range(tokenIndex, index), expression, member,
                        PrimitiveExpressionSyntax[]
                    )
                    continue
                }
                let arguments = PrimitiveExpressionSyntax[]
                let namedArguments = PrimitiveMixedNamedArgumentSyntax[]
                if (index < tokens.count && tokens[index].value != ")") {
                    while (true) {
                        if (tokens[index].type == Token.Type.IDENTIFIER &&
                            index + 1 < tokens.count && tokens[index + 1].value == ":") {
                            let argumentStart = index
                            let argumentName = tokens[index++].value
                            index++
                            let argumentValue = parseConditional()
                            namedArguments.add(PrimitiveMixedNamedArgumentSyntax(
                                range(argumentStart, index),
                                argumentName, argumentValue
                            ))
                        } else {
                            if (namedArguments.isNotEmpty) {
                                syntax("Positional member argument cannot follow a named argument", index)
                            }
                            arguments.add(parseConditional())
                        }
                        if (index >= tokens.count || tokens[index].value == ")") break
                        if (tokens[index].value != ",") {
                            syntax("Expected member call argument boundary", index)
                        }
                        index++
                    }
                }
                if (index >= tokens.count || tokens[index].value != ")") {
                    syntax("Expected closing member call parenthesis", index)
                }
                index++
                expression = PrimitiveMemberCallSyntax(
                    range(tokenIndex, index), expression, member, arguments,
                    namedArguments
                )
            } else expression = PrimitiveMemberAccessSyntax(
                range(tokenIndex, index), expression, member
            )
        }
        return expression
    }

    parseNative(Int start) -> PrimitiveExpressionSyntax {
        if (index >= tokens.count || tokens[index].value != "[") syntax("Expected native target annotation", index)
        index++
        if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) syntax("Expected native target", index)
        let target = tokens[index++].value
        if (index >= tokens.count || tokens[index].value != "]") syntax("Expected closing native target annotation", index)
        index++
        if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) syntax("Expected native name", index)
        var String name = tokens[index++].value
        while (index < tokens.count && tokens[index].value == ".") {
            index++
            if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) syntax("Expected qualified native component", index)
            name += "." + tokens[index++].value
        }
        if (index >= tokens.count || tokens[index].value != "(") syntax("Expected native arguments", index)
        let call = (PrimitiveCallSyntax)parseCall(start: start, name: name)
        return PrimitiveNativeSyntax(call.range, target, name, call.argumentValues())
    }

    parseNamedCall(Int start) -> PrimitiveExpressionSyntax {
        if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) {
            syntax("Expected named call target", index)
        }
        let name = tokens[index++].value
        if (index >= tokens.count || tokens[index].value != "(") syntax("Expected named arguments", index)
        index++
        let values = PrimitiveNamedArgumentSyntax[]
        while (index < tokens.count && tokens[index].value != ")") {
            let argumentStart = index
            if (tokens[index].type != Token.Type.IDENTIFIER) syntax("Expected named argument name", index)
            let argumentName = tokens[index++].value
            if (values.any({ _.name == argumentName })) syntax("Duplicate named argument", argumentStart)
            if (index >= tokens.count || tokens[index].value != ":") syntax("Expected ':' after named argument", index)
            index++
            let value = parseLevel(0)
            values.add(PrimitiveNamedArgumentSyntax(range(argumentStart, index), argumentName, value))
            if (index >= tokens.count || tokens[index].value != ",") break
            index++
        }
        if (index >= tokens.count || tokens[index].value != ")") syntax("Expected closing named call parenthesis", index)
        index++
        return PrimitiveNamedCallSyntax(range(start, index), name, values)
    }

    parseLambda(Int start) -> PrimitiveExpressionSyntax {
        if (index >= tokens.count || tokens[index].value != "(") syntax("Expected lambda parameters", index)
        index++
        let parameters = PrimitiveFunctionParameterSyntax[]
        if (index < tokens.count && tokens[index].value != ")") {
            while (true) {
                let parameterStart = index
                if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) syntax("Expected lambda parameter type", index)
                let typeName = tokens[index++].value
                if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) syntax("Expected lambda parameter name", index)
                let name = tokens[index++].value
                if (parameters.any({ _.name == name })) syntax("Duplicate lambda parameter", parameterStart)
                parameters.add(PrimitiveFunctionParameterSyntax(range(parameterStart, index), typeName, name))
                if (index >= tokens.count || tokens[index].value != ",") break
                index++
            }
        }
        if (index >= tokens.count || tokens[index].value != ")") syntax("Expected closing lambda parenthesis", index)
        index++
        if (index >= tokens.count || tokens[index].value != "=>") syntax("Expected lambda arrow", index)
        index++
        let body = parseLevel(0)
        return PrimitiveLambdaSyntax(range(start, index), parameters, body)
    }

    parseFunctionReference(Int start) -> PrimitiveExpressionSyntax {
        if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) {
            syntax("Expected referenced function name", index)
        }
        let name = tokens[index++].value
        return PrimitiveFunctionReferenceSyntax(range(start, index), name)
    }

    parseArray() -> PrimitiveExpressionSyntax {
        let start = index++
        let values = PrimitiveExpressionSyntax[]
        if (index < tokens.count && tokens[index].value == "]") {
            syntax("Array literal requires at least one element", index)
        }
        while (true) {
            values.add(parseLevel(0))
            if (index >= tokens.count) syntax("Expected closing array bracket", index)
            if (tokens[index].value == "]") {
                index++
                return PrimitiveArraySyntax(range(start, index), values)
            }
            if (tokens[index].value != ",") syntax("Expected array element separator", index)
            index++
            if (index >= tokens.count || tokens[index].value == "]") {
                syntax("Expected array element after ','", index)
            }
        }
    }

    parseCall(Int start, String name) -> PrimitiveExpressionSyntax {
        index++
        let arguments = PrimitiveExpressionSyntax[]
        let namedArguments = PrimitiveMixedNamedArgumentSyntax[]
        if (index < tokens.count && tokens[index].value == ")") {
            index++
            return PrimitiveCallSyntax(range(start, index), name, arguments, namedArguments)
        }
        while (true) {
            if (index >= tokens.count) syntax("Expected closing call parenthesis", index)
            if (tokens[index].type == Token.Type.IDENTIFIER &&
                index + 1 < tokens.count && tokens[index + 1].value == ":") {
                let argumentStart = index
                let argumentName = tokens[index++].value
                index++
                if (arguments.isEmpty && namedArguments.isNotEmpty) {
                    syntax("Named arguments must use one call form", argumentStart)
                }
                let value = parseLevel(0)
                namedArguments.add(PrimitiveMixedNamedArgumentSyntax(
                    range(argumentStart, index),
                    argumentName, value
                ))
            } else {
                if (namedArguments.isNotEmpty) {
                    syntax("Positional argument cannot follow a named argument", index)
                }
                arguments.add(parseLevel(0))
            }
            if (index >= tokens.count) syntax("Expected closing call parenthesis", index)
            if (tokens[index].value == ")") {
                index++
                return PrimitiveCallSyntax(
                    range(start, index), name, arguments, namedArguments
                )
            }
            if (tokens[index].value != ",") {
                syntax("Expected ',' or ')' after call argument", index)
            }
            index++
            if (index >= tokens.count || tokens[index].value == ")") {
                syntax("Expected call argument after ','", index)
            }
        }
    }

    hasInterpolationMarker(String value) -> Bool {
        var Int index
        while (index < value.count) {
            if (value.chars[index] == '#') return true
            index++
        }
        return value.isEmpty
    }

    range(Int startIndex, Int endIndex) -> SourceRange {
        let start = tokens[startIndex].location
        let last = tokens[endIndex - 1]
        let sourceStartIndex = startIndex + tokenIndexOffset
        let sourceEndIndex = endIndex + tokenIndexOffset
        return SourceRange(
            snapshot,
            containingRange ? containingRange.startTokenIndex : sourceStartIndex,
            containingRange ? containingRange.endTokenIndex : sourceEndIndex,
            start,
            Location(lineNumber: last.endLineNumber, column: last.endColumn)
        )
    }

    syntax(String message, Int tokenIndex) {
        throw Exception("Primitive expression syntax error at token #tokenIndex: #message")
    }
}
