package flat/parser/flat

import flat/compiler/models

/** Source-ranged syntax-only parser for the first primitive expression slice. */
class {
    var Token[] sourceSlice
    var Token[] tokens
    var Int index
    var Bool expectsConditionalSeparator
    var Int tokenIndexOffset
    var SourceRange containingRange
    var SourceSnapshotIdentity snapshot

    public parse(
        Token[] tokenValues,
        SourceSnapshotIdentity sourceSnapshot,
        Int sourceTokenIndexOffset = 0,
        SourceRange expressionContainingRange = null
    ) -> PrimitiveExpressionSyntax {
        if (!tokenValues || tokenValues.isEmpty || !sourceSnapshot) {
            throw Exception("Primitive expression parsing requires tokens and snapshot")
        }
        sourceSlice = tokenValues
        tokens = tokenValues.filter({
            let type = _.type
            return type != Token.Type.WHITESPACE && type != Token.Type.COMMENT
        })
        snapshot = sourceSnapshot
        tokenIndexOffset = sourceTokenIndexOffset
        containingRange = expressionContainingRange
        index = 0
        expectsConditionalSeparator = false
        var Token suffix
        if (tokens.count > 0 && tokens.last.value == "$") {
            suffix = tokens.last
            tokens = tokens.take(tokens.count - 1)
            if (tokens.isEmpty) syntax("Postfix $ requires an identifier or call", 0)
        }
        var PrimitiveExpressionSyntax expression = parseConditional()
        if (index < tokens.count && tokens[index].value == "=" && expression.class.isOfType(PrimitiveArrayAccessSyntax.class)) {
            index++
            let operand = parseConditional()
            expression = (PrimitiveExpressionSyntax)PrimitiveIndexedAssignmentValueSyntax(range(0, index), (PrimitiveArrayAccessSyntax)expression, operand)
        }
        if (index != tokens.count) syntax("Unexpected token '#{tokens[index].value}'", index)
        if (suffix) {
            let suffixRange = SourceRange(snapshot, expression.range.startTokenIndex,
                tokens.count + 1 + tokenIndexOffset, expression.range.start,
                Location(lineNumber: suffix.endLineNumber, column: suffix.endColumn))
            if (expression.class.isOfType(PrimitiveCallSyntax.class)) {
                let call = (PrimitiveCallSyntax)expression
                expression = PrimitiveCallSyntax(suffixRange, call.name, call.argumentValues(),
                    call.namedArgumentValues(), true)
            } else if (expression.class.isOfType(PrimitiveMemberCallSyntax.class)) {
                let call = (PrimitiveMemberCallSyntax)expression
                expression = PrimitiveMemberCallSyntax(suffixRange, call.receiver, call.memberName,
                    call.argumentValues(), call.namedArgumentValues(), call.typeArgumentNames(),
                    call.safeAccess, true)
            } else if (expression.class.isOfType(PrimitiveReferenceSyntax.class)) {
                let reference = (PrimitiveReferenceSyntax)expression
                expression = PrimitiveReferenceSyntax(suffixRange, reference.name, true)
            } else syntax("Postfix $ requires an identifier or call", tokens.count)
        }
        return expression
    }

    safeMemberOperator() -> Bool => index < tokens.count &&
        (tokens[index].value == "?." || (tokens[index].value == "?" &&
            index + 1 < tokens.count && tokens[index + 1].value == "."))

    consumeMemberOperator() -> Bool {
        let safe = safeMemberOperator()
        if (safe && tokens[index].value == "?") index++
        index++
        return safe
    }

    parseConditional(Bool beforeSeparator = false) -> PrimitiveExpressionSyntax {
        let enclosing = expectsConditionalSeparator
        expectsConditionalSeparator = beforeSeparator
        let start = index
        let condition = parseLevel(0)
        expectsConditionalSeparator = enclosing
        if (index < tokens.count && tokens[index].value == "?:") {
            index++
            let fallback = parseConditional(beforeSeparator)
            return PrimitiveBinarySyntax(range(start, index), "?:", condition, fallback)
        }
        if (index >= tokens.count || tokens[index].value != "?") return condition
        index++
        let whenTrue = parseConditional(true)
        if (index >= tokens.count || tokens[index].value != ":") {
            syntax("Expected ':' in conditional expression", index)
        }
        index++
        let whenFalse = parseConditional(beforeSeparator)
        return PrimitiveConditionalSyntax(
            range(start, index),
            condition, whenTrue, whenFalse
        )
    }

    parseLevel(Int level) -> PrimitiveExpressionSyntax {
        if (level >= 6) return parseUnary()
        // Keep the local cursor: interpolation nodes share one containing token range,
        // which cannot be converted back into an expression-token cursor.
        let start = index
        var PrimitiveExpressionSyntax left = parseLevel(level + 1)
        let operators = operatorsFor(level)
        while (index < tokens.count && operators.contains(tokens[index].value)) {
            let operator = tokens[index++].value
            let right = parseLevel(level + 1)
            let expressionRange = range(start, index)
            left = PrimitiveBinarySyntax(expressionRange, operator, left, right)
        }
        return left
    }

    operatorsFor(Int level) -> String[] {
        match level {
            0 => return ["||"]
            1 => return ["&&"]
            2 => return ["==", "!="]
            3 => return ["<", "<=", ">", ">="]
            4 => return ["+", "-"]
            5 => return ["*", "/", "%"]
        }
        return String[]
    }

    parseUnary() -> PrimitiveExpressionSyntax {
        if (index < tokens.count) {
            let unaryOperators = ["!", "+", "-", "~", "++", "--"]
            if (unaryOperators.contains(tokens[index].value)) {
                let start = index
                let operator = tokens[index++].value
                let operand = parseUnary()
                return PrimitiveUnarySyntax(
                    range(start, index),
                    operator,
                    operand
                )
            }
        }
        return parsePrimary()
    }

    binaryOnlyOperator(String value) -> Bool {
        if (value == "+" || value == "-") return false
        var Int level
        while (level < 6) {
            if (operatorsFor(level).contains(value)) return true
            level++
        }
        return false
    }

    assignmentOperator(String value) -> Bool =>
        value == "+=" || value == "-=" || value == "*=" || value == "/=" || value == "%="

    requireIfToken(String value) {
        if (index >= tokens.count || tokens[index].value != value) {
            syntax("Expected '#value' in if expression", index)
        }
        index++
    }

    parseIfBranch() -> PrimitiveExpressionSyntax {
        requireIfToken("{")
        if (index < tokens.count && tokens[index].value == "throw") {
            let start = index++
            if (index >= tokens.count || tokens[index].value == "}") syntax("Throw arm requires a value", start)
            let operand = parseConditional()
            let arm = PrimitiveThrowArmSyntax(range(start, index), operand)
            requireIfToken("}")
            return arm
        }
        let value = parseConditional()
        requireIfToken("}")
        return value
    }

    // A slash starts a pattern only when the expression grammar needs an operand.
    // Read the original slice here: filtering trivia inside a pattern changes it.
    parseRegex() -> PrimitiveExpressionSyntax {
        let start = index
        // Slices from declaration parsers may already exclude trivia. Never
        // invent missing pattern characters from column distances.
        var Int raw = index
        while (raw < sourceSlice.count && sourceSlice[raw].location != tokens[index].location) raw++
        let rawStart = raw
        var Int column = tokens[index].endColumn
        let line = tokens[index].location.lineNumber
        index++
        raw++
        var Bool escaped
        var Bool inClass
        var String pattern = ""
        while (raw < sourceSlice.count) {
            let token = sourceSlice[raw++]
            if (token.location.lineNumber != line || token.endLineNumber != line) break
            if (token.location.column != column) syntax("Missing source text in regex literal", index)
            column = token.endColumn
            if (token.type != Token.Type.WHITESPACE && token.type != Token.Type.COMMENT) index++
            if (!escaped && !inClass && token.value == "/") {
                var String flags = ""
                if (index < tokens.count && tokens[index].location.lineNumber == line &&
                    tokens[index].location.column == column && tokens[index].type == Token.Type.IDENTIFIER) {
                    flags = tokens[index++].value
                    for (i in 0..flags.count) {
                        let letter = flags.substring(i, i + 1)
                        if (!"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(letter)) {
                            syntax("Expected letters in regex flags", index - 1)
                        }
                    }
                }
                let literalRange = range(start, index)
                var SourceRange regexRange = literalRange
                if (!containingRange) {
                    if (flags.isNotEmpty) raw++
                    regexRange = SourceRange(snapshot, tokenIndexOffset + rawStart, tokenIndexOffset + raw,
                        literalRange.start, literalRange.end)
                }
                return parsePostfix(start, PrimitiveRegexSyntax(regexRange, pattern, flags))
            }
            var Int characterIndex = 0
            while (characterIndex < token.value.count) {
                let c = token.value.substring(characterIndex, characterIndex + 1)
                characterIndex++
                if (escaped) escaped = false
                else if (c == "\\") escaped = true
                else if (c == "[") inClass = true
                else if (c == "]") inClass = false
                else if (!inClass && c == "/") syntax("Regex delimiter is not a separate token", start)
            }
            pattern += token.value
        }
        syntax("Unterminated regex literal", start)
        return null
    }

    // Parse the false arm recursively without consuming postfixes belonging to the whole chain.
    parseIfValue() -> PrimitiveConditionalSyntax {
        let start = index++
        requireIfToken("(")
        let condition = parseConditional()
        requireIfToken(")")
        let whenTrue = parseIfBranch()
        requireIfToken("else")
        var PrimitiveExpressionSyntax whenFalse
        if (index < tokens.count && tokens[index].value == "if") whenFalse = parseIfValue()
        else whenFalse = parseIfBranch()
        return PrimitiveConditionalSyntax(range(start, index), condition, whenTrue, whenFalse)
    }

    parsePrimary() -> PrimitiveExpressionSyntax {
        if (index >= tokens.count) syntax("Expected primitive expression", index)
        if (tokens[index].value == "/") return parseRegex()
        if (tokens[index].value == "if") {
            let start = index
            return parsePostfix(start, parseIfValue())
        }
        if (tokens[index].value == "(") {
            let start = index++
            if (index + 2 < tokens.count && tokens[index].value == "let" &&
                tokens[index + 1].type == Token.Type.IDENTIFIER &&
                tokens[index + 2].value == "=") {
                index++
                let name = tokens[index++].value
                index++
                let value = parseConditional()
                if (index >= tokens.count || tokens[index].value != ")") {
                    syntax("Expected closing declaration expression parenthesis", index)
                }
                index++
                return PrimitiveDeclarationValueSyntax(range(start, index), name, value)
            }
            // Look ahead only to this parenthesized type boundary. Type spelling is
            // validated by the signature grammar, not reconstructed by expressions.
            var Int typeEnd = index
            var Int parentheses
            while (typeEnd < tokens.count) {
                let token = tokens[typeEnd].value
                if (token == ")" && parentheses == 0) break
                if (token == ";" || token == "{" || token == "}") break
                if (token == "(") parentheses++
                if (token == ")") parentheses--
                typeEnd++
            }
            if (typeEnd + 1 < tokens.count && tokens[typeEnd].value == ")" && tokens[typeEnd + 1].value == "=>") {
                return parseLambdaParameters(start, true)
            }
            if (typeEnd > index && typeEnd + 1 < tokens.count &&
                tokens[index].type == Token.Type.IDENTIFIER && tokens[typeEnd].value == ")" &&
                tokens[typeEnd + 1].value != "." && tokens[typeEnd + 1].value != ")" &&
                tokens[typeEnd + 1].value != "[" && tokens[typeEnd + 1].value != "," &&
                tokens[typeEnd + 1].value != "]" && tokens[typeEnd + 1].value != "}" &&
                tokens[typeEnd + 1].value != "?" && tokens[typeEnd + 1].value != ":" &&
                !binaryOnlyOperator(tokens[typeEnd + 1].value)) {
                var String typeName
                try {
                    // A finite cast-header slice, never a source/project barrier.
                    let typeTokens = Token[]
                    for (cursor in index..typeEnd) typeTokens.add(tokens[cursor])
                    typeName = PrimitiveFunctionParser().parseTypeTokens(typeTokens, snapshot)
                } catch (Exception error) {
                    // A parenthesized expression may start with an identifier too.
                }
                if (typeName) {
                    index = typeEnd + 1
                    let value = parseUnary()
                    return PrimitiveCastSyntax(range(start, index), typeName, value)
                }
            }
            var PrimitiveExpressionSyntax expression = parseConditional()
            if (index < tokens.count && tokens[index].value == "=" &&
                expression.class.isOfType(PrimitiveReferenceSyntax.class)) {
                index++
                let value = parseConditional()
                expression = (PrimitiveExpressionSyntax)PrimitiveAssignmentValueSyntax(
                    range(start + 1, index),
                    ((PrimitiveReferenceSyntax)expression).name, value
                )
            } else if (index < tokens.count && assignmentOperator(tokens[index].value) &&
                expression.class.isOfType(PrimitiveMemberAccessSyntax.class)) {
                let operator = tokens[index++].value
                let value = parseConditional()
                let assignment = PrimitiveMemberAssignmentValueSyntax(
                    range(start + 1, index),
                    (PrimitiveMemberAccessSyntax)expression,
                    operator,
                    value
                )
                expression = (PrimitiveExpressionSyntax)assignment
            }
            if (index >= tokens.count || tokens[index].value != ")") {
                syntax("Expected closing expression parenthesis", index)
            }
            index++
            if (expression.class.isOfType(PrimitiveConditionalSyntax.class)) {
                let conditional = (PrimitiveConditionalSyntax)expression
                expression = PrimitiveConditionalSyntax(
                    range(start, index), conditional.condition,
                    conditional.whenTrue, conditional.whenFalse
                )
            }
            return parsePostfix(start, expression)
        }
        if (tokens[index].value == "[") return parseArray()
        if (tokens[index].value == "{") return parseBracedLambda(index, PrimitiveFunctionParameterSyntax[])
        let tokenIndex = index
        let token = tokens[index++]
        if (token.value == "native") return parseNative(tokenIndex)
        if (token.value == "async") {
            if (index >= tokens.count || tokens[index].value != "(") syntax("Expected async expression", index)
            index++
            let canonical = parseLevel(0)
            if (index >= tokens.count || tokens[index].value != ")") syntax("Expected closing async parenthesis", index)
            index++
            return PrimitiveRichCollectionSyntax(range(tokenIndex, index), "async", canonical)
        }
        if ((token.value == "range" || token.value == "safe" || token.value == "match") &&
            index < tokens.count && tokens[index].value == "(") {
            let kind = token.value == "safe" ? "safe-access" : token.value
            index++
            let canonical = parseLevel(0)
            if (index >= tokens.count || tokens[index].value != ")") syntax("Expected closing rich form parenthesis", index)
            index++
            return PrimitiveRichCollectionSyntax(range(tokenIndex, index), kind, canonical)
        }
        if (token.value == "named") return parseNamedCall(tokenIndex)
        if (token.value == "lambda") return parseLambda(tokenIndex)
        if (token.value == "ref") return parseFunctionReference(tokenIndex)
        if (token.value == "new") {
            if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) {
                syntax("Expected constructed type name", index)
            }
            let typeName = tokens[index++].value
            if (index < tokens.count && tokens[index].value == "[") {
                index++
                if (index < tokens.count && tokens[index].value == "]") {
                    index++
                    return emptyArrayPostfix(tokenIndex, typeName)
                }
                let size = parseConditional()
                if (index >= tokens.count || tokens[index].value != "]") {
                    syntax("Expected closing array construction bracket", index)
                }
                index++
                return PrimitiveArrayConstructionSyntax(
                    range(tokenIndex, index), typeName, size
                )
            }
            let typeArguments = memberTypeArguments()
            if (index >= tokens.count || tokens[index].value != "(") {
                syntax("Expected constructor arguments", index)
            }
            let call = (PrimitiveCallSyntax)parseCall(start: tokenIndex, name: typeName)
            return PrimitiveConstructionSyntax(call.range, typeName, call.argumentValues(), typeArguments)
        }
        if (token.type == Token.Type.IDENTIFIER) {
            if (index < tokens.count && tokens[index].value == "<") {
                var Int cursor = index
                var Int depth
                var String elementType = token.value
                while (cursor < tokens.count) {
                    let part = tokens[cursor].value
                    if (part == "<") depth++
                    else if (part == ">") depth--
                    elementType += part
                    cursor++
                    if (depth == 0) break
                }
                if (depth == 0 && cursor + 1 < tokens.count &&
                    tokens[cursor].value == "[" && tokens[cursor + 1].value == "]") {
                    index = cursor + 2
                    return emptyArrayPostfix(tokenIndex, elementType)
                }
            }
            if (index + 1 < tokens.count && tokens[index].value == "[" &&
                tokens[index + 1].value == "]") {
                index += 2
                return emptyArrayPostfix(tokenIndex, token.value)
            }
            if (index < tokens.count && tokens[index].value == "<") {
                var Int cursor = index
                var Int depth
                while (cursor < tokens.count) {
                    if (tokens[cursor].value == "<") depth++
                    else if (tokens[cursor].value == ">") depth--
                    cursor++
                    if (depth == 0) break
                }
                if (depth == 0 && cursor < tokens.count && tokens[cursor].value == "(") {
                    let typeArguments = memberTypeArguments()
                    let call = (PrimitiveCallSyntax)parseCall(tokenIndex, token.value)
                    return parsePostfix(tokenIndex, PrimitiveConstructionSyntax(
                        call.range, token.value, call.argumentValues(), typeArguments
                    ), true)
                }
            }
            var PrimitiveExpressionSyntax expression
            if (index < tokens.count && tokens[index].value == "(") {
                expression = parseCall(tokenIndex, token.value)
            } else expression = PrimitiveReferenceSyntax(
                range(tokenIndex, tokenIndex + 1), token.value
            )
            if (index < tokens.count && tokens[index].value == ":" && !expectsConditionalSeparator) {
                return parsePostfix(tokenIndex, expression, true)
            }
            while (index < tokens.count && (tokens[index].value == "." || safeMemberOperator() || tokens[index].value == "[")) {
                if (tokens[index].value == "[") {
                    index++
                    let accessIndex = parseConditional()
                    if (index >= tokens.count || tokens[index].value != "]") {
                        syntax("Expected closing array bracket", index)
                    }
                    index++
                    expression = PrimitiveArrayAccessSyntax(
                        range(tokenIndex, index), expression, accessIndex
                    )
                    continue
                }
                let safeAccess = consumeMemberOperator()
                if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) {
                    syntax("Expected member name after '.'", index)
                }
                let member = tokens[index++].value
                let typeArguments = memberTypeArguments()
                if (index < tokens.count && tokens[index].value == "(") {
                    index++
                    let arguments = PrimitiveExpressionSyntax[]
                    let namedArguments = PrimitiveMixedNamedArgumentSyntax[]
                    if (index < tokens.count && tokens[index].value != ")") {
                        while (true) {
                            if (tokens[index].type == Token.Type.IDENTIFIER &&
                                index + 1 < tokens.count && tokens[index + 1].value == ":") {
                                let argumentStart = index
                                let argumentName = tokens[index++].value
                                index++
                                if (namedArguments.any({ _.name == argumentName })) {
                                    syntax("Duplicate named argument '#argumentName'", argumentStart)
                                }
                                let argumentValue = parseConditional()
                                namedArguments.add(PrimitiveMixedNamedArgumentSyntax(
                                    range(argumentStart, index),
                                    argumentName, argumentValue
                                ))
                            } else {
                                if (namedArguments.isNotEmpty) {
                                    syntax("Positional member argument cannot follow a named argument", index)
                                }
                                arguments.add(parseConditional())
                            }
                            if (index >= tokens.count || tokens[index].value == ")") break
                            if (tokens[index].value != ",") {
                                syntax("Expected member call argument boundary", index)
                            }
                            index++
                        }
                    }
                    if (index >= tokens.count || tokens[index].value != ")") {
                        syntax("Expected closing member call parenthesis", index)
                    }
                    index++
                    expression = PrimitiveMemberCallSyntax(
                        range(tokenIndex, index), expression, member, arguments,
                        namedArguments, typeArguments, safeAccess
                    )
                } else expression = PrimitiveMemberAccessSyntax(
                    range(tokenIndex, index), expression, member, safeAccess
                )
            }
            if (index < tokens.count &&
                (tokens[index].value == "++" || tokens[index].value == "--")) {
                let operator = tokens[index++].value
                expression = PrimitivePostfixUpdateSyntax(
                    range(tokenIndex, index), operator, expression
                )
            }
            if (expression.class.isOfType(PrimitiveMemberAccessSyntax.class)) {
                let nameAccess = (PrimitiveMemberAccessSyntax)expression
                if (!nameAccess.safeAccess && nameAccess.memberName == "name" &&
                    nameAccess.receiver.class.isOfType(PrimitiveMemberAccessSyntax.class)) {
                    let classAccess = (PrimitiveMemberAccessSyntax)nameAccess.receiver
                    if (!classAccess.safeAccess && classAccess.memberName == "class") {
                        return PrimitiveClassNameSyntax(expression.range, classAccess.receiver)
                    }
                }
            }
            return expression
        }
        if (token.type == Token.Type.STRING) {
            var PrimitiveExpressionSyntax expression
            let strings = PrimitiveInterpolatedStringParser()
            if (!strings.hasMarker(token.value)) {
                expression = PrimitiveLiteralSyntax(
                    range(tokenIndex, tokenIndex + 1), token.type,
                    strings.literalSource(token.value)
                )
            } else expression = strings.parse(
                token, snapshot, tokenIndex + tokenIndexOffset
            ).expression
            return parsePostfix(tokenIndex, expression)
        }
        if (token.type != Token.Type.INTEGER && token.type != Token.Type.FLOAT &&
            token.type != Token.Type.BOOL &&
            token.type != Token.Type.STRING && token.type != Token.Type.CHAR &&
            token.type != Token.Type.NULL) {
            syntax("Expected primitive literal or identifier but received '#{token.value}'", tokenIndex)
        }
        return PrimitiveLiteralSyntax(
            range(tokenIndex, tokenIndex + 1), token.type, token.value
        )
    }

    memberTypeArguments() -> String[] {
        let arguments = String[]
        if (index >= tokens.count || tokens[index].value != "<") return arguments
        var Int cursor = index + 1
        var Int depth = 1
        var String name = ""
        while (cursor < tokens.count && depth > 0) {
            let value = tokens[cursor].value
            if (value == "<") depth++
            else if (value == ">") depth--
            if (depth == 0 || (depth == 1 && value == ",")) {
                if (name.isEmpty) return String[]
                arguments.add(name)
                name = ""
            } else name += value
            cursor++
        }
        // A following call distinguishes type arguments from comparison operators.
        if (depth != 0 || cursor >= tokens.count || tokens[cursor].value != "(") return String[]
        index = cursor
        return arguments
    }

    // The first [] allocates one empty outer array. Additional empty pairs
    // describe its element type; a nonempty pair remains a postfix index.
    emptyArrayPostfix(Int start, String baseType) -> PrimitiveExpressionSyntax {
        var String elementType = baseType
        while (index + 1 < tokens.count && tokens[index].value == "[" && tokens[index + 1].value == "]") {
            elementType += "[]"
            index += 2
        }
        return parsePostfix(start, PrimitiveEmptyArrayConstructionSyntax(range(start, index), elementType), true)
    }

    parsePostfix(
        Int tokenIndex,
        PrimitiveExpressionSyntax initial,
        Bool colonCall = false
    ) -> PrimitiveExpressionSyntax {
        var PrimitiveExpressionSyntax expression = initial
        while (index < tokens.count && (tokens[index].value == "." || safeMemberOperator() ||
            (colonCall && !expectsConditionalSeparator && tokens[index].value == ":") || tokens[index].value == "[")) {
            if (tokens[index].value == "[") {
                index++
                let accessIndex = parseConditional()
                if (index >= tokens.count || tokens[index].value != "]") {
                    syntax("Expected closing array bracket", index)
                }
                index++
                expression = PrimitiveArrayAccessSyntax(
                    range(tokenIndex, index), expression, accessIndex
                )
                continue
            }
            let chainNavigation = tokens[index].value == ":"
            let safeAccess = consumeMemberOperator()
            if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) {
                syntax("Expected member name after '.'", index)
            }
            let member = tokens[index++].value
            if (chainNavigation && (index >= tokens.count || tokens[index].value != "("))
                syntax("Colon navigation requires a method call", index)
            if (index < tokens.count && tokens[index].value == "(") {
                index++
                if (index < tokens.count && tokens[index].value == ")") {
                    index++
                    expression = PrimitiveMemberCallSyntax(
                        range(tokenIndex, index), expression, member,
                        PrimitiveExpressionSyntax[], safeAccess: safeAccess,
                        chainNavigation: chainNavigation
                    )
                    continue
                }
                let arguments = PrimitiveExpressionSyntax[]
                let namedArguments = PrimitiveMixedNamedArgumentSyntax[]
                if (index < tokens.count && tokens[index].value != ")") {
                    while (true) {
                        if (tokens[index].type == Token.Type.IDENTIFIER &&
                            index + 1 < tokens.count && tokens[index + 1].value == ":") {
                            let argumentStart = index
                            let argumentName = tokens[index++].value
                            index++
                            if (namedArguments.any({ _.name == argumentName })) {
                                syntax("Duplicate named argument '#argumentName'", argumentStart)
                            }
                            let argumentValue = parseConditional()
                            namedArguments.add(PrimitiveMixedNamedArgumentSyntax(
                                range(argumentStart, index),
                                argumentName, argumentValue
                            ))
                        } else {
                            if (namedArguments.isNotEmpty) {
                                syntax("Positional member argument cannot follow a named argument", index)
                            }
                            arguments.add(parseConditional())
                        }
                        if (index >= tokens.count || tokens[index].value == ")") break
                        if (tokens[index].value != ",") {
                            syntax("Expected member call argument boundary", index)
                        }
                        index++
                    }
                }
                if (index >= tokens.count || tokens[index].value != ")") {
                    syntax("Expected closing member call parenthesis", index)
                }
                index++
                expression = PrimitiveMemberCallSyntax(
                    range(tokenIndex, index), expression, member, arguments,
                    namedArguments, safeAccess: safeAccess, chainNavigation: chainNavigation
                )
            } else expression = PrimitiveMemberAccessSyntax(
                range(tokenIndex, index), expression, member, safeAccess
            )
        }
        return expression
    }

    parseNative(Int start) -> PrimitiveExpressionSyntax {
        if (index >= tokens.count || tokens[index].value != "[") syntax("Expected native target annotation", index)
        index++
        if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) syntax("Expected native target", index)
        let target = tokens[index++].value
        if (index >= tokens.count || tokens[index].value != "]") syntax("Expected closing native target annotation", index)
        index++
        if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) syntax("Expected native name", index)
        var String name = tokens[index++].value
        while (index < tokens.count && tokens[index].value == ".") {
            index++
            if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) syntax("Expected qualified native component", index)
            name += "." + tokens[index++].value
        }
        if (index >= tokens.count || tokens[index].value != "(") syntax("Expected native arguments", index)
        let call = (PrimitiveCallSyntax)parseCall(start: start, name: name)
        return PrimitiveNativeSyntax(call.range, target, name, call.argumentValues())
    }

    parseNamedCall(Int start) -> PrimitiveExpressionSyntax {
        if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) {
            syntax("Expected named call target", index)
        }
        let name = tokens[index++].value
        if (index >= tokens.count || tokens[index].value != "(") syntax("Expected named arguments", index)
        index++
        let values = PrimitiveNamedArgumentSyntax[]
        while (index < tokens.count && tokens[index].value != ")") {
            let argumentStart = index
            if (tokens[index].type != Token.Type.IDENTIFIER) syntax("Expected named argument name", index)
            let argumentName = tokens[index++].value
            if (values.any({ _.name == argumentName })) syntax("Duplicate named argument", argumentStart)
            if (index >= tokens.count || tokens[index].value != ":") syntax("Expected ':' after named argument", index)
            index++
            let value = parseLevel(0)
            values.add(PrimitiveNamedArgumentSyntax(range(argumentStart, index), argumentName, value))
            if (index >= tokens.count || tokens[index].value != ",") break
            index++
        }
        if (index >= tokens.count || tokens[index].value != ")") syntax("Expected closing named call parenthesis", index)
        index++
        return PrimitiveNamedCallSyntax(range(start, index), name, values)
    }

    parseBracedLambda(Int start, PrimitiveFunctionParameterSyntax[] parameters) -> PrimitiveExpressionSyntax {
        index++
        if (index < tokens.count && tokens[index].value == "}") {
            index++
            return PrimitiveLambdaSyntax(
                range(start, index), parameters,
                PrimitiveLiteralSyntax(range(start, index), Token.Type.NULL, "null"),
                emptyBody: true
            )
        }
        let bodyStart = index
        var Int cursor = index
        var Int depth = 1
        var Bool statementBody = tokens[bodyStart].value == "throw"
        while (cursor < tokens.count && depth > 0) {
            let value = tokens[cursor].value
            if (value == "{") depth++
            else if (value == "}") depth--
            if (depth == 1 && (value == "return" || value == ";" ||
                value == "let" || value == "var" || value == "if" ||
                value == "for" || value == "while")) statementBody = true
            if (depth > 0) cursor++
        }
        if (depth != 0) syntax("Expected closing implicit lambda brace", cursor)
        if (!statementBody) {
            let body = parseConditional()
            if (index == cursor) {
                index++
                return PrimitiveLambdaSyntax(range(start, index), parameters, body)
            }
            // A complete expression followed by a write operator or a new statement
            // belongs to the ordinary statement grammar. Never split a continued call.
            if (index >= cursor || (!assignmentOperator(tokens[index].value) && tokens[index].value != "=" &&
                tokens[index].location.lineNumber <= tokens[index - 1].endLineNumber)) {
                syntax("Expected closing implicit lambda brace", index)
            }
        }
        let statements = PrimitiveControlStatementParser().parse(
            tokens.skip(bodyStart).take(cursor - bodyStart), snapshot,
            bodyStart + tokenIndexOffset
        ).statements()
        index = cursor + 1
        return PrimitiveLambdaSyntax(range(start, index), parameters,
            PrimitiveLiteralSyntax(range(start, index), Token.Type.NULL, "null"),
            statementValues: statements)
    }

    parseLambda(Int start) -> PrimitiveExpressionSyntax {
        if (index >= tokens.count || tokens[index].value != "(") syntax("Expected lambda parameters", index)
        index++
        return parseLambdaParameters(start, false)
    }

    parseLambdaParameters(Int start, Bool allowOmittedType) -> PrimitiveExpressionSyntax {
        var Int raw = index
        let parameters = PrimitiveFunctionParameterSyntax[]
        if (index < tokens.count && tokens[index].value != ")") {
            while (true) {
                let parameterStart = index
                if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) syntax("Expected lambda parameter type", index)
                var String typeName = null
                var String name = tokens[index++].value
                if (index < tokens.count && tokens[index].value == "<") {
                    // Commas inside the generic spelling belong to the type, not the lambda.
                    var Int depth = 1
                    index++
                    while (index < tokens.count && depth > 0) {
                        let part = tokens[index].value
                        if (part == "<") depth++
                        else if (part == ">") depth--
                        else if (part == ")" || part == "=>") syntax("Expected closing generic lambda parameter type", index)
                        index++
                    }
                    if (depth != 0) syntax("Expected closing generic lambda parameter type", index)
                    let typeTokens = Token[]
                    for (i in parameterStart..index) typeTokens.add(tokens[i])
                    typeName = PrimitiveFunctionParser().parseTypeTokens(typeTokens, snapshot, parameterStart + tokenIndexOffset)
                    if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) syntax("Expected lambda parameter name", index)
                    name = tokens[index++].value
                } else if (index < tokens.count && tokens[index].type == Token.Type.IDENTIFIER) {
                    typeName = name
                    name = tokens[index++].value
                } else if (!allowOmittedType) syntax("Expected lambda parameter name", index)
                if (parameters.any({ _.name == name })) syntax("Duplicate lambda parameter", index - 1)
                let first = tokens[parameterStart]
                let last = tokens[index - 1]
                while (sourceSlice[raw].location != first.location) raw++
                let rawStart = raw
                while (sourceSlice[raw].location != last.location) raw++
                let parameterRange = containingRange ? range(parameterStart, index) : SourceRange(snapshot,
                    tokenIndexOffset + rawStart, tokenIndexOffset + raw + 1, first.location,
                    Location(lineNumber: last.endLineNumber, column: last.endColumn))
                parameters.add(PrimitiveFunctionParameterSyntax(parameterRange, typeName, name,
                    omittedLambdaType: typeName == null))
                if (index >= tokens.count || tokens[index].value != ",") break
                index++
            }
        }
        if (index >= tokens.count || tokens[index].value != ")") syntax("Expected closing lambda parenthesis", index)
        index++
        if (index >= tokens.count || tokens[index].value != "=>") syntax("Expected lambda arrow", index)
        index++
        if (allowOmittedType && index < tokens.count && tokens[index].value == "{") return parseBracedLambda(start, parameters)
        let body = parseConditional()
        return PrimitiveLambdaSyntax(range(start, index), parameters, body)
    }

    parseFunctionReference(Int start) -> PrimitiveExpressionSyntax {
        if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) {
            syntax("Expected referenced function name", index)
        }
        let name = tokens[index++].value
        return PrimitiveFunctionReferenceSyntax(range(start, index), name)
    }

    parseArray() -> PrimitiveExpressionSyntax {
        let start = index++
        let values = PrimitiveExpressionSyntax[]
        if (index < tokens.count && tokens[index].value == "]") {
            syntax("Array literal requires at least one element", index)
        }
        while (true) {
            values.add(parseConditional())
            if (index >= tokens.count) syntax("Expected closing array bracket", index)
            if (tokens[index].value == "]") {
                index++
                return PrimitiveArraySyntax(range(start, index), values)
            }
            if (tokens[index].value != ",") syntax("Expected array element separator", index)
            index++
            if (index >= tokens.count) {
                syntax("Expected array element after ','", index)
            }
            if (tokens[index].value == "]") {
                index++
                return PrimitiveArraySyntax(range(start, index), values)
            }
        }
    }

    parseCall(Int start, String name) -> PrimitiveExpressionSyntax {
        index++
        let arguments = PrimitiveExpressionSyntax[]
        let namedArguments = PrimitiveMixedNamedArgumentSyntax[]
        if (index < tokens.count && tokens[index].value == ")") {
            index++
            return PrimitiveCallSyntax(range(start, index), name, arguments, namedArguments)
        }
        while (true) {
            if (index >= tokens.count) syntax("Expected closing call parenthesis", index)
            if (tokens[index].type == Token.Type.IDENTIFIER &&
                index + 1 < tokens.count && tokens[index + 1].value == ":") {
                let argumentStart = index
                let argumentName = tokens[index++].value
                index++
                if (namedArguments.any({ _.name == argumentName })) {
                    syntax("Duplicate named argument '#argumentName'", argumentStart)
                }
                let value = parseConditional()
                namedArguments.add(PrimitiveMixedNamedArgumentSyntax(
                    range(argumentStart, index),
                    argumentName, value
                ))
            } else {
                if (namedArguments.isNotEmpty) {
                    syntax("Positional argument cannot follow a named argument", index)
                }
                arguments.add(parseConditional())
            }
            if (index >= tokens.count) syntax("Expected closing call parenthesis", index)
            if (tokens[index].value == ")") {
                index++
                return PrimitiveCallSyntax(
                    range(start, index), name, arguments, namedArguments
                )
            }
            if (tokens[index].value != ",") {
                syntax("Expected ',' or ')' after call argument", index)
            }
            index++
            if (index >= tokens.count || tokens[index].value == ")") {
                syntax("Expected call argument after ','", index)
            }
        }
    }

    range(Int startIndex, Int endIndex) -> SourceRange {
        let start = tokens[startIndex].location
        let last = tokens[endIndex - 1]
        let sourceStartIndex = startIndex + tokenIndexOffset
        let sourceEndIndex = endIndex + tokenIndexOffset
        return SourceRange(
            snapshot,
            containingRange ? containingRange.startTokenIndex : sourceStartIndex,
            containingRange ? containingRange.endTokenIndex : sourceEndIndex,
            start,
            Location(lineNumber: last.endLineNumber, column: last.endColumn)
        )
    }

    syntax(String message, Int tokenIndex) {
        let sourceIndex = tokenIndex + tokenIndexOffset
        throw ParseFailure.atTokens("invalid-expression-syntax",
            "Primitive expression syntax error at token #sourceIndex: #message",
            snapshot, tokens, tokenIndex, tokenIndexOffset, containingRange)
    }
}
