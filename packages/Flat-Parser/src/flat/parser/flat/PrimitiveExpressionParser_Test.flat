    test `parses complete expression inside braced interpolation`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:interpolation-expression"), "revision:one"
        )
        var String source = "\"before "
        source += '#'
        source += "{symmetrical ? str.reverse() : str} after\""
        let parsedExpression = PrimitiveExpressionParser().parse([
            token(source, Token.Type.STRING, 4)
        ], snapshot, 12)
        var PrimitiveInterpolatedStringSyntax parsed
        parsed = (PrimitiveInterpolatedStringSyntax)parsedExpression
        var PrimitiveConditionalSyntax expression
        expression = (PrimitiveConditionalSyntax)parsed.segmentValues()[1].expression
        var PrimitiveMemberCallSyntax call
        call = (PrimitiveMemberCallSyntax)expression.whenTrue

        expect(expression.expressionKind()).toBe("conditional")
        expect(call.memberName).toBe("reverse")
        expect(expression.range.startTokenIndex).toBe(12)
        expect(expression.range.endTokenIndex).toBe(13)
        expect(expression.range.start.column).toBe(14)
        expect(expression.range.end.column).toBe(47)
    }

