    test `parses member call with trailing named argument`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:mixed-member-call"), "revision:one"
        )
        let parsed = PrimitiveExpressionParser().parse([
            token("value", Token.Type.IDENTIFIER, 1), token(".", Token.Type.SYMBOL, 6),
            token("trim", Token.Type.IDENTIFIER, 7), token("(", Token.Type.SYMBOL, 11),
            token("character", Token.Type.IDENTIFIER, 12), token(",", Token.Type.SYMBOL, 21),
            token("count", Token.Type.IDENTIFIER, 23), token(":", Token.Type.SYMBOL, 28),
            token("count", Token.Type.IDENTIFIER, 30), token("-", Token.Type.SYMBOL, 36),
            token("1", Token.Type.INTEGER, 38), token(")", Token.Type.SYMBOL, 39)
        ], snapshot)
        let call = (PrimitiveMemberCallSyntax)parsed

        expect(call.argumentValues().count).toBe(1)
        expect(call.namedArgumentValues().map({ _.name })).toBe(["count"])
        expect(call.namedArgumentValues().first.value.expressionKind()).toBe("binary")
    }

    test `parses receiver owned member call`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:member-call"), "revision:one"
        )
        let expression = PrimitiveExpressionParser().parse([
            token("other", Token.Type.IDENTIFIER, 1), token(".", Token.Type.SYMBOL, 6),
            token("equals", Token.Type.IDENTIFIER, 7), token("(", Token.Type.SYMBOL, 13),
            token("value", Token.Type.IDENTIFIER, 14), token(")", Token.Type.SYMBOL, 19)
        ], snapshot)
        let call = (PrimitiveMemberCallSyntax)expression

        expect(call.expressionKind()).toBe("member-call")
        expect(call.memberName).toBe("equals")
