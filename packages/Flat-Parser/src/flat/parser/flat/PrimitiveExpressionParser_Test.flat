package flat/parser/flat

import flat/compiler/models

testable class {
    test `class name shorthand does not erase safe navigation`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:safe-class-name"), "one")
        let tokens = [token("value", Token.Type.IDENTIFIER, 1), token("?", Token.Type.SYMBOL, 6),
            token(".", Token.Type.SYMBOL, 7), token("class", Token.Type.IDENTIFIER, 8),
            token(".", Token.Type.SYMBOL, 13), token("name", Token.Type.IDENTIFIER, 14)]
        let expression = PrimitiveExpressionParser().parse(tokens, snapshot)
        expect(expression.expressionKind()).toBe("member-access")
    }
    test `retains safe access and safe call markers`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:safe-access"), "one")
        let tokens = [token("value", Token.Type.IDENTIFIER, 1), token("?", Token.Type.SYMBOL, 6),
            token(".", Token.Type.SYMBOL, 7), token("read", Token.Type.IDENTIFIER, 8),
            token("(", Token.Type.SYMBOL, 12), token(")", Token.Type.SYMBOL, 13),
            token("?", Token.Type.SYMBOL, 14), token(".", Token.Type.SYMBOL, 15),
            token("name", Token.Type.IDENTIFIER, 16)]
        let expression = PrimitiveExpressionParser().parse(tokens, snapshot, 10)
        let access = (PrimitiveMemberAccessSyntax)expression
        expect(access.safeAccess).toBe(true)
        let receiverObject = access.receiver
        let call = (PrimitiveMemberCallSyntax)receiverObject
        expect(call.safeAccess).toBe(true)
        expect(access.range.startTokenIndex).toBe(10)
        expect(access.range.endTokenIndex).toBe(19)
        var Bool rejected
        try { PrimitiveExpressionParser().parse(tokens.take(3), snapshot) }
        catch (Exception error) { rejected = true }
        expect(rejected).toBe(true)
    }
    test `parses null fallback and rejects missing operand`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:fallback"), "one")
        let tokens = [token("null", Token.Type.IDENTIFIER, 1),
            token("?:", Token.Type.SYMBOL, 6), token("false", Token.Type.BOOL, 9)]
        let expression = PrimitiveExpressionParser().parse(tokens, snapshot, 10)
        let binary = (PrimitiveBinarySyntax)expression
        expect(binary.operator).toBe("?:")
        expect(binary.range.startTokenIndex).toBe(10)
        expect(binary.range.endTokenIndex).toBe(13)
        var Bool rejected
        try { PrimitiveExpressionParser().parse(tokens.take(2), snapshot) }
        catch (Exception error) { rejected = true }
        expect(rejected).toBe(true)
    }
    test `reports duplicate receiver call label with source offset`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:duplicate-member-label"), "one")
        var String failure
        try {
            PrimitiveExpressionParser().parse([
                token("value", Token.Type.IDENTIFIER, 1), token(".", Token.Type.SYMBOL, 6),
                token("read", Token.Type.IDENTIFIER, 7), token("(", Token.Type.SYMBOL, 11),
                token("count", Token.Type.IDENTIFIER, 12), token(":", Token.Type.SYMBOL, 17),
                token("1", Token.Type.INTEGER, 19), token(",", Token.Type.SYMBOL, 20),
                token("count", Token.Type.IDENTIFIER, 22), token(":", Token.Type.SYMBOL, 27),
                token("2", Token.Type.INTEGER, 29), token(")", Token.Type.SYMBOL, 30)
            ], snapshot, 20)
        } catch (Exception error) { failure = error.message }
        expect(failure).toBe("Primitive expression syntax error at token 28: Duplicate named argument 'count'")
    }

    test `reports duplicate named label at its second occurrence`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:duplicate-label"), "one")
        var String failure
        try {
            PrimitiveExpressionParser().parse([
                token("read", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 5),
                token("count", Token.Type.IDENTIFIER, 6), token(":", Token.Type.SYMBOL, 11),
                token("1", Token.Type.INTEGER, 13), token(",", Token.Type.SYMBOL, 14),
                token("count", Token.Type.IDENTIFIER, 16), token(":", Token.Type.SYMBOL, 21),
                token("2", Token.Type.INTEGER, 23), token(")", Token.Type.SYMBOL, 24)
            ], snapshot, 20)
        } catch (Exception error) { failure = error.message }
        expect(failure).toBe("Primitive expression syntax error at token 26: Duplicate named argument 'count'")
    }

    test `parses multiple ordinary named arguments in source order`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:all-named-call"), "one")
        let parsed = PrimitiveExpressionParser().parse([
            token("read", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 5),
            token("next", Token.Type.IDENTIFIER, 6), token(":", Token.Type.SYMBOL, 10),
            token("{", Token.Type.SYMBOL, 12), token("}", Token.Type.SYMBOL, 13),
            token(",", Token.Type.SYMBOL, 14), token("count", Token.Type.IDENTIFIER, 16),
            token(":", Token.Type.SYMBOL, 21), token("9", Token.Type.INTEGER, 23),
            token(")", Token.Type.SYMBOL, 24)
        ], snapshot)
        let call = (PrimitiveCallSyntax)parsed
        expect(call.argumentValues().count).toBe(0)
        expect(call.namedArgumentValues().map({ _.name })).toBe(["next", "count"])
        expect(call.range.endTokenIndex).toBe(11)
    }

    test `preserves generic empty array element`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:generic-empty"), "one")
        let values = [token("List", Token.Type.IDENTIFIER, 1), token("<", Token.Type.SYMBOL, 5),
            token("Type", Token.Type.IDENTIFIER, 6), token(">", Token.Type.SYMBOL, 10),
            token("[", Token.Type.SYMBOL, 11), token("]", Token.Type.SYMBOL, 12)]
        let parsed = PrimitiveExpressionParser().parse(values, snapshot, 20)
        let array = (PrimitiveEmptyArrayConstructionSyntax)parsed
        expect(array.elementTypeName).toBe("List<Type>")
        expect(array.range.startTokenIndex).toBe(20)
        expect(array.range.endTokenIndex).toBe(26)
        var String failure
        try {
            PrimitiveExpressionParser().parse(values.take(5), snapshot, 20)
        } catch (Exception error) {
            failure = error.message
        }
        expect(failure != null).toBe(true)
    }

    test `preserves explicit member type arguments`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:generic-member"), "one")
        let values = [token("Async", Token.Type.IDENTIFIER, 1), token(".", Token.Type.SYMBOL, 6),
            token("all", Token.Type.IDENTIFIER, 7), token("<", Token.Type.SYMBOL, 10),
            token("Bool", Token.Type.IDENTIFIER, 11), token(">", Token.Type.SYMBOL, 15),
            token("(", Token.Type.SYMBOL, 16), token("true", Token.Type.BOOL, 17),
            token(")", Token.Type.SYMBOL, 21)]
        let parsed = PrimitiveExpressionParser().parse(values, snapshot, 30)
        let call = (PrimitiveMemberCallSyntax)parsed
        expect(call.typeArgumentNames()).toBe(["Bool"])
        expect(call.range.startTokenIndex).toBe(30)
        expect(call.range.endTokenIndex).toBe(39)
        var String failure
        try {
            PrimitiveExpressionParser().parse(values.take(8), snapshot, 30)
        } catch (Exception error) {
            failure = error.message
        }
        expect(failure != null).toBe(true)
    }

    test `parses statement callback`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:statement-callback"), "one")
        let values = [token("{", Token.Type.SYMBOL, 1),
            token("func", Token.Type.IDENTIFIER, 2), token("(", Token.Type.SYMBOL, 6),
            token("_", Token.Type.IDENTIFIER, 7), token(")", Token.Type.SYMBOL, 8),
            token(";", Token.Type.SYMBOL, 9),
            token("return", Token.Type.IDENTIFIER, 10), token("null", Token.Type.NULL, 17),
            token("}", Token.Type.SYMBOL, 22)]
        let parsed = PrimitiveExpressionParser().parse(values, snapshot, 40)
        let callback = (PrimitiveLambdaSyntax)parsed
        expect(callback.statementValues().count).toBe(2)
        expect(callback.range.startTokenIndex).toBe(40)
        expect(callback.range.endTokenIndex).toBe(49)
        var String failure
        try {
            PrimitiveExpressionParser().parse(values.take(7), snapshot, 40)
        } catch (Exception error) {
            failure = error.message
        }
        expect(failure != null).toBe(true)
    }

    test `parses empty implicit callback expression`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:empty-callback"), "one")
        let parsed = PrimitiveExpressionParser().parse([
            token("{", Token.Type.SYMBOL, 1), token("}", Token.Type.SYMBOL, 2)
        ], snapshot)
        let callback = (PrimitiveLambdaSyntax)parsed
        expect(callback.emptyBody).toBe(true)
        expect(callback.parameterValues().count).toBe(0)
        expect(callback.range.startTokenIndex).toBe(0)
        expect(callback.range.endTokenIndex).toBe(2)
    }

    test `parses parenthesized local declaration value`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:declaration-value"), "revision:one"
        )
        let parsed = PrimitiveExpressionParser().parse([
            token("(", Token.Type.SYMBOL, 1), token("let", Token.Type.IDENTIFIER, 2),
            token("found", Token.Type.IDENTIFIER, 6), token("=", Token.Type.SYMBOL, 12),
            token("next", Token.Type.IDENTIFIER, 14), token("(", Token.Type.SYMBOL, 18),
            token(")", Token.Type.SYMBOL, 19), token(")", Token.Type.SYMBOL, 20),
            token(">=", Token.Type.SYMBOL, 22), token("0", Token.Type.INTEGER, 25)
        ], snapshot)
        let binary = (PrimitiveBinarySyntax)parsed
        let declaration = (PrimitiveDeclarationValueSyntax)binary.left

        expect(declaration.name).toBe("found")
        expect(declaration.value.expressionKind()).toBe("call")
        expect(binary.operator).toBe(">=")
    }

    test `parses ordinary call with trailing named argument`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:mixed-call"), "revision:one"
        )
        let parsed = PrimitiveExpressionParser().parse([
            token("indexOf", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 8),
            token("search", Token.Type.IDENTIFIER, 9), token(",", Token.Type.SYMBOL, 15),
            token("start", Token.Type.IDENTIFIER, 17), token(",", Token.Type.SYMBOL, 22),
            token("searchCount", Token.Type.IDENTIFIER, 24), token(":", Token.Type.SYMBOL, 35),
            token("1", Token.Type.INTEGER, 37), token(")", Token.Type.SYMBOL, 38)
        ], snapshot)
        let expression = (PrimitiveCallSyntax)parsed
        let namedArguments = expression.namedArgumentValues()

        expect(expression.argumentValues().count).toBe(2)
        expect(namedArguments.map({ _.name })).toBe(["searchCount"])
        expect(namedArguments.first.value.expressionKind()).toBe("literal")
    }

    test `rejects positional argument after ordinary named argument`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:mixed-call-order"), "revision:one"
        )
        var String message
        try {
            PrimitiveExpressionParser().parse([
                token("run", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 4),
                token("first", Token.Type.IDENTIFIER, 5), token(",", Token.Type.SYMBOL, 10),
                token("second", Token.Type.IDENTIFIER, 12), token(":", Token.Type.SYMBOL, 18),
                token("2", Token.Type.INTEGER, 20), token(",", Token.Type.SYMBOL, 21),
                token("3", Token.Type.INTEGER, 23), token(")", Token.Type.SYMBOL, 24)
            ], snapshot)
        } catch (Exception error) { message = error.message }

        expect(message).toBe(
            "Primitive expression syntax error at token 8: " +
                "Positional argument cannot follow a named argument"
        )
    }

    test `parses interpolated string segments with exact source ranges`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-interpolation"), "revision:one"
        )
        var String source = "\"Hello "
        source += '#'
        source += "{this.class.name} @"
        source += '#'
        source += "hashCode!\""
        let expression = PrimitiveExpressionParser().parse([
            token(source, Token.Type.STRING, 4)
        ], snapshot, 12)
        var PrimitiveInterpolatedStringSyntax interpolation
        interpolation = (PrimitiveInterpolatedStringSyntax)expression
        let segments = interpolation.segmentValues()

        expect(segments.count).toBe(5)
        expect(segments.map({ _.literal() })).toBe([true, false, true, false, true])
        expect(segments[0].literalSourceValue).toBe("\"Hello \"")
        expect(segments[1].expression.expressionKind()).toBe("interpolation-path")
        expect(((PrimitiveInterpolationPathSyntax)segments[1].expression).pathValues()).toBe(
            ["this", "class", "name"]
        )
        expect(((PrimitiveInterpolationPathSyntax)segments[3].expression).pathValues()).toBe(
            ["hashCode"]
        )
        expect(interpolation.range.startTokenIndex).toBe(12)
        expect(interpolation.range.endTokenIndex).toBe(13)
        expect(segments[0].range.start.column).toBe(5)
        expect(segments[1].range.start.column).toBe(11)
        expect(segments[4].range.end.column).toBe(41)

        let copied = interpolation.segmentValues()
        copied.clear()
        expect(interpolation.segmentValues().count).toBe(5)
    }

    test `rejects malformed string interpolation`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-interpolation-invalid"), "revision:one"
        )
        var Int rejected
        try {
            var String unterminated = "\"Hello "
            unterminated += '#'
            unterminated += "{name\""
            PrimitiveExpressionParser().parse([
                token(unterminated, Token.Type.STRING, 1)
            ], snapshot)
        } catch (Exception error) { rejected++ }
        try {
            var String empty = "\"Hello "
            empty += '#'
            empty += "{}\""
            PrimitiveExpressionParser().parse([
                token(empty, Token.Type.STRING, 1)
            ], snapshot)
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
    }

    test `parses floating point literal with exact source evidence`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-float"), "revision:one"
        )
        let expression = PrimitiveExpressionParser().parse([
            token("0.5", Token.Type.FLOAT, 3)
        ], snapshot, 7)
        let literal = (PrimitiveLiteralSyntax)expression

        expect(literal.tokenType).toBe(Token.Type.FLOAT)
        expect(literal.sourceValue).toBe("0.5")
        expect(literal.range.startTokenIndex).toBe(7)
        expect(literal.range.start.column).toBe(3)
    }

    test `parses primitive literal unary binary precedence and absolute ranges`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-expression"), "revision:one"
        )
        let expression = PrimitiveExpressionParser().parse([
            token("-", Token.Type.SYMBOL, 1),
            token("1", Token.Type.INTEGER, 2),
            token("+", Token.Type.SYMBOL, 4),
            token("2", Token.Type.INTEGER, 6),
            token("*", Token.Type.SYMBOL, 8),
            token("3", Token.Type.INTEGER, 10)
        ], snapshot)
        let binary = (PrimitiveBinarySyntax)expression
        let left = (PrimitiveUnarySyntax)binary.left
        let right = (PrimitiveBinarySyntax)binary.right

        expect(binary.operator).toBe("+")
        expect(left.operator).toBe("-")
        expect(right.operator).toBe("*")
        expect(binary.range.snapshot).toBe(snapshot)
        expect(binary.range.startTokenIndex).toBe(0)
        expect(binary.range.endTokenIndex).toBe(6)
        expect(binary.range.start.column).toBe(1)
        expect(binary.range.end.column).toBe(11)

        let offsetExpression = PrimitiveExpressionParser().parse([
            token("1", Token.Type.INTEGER, 20)
        ], snapshot, 12)
        expect(offsetExpression.range.startTokenIndex).toBe(12)
        expect(offsetExpression.range.endTokenIndex).toBe(13)
    }

    test `parses parenthesized local assignment value`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:assignment-value"), "revision:one"
        )
        let expression = PrimitiveExpressionParser().parse([
            token("(", Token.Type.SYMBOL, 1), token("index", Token.Type.IDENTIFIER, 2),
            token("=", Token.Type.SYMBOL, 8), token("next", Token.Type.IDENTIFIER, 10),
            token(")", Token.Type.SYMBOL, 14), token(">=", Token.Type.SYMBOL, 16),
            token("0", Token.Type.INTEGER, 19)
        ], snapshot)
        let comparison = (PrimitiveBinarySyntax)expression
        let assignment = (PrimitiveAssignmentValueSyntax)comparison.left

        expect(assignment.name).toBe("index")
        expect(assignment.value.expressionKind()).toBe("reference")
    }

    test `parses cast wrapped member compound assignment value`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:member-assignment-value"), "revision:one"
        )
        let expression = PrimitiveExpressionParser().parse([
            token("(", Token.Type.SYMBOL, 1), token("Long", Token.Type.IDENTIFIER, 2),
            token(")", Token.Type.SYMBOL, 6), token("(", Token.Type.SYMBOL, 7),
            token("this", Token.Type.IDENTIFIER, 8), token(".", Token.Type.SYMBOL, 12),
            token("value", Token.Type.IDENTIFIER, 13), token("+=", Token.Type.SYMBOL, 19),
            token("other", Token.Type.IDENTIFIER, 22), token(")", Token.Type.SYMBOL, 27)
        ], snapshot)
        let cast = (PrimitiveCastSyntax)expression

        expect(cast.value.expressionKind()).toBe("member-assignment-value")
        expect(cast.typeName).toBe("Long")
    }

    test `parses metadata access explicitly`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:class-name-expression"), "revision:one"
        )
        let expression = PrimitiveExpressionParser().parse([
            token("this", Token.Type.IDENTIFIER, 1), token(".", Token.Type.SYMBOL, 5),
            token("cla" + "ss", Token.Type.IDENTIFIER, 6), token(".", Token.Type.SYMBOL, 11),
            token("name", Token.Type.IDENTIFIER, 12)
        ], snapshot)

        expect(expression.expressionKind()).toBe("class-name")
        expect(expression.range.startTokenIndex).toBe(0)
        expect(expression.range.endTokenIndex).toBe(5)
