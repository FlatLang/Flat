    test `parses fixed size array construction`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:array-construction"), "revision:one"
        )
        let expression = PrimitiveExpressionParser().parse([
            token("new", Token.Type.IDENTIFIER, 1),
            token("Char", Token.Type.IDENTIFIER, 5),
            token("[", Token.Type.SYMBOL, 9),
            token("count", Token.Type.IDENTIFIER, 10),
            token("]", Token.Type.SYMBOL, 15)
        ], snapshot)
        let construction = (PrimitiveArrayConstructionSyntax)expression

        expect(construction.expressionKind()).toBe("array-construction")
        expect(construction.elementTypeName).toBe("Char")
        expect(construction.size.expressionKind()).toBe("reference")
        expect(construction.range.startTokenIndex).toBe(0)
        expect(construction.range.endTokenIndex).toBe(5)
