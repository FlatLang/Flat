    test `parses zero size generic array construction`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:zero-array"), "revision:one"
        )
        let parsed = PrimitiveExpressionParser().parse([
            token("Array", Token.Type.IDENTIFIER, 1), token("<", Token.Type.SYMBOL, 6),
            token("Char", Token.Type.IDENTIFIER, 7), token(">", Token.Type.SYMBOL, 11),
            token("(", Token.Type.SYMBOL, 12), token(")", Token.Type.SYMBOL, 13),
            token(".", Token.Type.SYMBOL, 14), token("add", Token.Type.IDENTIFIER, 15),
            token("(", Token.Type.SYMBOL, 18), token("value", Token.Type.IDENTIFIER, 19),
            token(")", Token.Type.SYMBOL, 24)
        ], snapshot)
        let call = (PrimitiveMemberCallSyntax)parsed

        expect(call.receiver.expressionKind()).toBe("construction")
        let receiver = (PrimitiveConstructionSyntax)call.receiver
        expect(receiver.typeArgumentNames()).toBe(["Char"])
        expect(call.memberName).toBe("add")
    }

    test `parses value producing postfix increment in call argument`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:postfix-call-argument"), "revision:one"
        )
        let parsed = PrimitiveExpressionParser().parse([
            token("ints", Token.Type.IDENTIFIER, 1), token(".", Token.Type.SYMBOL, 5),
            token("set", Token.Type.IDENTIFIER, 6), token("(", Token.Type.SYMBOL, 9),
            token("i", Token.Type.IDENTIFIER, 10), token("-", Token.Type.SYMBOL, 12),
            token("start", Token.Type.IDENTIFIER, 14), token(",", Token.Type.SYMBOL, 19),
            token("i", Token.Type.IDENTIFIER, 21), token("++", Token.Type.SYMBOL, 22),
            token(")", Token.Type.SYMBOL, 24)
        ], snapshot)
        let call = (PrimitiveMemberCallSyntax)parsed
        let arguments = call.argumentValues()

        expect(arguments.last.expressionKind()).toBe("postfix-update")
        expect(arguments.last.range.start.column).toBe(21)
        expect(arguments.last.range.end.column).toBe(24)
    }

