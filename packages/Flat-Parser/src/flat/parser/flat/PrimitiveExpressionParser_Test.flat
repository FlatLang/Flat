        let parsed = PrimitiveExpressionParser().parse([
            token("Array", Token.Type.IDENTIFIER, 1), token("<", Token.Type.SYMBOL, 6),
            token("Char", Token.Type.IDENTIFIER, 7), token(">", Token.Type.SYMBOL, 11),
            token("(", Token.Type.SYMBOL, 12), token(")", Token.Type.SYMBOL, 13),
            token(":", Token.Type.SYMBOL, 14), token("add", Token.Type.IDENTIFIER, 15),
            token("(", Token.Type.SYMBOL, 18), token("value", Token.Type.IDENTIFIER, 19),
            token(")", Token.Type.SYMBOL, 24)
        ], snapshot)
