            tokens.add(token("values", Token.Type.IDENTIFIER, 2))
            if (grouped) tokens.add(token(")", Token.Type.SYMBOL, 8))
            tokens.add(token("[", Token.Type.SYMBOL, 9))
            tokens.add(token("choose", Token.Type.IDENTIFIER, 10))
            tokens.add(token("?", Token.Type.SYMBOL, 17))
            tokens.add(token("0", Token.Type.INTEGER, 19))
            tokens.add(token(":", Token.Type.SYMBOL, 21))
            tokens.add(token("1", Token.Type.INTEGER, 23))
            tokens.add(token("]", Token.Type.SYMBOL, 24))
            let expression = PrimitiveExpressionParser().parse(tokens, snapshot)
            expect(expression.expressionKind()).toBe("array-access")
            expect(((PrimitiveArrayAccessSyntax)expression).index.expressionKind()).toBe("conditional")
            expect(expression.range.startTokenIndex).toBe(0)
            expect(expression.range.endTokenIndex).toBe(tokens.count)
        }
    }

