    test `parses explicit cast expression with source range`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-cast"), "revision:one"
        )
        let expression = PrimitiveExpressionParser().parse([
            token("(", Token.Type.SYMBOL, 1), token("Bool", Token.Type.IDENTIFIER, 2),
            token(")", Token.Type.SYMBOL, 6), token("other", Token.Type.IDENTIFIER, 7)
        ], snapshot)
        let cast = (PrimitiveCastSyntax)expression

        expect(cast.expressionKind()).toBe("cast")
        expect(cast.typeName).toBe("Bool")
