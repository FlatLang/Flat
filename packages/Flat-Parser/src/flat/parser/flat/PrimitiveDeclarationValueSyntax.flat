package flat/parser/flat

import flat/compiler/models

/** Local declaration whose initialized value participates in an enclosing expression. */
data class extends PrimitiveExpressionSyntax {
    public construct(
        SourceRange range,
        visible String name,
        visible PrimitiveExpressionSyntax value
    ) {
        if (!range || !name || name.trim().isEmpty || !value) {
            throw Exception("Primitive declaration value requires local name and value")
        }
        super(range)
    }
    override public expressionKind() => "declaration-value"
}
