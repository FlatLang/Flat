package flat/parser/flat

import flat/compiler/models

/** Balanced parser for the reduced trait signatures consumed by class binding. */
class {
    var Token[] tokens
    var Int index
    var SourceSnapshotIdentity snapshot
    var Int tokenIndexOffset

    public parseImplicit(
        Token[] tokenValues,
        SourceSnapshotIdentity sourceSnapshot,
        Int sourceTokenIndexOffset,
        String implicitName
    ) -> PrimitiveInterfaceSyntax {
        return parse(tokenValues, sourceSnapshot, sourceTokenIndexOffset, implicitName)
    }

    public parse(
        Token[] tokenValues,
        SourceSnapshotIdentity sourceSnapshot,
        Int sourceTokenIndexOffset = 0,
        String implicitName = null
    ) -> PrimitiveInterfaceSyntax {
        if (!tokenValues || !sourceSnapshot) {
            throw Exception("Reduced interface parsing requires tokens and snapshot")
        }
        tokens = tokenValues.filter((token) => {
            let type = token.type
            return type != Token.Type.WHITESPACE && type != Token.Type.COMMENT
        })
        if (implicitName && tokens.count > 1 && tokens[1].value != implicitName &&
            tokens[1].value != "<" && tokens[1].value != "{" &&
            tokens[1].value != "implements" && tokens[1].value != "extends") {
            let withoutPartitionName = Token[]
            withoutPartitionName.add(tokens.first)
            withoutPartitionName.addAll(tokens.skip(2))
            tokens = withoutPartitionName
        }
        snapshot = sourceSnapshot
        tokenIndexOffset = sourceTokenIndexOffset
        index = 0
        let start = index
        if (tokens[index].value != "trait" && tokens[index].value != "interface") {
            syntax("Expected trait or interface")
        }
        index++
        var String name
        if (index < tokens.count && implicitName &&
            (tokens[index].value == "<" || tokens[index].value == "{")) {
            name = implicitName
        } else name = identifier("Expected interface name")
        var String genericParameterName
        let genericParameters = String[]
        if (index < tokens.count && tokens[index].value == "<") {
            index++
            genericParameterName = identifier("Expected generic parameter")
            genericParameters.add(genericParameterName)
            while (index < tokens.count && tokens[index].value == ",") {
                index++
                let parameter = identifier("Expected generic parameter")
                if (genericParameters.contains(parameter)) syntax("Duplicate generic parameter '#parameter'")
                genericParameters.add(parameter)
            }
            require(">")
        }
        let parentTypes = String[]
        if (index < tokens.count && (tokens[index].value == "implements" || tokens[index].value == "extends")) {
            index++
            parentTypes.add(parseTypeName("Expected interface parent"))
            while (index < tokens.count && tokens[index].value == ",") {
                index++
                parentTypes.add(parseTypeName("Expected interface parent"))
            }
        }
        require("{")
        let methods = PrimitiveInterfaceMethodSyntax[]
        while (index < tokens.count && tokens[index].value != "}") {
            let memberStart = index
            var SourceRange nativeReturnRange
            var SourceRange nativeArrayReturnRange
            while (index < tokens.count && modifier(tokens[index].value)) {
                if (tokens[index].value == "native") {
                    if (nativeReturnRange) syntax("Duplicate native return modifier", index)
                    nativeReturnRange = range(index, index + 1)
                } else if (tokens[index].value == "native_array") {
                    if (nativeArrayReturnRange) syntax("Duplicate native_array return modifier", index)
                    nativeArrayReturnRange = range(index, index + 1)
                }
                index++
            }
            let storageProperty = index < tokens.count && tokens[index].value == "var"
            if (storageProperty) index++
            let memberTypeStart = index
            var Int propertyCursor = index
            var String propertyType
            if (propertyCursor < tokens.count &&
                tokens[propertyCursor].type == Token.Type.IDENTIFIER) {
                propertyType = parseTypeName("Expected interface member type")
                propertyCursor = index
                index = memberTypeStart
            }
            if (propertyType && propertyCursor < tokens.count &&
                tokens[propertyCursor].type == Token.Type.IDENTIFIER &&
                (propertyCursor + 1 >= tokens.count ||
                    tokens[propertyCursor + 1].value == "=>" ||
                    tokens[propertyCursor + 1].value == "}" ||
                    tokens[propertyCursor + 1].type == Token.Type.IDENTIFIER ||
                    modifier(tokens[propertyCursor + 1].value))) {
                let methodName = tokens[propertyCursor++].value
                index = propertyCursor
                var PrimitiveExpressionSyntax value
                if (index < tokens.count && tokens[index].value == "=>") {
                    index++
                    let expressionStart = index
                    while (index < tokens.count && tokens[index].value != "}" &&
                        !propertyBoundary(index)) index++
                    if (expressionStart == index) syntax("Expected interface property value")
                    value = PrimitiveExpressionParser().parse(
                        tokens.skip(expressionStart).take(index - expressionStart), snapshot,
                        expressionStart + tokenIndexOffset
                    )
                }
                validateNativeReturn(propertyType, nativeReturnRange, nativeArrayReturnRange)
                methods.add(PrimitiveInterfaceMethodSyntax(
                    methodName, String[], propertyType, range(memberStart, index), value,
                    storageProperty: storageProperty,
                    nativeReturnModifierRange: nativeReturnRange,
                    nativeArrayReturnModifierRange: nativeArrayReturnRange
                ))
                continue
            }
            if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) {
                let received = index < tokens.count ? tokens[index].value : "<end>"
                let previous = index > 0 ? tokens[index - 1].value : "<start>"
                syntax("Expected interface method name after '#previous' but received '#received'")
            }
            let methodName = identifier("Expected interface method name")
            if (index < tokens.count && tokens[index].value == "<") {
                index++
                identifier("Expected interface method generic parameter")
                while (index < tokens.count && tokens[index].value == ",") {
                    index++
                    identifier("Expected interface method generic parameter")
                }
                require(">")
            }
            require("(")
            let parameterTypes = String[]
            while (index < tokens.count && tokens[index].value != ")") {
                let typeName = parseParameterType()
                parameterTypes.add(typeName)
                if (index < tokens.count && tokens[index].value == "=") {
                    index++
                    var Int defaultBraceDepth
                    var Int defaultParenDepth
                    var Int defaultBracketDepth
                    let defaultStart = index
                    while (index < tokens.count) {
                        let value = tokens[index].value
                        if (defaultBraceDepth == 0 && defaultParenDepth == 0 && defaultBracketDepth == 0 &&
                            (value == "," || value == ")")) break
                        if (value == "{") defaultBraceDepth++
                        else if (value == "}") {
                            if (defaultBraceDepth == 0) syntax("Expected interface parameter default")
                            defaultBraceDepth--
                        } else if (value == "(") defaultParenDepth++
                        else if (value == ")") defaultParenDepth--
                        else if (value == "[") defaultBracketDepth++
                        else if (value == "]") defaultBracketDepth--
                        index++
                    }
                    if (index == defaultStart || defaultBraceDepth != 0 ||
                        defaultParenDepth != 0 || defaultBracketDepth != 0) {
                        syntax("Expected complete interface parameter default")
                    }
                }
                if (index >= tokens.count || tokens[index].value != ",") break
                index++
                if (index >= tokens.count || tokens[index].value == ")") {
                    syntax("Expected interface parameter after ','")
                }
            }
            require(")")
            var String returnType = "Unit"
            var PrimitiveExpressionSyntax defaultValue
            if (index < tokens.count && tokens[index].value == "->") {
                index++
                returnType = parseTypeName("Expected interface return type")
            } else if (index < tokens.count && tokens[index].value == "=>") {
                returnType = "Unknown"
                index++
                let expressionStart = index
                if (index + 1 < tokens.count && tokens[index].value == "this" &&
                    tokens[index + 1].value == "{") {
                    index++
                } else {
                    var Int expressionBraceDepth
                    while (index < tokens.count) {
                        if (tokens[index].value == "{" && expressionBraceDepth == 0 &&
                            index > expressionStart && tokens[index - 1].value != "(") break
                        if (tokens[index].value == "{") expressionBraceDepth++
                        else if (tokens[index].value == "}") {
                            if (expressionBraceDepth == 0) break
                            expressionBraceDepth--
                        }
                        if (expressionBraceDepth == 0 && propertyBoundary(index)) break
                        index++
                    }
                }
                if (expressionStart == index) syntax("Expected interface method expression")
                try {
                    defaultValue = PrimitiveExpressionParser().parse(
                        tokens.skip(expressionStart).take(index - expressionStart), snapshot,
                        expressionStart + tokenIndexOffset
                    )
                } catch (Exception error) {
                    throw Exception("Primitive interface method '#methodName' failed: #{error.message}")
                }
            } else if (index < tokens.count && tokens[index].value != "{" &&
                tokens[index].value != "}" && tokens[index].type != Token.Type.IDENTIFIER) {
                syntax("Expected interface return type or body")
            }
            validateNativeReturn(returnType, nativeReturnRange, nativeArrayReturnRange)
            if (index < tokens.count && tokens[index].value == "=>") {
                index++
                let expressionStart = index
                while (index < tokens.count && tokens[index].value != "{" &&
                    tokens[index].value != "}" && !modifier(tokens[index].value) &&
                    !propertyBoundary(index)) index++
                if (expressionStart == index) syntax("Expected interface method expression")
                try {
                    defaultValue = PrimitiveExpressionParser().parse(
                        tokens.skip(expressionStart).take(index - expressionStart), snapshot,
                        expressionStart + tokenIndexOffset
                    )
                } catch (Exception error) {
                    throw Exception("Primitive interface method '#methodName' failed: #{error.message}")
                }
            }
            var Bool bracedBody
            if (index < tokens.count && tokens[index].value == "{") {
                bracedBody = true
                index++
                var Int bodyDepth = 1
                while (index < tokens.count && bodyDepth > 0) {
                    if (tokens[index].value == "{") bodyDepth++
                    else if (tokens[index].value == "}") bodyDepth--
                    index++
                }
                if (bodyDepth != 0) syntax("Expected closing interface method body")
            }
            methods.add(PrimitiveInterfaceMethodSyntax(
                methodName, parameterTypes, returnType, range(memberStart, index), defaultValue,
                (bracedBody || defaultValue) ? tokens.skip(memberStart).take(index - memberStart) : Token[],
                signatureTokens: (bracedBody || defaultValue) ? Token[] : tokens.skip(memberStart).take(index - memberStart),
                nativeReturnModifierRange: nativeReturnRange,
                nativeArrayReturnModifierRange: nativeArrayReturnRange
            ))
        }
        require("}")
        if (index != tokens.count) syntax("Unexpected interface tokens")
        return PrimitiveInterfaceSyntax(range(start, index), name, genericParameterName, methods, genericParameters, parentTypes)
    }

    validateNativeReturn(String typeName, SourceRange scalarRange, SourceRange arrayRange) {
        if (arrayRange && !typeName.endsWith("[]")) {
            syntax("native_array return modifier requires an array return type",
                arrayRange.startTokenIndex - tokenIndexOffset)
        }
        if (scalarRange && (typeName == "Unit" || typeName == "Unknown")) {
            syntax("Native return modifier requires an explicit return type",
                scalarRange.startTokenIndex - tokenIndexOffset)
        }
    }

    parseParameterType() -> String {
        var Bool asyncType
        while (index < tokens.count && (tokens[index].value == "native" ||
            tokens[index].value == "native_array")) index++
        if (index < tokens.count && tokens[index].value == "var") index++
        if (index < tokens.count && tokens[index].value == "async") {
            asyncType = true
            index++
        }
        var String result = parseTypeName("Expected interface parameter type")
        if (index < tokens.count && tokens[index].value == "(") {
            result += "("
            index++
            var Bool first = true
            while (index < tokens.count && tokens[index].value != ")") {
                if (!first) result += ","
                result += parseTypeName("Expected function parameter type")
                identifier("Expected function parameter name")
                first = false
                if (index >= tokens.count || tokens[index].value != ",") break
                index++
            }
            require(")")
            result += ")"
            if (index < tokens.count && tokens[index].value == "->") {
                index++
                result += "->" + parseTypeName("Expected function return type")
            }
        } else {
            if (index < tokens.count && tokens[index].value == ":") index++
            identifier("Expected interface parameter name")
        }
        if (asyncType) result = "async " + result
        return result
    }

    parseTypeName(String message) -> String {
        var String result = identifier(message)
        while (index < tokens.count && tokens[index].value == ".") {
            index++
            result += "." + identifier("Expected qualified interface type name")
        }
        if (index < tokens.count && tokens[index].value == "<") {
            result += "<"
            index++
            result += parseTypeName("Expected generic interface type argument")
            while (index < tokens.count && tokens[index].value == ",") {
                index++
                result += "," + parseTypeName("Expected generic interface type argument")
            }
            require(">")
            result += ">"
        }
        while (index + 1 < tokens.count && tokens[index].value == "[" &&
            tokens[index + 1].value == "]") {
            result += "[]"
            index += 2
        }
        if (index < tokens.count && tokens[index].value == "?") {
            result += "?"
            index++
        }
        return result
    }

    propertyBoundary(Int cursor) -> Bool {
        if (cursor + 2 >= tokens.count) return false
        var Int candidate = cursor
        var Bool modified
        while (candidate < tokens.count && modifier(tokens[candidate].value)) {
            modified = true
            candidate++
        }
        if (candidate >= tokens.count ||
            tokens[candidate].type != Token.Type.IDENTIFIER) return false
        if (modified && candidate + 1 < tokens.count &&
            tokens[candidate + 1].value == "(") return true
        return candidate + 2 < tokens.count &&
            tokens[candidate + 1].type == Token.Type.IDENTIFIER &&
            (tokens[candidate + 2].value == "=>" || tokens[candidate + 2].value == "(")
    }

    modifier(String value) -> Bool =>
        value == "public" || value == "private" || value == "protected" ||
            value == "visible" || value == "async" || value == "override" ||
            value == "abstract" || value == "native" || value == "native_array" ||
            value == "external_name"

    identifier(String message) -> String {
        if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) syntax(message)
        return tokens[index++].value
    }

    requireAt(String value, Int cursor) {
        if (cursor >= tokens.count || tokens[cursor].value != value) {
            syntax("Expected '#value'")
        }
    }

    require(String value) {
        if (index >= tokens.count || tokens[index].value != value) syntax("Expected '#value'")
        index++
    }

    range(Int start, Int end) -> SourceRange {
        let first = tokens[start]
        let last = tokens[end - 1]
        return SourceRange(
            snapshot, start + tokenIndexOffset, end + tokenIndexOffset,
            first.location, Location(lineNumber: last.endLineNumber, column: last.endColumn)
        )
    }

    syntax(String message, Int tokenIndex = -1) {
        let errorIndex = (tokenIndex < 0 ? index : tokenIndex) + tokenIndexOffset
        throw Exception("Primitive interface syntax error at token #errorIndex: #message")
    }
}
