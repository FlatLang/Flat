package flat/parser/flat

import flat/compiler/models

/** Immutable syntax for one switch label and its owned statements. */
data class {
    var PrimitiveStatementSyntax[] body

    public construct(
        visible SourceRange range,
        visible PrimitiveExpressionSyntax label,
        PrimitiveStatementSyntax[] statements,
        visible Bool defaultCase = false,
        visible Bool fallsThrough = false
    ) {
        if (!range || (defaultCase == (label != null)) || !statements ||
            statements.any({ !_ }) || (fallsThrough && statements.isNotEmpty)) {
            throw Exception("Primitive switch case requires one label/default and valid body")
        }
        body = PrimitiveStatementSyntax[]
        body.addAll(statements)
    }

    public statementValues() -> PrimitiveStatementSyntax[] =>
        PrimitiveStatementSyntax[]:addAll(body)
}
