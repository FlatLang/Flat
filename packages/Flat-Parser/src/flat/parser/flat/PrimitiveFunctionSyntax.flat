package flat/parser/flat

import flat/compiler/models

/** Immutable syntax-only independently bindable function declaration. */
data class {
    var PrimitiveFunctionParameterSyntax[] parameters
    var PrimitiveStatementSyntax[] body
    var String[] genericNames

    public construct(
        visible SourceRange range,
        visible String name,
        PrimitiveFunctionParameterSyntax[] parameterValues,
        visible String returnTypeName,
        PrimitiveStatementSyntax[] statements,
        visible Bool staticMethod = false,
        visible Bool inferredReturnType = false,
        visible Bool asyncMethod = false,
        visible String externalName = null,
        visible Bool abstractMethod = false,
        String[] genericParameterNameValues = String[],
        visible Bool lazyProperty = false
    ) {
        if (!range || !name || name.trim().count == 0 || !parameterValues ||
            parameterValues.any({ !_ }) || !returnTypeName ||
            returnTypeName.trim().count == 0 || !statements || statements.any({ !_ }) ||
            (externalName != null && externalName.trim().isEmpty)) {
            throw Exception("Primitive function syntax requires range, signature, and body")
        }
        genericNames = String[]
        if (!genericParameterNameValues || genericParameterNameValues.any((candidate) => !candidate || candidate.trim().isEmpty)) {
            throw Exception("Primitive function generic parameters require names")
        }
        for (genericName in genericParameterNameValues) {
            if (genericNames.contains(genericName)) throw Exception("Duplicate function generic parameter '#genericName'")
            genericNames.add(genericName)
        }
        parameters = PrimitiveFunctionParameterSyntax[]
        parameters.addAll(parameterValues)
        body = PrimitiveStatementSyntax[]
        body.addAll(statements)
    }

    public genericParameterNames() -> String[] {
        let result = String[]
        result.addAll(genericNames)
        return result
    }

    public parameterValues() -> PrimitiveFunctionParameterSyntax[] {
        let result = PrimitiveFunctionParameterSyntax[]
        result.addAll(parameters)
        return result
    }

    public statements() -> PrimitiveStatementSyntax[] {
        let result = PrimitiveStatementSyntax[]
        result.addAll(body)
        return result
    }
}
