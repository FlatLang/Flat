package flat/parser/flat

import flat/compiler/models

/** Parses all Flat string interpolation segments without target-specific lowering. */
class {
    public parse(
        Token token,
        SourceSnapshotIdentity snapshot,
        Int tokenIndex
    ) -> PrimitiveStringExpressionSyntaxResult {
        if (!token || token.type != Token.Type.STRING || !snapshot || tokenIndex < 0 || !token.location) {
            throw Exception("String interpolation parsing requires a ranged string token")
        }
        let source = token.value
        let segments = PrimitiveInterpolatedStringSegmentSyntax[]
        var Int cursor = 1
        var Int literalStart = cursor
        let contentEnd = source.count - 1
        while (cursor < contentEnd) {
            if (source.chars[cursor] != '#') {
                cursor++
                continue
            }
            if (cursor > literalStart) {
                segments.add(literal(token, snapshot, tokenIndex, literalStart, cursor))
            }
            let interpolationStart = cursor
            cursor++
            var Int expressionStart = cursor
            var Int expressionEnd
            if (cursor < contentEnd && source.substring(cursor, cursor + 1) == "{") {
                cursor++
                expressionStart = cursor
                var Int depth = 1
                while (cursor < contentEnd && depth > 0) {
                    let value = source.substring(cursor, cursor + 1)
                    if (value == "{") depth++
                    else if (value == "}") depth--
                    if (depth > 0) cursor++
                }
                if (depth != 0) invalid("Unterminated braced string interpolation")
                expressionEnd = cursor
                cursor++
            } else {
                while (cursor < contentEnd && interpolationPart(source.substring(cursor, cursor + 1))) {
                    cursor++
                }
                expressionEnd = cursor
            }
            if (expressionStart == expressionEnd) invalid("String interpolation requires an expression")
            let expressionSource = source.substring(expressionStart, expressionEnd)
            let expression = expressionSyntax(
                expressionSource,
                range(token, snapshot, tokenIndex, expressionStart, expressionEnd),
                tokenIndex, location(token, expressionStart)
            )
            segments.add(PrimitiveInterpolatedStringSegmentSyntax(
                range(token, snapshot, tokenIndex, interpolationStart, cursor),
                null,
                expression
            ))
            literalStart = cursor
        }
        if (literalStart < contentEnd) {
            segments.add(literal(token, snapshot, tokenIndex, literalStart, contentEnd))
        }
        if (!segments.any({ !_.literal() })) {
            invalid("Interpolated string parser requires an interpolation marker")
        }
        let interpolationObject = (Object)PrimitiveInterpolatedStringSyntax(
            range(token, snapshot, tokenIndex, 0, source.count), segments
        )
        let expression = (PrimitiveExpressionSyntax)interpolationObject
        return PrimitiveStringExpressionSyntaxResult(expression)
    }

    literal(
        Token token,
        SourceSnapshotIdentity snapshot,
        Int tokenIndex,
        Int start,
        Int end
    ) -> PrimitiveInterpolatedStringSegmentSyntax {
        return PrimitiveInterpolatedStringSegmentSyntax(
            range(token, snapshot, tokenIndex, start, end),
            "\"" + token.value.substring(start, end) + "\"",
            null
        )
    }

    public expressionSyntax(
        String source,
        SourceRange sourceRange,
        Int tokenIndex,
        Location start
    ) -> PrimitiveExpressionSyntax {
        let parts = source.split(".")
        if (parts.isNotEmpty && parts.all({ identifier(_) })) {
            return PrimitiveInterpolationPathSyntax(sourceRange, parts)
        }
        let tokens = expressionTokens(source, start)
        try {
            return PrimitiveExpressionParser().parse(
                tokens, sourceRange.snapshot, tokenIndex, sourceRange
            )
        } catch (Exception error) {
            let prefix = "Primitive expression syntax error at token "
            if (error.message.startsWith(prefix) && error.message.contains(":")) {
                invalid(error.message.substring(error.message.indexOf(":") + 2))
            }
            invalid(error.message)
        }
    }

    expressionTokens(String source, Location start) -> Token[] {
        let tokens = Token[]
        var Int cursor
        var Int line = start.lineNumber
        var Int column = start.column
        while (cursor < source.count) {
            let value = source.substring(cursor, cursor + 1)
            if (" \t\r\n".contains(value)) {
                if (value == "\n") {
                    line++
                    column = 1
                } else column++
                cursor++
                continue
            }
            let tokenLine = line
            let tokenColumn = column
            let tokenStart = cursor
            var Int type
            if (value == "\"" || value == "'") {
                let quote = value
                cursor++
                column++
                var Bool escaped
                var Bool closed
                while (cursor < source.count && !closed) {
                    let next = source.substring(cursor, cursor + 1)
                    cursor++
                    if (next == "\n") {
                        line++
                        column = 1
                    } else column++
                    if (escaped) escaped = false
                    else if (next == "\\") escaped = true
                    else if (next == quote) closed = true
                }
                if (!closed) invalid("Unterminated literal in string interpolation")
                type = quote == "\"" ? Token.Type.STRING : Token.Type.CHAR
            } else if ("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_".contains(value)) {
                cursor++
                column++
                while (cursor < source.count &&
                    "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789".contains(
                        source.substring(cursor, cursor + 1)
                    )) {
                    cursor++
                    column++
                }
                let word = source.substring(tokenStart, cursor)
                if (word == "true" || word == "false") type = Token.Type.BOOL
                else if (word == "null") type = Token.Type.NULL
                else type = Token.Type.IDENTIFIER
            } else if ("0123456789".contains(value)) {
                var Bool decimal
                cursor++
                column++
                while (cursor < source.count) {
                    let next = source.substring(cursor, cursor + 1)
                    if ("0123456789".contains(next)) {
                        cursor++
                        column++
                    } else if (next == "." && !decimal && cursor + 1 < source.count &&
                        "0123456789".contains(source.substring(cursor + 1, cursor + 2))) {
                        decimal = true
                        cursor++
                        column++
                    } else break
                }
                type = decimal ? Token.Type.FLOAT : Token.Type.INTEGER
            } else {
                let pair = cursor + 1 < source.count ? source.substring(cursor, cursor + 2) : ""
                let pairs = [
                    "==", "!=", "<=", ">=", "&&", "||",
                    "++", "--", "+=", "-=", "*=", "/="
                ]
                if (pairs.contains(pair)) {
                    cursor += 2
                    column += 2
                } else {
                    cursor++
                    column++
                }
                type = Token.Type.SYMBOL
            }
            tokens.add(Token(
                value: source.substring(tokenStart, cursor),
                type: type,
                location: Location(lineNumber: tokenLine, column: tokenColumn)
            ))
        }
        if (tokens.isEmpty) invalid("String interpolation requires an expression")
        return tokens
    }

    interpolationPart(String value) -> Bool =>
        "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789.".contains(value)

    identifier(String value) -> Bool {
        if (!value || value.isEmpty) return false
        let first = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"
        let rest = first + "0123456789"
        if (!first.contains(value.substring(0, 1))) return false
        var Int index = 1
        while (index < value.count) {
            if (!rest.contains(value.substring(index, index + 1))) return false
            index++
        }
        return true
    }

    range(
        Token token,
        SourceSnapshotIdentity snapshot,
        Int tokenIndex,
        Int start,
        Int end
    ) -> SourceRange {
        return SourceRange(
            snapshot, tokenIndex, tokenIndex + 1,
            location(token, start), location(token, end)
        )
    }

    location(Token token, Int offset) -> Location {
        var Int line = token.location.lineNumber
        var Int column = token.location.column
        var Int index
        while (index < offset) {
            if (token.value.substring(index, index + 1) == "\n") {
                line++
                column = 1
            } else column++
            index++
        }
        return Location(lineNumber: line, column: column)
    }

    invalid(String message) {
        throw Exception(message)
    }
}
