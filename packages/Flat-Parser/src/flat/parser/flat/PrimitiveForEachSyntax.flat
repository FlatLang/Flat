package flat/parser/flat

import flat/compiler/models

/** Syntax-only foreach over either an exclusive integer range or a collection expression. */
data class extends PrimitiveStatementSyntax {
    var PrimitiveStatementSyntax[] bodyStatements

    public construct(
        SourceRange range,
        visible String indexName,
        visible PrimitiveExpressionSyntax rangeStart,
        visible PrimitiveExpressionSyntax rangeEnd,
        PrimitiveStatementSyntax[] bodyValues,
        visible PrimitiveExpressionSyntax collection = null
    ) {
        let rangeLoop = rangeStart && rangeEnd && !collection
        let collectionLoop = collection && !rangeStart && !rangeEnd
        if (!range || !indexName || indexName.trim().isEmpty ||
            (!rangeLoop && !collectionLoop) || !bodyValues || bodyValues.any({ !_ })) {
            throw Exception("Primitive foreach syntax requires iterator, source, and body")
        }
        bodyStatements = PrimitiveStatementSyntax[]
        bodyStatements.addAll(bodyValues)
        super(range)
    }

    public bodyValues() -> PrimitiveStatementSyntax[] =>
        PrimitiveStatementSyntax[]:addAll(bodyStatements)
    public collectionLoop() -> Bool => collection != null
    override public statementKind() => "foreach"
}
