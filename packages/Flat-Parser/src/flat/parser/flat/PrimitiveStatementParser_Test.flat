package flat/parser/flat

import flat/compiler/models
import flat/lexer/Lexer

testable class {
    async test `outer returns preserve nested statement lambda semicolons and generic member calls`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:nested-return-boundary"), "one")
        let variants = ["", "<Int>"]
        for (typeArguments in variants) {
            let source = "return Future.from" + typeArguments + "({ return 0; }); return 1;"
            let stream = Lexer().lex(source)
            stream.emit("start")
            let values = stream.consumeAll<Token>("data")
            let shift = typeArguments.isEmpty ? 0 : 3
            let statements = PrimitiveStatementParser().parse(values, snapshot, 40).statements()
            expect(statements.count).toBe(2)
            let returned = (PrimitiveReturnSyntax)statements[0]
            let callObject = (Object)returned.value
            let call = (PrimitiveMemberCallSyntax)callObject
            let argument = call.argumentValues()[0]
            let lambda = (PrimitiveLambdaSyntax)argument
            let innerStatements = lambda.statementValues()
            expect(innerStatements.count).toBe(1)
            let innerReturn = (PrimitiveReturnSyntax)innerStatements[0]
            let literalObject = (Object)innerReturn.value
            let literal = (PrimitiveLiteralSyntax)literalObject
            expect(literal.sourceValue).toBe("0")
            expect(call.memberName).toBe("from")
            expect(call.typeArgumentNames().count).toBe(typeArguments.isEmpty ? 0 : 1)
            expect(returned.range.startTokenIndex).toBe(40)
            expect(returned.range.endTokenIndex).toBe(51 + shift)
            expect(lambda.range.startTokenIndex).toBe(45 + shift)
            expect(lambda.range.endTokenIndex).toBe(50 + shift)
            expect(innerReturn.range.startTokenIndex).toBe(46 + shift)
            expect(innerReturn.range.endTokenIndex).toBe(48 + shift)
            expect(returned.range.start.column).toBe(1)
            expect(returned.range.end.column).toBe(source.indexOf("; return 1;") + 1)
            expect(innerReturn.range.start.column).toBe(source.indexOf("return 0") + 1)
            expect(innerReturn.range.end.column).toBe(source.indexOf("0;") + 2)
            expect(statements[1].range.startTokenIndex).toBe(52 + shift)
            // Exercise the delegating entry point used by class/body parsing too.
            let delegated = PrimitiveControlStatementParser().parse(values, snapshot, 40).statements()
            expect(delegated.count).toBe(2)
            let delegatedReturn = (PrimitiveReturnSyntax)delegated[0]
            let delegatedCallObject = (Object)delegatedReturn.value
            let delegatedCall = (PrimitiveMemberCallSyntax)delegatedCallObject
            let delegatedArgument = delegatedCall.argumentValues()[0]
            let delegatedLambda = (PrimitiveLambdaSyntax)delegatedArgument
            expect(delegatedLambda.statementValues().count).toBe(1)
            expect(delegatedLambda.range.startTokenIndex).toBe(45 + shift)
        }
    }

    async test `nested brackets parentheses and braces retain only outer statement boundaries`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:three-delimiters"), "one")
        let source = "return Future.from({ return [Future.from({ return 0; })]; }); return 1;"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let statements = PrimitiveStatementParser().parse(stream.consumeAll<Token>("data"), snapshot).statements()
        expect(statements.count).toBe(2)
        let returned = (PrimitiveReturnSyntax)statements[0]
        let callObject = (Object)returned.value
        let call = (PrimitiveMemberCallSyntax)callObject
        let argument = call.argumentValues()[0]
        let lambda = (PrimitiveLambdaSyntax)argument
        expect(lambda.statementValues().count).toBe(1)
        let innerStatement = lambda.statementValues()[0]
        let inner = (PrimitiveReturnSyntax)innerStatement
        expect(inner.value.expressionKind()).toBe("array")
    }

    async test `lexer strings and comments containing delimiters do not truncate nested lambda returns`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:nested-opaque-delimiters"), "one")
        var String source = "return Future.from({ /* ; ) ] } */ return \""
        source += '#'
        source += "{value} ; ) ] }\"; }); return 1;"
        let stream = Lexer().lex(source)
        stream.emit("start")
        let statements = PrimitiveStatementParser().parse(stream.consumeAll<Token>("data"), snapshot).statements()
        expect(statements.count).toBe(2)
        let returned = (PrimitiveReturnSyntax)statements[0]
        let callObject = (Object)returned.value
        let call = (PrimitiveMemberCallSyntax)callObject
        let argument = call.argumentValues()[0]
        let lambda = (PrimitiveLambdaSyntax)argument
        let innerStatements = lambda.statementValues()
        expect(innerStatements.count).toBe(1)
        let innerReturn = (PrimitiveReturnSyntax)innerStatements[0]
        let innerValue = innerReturn.value
        expect(innerValue.expressionKind()).toBe("interpolated-string")
    }

    test `literal interpolation and comment token contents are opaque to statement splitting`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:opaque-delimiters"), "one")
        var String interpolation = "\""
        interpolation += '#'
        interpolation += "{value}\""
        let values = [
            token("return", Token.Type.IDENTIFIER, 1),
            token("\"; ) ] }\"", Token.Type.STRING, 8), token(";", Token.Type.SYMBOL, 17),
            token("; ) ] }", Token.Type.COMMENT, 18),
            token("return", Token.Type.IDENTIFIER, 26), token("';'", Token.Type.CHAR, 33),
            token(";", Token.Type.SYMBOL, 36),
            token("return", Token.Type.IDENTIFIER, 38), token(interpolation, Token.Type.STRING, 45),
            token(";", Token.Type.SYMBOL, 60)
        ]
        let statements = PrimitiveStatementParser().parse(values, snapshot, 10).statements()
        expect(statements.count).toBe(3)
        let last = (PrimitiveReturnSyntax)statements[2]
        let lastValue = last.value
        expect(lastValue.expressionKind()).toBe("interpolated-string")
        expect(last.range.startTokenIndex).toBe(16)
        expect(last.range.endTokenIndex).toBe(18)
    }

    async test `statement delimiter diagnostics identify mismatches unexpected closers and EOF`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:bad-statement-delimiters"), "one")
        let sources = ["return call(];", "return [1);", "return { return 0; ];", "return 0);", "return call({ return 0;"]
        let positions = ["43..44", "43..44", "45..46", "42..43", "47..47"]
        let reasons = ["Expected ')'", "Expected ']'", "Expected '}'", "Unexpected closing", "at token 43"]
        let parser = PrimitiveStatementParser()
        for (index in 0..sources.count) {
            let stream = Lexer().lex(sources[index])
            stream.emit("start")
            var String message
            try { parser.parse(stream.consumeAll<Token>("data"), snapshot, 40) }
            catch (Exception error) { message = error.message }
            expect(message.contains("Primitive statement syntax error at " + positions[index])).toBe(true)
            expect(message.contains(reasons[index])).toBe(true)
        }
        let recovered = parser.parse([
            token("return", Token.Type.IDENTIFIER, 1), token("1", Token.Type.INTEGER, 8)
        ], snapshot, 90).statements()
        expect(recovered.count).toBe(1)
        expect(recovered[0].range.startTokenIndex).toBe(90)
        expect(recovered[0].range.endTokenIndex).toBe(92)
    }

    test `retains native scalar local evidence in both modifier orders`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:scalar-native-local"), "one")
        let first = PrimitiveStatementParser().parse([
            token("native", Token.Type.IDENTIFIER, 1), token("var", Token.Type.IDENTIFIER, 8),
            token("Out", Token.Type.IDENTIFIER, 12), token("data", Token.Type.IDENTIFIER, 16)
        ], snapshot, 30).statements().first
        let local = (PrimitiveLocalDeclarationSyntax)first
        expect(local.nativeScalarStorage).toBe(true)
        expect(local.nativeArrayStorage).toBe(false)
        expect(local.declaredTypeName).toBe("Out")
        expect(local.range.startTokenIndex).toBe(30)
        expect(local.range.endTokenIndex).toBe(34)
        expect(local.range.start.column).toBe(1)
        expect(local.range.end.column).toBe(20)
        let second = PrimitiveStatementParser().parse([
            token("var", Token.Type.IDENTIFIER, 1), token("native", Token.Type.IDENTIFIER, 5),
            token("String", Token.Type.IDENTIFIER, 12), token("text", Token.Type.IDENTIFIER, 19)
        ], snapshot).statements().first
        expect(((PrimitiveLocalDeclarationSyntax)second).nativeScalarStorage).toBe(true)
        let ordinary = PrimitiveLocalDeclarationSyntax(local.range, true, "ordinary", null, "String")
        expect(ordinary.nativeScalarStorage).toBe(false)
    }
    test `retains native array storage after var native modifiers`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:storage-order"), "one")
        let values = [token("var", Token.Type.IDENTIFIER, 1),
            token("native", Token.Type.IDENTIFIER, 5), token("native_array", Token.Type.IDENTIFIER, 12),
            token("Char", Token.Type.IDENTIFIER, 25), token("[", Token.Type.SYMBOL, 29),
            token("]", Token.Type.SYMBOL, 30), token("chars", Token.Type.IDENTIFIER, 32)]
        let parsed = PrimitiveStatementParser().parse(values, snapshot, 30).statements().first
        let local = (PrimitiveLocalDeclarationSyntax)parsed
        expect(local.nativeArrayStorage).toBe(true)
        expect(local.nativeScalarStorage).toBe(false)
        expect(local.mutable).toBe(true)
        expect(local.declaredTypeName).toBe("Char[]")
        expect(local.range.startTokenIndex).toBe(30)
        expect(local.range.endTokenIndex).toBe(37)
    }

    test `parses call receiver compound field statement`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:call-field-store"), "one")
        let parsed = PrimitiveStatementParser().parse([
            token("next", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 5),
            token(")", Token.Type.SYMBOL, 6), token(".", Token.Type.SYMBOL, 7),
            token("count", Token.Type.IDENTIFIER, 8), token("+=", Token.Type.SYMBOL, 14),
            token("2", Token.Type.INTEGER, 17)
        ], snapshot, 30).statements().first
        let assignment = (PrimitiveMemberAssignmentSyntax)parsed
        expect(assignment.target.receiver.class.isOfType(PrimitiveCallSyntax.class)).toBe(true)
        expect(assignment.assignmentOperator).toBe("+=")
        expect(assignment.range.startTokenIndex).toBe(30)
        expect(assignment.range.endTokenIndex).toBe(37)
    }
    test `parses native storage local`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:native-local"), "one")
        let parsed = PrimitiveStatementParser().parse([
            token("native", Token.Type.IDENTIFIER, 1), token("var", Token.Type.IDENTIFIER, 8),
            token("Out", Token.Type.IDENTIFIER, 12), token("data", Token.Type.IDENTIFIER, 16)
        ], snapshot, 30).statements().first
        let local = (PrimitiveLocalDeclarationSyntax)parsed
        expect(local.name).toBe("data")
        expect(local.declaredTypeName).toBe("Out")
        expect(local.range.startTokenIndex).toBe(30)
        expect(local.range.endTokenIndex).toBe(34)
    }

    test `parses direct array local`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:array-local"), "one")
        let values = [token("Type", Token.Type.IDENTIFIER, 1), token("[", Token.Type.SYMBOL, 5),
            token("]", Token.Type.SYMBOL, 6), token("list", Token.Type.IDENTIFIER, 8),
            token("=", Token.Type.SYMBOL, 13), token("Type", Token.Type.IDENTIFIER, 15),
            token("[", Token.Type.SYMBOL, 19), token("]", Token.Type.SYMBOL, 20)]
        let parsed = PrimitiveStatementParser().parse(values, snapshot, 30).statements().first
        let local = (PrimitiveLocalDeclarationSyntax)parsed
        expect(local.name).toBe("list")
        expect(local.declaredTypeName).toBe("Type[]")
        expect(local.range.startTokenIndex).toBe(30)
        expect(local.range.endTokenIndex).toBe(38)
        var String failure
        try {
            PrimitiveStatementParser().parse(values.take(5), snapshot, 30)
        } catch (Exception error) {
            failure = error.message
        }
        expect(failure != null).toBe(true)
    }

    test `parses receiver owned call as expression statement`() {
        let delegationSnapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:constructor-delegation-parse"), "revision:one"
        )
        let delegation = PrimitiveStatementParser().parse([
            token("this", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 5),
            token("value", Token.Type.IDENTIFIER, 6), token(")", Token.Type.SYMBOL, 11),
            token(";", Token.Type.SYMBOL, 12)
        ], delegationSnapshot)
        expect(delegation.statements().first.statementKind())
            .toBe("constructor-delegation")

        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:member-call-statement"), "revision:one"
        )
        let parsed = PrimitiveStatementParser().parse([
            token("strs", Token.Type.IDENTIFIER, 1), token(".", Token.Type.SYMBOL, 5),
            token("add", Token.Type.IDENTIFIER, 6), token("(", Token.Type.SYMBOL, 9),
            token("substring", Token.Type.IDENTIFIER, 10), token("(", Token.Type.SYMBOL, 19),
            token("lastI", Token.Type.IDENTIFIER, 20), token(",", Token.Type.SYMBOL, 25),
            token("i", Token.Type.IDENTIFIER, 27), token(")", Token.Type.SYMBOL, 28),
            token(")", Token.Type.SYMBOL, 29)
        ], snapshot)
        let statements = parsed.statements()
        let statementObject = (Object)statements.first
        let statement = (PrimitiveExpressionStatementSyntax)statementObject

        expect(statement.statementKind()).toBe("expression")
        expect(statement.expression.expressionKind()).toBe("member-call")
    }

    test `parses continue statement`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:continue"), "revision:one"
        )
        let parsed = PrimitiveStatementParser().parse([
            token("continue", Token.Type.IDENTIFIER, 1)
        ], snapshot)

        expect(parsed.statements().first.statementKind()).toBe("continue")
    }

    test `parses native array local without var modifier`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:native-array-local-no-var"), "revision:one"
        )
        let result = PrimitiveStatementParser().parse([
            token("native_array", Token.Type.IDENTIFIER, 1),
            token("native", Token.Type.IDENTIFIER, 14),
            token("Char", Token.Type.IDENTIFIER, 21),
            token("[", Token.Type.SYMBOL, 25), token("]", Token.Type.SYMBOL, 26),
            token("buf", Token.Type.IDENTIFIER, 28)
        ], snapshot)
        let statements = result.statements()
        let localObject = (Object)statements.first
        let local = (PrimitiveLocalDeclarationSyntax)localObject

        expect(local.name).toBe("buf")
        expect(local.declaredTypeName).toBe("Char[]")
        expect(local.nativeArrayStorage).toBe(true)
    }

    test `parses array element assignment with indexed value`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-array-assignment"), "revision:one"
        )
        let result = PrimitiveStatementParser().parse([
            token("array", Token.Type.IDENTIFIER, 1), token("[", Token.Type.SYMBOL, 6),
            token("count", Token.Type.IDENTIFIER, 7), token("-", Token.Type.SYMBOL, 13),
            token("i", Token.Type.IDENTIFIER, 15), token("-", Token.Type.SYMBOL, 17),
            token("1", Token.Type.INTEGER, 19), token("]", Token.Type.SYMBOL, 20),
            token("=", Token.Type.SYMBOL, 22), token("this", Token.Type.IDENTIFIER, 24),
            token("[", Token.Type.SYMBOL, 28), token("i", Token.Type.IDENTIFIER, 29),
            token("]", Token.Type.SYMBOL, 30)
        ], snapshot)
        let statements = result.statements()
        let assignmentObject = (Object)statements.first
        let assignment = (PrimitiveArrayAssignmentSyntax)assignmentObject

        expect(assignment.statementKind()).toBe("array-assignment")
        expect(assignment.target.index.expressionKind()).toBe("binary")
        expect(assignment.value.expressionKind()).toBe("array-access")
    }

    test `parses syntax only locals assignments and returns`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-statements"), "revision:one"
        )
        let result = PrimitiveStatementParser().parse([
            token("let", Token.Type.IDENTIFIER, 1),
            token("value", Token.Type.IDENTIFIER, 5),
            token("=", Token.Type.SYMBOL, 11),
            token("1", Token.Type.INTEGER, 13),
            token(";", Token.Type.SYMBOL, 14),
            token("value", Token.Type.IDENTIFIER, 16),
            token("=", Token.Type.SYMBOL, 22),
            token("2", Token.Type.INTEGER, 24),
            token(";", Token.Type.SYMBOL, 25),
            token("return", Token.Type.IDENTIFIER, 27),
            token("value", Token.Type.IDENTIFIER, 34),
            token(";", Token.Type.SYMBOL, 39)
        ], snapshot)
        let statements = result.statements()
        let declaration = (PrimitiveLocalDeclarationSyntax)statements[0]
        let assignment = (PrimitiveAssignmentSyntax)statements[1]

        expect(statements.map({ _.statementKind() })).toBe([
            "local-declaration", "assignment", "return"
        ])
        expect(declaration.range.start.column).toBe(1)
        expect(declaration.range.end.column).toBe(14)
    }

    test `parses compound and update assignments as assignment evidence`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-compound-assignments"), "revision:one"
        )
        let divided = PrimitiveStatementParser().parse([
            token("number", Token.Type.IDENTIFIER, 1),
            token("/=", Token.Type.SYMBOL, 8),
            token("10", Token.Type.INTEGER, 11)
        ], snapshot)
        let incremented = PrimitiveStatementParser().parse([
            token("size", Token.Type.IDENTIFIER, 1),
            token("++", Token.Type.SYMBOL, 5)
        ], snapshot)
        let member = PrimitiveStatementParser().parse([
            token("this", Token.Type.IDENTIFIER, 1), token(".", Token.Type.SYMBOL, 5),
            token("value", Token.Type.IDENTIFIER, 6), token("+=", Token.Type.SYMBOL, 12),
            token("1", Token.Type.INTEGER, 15)
        ], snapshot)
        expect(divided.statements().map({ _.statementKind() })).toBe(["assignment"])
        expect(incremented.statements().map({ _.statementKind() })).toBe(["assignment"])
        expect(member.statements().map({ _.statementKind() })).toBe(["member-assignment"])
    }

    test `parses typed primitive local declaration`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:typed-primitive-local"), "revision:one"
        )
        let result = PrimitiveStatementParser().parse([
            token("var", Token.Type.IDENTIFIER, 1),
            token("Int", Token.Type.IDENTIFIER, 5),
            token("size", Token.Type.IDENTIFIER, 9),
            token("=", Token.Type.SYMBOL, 14),
            token("1", Token.Type.INTEGER, 16)
        ], snapshot)
        expect(result.statements().map({ _.statementKind() })).toBe(["local-declaration"])
    }

    test `parses direct typed initialized local declaration`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:direct-typed-local"), "revision:one"
        )
        let result = PrimitiveStatementParser().parse([
            token("Int", Token.Type.IDENTIFIER, 1),
            token("id", Token.Type.IDENTIFIER, 5),
            token("=", Token.Type.SYMBOL, 8),
            token("1", Token.Type.INTEGER, 10)
        ], snapshot)
        let statements = result.statements()
        let localObject = (Object)statements.first
        let local = (PrimitiveLocalDeclarationSyntax)localObject

        expect(local.declaredTypeName).toBe("Int")
        expect(local.name).toBe("id")
    }

    test `parses native array typed local without initializer`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:native-array-local"), "revision:one"
        )
        let result = PrimitiveStatementParser().parse([
            token("native_array", Token.Type.IDENTIFIER, 1),
            token("native", Token.Type.IDENTIFIER, 14),
            token("var", Token.Type.IDENTIFIER, 21),
            token("Char", Token.Type.IDENTIFIER, 25),
            token("[", Token.Type.SYMBOL, 29), token("]", Token.Type.SYMBOL, 30),
            token("data", Token.Type.IDENTIFIER, 32)
        ], snapshot)

        expect(result.statements().map({ _.statementKind() })).toBe(["local-declaration"])
    }

    test `parses target native expression statement`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:native-statement"), "revision:one"
        )
        let result = PrimitiveStatementParser().parse([
            token("native", Token.Type.IDENTIFIER, 1),
            token("[", Token.Type.SYMBOL, 7), token("es6", Token.Type.IDENTIFIER, 8),
            token("]", Token.Type.SYMBOL, 11), token("Math", Token.Type.IDENTIFIER, 13),
            token(".", Token.Type.SYMBOL, 17), token("max", Token.Type.IDENTIFIER, 18),
            token("(", Token.Type.SYMBOL, 21), token("1", Token.Type.INTEGER, 22),
            token(",", Token.Type.SYMBOL, 23), token("2", Token.Type.INTEGER, 25),
            token(")", Token.Type.SYMBOL, 26), token(";", Token.Type.SYMBOL, 27)
        ], snapshot)
        let statements = result.statements()
        let statementObject = (Object)statements.first
        let statement = (PrimitiveExpressionStatementSyntax)statementObject
        let nativeObject = (Object)statement.expression
        let native = (PrimitiveNativeSyntax)nativeObject

        expect(statement.statementKind()).toBe("expression")
        expect(native.target).toBe("es6")
        expect(native.nativeName).toBe("Math.max")
    }

    test `rejects incomplete declarations and malformed assignments`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-statement-invalid"), "revision:one"
        )
        var Int rejected
        try {
            PrimitiveStatementParser().parse([
                token("let", Token.Type.IDENTIFIER, 1),
                token("value", Token.Type.IDENTIFIER, 5)
            ], snapshot)
        } catch (Exception error) { rejected++ }
        try {
            PrimitiveStatementParser().parse([
                token("value", Token.Type.IDENTIFIER, 1),
                token("1", Token.Type.INTEGER, 7)
            ], snapshot)
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(2)
    }

    token(String value, Int type, Int column) -> Token {
        return Token(
            value: value,
            type: type,
            location: Location(lineNumber: 1, column: column)
        )
    }
}
