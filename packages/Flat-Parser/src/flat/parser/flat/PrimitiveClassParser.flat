package flat/parser/flat

import flat/compiler/models

/** Balanced syntax-only parser for one reduced class/field/constructor partition. */
class {
    var Token[] tokens
    var SourceSnapshotIdentity snapshot
    var Int tokenIndexOffset
    var Int index

    public parse(
        Token[] tokenValues,
        SourceSnapshotIdentity sourceSnapshot,
        Int sourceTokenIndexOffset = 0,
        String implicitName = null
    ) -> PrimitiveClassSyntax {
        if (!tokenValues || !sourceSnapshot) throw Exception("Primitive class parsing requires tokens and snapshot")
        tokens = tokenValues.filter({
            let type = _.type
            return type != Token.Type.WHITESPACE && type != Token.Type.COMMENT
        })
        snapshot = sourceSnapshot
        tokenIndexOffset = sourceTokenIndexOffset
        index = 0
        let start = index
        var Bool abstractClass
        if (index < tokens.count && tokens[index].value == "abstract") {
            abstractClass = true
            index++
        }
        require("class")
        let name = index < tokens.count && implicitName &&
            (tokens[index].value == "{" || tokens[index].value == "<" ||
                tokens[index].value == "extends" ||
                tokens[index].value == "implements")
            ? implicitName
            : identifier("Expected class name")
        var String genericParameterName
        if (index < tokens.count && tokens[index].value == "<") {
            index++
            genericParameterName = identifier("Expected generic parameter name")
            if (index < tokens.count && tokens[index].value == "extends") {
                index++
                identifier("Expected generic parameter bound")
            }
            require(">")
        }
        var String parentName
        if (index < tokens.count && tokens[index].value == "extends") {
            index++
            parentName = identifier("Expected parent class name")
            if (index < tokens.count && tokens[index].value == "<") skipGenericArguments()
        }
        let implementedTypeNames = String[]
        if (index < tokens.count && tokens[index].value == "implements") {
            index++
            while (true) {
                var String implemented = identifier("Expected implemented type name")
                if (index < tokens.count && tokens[index].value == "<") {
                    index++
                    implemented += "<"
                    var Bool firstArgument = true
                    while (index < tokens.count && tokens[index].value != ">") {
                        if (!firstArgument) {
                            require(",")
                            implemented += ","
                        }
                        implemented += identifier("Expected implemented generic argument")
                        firstArgument = false
                    }
                    require(">")
                    implemented += ">"
                }
                implementedTypeNames.add(implemented)
                if (index >= tokens.count || tokens[index].value != ",") break
                index++
            }
        }
        require("{")
        let fields = PrimitiveFieldSyntax[]
        var PrimitiveConstructorSyntax constructorValue
        let methods = PrimitiveFunctionSyntax[]
        var Bool visibleField
        var Bool staticField
        while (index < tokens.count && tokens[index].value != "}") {
            if (isFunctionModifier(tokens[index].value) &&
                tokens[index].value != "visible" &&
                !(tokens[index].value == "public" && index + 2 < tokens.count &&
                    tokens[index + 1].value == "construct" &&
                    tokens[index + 2].value == "(")) {
                var Int modifierCursor = index
                while (modifierCursor < tokens.count &&
                    isFunctionModifier(tokens[modifierCursor].value)) {
                    modifierCursor++
                }
                if (modifierCursor < tokens.count && tokens[modifierCursor].type == Token.Type.IDENTIFIER &&
                    modifierCursor + 1 < tokens.count && tokens[modifierCursor + 1].value == "(") {
                    let abstractMethod = tokens.skip(index).take(modifierCursor - index)
                        .any({ _.value == "abstract" })
                    let end = abstractMethod ? abstractDeclarationEnd(index) : declarationEnd(index)
                    let parsed = parseMethod(index, end, "modified method")
                    if (parsed.count != 1) syntax("Expected one modified method", index)
                    methods.add(parsed.first)
                    index = end
                    continue
                }
            }
            if (tokens[index].value == "public" && index + 1 < tokens.count &&
                tokens[index + 1].value == "static") {
                let end = declarationEnd(index)
                let parsed = parseMethod(index, end, "static method")
                if (parsed.count != 1) syntax("Expected one static method", index)
                methods.add(parsed.first)
                index = end
            } else if (tokens[index].value == "public" || tokens[index].value == "private" ||
                tokens[index].value == "protected") {
                index++
            } else if (tokens[index].value == "visible" && index + 3 < tokens.count &&
                tokens[index + 1].type == Token.Type.IDENTIFIER &&
                tokens[index + 2].type == Token.Type.IDENTIFIER &&
                tokens[index + 3].value == "=>") {
                let propertyStart = index++
                let returnType = tokens[index++].value
                let propertyName = tokens[index++].value
                index++
                let expressionStart = index
                let end = declarationEnd(propertyStart)
                let value = PrimitiveExpressionParser().parse(
                    tokens.skip(expressionStart).take(end - expressionStart), snapshot,
                    expressionStart + tokenIndexOffset
                )
                methods.add(PrimitiveFunctionSyntax(
                    range(propertyStart, end), propertyName,
                    PrimitiveFunctionParameterSyntax[], returnType,
                    [PrimitiveReturnSyntax(range(expressionStart, end), value)]
                ))
                index = end
            } else if (tokens[index].value == "visible") {
                visibleField = true
                index++
                if (index < tokens.count && tokens[index].value == "static") {
                    staticField = true
                    index++
                }
            } else if (tokens[index].value == "static") {
                staticField = true
                index++
            } else if (tokens[index].value == "constructor" || tokens[index].value == "construct") {
                if (constructorValue) syntax("Duplicate constructor", index)
                constructorValue = parseConstructor()
            } else if (index + 2 < tokens.count &&
                tokens[index].type == Token.Type.IDENTIFIER &&
                tokens[index + 1].type == Token.Type.IDENTIFIER &&
                tokens[index + 2].value == "=>") {
                let propertyStart = index
                let returnType = tokens[index++].value
                let propertyName = tokens[index++].value
                index++
                let expressionStart = index
                let end = declarationEnd(propertyStart)
                let value = PrimitiveExpressionParser().parse(
                    tokens.skip(expressionStart).take(end - expressionStart), snapshot,
                    expressionStart + tokenIndexOffset
                )
                methods.add(PrimitiveFunctionSyntax(
                    range(propertyStart, end), propertyName,
                    PrimitiveFunctionParameterSyntax[], returnType,
                    [PrimitiveReturnSyntax(range(expressionStart, end), value)]
                ))
                index = end
            } else if (index + 1 < tokens.count && tokens[index].type == Token.Type.IDENTIFIER &&
                tokens[index + 1].type == Token.Type.IDENTIFIER) {
                let fieldStart = index
                let typeName = tokens[index++].value
                let fieldName = tokens[index++].value
                var PrimitiveExpressionSyntax initializer
                if (index < tokens.count && tokens[index].value == "=") {
                    index++
                    let initializerStart = index
                    var Int initializerDepth
                    while (index < tokens.count) {
                        let value = tokens[index].value
                        if (value == "(" || value == "[") initializerDepth++
                        else if (value == ")" || value == "]") initializerDepth--
                        if (initializerDepth == 0 && (value == ";" ||
                            value == "public" || value == "private" ||
                            value == "protected" || value == "visible" || value == "static" ||
                            value == "override" ||
                            value == "constructor" || value == "construct" || value == "}")) break
                        index++
                    }
                    if (initializerStart == index) syntax("Field initializer requires a value", index)
                    initializer = PrimitiveExpressionParser().parse(
                        tokens.skip(initializerStart).take(index - initializerStart),
                        snapshot, initializerStart + tokenIndexOffset
                    )
                }
                if (index < tokens.count && tokens[index].value == ";") index++
                else if (index >= tokens.count || (tokens[index].value != "public" &&
                    tokens[index].value != "private" && tokens[index].value != "protected" &&
                    tokens[index].value != "visible" && tokens[index].value != "static" &&
                    tokens[index].value != "override" &&
                    tokens[index].value != "constructor" &&
                    tokens[index].value != "construct" && tokens[index].value != "}")) require(";")
                if (fields.any({ _.name == fieldName })) syntax("Duplicate field '#fieldName'", fieldStart)
                fields.add(PrimitiveFieldSyntax(
                    range(fieldStart, index), typeName, fieldName,
                    visibleField, initializer, staticField
                ))
                visibleField = false
                staticField = false
            } else {
                let end = declarationEnd(index)
                let parsed = parseMethod(index, end, "method")
                if (parsed.count != 1) syntax("Expected one method", index)
                methods.add(parsed.first)
                index = end
            }
        }
        if (visibleField || staticField) syntax("Expected field declaration", index)
        require("}")
        if (index != tokens.count) syntax("Unexpected trailing class token", index)
        if (!constructorValue) {
            constructorValue = PrimitiveConstructorSyntax(
                range(start, index), PrimitiveFunctionParameterSyntax[], PrimitiveStatementSyntax[]
            )
        }
        return PrimitiveClassSyntax(
            range(start, index), name, genericParameterName, parentName,
            fields, constructorValue, methods, implementedTypeNames, abstractClass
        )
    }

    parseConstructor() -> PrimitiveConstructorSyntax {
        let start = index++
        require("(")
        let parameters = parameters()
        require(")")
        if (index < tokens.count && tokens[index].value == "=>") {
            index++
            require("super")
            require("(")
            let arguments = PrimitiveExpressionSyntax[]
            if (index < tokens.count && tokens[index].value != ")") {
                while (true) {
                    let argumentStart = index
                    var Int parenthesisDepth
                    while (index < tokens.count) {
                        let value = tokens[index].value
                        if (value == "(") parenthesisDepth++
                        else if (value == ")") {
                            if (parenthesisDepth == 0) break
                            parenthesisDepth--
                        } else if (value == "," && parenthesisDepth == 0) break
                        index++
                    }
                    if (argumentStart == index) syntax("Expected parent constructor argument", index)
                    arguments.add(PrimitiveExpressionParser().parse(
                        tokens.skip(argumentStart).take(index - argumentStart), snapshot,
                        argumentStart + tokenIndexOffset
                    ))
                    if (index >= tokens.count || tokens[index].value == ")") break
                    require(",")
                    if (index >= tokens.count || tokens[index].value == ")") {
                        syntax("Expected parent constructor argument", index)
                    }
                }
            }
            require(")")
            return PrimitiveConstructorSyntax(
                range(start, index), parameters, PrimitiveStatementSyntax[], arguments
            )
        }
        if (index >= tokens.count || tokens[index].value != "{") {
            return PrimitiveConstructorSyntax(
                range(start, index), parameters, PrimitiveStatementSyntax[]
            )
        }
        require("{")
        let bodyStart = index
        var Int depth = 1
        while (index < tokens.count && depth > 0) {
            if (tokens[index].value == "{") depth++
            else if (tokens[index].value == "}") depth--
            index++
        }
        if (depth != 0) syntax("Unterminated constructor", index)
        let bodyEnd = index - 1
        return PrimitiveConstructorSyntax(
            range(start, index), parameters,
            PrimitiveControlStatementParser().parse(
                tokens.skip(bodyStart).take(bodyEnd - bodyStart), snapshot,
                bodyStart + tokenIndexOffset
            ).statements()
        )
    }

    parameters() -> PrimitiveFunctionParameterSyntax[] {
        let result = PrimitiveFunctionParameterSyntax[]
        if (index < tokens.count && tokens[index].value == ")") return result
        while (true) {
            let start = index
            var Bool visibleParameter
            if (index < tokens.count &&
                (tokens[index].value == "visible" || tokens[index].value == "public")) {
                visibleParameter = true
                index++
            }
            let typeName = identifier("Expected parameter type")
            let name = identifier("Expected parameter name")
            if (result.any({ _.name == name })) syntax("Duplicate parameter '#name'", start)
            var PrimitiveExpressionSyntax defaultValue
            if (index < tokens.count && tokens[index].value == "=") {
                index++
                let defaultStart = index
                var Int depth
                while (index < tokens.count) {
                    let value = tokens[index].value
                    if (value == "(" || value == "[") depth++
                    else if (value == ")" || value == "]") {
                        if (depth == 0 && value == ")") break
                        depth--
                    }
                    if (depth == 0 && (value == "," || value == ")")) break
                    index++
                }
                if (defaultStart == index) syntax("Default parameter requires a value", index)
                defaultValue = PrimitiveExpressionParser().parse(
                    tokens.skip(defaultStart).take(index - defaultStart), snapshot,
                    defaultStart + tokenIndexOffset
                )
            }
            result.add(PrimitiveFunctionParameterSyntax(
                range(start, index), typeName, name, defaultValue, visibleParameter
            ))
            if (index >= tokens.count || tokens[index].value != ",") break
            index++
        }
        return result
    }

    isFunctionModifier(String value) -> Bool =>
        value == "public" || value == "private" || value == "protected" ||
            value == "static" || value == "async" || value == "compiler_visible" ||
            value == "external_name" || value == "native_array" || value == "native" ||
            value == "abstract" || value == "override"

    skipGenericArguments() {
        require("<")
        var Int depth = 1
        while (index < tokens.count && depth > 0) {
            if (tokens[index].value == "<") depth++
            else if (tokens[index].value == ">") depth--
            index++
        }
        if (depth != 0) syntax("Unterminated generic arguments", index)
    }

    abstractDeclarationEnd(Int start) -> Int {
        var Int cursor = start
        while (cursor < tokens.count && tokens[cursor].value != "->") cursor++
        if (cursor >= tokens.count) syntax("Abstract method requires return type", start)
        cursor++
        parseTypeNameAt(cursor)
        cursor++
        return cursor
    }

    parseTypeNameAt(Int cursor) {
        if (cursor >= tokens.count || tokens[cursor].type != Token.Type.IDENTIFIER) {
            syntax("Abstract method requires return type", cursor)
        }
    }

    fallbackBodyEnd(Int expressionStart) -> Int => -1 {
        var Int parenthesisDepth
        var Int bracketDepth
        var Int cursor = expressionStart
        while (cursor < tokens.count) {
            let value = tokens[cursor].value
            if (value == "(") parenthesisDepth++
            else if (value == ")") parenthesisDepth--
            else if (value == "[") bracketDepth++
            else if (value == "]") bracketDepth--
            else if (value == "{" && parenthesisDepth == 0 && bracketDepth == 0) {
                var Int bodyDepth = 1
                cursor++
                while (cursor < tokens.count && bodyDepth > 0) {
                    if (tokens[cursor].value == "{") bodyDepth++
                    else if (tokens[cursor].value == "}") bodyDepth--
                    cursor++
                }
                if (bodyDepth != 0) syntax("Unterminated fallback method body", expressionStart)
                return cursor
            }
            var Bool typeBoundary = value == "class" || value == "trait" ||
                value == "interface"
            if (typeBoundary && cursor > 0 && tokens[cursor - 1].value == ".") {
                typeBoundary = false
            }
            if (parenthesisDepth == 0 && bracketDepth == 0 &&
                (value == "}" || value == "public" || value == "private" ||
                    value == "protected" || value == "visible" || value == "static" ||
                    value == "async" || value == "compiler_visible" ||
                    value == "external_name" || value == "override" ||
                    value == "constructor" ||
                    value == "construct" || typeBoundary ||
                    (value == "[" && cursor + 1 < tokens.count &&
                        tokens[cursor + 1].value == "Target"))) return -1
            cursor++
        }
    }

    parseMethod(
        Int start,
        Int end,
        String context
    ) -> PrimitiveFunctionSyntax[] {
        try {
            return PrimitiveFunctionParser().parse(
                tokens.skip(start).take(end - start), snapshot,
                start + tokenIndexOffset
            ).functionValues()
        } catch (Exception error) {
            let name = methodName(start, end)
            throw Exception(
                "Primitive class #context '#name' at token #start failed: #{error.message}"
            )
        }
    }

    methodName(Int start, Int end) -> String {
        var Int cursor = start
        while (cursor + 1 < end) {
            if (tokens[cursor].type == Token.Type.IDENTIFIER &&
                tokens[cursor + 1].value == "(") return tokens[cursor].value
            cursor++
        }
        return "<unknown>"
    }

    declarationEnd(Int start) -> Int {
        var Int cursor = start
        while (cursor < tokens.count && tokens[cursor].value != "{" &&
            tokens[cursor].value != "=>") cursor++
        if (cursor < tokens.count && tokens[cursor].value == "=>") {
            cursor++
            if (cursor + 1 < tokens.count && tokens[cursor].value == "this" &&
                tokens[cursor + 1].value == "{") {
                cursor += 2
                var Int bodyDepth = 1
                while (cursor < tokens.count && bodyDepth > 0) {
                    if (tokens[cursor].value == "{") bodyDepth++
                    else if (tokens[cursor].value == "}") bodyDepth--
                    cursor++
                }
                if (bodyDepth != 0) syntax("Unterminated receiver-return method", start)
                return cursor
            }
            let fallbackEnd = fallbackBodyEnd(cursor)
            if (fallbackEnd >= 0) return fallbackEnd
            var Int parenthesisDepth
            var Int bracketDepth
            while (cursor < tokens.count) {
                let value = tokens[cursor].value
                if (value == "(") parenthesisDepth++
                else if (value == ")") parenthesisDepth--
                else if (value == "[") bracketDepth++
                else if (value == "]") bracketDepth--
                else if (parenthesisDepth == 0 && bracketDepth == 0 &&
                    (value == "public" || value == "private" ||
                        value == "protected" || value == "static" ||
                        value == "async" || value == "compiler_visible" ||
                        value == "external_name" || value == "visible" ||
                        value == "override" || value == "constructor" || value == "construct" || value == "}")) break
                cursor++
            }
            if (cursor >= tokens.count) syntax("Expected method expression boundary", start)
            return cursor
        }
        if (cursor >= tokens.count) syntax("Expected method body", start)
        var Int depth = 1
        cursor++
        while (cursor < tokens.count && depth > 0) {
            if (tokens[cursor].value == "{") depth++
            else if (tokens[cursor].value == "}") depth--
            cursor++
        }
        if (depth != 0) syntax("Unterminated method", start)
        return cursor
    }

    identifier(String message) -> String {
        if (index >= tokens.count || tokens[index].type != Token.Type.IDENTIFIER) syntax(message, index)
        return tokens[index++].value
    }

    require(String value) {
        if (index >= tokens.count || tokens[index].value != value) syntax("Expected '#value'", index)
        index++
    }

    range(Int start, Int end) -> SourceRange {
        let first = tokens[start]
        let last = tokens[end - 1]
        return SourceRange(snapshot, start + tokenIndexOffset, end + tokenIndexOffset,
            first.location, Location(lineNumber: last.endLineNumber, column: last.endColumn))
    }

    syntax(String message, Int tokenIndex) {
        throw Exception("Primitive class syntax error at token #tokenIndex: #message")
    }
}
