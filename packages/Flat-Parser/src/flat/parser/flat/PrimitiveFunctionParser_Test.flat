package flat/parser/flat

import flat/compiler/models

testable class {
    test `parses representation modified structural parameter`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:representation-parameter"), "revision:one"
        )
        let parsed = PrimitiveFunctionParser().parse([
            token("calculateSize", Token.Type.IDENTIFIER, 1),
            token("(", Token.Type.SYMBOL, 14),
            token("native_array", Token.Type.IDENTIFIER, 15),
            token("native", Token.Type.IDENTIFIER, 28),
            token("Char", Token.Type.IDENTIFIER, 35),
            token("[", Token.Type.SYMBOL, 39), token("]", Token.Type.SYMBOL, 40),
            token("chars", Token.Type.IDENTIFIER, 42), token(")", Token.Type.SYMBOL, 47),
            token("->", Token.Type.SYMBOL, 49), token("Int", Token.Type.IDENTIFIER, 52),
            token("{", Token.Type.SYMBOL, 56), token("}", Token.Type.SYMBOL, 57)
        ], snapshot).functionValues().first
        let parameter = parsed.parameterValues().first

        expect(parameter.typeName).toBe("Char[]")
        expect(parameter.name).toBe("chars")
    }

    test `parses mutable parameter modifier`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:mutable-parameter"), "revision:one"
        )
        let parsed = PrimitiveFunctionParser().parse([
            token("scan", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 5),
            token("var", Token.Type.IDENTIFIER, 6), token("Int", Token.Type.IDENTIFIER, 10),
            token("count", Token.Type.IDENTIFIER, 14), token(")", Token.Type.SYMBOL, 19),
            token("=>", Token.Type.SYMBOL, 21), token("count", Token.Type.IDENTIFIER, 24)
        ], snapshot)
        let parameter = parsed.functionValues().first.parameterValues().first

        expect(parameter.typeName).toBe("Int")
        expect(parameter.name).toBe("count")
    }

    test `parses fallback body beginning with switch after expression result`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:fallback-switch"), "revision:one"
        )
        let parsed = PrimitiveFunctionParser().parse([
            token("check", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 6),
            token(")", Token.Type.SYMBOL, 7), token("=>", Token.Type.SYMBOL, 9),
            token("true", Token.Type.BOOL, 12), token("{", Token.Type.SYMBOL, 17),
            token("switch", Token.Type.IDENTIFIER, 19), token("value", Token.Type.IDENTIFIER, 26),
            token("{", Token.Type.SYMBOL, 32), token("default", Token.Type.IDENTIFIER, 34),
            token("=>", Token.Type.SYMBOL, 42), token("return", Token.Type.IDENTIFIER, 45),
            token("false", Token.Type.BOOL, 52), token("}", Token.Type.SYMBOL, 58),
            token("}", Token.Type.SYMBOL, 60)
        ], snapshot)
        let method = parsed.functionValues().first

        expect(method.statements().map({ _.statementKind() })).toBe(["return", "switch"])
    }

    test `parses multiple functions parameters calls recursion and ranges`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-functions"), "revision:one"
        )
        let result = PrimitiveFunctionParser().parse([
            token("double", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 7),
            token("Int", Token.Type.IDENTIFIER, 8), token("value", Token.Type.IDENTIFIER, 12),
            token(")", Token.Type.SYMBOL, 17), token("->", Token.Type.SYMBOL, 19),
            token("Int", Token.Type.IDENTIFIER, 22), token("{", Token.Type.SYMBOL, 26),
            token("return", Token.Type.IDENTIFIER, 28), token("value", Token.Type.IDENTIFIER, 35),
            token("+", Token.Type.SYMBOL, 41), token("value", Token.Type.IDENTIFIER, 43),
            token(";", Token.Type.SYMBOL, 48), token("}", Token.Type.SYMBOL, 50),
            token("run", Token.Type.IDENTIFIER, 52), token("(", Token.Type.SYMBOL, 55),
            token(")", Token.Type.SYMBOL, 56), token("->", Token.Type.SYMBOL, 58),
            token("Int", Token.Type.IDENTIFIER, 61), token("{", Token.Type.SYMBOL, 65),
            token("return", Token.Type.IDENTIFIER, 67), token("double", Token.Type.IDENTIFIER, 74),
            token("(", Token.Type.SYMBOL, 80), token("2", Token.Type.INTEGER, 81),
            token(")", Token.Type.SYMBOL, 82), token(";", Token.Type.SYMBOL, 83),
            token("}", Token.Type.SYMBOL, 85)
        ], snapshot, 5)
        let functions = result.functionValues()
        let first = functions.first
        let second = functions.last
        let secondStatements = second.statements()
        let returnedObject = (Object)secondStatements.first
        let returned = (PrimitiveReturnSyntax)returnedObject
        let callObject = (Object)returned.value
        let call = (PrimitiveCallSyntax)callObject

        expect(functions.count).toBe(2)
        expect(first.parameterValues().first.typeName).toBe("Int")
        expect(first.parameterValues().first.name).toBe("value")
        expect(first.range.startTokenIndex).toBe(5)
        expect(first.range.endTokenIndex).toBe(19)
        expect(call.name).toBe("double")
        expect(call.argumentValues().count).toBe(1)
    }

    test `parses native declaration modifiers`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:native-function-modifiers"), "revision:one"
        )
        let parsed = PrimitiveFunctionParser().parse([
            token("public", Token.Type.IDENTIFIER, 1),
            token("native_array", Token.Type.IDENTIFIER, 8),
            token("native", Token.Type.IDENTIFIER, 21),
            token("static", Token.Type.IDENTIFIER, 28),
            token("toCharArray", Token.Type.IDENTIFIER, 35),
            token("(", Token.Type.SYMBOL, 46),
            token("Double", Token.Type.IDENTIFIER, 47),
            token("value", Token.Type.IDENTIFIER, 54),
            token(")", Token.Type.SYMBOL, 59),
            token("->", Token.Type.SYMBOL, 61),
            token("Char", Token.Type.IDENTIFIER, 64),
            token("[", Token.Type.SYMBOL, 68), token("]", Token.Type.SYMBOL, 69),
            token("{", Token.Type.SYMBOL, 71), token("}", Token.Type.SYMBOL, 72)
        ], snapshot).functionValues().first

        expect(parsed.name).toBe("toCharArray")
        expect(parsed.staticMethod).toBe(true)
        expect(parsed.returnTypeName).toBe("Char[]")
    }

    test `parses bodyless inferred return method`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:bodyless-function"), "revision:one"
        )
        let parsed = PrimitiveFunctionParser().parse([
            token("toString", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 9),
            token(")", Token.Type.SYMBOL, 10), token("=>", Token.Type.SYMBOL, 12),
            token("message", Token.Type.IDENTIFIER, 15)
        ], snapshot).functionValues().first

        expect(parsed.name).toBe("toString")
        expect(parsed.returnTypeName).toBe("String")
        expect(parsed.inferredReturnType).toBe(true)
        expect(parsed.statements().count).toBe(1)
    }

    test `parses visible static bodyless method modifiers`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:static-bodyless-function"), "revision:one"
        )
        let parsed = PrimitiveFunctionParser().parse([
            token("public", Token.Type.IDENTIFIER, 1),
            token("static", Token.Type.IDENTIFIER, 8),
            token("toString", Token.Type.IDENTIFIER, 15), token("(", Token.Type.SYMBOL, 23),
            token("Bool", Token.Type.IDENTIFIER, 24), token("value", Token.Type.IDENTIFIER, 29),
            token(")", Token.Type.SYMBOL, 34), token("=>", Token.Type.SYMBOL, 36),
            token("value", Token.Type.IDENTIFIER, 39)
        ], snapshot).functionValues().first

        expect(parsed.name).toBe("toString")
        expect(parsed.staticMethod).toBe(true)
    }

    test `parses typed bodyless function return`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:typed-bodyless-function"), "revision:one"
        )
        let parsed = PrimitiveFunctionParser().parse([
            token("toString", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 9),
            token(")", Token.Type.SYMBOL, 10), token("->", Token.Type.SYMBOL, 12),
            token("String", Token.Type.IDENTIFIER, 15), token("=>", Token.Type.SYMBOL, 22),
            token("value", Token.Type.IDENTIFIER, 25)
        ], snapshot).functionValues().first

        expect(parsed.returnTypeName).toBe("String")
        expect(parsed.inferredReturnType).toBe(false)
        expect(parsed.statements().count).toBe(1)
    }

    test `parses named default function parameters`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:named-default-function"), "revision:one"
        )
        let parsed = PrimitiveFunctionParser().parse([
            token("toJson", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 7),
            token("Bool", Token.Type.IDENTIFIER, 8), token(":", Token.Type.SYMBOL, 12),
            token("format", Token.Type.IDENTIFIER, 14), token("=", Token.Type.SYMBOL, 21),
            token("false", Token.Type.BOOL, 23), token(")", Token.Type.SYMBOL, 28),
            token("=>", Token.Type.SYMBOL, 30), token("format", Token.Type.IDENTIFIER, 33)
        ], snapshot).functionValues().first
        let parameter = parsed.parameterValues().first

        expect(parameter.typeName).toBe("Bool")
        expect(parameter.name).toBe("format")
        expect(parameter.defaultValue.expressionKind()).toBe("literal")
    }

    test `parses inferred expression followed by nested fallback control body`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:function-fallback-if"), "revision:one"
        )
        let parsed = PrimitiveFunctionParser().parse([
            token("substring", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 10),
            token("Int", Token.Type.IDENTIFIER, 11), token("start", Token.Type.IDENTIFIER, 15),
            token(")", Token.Type.SYMBOL, 20), token("=>", Token.Type.SYMBOL, 22),
            token("null", Token.Type.NULL, 25), token("{", Token.Type.SYMBOL, 30),
            token("if", Token.Type.IDENTIFIER, 32), token("(", Token.Type.SYMBOL, 35),
            token("true", Token.Type.BOOL, 36), token(")", Token.Type.SYMBOL, 40),
            token("{", Token.Type.SYMBOL, 42), token("return", Token.Type.IDENTIFIER, 44),
            token("null", Token.Type.NULL, 51), token("}", Token.Type.SYMBOL, 56),
            token("else", Token.Type.IDENTIFIER, 58), token("if", Token.Type.IDENTIFIER, 63),
            token("(", Token.Type.SYMBOL, 66), token("false", Token.Type.BOOL, 67),
            token(")", Token.Type.SYMBOL, 72), token("{", Token.Type.SYMBOL, 74),
            token("return", Token.Type.IDENTIFIER, 76), token("null", Token.Type.NULL, 83),
            token("}", Token.Type.SYMBOL, 88), token("}", Token.Type.SYMBOL, 90)
        ], snapshot).functionValues().first

        expect(parsed.statements().count).toBe(2)
        expect(parsed.statements().last.statementKind()).toBe("if")
    }

    test `parses expression fallback followed by braced body`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:function-fallback-body"), "revision:one"
        )
        let parsed = PrimitiveFunctionParser().parse([
            token("isWhitespace", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 13),
            token("Char", Token.Type.IDENTIFIER, 14), token("value", Token.Type.IDENTIFIER, 19),
            token(")", Token.Type.SYMBOL, 24), token("=>", Token.Type.SYMBOL, 26),
            token("false", Token.Type.BOOL, 29), token("{", Token.Type.SYMBOL, 35),
            token("return", Token.Type.IDENTIFIER, 37),
            token("true", Token.Type.BOOL, 44), token(";", Token.Type.SYMBOL, 48),
            token("}", Token.Type.SYMBOL, 50)
        ], snapshot).functionValues().first

        expect(parsed.statements().count).toBe(2)
    }

    test `parses receiver compound expression body as member assignment`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:function-member-compound"), "revision:one"
        )
        let parsed = PrimitiveFunctionParser().parse([
            token("plusEquals", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 11),
            token("Int", Token.Type.IDENTIFIER, 12), token("other", Token.Type.IDENTIFIER, 16),
            token(")", Token.Type.SYMBOL, 21), token("=>", Token.Type.SYMBOL, 23),
            token("this", Token.Type.IDENTIFIER, 26), token(".", Token.Type.SYMBOL, 30),
            token("value", Token.Type.IDENTIFIER, 31), token("+=", Token.Type.SYMBOL, 37),
            token("other", Token.Type.IDENTIFIER, 40)
        ], snapshot).functionValues().first

        expect(parsed.statements().map({ _.statementKind() })).toBe(["member-assignment"])
        expect(parsed.inferredReturnType).toBe(true)
    }

    test `parses canonical generic async parameter defaults`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:canonical-map-parallel"), "revision:one"
        )
        let parsed = PrimitiveFunctionParser().parse([
            token("public", Token.Type.IDENTIFIER, 1),
            token("async", Token.Type.IDENTIFIER, 8),
            token("mapParallel", Token.Type.IDENTIFIER, 14),
            token("<", Token.Type.SYMBOL, 25), token("Out", Token.Type.IDENTIFIER, 26),
            token(">", Token.Type.SYMBOL, 29), token("(", Token.Type.SYMBOL, 30),
            token("async", Token.Type.IDENTIFIER, 31),
            token("mapFunc", Token.Type.IDENTIFIER, 37), token("(", Token.Type.SYMBOL, 44),
            token("Type", Token.Type.IDENTIFIER, 45), token("x", Token.Type.IDENTIFIER, 50),
            token(",", Token.Type.SYMBOL, 51), token("Int", Token.Type.IDENTIFIER, 53),
            token("i", Token.Type.IDENTIFIER, 57), token(",", Token.Type.SYMBOL, 58),
            token("List", Token.Type.IDENTIFIER, 60), token("<", Token.Type.SYMBOL, 64),
            token("Type", Token.Type.IDENTIFIER, 65), token(">", Token.Type.SYMBOL, 69),
            token("list", Token.Type.IDENTIFIER, 71),
            token(")", Token.Type.SYMBOL, 75), token("->", Token.Type.SYMBOL, 77),
            token("Out", Token.Type.IDENTIFIER, 80), token(",", Token.Type.SYMBOL, 83),
            token("Int", Token.Type.IDENTIFIER, 61), token("maxParallel", Token.Type.IDENTIFIER, 65),
            token("=", Token.Type.SYMBOL, 77), token("-", Token.Type.SYMBOL, 79),
            token("1", Token.Type.INTEGER, 80), token(",", Token.Type.SYMBOL, 81),
            token("async", Token.Type.IDENTIFIER, 83),
            token("onAfterChunk", Token.Type.IDENTIFIER, 89), token("(", Token.Type.SYMBOL, 101),
            token("Int", Token.Type.IDENTIFIER, 102), token("count", Token.Type.IDENTIFIER, 106),
            token(")", Token.Type.SYMBOL, 111), token("=", Token.Type.SYMBOL, 113),
            token("{", Token.Type.SYMBOL, 115), token("}", Token.Type.SYMBOL, 116),
            token(")", Token.Type.SYMBOL, 117), token("->", Token.Type.SYMBOL, 119),
            token("Int", Token.Type.IDENTIFIER, 122), token("{", Token.Type.SYMBOL, 126),
            token("return", Token.Type.IDENTIFIER, 128), token("1", Token.Type.INTEGER, 135),
            token("}", Token.Type.SYMBOL, 137)
        ], snapshot).functionValues().first
        let parameters = parsed.parameterValues()

        expect(parsed.name).toBe("mapParallel")
        expect(parameters.count).toBe(3)
        expect(parameters[0].typeName).toBe("async func(Type,Int,List<Type>)->Out")
        expect(parameters[1].defaultValue.expressionKind()).toBe("unary")
        expect(parameters[2].defaultValue.expressionKind()).toBe("lambda")
        expect(parsed.returnTypeName).toBe("Int")
        expect(parsed.asyncMethod).toBe(true)
        expect(parsed.range.startTokenIndex).toBe(0)
        expect(parsed.genericParameterNames()).toBe(["Out"])
        let names = parsed.genericParameterNames()
        names.add("Other")
        expect(parsed.genericParameterNames()).toBe(["Out"])
        expect(parsed.range.endTokenIndex).toBe(47)
    }

    test `preserves ordered generic names and rejects duplicate names`() {
        let snapshot = SourceSnapshotIdentity(SourceIdentity("memory:generic-names"), "one")
        let names = ["First", "Second"]
        let range = SourceRange(snapshot, 0, 1,
            Location(lineNumber: 1, column: 1), Location(lineNumber: 1, column: 2))
        let syntax = PrimitiveFunctionSyntax(
            range, "map", PrimitiveFunctionParameterSyntax[],
            "Unit", PrimitiveStatementSyntax[], genericParameterNameValues: names
        )
        names.add("Third")
        expect(syntax.genericParameterNames()).toBe(["First", "Second"])
        var Bool rejected
        try {
            PrimitiveFunctionSyntax(
                range, "map", PrimitiveFunctionParameterSyntax[],
                "Unit", PrimitiveStatementSyntax[], genericParameterNameValues: ["Out", "Out"]
            )
        } catch (Exception error) {
            rejected = true
        }
        expect(rejected).toBe(true)
    }

    test `parses structural parameters and implicit Unit body`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:structural-function"), "revision:one"
        )
        let parsed = PrimitiveFunctionParser().parse([
            token("run", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 4),
            token("func", Token.Type.IDENTIFIER, 5), token("(", Token.Type.SYMBOL, 9),
            token(")", Token.Type.SYMBOL, 10), token("callback", Token.Type.IDENTIFIER, 12),
            token(",", Token.Type.SYMBOL, 20), token("Object", Token.Type.IDENTIFIER, 22),
            token("[", Token.Type.SYMBOL, 28), token("]", Token.Type.SYMBOL, 29),
            token("args", Token.Type.IDENTIFIER, 31), token(")", Token.Type.SYMBOL, 35),
            token("{", Token.Type.SYMBOL, 37), token("}", Token.Type.SYMBOL, 38)
        ], snapshot).functionValues().first
        let parameters = parsed.parameterValues()
        let callback = parameters.first
        let args = parameters.last

        expect(callback.typeName).toBe("func()")
        expect(args.typeName).toBe("Object[]")
        expect(parsed.returnTypeName).toBe("Unit")
        expect(parsed.statements().count).toBe(0)
    }

    test `rejects duplicate delimiters and incomplete signatures or bodies`() {
        let snapshot = SourceSnapshotIdentity(
            SourceIdentity("memory:primitive-functions-invalid"), "revision:one"
        )
        var Int rejected
        try {
            PrimitiveFunctionParser().parse([
                token("run", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 4),
                token(")", Token.Type.SYMBOL, 5), token("Int", Token.Type.IDENTIFIER, 7),
                token("{", Token.Type.SYMBOL, 11), token("}", Token.Type.SYMBOL, 12)
            ], snapshot)
        } catch (Exception error) { rejected++ }
        try {
            PrimitiveFunctionParser().parse([
                token("run", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 4),
                token("Int", Token.Type.IDENTIFIER, 5), token("value", Token.Type.IDENTIFIER, 9),
                token(",", Token.Type.SYMBOL, 14), token(")", Token.Type.SYMBOL, 15),
                token("->", Token.Type.SYMBOL, 17), token("Int", Token.Type.IDENTIFIER, 20),
                token("{", Token.Type.SYMBOL, 24), token("}", Token.Type.SYMBOL, 25)
            ], snapshot)
        } catch (Exception error) { rejected++ }
        try {
            PrimitiveFunctionParser().parse([
                token("run", Token.Type.IDENTIFIER, 1), token("(", Token.Type.SYMBOL, 4),
                token(")", Token.Type.SYMBOL, 5), token("->", Token.Type.SYMBOL, 7),
                token("Int", Token.Type.IDENTIFIER, 10), token("{", Token.Type.SYMBOL, 14),
                token("return", Token.Type.IDENTIFIER, 16), token("1", Token.Type.INTEGER, 23),
                token(";", Token.Type.SYMBOL, 24)
            ], snapshot)
        } catch (Exception error) { rejected++ }
        expect(rejected).toBe(3)
    }

    token(String value, Int type, Int column) -> Token {
        return Token(value: value, type: type,
            location: Location(lineNumber: 1, column: column))
    }
}
