package flat/parser/flat

import flat/compiler/models

data class extends PrimitiveStatementSyntax {
    public construct(
        SourceRange range,
        visible String name,
        visible PrimitiveExpressionSyntax value,
        visible String assignmentOperator = "="
    ) {
        var Bool update = assignmentOperator == "++" || assignmentOperator == "--"
        var Bool compound = assignmentOperator == "+=" || assignmentOperator == "-=" ||
            assignmentOperator == "*=" || assignmentOperator == "/=" || assignmentOperator == "%="
        if (!range || !name || !value ||
            (assignmentOperator != "=" && !compound && !update)) {
            throw Exception("Primitive assignment syntax requires name, supported operator, and value")
        }
        super(range)
    }
    override public statementKind() => "assignment"
}
