package flat/parser/flat

import flat/compiler/models

/** Syntax-only parser for delimited primitive local, assignment, and return statements. */
class {
    var Token[] tokens
    var SourceSnapshotIdentity snapshot
    var Int tokenIndexOffset

    public parse(
        Token[] tokenValues,
        SourceSnapshotIdentity sourceSnapshot,
        Int sourceTokenIndexOffset = 0
    ) -> PrimitiveStatementSyntaxResult {
        if (!tokenValues || !sourceSnapshot) {
            throw Exception("Primitive statement parsing requires tokens and snapshot")
        }
        tokens = tokenValues.filter({
            let type = _.type
            return type != Token.Type.WHITESPACE && type != Token.Type.COMMENT
        })
        snapshot = sourceSnapshot
        tokenIndexOffset = sourceTokenIndexOffset
        let statements = PrimitiveStatementSyntax[]
        var Int start
        var Int index
        while (index <= tokens.count) {
            if (index == tokens.count || tokens[index].value == ";") {
                if (index > start) statements.add(parseStatement(start, index))
                start = index + 1
            }
            index++
        }
        return PrimitiveStatementSyntaxResult(statements)
    }

    parseStatement(Int start, Int end) -> PrimitiveStatementSyntax {
        let first = tokens[start].value
        if (first == "let" || first == "var" ||
            (start + 2 < end && tokens[start].type == Token.Type.IDENTIFIER &&
                tokens[start + 1].type == Token.Type.IDENTIFIER &&
                tokens[start + 2].value == "=") ||
            first == "native_array") {
            return parseLocal(start, end)
        }
        if (first == "return") return parseReturn(start, end)
        if (first == "continue" && end - start == 1) {
            return PrimitiveContinueSyntax(range(start, end))
        }
        if (first == "throw") return parseThrow(start, end)
        if (first == "this" && start + 1 < end && tokens[start + 1].value == "(") {
            let call = (PrimitiveCallSyntax)expression(start, end)
            return PrimitiveConstructorDelegationSyntax(
                range(start, end), call.argumentValues()
            )
        }
        if (first == "native") return PrimitiveExpressionStatementSyntax(
            range(start, end), expression(start, end)
        )
        if (start + 1 < end &&
            (tokens[start + 1].value == "(" ||
                (tokens[start + 1].value == "." && start + 3 < end &&
                    tokens[start + 3].value == "("))) {
            let value = expression(start, end)
            if (value.class.isOfType(PrimitiveCallSyntax.class) ||
                value.class.isOfType(PrimitiveMemberCallSyntax.class)) {
                return PrimitiveExpressionStatementSyntax(range(start, end), value)
            }
        }
        return parseAssignment(start, end)
    }

    parseLocal(Int start, Int end) -> PrimitiveStatementSyntax {
        var Int declarationStart = start
        var Bool directTyped
        if (tokens[start].value == "native_array") {
            declarationStart++
            while (declarationStart < end &&
                (tokens[declarationStart].value == "native" ||
                 tokens[declarationStart].value == "var")) declarationStart++
            declarationStart--
        } else if (tokens[start].value != "let" && tokens[start].value != "var") {
            directTyped = true
            declarationStart--
        }
        if (end - declarationStart < 2 ||
            tokens[declarationStart + 1].type != Token.Type.IDENTIFIER) {
            syntax("Local declaration requires a name or type", start, end)
        }
        var Int assignment = declarationStart + 2
        while (assignment < end && tokens[assignment].value != "=") assignment++
        if (assignment < end && assignment + 1 >= end) {
            syntax("Primitive local initializer requires a value", start, end)
        }
        var String declaredTypeName
        var String name
        if (assignment == declarationStart + 2) {
            name = tokens[declarationStart + 1].value
        } else {
            declaredTypeName = typeName(declarationStart + 1, assignment - 1)
            if (tokens[assignment - 1].type != Token.Type.IDENTIFIER) {
                syntax("Typed local declaration requires a name", start, end)
            }
            name = tokens[assignment - 1].value
        }
        var PrimitiveExpressionSyntax initializer
        if (assignment < end) initializer = expression(assignment + 1, end)
        return PrimitiveLocalDeclarationSyntax(
            range(start, end), !directTyped && tokens[declarationStart].value == "var", name,
            initializer, declaredTypeName
        )
    }

    typeName(Int start, Int end) -> String {
        if (end <= start) syntax("Typed local declaration requires a type", start, end)
        let components = String[]
        var Int index = start
        while (index < end) {
            components.add(tokens[index].value)
            index++
        }
        return components.join("")
    }

    parseAssignment(Int start, Int end) -> PrimitiveStatementSyntax {
        if (end - start >= 6 && tokens[start].type == Token.Type.IDENTIFIER &&
            tokens[start + 1].value == "[") {
            var Int close = start + 2
            while (close < end && tokens[close].value != "]") close++
            if (close < end - 1 && assignmentOperator(tokens[close + 1].value)) {
                let receiver = PrimitiveReferenceSyntax(
                    range(start, start + 1), tokens[start].value
                )
                let target = PrimitiveArrayAccessSyntax(
                    range(start, close + 1), receiver,
                    expression(start + 2, close)
                )
                return PrimitiveArrayAssignmentSyntax(
                    range(start, end), target, expression(close + 2, end),
                    tokens[close + 1].value
                )
            }
        }
        if (end - start >= 5 && tokens[start].type == Token.Type.IDENTIFIER &&
            tokens[start + 1].value == "." && tokens[start + 2].type == Token.Type.IDENTIFIER &&
            assignmentOperator(tokens[start + 3].value)) {
            let receiver = PrimitiveReferenceSyntax(range(start, start + 1), tokens[start].value)
            let target = PrimitiveMemberAccessSyntax(
                range(start, start + 3), receiver, tokens[start + 2].value
            )
            return PrimitiveMemberAssignmentSyntax(
                range(start, end), target, expression(start + 4, end),
                tokens[start + 3].value
            )
        }
        if (end - start == 2 && tokens[start].type == Token.Type.IDENTIFIER &&
            (tokens[start + 1].value == "++" || tokens[start + 1].value == "--")) {
            return PrimitiveAssignmentSyntax(
                range(start, end), tokens[start].value,
                PrimitiveLiteralSyntax(range(start + 1, end), Token.Type.INTEGER, "1"),
                tokens[start + 1].value
            )
        }
        if (end - start < 3 || tokens[start].type != Token.Type.IDENTIFIER ||
            !assignmentOperator(tokens[start + 1].value)) {
            syntax("Assignment requires a name and assignment operator", start, end)
        }
        return PrimitiveAssignmentSyntax(
            range(start, end), tokens[start].value, expression(start + 2, end),
            tokens[start + 1].value
        )
    }

    assignmentOperator(String value) -> Bool =>
        value == "=" || value == "+=" || value == "-=" || value == "*=" ||
            value == "/=" || value == "%="

    parseThrow(Int start, Int end) -> PrimitiveStatementSyntax {
        if (end - start == 1) syntax("Throw requires a value", start, end)
        return PrimitiveThrowSyntax(range(start, end), expression(start + 1, end))
    }

    parseReturn(Int start, Int end) -> PrimitiveStatementSyntax {
        if (end - start == 1) return PrimitiveReturnSyntax(range(start, end))
        return PrimitiveReturnSyntax(range(start, end), expression(start + 1, end))
    }

    expression(Int start, Int end) -> PrimitiveExpressionSyntax {
        let values = tokens.skip(start).take(end - start)
        return PrimitiveExpressionParser().parse(
            values, snapshot, start + tokenIndexOffset
        )
    }

    range(Int start, Int end) -> SourceRange {
        let first = tokens[start]
        let last = tokens[end - 1]
        return SourceRange(
            snapshot,
            start + tokenIndexOffset,
            end + tokenIndexOffset,
            first.location,
            Location(lineNumber: last.endLineNumber, column: last.endColumn)
        )
    }

    syntax(String message, Int start, Int end) {
        throw Exception("Primitive statement syntax error at " + start.toString() +
            ".." + end.toString() + ": " + message)
    }
}
